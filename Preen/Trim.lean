lemma decarded (u:H)(v:W): inner ℂ (ζ u) v=inner ℂ u (e v):=by
 rw [←ContinuousLinearMap.adjoint_inner_right (ζ),P.bank_star]; rfl
#check ext_inner_left
lemma traveller (y:P.VMark)(v:H):ζ (U y v)= T (P.laysM y) (ζ v):=by
 -- by inner equality
 apply ext_inner_right ℂ -- check right argument? type
 intro a
 have hg:=P.cart_reverses 3 x (P.laysM y)
 rw [decarded,P.truck_inner, P.cart_and,P.lays_neg, ← ContinuousLinearMap.adjoint_inner_right,hg,decarded]
lemma conveyor(z:Cover)(s:ℕ)(f:P.Test)(p:P.birthF 3 s f): let L:=P.luggage 3 (look 3) (fun i=> z i.val); let q:=P.certify 3 s (look 3) (fun i=> z i.val) p
 ‖ϕ (ζ (P.viewF 3 x s q))‖=‖ϕ (ζ (P.viewF 3 x s p))‖:=by
 let r:=P.viewF 3 x s p; let y:=P.vtile s z
 intro L q; unfold q
 rw [P.ship_ideal]
 change ‖ϕ (ζ (U y r))‖=_; rw [traveller,pasted _ (P.stone_norm ..),pasted _ (P.stone_norm ..),← P.inner_pay 3 x (P.laysM y) (Ω) (ζ r),P.cart_empty]
 let θ:=inner ℂ (Ω) (T (P.laysM y) (ζ r)); let a:= P.laysM y
 rw [show T a (ζ r)- θ • (Ω)= T a (ζ r - θ • (Ω)) from (by rw [map_sub,map_smul,P.cart_empty]),P.cart_norm]
