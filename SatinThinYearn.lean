lemma rate_Yearn (i:RocX)(o':Site (mid m B))(ei:(w.step V).ratio.parent i.1.val.1 = node o')(a b c:ℝ)(zν:ℂ)(Γκ:Skate)
  (hx:Yearn (Xs:=SX β) (o.tinted β) Ty i h o' (L' (Gμ i)) a b c zν Γκ): Yearn (Xs:=SX β) (o.tinted β) Ty i h o' (Lz (Gμ i)) a b (c+Xi) zν Γκ:= by
 obtain ⟨A,hA,PU,PA,PB⟩:= hx.wave
 constructor; swap; · intro j u; exact winter_ticks (Z:=Z) Q hF pT i j u -- order
 have hg(j:Lo):=C0tick Uq L' ht hm i j
 let H(x:Lo):=A x + hq i x; let U₁(j:Lo):InkD (mid m B):=fun V=> L' (Gμ i) j (V,Ty); let U₂(j:Lo): InkD (mid m B):= fun V=> Lz (Gμ i) j (V,Ty); let t(j:Lo):=tonK (o.tinted β) i j
 let aj(j:Lo):= (if j=host i then a else 0); let K(j:Lo):= aj j+A j -- parentheses parser
 have hp(j:Lo)(v:(host i).val⊆ j.val):=tale_ticks Uq Ty Q hF pT L' ht hm i j v
 have hv(j:Lo)(v:(host i).val⊆ j.val): PressB p (t j v) (U₂ j) h (aj j+H j):=by
    have ht:= Larch.prop_add p (t j v) (hp j v) (PU j v).1; change PressB p (t j v) (U₂ j-U₁ j+U₁ j) h (hq i j+K j) at ht; rwa [sub_add_cancel, show hq i j + K j = aj j + H j from (by unfold K H; abel)] at ht; -- adjust costs
 let RQ:= w.step V; let o₁:= RQ.ratio.parent i.1.val.1; let W:=host i
 refine ⟨H,fun j=>add_nonneg (hA j) (hg j),fun j v=>⟨hv j v,?_⟩,fun u v=>?_,?_⟩ -- h shadow
 · have hw:= (PU j v).2
   let N₀:=Haro.orbitPH (U₁ j 1); let N₁:=Haro.orbitPH (U₂ j 1)
   change Hove.paid_M _ N₀ _*_≤ _ at hw; change Hove.paid_M _ N₁ _*_≤ _
   have hy:Hove.paid_M o' (N₁-N₀) p.power*h^2 ≤2*hq i j:=by
      have h:=Neon.wake_X h (t j v) o' ei (U₂ j-U₁ j) p (hp j v) (zero_le_one.trans D.high); rw [Pi.sub_apply,Moto.tail_K] at h; exact h
   calc
    _ ≤ Hove.paid_M o' (N₁-N₀) p.power*h^2 + Hove.paid_M o' N₀ p.power*h^2 := by rw [←add_mul]; apply mul_le_mul_of_nonneg_right _ (sq_nonneg _); exact le_trans (le_of_eq (congrArg (fun j=> Hove.paid_M o' j p.power) (sub_add_cancel N₁ N₀).symm)) (Hove.paidp_sum ..)
    _ ≤ _ := (add_le_add hy hw).trans_eq (by unfold H; ring)
 · let X0:= t W (Subset.refl (host i).val)
   have h0:=zero_le_one.trans D.high
   let Zd:=Moto.tooth o₁ p
   have hb: ‖Zd (U₁ W) u v- zν*Γκ u v‖≤ b+A W:= PA u v
   have he:Zd (U₂ W-U₁ W)=Zd (U₂ W)- Zd (U₁ W):= Moto.hut_p (P:=p) (X₀:=X0) (F:=U₂ W) (G:=U₁ W) (hv W (Subset.refl _)) (PU W (Subset.refl _) |>.1) h0
   have hh: ‖Zd (U₂ W-U₁ W) u v‖≤ hq i W:= Moto.dia p _ X0 (hp W (Subset.refl _)) h0 u v
   change ‖Zd (U₂ W) u v - zν*Γκ u v‖ ≤ b+ H W
   rw [show Zd (U₂ W) u v-zν*Γκ u v=Zd (U₂ W-U₁ W) u v+(Zd (U₁ W) u v-zν*Γκ u v) from (by rw [he,Pi.sub_apply,Pi.sub_apply]; abel)]
   exact (norm_add_le ..).trans ((add_le_add hh hb).trans_eq (by unfold H; abel))
 unfold H BudgetPoint.mass; simp_rw [mul_add,sum_add_distrib]; apply add_le_add PB; -- mood sums
 let Gs (j:RocX):=∑ q:Lo with (host j).val⊆q.val,p.mass q.val (hq j q)
 exact (single_le_sum (a:=i) (s:=univ.filter fun j:RocX=> RQ.ratio.parent j.1.val.1=o₁) (f:=Gs) (fun j _=>sum_nonneg (fun t _=> mul_nonneg (Real.exp_pos _).le (C0tick Uq L' ht hm j t))) (mem_filter.mpr ⟨mem_univ _,rfl⟩)).trans (singular_sum Uq ht hm o₁)
