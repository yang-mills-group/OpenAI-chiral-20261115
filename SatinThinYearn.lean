lemma rate_Knot (a b δ:ℝ)(Zμ:RocX→ℝ)(Zp:RocX→ Pane ι→ Ride (w.step V) →FC (Dwell ι))
  (hx:KnotX (Xs:=SX β) (Y:=Ys β F) (o.tinted β) Ty h δ Zμ (fun i j=>L' (Gμ i) j) Zp a b): KnotX (Xs:=SX β) (Y:=Ys β F) (o.tinted β) Ty h δ Zμ (fun i j=>Lz (Gμ i) j) Zp a (b+Xi):=by
 obtain ⟨A,Bt,ψ,Ψ,Γ⟩:= hx.yield
 let B1(i:RocX)(j:Lo):= Bt i j+hq i j
 constructor; refine ⟨A,B1,fun i=>?_,fun oμ=>?_ ,fun oμ=>?_⟩
 · constructor; swap; · exact (ψ i).tumor
   intro j; obtain ⟨T,u,pC⟩:= (ψ i).sustain j
   refine ⟨T,fun g=>?_ ,fun g y'=>⟨congrFun (winter_ticks (Z:=Z) Q hF pT i j g) _,(pC g y').2⟩⟩ -- order
   let U₁:InkD ι:=fun y=> L' (Gμ i) j (y,Ty); let U₂:InkD (mid m B):= fun y=> Lz (Gμ i) j (y,Ty)
   have hp:=Larch.prop_add p _ (u g) (tale_ticks Uq Ty Q hF pT L' ht hm i j g) -- order
   unfold B1; rw [←add_assoc];
   convert hp using 1; funext v; change Lz _ _ _ - _ = (L' _ _ _- _)+(Lz _ _ _ -L' _ _ _); abel
 · unfold B1 BudgetPoint.mass; simp_rw [mul_add,sum_add_distrib]; exact add_le_add (Ψ oμ) (singular_sum Uq ht hm oμ)
 unfold B1 BudgetPoint.mass; simp_rw [←add_assoc (A _ _),mul_add _ (A _ _+_),sum_add_distrib]; rw [←add_assoc]; exact add_le_add (Γ oμ) (singular_sum Uq ht hm oμ)
