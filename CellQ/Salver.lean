private lemma walk_shape (P:Spine)(i k j:ℕ): mid ((stageA P i k).side j) P.par.block = P.calibration.c (momentm P.run i j):=(terrain P.run P.large (P.run.ir i) j).symm
lemma corkage_plus (P:Spine)(j r v:ℕ)(c:ℝ): ∀ᶠ k:ℕ in atTop,∀ i:ℕ,∀ h:(P.run.voyage i).kick ≤ k,v ≤ P.run.uv k → r ≤ v → Ferry P.run v i k ∧
  ∀ t: Mark (Papal.count P.run v i), RG.Envelope t→ (∀ x,‖t x‖ ≤ Real.exp (
     (steamPrice P.par.R.L j r v ((stageA P i k).gram v).p ((stageA P i k).gram r).p ((stageA P i k).money v) ((stageA P i k).money r)+c)* sites (Papal.count P.run j i))) → ‖Journey.compass P.run i k v t-Journey.solder P.run i k h v t‖≤1:=by
 let E:=steamPrice P.par.R.L j r v (P.run.meter.a v) (P.run.meter.a r) (payday P v) (payday P r)+c
 let q:= LocalLimit.postage P.par.block P.par.R.L j
 filter_upwards [Journey.circumvol P.run v (E * q) 1 zero_lt_one] with k p i h v' g
 specialize p i h; refine ⟨p.1, fun t b c=>p.2 _ b (fun x=>?_ )⟩
 apply (c x).trans_eq; apply congrArg Real.exp
 rw [show sites (Papal.count P.run j i) = q * game (P.run.ir i) from sites_postage .., ←mul_assoc]
 let S:=stageA P i k
 rw [show ((stageA P i k).gram v).p=P.run.meter.a v from (prices_plot P.run v i k v').1,show ((stageA P i k).gram r).p=P.run.meter.a r from (prices_plot P.run r i k (g.trans v')).1]

abbrev CapFoam (P:Spine)(U:P.Roster)(M:Pitching.Focus.Morn P.par.K)(Aα:ℝ):Prop:=∀ᶠ f:ℕ in atTop,∀ v, f ≤ v→ ∀ᶠ z:ℕ×ℕ in atTop,let k:=z.1;let i:=z.2;∀w:(P.run.voyage i).kick≤k,∃ p:v≤P.run.uv k, Ferry P.run v i k ∧
  let T':=P.run.voyage i; let X:=T'.X (P.run.uv k); let A:=stageA P i k; let ψ:= stageφ P i k
  ∃ (C:ℕ→ℝ)(D:ℕ→ℕ→ℝ),
      (∀ j,f≤j→j<v→Niche P.par.R.L (C j) 0)∧(∀ j r:ℕ,f≤j→j< r → r≤v→ Niche P.par.R.L (C j) (D r j)) ∧
      ∀ (j r:ℕ),∀ q:f ≤ j,∀ h:j ≤ r, ∀u:r≤v,
        |revenue P.par.R.L C (D r) r j-1|≤1/4 ∧
        ∀ t:ℕ,∀ y:22≤ t, ((stageA P i k).gram j).p.B^3+((stageA P i k).gram j).p.B ≤ t/2→ -- parentheses syntax
        ∀ (l:List (Tix A j))(d:ℕ),l≠[]→d+addgap P.calibration ≤ (Papal.count P.run j i).val →
          let kS:=baller P U f v i k p C (D r) j r t q h u y
          (∀ n:Axis, rest P.calibration (momentm P.run i j) (Sport.hopit kS l) n d) → Sport.race kS l →
            ‖solder P.run i k w v (Sport.film kS l)‖ ≤ (payday P j*Real.exp (2* (|Aα|+|M.Mult|)+1))^l.length * Real.exp ((7*Papal.parcelF (hat P.par.R.L P.par.x j))*(4*((d:ℝ)+(addgap P.calibration)))^4)
private lemma all_b {r:ℕ}{p:ℕ→ℕ→ℕ→Prop}(h:∀ i j:ℕ,∀ᶠ k:ℕ in atTop,p i j k):∀ᶠ k:ℕ in atTop,∀ i≤r,∀ j≤r,p i j k:= by
 have e:= eventually_all.mpr (fun (x:Fin (r+1) × Fin (r+1))=>h x.1 x.2)
 filter_upwards [e] with k h i a j b; exact h (⟨i,by omega⟩,⟨j,by omega⟩)

open Papal CF.Pannier.Chancel Checkers Flint
lemma gainsCap (P:Spine)(U:P.Roster)(M:Pitching.Focus.Morn P.par.K)(Aα:ℝ)(K:P.Reader M Aα)(H:∀ᶠ s in atTop,∀ᶠ i in atTop,∀ k:ℕ,(P.run.voyage i).kick≤k→s≤P.run.uv k → Charcoal P.run s i k Aα M.Mult) : CapFoam P U M Aα:=by
 -- Observer parameter chronological. Independent thresholds pair. income scales.

 let a:= P.calibration
 let Y:= P.run
 obtain ⟨N,hN⟩:= eventually_atTop.mp (H.and (clocks_roof P.run M.Mult Aα |>.and ((turnover P.par).eventually_ge_atTop 1)))
 filter_upwards [eventually_ge_atTop N,K] with F hF p v hv
 let r :=P.par.R.L; let x(n:ℕ):=hat r P.par.x n
 let KR(j r':ℕ):=corkage_plus P j r' v (-Real.log (payday P j))
 let Wq(j i:ℕ): Prop:= F ≤ j→∀ k:ℕ,(Y.voyage i).kick≤k→ j≤ Y.uv k → Charcoal Y j i k Aα M.Mult
 have he(j): ∀ᶠ i:ℕ in atTop,Wq j i :=by
    by_cases h:F ≤ j; · exact ((hN j (hF.trans h)).1).mono (fun _ t _=> t)
    exact Eventually.of_forall (fun i e=> (h e).elim)
 obtain ⟨T,t⟩:= eventually_atTop.mp ((all_b (r:=v) (p:=fun j r k=> _) KR).and (ferry_all Y v)); obtain ⟨T',t'⟩:=eventually_atTop.mp (all_b (r:=v) (p:=fun j _ k=> Wq j k) (fun j _=> he j))
 filter_upwards [eventually_ge_atTop (T,T')] with z w iK iV HW -- iK=k iV=i
 let k:=z.1; let i:=z.2; obtain ⟨kw,kF⟩:= t k w.1
 let J:= kF i HW; let h0:=J.enters
 refine ⟨h0,J,?_⟩; intro zA
 obtain ⟨C,D,c,d,E⟩:= p i v (Y.uv k) hv h0
 refine ⟨C,D,c,d,fun j r' q v0 v1=>?_⟩
 let Q:= stageA P i k; let ph:= stageφ P i k
 let tK:= C
 let ζ:=P.par
 have he: |revenue r tK (D r') r' j-1| ≤ 1/4 := fare_toll _ _ _ v0 (fun n h g=>d n r' (q.trans h) g v1)
 refine ⟨he,?_⟩; intro tM hT hQ l bM hb hW X1 ht hvL
 let ℓ:=reserve ζ P.width
 let κ:=aliasLaw ζ; let ap:=Y.voyage i; let V:=ap.X (Y.uv k)
 let Vp:= Parcel.paper ap.funds (Y.uv k) V ζ.H (U.prepared ..) κ (Journey.legal ζ) F v h0
 let Fx:= Parcel.loom_shop ap.funds (Y.uv k) V κ (U.loom i) F v
 let zS:= Journey.prepared ζ P.width; let hp:ℓ=P.calibration.ℓ:=rfl
 let Ξ:= Journey.compass Y i k v; let Ξ':= solder Y i k HW v
 let Qr:= payday P j; let Z:= |Aα|+|M.Mult|
 have hV:=v0.trans v1; have hK:=hV.trans h0
 obtain ⟨- ,hu,hu',_⟩:= (hN j (hF.trans q)).2.1 i k hK
 have Hp:0≤7*parcelF (x j):=by unfold parcelF x; have hx:1≤hat P.par.R.L P.par.x j:= (hN j (hF.trans q)).2.2; positivity
 have hz:0≤ Z:=by unfold Z; positivity
 apply perfusion Q Vp Fx zS j r' tM hp q v0 v1 hT C (D r') (walk_shape P i k j) l Ξ Ξ' hu' (show Qr ≤1 from (one_le_inv_iff₀.mp hu).2) (by positivity : 0≤2*Z) Hp _ hQ (fun i a h=>c i (q.trans a) h) he (Papal.revive P.run P.large _ _ _ J) ((kw j hV r' v1 i HW h0 v1).2) _ ((walk_shape P i k j) ▸ hW) ht hvL hb
 · intro l hw; refine linedance Q Vp Fx zS j r' tM hp q v0 v1 hT C (D r') (walk_shape P i k j) l Ξ hu' hz Hp hQ hw ?_
   intro I htI hI o l uo hl
   obtain ⟨T,b,c,d⟩:= E j r' q v0 v1 I o uo
   have hl':Ξ (braidP (Yz:=ph) (v:=v) ζ.V Q j r' o C (D r') l)= rumor ζ.V Q j T l 1:=d l hl
   rw [hl']; exact (t' i w.2 j hV j hV q k HW hK).invoice o T _ l b uo
 intro c F; unfold Ξ Ξ' Journey.compass solder; rw [Buffered.mark_smul,Buffered.mark_smul]; ring
