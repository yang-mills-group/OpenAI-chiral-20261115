 have he(s):∃ C D,F ≤ s→ Accolade P M A F s C D:=by
    by_cases h:F ≤ s; · obtain ⟨C,D,q⟩:=T s h; exact ⟨C,D,fun _=>q⟩
    exact ⟨0,0,fun e=>(h e).elim⟩
 choose C D b₀ using he
 have bZ(s)(t:F ≤ s):Accordance P M F s (C s) (D s) :=by
    refine ⟨(b₀ s t).1,fun j u v i o b d=>?_⟩
    intro i0 h0 ht; exact ((b₀ s t).2 j u v i o b d h0 ht).trans (hx j u d)
