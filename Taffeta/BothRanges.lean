include pU liftV qZ p0 pC hI uR
lemma frosted (s:List PK)(t:Mark (Sc i0))(hT:benign t)(p:(wrap0 s).Nodup):
 rumor V A i0 l s t=levy (shareT R.L C D1 r0 v i0) (shareS R.L r0 i0) (habitat V A Yz i0 r0 v o t) s:=by
 induction pC generalizing s
 case splitP o X y c=>
    let S:=A.plant r0; let Gv:=A.gram r0; let Zt:=canvas o Gv (A.money r0)
    have hl:= commissioning1 V A C r0 v o X y; have hm:= hl.2
    have hy:= pU r0 p0 uR
    have he(s'): AtSupport false univ (Zt s'*t):=(canvas_at o s' Gv (A.money r0)).mulM hT
    refine (fare_bloom (U:=U) (X:=Gv) (G₀:=S) V o X (A.money r0) s p t hT hm.age.1 hm.age.2 c.age.1 c.age.2 hy.1 (hy.2 _ o X hm)).trans ?_
    let η:ℂ:=(hGain C v r0:ℝ)
    have hs:=share_top (I:=I) C D1 v r0 R.L -- order
    rw [hs.1,hs.2]
    have hP(l:List PK)(f:List I→ List I→ℂ):Mew.levy (fun _:PK=>η) bore f l=Mew.levy 1 bore (fun s t=>η^s.length*f s t) l:=by
       have h:=Mew.levyMulL l (1:PK→ℂ) bore (fun _=>η) f; simpa only [Pi.one_apply,mul_one,smul_eq_mul,Mew.berry] using h
    rw [hP]; apply Mew.levy_c; intro l m g h; rw [hab_r]; exact natural V A qZ X o p0 pU liftV y hI (Zt m*t) (he m) l (p.sublist g) -- order
 case reel i e o L Q n c x ih=>
    let Fσ:= node∘sameY o; let xσ:=cobble I (C i) (D1 i) βpal
    have hLV:= liftV i p0 (e.trans_le uR) _ o hI
    have hx:= shift_quote V A qZ (C i) (D1 i) L Q o p0 (e.trans_le uR) pU (charged1 V A C D1 _ _ _ _ _ n).2 x t hT s ((mapSep V A s o) ▸ p.map hI.1)
    let P:= levy (shareT R.L C D1 r0 v (i+1)) (shareS R.L r0 (i+1)) (habitat V A Yz (i+1) r0 v (adapt V A i o) (Yz i t))
    refine (hx.trans (rer Fσ xσ s (W:=P) ?_)).trans ?_
    · intro l h
      have hv':(wrap0 l).Nodup:=List.Nodup.of_map (node∘o) (by rw [←mapSep V A l o,h,mapSep V A s o]; exact p.map hI.1) -- h rewrite Fσ issue
      exact ih (p0.trans (Nat.le_succ _)) hLV l (Yz i t) (gustF V A qZ p0 (e.trans_le uR) t hT) hv'
    have hσ:=Mew.spinLevy (node ∘o) hI.1 (shareT R.L C D1 r0 v (i+1)) (shareS R.L r0 (i+1)) (habitat V A Yz (i+1) r0 v (adapt V A i o) (Yz i t)) s (stone (C i) (D1 i) βpal)
    obtain ⟨a,b⟩:=share_n (I:=I) C D1 i v r0 R.L e uR
    rw [a,b] at hσ; exact hσ.trans (Mew.levy_c _ _ _ _ _ fun _ _ _ _=>(hab_step V A _ _ _ _ e _ _ _ _).symm)
