noncomputable abbrev habitat (sd:Vxpert V A)(i r v:ℕ)(o:I→Site (Sc i))(T:Mark (Sc i))(s t:List I):ℂ:=
 let u:= liftCanvas V A i r o; let f:= liftCanvas V A r v u
 let Ext:=blaze V A sd i r T
 let qv:= canvas u (A.gram r) (A.money r) t * Ext
 house V A v (canvas f (A.gram v) (A.money v) s * blaze V A sd r v qv)
lemma hab_r (sd:Vxpert V A)(r v:ℕ)(o:I→Site (Sc r))(T:Mark (Sc r))(s t:List I): habitat V A sd r r v o T s t=house V A v (canvas (liftCanvas V A r v o) (A.gram v) (A.money v) s* blaze V A sd r v (canvas o (A.gram r) (A.money r) t * T)):=by unfold habitat; dsimp only; rw [show liftCanvas V A r r o=o from hop_here ..,show blaze V A sd r r T=T from hop_here ..]
lemma hab_step (sd:Vxpert V A)(i r v:ℕ)(h:i<r)(o:I→Site (Sc i))(T:Mark (Sc i))(s t:List I): habitat V A sd i r v o T s t=habitat V A sd (i+1) r v (adapt V A i o) (sd i T) s t:=by
 let L:=Sc i
 have he:liftCanvas V A i r o=liftCanvas V A (i+1) r (adapt V A i o):=hop_step _ _ _ _ h _
 have hT:blaze V A sd i r T=blaze V A sd (i+1) r (sd i T):= hop_step _ _ _ _ h _
 unfold habitat; simp only; rw [he,hT]
lemma mapSep (s:List (PairKey I))(o:I→Site (Sc i0)):s.map (node ∘ sameY o)= (wrap0 s).map (node ∘ o):=by unfold wrap0; rw [List.map_map]; rfl
