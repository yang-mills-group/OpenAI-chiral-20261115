lemma saleArticles (tC: Cl (β:ℂ) (F,0)) :
    Voucher p h Lunar.brickDate (flower p.B) ((articles (Z0:=Z0) Ty Vq).Eτ (β:ℂ) (F,0)).1:=by
  change Voucher p h Lunar.brickDate (flower p.B) (PE (β:ℂ) (F,0)).1
  rw [(billingReal T.toFocus Ty Vq hv T.fair β F).1]
  have v := (matured Ty T Vq hv _ tC).1
  let qx :=T.member v tC.1
  let w :=v.mono (show εLeaf R.L x/3 ≤ εLeaf R.L x by linarith only [T.buy])
  let e:= gross_shape (D:=D) w T.cost
  obtain ⟨B0,g⟩:= Banker.Hoisted Z0 e C (T.ledge _ tC.1)
  refine Voucher.like (Y:=pre_E (p:=p) (p':=p') (o:=o) Ty Vq (Banker.Phi Z0 (β:ℂ) F) F)
    (Voucher.loan (tapHigh T.toFocus Ty T.fair (Weather.still Ty T Vq hv tC).spirit g)) ?_
  intro i pay
  unfold pre_E
  rw [headPlus,Pi.add_apply]
  refine add_eq_left.mpr ?_
  funext V'
  change cut_V (Lunar.radixLin (p:=p) (p':=p') (o:=o) Vq (Lunar.pennies F.1) i V') = 0
  rw [Lunar.capRadix T.toFocus qx w Vq i pay,Pi.zero_apply,map_zero]
#print axioms saleArticles
