open Zephyr

theorem polyFlower: Zephyr.Poly flower:=by
  change Zephyr.Poly (fun b=>wren_K 6 2+Nor.reserveT 2 6 b 1*(2+2))
  unfold Nor.reserveT Nor.coin_n Nor.stilK
  zipcost

open Sour
def springFee (b:ℕ):= flower b+(iceRent b+iceRent b)+ 1 + iceRent b

theorem polySpring: Zephyr.Poly springFee:=
 ((polyFlower.add (polIce.add polIce)).add (Zephyr.pol _)).add polIce

theorem springPos (b:ℕ):0 ≤ springFee b:=by
  have ht := iceRentZen b
  have hw : 0 ≤ wren_K 6 2:=by unfold wren_K;linarith only [lucre 6 2]
  unfold springFee flower Nor.reserveT Nor.coin_n Nor.stilK
  positivity

