    Voucher p h (hardEdge R) (springFee p.B) ((s.operate.realArr β F).1):=by
 obtain ⟨Ty,Vq,hv,u⟩:= P_.lobby
 have v:Client K R x w.input p' h (β:ℂ) (F,0):=
   submits P_.capsule e ⟨hF,Charged.zero.mono (mul_nonneg (by norm_num) P_.capsule.high.le)⟩
 let X:= Z0.request.boot
 refine s.priorSpring v G X.order X.power X.exponent ?_
 rw [u]
 exact saleArticles Ty P_.weather Vq hv v
