lemma Launch.same_exp {X:Corr (mid m B)} {Y:Corr (mid n B)}{v i j:ℂ}{b a:ℝ}{g:SpaceM}(K:Launch p p' w U q J.d X Y b a v i g)(H:Launch p p' w U q J.d X Y b a v j g)
    (u:Location.Request V U W J q w N0 x p p') : Complex.exp i=Complex.exp j:= by
 let V0:Orbit (mid m B):=(1,Classical.arbitrary _); let M:=w.output; let S:=w.coarse; have he : flags p.threshold V0.1=∅:=UVNext.CouplingReset.flags_one _; let P:= V.L.path (w.lag+1); let β:=b+Location.movement V w-a
 have hv:= congrArg (fun x=> inner ℂ (changeM (m:=m) U (S V0) M.M) x) ((K.wear V0 (clear_identity _)).trans (H.wear V0 (clear_identity _)).symm)
 let hp:= J.gran.trans u.rocket.size; let hg:= (u.rocket.paid.paid V0).shrink J.hr.le
 -- unfold flag-equality
 change inner ℂ _ (denZ (construct p P _ M β X i) U S V0) = inner ℂ _ (denZ (construct p P _ M β X j) U S V0) at hv
 rw [sea_read (m:=m) U P _ S M X i β V0 he hp hg, sea_read (m:=m) U P _ S M X j β V0 he hp hg] at hv
 simp only [Complex.exp_add, Complex.exp_sub,div_eq_mul_inv, mul_left_inj' (Complex.exp_ne_zero _), mul_left_inj' (inv_ne_zero (Complex.exp_ne_zero _))] at hv -- syntax mul_left inj'? expo char cancel simplify.
 exact hv
