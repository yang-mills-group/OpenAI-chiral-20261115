lemma record_body (uf:ℂ)(Q:β∈ Year R x)(q0:Cl (β:ℂ) (F,0))(pix:s.Lp=articles (Z0:=Z0) Ty Vq) (Lr:ℝ)(he:s.Sh ≤ Lr): let E:=(s.standby (β:ℂ) (F,0)).1; let F':=s.operate.realArr β F; let t:=Banker.Phi Z0 (β:ℂ) F; let u := s.A0.dream.pivotP E (cone_f t);
  E.val= Λi ∧∃ (v:ℝ)(KΦ:Cusp ι), Course p u (V.L.path (w.lag+1)) K.top.clip (β+w.movement V) (β+w.movement V-s.operate.posted β F) F'.1 KΦ v ∧ Packed p h (Cash.prominence p) KΦ Lr∧ZealQ KΦ∧F'.2=roomB p u KΦ ∧ Complex.exp ((SℲ).offset β F uf)=retail (F:=F) (Z0:=Z0) P Q * Complex.exp uf * ((Real.exp v:ℝ):ℂ):= by
 intro E F' t u; obtain ⟨A,hY⟩:= s.rep_point q0; have hY:E.val=Λi:= hY
 refine ⟨hY,?_⟩
 obtain ⟨μ,DataΦ,p0,Vp,HB,g,e,xq⟩:= A.body
 -- rep rewrite husk; stake about this Shop, not occupancy chosen by some other weather
 rw [pix] at e g xq p0
 let Fx := (stock_ξ (Lp:=articles (Z0:=Z0) Ty Vq) (A0:=s.A0) (rePoint E) (β:ℂ) (F,0)).1
 have hx : Fx=u := by
    unfold Fx stock_ξ; rw [store_φ Ty T Vq hv,(s.A0.dream.realP E _).1]
 change Cycle929.Course p Fx _ _ βπ (βπ -LτX) F'.1 DataΦ μ at p0
 change F'.2=roomB p Fx DataΦ at g
 obtain ⟨v,h0,f0⟩:= reside Ty T Vq hv q0 s.A0 P E e LτX μ F' xq
 have hz : Launch p p' w U q J.d F' F β LτX 0 v Λi := by rw [←hY]; exact ⟨fun y p=>(f0 y p).symm⟩
 rw [hx] at p0 g; refine ⟨μ,DataΦ,p0, HB.purse he,Vp,g,?_⟩
 have hv:Launch p p' w U q J.d F' F β LτX uf (v+uf) Λi:=by simpa only [zero_add] using hz.adjust uf
 rw [Launch.same_exp (s.RepReal q0 uf).2.1 hv Z0.request,Complex.exp_add,h0]; -- offset formula defeq `Ys`. proof money eq.
 change (retail _ _* Complex.exp 0 * ((Real.exp μ:ℝ):ℂ)) * Complex.exp uf = _
 rw [Complex.exp_zero,mul_one]; ring
