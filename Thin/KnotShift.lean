lemma sum_increases (v:Seat (Scree.mid m B)) :
    (∑ i:RΛ with (S').ratio.parent i.1.val.1=v,∑ j:Lo with (hostX (l:=Δ) S' i).val⊆ j.val,p.mass j.val (Tδ ((S').ratio.parent i.1.val.1) (Gμ i) j))≤ U_ν:=by
 -- `payment_by` in product enumeration with same coordinates
 let Bx:= Uq.payment_by pL u v
 refine Eq.trans_le ?_ Bx
 unfold rope_i
 simp_rw [sum_filter]
 conv_rhs => rw [Fintype.sum_prod_type]
 apply sum_congr rfl
 intro i0 _
 by_cases e: (S').ratio.parent i0.1.val.1=v  
 · rw [if_pos e]; apply sum_congr rfl; intro j hj
   by_cases Hq: (hostX (l:=Δ) S' i0).val⊆ j.val
   · have Ht:(keep_ (i0,j))=tonK oWell i0 j Hq:= dif_pos Hq
     change (if (hostX (l:=Δ) S' i0).val⊆ j.val then _ else _) = if (hostX (l:=Δ) S' i0).val⊆ j.val then (if (keep_ (i0,j)).val.1=v then _ else _) else _
     simp_rw [if_pos Hq,Ht]; rw [if_pos (show (tonK oWell i0 j Hq).val.1=v from e)]
   change (if (hostX (l:=Δ) S' i0).val⊆ j.val then _ else _) = if (hostX (l:=Δ) S' i0).val⊆ j.val then _ else _
   simp only [if_neg Hq]
 rw [if_neg e]; symm; apply sum_eq_zero; intro j hj
 by_cases Hq: (hostX (l:=Δ) S' i0).val⊆ j.val
 · have Ht:(keep_ (i0,j))=tonK oWell i0 j Hq:= dif_pos Hq
   change (if (hostX (l:=Δ) S' i0).val⊆ j.val then (if (keep_ (i0,j)).val.1=v then _ else _) else _)=_
   simp_rw [if_pos Hq,Ht]; rw [if_neg (show ¬ (tonK oWell i0 j Hq).val.1=v from e)]
 change (if (hostX (l:=Δ) S' i0).val⊆ j.val then _ else _) = _; rw [if_neg Hq]

