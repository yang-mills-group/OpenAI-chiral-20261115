/-- absolute continuity is all that is needed to transfer the leaf look. -/
lemma plummy_absContinuous {K N B : Side}(S:StepData (Domain N B) (Domain K B)) {u v:ℝ} (hp:0<u)(he:u≤v) : plummy S u ≪ plummy S v := by
 have hz:= hp.trans_le he; let Y:= Bond (Domain K B)
 haveI hx₁:IsProbabilityMeasure (springT S u):= lum_p _ hp
 haveI hx₂:IsProbabilityMeasure (springT S v):= lum_p _ hz
 let T := tableG SU.group (Bond (Domain K B)); haveI : IsProbabilityMeasure (T u):= Appel.how _ hp; haveI : IsProbabilityMeasure (T v):= Appel.how _ hz
 -- T includes curtain, before step
 apply Measure.AbsolutelyContinuous.prod Measure.AbsolutelyContinuous.rfl
 apply Measure.AbsolutelyContinuous.prod _ Measure.AbsolutelyContinuous.rfl
 apply Measure.AbsolutelyContinuous.prod Measure.AbsolutelyContinuous.rfl
 -- meal lemma
 change T u ≪ T v
 intro s e
 let A := Measure.pi fun _ : Bond (Domain K B) => rice SU.group; let f(x:ℝ) := grainS SU.group x ^Fintype.card (Bond (Domain K B)); let Vp(x:ℝ):=A.restrict (surface SU.group (Bond (Domain K B)) x)
 have meal_eq x (q:0<x) : Vp x s = f x * ((T x) s) := by unfold Vp; rw [show A.restrict _ = f x • T x from (Appel.meal _ q).symm, Measure.smul_apply]; rfl
 have hb (x) (q:0<x) : f x ≠ 0:= pow_ne_zero _ (grain_pos SU.group q).ne'
 have hg : Vp u s = 0 := nonpos_iff_eq_zero.mp ((Measure.le_iff'.mp (Measure.restrict_mono_set _ (Set.pi_mono fun _ _=> closedBall_subset_closedBall he))) s |>.trans_eq (by rw [meal_eq _ hz,e,mul_zero]))
 rw [meal_eq _ hp] at hg; exact (mul_eq_zero.mp hg).resolve_left (hb _ hp)

-- avoid refactoring the LookZ chain: buy its domination by
-- varying its free cQ parameter (NOT its ScaledV rate) separately for each torus.
private lemma toll_coin {X Y:Type*}[MeasurableSpace X](P:Measure X)[IsProbabilityMeasure P][Fintype Y](f:X→Y)(c c':ℝ)(p:0<c')(b:ℝ)(k:ℕ)(q:0<b)(hb:c*(1-degreePrice k c 1)⁻¹=b) : ∃ K:ℝ, 0<K ∧ tollW' P f c c' k=b*K ∧ ∀ d b':ℝ,0<b' → d*(1-degreePrice k d 1)⁻¹=b' → tollW' P f d c' k=b'*K:=by
 classical
 let u (x:Y):=P.real (f ⁻¹' {x}); let K:= ∑ i:Y, 1/c'/u i
 have H(d b':ℝ)(h:0<b')(hp:d*(1-degreePrice k d 1)⁻¹=b'): tollW' P f d c' k=b'*K:=by unfold tollW' K; simp only [pow_zero,mul_one,hp,abs_of_pos (div_pos h p), Finset.mul_sum,←mul_div_assoc,mul_one]; rfl
 refine ⟨K,?_,H c b q hb,H⟩
 have hh : ∃ i:Y, u i ≠ 0:= by
    by_contra e
    push Not at e
    have hb(i:Y):P (f ⁻¹' {i})=0:= by exact ((ENNReal.toReal_eq_zero_iff _).mp (e i)).resolve_right (measure_ne_top _ _)
    have ht :P (Set.univ:Set X)=0:=by
      rw [show (Set.univ:Set X)=⋃ i:Y,f ⁻¹' {i} from Set.eq_univ_of_forall (fun x=>Set.mem_iUnion.mpr ⟨f x,rfl⟩) |>.symm]; exact measure_iUnion_null hb
    simp at ht
 obtain ⟨i,w⟩:=hh
 have hm(i:Y):0≤ u i:= ENNReal.toReal_nonneg
 have hs:0< 1/c'/u i:= div_pos (by positivity) (lt_of_le_of_ne (hm i) (Ne.symm w)); exact hs.trans_le (single_le_sum (f:=fun i:Y=>1/c'/u i) (fun i _=>div_nonneg (by positivity) (hm i)) (mem_univ i))
private lemma fix_pave (c:ℝ) (k:ℕ)(p:0<c): ∃ q:ℝ,q*(1-degreePrice k q 1)⁻¹=c:=by
 let d:= degreePrice k 1 1; let Q:=c/(1+c*d); have h:0<d:=mul_pos (by norm_num) (stretch_pos k (by norm_num) (by norm_num)); refine ⟨Q,?_⟩
 have hd:1-degreePrice k Q 1=(1+c*d)⁻¹:=by rw [show degreePrice k Q 1=Q*d from (by unfold d degreePrice Trees.stretch; ring)]; unfold Q; field_simp; ring
 rw [hd,inv_inv]; unfold Q; rw [div_mul_cancel₀ _ (by positivity)]
private lemma cover_pave (T:Lo→ℝ) (v:ℝ) (c q:ℝ)(h0:0<v) (j₁ j₂ k:ℕ) : ∃ kQ:ℝ,∀ i:Lo,T i ≤ pave_ j₁ j₂ v kQ c q (w.step V) p i k:=by
 haveI := plum_p (w.step V) h0
 letI : Fintype ↥(Sil (w.step V) j₂):= @Fintype.ofFinite _ (Set.Finite.to_subtype Jade.sill_p)
 have h(i:Lo) : ∃ K:ℝ,0<K ∧ ∀ d b':ℝ,0<b' → d*(1-degreePrice k d 1)⁻¹=b' → pave_ j₁ j₂ v d c q S' p i k=b'*K:=by
    obtain ⟨a,h⟩:=fix_pave 1 k (by norm_num)
    unfold pave_
    obtain ⟨K,hp,-,u⟩:= toll_coin (plummy S' v) (fun y=>stamp y j₁ q j₂) a (Trees.currency k c i.val) (Real.exp_pos _) 1 k (by norm_num) h
    let t:=surgeL p i.val k * liftR p i.val k 1; have ht:0<t:= by unfold t Nor.surgeL Nor.liftR Jet.composeCost surgeL; positivity
    refine ⟨t*K,by positivity,fun d b' hv e=> ?_⟩; unfold mow_z; rw [u d b' hv e]; rw [abs_of_pos ht,abs_of_pos (mul_pos hv hp)]; unfold t; ring
 choose B hb he using h; let Tt : Lo → ℝ:= fun i=> |T i / B i|
 let b':=1+∑ i:Lo, Tt i; have hf(i:Lo):0 ≤ Tt i:= abs_nonneg _; have hp:0<b':= add_pos_of_pos_of_nonneg zero_lt_one (sum_nonneg (fun i _=>hf i))
 obtain ⟨u,w'⟩:= fix_pave b' k hp; refine ⟨u,fun i=>?_⟩; rw [he i u b' hp w']; exact (div_le_iff₀ (hb i)).mp ((le_abs_self _).trans ((single_le_sum (f:=Tt) (fun i _=>hf i) (mem_univ i)).trans (le_add_of_nonneg_left zero_le_one)))
local notation "Rp"=> Appel.point G5 Sp/Appel.point G5 ℓ
include M
private lemma lit_ratio_look (A:Orbit ι) (S:Ω): Z.tiny K0 O' hF Q A S=(Rp)^(tokenFuel K0 S) • Z.grand K0 O' hF Q A S:= by
 let v:= Z.toLid.ZoomB Q; rw [RCLike.real_smul_eq_coe_smul (K:=ℂ)]; let x:ℂ:= ↑(Rp); have hp:= shot_orientation Z.toLid M Q
 let k:=tokenFuel K0 S
 have e:Z.tiny K0 O' hF Q A S= _ :=Z.ratio_master K0 O' hF S A Q _ (Z.toLid.fend Q (Z.toLid.scaler Q)) rfl rfl
 change _= (↑((Rp)^k):ℂ) • _; rw [e, Complex.ofReal_pow,←hp,Complex.ofReal_div];
theorem zoom_look (hq:(β:ℂ)∈Ledge nₐ t (Scales.y SU.group R.L x))(payC vL:ℝ) : ∃ kQ:ℝ,∀ (F: Corr (mid n B))(hF:Location.gross p' D f F), LookZ V (Xm:=Xs β) (Xu:=Ys β F) o.SheepR ((Z.toLid.crew β Q).1) (Z.toLid.choice Q hF) o.bags o.vista o.Jz payC vL → LookZ V (Xm:=Xs β) (Xu:=Ys β F) o.SheepR (Z.toLid.fend Q (Z.toLid.scaler Q)) (Z.toLid.choice Q hF) o.bags o.vista o.Jz kQ vL:= by
 -- local abbreviations use payC shadow! rename
 let W : V_→ Arena.Tab S'→ ℝ:= fun j a=> |(Rp)^(∑ y∈liftK S' j.toLeft,Fintype.card (Frozen y.val x a.1))|
 let C:= ∑ i:V_, ∑ j:Arena.Tab S',W i j
 have hb (i:V_)(j:Arena.Tab S'):0 ≤ W i j:= abs_nonneg _; have hl:0 ≤ C:= sum_nonneg fun i _=>sum_nonneg fun j _=> hb i j
 have hu (i:V_)(y:Ω) : |(Rp)^tokenFuel i y| ≤ C:=by change W i y.1 ≤ C; apply le_trans (single_le_sum (f:=W i) (fun j _=>hb i j) (mem_univ y.1)); exact single_le_sum (f:=fun i:V_=>∑ j:Arena.Tab S',W i j) (fun i _=>sum_nonneg fun j _=>hb i j) (mem_univ i)
 let L1:= Ξ; let L2:= z'; let a:= luceL R o.Jz x
 let Td (v:ℝ)(payC:ℝ)(i:Lo):= pave_ L1 L2 v payC vL a S' p i Dα
 have hs:ℓ≤Sp:= Pilot.hat_zoom ..; have hp:0<ℓ:=zero_lt_one.trans_le (coast Z.toLid M Q)
 obtain ⟨kQ,H⟩:= cover_pave (fun i:Lo=>C * Td Sp payC i) ℓ vL a hp L1 L2 Dα
 refine ⟨kQ, fun F hF A i j I g u=> ⟨?_,?_⟩⟩
 · have he:∀ᵐ y∂μπ, ‖Z.grand i (Stilo.beamH j.val) hF Q I y‖ ≤ Td Sp payC j:= (A i j I g u).1
   have ht: Plume.plummy S' ℓ ≪ μπ:= plummy_absContinuous _ hp hs
   filter_upwards [ht.ae_le he] with y pV
   change ‖Z.tiny i (Stilo.beamH j.val) hF Q I y‖ ≤ Td ℓ kQ j
   rw [lit_ratio_look j i Z hF Q M, norm_smul,Real.norm_eq_abs]
   exact (mul_le_mul (hu _ _) pV (norm_nonneg _) hl).trans (H j)
 have ht:I.1 ∈ Rue.litres p.threshold (Stilo.bay (beamH j.val)) (cook S' i.toLeft).flags:= by rw [bay_beam]; exact u
 exact keep_live j i Z hF M hq I ht
