open Linen
/-- independent x,Shop -/
def shelf:ℕ:=((5+300)+(5+300)+1)^4
def shield:=max reach_T shelf

variable (G:Youth m n B→ InkD (Scree.mid m B))
private lemma stems (bound:∀ i:Ξm,G i ≠ 0→ coverNumber (radiusB x) i.2.1.val ≤ shelf):
 Sparse (solar (o:=o) G) shelf (radiusB x):=by
 apply Sparse.sunY
 intro j _ h
 rw [keep_h (o:=o)] at h
 apply Finset.sum_eq_zero
 intro i si
 rw [←(mem_filter.mp si).2.2] at h
 by_contra v; exact Nat.not_lt.mpr (bound i v) h

private lemma buds (u:1≤radiusB x):
 Sparse (sunrise (x:=x) G) reach_T (radiusB x):=by
 apply Sparse.sunY
 intro i _ h
 exact False.elim (Nat.not_lt.mpr (yard_m x i.2.1 u) h)

variable (E:RegBudget (Scree.mid m B))(A:Cusp (Scree.mid m B))
      (hp: YM.CF.Py.Lunar (H:=tint_z o.muster β) (Uφ:=Lz)
        (Y:=Pitching.input (V:=V) (w:=w) p' β F) (X:=Pitching.start (V:=V) (w:=w) p β) V o.SheepR D.D Vq C' D.X D.jp Ty E A)
local notation "L'"=>forge_P (H:=Up β) (Y:=Ys β F) (X:=Xs β) V o.SheepR D.D Vq C' D.X D.jp
include hp
lemma spar (i:Ξm)(u:S0 (pennies F.1) i≠0): i∈L' := by

 obtain ⟨f,hv,hQ,hz⟩:=hp.pay; let G:= S0 (pennies F.1); have he: f=G:=by funext i V'; apply Subtype.ext; rw [hv,birth]
 subst f; let L:= forge_P (H:=Up β) (Y:=Ys β F) (X:=Xs β) V o.SheepR D.D Vq C' D.X D.jp
 have hu(x:Ξm)(g:x ∉ L) : G x= 0 := by
    funext i; apply Subtype.ext; rw [hv, show glasp _ _ _ _ _ _ _ _=0 from not_not.mp fun t=> g (mem_filter.mpr ⟨mem_univ _,t⟩),thaw_v]; rfl
 by_contra w; exact u (hu i w)

include Uq Q hF
lemma stellate
 (i:Ξm)(u:S0 (pennies F.1) i≠0) :
 coverNumber (radiusB x) i.2.1.val ≤ shelf := by
 have si:= spar Ty Vq E A hp i u
 have hg:=gross_shape (D:=D) hF (le_refl f)
 let U0:= Uq.layout.full β Q F hg
 obtain ⟨Qx,Qv,Fq⟩:= Pig.sail_t (H₀:=Ys β F) (H₁:=Xs β) (k:=6) V (M_:=o.SheepR)
 let q:= till_q V D.pilot D.Z U0.statv o.SheepR F_ D.D Vq Qx Qv Fq C' D.X D.jp i si
 have a:1≤radiusB x:=by rw[←Z.request.boot.B]; exact (by linarith only[Uq.hefty])
 exact (Corona.cover_mono (subset_union_left.trans q) _).trans (Corona.tile _ _ _ a)
#check Pig.sail_t
#check till_q
#check yard_m


lemma shower : Sparse (noncash_E (p:=p) (p':=p') (o:=o) Vq F) shield p.B:=by
 have a:1≤radiusB x:=by rw [←Z.request.boot.B]; exact (by linarith only[Uq.hefty])
 -- careful conv rw [p.B]
 have y:= (stems (o:=o) (S0 (pennies F.1)) (stellate Uq Ty Q hF Vq E A hp)).mono shield (le_max_right ..)
 have z:= (buds (S0 (pennies F.1)) a).mono shield (le_max_left ..)
 rw [Z.request.boot.B]; exact (z.sub y).writ
end Lunar
open Linen
include Uq Ty Q
lemma shone (Bq:Rill.Arch w.G d)(hx:Bq.val=1)(tF:Charged p' w.input K.j R.L.val h ff F):
 Sparse (noncash_E (p:=p) (p':=p') (o:=o) Bq F) Lunar.shield p.B:=by
 obtain ⟨T,g,E,G,Bx,q,e,v⟩:= Uq.sharp Ty Q tF
 have hb : Bx=Bq:=Subtype.ext (q.trans hx.symm)
 subst Bx
 exact Lunar.shower Uq Ty Q (tF.mono Uq.cost) Bq E G e
