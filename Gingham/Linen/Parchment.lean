 let G: MonoQ p h UP (FeeD p (nixV (cone_f Lz))) 1 :=
   ((hk.usable Uq).halve.1.fee (hk.ps Uq) D.high b).purse ((hk.usable Uq).thin_fee)
 exact ⟨(hp.livelihood Uq Ty hk u hT bt).1,(G.sub (z.fade (le_add_of_nonneg_right zero_le_one) (zero_le_one.trans D.high))).purse (by linarith only [k,p1])⟩

