 · intro i _; let l:= Trefoil.mint Uq Ty (Gμ i.1) i.2 (pL.spruce _ _ (by rw [soils]; exact empty_subset _)) u (keep_ i) (soils _) (keep_h (o:=o) i); exact pop_up l
