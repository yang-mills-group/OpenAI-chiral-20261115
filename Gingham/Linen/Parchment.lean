lemma polonaise (dt:tα=1) : IncX Utrue tL p.raisin h (bill_tap p.B):=by
 subst tα
 obtain ⟨q,b⟩:= livelihood_better Uq Ty u hp hk zero_le_one (by norm_num)
 have d:=addT p.raisin (pertains_two Uq Ty hp.seed u hp) (Cash.priceRun_two D.high Ty b q)
 rw [Z.request.boot.order,Z.request.boot.power] at d
 apply Fixed.Voltage.upgradeI _ _ d
 unfold bill_tap
 refine add_le_add ?_ le_rfl
 apply mul_le_of_le_one_right (add_nonneg zero_le_one (Ione.lucre ..))
 rw [one_mul]
 have k:=le_mul_of_one_le_left hk.beam spicy6
 linarith only [k,hk.beam,hk.gain,hk.book.capped]
