lemma livelihood_better
 (hT:0 ≤ tα)(bt:tα≤100) : Cash.poise sL ∧ MonoQ p h UP sL 2 := by
 obtain ⟨y,_,z⟩:= Young Uq hp.seed u
 have k:=hk.audit Uq hT bt
 have p1:=hk.book.capped
