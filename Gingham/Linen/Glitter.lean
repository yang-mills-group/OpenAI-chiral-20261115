lemma Article.pays_U0 (pB:Cl (β:ℂ) (F,0)):
 Glazes ((Art).Eτ (β:ℂ) (F,0)).1 p h Lunar.shield (bill_tap p.B) := by
 have k:= (billingReal Tu Ty Vq hv T.fair β F).1
 have h₁:= (matured Ty T Vq hv (β:ℂ) pB).1
 have H:=glitter_more T.toFocus Ty (T.member h₁ pB.1) Vq hv T.fair
     (h₁.mono (by have h:=T.buy;linarith)) (T.ledge _ pB.1)
 exact (congrArg (fun z=> Glazes z.1 p h Lunar.shield (bill_tap p.B)) k).mpr H
