lemma glitter_more (hz'β:(β:ℂ) ∈ ℓ'): Glazes (pre_E (p:=p) (p':=p') (o:=o) Ty hz' (Banker.Phi Z (β:ℂ) F) F) p h Lunar.shield (bill_tap p.B):=by
