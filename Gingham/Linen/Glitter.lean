 let Vg:=Banker.trustI Z Pp Q M X hz'β hX
 let hs:= Uq.yieldsSpirit Ty Q (tF.mono Uq.cost) (@Z.pond (Z.toLid.scaler Q)) Vg
 let A:=tapped p o Ty (Banker.Phi Z (β:ℂ) F)
 refine ⟨A,polonaise Uq Ty hX hs hγ rfl, ?_⟩
 intro j g; have hs:=shone Uq Ty Q hz' hm tF j g
 funext V'
 change minusO (A j V')= minusO (((A+ noncash_E (p:=p) (p':=p') (o:=o) hz' F) j) V')
 rw [Pi.add_apply,hs,add_zero]

