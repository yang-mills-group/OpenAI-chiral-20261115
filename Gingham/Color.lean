-- Link-independent (= X PureMatter) even on all consultations of
-- native mesh. Reflection, shifts and hence grid with no promotion stay there.

lemma wreath (F:P.Test)(p:PureMatter K F)(a:Axis): PureMatter K (P.reflectTest a F):=
   fun n x y=>congrArg (theta (carR a 0 _)) (p n (reflFields a 0 x) (reflFields a 0 y))

lemma mathur (j:Axis)(v:ℤ)(F:P.Test)(p:PureMatter K F):
    PureMatter K (P.shifts j v F):=by
  let Z:=P.reflectTest j F
  have t:=wreath P F p j
  let b:=gaugeT K v
  intro n x y
  exact congrArg (theta (carR j b _))
    (t n (reflFields j b x) (reflFields j b y))

lemma requestNative (t:ℕ)(B:P.Apron)
    (k: t=B.s)(h:PureMatter K B.F)(F:SampleDose):
    PureMatter K (P.prepared t B F):=by
  have u : B.full P t=B.F:= by unfold Apron.full; rw [k,Nat.sub_self]; rfl
  have e (k:Cover)(L:List Axis):PureMatter K (P.cruise L k B.F):=by
    induction L with
    | nil=>exact h
    | cons i l ih=>
       rw [P.cruise_step,AlgHom.comp_apply]
       exact mathur P i _ _ ih
  unfold prepared
  refine (matterPlane K).sum_mem fun k _=>(matterPlane K).smul_mem _ ?_
  rw [issuing,u]
  exact e k _

variable (x:P.Spectrum0 3)
local notation "ξ"=> P.advocate 3 x 3
local notation "𝓢"=> P.seasons 3 ξ
local notation "D"=> (𝓢).muslin
local notation "Ω"=> P.firstTulle 3 ξ
local notation "𝐄"=> Module.End ℂ D
local notation "𝓟"=> pelisse P x

/-- true G, false M. Matter sector requires enough stages even
for cofinally many uncompromised (not link-transported) pairings. -/
def clean : Bool→ Hook P x→ Prop
  | true => fun b=> ∀ᶠ i in atTop, PureGauge K (b.arms.fieldA i).F
  | false => fun b=> (∀ᶠ i in atTop, PureMatter K (b.arms.fieldA i).F) ∧
               Tendsto (fun i=>(b.arms.fieldA i).s) atTop atTop

lemma luminous {j:Bool}{b:Hook P x}(p:clean P x j b) : clean P x j (b.west P x):=
   match j with
   | true => p.mono fun _ h=>P.reflect_keepsPure h 3
   | false => ⟨p.1.mono fun _ h=>wreath P _ h 3,p.2⟩

variable (j:Bool)
abbrev Stalk := {b//clean P x j b}
abbrev estateField (b:Stalk P x j) := 𝓟 b

-- Pocket in real coordinates O (ideally bounded), placement tsupport sample ⊆
abbrev estate (O:Set E4):Subalgebra ℂ 𝐄:= pocket (estateField P x j) O

lemma estate_seeds {b:Hook P x}(c:clean P x j b) {f:Test4}{O:Set E4}
    (k:tsupport f ⊆ O) :
    𝓟 b f ∈ estate P x j O :=
   @grove_seed _ _ _ _ (estateField P x j) _ ⟨b,c⟩ _ k -- tune

lemma estate_books : (𝓢).Fray (fun b:Stalk P x j=>toll P x b)
    (estateField P x j):=
   ⟨fun b=> collects P x b, fun b=>
     ⟨⟨b.val.west P x, luminous P x b.property⟩,
       Eventually.of_forall (toll_adj P x b.val)⟩⟩

lemma estate_inside (O:Set E4) : estate P x j O ≤ pocket 𝓟 O :=
  Algebra.adjoin_mono (by rintro _ ⟨i,f,p,rfl⟩; exact ⟨i.val,f,p,rfl⟩)

lemma estate_faces (O:Set E4) {X:𝐄} (e:X∈estate P x j O):
    (𝓢).Firm X ∧ ∃Y∈estate P x j O,(𝓢).Faces X Y:=
  pocket_faces (estate_books P x j) O e




def PriceFn : 𝐄 →ₗ[ℂ] ℂ:=
 (((innerSL ℂ (P.heaven 3 ξ)).toLinearMap).comp ((𝓢).muslin.subtype)).comp
    (LinearMap.flip (LinearMap.id : 𝐄→ₗ[ℂ]𝐄) Ω)

def ActualMarginal (O:Set E4): estate P x j O →ₗ[ℂ] ℂ:=
    (PriceFn P x).comp (estate P x j O).val.toLinearMap

/-- On inputs here even if a raw presentation includes coincident channels
with the other sector; not a split on labelled mixed fields. -/
def two_reads {O B:Set E4}
    (L : estate P x true O) (R : estate P x false B) : ℂ × ℂ :=
    (PriceFn P x (L.val * R.val),
       ActualMarginal P x true O L * ActualMarginal P x false B R)

lemma two_open {O B:Set E4}
    (L:estate P x true O)(R:estate P x false B):
    two_reads P x L R =
     (rcoupled 𝓢 Ω L.val R.val,rforecast 𝓢 Ω L.val R.val):=rfl


theorem two_unique {O B:Set E4} (s:IsCompact (closure B))
    (L L':estate P x true O)(R R':estate P x false B)
    (e:EqOn ⇑L.val ⇑L'.val (here P x))
    (v:EqOn ⇑R.val ⇑R'.val (here P x)) :
    two_reads P x L R=two_reads P x L' R':=by
  have h:R.val∈pocket 𝓟 B:= estate_inside P x false B R.property
  have h':R.val Ω∈here P x:=by
    exact ⟨_,grove_mono (fun f (z: f∈placement B)=>
      s.of_isClosed_subset isClosed_closure
        ((show tsupport f ⊆ B from z).trans subset_closure)) h,rfl⟩
  obtain ⟨g,t⟩:=descend_real P x e v h'
  rw [two_open,two_open,g,t]


/-- These are now the separate-sector operands, in particular
the two crossed calculations. Include poses through foldSpace.
Neighborhood compactness in E4 also follows via the homeomorphism. -/
theorem belongs (a:Weave)
    (g m:Hook P x)(c:clean P x true g)(u:clean P x false m):
    RealLeft P x a (𝓟 g) ∈ estate P x true (foldSpace ⁻¹' a.ra) ∧
    RealRight P x a (𝓟 m) ∈ estate P x false (foldSpace ⁻¹' a.rb):=by
  unfold RealLeft RealRight
  refine ⟨estate_seeds P x _ c ?_, estate_seeds P x _ u ?_⟩
  · rw [sachet_support];exact preimage_mono a.ta
  rw [sachet_support];exact preimage_mono a.tb

lemma in_bounded (U:Set Vantage)(b:IsCompact (closure U)):
    IsCompact (closure (foldSpace ⁻¹' U)):= by
  rw [show closure (foldSpace ⁻¹' U) = foldSpace.symm '' (closure U) from ?_]
  · exact b.image foldSpace.symm.continuous
  refine (foldSpace.toHomeomorph.preimage_closure U).symm.trans ?_
  apply Set.Subset.antisymm
  · exact fun y h=>⟨_,h,foldSpace.symm_apply_apply _⟩
  rintro y ⟨v,h,rfl⟩ -- rintro perhaps only two binders? subset intro {a}
  change foldSpace (foldSpace.symm v)∈closure U
  rw [foldSpace.apply_symm_apply]
  exact h


variable (a:Weave)(g m:Hook P x)
local notation "Gᵢ"=> BlotAt a P x g
local notation "Mᵢ"=> WellAt a P x m
local notation "Ξ"=> P.thinSplit x

/-- Simultaneous two-input prices, pure stages =
G unscaled stamps pure at their own printing height (.s i),
matter likewise at .s k≥.s i, consult there. -/
abbrev NativeHeight (i k t:ℕ):Prop :=
   (g.arms.fieldA i).s ≤ t ∧ t=(m.arms.fieldA k).s

def SameForecast (i k t:ℕ):Prop :=
    PureGauge K (Gᵢ i t) ∧ PureMatter K (Mᵢ k t) ∧
    guess (GridEu a P x g m i k t) =
      Ξ t (Gᵢ i t * Mᵢ k t)

/-- Any promoted-to-t gauge appointment with same height,
and a non-promoted matter appointment -- including P.thinSplit with exactly the
same material responses by Comparison. -/
lemma comparator_receipt (i k t:ℕ)
    (h:NativeHeight P x g m i k t)
    (gauge:PureGauge K (g.arms.fieldA i).F)
    (matter:PureMatter K (m.arms.fieldA k).F):
    SameForecast P x a g m i k t:=by
  have g':PureGauge K (Gᵢ i t):= (gaugePlane K).smul_mem _
    (P.prepare_pure _ _ gauge _)
  have m':PureMatter K (Mᵢ k t):=(matterPlane K).smul_mem _
    (requestNative P t (m.arms.fieldA k) h.2 matter _)
  refine ⟨g',m',?_⟩
  have u:=(P.thin_comparator_LocalFieldBounds x t).1
  rw [u.factors _ _ g' m',u.link _ g',u.matter _ m']
  rfl

lemma cofinal_native (p:clean P x false m) (i k:ℕ):
    ∃ j t : ℕ, k ≤ j ∧ k ≤ t ∧ NativeHeight P x g m i j t:=by
   obtain ⟨j,h,v⟩:= ((eventually_ge_atTop k).and (p.2.eventually
     (eventually_ge_atTop (max k (g.arms.fieldA i).s)))).exists
   exact ⟨j,_,h,(le_max_left ..).trans v,(le_max_right ..).trans v,rfl⟩

lemma kept_forecast (g':clean P x true g)(m':clean P x false m):
    ∃ k:ℕ, ∀ i j t:ℕ, k ≤ i→k ≤ j →
      NativeHeight P x g m i j t → SameForecast P x a g m i j t:=by
   obtain ⟨k,w⟩:= eventually_atTop.mp g'
   obtain ⟨v,t⟩:= eventually_atTop.mp m'.1
   exact ⟨max k v,fun i j u b c h=>
     comparator_receipt P x a g m i j u h (w i ((le_max_left ..).trans b))
       (t j ((le_max_right ..).trans c))⟩

structure IntrinsicTwo (δ:ℝ):Prop where
  eye : Scrive a
  isgauge : clean P x true g
  ismatter : clean P x false m
  gloria : Glory a P x g m δ
  split :
    ∃ k:ℕ, ∀ i j t:ℕ, k ≤ i→k ≤ j →
      NativeHeight P x g m i j t → SameForecast P x a g m i j t
  cofinal (i k:ℕ) :
    ∃ j t : ℕ, k ≤ j ∧ k ≤ t ∧ NativeHeight P x g m i j t

/-- Genuine detector if the two-input prices have the proposed bills.
No **change of preparations** whatsoever from this elected x,
and operands in the separate persistence sectors. Same budget entails
extra raw nondecoupling as a *consequence*, along NativeHeight visits.
The books for this assessment are on the actual sector inputs themselves;
the real reading (same forecast value as Eu even though different slot
protocol, tied by same fields and positive price charges) is even on
the real algebra at this smeared choice (Campus), in these two separate
subalgebras. -/
theorem div_income (J:P.Ellis 3 x)(g':clean P x true g)
    {I:Type}(Mm:I→Hook P x)(t':∀i,clean P x false (Mm i))
    (e:mistrial 𝓢 (P.heaven 3 ξ) (toll P x g) (toll P x ∘ Mm)):
    ∃ a δ i, IntrinsicTwo P x a (g.west P x) (Mm i) δ :=by
   obtain ⟨i,a,h⟩:= assigns P x g Mm e
   have g'' := luminous P x g'
   obtain ⟨δ,v⟩:= blush a P x (g.west P x) (Mm i) J h

   exact ⟨a,δ,i,h.1,g'',t' i,v,kept_forecast P x a _ _ g'' (t' i),
     cofinal_native P x _ _ (t' i)⟩

