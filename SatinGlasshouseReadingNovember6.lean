import YM.SU5.Six.PressSmear
import YM.SU5.Selected.Sustain

/-! The Glasshouse display and the thin-probe experiment compress exactly the
same marked words when given the same physical Spine, room, and reference axis. -/
set_option autoImplicit false
set_option synthInstance.maxSize 26000
set_option maxRecDepth 4000
set_option maxHeartbeats 400000
noncomputable section
namespace YM.CF.Buffered.Afterglow.Tower.VacuumSelection
open Function Filter Metric NormedSpace SU Lat Lattice Wilson Cube Finset Mir Phase MeasureTheory RP Reflect Advance Nacre Spire Scroll Peaks Rush Tulip Skye Window Vale Girt
open Push.SectorMeasure RG Lifted Scree ProbabilityTheory Py Py.Rate LocalLimit FullBill Sound Common Ballad Cordial
open scoped Topology Matrix MatrixOrder Matrix.Norms.L2Operator BigOperators Kronecker ComplexOrder InnerProductSpace NNReal ENNReal Classical
attribute [local instance] opCStarAlgebra
open Preparation Journey Satin Fock Analysis SlabMark MeshClock SatinVerification Vacancy Tapestry
namespace Spine

/-- The CP27 display algebra on this course and room is exactly the CP18
compression algebra. Both are the closed star algebra generated by the same
raw marked words at every level. -/
theorem glasshouseDisplay_eq (P : Spine) (j : Axis) :
    Selected.displayAlgebra P.run P.large P.law P.history P.projection.clipped j false (P.room j) =
      P.compressionAlgebra j := by
  have words : Set.range (Selected.instrument P.run P.large P.law P.history P.projection.clipped
        j false (P.room j)) = Set.range (P.labelled j) := by
    ext z
    constructor
    · rintro ⟨⟨s, m⟩, rfl⟩
      exact ⟨(s, ⟨m.val, m.property.1⟩), rfl⟩
    · rintro ⟨⟨s, f⟩, rfl⟩
      exact ⟨(s, P.obs f), rfl⟩
  unfold Selected.displayAlgebra compressionAlgebra
  rw [words]

def glasshouseCharacter (P : Spine) (j : Axis) (x : P.Spectrum0 j) :
    Selected.displayAlgebra P.run P.large P.law P.history P.projection.clipped j false (P.room j) →⋆ₐ[ℂ] ℂ :=
  (P.chi j x).comp (StarSubalgebra.inclusion (P.glasshouseDisplay_eq j).le)

def glasshouseMark (P : Spine) (f : P.Test) : Selected.Marks P.calibration false :=
  ⟨f.val, f.property, by simp⟩

/-- The actual smeared insertion also qualifies in the stricter, gauge-covariant
mark algebra used for the physical field registration problem. -/
def glasshouseStrictPrepared (P : Spine) (t : ℕ) (B : P.Apron) (F : SampleDose) :
    Selected.Marks P.calibration true :=
  ⟨(P.prepared t B F).val, (P.prepared t B F).property,
    fun _ => (enclave_spec P.calibration).mp (P.prepared_color t B F)⟩

theorem glasshouseStrictPrepared_val (P : Spine) (t : ℕ) (B : P.Apron) (F : SampleDose) :
    (P.glasshouseStrictPrepared t B F).val = (P.prepared t B F).val := rfl

/-- Exact equality for every marked reading, on this very character.
In particular both given smears and their ordered product can be substituted. -/
theorem glasshouseResponse_eq (P : Spine) (j : Axis) (x : P.Spectrum0 j) (t : ℕ) (f : P.Test) :
    Selected.response P.run P.large P.law t P.history P.projection.clipped j false (P.room j)
      (P.glasshouseCharacter j x) (P.glasshouseMark f) = P.singleState j t x f := rfl

end Spine
end YM.CF.Buffered.Afterglow.Tower.VacuumSelection
