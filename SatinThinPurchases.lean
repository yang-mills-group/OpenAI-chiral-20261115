/-- Instead of the manuscript's intermediate rate, we can go almost all the
way to dleaf in this test. Unlike a fixed multiple of allotΨ, the expense
remains ample for the fanout-economies even after choosing their constants. -/
abbrev colorsPhi (L : Side)(D : ℝ) (x:ℝ):= (1+|Sauce HI D|)⁻¹*dleaf L x
abbrev tileFee (c:Estimate)(x:ℝ)(k:ℝ):= 2*(c.F x+k)
abbrev tileSmall (c:Estimate)(R:Patch)(x:ℝ)(k b:ℝ):= c.small x+2*b*value_ R x k

lemma colors_size (P:Patch)(C:ℝ) : sizeK P.L 2 (colorsPhi P.L C) := (dev_R P).1.scale _
lemma colors_more (P:Patch)(C:ℝ)(f:ℝ) : ∀ᶠ x:ℝ in atTop,f * allotΨ P.L x ≤ colorsPhi P.L C x:=by
 let q:= (1+|Sauce HI C|)⁻¹; have hp:0<q:=by unfold q; positivity
 filter_upwards [(stockpile_ν (R:=P)),eventually_gt_atTop (0:ℝ),((clove_p P).spine_a.const_mul f).eventually (ge_mem_nhds (show f*(0:ℝ)< q by simpa))] with x k t r
 let g:=Scales.g SU.group P.L x; change f*(g/_)≤ q at r; have hx:= Work.E09.temp_pos t; have hg:0 < g:= k.2.1
 change f*g^2 ≤q*(g*temp x); rw [←mul_div_assoc] at r; have he:=(div_le_iff₀ hx).mp r; nlinarith only [mul_le_mul_of_nonneg_left he hg.le]

