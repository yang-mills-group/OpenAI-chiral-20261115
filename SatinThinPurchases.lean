structure PaySlip (R:Patch)(c:Estimate)(k b z:ℝ)(x:ℝ):Prop where
 tile : degreePrice (radiusB x) (tileFee c x k) 1 < 1
 colorsBig : 2*c.F x≤ tileFee c x k ∧2*k≤tileFee c x k
 cv:0≤ c.F x
 stampS : rainX R 2 x * (2*b) ≤ 1
 rain : 1 ≤ rainX R 1 x ∧rainX R 1 x ≤ rainX R 2 x
 sauce : Sauce HI z * colorsPhi R.L z x ≤ εLeaf R.L x
 price:0 < colorsPhi R.L z x ∧3*dleaf R.L x+colorsPhi R.L z x ≤ εLeaf R.L x
 boom : 10≤radiusB x ∧10≤radiusB (x+ Vale.billX R.L) ∧2*R.L.val^2<radiusB x
 heat : εLeaf R.L x ≤1
lemma color_spending (vτ:ℝ) : ∀ᶠ x:ℝ in atTop, PaySlip R c (Fσ x) (E_s x) vτ x:= by
 have hk:= prizeQ (R:=R) (prizeQ ((Hκ.heat 3).scale 2)) -- σ index. hv≥. exponent order supply
 let T:= 1+|Sauce HI vτ|; have ht:1 ≤ T:= le_add_of_nonneg_right (abs_nonneg _); have he:0<T:= zero_lt_one.trans_le ht
 filter_upwards [(cash_tile Hκ).2.1,Hκ.warm,Hκ.warmK, (spice_R (R:=R)),stockpile_ν (R:=R),(minute SU.group R.L).eventually (ge_mem_nhds zero_lt_one), hk.spine.eventually (ge_mem_nhds zero_lt_one), Work.E01.radiusB_tendsto.eventually_ge_atTop (2*R.L.val^2+10), thermal_A (Vale.billX R.L),(Stockpile.low (R:=R)).low (k:=1) (by norm_num)|>.spine.eventually (ge_mem_nhds zero_lt_one)] with x hp hv hv' pu p t e k δu yH
 have hs:=p.2.2.1; have hx:0 < dleaf R.L x:=pos_of_mul_pos_right hs (by norm_num); let v:= Scales.g SU.group R.L x; have hq :0<v:=p.2.1
 refine ⟨lt_of_le_of_lt hp.2 (by norm_num : (1/2:ℝ)<1),⟨?_,?_⟩,hv.1.le,?_ ,?_,?_,⟨?_,?_⟩,⟨by omega,δu,by omega⟩,yH⟩
 · unfold tileFee; linarith only [hv'.1]
 · unfold tileFee; linarith only [hv.1]
 · change (v^2)⁻¹* (2*E_s x)≤1; rw [←inv_pow,pow_two,mul_assoc]; exact e
 · exact ⟨rain_one _ _ p.1 t, inv_anti₀ (pow_pos hq 2) (pow_le_pow_of_le_one hq.le t (by decide:(1:ℕ)≤2))⟩
 · have hq':Sauce HI vτ ≤ T:= (le_abs_self _).trans (le_add_of_nonneg_left zero_le_one); refine le_trans (mul_le_mul_of_nonneg_right hq' (mul_nonneg (inv_pos.mpr he).le hx.le)) ?_; unfold colorsPhi εLeaf; rw [show T*( _* dleaf R.L x)=dleaf R.L x from (by rw [←mul_assoc,show T*T⁻¹=1 from mul_inv_cancel₀ he.ne',one_mul])]; linarith only [hx]
 · exact mul_pos (inv_pos.mpr he) hx
 · have hv: T⁻¹≤1:= inv_le_one_of_one_le₀ ht; unfold colorsPhi εLeaf; nlinarith only [mul_le_mul_of_nonneg_right hv hx.le,hx]

