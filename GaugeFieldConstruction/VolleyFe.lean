lemma ΞCorralFe : ∃ X: ℕ→ (Module.End ℂ (FrameK (RootS J' dΩ))), (∀ᶠ f in atTop,(Bf f= (JoltFe p B0 M R pu A D m Sq Wp dΩ L0 J' f).comp (X f)) ∧ Bijective (X f))∧∀ v,Tendsto (fun f=> X f v) atTop (𝓝 v):=by
 obtain ⟨c,t0,pt,u,pR⟩:= SweetRankR p B0 M pu A D Q t u' H m J' dΩ Sq Wp pMm false L0
 let OK(k:ℕ):Prop:=∃ g:f0 ≤ k, claims_R p B0 M 0 pu A D m J' dΩ Sq Wp false L0 g c t0 R
 have hp:∀ᶠ f in atTop,OK f:= (pR.and (eventually_ge_atTop f0)).mono fun i v=>⟨v.2,v.1 0 R v.2⟩
 let Θ:=ΝPlanR p B0 M 0 pu A D Sq Wp dΩ
 have ht(f:ℕ)(h:OK f):∃ G:Module.End ℂ (FrameK (RootS J' dΩ)), Bf f=(JoltFe p B0 M R pu A D m Sq Wp dΩ L0 J' f).comp G:=by
    obtain ⟨g,q,w,H⟩:=h
    let F:=PaneKeyR p B0 M 0 pu A D m J' dΩ Sq Wp R g false L0
    have hz(v:FrameK (RootS J' dΩ)): (Mζ f v).val=F v:=JoltFe_v ..
    have he: Injective (Mζ f):=fun i j t=> q ((hz i).symm.trans ((congrArg Subtype.val t).trans (hz j)))
    have hx(vK:Θν):∃ x,Mζ f x=Bf f vK:=by let H:=Bf f vK; obtain ⟨z,u⟩:=show H.val∈LinearMap.range F from w.symm ▸ (show H.val∈Utf0P Θ from ⟨H.property,Bc f vK⟩); exact ⟨z,Subtype.ext ((hz _).trans u)⟩
    choose G t using hx
    let X:Module.End ℂ (FrameK (RootS J' dΩ)) :={
      toFun:= G
      map_add':= fun a b => by apply he; rw [map_add,t,t,t,map_add]
      map_smul':= fun z x => by apply he; rw [map_smul,t,t,map_smul]; try rfl }
    exact ⟨X,LinearMap.ext fun i=> (t i).symm⟩
 choose G pG using ht; let X(f:ℕ):Module.End ℂ (FrameK (RootS J' dΩ)):= if v:OK f then G _ v else 0
 have ht:∀ᶠ f in atTop,Bf f=(Mζ f).comp (X f):= hp.mono (fun i v=>by unfold X; rw[dif_pos v]; exact pG ..)
 have hw(v:FrameK (RootS J' dΩ)):Tendsto (fun f=> X f v) atTop (𝓝 v):=by
    apply tendsto_iff_dist_tendsto_zero.mpr
    let Y(f:ℕ):= (GapHeightR P f (Bf f v).val-GapHeightR P f (Mζ f v).val)
    have e:Tendsto (fun f=> c⁻¹*‖Y f‖) atTop (𝓝 0):=by simpa only[norm_zero,mul_zero] using (Bn v).norm.const_mul (c⁻¹)
    apply squeeze_zero' (Eventually.of_forall fun i=> dist_nonneg) ?_ e
    filter_upwards [ht,hp] with f F h; obtain ⟨g,_,a,H⟩:= h
    let U:= ΥGapFe P (ΝPlanR p B0 M 0 pu A D Sq Wp dΩ) f
    let v':= X f v-v; let F':= PaneKeyR p B0 M 0 pu A D m J' dΩ Sq Wp R g false L0
    have he: Y f= U (Mζ f v'):=by unfold Y v'; rw [map_sub,map_sub,F]; rfl
    rw [dist_eq_norm,he,mul_comm, ← div_eq_mul_inv, le_div_iff₀ pt,mul_comm]; change c*‖v'‖≤ ‖GapHeightR P f (Mζ f v').val‖; rw[JoltFe_v p B0 M R pu A D m Sq Wp dΩ L0 J' v' g]; exact (H v').1 -- tune
 exact ⟨X, ht.and (NearIsoFe X hw), hw⟩
