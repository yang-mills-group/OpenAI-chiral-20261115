lemma ask_consQ (x:P.VMark)(X:Fin n→P.VMark): AskR P (Fin.cons x X)= Fin.cons (fun i=>(x i:ℝ)) (AskR P X):=by funext i; cases i using Fin.cases <;> simp [AskR,clearAbove] -- inspect
lemma MasksTailQ (x y:Axis→ℝ)(X:Fin n→Axis→ℝ)(h:Fin.cons x (Fin.cons y X)∈ MasksR (Fin (n+2))): Fin.cons x X ∈ MasksR (Fin (n+1)):=by
 intro i z w hv
 let e:Fin (n+1) → Fin (n+2):= (1: Fin (n+2)).succAbove
 have he(t:Fin (n+1)): (show Fin (n+1)→Axis→ℝ from Fin.cons x X) t=(show Fin (n+2)→Axis→ℝ from Fin.cons x (Fin.cons y X)) (e t):=by cases t using Fin.cases <;> simp [e] -- tune
 change ((show Fin (n+1)→Axis→ℝ from Fin.cons x X) z) i=((show Fin (n+1)→Axis→ℝ from Fin.cons x X) w) i at hv; rw[he,he w] at hv; exact Fin.succAbove_right_injective (show e z=e w from h i hv)
lemma CopperbackQ (X:Fin n→P.VMark)(h:AskR P (PHealthCQ Z X)∈ MasksR (Fin (n+2))): AskR P (Fin.cons (Z false) X)∈ MasksR (Fin (n+1)):=by
