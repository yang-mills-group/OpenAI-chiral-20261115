lemma nullΦFe(P:Spine)(n:ℕ):FearΘFe (fun _ (_:CoinsR P)(_ :Points n)=>0) 0:=⟨fun _ _=>continuousOn_const, continuousOn_const, fun K Q t=>⟨0,le_rfl,Eventually.of_forall fun i c x u=>by simp⟩,fun K x h ε e=> Eventually.of_forall fun i c p v=> by simpa using e.le⟩
lemma StoryFinFe {W:Type}(S:Finset W)(F:W→ κYFeS P n)(X:W→Points n→ℂ)(p:∀ i,FearΘFe (F i) (X i)) : FearΘFe (fun k C=> ∑ i∈ S,F i k C) (∑ i∈S,X i):=by
