lemma modifies (p:FearΘFe F X)(h:∀ k C, ContinuousOn (G k C) (B_Esc n))(e:Set.EqOn X Y (B_Esc n))(q:∀ᶠ k in atTop,∀ C,Set.EqOn (F k C) (G k C) (B_Esc n)): FearΘFe G Y:=by
 refine ⟨h,p.contS.congr e.symm,fun K s t=> ?_,fun K s t ε e'=>?_⟩
 · obtain ⟨b,g,x⟩:=p.thick K s t; refine ⟨b,g,(x.and q).mono fun i v c j H=>?_⟩; rw[←v.2 c (t H)]; exact v.1 c j H
 filter_upwards[p.costs K s t ε e',q] with i H y c x hp; rw[← e (t hp.1),← y c (t hp.1)]; exact H c x hp
lemma plus (p:FearΘFe F X)(q:FearΘFe G Y): FearΘFe (fun f C=>F f C+G f C) (X+Y):=by
 refine ⟨fun k C=> (p.contY k C).add (q.contY k C),p.contS.add q.contS, fun K s t=>?_, fun K s t ε e=>?_⟩
 · obtain ⟨b,g,x⟩:= p.thick K s t; obtain ⟨c,u,h⟩:= q.thick K s t
   refine ⟨b+c,add_nonneg g u,(x.and h).mono (fun i v C j H=>?_)⟩; exact (norm_add_le ..).trans ((add_le_add (v.1 C j H) (v.2 C j H)).trans_eq (_root_.add_mul ..).symm)
 filter_upwards [p.costs K s t (ε/2) (by positivity),q.costs K s t (ε/2) (by positivity)] with i r v C j u
 change ‖F i C j + G i C j- (X j+Y j)‖≤ _; rw [show F i C j+G i C j- (X j+Y j)= (F i C j-X j)+(G i C j-Y j) from (by ring)]; exact (norm_add_le ..).trans ((add_le_add (r C j u) (v C j u)).trans_eq (add_halves _))
lemma scala (p:FearΘFe F X)(a:ℂ)(v:ℕ→ℂ)(w:Tendsto v atTop (𝓝 a)): FearΘFe (fun f C x=> v f * F f C x) (fun i=> a*X i):=by
 let V:=‖a‖+1; have hv:0<V:=add_pos_of_nonneg_of_pos (norm_nonneg _) one_pos
 have hx:∀ᶠ f in atTop, ‖v f‖≤V:=w.norm.eventually (ge_mem_nhds (lt_add_one _))
 refine ⟨fun k C=>continuousOn_const.mul (p.contY k C),continuousOn_const.mul p.contS, fun K s t=> ?_, fun K s t ε e=>?_⟩
 · obtain ⟨b,h,q⟩:=p.thick K s t; refine ⟨V*b,mul_nonneg hv.le h,(hx.and q).mono (fun i h C s u=>?_ )⟩; rw[norm_mul]; apply le_trans (mul_le_mul h.1 (h.2 _ s u) (norm_nonneg _) hv.le); exact le_of_eq (mul_assoc ..).symm
 obtain ⟨R,g⟩:= s.exists_bound_of_continuousOn (p.contS.mono t); let C:= ‖R‖+1; have hR:0<C:=add_pos_of_nonneg_of_pos (norm_nonneg _) one_pos
 filter_upwards[hx,p.costs K s t (ε/2/V) (by positivity),Metric.tendsto_nhds.mp w (ε/2/C) (by positivity)] with k H X' j B u y
 let T:=F k B u; let Y:=X u
 rw [show v k*F k B u-a*X u=v k*(T-Y)+(v k-a)*Y from (by unfold T Y; ring)]; apply le_trans (norm_add_le _ _)
 rw [norm_mul,norm_mul]
 have hz: ‖v k‖*‖T-Y‖≤ε/2:=(mul_le_mul H (X' _ _ y) (norm_nonneg _) hv.le).trans_eq (by field_simp)
 have hx: ‖v k-a‖*‖Y‖≤ ε/2:=by
   rw [dist_eq_norm] at j
   apply le_trans (mul_le_mul j.le (show ‖Y‖ ≤ C from ((g u y.1).trans (le_abs_self R)).trans ((lt_add_one _).le)) (norm_nonneg _) (by positivity)); exact le_of_eq (div_mul_cancel₀ _ hR.ne')
 exact (add_le_add hz hx).trans_eq (add_halves _)
