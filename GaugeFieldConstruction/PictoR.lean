open Submodule
abbrev D_r := GaugeFieldConstruction.Calibration.Floor
abbrev ΤbandR (d:D_r): BandS:= ⟨metK d,(by cases d <;> decide)⟩
lemma normandR (d:D_r):3+(ΤbandR d).val= aptC d:=by cases d <;> rfl
abbrev UniComR (d:D_r) : Submodule ℂ GaugeFieldConstruction.Calibration.Shell:=LinearMap.range (shells d) ⊓ LinearMap.ker (LinearMap.fst ℂ _ _)
lemma uniCR (d:D_r)(S:GaugeFieldConstruction.Calibration.Shell) : S∈ UniComR d↔S∈ Umatrix d:=by change (_∧ S.1=0)↔ S.1=0∧ _; exact and_comm
abbrev LevelRiseR (W: Waves)(d:D_r):Prop:=LegL W d
lemma HorseR (W:Waves) (d:D_r)(A:Genre)(H:HomΓ A d W): LegL W d:=by
 cases d with
 | three=> exact (leg_3 _).2 H.2.2
 | four=> exact (leg_4 _).2 H.2.2.2
 | five=> exact leg_5 _
lemma sortNatR (W: Waves)(a b:D_r)(p:ΤbandR a ≤ ΤbandR b)(q:LegL W a):LegL W b:=by
 have he:= MGate (show metK a ≤ metK b from p) W; rw [show ΓProj (metK a) W=W from q] at he; exact he
-- finite via range bound. no topology on Wick Shell.
abbrev BezelR:= Genre × D_r × Waves
abbrev ZeckR (A:BezelR):= SpineM A.2.2
abbrev PerlSetR (d:D_r):Set BezelR := {A| HomΓ A.1 A.2.1 A.2.2∧ ΤbandR A.2.1 ≤ ΤbandR d}
private lemma RepH {A B C D E F:Type}[AddCommGroup A][AddCommGroup B][AddCommGroup C][AddCommGroup D][AddCommGroup E][AddCommGroup F](x:A)(k:B×C)(v:D×E×F): ((x,k,(0:D×E×F)):(A×(B×C)×D×E×F))=(x,0)+(0,(k.1,0),0)+(0,(0,k.2),0) ∧ (x,k,v)=(x,0)+(0,(k.1,0),0)+(0,(0,k.2),0)+(0,0,v.1,0)+(0,0,0,v.2.1,0)+(0,0,0,0,v.2.2):=by rcases k with ⟨i,j⟩; rcases v with ⟨y,t,w⟩; apply And.intro <;> ext <;> simp -- tune
private lemma crest_vR (A:D_r):span ℂ (ZeckR '' PerlSetR A) = UniComR A:=by
 let S:=span ℂ (ZeckR '' PerlSetR A); have h(x:Waves)(s:D_r)(V:Genre)(q:ΤbandR s≤ΤbandR A)(p:HomΓ V s x):SpineM x∈ S:= subset_span (show ∃ c∈ PerlSetR A, ZeckR c=SpineM x from ⟨(V,s,x),⟨p,q⟩,rfl⟩)
 refine le_antisymm (Submodule.span_le.mpr ?_) (fun i vS=>?_)
 · rintro i ⟨⟨k,q,p⟩,⟨t,z⟩,rfl⟩; exact (uniCR A _).mpr (harbour A _ (sortNatR p q A z (HorseR p q k t)))
 obtain ⟨X,hp,e⟩:= portPic i A ((uniCR A _).1 vS); subst i; change SpineM X∈S
 obtain ⟨x,y⟩:= X
 have ht: ΤbandR three≤ΤbandR A:=by cases A <;> decide
 let P: Waves:= (x,0)
 have hP:SpineM P∈S:= h P three .pure ht ⟨⟨rfl,rfl,rfl⟩,rfl,rfl⟩
 rcases y with ⟨k,v⟩
 cases A with
 | three=> rw[show (k,v)=(0:J4 × J5) from (leg_3 _).1 hp]; exact hP
 | four=>
   rw [show v=0 from (leg_4 _).1 hp]; let Q: Waves:= (0,(k.1,0),0); let F: Waves:= (0,(0,k.2),0)
   have hg: SpineM Q∈ S:=h Q four Genre.gauge (le_refl _) ⟨⟨rfl,rfl⟩,(by decide),rfl,rfl⟩
   have hv:SpineM F∈S:=h F four Genre.pure (le_refl _) ⟨⟨rfl,rfl,rfl⟩, (by decide),rfl,rfl⟩
   rw[show ((x,k,(0:J5)):Waves)=P+Q+F from ?_,map_add,map_add]; exact S.add_mem (S.add_mem hP hg) hv
   exact (@RepH _ _ _ _ _ _ PackL.G.toAddCommGroup PackG.G.toAddCommGroup PackP.G.toAddCommGroup PackH.G.toAddCommGroup PackM.G.toAddCommGroup PackS.G.toAddCommGroup x k v).1 -- tune product using ext w explicit T.Kin
 | five=>
   let Q:Waves:=(0,(k.1,0),0); let F:Waves:=(0,(0,k.2),0); let Z:Waves:=(0,0,v.1,0); let L:Waves:=(0,0,0,v.2.1,0); let T:Waves:=(0,0,0,0,v.2.2)
   have hg: SpineM Q∈ S:=h Q four Genre.gauge (by decide) ⟨⟨rfl,rfl⟩,(by decide),rfl,rfl⟩
   have hv:SpineM F∈S:=h F four Genre.pure (by decide) ⟨⟨rfl,rfl,rfl⟩, (by decide),rfl,rfl⟩
   have hp: SpineM Z∈ S:=h Z five .gauge le_rfl ⟨⟨rfl,rfl⟩,rfl,rfl⟩
   have hf: SpineM L∈ S:=h L five .pure le_rfl ⟨⟨rfl,rfl,rfl⟩,rfl,rfl⟩
   have hz: SpineM T∈ S:=h T five .mixed le_rfl ⟨⟨rfl,rfl,rfl⟩,rfl,rfl⟩
   rw [show ((x,k,v):Waves)=P+Q+F+Z+L+T from ?_,map_add,map_add,map_add,map_add,map_add]; exact S.add_mem (S.add_mem (S.add_mem (S.add_mem (S.add_mem hP hg) hv) hp) hf) hz
   exact (@RepH _ _ _ _ _ _ PackL.G.toAddCommGroup PackG.G.toAddCommGroup PackP.G.toAddCommGroup PackH.G.toAddCommGroup PackM.G.toAddCommGroup PackS.G.toAddCommGroup x k v).2
structure InterR where
 B:D_r → Set BezelR
 sat (d:D_r): B d⊆ PerlSetR d
 fre (d:D_r): LinearIndepOn ℂ ZeckR (B d)
 port (d:D_r): span ℂ (ZeckR '' B d)= UniComR d
 rise {d c:D_r}(p:ΤbandR d≤ΤbandR c): B d⊆ B c
lemma victoryR : Nonempty InterR:=by
 have ht(A B:D_r)(q:ΤbandR A≤ΤbandR B) : PerlSetR A ⊆ PerlSetR B:=fun _ h=>⟨h.1,h.2.trans q⟩
 obtain ⟨b₀,b,s,g,w⟩:= exists_linearIndepOn_extension (show LinearIndepOn ℂ ZeckR ∅ from linearIndepOn_empty ..) (Set.empty_subset (PerlSetR three))
 obtain ⟨b₁,h,e,r,K⟩:= exists_linearIndepOn_extension w (b.trans (ht three four (by decide)))
 obtain ⟨b₂,k,p,H,v⟩:= exists_linearIndepOn_extension K (h.trans (ht four five (by decide)))
 let a:D_r → Set BezelR:=fun d=> match d with| .three=> b₀ | .four=> b₁ | .five=> b₂
 have hf(d:D_r) : a d⊆ PerlSetR d:=by cases d; exact b; exact h; exact k
 have hz(d:D_r):Set.image ZeckR (PerlSetR d)⊆ span ℂ (ZeckR '' a d):=by cases d; exact g; exact r; exact H
 refine ⟨a,hf,?_,fun i=> by rw [← crest_vR]; exact le_antisymm (Submodule.span_mono (Set.image_mono (hf i))) (Submodule.span_le.mpr (hz i)),?_⟩
 · intro i; cases i; exact w; exact K; exact v
 intro i j q; cases i <;> cases j <;> try exact Set.Subset.refl _
 all_goals first| exact e.trans p| exact e| exact p| exfalso; revert q; decide
