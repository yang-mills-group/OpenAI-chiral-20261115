noncomputable def BarRayVU (b:JetVU): Module.End ℂ (CrewJetVU p B0 M pu A D Sq Wp dΩ) := LinearMap.prodMap (WaitMU b) (LinearMap.pi (fun i:ℕ=> (ΕΓJUV b).comp (LinearMap.proj i)))
