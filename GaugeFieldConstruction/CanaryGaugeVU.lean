noncomputable def SnapΦVU (i:ℕ): AUV→ₗ[ℂ]P.Test:= (ΚassetVU D i 0).comp ((LinearMap.proj i).comp (LinearMap.snd ..)) -- tune sig
abbrev LateCeilVU (k: ℕ)(z:ℕ→μrayHUV):Prop:=∀ᶠ s in atTop, ΓProj k (z s).1=(z s).1
local notation "ΑΦ"=>SnapΦVU p B0 M pu A D Sq Wp dΩ
abbrev RichCanaryVU (X: AUV):Prop:= LateCeilVU (ΤbandR dΩ).val X.2 ∧ ∀ b:JetVU, VenueX 0 (WaitMUV p B0 M pu A D Q t uH H Sq Wp dΩ b X.1).val (fun i=>SnapΦVU p B0 M pu A D Sq Wp dΩ i (BarRayVU p B0 M pu A D Q t uH H Sq Wp dΩ b X))
local notation "RUV"=> RichCanaryVU p B0 M pu A D Q t uH H Sq Wp dΩ
lemma withBox0VU:RUV 0:= by
    change RUV 0; refine ⟨Eventually.of_forall fun i=>map_zero _,fun b=>?_⟩
    simp only [Prod.fst_zero,map_zero,ZeroMemClass.coe_zero]; simpa only [zero_smul] using VenueZ_S 0 (Unitφ (P:=P) 0) 0
lemma withBox2VU (X Y:AUV)(x:RUV X)(y:RUV Y):RUV (X+Y):=by
    refine ⟨?_,fun b=>?_⟩
    · filter_upwards [x.1,y.1] with i u v; simp only [Prod.snd_add,Pi.add_apply,Prod.fst_add,map_add,u,v] -- tune
    simp only [Prod.fst_add,map_add]; exact VenueX.plus _ (x.2 _) (y.2 _)
lemma withBox1VU (c:ℂ)(X:AUV)(x:RUV X):RUV (c • X):=by
    refine ⟨?_,fun b=>?_⟩
    · filter_upwards[x.1] with i u; change ΓProj _ (c • (X.2 i).1)= c • _; rw[map_smul,u] -- tune
    rw [show (c • X).1 = c • X.1 from rfl,map_smul]; simp only [map_smul]; exact VenueZ_S _ (x.2 _) c
noncomputable def NewCanaryVU: Submodule ℂ AUV where
 carrier:=setOf RUV
 zero_mem':=withBox0VU p B0 M pu A D Q t uH H Sq Wp dΩ
 add_mem':= fun x y => withBox2VU p B0 M pu A D Q t uH H Sq Wp dΩ _ _ x y
 smul_mem':= fun i x h=>withBox1VU p B0 M pu A D Q t uH H Sq Wp dΩ i x h
