abbrev μrayHUV := Waves × ℂ
noncomputable def ΕΓJUV (d:JetVU):Module.End ℂ μrayHUV:= LinearMap.prodMap (ProperWaitVU d) 1
noncomputable def ΚassetVU (s:ℕ) (x:P.VMark):μrayHUV→ₗ[ℂ]P.Test where
 toFun y:=D.M s (P.adventJ x s) y.1+ y.2 • 1
 map_add' a b:=by dsimp only [Prod.fst_add,Prod.snd_add]; rw [map_add,add_smul]; abel
 map_smul' z y:=by change D.M s _ (z • y.1)+(z*y.2) • 1=z • (D.M _ _ y.1+ y.2 • _); rw [map_smul,smul_add,smul_smul]
lemma SaneHeightVU (b:JetVU)(z:ℂ): sailH (PrimeScriptR b.val⁻¹ 0) false z=z:=by unfold sailH; rw [grinDet,←same_charge,b.property]; rfl
noncomputable def WaitMUV(b:JetVU): Module.End ℂ (ΝPlanR p B0 M 0 pu A D Sq Wp dΩ) where
 toFun:=DayShiftP p B0 M pu A D b.val⁻¹ false dΩ Sq Wp
 map_add':= fun x y => DayPlusS p B0 M pu A D Q _ uH H _ _ _ Sq Wp x y
 map_smul':=by intro i z; rw[DayScaleS p B0 M pu A D Q _ uH H,SaneHeightVU]; rfl
local notation "WaitMU"=>WaitMUV p B0 M pu A D Q t uH H Sq Wp dΩ
