variable {f:ℕ}(π: Fin n → Fin f)(pπ:Injective π)
abbrev LeapRFe (π:Fin n→Fin f)(x:Points f):Points n:=points (fun i=> x (π i))
include pπ
lemma CollectFe (x:Points f)(s:x∈B_Esc f): LeapRFe π x∈ B_Esc n:=by obtain ⟨i,h⟩:=Set.mem_iUnion.mp (show ΦplanR f x∈CardsR _ from s); unfold B_Esc; refine Set.mem_iUnion.mpr ⟨i,?_⟩; exact fun i j e=> pπ (h e)
lemma unstripFe (x:Points f)(v:ℝ)(t:x∉StrikeM_S f v):LeapRFe π x∉ StrikeM_S n v:=by
 intro y; obtain ⟨⟨⟨⟨i,j⟩,a⟩,h⟩,g⟩:=Set.mem_iUnion.mp y; exact t (Set.mem_iUnion.mpr ⟨⟨((π i,π j),a), pπ.ne (show i≠j from h)⟩, g⟩)
lemma pullFe (F: κYFeS P n)(V:Points n→ℂ)(v:FearΘFe F V): FearΘFe (fun j C=> F j C ∘ LeapRFe π) (V ∘ LeapRFe π):=by
 let G:= LeapRFe π; have hg:Continuous G:=by unfold G LeapRFe points; fun_prop
 have hy:Set.MapsTo G (B_Esc f) (B_Esc n):=fun x h=> CollectFe π pπ x h
 refine ⟨fun i c=> (v.contY i c).comp hg.continuousOn hy,v.contS.comp hg.continuousOn hy, fun K s tC=> ?_, fun K s tC ε e=>?_⟩
 · let T:=G '' K; obtain ⟨b,h,z⟩:=v.thick T (s.image hg) (by rintro i ⟨x,v,rfl⟩; exact hy (tC v)); exact ⟨b,h,z.mono fun i H c x a=> H c _ (Set.mem_image_of_mem _ a)⟩
 let T:=G '' K; exact (v.costs T (s.image hg) (by rintro i ⟨x,h,rfl⟩; exact hy (tC h)) ε e).mono fun i h c j p=>h c (G j) ⟨Set.mem_image_of_mem _ p.1,unstripFe π pπ j _ p.2⟩
end
lemma pointFe (V:Set (Points n))(h:IsCompact V)(v:V⊆ P_Esc n):∀ᶠ f in atTop, Disjoint V (StrikeM_S n (WishGap_S P f)):=by
 suffices g:∀ b:Bibbin n, ∀ᶠ f in atTop,Disjoint V (TurnFigureS b (WishGap_S P f)) by
    filter_upwards[eventually_all.mpr g] with i h; rw [Set.disjoint_iUnion_right]; exact h
 rintro ⟨⟨⟨i,j⟩,u⟩,Q⟩; by_cases hV:V.Nonempty; swap; · rw [Set.not_nonempty_iff_eq_empty.mp hV]; exact Eventually.of_forall fun _=>Set.empty_disjoint _
 let W(x:Points n):= |FeeCord i j u x|
 obtain ⟨p,e,k⟩:= h.exists_isMinOn hV (show Continuous W by unfold W FeeCord; fun_prop).continuousOn
 have he:0<W p:= abs_pos.mpr (sub_ne_zero.mpr (fun k=> Q ((v e) u k)))
 let t:= he; filter_upwards [(show Tendsto (fun f=>6*WishGap_S P f) atTop (𝓝 0) by simpa using (wish0_S P).const_mul 6).eventually (gt_mem_nhds he)] with f g; exact Set.disjoint_left.mpr fun i v w=>g.not_ge ((k v).trans w) -- tune
lemma UniformPFe {F:κYFeS P n}{A:Points n→ℂ}(p:FearΘFe F A) (V:Set (Points n))(h:IsCompact V)(v:V⊆ P_Esc n): ∀ ε>0,∀ᶠ f in atTop,∀ (C:CoinsR P) (x:Points n),x∈V→‖F f C x-A x‖≤ ε:=by
 intro ε q; let T:= p.costs V h (fun x c=> Set.mem_iUnion.mpr ⟨(0:Axis),(show ΦplanR n x∈ MasksR _ from v c) 0⟩) ε q -- find
 filter_upwards[T, pointFe (P:=P) V h v] with f a b c x k; exact a c x ⟨k,fun h=>Set.disjoint_left.mp b k h⟩
#print axioms pointFe
