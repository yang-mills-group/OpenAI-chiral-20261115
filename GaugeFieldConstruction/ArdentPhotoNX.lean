lemma timesNX (p:TerraceFNX P S x X)(v:ℂ) : TerraceFNX P S (v • x) (v • X):=by
 intro j a b W; obtain ⟨h,t⟩:=p j a b; let F(i):=costΞJ P j 0 (S i) a b (x i)
 have hz:∀ᶠ i in atTop,W i=v • F i ∧ CallBoxJ 0 a b j ((v • x) i) (W i) (S i):=by
    filter_upwards[h] with i p; have e:W i=v • F i:=ℓγHeard _ _ _ _ _ (p.scale v); rw [e]; exact ⟨rfl,p.scale v⟩
 exact ⟨hz.mono fun i p=> p.2,(tendsto_const_nhds (x:=v)|>.smul t).congr' (hz.mono fun i p=>p.1.symm)⟩
lemma bendsNX(p:TerraceFNX P S x X)(q:TerraceFNX P S y Y): TerraceFNX P S (x+y) (X+Y):=by
 intro j a b W; obtain ⟨h,t⟩:=p j a b; obtain ⟨h',t'⟩:=q j a b; let F(z:ℕ→P.Test)(i):=costΞJ P j 0 (S i) a b (z i)
 have hz:∀ᶠ i in atTop,W i= F x i+ F y i∧ CallBoxJ 0 a b j ((x+y) i) (W i) (S i):=by
    filter_upwards[h,h'] with i p q; have e:W i=F x i+F y i:= ℓγHeard _ _ _ _ _ (p.plus q); rw[e]; exact ⟨rfl,p.plus q⟩
 exact ⟨hz.mono fun i p=>p.2,(t.add t').congr' (hz.mono fun i p=>p.1.symm)⟩
lemma quietNX(P:Spine)(S:ℕ→ℕ) : TerraceFNX P S 0 0:=by
 intro j a b W; have ht(i:ℕ):CallBoxJ 0 a b j (P:=P) 0 0 (S i):=by simpa [CallBoxJ] using ((UnitWallJ 0 a b j (S i)).minus (UnitWallJ 0 a b j (S i)))
 have he(i):W i=0:=ℓγHeard _ _ _ _ _ (ht i)
 refine ⟨Eventually.of_forall fun i=> by rw[he]; exact ht i,tendsto_const_nhds.congr fun i=>(he i).symm⟩
lemma cutsNX{I:Type*}(t: Finset I)(Z:I→ℕ→P.Test)(X:I→ScreensJ P)(p:∀ i∈t,TerraceFNX P S (Z i) (X i)): TerraceFNX P S (∑ i∈t,Z i) (∑ i∈ t,X i):=by
 induction t using Finset.induction with
 | empty=> rw[sum_empty,sum_empty]; exact quietNX P S
 | insert i t v ih=> rw [sum_insert v,sum_insert v]; exact bendsNX (p i (mem_insert_self ..)) (ih fun j h=>p j (mem_insert_of_mem h)) -- tune
