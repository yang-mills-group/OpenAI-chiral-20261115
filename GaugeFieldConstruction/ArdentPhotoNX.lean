lemma AuraPairNX (HV:F∈Utf0P (TivieraR p B0 M (0:P.VMark) pu A D S V three))(pH: ∀ i:↥CompassN,ClanFe i.val 0 F (βChiN i uD • F)) : ∃ z:ℕ→P.Test,TerraceFNX P (SportR P m) z F ∧ ∀ᶠ i in atTop,z i∈ libBlinkNX P B uD:=by
 obtain ⟨Y,t',Lk⟩:= PhotoAtlasNX p B0 M pu A D Q t u' H m U S V P' hm B F HV
 let W₀:=TivieraR p B0 M (0:P.VMark) pu A D S V three
 let X(i:χΩ)(f:ℕ):= PupilFNX P B (dueNX (Y f) i) m f
 have ht(i:χΩ): TerraceFNX P (SportR P m) (X i) (βChiN i uD • F):=PhaseRollNX p B0 M pu A D Q t u' H m U S V P' hm B i υ Y F _ (W₀.smul_mem _ HV.1) (pH i) t' Lk -- tune order
 let Y'(i:χΩ):= βChiN i uD • X i; let θ:= Fintype.card χΩ; have he(i:χΩ):TerraceFNX P (SportR P m) (Y' i) F:=by
    let h:= TerraceFNX.timesNX (ht i) (βChiN i uD); rw[smul_smul,peN,one_smul] at h; exact h
 let S':= ∑ i:χΩ,Y' i; let K:ℂ:= θ
 have hz:TerraceFNX P (SportR P m) S' (K • F):=by
    have hθ: (∑ _i:χΩ,F) = K • F:=by simp only[sum_const,card_univ]; rw [show K=(Fintype.card χΩ:ℂ) from rfl,Nat.cast_smul_eq_nsmul]; -- tune
    rw [← hθ]; exact TerraceFNX.cutsNX univ Y' (fun _=>F) (fun i _=>he i)
 have hx:K≠0:=by change (Fintype.card χΩ:ℂ)≠0; exact_mod_cast (Fintype.card_pos_iff.mpr (inferInstance:Nonempty χΩ)).ne'
 let Z:= K⁻¹ • S'
 refine ⟨Z, (by have H:= TerraceFNX.timesNX hz K⁻¹; rw [smul_smul,inv_mul_cancel₀ hx,one_smul] at H; exact H),?_⟩
 filter_upwards[(SportR.tale P m).eventually υ] with i k
 have ht:S' i = PupilFNX P B (ShadePNX uD (Y i)) m i:=by
    unfold S'; rw [Finset.sum_apply]; unfold Y' X PupilFNX; simp only[Pi.smul_apply, Finset.smul_sum]; rw[sum_comm]; apply sum_congr rfl; intro j _
    unfold ShadePNX dueNX; dsimp only; rw[Finset.sum_mul,sum_smul]; apply sum_congr rfl; intro g _; rw[smul_smul,←mul_assoc] -- tune sum_smul name
 change K⁻¹ • S' i∈ _; rw [ht]; exact Submodule.smul_mem _ _ (StoodTypedNX m B uD pD _ ((k _ le_rfl).2))
