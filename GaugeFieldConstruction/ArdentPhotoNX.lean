abbrev libBlinkNX (P:Spine)(B:Lead n)(u:Matter.FlavorIndex): Submodule ℂ P.Test:= Submodule.span ℂ (setOf fun v=> ∃ i:ExposureIndexNX,offFNX u i ∧ v=P.plaqueStakeNX (B,i))
noncomputable abbrev ShadePNX (B:Matter.FlavorIndex)(v:ExposureFrameNX): ExposureFrameNX:= fun i=> let H:= ∑ j: χΩ,βChiN j B*βChiN j i.1; H*v i
include pD
lemma loyalPaintNX(v:ExposureFrameNX)(i:ExposureIndexNX)(p:¬ offFNX uD i): ShadePNX uD v i=0:=by
 have ht: (∑ j: χΩ,βChiN j uD*βChiN j i.1)=0:= by
    trans ∑ j:χΩ, βChiN j uD*hueChiN j (i.1.1,i.1.2.1) (i.1.1,i.1.2.2)
    · rfl
    exact ClaraN uD pD _ _ p
 unfold ShadePNX; simp only [ht,zero_mul]
lemma portraitEstateNX(e:EpochEFe P (SportR P m s))(i:ExposureIndexNX)(hp: offFNX uD i) : P.SunPlateNX (B,i) m s= P.ScaleFlagNX m s • P.plaqueStakeNX (B,i):=by
 let Z:= P.plaqueStakeNX (B,i); let t:=SportR P m s; let F:= P.publicBill t Z
 have Q: i.1.2.1≠i.1.2.2:=by
    obtain ⟨h,g⟩|⟨h,g⟩:= hp
    · rw [show i.1.2.1=uD.2.1 from congrArg (fun z: Bool × Fin 3=>z.2) h,show i.1.2.2=uD.2.2 from congrArg (fun z: Bool × Fin 3=>z.2) g]; exact pD
    rw [show i.1.2.1=uD.2.2 from congrArg (fun z: Bool × Fin 3=>z.2) h,show i.1.2.2=uD.2.1 from congrArg (fun z: Bool × Fin 3=>z.2) g]; exact pD.symm
 have hv : F=0:=by
    have h: 0= (Fintype.card χΩ:ℂ)*F:=by calc
       (0:ℂ) = F*∑ j:χΩ,βChiN j i.1 := by rw [vaneN _ Q,mul_zero]
       _= ∑ j:χΩ,F:=by rw [mul_sum]; exact sum_congr rfl fun j _=> EpochSpurNX (s:=t) j _ e
       _=_:=by simp -- tune nsmul
    exact (mul_eq_zero.mp h.symm).resolve_left (by exact_mod_cast (Fintype.card_pos_iff.mpr (inferInstance:Nonempty χΩ)).ne')
 let V:= P.ScaleFlagNX m s; change _- P.publicBill t (V • Z) • 1= V • Z; rw [show P.publicBill t (V • Z)=V*F from map_smul (EvLB P t) _ _,hv,mul_zero,zero_smul, sub_zero]
lemma StoodTypedNX(v:ExposureFrameNX)(p:EpochEFe P (SportR P m s)): PupilFNX P B (ShadePNX uD v) m s∈ libBlinkNX P B uD:= by
 let S:= libBlinkNX P B uD; refine S.sum_mem (fun i _=>?_); by_cases e:offFNX uD i
 · rw[portraitEstateNX m B uD pD p _ e]; exact S.smul_mem _ (S.smul_mem _ (Submodule.subset_span (show P.plaqueStakeNX (B,i)∈_ from ⟨i,e,rfl⟩)))
 rw[loyalPaintNX _ pD v i e,zero_smul]; exact S.zero_mem
