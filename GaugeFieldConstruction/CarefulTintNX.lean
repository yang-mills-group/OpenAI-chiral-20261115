 let s:= SportR P m f; let z:=L f; let J:= P.plaqueStakeNX K; let Vz:=costΞJ P i 0 s U W J
 have He:= (h' (v f) (hf.trans (SportR.hop P m f))).choose_spec.2 j a b U W i pM; obtain ⟨H,kp⟩:= (show CallBoxJ 0 U W i J Vz s ∧ ‖Vz-YT f i U W‖ ≤ c*FingerprintNX P u' j s from (by 
    unfold YT; rw[dif_pos hf]; exact He))
 let Q:= z• Vz; let K:=reGainNX U W i; have hK:CallBoxJ 0 U W i (P.SunPlateNX _ m f) (K Q) s:=payC_R (P:=P) 0 _ _ _ (H.scale _)
 have ht:Y=K Q:= ℓγHeard _ _ _ _ _ hK; rw[ht]
 let Z:= G f i U W; let x:=YT f i U W
 have hu:X f i U W = K Z:=by
    change Z-Heapψ P (G f) • _=Z-incomeVertR i Z • _
    rw[show incomeVertR i Z=Heapψ P (G f) from PanΨ p B0 M 0 R u' pu A _ D (V.go ..) (s:=f0) le_rfl U W i _ (MeanBylawsJ P) _ (hp f)]
 refine ⟨hK,?_⟩; rw[hu,←map_sub]; refine (budget_R U W i (Q-Z)).trans ?_; rw[show Q-Z=z • (Vz-x) from (smul_sub ..).symm,norm_smul]; let C₀:=(Richm_R P m f)^3
 have hy:‖z‖=C₀:=by change ‖(↑(Richm_R P m f):ℂ)^3‖=_; rw [norm_pow,Complex.norm_real,Real.norm_of_nonneg (Richm_good ..).le]
 rw [hy]; exact (mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left kp (show 0≤ C₀ from (norm_nonneg z).trans_eq hy)) (by norm_num : (0:ℝ)≤2)).trans_eq (by unfold LegScanNX C₀ s; ring) -- tune
