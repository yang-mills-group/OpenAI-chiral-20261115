lemma AlpinePrintNX : ∃ X:ℕ→ScreensJ P,(∀ i,X i∈ F_P)∧AlliantFNX P (ΤbandR u) m K X:=by
 let R:Signed × Bool:= (1,false); let u':=ΤbandR u; let Z:= (0:P.VMark); let Φ:= TivieraR p B0 M Z pu A D S V u
 obtain ⟨t,c,h,h'⟩:= StampClockNX p B0 M R u' pu A (S Z R _) D K P' ε (V.go ..)
 let v:=SportR P m
 let YT (j:ℕ):ScreensJ P:= if g:t ≤ j then (h' (v j) (g.trans (SportR.hop P m j))).choose else 0
 have hz (i:ℕ):YT i∈Φ:=by 
    unfold YT; split_ifs with g; · exact (h' (v i) (g.trans (SportR.hop P m i))).choose_spec.1
    exact Φ.zero_mem
 let L:=P.ScaleFlagNX m; let G(i:ℕ):= L i • YT i; have hp(i:ℕ):G i∈ Φ:=Φ.smul_mem _ (hz i); let X(i:ℕ):=RenewΛJ P (G i)
 refine ⟨X,(fun i=> ⟨Φ.sub_mem (hp i) (UnitσP p B0 M 0 R u' pu A _ D (V.go ..) (s:=f0) le_rfl _),PoseNullJ P (G i)⟩), t,2*c,(by positivity),?_⟩ -- existential grouping tune
