 let Z:=x-y; have hp:Heapψ P Z.val=0:=by change Focusβ P (x.val-y.val)=0; rw [map_sub]; exact sub_eq_zero.mpr p'
 let Z':B_ζ:= ⟨Z.val,Z.property,hp⟩
 obtain ⟨a,ha⟩:=q1.1 Z'; have h':a=0:=p1 a (fun i=> by
    unfold RealityS; rw [LinearMap.comp_apply,ha]; let G:=ΞkS p B0 M R pu A D m U u S V o f i; let F:B_d:= ⟨G.val,G.property.1⟩; let W:=LεS P f; rw [RowHoldS]; change SπR _ ![G.val,Z'.val] _=_; rw[show _ =RowJ_S _ eβ wδ W F Z from (RowHoldS ..).symm, map_sub]; exact sub_eq_zero.mpr (h F)) -- rewrite test
 rw [h',map_zero] at ha; apply sub_eq_zero.mp; apply Subtype.ext; exact (congrArg Subtype.val ha).symm
lemma GlobalRankES (x y:B_d)(g:(∀ u: DiagramR (Fin 1),KriffS _ eβ wδ u ![x]=KriffS _ eβ wδ u ![y]))(h:∀ W:B_d,∀ s∈ MasksR (Fin 2),RowJ_S _ eβ wδ s W x=RowJ_S _ eβ wδ s W y):x=y:=by
