lemma SeparatorES : ∀ᶠ f in atTop,∀ x y:B_d, Heapψ P x.val=Heapψ P y.val →(∀ F:B_d, RowJ_S _ eβ wδ (LεS P f) F x=RowJ_S _ eβ wδ (LεS P f) F y)→ x=y:=by
