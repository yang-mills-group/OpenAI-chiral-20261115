lemma singular_4 {r:ℝ} (s: Seed (D:=D) (x:=x) p L₁)(g:Harvest (D:=D) (V:=V) (w:=w) (x:=x) p h κ r L₁ R₁) (seat : Seat (Scree.mid m B)):
   (∑ i:RocX with (w.step V).ratio.parent i.1.val.1=seat,∑ j:Lo with (host₀ i).val⊆ j.val, (tolQ p).mass j.val (Cfee i j)) ≤ r*value_ R x κ:= by
 apply le_trans _ (dividend_E Uq s g seat)
 rw [sum_filter,sum_filter]; apply le_of_eq; unfold rope_i; -- could rewrite filtered products order. Need two. tune
 rw [sum_filter]; conv_rhs => rw [Fintype.sum_prod_type];
 apply sum_congr rfl; intro i hu
 by_cases e:(w.step V).ratio.parent i.1.val.1=seat
 · rw [if_pos e,sum_filter]; apply sum_congr rfl; intro j _
   by_cases h_: (host₀ i).val ⊆ j.val
   · simp only [h_,if_true,keep_A,dif_pos, tonK,e]; unfold fee_term; rw [e]
   simp only [h_,if_false]
 rw [if_neg e]; symm; apply sum_eq_zero; intro j _
 by_cases h_: (host₀ i).val ⊆ j.val
 · simp only [h_,if_true,keep_A,dif_pos,tonK,e,if_false]
 simp only [h_,if_false]

