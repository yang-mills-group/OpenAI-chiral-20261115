lemma actor_stampΞ (v:Test4)(h:∃ f:_root_.GarnetAct.Cut.Curtain,v= Easel.film f): v≠0∧IsCompact (tsupport v)∧(∫ x:E4,v x)=1 ∧ _root_.YM.Boundary.Probe.bar v=v∧∀ x:E4,0≤ (v x).re:=by
 obtain ⟨f,rfl⟩:=h; have hp:= Easel.normalized f; refine ⟨fun h=> ?_,?_,hp,film_real _,allocation _⟩
 · rw [h] at hp; simp at hp
 rw[Easel.aperture]; exact (f.budget.image cont_face)
-- positive in Eu readings & precise direct-sign compromise; `σ` below is the sign inferred from the direct read
-- itself. At normalized f g with CAMERA sign κ (chosen for Eu Wick) we do not assert whether σ=1 or -1; provide
-- reality & absolute margin. Flipping camera sign makes the direct bill positive, at that flip not claiming positive joint also in Eu.
variable (yα Yq TxX HxX)
structure MovieLensSt :Prop where
 sure : Motif.Stamp y.P y.M zX a.guest.i y.ht.tendsto_atTop WΞ eΞ ΧΞ a.guest.sig true 0 a.w
 signs : SignCrew a.guest.sig ∧ a.guest.i≠3
 not_empty (x:Test4)(p:x=(Easel.film fL)∨x=(Easel.film fR)): x≠0∧ IsCompact (tsupport x)∧(∫ v:E4,x v)=1∧_root_.YM.Boundary.Probe.bar x=x ∧∀ v:E4,0≤(x v).re
 region : TxX>0 ∧ ∀ x∈tsupport (Easel.film fL),∀ y∈tsupport (Easel.film fR), 2*TxX<time y-time x ∧ |time y-time x|+TxX< y.ofLp 0-x.ofLp 0 ∧ x-y ∈ Mink.spacelike
 price : HxX>0 ∧ HxX ≤ (WickM).re
 left_eq : inner ℂ sv ((J#) sv)= ζleft
 right_eq : inner ℂ sv ((K#) sv)= ζright ∧ ζright=0
 pair_eq : inner ℂ sv (((J#)*(K#)) sv)= ζboth ∧ movieGapSt (model:=model) (a:=a) k X fL fR= Ψι
 joint_prices_unpadded : LinearMap.IsSymmetric (J#)∧ LinearMap.IsSymmetric (K#)∧ Commute (J#) (K#)∧ star (movieGapSt (model:=model) (a:=a) k X fL fR)=(movieGapSt (model:=model) (a:=a) k X fL fR)
 tape : (movieGapSt (model:=model) (a:=a) k X fL fR).re ≠ 0
 margin : ∃ δ τ:ℝ, 0<δ ∧ |τ|=1 ∧ δ ≤ τ*(movieGapSt (model:=model) (a:=a) k X fL fR).re

-- heuristic orientation is EXACT camera. For these ANY Pose supporters only nonzero, see also separate gold proof
private lemma realAnchorSt (z w:ℂ) (h:z=w)(p:star w=w)(e:w ≠ 0): star z=z ∧ z.re≠0∧ ∃ δ τ:ℝ, 0<δ ∧ |τ|=1∧ δ≤ τ*z.re :=by
 subst w; have hz:z.re≠0:= fun t=>e (Complex.ext t (by have s:= congrArg Complex.im p; simp only[Complex.star_def,Complex.conj_im] at s; rw [Complex.zero_im]; linarith)); refine ⟨p,hz,?_⟩; rcases lt_or_gt_of_ne hz with u|u; · refine ⟨-(z).re,-1,by linarith,by norm_num,?_⟩; linarith
 exact ⟨z.re,1,u,by norm_num,by linarith⟩
include V pKH
lemma profileLensSt : MovieLensSt (model:=model) (a:=a) k X fL fR TxX HxX:=by
 let Q:=pKH; let I:=Q.song; let Y:= I.wrap
 have hx:= I.spacelike
 have hu:= ink_price k X fL fR V
 obtain ⟨p,b,d⟩:=direct_sepΞ k X fL fR V
 obtain ⟨he,he',yu⟩:= realAnchorSt _ _ hu (tint_real k X fL fR V pKH) I.direct
 refine ⟨Q.tag,⟨Y.key,Y.rank_spatial⟩,?_,⟨Y.tempo,fun p e q w=> Motif.out_of_reach y.P y.M zX voΞ y.ht.tendsto_atTop WΞ eΞ ΧΞ a.guest.atx TxX ζΞ fL fR yα Y p q e w⟩,⟨Y.meter, I.wick⟩,p,⟨b,Q.zeroK⟩,⟨d,hu⟩, ⟨u.symmetricReceipt _ _ (weight_sendsΞ k X V (Easel.film fL)) Q.credit.grip.1, u.symmetricReceipt _ _ (V.small (Easel.film fR)) Q.credit.grip.2, commutes_supportKΞ k X voΞ _ _ hx,he⟩,he',?_⟩
 · intro x h; apply actor_stampΞ; exact h.elim (fun p=>⟨_,p⟩) fun p=>⟨_,p⟩
 exact yu

end
