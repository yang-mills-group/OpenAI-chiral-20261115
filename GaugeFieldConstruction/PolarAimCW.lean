lemma flavour_slot (a:IdWitPV)(i:Axis) (g:CompassN): flavors three g.val (SpinSlot3 a i) = Flavor.βChiN g a • SpinSlot3 a i:=by
 let x:= a; let b:=βChiN g x; let H:Fragment (UF three):=Pi.single x ((DeckF three).issue (ket i)); refine Prod.ext ?_ (Prod.ext ?_ (Prod.ext ?_ ?_))
 · exact (smul_zero b).symm
 · exact (smul_zero b).symm
 swap
 · change hues g.val (0:Fragment (UX three)) = b • 0; rw [map_zero,smul_zero]
 change hues g.val H=b • H; ext1 j; rw [Pi.smul_apply]; have he:=plate H g.val j; rw [Flavor.chaseN g j] at he; rw [he]; by_cases v:j=x
 · subst j; change GaugeFieldConstruction.pay (βbitN g x) _=GaugeFieldConstruction.pay (βbitN g x) (1:ℂ) • _; cases βbitN g x <;> simp
 rw [show H j=0 from Pi.single_eq_of_ne v _,GaugeFieldConstruction.pay_zero,smul_zero]
abbrev OffDiagonalPhotos (j:Axis) (q:IdWitPV) (n i:ℕ)(A:ℕ→process.Apron):Prop:=
  TerraceFNX process (SportR process ΓstageVU) (fun s=>(A s).F) (roles.RoomsVU (roles.StaturePV i q j)) ∧
  MagazineNX process A ΓstageVU n q∧ JointLedgerNX (SportR process ΓstageVU) A (roles.RoomsVU (roles.StaturePV i q j)) ∧
  StandardPV (SportR process ΓstageVU) (fun k s=>(A k).full process s) (roles.RoomsVU (roles.StaturePV i q j))
