theorem all_off_diagonal (j:Axis) (q:IdWitPV)(p:q.2.1≠q.2.2) (n i:ℕ)(w:n>process.calibration.ℓ) : ∃ A:ℕ→process.Apron, OffDiagonalPhotos (roles:=roles) j q n i A:=by
 obtain ⟨Y,S,H⟩:= BlinkPhysicsNX production.p production.B0 production.M _ production.pu roles.A roles.Dp roles.Q _ _ roles.H ΓstageVU roles.Sq roles.Wp _ growth roles.υ i n q Certificate.extra_births (by decide) w p (SpinSlot3 q j) (flavour_slot q j)
 let W:=SportR process ΓstageVU
 have t : TerraceFNX process (SportR process ΓstageVU) (fun s=>(Y s).F) (roles.RoomsVU (roles.StaturePV i q j)):=by unfold StaturePV; rw [DeckΛAxisVU]; exact S
 have h : JointLedgerNX (SportR process ΓstageVU) Y (roles.RoomsVU (roles.StaturePV i q j)):=by
    refine ⟨atTerraceNX _ Y W (SportR.tale process ΓstageVU) (BrightShrinkNX Y ΓstageVU _ _ H) t,fun s=>(H s).2.2.1.le,BandedWidthNX Y ΓstageVU n q H,fun s=>⟨_,Spine.Beam.of_sensed (H s).2.1⟩⟩
 exact ⟨Y,t,H,h,roles.FieldWisePV h⟩
#print axioms all_off_diagonal
