lemma PaneTruthPV(z:ShIdPV→ℂ) (h: (∑ k:ShIdPV,z k • E.RotorReadPV p q i k.2 k.1)=0):z=0:=by
 let f:= (E.PerD_VU p q).TinCanL; let W(k:ShIdPV):=z k * (Wickγ k.1)⁻¹
 have ht := congrArg f.symm h; rw [map_zero,map_sum] at ht
 have he : ∑ x:ShIdPV, W x • RushSlotPV x=0:=by
    apply (DeckPortInvVU E _ hi); rw [map_zero,map_sum]; refine Eq.trans (Finset.sum_congr rfl (fun j _=>?_)) ht
    rw [map_smul,map_smul,show E.RotorReadPV _ _ _ _ _ =f _ from rfl, f.symm_apply_apply]; rw [smul_smul]
 have hp(k):W k=0:=congrFun (fullRankLipPV W 0 (by simp [he])).1 k
 funext x; exact (mul_eq_zero.mp (hp x)).resolve_right (inv_ne_zero (wickLiveL _))
