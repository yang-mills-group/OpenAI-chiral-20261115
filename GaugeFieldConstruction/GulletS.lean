lemma GuttersS (k:ℕ)(g:26+k ≤ m)(d:Axis)(l:List I)(p1:PolesR l) : ∀ᶠ f in atTop,∀ (C:CoinsR P)(x:I→ Cover),let s:=SportR P m f; let F:=TapeI p B0 M pu A D m u S V X' R L0 f
 let Z:=AskR P (CountersS P m f x); let B:ℝ:=SpringR P f; let Y(i:I):= StageμS D m f (X' i) (x i)
 Z∈ MasksR I→ Z∈ OpenR d (fun _:I=> AutoPadR P f) l→ ‖SπR C.porch F Z-C.cash s (l.map Y).prod‖≤ Fintype.card I*(B^k)⁻¹*(2*B^LowSν)^Fintype.card I:=by
 have hx(i:I):= SpendS_R p B0 M (R i) pu A D Q t u' H m S V (u i) (L0 i) _ (H' i) (by omega) 26 (by decide) -- L0 placeholder not constrained
 have hv(i:I):= entryμS p B0 M (R i) pu A D m S V (u i) (L0 i) (X' i) (H' i) k (by omega) -- order
 filter_upwards [eventually_all.mpr hx,eventually_all.mpr hv,eventually_ge_atTop f0] with f T t' e C x
 intro s F Z B Y H h
 let A:= fun _ :I=>AutoPadR P f; let X:= CountersS P m f x
 rw[S_rawMeshR C.porch d A X l F (fun i=> AttS_R p B0 M (R i) pu _ _ m S V (u i) (L0 i) (X' i) f) p1 h H] -- order
 let T₀:=legR d X (BodyΘ P F d A)
 choose c' G hc using fun i=>t' i d (x i)
 have hg: C.cash s (l.map Y).prod= VirtueJ C.porch d (SweepR d A X l none c'):= (PlotAccessR C.porch d A X l c' G h).symm -- order B0 shadow
 rw [hg, ← listCount_R l p1]; let p₀:= SweepR d A X; have hB:1 ≤ B:=SpringR.tall ..; have ht:∀ i,‖T₀ i‖≤ B^LowSν:=by
    intro i; unfold T₀ legR; rw [ambient_norm]; exact T i (A i) d f e (SportR.hop ..) le_rfl
 let B':=B^LowSν; have hp:1≤B':= one_le_pow₀ hB
 have he:∀ i,‖c' i‖≤ 2*B':=by
    intro i; have hx:= norm_le_norm_add_norm_sub' (c' i) (T₀ i); have hf: ‖c' i-T₀ i‖≤ (B^k)⁻¹:=hc i; have hs:(B^k)⁻¹≤1:=inv_le_one_of_one_le₀ (one_le_pow₀ hB); linarith only [hx,hp,hf,ht i,hs]
 exact BillSmallR C.porch d l X A T₀ c' (2*B') (B^k)⁻¹ (by linarith) (fun i=>(ht i).trans (show B'≤ 2*B' by linarith)) he (fun i=>by rw [norm_sub_rev]; exact hc i) (by have h:=zero_lt_one.trans_le hB; positivity) -- tune
lemma SlipS_R (k:ℕ)(e:26+k ≤ m)(w:LowSν*Fintype.card I< k)(l:List I)(h:PolesR l):∀ ε>0, ∀ᶠ f in atTop, ∀ (C:CoinsR P)(x:I→ Cover)(d:Axis)(L:List I),l.Perm L → let s:=SportR P m f
 let F:=TapeI p B0 M pu A D m u S V X' R L0 f
 let Z:=AskR P (CountersS P m f x); let Y(i:I):= StageμS D m f (X' i) (x i)
 Z∈ MasksR I→ Z∈ OpenR d (fun _:I=> AutoPadR P f) L→ ‖SπR C.porch F Z-C.cash s (l.map Y).prod‖ < ε:=by
 intro ε d
 let n:=Fintype.card I; let Z(k:ℕ):=SpringR P k; let W (f:ℕ):=(n:ℝ)*(Z f ^k)⁻¹*(2*Z f^LowSν)^n
 have hx(k':ℕ):1≤ Z k':=SpringR.tall ..
 have hw:Tendsto W atTop (𝓝 0):=by
    obtain ⟨z,h⟩:= Nat.exists_eq_add_of_le w; change k= (LowSν*n+1)+z at h
    have hw : Tendsto (fun f=>(Z f^(1+z))⁻¹) atTop (𝓝 0):=tendsto_inv_atTop_zero.comp ((tendsto_pow_atTop (by omega :1+z ≠ 0)).comp (SpringR.escape P))
    have h':=hw.const_mul ((n:ℝ)*2^n); rw [mul_zero] at h'; apply h'.congr; intro f; have hp:0< Z f:= zero_lt_one.trans_le (hx f); change _=W f; unfold W; rw [h,Nat.add_assoc,pow_add (Z f) (LowSν*n) (1+z),mul_pow,mul_inv_rev,←pow_mul (Z f) LowSν n]; generalize hy : Z f^(LowSν*n)=y; have hk:y≠0:=by rw [←hy]; positivity
    rw [show ∀ z':ℝ,(n:ℝ)*(z'*y⁻¹)*(2^n*y)=↑n*2^n*z' from (fun z'=> by field_simp)]
 have hz: Set.Finite {L:List I|l.Perm L}:= l.permutations.toFinset.finite_toSet.subset (fun q h=> by simpa using (show q.Perm l from List.Perm.symm h)) -- tune
 have hG:(∀ᶠ f:ℕ in atTop, ∀ L, l.Perm L →∀ (i:Axis) (C:CoinsR P)(x:I→ Cover),AskR P (CountersS P m f x) ∈ MasksR I→ AskR P (CountersS P m f x)∈ OpenR i (fun _=> AutoPadR P f) L→
    ‖SπR C.porch (TapeI p B0 M pu A D m u S V X' R L0 f) (AskR P (CountersS P m f x))- C.cash (SportR P m f) (l.map (fun i=> StageμS D m f (X' i) (x i))).prod‖≤ W f):=by
    apply (eventually_all_finite hz).2; intro L pL
    apply eventually_all.mpr; intro i; apply (GuttersS p B0 M pu A D Q t u' H m u S V X' R L0 H' k e i L ⟨(List.Perm.nodup_iff pL).mp h.1,fun i=>List.Perm.subset pL (h.2 i)⟩).mono -- tune pL prop reduces
    intro f p C x t v; specialize p C x t v; rw [show _=_ from (List.Perm.map (fun i=>StageμS D m f (X' i) (x i)) pL).prod_eq]; exact p -- pattern
 filter_upwards [hw.eventually (gt_mem_nhds d), hG] with f v w C x i L e; exact fun a b => (w _ e i C x a b).trans_lt v
