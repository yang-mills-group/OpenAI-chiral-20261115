lemma acceptedAll (A:ΧiMars)(u y:PermWallJ P): E.RoomsVU A i u y ∈ P.neutralSlabs i :=by
 let F:= E.OriginsVU A; let Wv:=E.GrowableVU A ; have he: ∀ᶠ t in atTop,F t∈ enclave P.calibration := Wv.2.mono fun t h=> by have H':= (h (0:Cover)).1; rwa [relocate_identity] at H'
 obtain ⟨B,p',s⟩:= Wv.1.1 i u y; apply (P.hereClosed i).mem_of_tendsto p'; filter_upwards [s,he] with t ht he; exact tintShadow P i _ _ _ _ he t ht
