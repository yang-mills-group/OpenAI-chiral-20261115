lemma sieveSt : ∃ Z:UV three, (∀ j (a b:PermWallJ P), projectPrice P j x (E.RoomsVU (E.DeckLiftVU k Z) j a b) = U j a b) ∧
           ((∀ Z: UV three, (∀ j (l r:PermWallJ P), projectLine P j x (E.RoomsVU (E.DeckLiftVU k Z) j l r)=0)→Z=0)→ VistaX 0 (E.RoomsVU (E.DeckLiftVU k Z)) (fun s=> (V s).F)) :=by
 let A(s:ℕ): Ι:=⟨F s,Hf s⟩
 choose L Lhit using (fun s:ℕ=> (t three).2 (A s))
 have ht(v:ℕ): F v= E.RoomsVU (E.DeckLiftVU k (L v)):=by rw[E.DeckΛAxisVU,Lhit]
 have hx(j:Axis)(a b:PermWallJ P): BSOT (fun v:ℕ=> projectLine P j x (F v j a b)) atTop (U j a b):=by
    obtain ⟨B,t,h₁⟩:=hF j a b; let H:= (V) -- ensure underscores
    have hk:Tendsto (fun v=> ‖B v-F v j a b‖) atTop (𝓝 0):= tendsto_zero_iff_norm_tendsto_zero.mp h₁
    refine BSOT.squeeze' (hp j a b) hk ?_; filter_upwards [t,(p j).eventually (gt_mem_nhds a.2), (p j).eventually (gt_mem_nhds b.2)] with s x' g p''; obtain ⟨h₀,hV⟩:=shadowBox P j x (V s) a b g.le p''.le
    -- don't rewrite all dependencies. h0 : .s=s
    have hh: costΞJ P j 0 (V s).s a b (V s).F = B s:=h₀.same (by rw [h0]; exact x')
    rw [hh] at hV; change ‖projectPrice P j x (F s j a b) - P.base j _ _ _ _‖ ≤ _; rw [← hV,ht,norm_sub_rev] -- orientation? post norm left F-B => now B-F, right B-F
    exact shadowCost P j x (B s) _ (tintShadow P j _ _ _ _ (V s).realM _ x') (acceptedAll E _ _ _ _)
 let L₁(z:UV three)(j:Axis)(l r:PermWallJ P)(x': P.ManyF j (χ j)) : P.ManyF j (χ j):= projectLine P j x (E.RoomsVU (E.DeckLiftVU k z) j l r) x'
 let κ:UV three→ₗ[ℂ] ((j:Axis)→PermWallJ P→ PermWallJ P→P.ManyF j (P.advocate 3 x j)→ (P.ManyF j (P.advocate 3 x j)).space):={toFun:=L₁, map_add':=fun z w=>by funext j l r u; simp [L₁,Pi.add_apply], map_smul':=fun c z=>by funext j l r u; simp [L₁,Pi.smul_apply] }
 let Γ(j:Axis)(l r:PermWallJ P)(s:P.ManyF j (χ j)):= (U j l r) s
 letI: FiniteDimensional ℂ (LinearMap.range κ):= Module.Finite.range _
 have hu:Tendsto (fun v=>κ (L v)) atTop (𝓝 Γ):= tendsto_pi_nhds.mpr fun j=> tendsto_pi_nhds.mpr fun l=> tendsto_pi_nhds.mpr fun r=> tendsto_pi_nhds.mpr fun s=> ((hx j l r).showAt s).congr (fun i=>congrArg (fun (v':ScreensJ P)=> projectLine P j x (v' j l r) s) (ht i))
 obtain ⟨z,hz⟩:= stampPocketSt κ L Γ hu
 refine ⟨z,(fun j l r=> ContinuousLinearMap.ext fun s=>congrFun (congrFun (congrFun (congrFun hz j) l) r) s),?_⟩
 intro u0 j a b; let T (Z:UV three):= E.RoomsVU (E.DeckLiftVU k Z) j a b
 let J':UV three→ₗ[ℂ](P.Slabs j):={ toFun:=T, map_add':=fun _ _=>by simp [T], map_smul':=fun _ _=>by simp [T] }
 have hi(x₂:UV three)(h₂:κ x₂=0):x₂=0:= u0 _ (fun j l r=> ContinuousLinearMap.ext (fun v=> congrFun (congrFun (congrFun (congrFun h₂ j) l) r) v))
 have hw:Tendsto (fun i=> F i j a b) atTop (𝓝 (J' z)):= by simp_rw [ht]; exact stampRefundSt κ L Γ hu (P.Slabs j) z hz hi J'
 obtain ⟨B,sB,uB⟩:= hF j a b; refine ⟨fun s=>costΞJ P j 0 s a b (V s).F,?_,shadowLevelSt P j V h0 a b (p j)⟩
 have t: Tendsto B atTop (𝓝 (T z)):= by have he:=uB.add hw; rw [zero_add] at he; exact he.congr (fun i=> sub_add_cancel _ _)
 exact t.congr' (sB.mono fun i t=> (ℓγHeard _ _ _ _ _ t).symm)
