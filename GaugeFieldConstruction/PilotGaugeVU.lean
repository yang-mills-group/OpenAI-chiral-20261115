lemma CommissionFieldUV (x:↥Β_f): ∃ V:AUV,V∈ ΝC ∧ V.1=x:=by
 let R: Signed × Bool:=(1,false); obtain ⟨p',e⟩:=OriginCoreR p B0 M R pu A D dΩ Sq Wp x s0
 let X'(R:Signed × Bool)(y):= DietX p B0 M R pu A D s0 dΩ Sq Wp y
 let g':=X' R p'; have hp:g'=x:=Subtype.ext e
 let B':AUV:= (g',fun i=>if h : s ≤ i then ΡVU R s i h p' else (0,p'.2))
 refine ⟨B',?_,hp⟩; change RUV B'; refine ⟨?_,fun b=>?_⟩
 · filter_upwards[eventually_ge_atTop s] with i v; simp only [B',dif_pos v]; rw [map_smul, ΦVotRayU p B0 M R uXz pu] -- tune
 let Φ:= b.val⁻¹; let h:= GripR R Φ false; let y:=RichL_S P Φ false p'
 let D':= DietX p B0 M h pu A D s0 dΩ Sq Wp y
 have hx:WaitMU b B'.1=D':= thetaRevS p B0 M R pu A D s0 Q t uH H Φ false dΩ Sq Wp p'
 rw[hx]
 have he:=(ΘVenue_S p B0 M 0 h uXz pu A (Sq 0 h _) D (Wp.go ..) s0 y.1 0).plus 0 (VenueZ_S 0 (Unitφ (P:=P) 0) y.2)
 apply LiveZoneUV _ _ _ he
 filter_upwards[eventually_ge_atTop s] with i r; change dite _ _ _ + y.2 • 1 = ΚassetVU D i 0 (ΕΓJUV b (B'.2 i)); simp only [B',dif_pos r]; rw [TravelPrepVU p B0 M R A D s0 Sq Wp]; exact (CapitolPXUV B0 h D Sq dΩ r y).symm -- tune
