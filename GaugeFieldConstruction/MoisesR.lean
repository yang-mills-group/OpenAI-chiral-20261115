private def ambiR (P:Spine)(y:P.VMark)(i:Axis) : P.Slabs i→ₗ[ℂ] P.Slabs i where
 toFun:= P.ambientTurn i y
 map_add' x z:=by unfold ambientTurn; rw[mul_add,add_mul]
 map_smul' a b:=by unfold ambientTurn; rw [mul_smul_comm,smul_mul_assoc]; rfl
-- pi manual
abbrev WmoveR (P:Spine)(y:P.VMark) (X:ScreensJ P):ScreensJ P:= fun i a b=> P.ambientTurn i y (X i a b)
def WayMoveR (P:Spine)(y:P.VMark) : ScreensJ P→ₗ[ℂ] ScreensJ P where
 toFun:= WmoveR P y
 map_add' x z:=by funext i a b; exact (ambiR P y i).map_add (x i a b) (z i a b)
 map_smul' z x:=by funext i a b; exact (ambiR P y i).map_smul z _
lemma WayD_R (x y:P.VMark)(X:ScreensJ P): WayMoveR P x (WayMoveR P y X)=WayMoveR P (x+y) X:=funext fun i=> funext fun a=>funext fun b=> ambient_plus x y _
lemma WayNullR (P:Spine)(X:ScreensJ P):WayMoveR P 0 X=X:=by
 funext i a b; change transitTile P i 0 * _ * transitTile P i (-0)=_; rw [neg_zero,transit_zero,mul_one,one_mul]
lemma vacWay_R (P:Spine)(y:P.VMark):WayMoveR P y (CandΛJ P)=CandΛJ P:=by
 funext i a b; unfold WayMoveR; change P.ambientTurn i y (CandΛJ P i a b)= _; unfold ambientTurn CandΛJ; rw [transit_share,mul_assoc,←transit_plus, add_neg_cancel, transit_zero,mul_one]
lemma DotWay_R (k:ℕ)(X:ScreensJ P): ‖GapHeightR P k (WayMoveR P y X)‖=‖GapHeightR P k X‖:=by
 let v:= RootApR P k
 have hp(q:P.VMark)(X:ScreensJ P):‖GapHeightR P k (WayMoveR P q X)‖ ≤ ‖GapHeightR P k X‖:=by
    let A:= transitTile P 3 q; let Y:= transitTile P 3 (-q); let Ω:=floorVec P 3; let R:=P.publicH 3; let F:= X 3 v v
    change ‖A.val (F.val (Y.val Ω))‖ ≤ ‖F.val Ω‖; rw [show Y.val Ω=Ω from ?u]; exact (A.val.le_opNorm _).trans ((mul_le_mul_of_nonneg_right (transit_affordable q) (norm_nonneg _)).trans_eq (one_mul ..))
    case u=> change R.ρ Y R.Ω= _; unfold Y; rw [R.transitReceipt,transit_Ω]; rfl
 refine (hp y X).antisymm ?_; apply le_trans ?_ (hp (-y) (WayMoveR P y X)); rw [WayD_R,neg_add_cancel,WayNullR]
include g
lemma InclineMoveR (z:Cover)(i:Axis)(σ τ:PermWallJ P)(u:D_r)(R:Signed × Bool)(v:FrameK (Fin (θ (ΤbandR u)))) : let X:=fleetΨJ P f z x
 P.ambientTurn i (P.vtile f z) (MeshΦ p B0 M x R (ΤbandR u) pu A (S x R _) D (V.go ..) g v i σ τ)= MeshΦ p B0 M X R (ΤbandR u) pu A (S X R _) D (V.go ..) g v i σ τ:= HullLipsJ p B0 M x R _ pu A _ D _ _ z _ _ v σ τ i -- proof infer? tune
lemma RimAxisR(z:Cover)(R:Signed × Bool)(d:D_r) (F:ScreensJ P) (h:F∈ BazaarP p B0 M x pu A D S V f g d R): WayMoveR P (P.vtile f z) F ∈ BazaarP p B0 M (fleetΨJ P f z x) pu A D S V f g d R:=by
 obtain ⟨⟨v,c⟩,rfl⟩:=h; rw [kickΔ,(WayMoveR P _).map_add,(WayMoveR P _).map_smul,vacWay_R]; let u:=ΤbandR d; let w:=S x R u; let y:=fleetΨJ P f z x; let T:=S y R u
 let X:= MeshΦ p B0 M y R u pu A T D (V.go ..) g v; let Z:= MeshΦ p B0 M x R u pu A w D (V.go ..) g v
 change WayMoveR P _ Z+_∈_; rw [show WayMoveR P _ Z=X from (funext fun i=> funext fun a=> funext fun b=> InclineMoveR p B0 M x pu A D g S V z i a b d R v)]; exact Δmk ..
