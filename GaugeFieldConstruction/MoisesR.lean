lemma PanWayR (F:ScreensJ P) (h:F∈ TivieraR p B0 M x pu A D S V u):WayMoveR P y F ∈ TivieraR p B0 M (x+y) pu A D S V u :=by
 obtain ⟨f,p',w⟩:= ((mint_voxel y).and (eventually_ge_atTop f0)).exists; obtain ⟨v,rfl⟩:=p'; rw [← orientP_R p B0 M x ((1,false):Signed × Bool) pu A D u S V w] at h
 rw[←orientP_R p B0 M _ ((1,false):Signed × Bool) pu A D u S V w]; exact RimAxisR p B0 M x pu A D w S V v ⟨1,false⟩ u _ h
lemma VirtWayR (P:Spine)(u:P.VMark)(X:ScreensJ P): Heapψ P (WayMoveR P u X)=Heapψ P X:=by
 -- transit inner_unit proper.Unfold.
 let Q:=X 3 (Sehya P) (Sehya P); let T:= P.transitTile; let x:=transitTile P 3 u; let y:=transitTile P 3 (-u); let R:=P.publicH 3; let θ:= floorVec P 3; let Y:= Q.val θ
 have hp(p:P.VMark) : (T 3 p).val θ=θ:=by change R.ρ (transitTile P 3 p) R.Ω=_; rw [R.transitReceipt, transit_Ω]; rfl
 change inner ℂ θ (x.val (Q.val (y.val θ)))= inner ℂ θ Y; rw [show y.val θ=θ from hp _]; -- use unitary
 let Z(k:P.VMark):= R.porchMove k; change inner ℂ R.Ω (R.ρ (transitTile P 3 u) Y)=_; rw [R.transitReceipt]; have he(z:R.H):‖Z u z‖=‖z‖:=by
    have ht(s:P.VMark)(w:R.H): ‖Z s w‖≤ ‖w‖:= R.canopy.raw_price _ _ _
    have he:= R.porch_plus (-u) u; rw[neg_add_cancel,R.porch_zero] at he; have hx:Z (-u) (Z u z)=z:=(DFunLike.congr_fun he z).symm
    exact (ht u z).antisymm ((congrArg norm hx.symm).le.trans (ht _ _))
 let F:R.H →ₗᵢ[ℂ] R.H:={ toLinearMap := (Z u).toLinearMap, norm_map' := he }
 have p:= F.inner_map_map R.Ω Y; change inner ℂ (Z u R.Ω) (Z u Y)=_ at p; rw [show Z u R.Ω= _ from transit_Ω R u] at p; exact p
lemma utfWayR(X:ScreensJ P)(h:X∈ Utf0P (TivieraR p B0 M x pu A D S V u)): WayMoveR P y X∈ Utf0P (TivieraR p B0 M (x+y) pu A D S V u):=⟨PanWayR p B0 M x pu A D u S V y X h.1,(VirtWayR P y X).trans h.2⟩
