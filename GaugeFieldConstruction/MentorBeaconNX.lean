private abbrev ChfNX (B:Lead n)(i:ExposureIndexNX):ℝ := NumberSpinNX (B,i) * (32*Maxwell.normal)^2
abbrev EvalΛNX (B:Lead n)(T:ExposureIndexNX→ℂ):ℝ := ∑ i:ExposureIndexNX, ‖T i‖^2 * ChfNX B i
lemma AheadScanNX (a:ExposureIndexNX→ℂ)(h:a≠0) :0< EvalΛNX B a:=by
 have ht(i:ExposureIndexNX):0 < ChfNX B i:= mul_pos (NumSPposNX ..) (pow_pos (mul_pos (by norm_num) Maxwell.normal_pos) _)
 apply sum_pos'; · intro i _; exact mul_nonneg (sq_nonneg _) (ht i).le
 obtain ⟨i,h⟩:= Function.ne_iff.mp h; exact ⟨i,mem_univ _,mul_pos (pow_pos (norm_pos_iff.mpr h) _) (ht i)⟩
include hm p H Y0
lemma HorizonFNX (L:ℕ→ℕ)(v:ℕ→ExposureIndexNX → ℂ)(T:ExposureIndexNX→ℂ)(d:Tendsto L atTop atTop)(u:Tendsto v atTop (𝓝 T)): Tendsto (fun i=> ‖GapHeightR P (L i) (ScanTicketR P (Y (L i)) (v i))‖^2) atTop (𝓝 (EvalΛNX B T)):=by
 let V(x y: ExposureIndexNX):= (B,(x,y).1); let X i j:= GapHeightR P i (Y i j); let α(x:ExposureIndexNX):BeaconNX n:= (B,x); let β(x y:ExposureIndexNX):=ArmΔScanNX (α x) (α y)
 have h(i j):Tendsto (fun k=> Star.star (v k i)*v k j*inner ℂ (X (L k) i) (X (L k) j)) atTop (𝓝 (Star.star (T i)*T j*β i j)):= by
    apply (((tendsto_pi_nhds.mp u i).star).mul (tendsto_pi_nhds.mp u j)).mul; exact (CountersFNX p Q t u' H m _ hm _ _ _ _ (Y0 i) (Y0 j)).comp d
 have hz: ((∑ i:ExposureIndexNX,∑ j: ExposureIndexNX, Star.star (T i)* T j * β i j):ℂ)= (↑(EvalΛNX B T):ℂ):=by
    unfold EvalΛNX; rw[Complex.ofReal_sum]; apply sum_congr rfl; intro i _; rw[sum_eq_single i]
    · have he: Star.star (T i)* T i = (↑‖T i‖ :ℂ)^2:= by
         exact (mul_comm ..).trans (inner_self_eq_norm_sq_to_K (𝕜:=ℂ) (T i)) 
      rw[he,show β i i=_ from (show β i i=(NumberSpinNX (α i):ℂ)*kBlendNX*kBlendNX from if_pos rfl)]; unfold ChfNX α kBlendNX; push_cast; ring
    · intro j _ h; rw [show β i j=0 from if_neg (show (α i).2 ≠ (α j).2 from Ne.symm h)]; rw [mul_zero]
    simp
 have g:= tendsto_finsetSum Finset.univ fun i _=> tendsto_finsetSum Finset.univ fun j _=> h i j
 rw [hz] at g; let G:= Complex.continuous_re.continuousAt.tendsto.comp g
 apply (show Tendsto _ _ _ from G).congr; intro i
 let V:=GapHeightR P (L i) (ScanTicketR P (Y (L i)) (v i)); change Complex.re (∑ x:ExposureIndexNX, ∑ y:ExposureIndexNX,_)=‖V‖^2
 have he: (inner ℂ V V).re= ‖V‖^2:= inner_self_eq_norm_sq (𝕜:=ℂ) _
 refine (congrArg Complex.re (Eq.symm ?_)).trans he
 let T:= RootApR P (L i); let F:= AChordR P 3
 change inner ℂ (F (∑ j:ExposureIndexNX,v i j • (Y (L i) j 3 T T))) (F (∑ j:ExposureIndexNX,v i j • (Y (L i) j 3 T T)))=_
 rw [map_sum,sum_inner]; apply sum_congr rfl; intro x _; rw [inner_sum]; apply sum_congr rfl; intro y _
 rw[F.map_smul,F.map_smul,inner_smul_left,inner_smul_right]; exact (mul_assoc ..).symm
omit hm p H Y0
private lemma TangleScanNX {E F S:Type*}[NormedAddCommGroup E][NormedSpace ℂ E][FiniteDimensional ℂ E]
    [NormedAddCommGroup F][NormedSpace ℂ F][Nonempty S](X:ℕ→ S→E→ₗ[ℂ] F)(C:E→ℝ)
    (p:∀ x:E,x≠0→0<C x)(G:∀ (L:ℕ→ℕ)(y:ℕ→S)(T:ℕ→ E) (z:E), Tendsto L atTop atTop→ Tendsto T atTop (𝓝 z)→ Tendsto (fun i=> ‖X (L i) (y i) (T i)‖^2) atTop (𝓝 (C z))) : ∃ k>0,∀ᶠ i:ℕ in atTop,∀ t:S,∀ x:E, k*‖x‖≤‖X i t x‖:=by
 haveI: ProperSpace E:=FiniteDimensional.proper ℂ _
 suffices H: ∃ k>0,∀ᶠ i in atTop,∀ t:S,∀ x:E, ‖x‖=1 → k≤‖X i t x‖ by
    obtain ⟨k,v,p⟩:=H; refine ⟨k,v,p.mono fun i h y v=>?_⟩; by_cases q:v=0
    · subst v; simp
    have hz:0< ‖v‖:=norm_pos_iff.mpr q; let z:ℂ:= ‖v‖; have hr:‖z‖=‖v‖:= Complex.norm_of_nonneg (norm_nonneg _) -- tune
    have ht:‖z⁻¹ • v‖=1:=by rw[norm_smul, norm_inv,hr, inv_mul_cancel₀ hz.ne']
    have h':=h y _ ht; rw[map_smul, norm_smul,norm_inv,hr, mul_comm,← div_eq_mul_inv] at h'; exact (le_div_iff₀ hz).mp h'
 by_contra! h
 have he(k:ℕ): ∃ i ≥ k,∃ y:S,∃ x:E,‖x‖=1 ∧ ‖X i y x‖< ((k:ℝ)+1)⁻¹:= frequently_atTop.mp (h _ (by positivity)) k -- tune
 choose i d y x t r using he
 obtain ⟨a,c,R,p',F⟩:= (isCompact_sphere (0:E) 1).tendsto_subseq (fun i=> show x i∈Metric.sphere (0:E) 1 from by rw [Metric.mem_sphere,dist_zero_right]; exact t i)
 have H:0<C a:= p _ (by intro w; rw[Metric.mem_sphere,w,dist_self] at c; norm_num at c)
 let V:= G (fun j=> i (R j)) (y∘R) (x∘R) a ((tendsto_atTop_mono d tendsto_id).comp p'.tendsto_atTop) F; have hy:Tendsto (fun j=>(R j:ℝ)+1) atTop atTop:= ((Filter.tendsto_atTop_add_const_right _ (1:ℝ) tendsto_natCast_atTop_atTop).comp p'.tendsto_atTop)
 obtain ⟨j,g,h⟩:= ((((tendsto_inv_atTop_zero.comp hy).pow 2).eventually (ge_mem_nhds (show (0:ℝ)^2<C a/2 by rw [zero_pow (by decide : (2:ℕ)≠0)]; linarith))).and (V.eventually (Ioi_mem_nhds (half_lt_self H)))).exists
 have hx:= pow_le_pow_left₀ (norm_nonneg _) ((r (R j)).le) 2; exact (not_le.mpr h) (hx.trans g)
include hm p H Y0
lemma FinalMentNX : ∃ k:ℝ, 0<k ∧∀ᶠ f in atTop,∀ v: ExposureIndexNX → ℂ,k * ‖v‖ ≤ ‖GapHeightR P f (ScanTicketR P (Y f) v)‖:=by
 let Z(k:ℕ): ScreensJ P→ₗ[ℂ] P.Hil 3:=⟨⟨fun v=>GapHeightR P k v,fun i j=>rfl⟩,fun i j=>rfl⟩
 let X(k:ℕ)(_w:Unit):= (Z k).comp (ScanTicketR P (Y k)); obtain ⟨z,h,t⟩:= TangleScanNX X (EvalΛNX B) (AheadScanNX B) (fun L _ a b k i=>HorizonFNX p Q t u' H m hm B A1 Y Y0 L a b k i) -- tune order
 exact ⟨z,h,t.mono fun i j=> j ()⟩
