private lemma BloomRightFNX {F:Type}[NormedAddCommGroup F][InnerProductSpace ℂ F](A B X Y:ℕ→ F)(v w k:ℂ)(h:Tendsto (fun i=>inner ℂ (A i) (A i)) atTop (𝓝 v))(d:Tendsto (fun i=>inner ℂ (B i) (B i)) atTop (𝓝 w))(p:Tendsto (fun i=>inner ℂ (A i) (B i)) atTop (𝓝 k))(a:Tendsto (A-X) atTop (𝓝 0)) (b:Tendsto (B-Y) atTop (𝓝 0)): Tendsto (fun i=> inner ℂ (X i) (Y i)) atTop (𝓝 k):=by
 have ht {V:ℕ→F} {y:ℂ} (p:Tendsto (fun i=>inner ℂ (V i) (V i)) atTop (𝓝 y)) : Tendsto (fun i=> ‖V i‖) atTop (𝓝 (Real.sqrt y.re)):=by
    refine ((Complex.continuous_re.continuousAt.tendsto.comp p).sqrt).congr ?_; intro i; change Real.sqrt (inner ℂ (V i) (V i)).re=_; rw [inner_self_eq_norm_sq_to_K]; change Real.sqrt ((↑‖V i‖:ℂ)^2).re=_; rw [← Complex.ofReal_pow, Complex.ofReal_re, Real.sqrt_sq (norm_nonneg _)] -- tune
 have hh {V W:ℕ→ F}{y z:ℝ}(h:y*z=0)(p:Tendsto (fun i=> ‖V i‖) atTop (𝓝 y))(q:Tendsto (fun i=> ‖W i‖) atTop (𝓝 z)): Tendsto (fun i=>inner ℂ (V i) (W i)) atTop (𝓝 0):=by rw[tendsto_zero_iff_norm_tendsto_zero]; have he:=p.mul q; rw[h] at he; exact squeeze_zero (fun _=>norm_nonneg _) (fun i=> norm_inner_le_norm ..) he
 let R:=A-X; let S:= B-Y
 have hp:Tendsto (fun i=> ‖R i‖) atTop (𝓝 0):= tendsto_zero_iff_norm_tendsto_zero.mp a; have hy:Tendsto (fun i=> ‖S i‖) atTop (𝓝 0):=tendsto_zero_iff_norm_tendsto_zero.mp b
 have hh:= ((p.sub (hh (mul_zero _) (ht h) hy)).sub (hh (zero_mul _) hp (ht d))).add (hh (zero_mul _) hp hy)
 rw [sub_zero,sub_zero,add_zero] at hh
 refine hh.congr fun i=> ?_
 have ha:X i=A i-R i:=by change X i=A i-(A i-X i); abel; -- tune simp
 have hv:Y i=B i-S i:=by change Y i=B i-(B i-Y i); abel;
 change _=inner ℂ (X i) (Y i); rw[ha,hv,inner_sub_left,inner_sub_right,inner_sub_right]; abel
