 apply SaberFe.together ?_ ((feeP_1 β P).scale z); intro s t; let N:=P.calibration.c s; rw[hv',hv,←Fock.twin]; rw[show quantU (TVfe N β)*quantU (TVfe N α)=quantU (TVfe N (β*α)) from ?_]; unfold TVfe; rw [chipMulU,map_mul]; exact Subtype.ext (quant_mul (TVfe N β).val (TVfe N α).val).symm
