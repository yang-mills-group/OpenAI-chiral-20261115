variable {E O:Type*}[Fintype E][Fintype O][DecidableEq E][DecidableEq O]
lemma loomer_T (x y:FrameK E): LoomK (x+y) ≤LoomK x+ LoomK y:=by unfold LoomK; rw[←sum_add_distrib]; exact sum_le_sum (fun i _=> norm_add_le ..)
lemma loomer_J (w:ℂ)(y:FrameK E): LoomK (w • y)=‖w‖*LoomK y:=by unfold LoomK; rw [mul_sum]; exact sum_congr rfl (fun i _=> norm_mul ..)
lemma loomer_Y (w:FrameK E): LoomK (-w)=LoomK w:=sum_congr rfl (fun i _=>norm_neg _)
lemma loomer_N : LoomK (0:FrameK E)=0:=by unfold LoomK; simp
lemma loomer_W (Y:E→ FrameK O)(S:Finset E): LoomK (∑ j∈S,Y j) ≤∑ j∈S,LoomK (Y j):=by
 classical
 induction S using Finset.induction_on with
 | empty=>rw [sum_empty,sum_empty,loomer_N]
 | insert i X p ih=>rw [sum_insert p,sum_insert p]; linarith only [loomer_T (Y i) (∑ j∈X,Y j),ih]
abbrev SkillJ (L:FrameK E→ₗ[ℂ]FrameK O)(b:ℝ): Prop:=∀ w:FrameK E,LoomK (L w) ≤ b*LoomK w
abbrev SkillA (L:FrameK E→ₗ[ℂ]ℂ)(b:ℝ):Prop:=∀ w:FrameK E,‖L w‖ ≤ b*LoomK w
section
variable {E O:Type}[Fintype E][Fintype O][LinearOrder E][LinearOrder O]
lemma Καone (w:FrameK E): w=∑ i:E,w i • κEye i:=by ext j; unfold κEye; simp [Finset.sum_apply,Pi.single_apply,mul_ite] -- DecidableEq conflict check
lemma loomer_single (w:FrameK E)(A:FrameK E→ₗ[ℂ] FrameK O):A w=W_s (fun i=> A (κEye i)) w:=by nth_rw 1 [Καone w]; rw [map_sum]; simp only[map_smul,W_s]
lemma single_BJ (b:ℝ)(A:FrameK E→ₗ[ℂ]FrameK O)(h:∀ i:E,LoomK (A (κEye i))≤ b):SkillJ A b:=by
 intro w; rw [loomer_single]; apply le_trans (loomer_W ..); simp_rw [loomer_J]; rw [mul_comm b]; unfold LoomK; rw [sum_mul]; apply sum_le_sum; intro i _; exact mul_le_mul_of_nonneg_left (h i) (norm_nonneg _) -- unfolding Lhs issue
end
