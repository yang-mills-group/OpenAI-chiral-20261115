lemma PatchVenueNX (Z:ScreensJ P){F G:ℕ→P.Test}(u: F=ᶠ[atTop] G)(x:VenueX 0 Z F):VenueX 0 Z G:=by
   refine ⟨fun i σ τ=>?_,(u.and x.2).mono (fun i h=>(show G i∈bay .. from h.1 ▸ h.2))⟩ -- tune
   obtain ⟨W,q,g⟩:=x.1 i σ τ; exact ⟨W,q,(u.and g).mono fun i h=> h.1 ▸ h.2⟩ -- tune
lemma chartGroundNX(F:P.Test): P.chartAll 0 F=F:= Subtype.ext ((P.followsChart ..).trans (Vacancy.cad_zero _ _ ((marque ..).1 F.property)))
lemma poseGroundNX(P:Spine)(s:ℕ): P.meshPose s 0=0:=by funext i; change _= (0:ℝ); exact P.tock_zero _ -- tune
lemma PrechargeNX(U:ScreensJ P)(F:ℕ→P.Test)(u:VenueX 0 U F): Tendsto (fun s=> P.singleState 3 s v (F s)) atTop (𝓝 (Seen1N (SΡχ P v) U 0)):=by
    obtain ⟨q,g,x⟩:= WearingOneN (P:=P) _ _ u
    apply Metric.tendsto_nhds.mpr; intro e u; filter_upwards [x,g.eventually (gt_mem_nhds u)] with s h p; have j:= h (SΡχ P v) 0; rw [chartGroundNX,poseGroundNX] at j; rw[dist_eq_norm]; exact lt_of_le_of_lt j p
lemma CenterNX (A:P.Glaze)(s:ℕ):P.singleState 3 s v (A.soot (P.singleState 3 s v A.F)).F=0:=by
    change P.singleState 3 s v (A.F+(-(P.singleState 3 s v A.F)) • 1)=0; rw[map_add,map_smul,show P.singleState 3 s v 1=1 from by rw[P.single_state,P.reading_unit,map_one],smul_eq_mul,mul_one,add_neg_cancel]
lemma PerturbNX (A:ℕ→P.Glaze)(Z:ScreensJ P)(y:BasketNX P A id Z)(a:ℕ→ℂ)(p:Tendsto a atTop (𝓝 0)):BasketNX P (fun s=> (A s).soot (a s)) id Z:=by
    refine ⟨y.1,?_⟩; intro i σ τ; let L:= P.hearthNX i ((σ.val:ℝ)+(τ.val:ℝ)); have ht:= (y.2 i σ τ).add (p.neg.smul_const L); rw [neg_zero,zero_smul,add_zero] at ht -- tune
    apply ht.congr'; filter_upwards [y.1.eventually (gt_mem_nhds σ.2),y.1.eventually (gt_mem_nhds τ.2)] with s h v; let D:=A s; let d:=D.w; change P.grantGapNX i s d D.F _ _+ _=P.grantGapNX i s d (D.F+(-(a s)) • 1) _ _
    have he:P.BEntry i (d+d) (P.shifts i d 1):=by rw [map_one]; exact BEntry.one P i (add_pos D.pos D.pos)
    rw[civicPlusNX i d s (D.centers i) (by rw[map_smul]; exact he.smul _),civicSharesNX i d s he,civicUnitNX i d D.pos s h.le v.le]
    -- tune
abbrev CentroidNX(A:ℕ→P.Glaze): ℕ→P.Glaze:=fun s=>(A s).soot (P.singleState 3 s v (A s).F)
def PearyNX(i:ℕ)(A:ℕ→P.Glaze):Prop:= E.ExhibitGeVu i (fun s=> (A s).F) ∧ BasketNX P (CentroidNX v A) id (E.RoomsVU (E.FloraBinVU i)) ∧ ∃ S:Finset Cover, ∀ᶠ s in atTop,(A s).S=S
include q hp qx
lemma FollyBeltNX(i:ℕ)(a:E.LeaseVU i): ∃ A:ℕ→P.Glaze,PearyNX E v i A:=by
    obtain ⟨F,y⟩:= E.PricesFeVU i; let S:=cartO (SceneAtN P 0) 28; obtain ⟨w,U,H⟩:= ((P.eventually_BFits S).and (eventually_ge_atTop 1)).exists
    let Z:= E.RoomsVU (E.FloraBinVU i); have he:∀ᶠ s in atTop,∃ A:P.Glaze,A.w=w ∧ A.F=F s∧ A.S=S:= y.2.mono fun s h=>by
        have p:= h 0; rw [chartGroundNX] at p; exact ⟨⟨_,H,S,F s,p.2.1,p.1,U⟩,rfl,rfl,rfl⟩
    let B:= (he.exists.choose_spec.choose); let A(s:ℕ):P.Glaze:= if h:∃ A:P.Glaze,A.w=w∧A.F=F s∧ A.S=S then h.choose else B
    have hz: ∀ᶠ s in atTop, (A s).w=w∧ (A s).F=F s∧ (A s).S=S:= he.mono fun s h=> by unfold A; rw [dif_pos h]; exact h.choose_spec
    let C:=CentroidNX v A
    have hV:= PatchVenueNX Z (hz.mono (fun s v=>v.2.1.symm): F =ᶠ[atTop] fun s=>(A s).F) y.1.1
    have hh:E.ExhibitGeVu i (fun s=>(A s).F):= ⟨⟨hV,(hz.and y.1.2).mono fun s e=> by dsimp only; rw[e.1.2.1]; exact e.2⟩, GaugeRoomUV _ _ _ (show RaysΦUV E.Dp _ _ from ⟨hV,(hz.and y.1.2).mono fun s e=> by dsimp only; rw[e.1.2.1]; exact e.2⟩)⟩
    have ht:= E.CloudVU p v hp 0 (E.FloraBinVU i); rw [E.forswearVU p v q hp qx i a] at ht
    have hL: Tendsto (fun s=> P.singleState 3 s v (A s).F) atTop (𝓝 0):=(show 0=Seen1N (SΡχ P v) Z 0 from ht).symm ▸ PrechargeNX _ _ _ hV
    refine ⟨A,hh,PerturbNX _ _ (BasketSeedNX hV ?_) _ hL, S,hz.mono fun s v=> v.2.2⟩; exact (P.tock_fades w).congr' (hz.mono fun s v=> congrArg (fun i:ℕ=>P.tock s i) v.1.symm)
#print axioms FollyBeltNX
