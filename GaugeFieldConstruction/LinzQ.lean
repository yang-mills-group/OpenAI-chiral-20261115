lemma fare_ProofQ (l:List X)(S:X→ Mark (side P.run i (P.run.uv k)))(Fv:X→ℝ)(Gv:∀x∈l, Circζ P.run i k θ M' f x (S x) (Fv x))(t:l.Pairwise (·<·)): ‖Cap_ZΛ P.run i k (l.map S).prod‖≤ (SkyWJ P.par (side P.run i f) f* (inkΛJ p.u)^l.length)*(l.map Fv).prod:=by
 let ΘW:= PlaneXQ A M i k X (fun _:X=>Z false) r (fun _=> L false) 0 f
 let K:= M'.Mark f; let W:=ηQ; have U:= qU.bill; let σ:= (TolJ X θ).F_v (ΘW.σ f)
 let R:= Kγ; let c:=RankQJ P.par f; let C:=SkyWJ P.par (side P.run i f) f; let K1:= inkΛJ p.u; have ht:1 ≤ C:=le_add_of_nonneg_right (Real.exp_pos _).le
 let z:=hG.trans gU.le; have hx:0 ≤ c:=sq_nonneg _; have hr:1≤K1:= Real.one_le_exp (by linarith[p.ν]); let w:=Κt
 have R':=CityCq f p A M i k (fun _:X=>Z false) r (fun _=>L false) 0 tE (show 3*f ≤ P.run.uv k from by omega) z0
 have V'' (l:List Νp)(pA:galaJ w l): ‖Cap_ZΛ P.run i k ((l.map K).prod)‖ ≤ C*K1^l.length*c^ l.length:=by
    let Zs:= ValueHJ f ΘW M'; have e:= U.fare l pA ∅ 1 ⟨Finset.disjoint_empty_left _,AtSupport.oneM _⟩
    let J:= P.run; let P':= P.par; let α:= partitionZ (RootBook P.run i k f) P.par.U ((J.voyage i).CapeT f)
    rw[convoy_one _ _ _ g _ le_rfl,one_mul] at e -- cir variables
    let Γ:= partitionZ (RootBook P.run i k (J.uv k)) P.par.U ((J.voyage i).CapeT (J.uv k))
    have hz: α=Γ:=(((J.voyage i).X (J.uv k)).balance f z).trans (((J.voyage i).X (J.uv k)).balance (J.uv k) le_rfl).symm
    change markedRead _ _ (Zs l)=RevenueT P.run i k (l.map K).prod at e; change ‖ (RevenueT P.run i k _)/ Γ‖≤ _; rw[← e,← hz, markvac, norm_div]
    have V':= (W.cost z0 z).power (Νp) σ (M'.Roll f).F (M'.Roll f).E l (qU.path.tandem (s:=f) le_rfl hG|>.2.1) (qU.arc.force le_rfl z) (gala_ψ P.run i w σ (R'.camp le_rfl z) l pA)
    apply le_trans _ (show (ExpWJ P.par _ f*K1^l.length)* c^l.length≤_ from (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right (show ExpWJ P.par _ f≤ C from le_add_of_nonneg_left zero_le_one) (pow_nonneg (zero_le_one.trans hr) _)) (pow_nonneg hx _)))
    rw [div_le_iff₀ (norm_pos_iff.mpr ((J.each_level i k f g z).valid))]; change _ ≤ BillJ P.par f (side P.run i f) p.u l.length * ‖α‖ at V'; refine le_trans V' ?_; unfold BillJ; rw[Real.exp_add, mul_comm (2*p.u),Real.exp_nat_mul]; unfold K1 c ExpWJ inkΛJ; apply le_of_eq; ring -- tune
 have he:= Sermon P.run i k X (SailκJ X θ) w K C K1 c hx ht V'' (fun i=>U.stamped.owns i) g hr S Fv l Gv [] (by simpa using t); simpa only[List.map_nil,List.prod_nil,List.length_nil,zero_add,pow_zero,mul_one,one_mul] using he
#print axioms fare_ProofQ
