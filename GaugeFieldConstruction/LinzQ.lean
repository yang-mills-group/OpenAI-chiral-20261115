lemma ChargeζQ (x:FrameK (Fin (θ G'.2))) : Circζ P.run i k θ M' f G'.1 (ΓPrimary P.run i k θ M' G' s x) (LoomK x*RankQJ P.par s):=by
 let Pat:=p.price f z0 G'.2 s; let W:= Hρ; let k':=EarnCQ f A M i k Z r L M' G'; let E:=ΓPrimary P.run i k θ M' G'; let S:= PlcJ s f k' hG; let X':= AcJ k' s f hG; have he:= BasisBQ ηQ W z0 M' _ s gU.le qU.path N le_rfl -- order
 have hE: Bijective S:= (ζAccum _ k' f s f s he Pat le_rfl hG le_rfl).2.1
 obtain ⟨x,rfl⟩:=hE.surjective x
 have h:= CorsV _ k' f s f s he Pat le_rfl hG le_rfl x
 have hu: E s (S x)=E f x+X' x • 1:=by
    have hp:= chantBQ ηQ W qU.arc z0 M' G' s gU.le qU.path N (le_refl s) -- order
    have hh:=TrekJ.PathJ _ k' f s f s E hp le_rfl hG le_rfl x; exact (eq_sub_iff_add_eq.mp hh).symm
 let w:= RankQJ P.par f; have hp:= (primAJ P.run i k f θ M' G' x).add ((ChargedJ.one (x:=G'.1) (M:=M'.Mark f) (F:=TolHouseJ θ) (c:=w)).smul (X' x)) -- dot notation $(Circζ not reducible dot)
 change C_ G'.1 (E s (S x)) _; rw[hu]; apply ChargedJ.lift _ hp; rw[mul_one,mul_comm (LoomK x),mul_comm (LoomK (S x))]; simpa using h -- tune
