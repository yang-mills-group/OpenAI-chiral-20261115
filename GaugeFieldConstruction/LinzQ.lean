 let K:=Hρ; let S:=ΓPrimary P.run i k θ M'; let T:=EarnCQ f A M i k Z r L M' G'; let C:=EarnOQ f A M i k Z r L M' G' h0
 have t:=p.price f z0 G'.2 s; have he:=BasisBQ ηQ K z0 M' G' s gU.le qU.path N (le_refl s); have hp: GainJ (RankQJ P.par) (ScaleμJ P.par G'.2.val) (chipJ P.par) (sideJ P.par) f s C :=earnQG ηQ K z0 M' G' s gU.le qU.path N _ (le_refl s); have hv: Clipζ Λf (1/2) (0:ThreadJ (E:=Fin (θ G'.2))):= ⟨fun i=>by change LoomK (0:FrameK (Fin (θ G'.2)))≤ _; simp only [LoomK,Pi.zero_apply,norm_zero,sum_const_zero]; exact mul_nonneg (by norm_num) (noLoom i), fun i=>by change ‖(0:ℂ)‖≤ _; rw[norm_zero]; exact mul_nonneg (mul_nonneg (by norm_num) ((p.tempo f z0).1.le)) (noLoom _)⟩
 exact Jet_r _ _ f f s he t C hp _ le_rfl hG le_rfl hv
#check ArmJ
lemma ageCostQ (x:Fin (θ G'.2)): Circζ P.run i k θ M' f G'.1 (M'.Mark s h0.val- ΓPrimary P.run i k θ M' G' s ((EarnRQ f s A M i k Z r L M' hG G' h0).1 (κEye x))- ((EarnRQ f s A M i k Z r L M' hG G' h0).2 (κEye x)) • 1) ((ScaleμJ P.par G'.2.val)^(s-f)* RankQJ P.par f):=by
 let H:=Hρ; let T:=Qχ; let K:= T.C f; let E:=ΓPrimary P.run i k θ M' G'; let C:=EarnOQ f A M i k Z r L M' G' h0; have Art:= chantBQ ηQ H qU.arc z0 M' G' s gU.le qU.path N (le_refl s)
 let A':= GapPJ M' G' (fun _ :Fin (θ G'.2)=>h0); let b:=κEye x; let vB:= ScaleμJ P.par G'.2.val
 have ΓΦ: ArmJ (1:Mark (side P.run i (P.run.uv k))) C E A' f s (μ0:=vB):= by
    refine passageQ ηQ H qU.arc z0 M' G' s gU.le qU.path N (fun _=>h0) s le_rfl fun i' p q t v=>?_
    change h0.val∈ (BoltDate θ 0 i').toFinset at v; simp [BoltDate,χBty] at v
 let R:= EarnRQ f s A M i k Z r L M' hG G' h0; have h:= TraceNJ _ T f s f s C E A' Art ΓΦ le_rfl hG le_rfl b (0:ThreadJ (E:=Fin (θ G'.2))); have e:(vB:ℂ)^(s-f) • M'.Mark f h0.val= M'.Mark s h0.val-E s (R.1 b)-R.2 b • 1:=by
    change GapPJ _ _ _ _ b - E s (R.1 b)- R.2 b • 1=(vB:ℂ)^(s-f) • (A' f b- E f ((0:ThreadJ (E:=Fin (θ G'.2))).1 b)-_ • (1:Mark _)) at h
    let T':=(0:ThreadJ (E:=Fin (θ G'.2))); have ht:A' f b- E f (T'.1 b)-T'.2 b • 1=M'.Mark f h0.val:=by rw[show T'.2 b=0 from rfl,show T'.1 b=0 from rfl, zero_smul,map_zero,sub_zero,sub_zero]; exact Arach_B _ _
    change A' s b- E s (R.1 b)-R.2 b • 1=(vB:ℂ)^(s-f) • (A' f b-E f (T'.1 b)-T'.2 b • 1) at h; rw [ht,show A' s b=M'.Mark s h0.val from Arach_B _ _] at h; exact h.symm
 change Circζ _ _ _ _ _ _ _ (M'.Mark s h0.val-E s (R.1 b)- R.2 b • 1) (vB^(s-f)*_); rw [←e,show vB^(s-f)=‖(vB:ℂ)^(s-f)‖ from (by have h_v:0 ≤vB:= (p.price f z0 G'.2 s).small; rw [norm_pow,Complex.norm_real,Real.norm_of_nonneg h_v])]; exact ChargedJ.smul _ (ChargedJ.coin h0.val (congrArg Prod.fst h0.property.1))
