lemma AnnualQw(z:SailκJ X θ)(q0:(TolJ X θ).own z=G') : let Lo:=RankQJ P.par; Circζ P.run i k θ M' f G'.1 (M'.Mark s z) ((ScaleμJ P.par G'.2.val)^(s-f)* (Lo f)+ 2* Lo s):=by
 subst G'; intro Lo; let W:=TolJ X θ; let d:= W.own z; let T:=ΓPrimary P.run i k θ M' d; let J:= (TolTileJ _ z).2.1; let Q:= Facingκ θ d
 have hx(i:Fin (θ d.2)): LoomK (κEye i)=1:=by
     unfold LoomK κEye; rw [Finset.sum_eq_single_of_mem (s:=univ) i (mem_univ _)]; · simp [Pi.single_apply]
     intro j _ h; simp [Pi.single_apply,h] -- tune
 let pV:= ScaleμJ P.par d.2.val; let n0:= Lo s; let T':= Lo f; have hP:pV≥0:=(p.price f z0 d.2 s).small; have hn:0≤n0:=sq_nonneg _; have hv':0≤T':=sq_nonneg _
 have hr:= ChargeζQ f s p A M i k v g Z r L ‹BoardDate (ChildQ X)› ι Y M' Ω hG z0 gU qU d -- args & T shadow
 by_cases e: W.kind z=true
 · let t:W.Pname d:=⟨z,rfl,e⟩; obtain ⟨j,hj⟩:= Q.surjective t; let x:= κEye j; have hg:T s x=M'.Mark s z:= (ser_i s M' d Q j).trans (congrArg (M'.Mark s) (congrArg Subtype.val hj))
   have g:= hr x; change Circζ _ _ _ _ _ _ _ (T s x) (LoomK (κEye j)*Lo s) at g; rw [hx,hg] at g; apply ChargedJ.lift _ g; rw [one_mul]; change _≤ pV^(s-f)*T'+2*n0; linarith [mul_nonneg (pow_nonneg hP (s-f)) hv']
 let t:W.Vname d:= ⟨z,rfl,Bool.eq_false_iff.mpr e⟩; let R:=EarnRQ f s A M i k Z r L M' hG d t; let u:=κEye J
 have hh:= ageCostQ f s p A M i k v g Z r L ‹BoardDate _› ι Y M' Ω hG z0 gU qU d t J -- tune G'.
 let K:=M'.Mark s z; have k':Circζ P.run i k θ M' f d.1 (K-T s (R.1 u)- R.2 u • 1) (pV^(s-f)*T'):=hh
 have hR:=hr (R.1 u); let H:=ChargedJ.add k' ((ChargedJ.one (x:=d.1) (c:=T') (M:=M'.Mark f) (F:=TolHouseJ θ)).smul (R.2 u)); let G:= H.add hR; rw [sub_add_cancel] at G; change ChargedJ _ _ _ _ (K-T s (R.1 u)+T s (R.1 u)) _ at G; rw[sub_add_cancel] at G
 let V: Clipζ n0 (1/2) R:=ΡIncomeQ f s p A M i k v g Z r L ‹BoardDate _› ι Y M' Ω hG z0 gU qU d t
 apply ChargedJ.lift _ G; change pV^(s-f)*T'+‖R.2 u‖*1+ LoomK (R.1 u)*n0 ≤ pV^(s-f)*T'+2*n0; have hp:= V.1 u; have ht:= V.2 u; unfold u at ht hp ⊢; rw [hx] at hp ht; nlinarith only [mul_le_mul_of_nonneg_right hp hn,ht,hn]
