lemma ProgressNX (e:∀ᶠ i in atTop,Qx i≤ u' i): Tendsto (fun i=>HouseNX F G A i (u' i)) atTop (𝓝 A.Horizon_μN):=by
 let Q:= Qx; have g(i):=BrightShrinkNX _ _ _ _ (a i).2; have h(i):=BrightShrinkNX _ _ _ _ (b i).2; have v(i):VenueY 0 (Y i):=⟨_, (A.Fcal i).1⟩; have w(i): VenueY 0 (Z i):=⟨_,(A.Gcal i).1⟩; have z:Tendsto Q atTop atTop:=SportR.tale P K; refine tendsto_pi_nhds.mpr (fun i=> tendsto_pi_nhds.mpr fun j=>?_); exact (NearCost2_NX Q z Χw u' e (F i) (G j) _ _ (v i) (g i) (a i).1 (w j) (h j) (b j).1 _ _ _ A.scopeN).sub ((NearCost1_NX Q z Χw _ e _ _ (v i) (g i) (a i).1 _).mul (NearCost1_NX Q z Χw _ e _ _ (w j) (h j) (b j).1 _))
