abbrev CoverageNX (i:ℕ):Prop:=(∀ j:ClanZN,P.spacePrice (F j i) A.K⊆ A.A_X)∧ ∀ j:ClanZN,P.spacePrice (G j i) A.L⊆ A.B_Y
lemma ProvenumNX : ∀ᶠ i in atTop,CoverageNX F G A i ∧ ∀ t:ℕ, SportR P K i≤t→ HouseNX F G A i t ∈ PrecisionYN A.δ ∧ (∃! Q:P.Test→ₗ[ℂ]ℂ,P.SameRawProduct t ξσ Q) ∧ ∀ Q:P.Test→ₗ[ℂ]ℂ,P.SameRawProduct t ξσ Q→ TailNX (f:=i) F G A t Q ∧ Q ≠ P.singleState 3 t ξσ:=by
 let S:= SportR P K; have ht:∀ᶠ i in atTop,∀ t:ℕ,S i≤t→ HouseNX F G A i t ∈ PrecisionYN A.δ:= EventuallyRightNX _ fun u e=> (ProgressNX u F G A a b e).eventually ((PointMatrix_μN _).mem_nhds A.test)
 filter_upwards[ht,eventually_all.mpr fun i:ClanZN=> ApertShrinkNX (F i) A.K _ _ _ ((a i).2) A.A_X A.Aopen A.Kinside,eventually_all.mpr fun i:ClanZN=> ApertShrinkNX (G i) A.L _ _ _ ((b i).2) A.B_Y A.Bopen A.Linside] with r p W Y
 refine ⟨⟨W,Y⟩,fun t h=>?_⟩; have pv:=p t h
 refine ⟨pv,P.thin_comparator ..,fun Q q=>?_⟩
 have ha(i):= (a i).2 r; have hv(i):= (b i).2 r; have hf(i): (F i r).s≤t:=(ha i).2.2.1.trans_le h; have hg(i): (G i r).s≤t:=(hv i).2.2.1.trans_le h
 have he(i):Q (P.prepared t (F i r) A.K)=0:= P.thin_zero_single t A.K Q q.marginal.factors (.inl q.matter) _ _ (ha i).2.1 (hf i)
 let U:= PricingLoopNX F r; let V:=PricingLoopNX G r
 have hu:MarketN A.K A.L U V Q t=0:=by
    ext1 i; funext j
    have ht:= P.split_test t (F i r) A.K (G j r) A.L ((bundleDisΝ A.width A.ε_pos).mono (W i) (Y j)) (hf i) (hg j) _ (ha i).2.1 Q q.marginal.factors (.inl q.matter)
    change Q (P.prepared t (F i r) A.K * P.prepared t (G j r) A.L)-Q (P.prepared t (F i r) A.K)*Q _=0
    rw[ht,he,zero_mul,sub_self]
 refine ⟨⟨fun i=> ⟨he i,P.thin_zero_single t A.L Q q.marginal.factors (.inl q.matter) _ _ (hv i).2.1 (hg i)⟩,hu⟩,?_⟩; intro g; rw [g] at hu
 have ht:= visibleXN pv (0,false); rw[show HouseNX F G A r t=0 from hu] at ht; exact lt_irrefl _ (lt_trans A.δ_pos ht)
