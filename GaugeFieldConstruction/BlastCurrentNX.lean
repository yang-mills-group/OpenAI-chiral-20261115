lemma BandedWidthNX (a:MagazineNX P F k u0 x0)(j:Axis): Tendsto (fun i=> (F i).realWidth P j) atTop (𝓝 0):=by
 let w:=P.probeClock u0 j; let h(x):= P.mellow x
 have hp:Tendsto (fun i=> h (SportR P k i)*((ruler P.par.block*(w:ℤ):ℤ):ℝ)) atTop (𝓝 0):=by
    simpa only [Function.comp_apply,zero_mul] using ((mellowMountNX P).comp (SportR.tale P k)).mul_const (((ruler P.par.block*(w:ℤ):ℤ):ℝ))
 apply hp.congr; intro i; unfold Apron.realWidth; rw[(a i).2.2.1, (a i).2.2.2.2]; exact (mellow_firm ..).symm -- tune
lemma ApertShrinkNX(a: MagazineNX P F k u0 x0)(U:Set Vantage)(e:IsOpen U)(p:tsupport K.val ⊆ U):∀ᶠ s in atTop,P.spacePrice (F s) K ⊆ U:=by
 obtain ⟨d,g,v⟩:= (show IsCompact (tsupport K.val) from K.budget).exists_thickening_subset_open e p
 filter_upwards[eventually_all.mpr fun i:Axis=> (BandedWidthNX F k u0 x0 a i).eventually (gt_mem_nhds g)] with s w; refine Set.Subset.trans ?_ v; rw [thickening_eq_biUnion_ball]
 intro x h; obtain ⟨y,c,h⟩:= Set.mem_iUnion₂.mp h; exact Set.mem_iUnion₂.mpr ⟨y,c, (dist_pi_lt_iff g).2 fun i=>(h i).trans_lt (w i)⟩
lemma EventuallyRightNX{S:ℕ→ℕ}(p:ℕ→ℕ→Prop)(v:∀ u:ℕ→ℕ,(∀ᶠ i in atTop,S i≤ u i) → ∀ᶠ i in atTop,p i (u i)): ∀ᶠ i in atTop, ∀ t:ℕ,S i≤ t→p i t:=by
 let R(i:ℕ):Prop:=∃ u:ℕ,S i≤u∧¬ p i u; let f(i:ℕ):ℕ:= if h:R i then Classical.choose (show ∃ j:ℕ,S i≤j∧¬ p i j from h) else S i
 have h(i:ℕ)(t:R i):S i ≤ f i ∧ ¬p i (f i):=by unfold f; rw[dif_pos t]; exact (show ∃ u:ℕ,S i≤u∧¬ p i u from t).choose_spec
 refine (v f (Eventually.of_forall fun i=>by by_cases po:R i; exact (h i po).1; rw [show f i=S i from dif_neg po] )).mono fun i t u e=> Classical.byContradiction fun hu=> ((h i ⟨u,e,hu⟩).2 t)
