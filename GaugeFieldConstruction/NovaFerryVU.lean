lemma localHeatVUV (t: E.SturdyVU p v q (L:=L) X G A): NSF.Boundary.Fields.causal (TagVU A.K) (TagVU A.L):=by
 intro x g y u; rw [moneyExtentVU] at g u; have hx:= (t.2.2.1 x.ofLp (A.Kinside g) y.ofLp (A.Linside u)).1.2
 change y-x ∈ Mink.spacelike at hx; rw [Mink.lateral] at hx ⊢
 rw [show x-y= -(y-x) from (neg_sub ..).symm]; rw [show YM.time (-(y-x))=- YM.time (y-x) from rfl, show YM.spatial (-(y-x))=-YM.spatial (y-x) from rfl,abs_neg,norm_neg]; exact hx -- tune
lemma LexHeatVUV (t:E.SturdyVU p v q (L:=L) X G A)(x y:(E.RadianceVU p).Union)(a:D.system.operators.domain):
    D.system.operators.field x (TagVU A.K) (D.system.operators.field y (TagVU A.L) a)=D.system.operators.field y (TagVU A.L) (D.system.operators.field x (TagVU A.K) a):= D.course.localPairs x y _ _ (E.localHeatVUV p v q D X G A t) a
lemma SystemMakerVU (i j:ClanZN): E.LorPriceVU p q (L:=L) X G A.K A.L i j= inner ℂ (Ξ_LVU i) (ΟζVU j):=by
 let x:=(E.PerD_VU p q).TinCanL (X i); let y:=(E.PerD_VU p q).TinCanL (G j); let f:=TagVU A.K; let g:=TagVU A.L
 have hp:(E.PerD_VU p q).TinCanL∘ ![X i,G j]=![x,y]:= by ext1 r; fin_cases r<;> rfl
 have h:(E.PerD_VU p q).TinCanL∘ ![X i]= ![x]:= by ext1 r; fin_cases r; rfl
 have ht:(E.PerD_VU p q).TinCanL∘ ![G j]= ![y]:= by ext1 r; fin_cases r; rfl
 let p':=PairCoinVU A.K A.L; let u:=MonoCoinVU A.K; let v':=MonoCoinVU A.L
 have he: p'=YM.Boundary.Joint.materialize _ ![f,g]:= congrArg (YM.Boundary.Joint.materialize 2) (show TagVU ∘ (![A.K,A.L]:Fin 2→SampleDose)= (![f,g]) from (by ext1 i; fin_cases i<;>rfl))
 have hd(c:SampleDose):MonoCoinVU c=YM.Boundary.Joint.materialize _ ![TagVU c]:= congrArg (YM.Boundary.Joint.materialize 1) (show TagVU ∘ ![c]=![TagVU c] from (by ext1 r; fin_cases r; rfl)) -- tune
 unfold LorPriceVU; rw[hp,h,ht,show PairCoinVU _ _=_ from he,hd,hd]; exact MintMarketVU D.system D.course x y f g
lemma VoltagePortVU (i:ClanZN)(j:ClanZN): E.LorPriceVU p q (L:=L) X G A.K A.L i j= inner ℂ (Ξ_LVU i) (D.system.momentum.region FlameVUV (ΟζVU j)) ∧ D.system.momentum.region FlameVUV (Ξ_LVU i)=Ξ_LVU i ∧ D.system.momentum.region FlameVUV (ΟζVU j)=ΟζVU j:=by
 have hp(i:ClanZN):D.system.momentum.region FlameVUV (Ξ_LVU i)=Ξ_LVU i:= levitatesVU D.system D.course _
 have ht(i:ClanZN):D.system.momentum.region FlameVUV (ΟζVU i)=ΟζVU i:= levitatesVU D.system D.course _
 exact ⟨(ht j).symm ▸ E.SystemMakerVU p v q D X G A i j,hp i,ht j⟩
lemma intrinsicVUV(t:E.SturdyVU p v q (L:=L) X G A): LinearIndependent ℂ (Ξ_LVU) ∧ LinearIndependent ℂ (ΟζVU):=by
 apply ArchiteΛVU A.δ_pos; rw [show (fun i j=> inner ℂ _ _)=E.LorPriceVU p q X G A.K A.L (L:=L) from ?_]; exact t.2.2.2; exact funext fun i=>funext fun j=> (SystemMakerVU E p v q D X G A i j).symm -- tune
