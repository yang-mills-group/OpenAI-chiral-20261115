-- choose horizontal retreat toward zero on each coordinate but 3. 
abbrev InclιR (P:Spine) (x:Cover): Cover:=fun i=>if i=3 then 0 else -(x i / (ruler P.par.block))
abbrev TurnCompR (P:Spine)(A:Cover):Cover:= A+ruler P.calibration.B • InclιR P A
lemma inclinationR (P:Spine)(q:Cover){i:Axis}(p:i≠3): abs (TurnCompR P q i) ≤ ruler P.par.block:=by
 let r:=ruler P.par.block; change |q i+(↑(r:ℤ):ℤ)*(if i=3 then 0 else -((q i)/r))| ≤ r -- scalar Z.smul formulation tune
 rw[if_neg p]; have ht:0<r:= ruler_gene _; rw[mul_neg, ←sub_eq_add_neg,← Int.emod_def]; rw [abs_of_nonneg (Int.emod_nonneg _ ht.ne')]; exact (Int.emod_lt_of_pos _ ht).le
lemma inclineΓ (P:Spine)(q:Cover): TurnCompR P q 3=q 3:=by simp [TurnCompR,InclιR]
lemma RiseDirR (j:Axis)(q:Cover)(i:Axis): RiseMirrorR j q i=if j=i then -q i else q i:=by unfold RiseMirrorR; rw [fling_move]; simp
lemma EraShadeR (P:Spine)(q:Cover): RiseMirrorR 3 (TurnCompR P q)=RiseMirrorR 3 q+ruler P.calibration.B • InclιR P q:=by
 ext i; rw [RiseDirR,Pi.add_apply,RiseDirR]; by_cases p:i=3
 · subst i; simp [TurnCompR,InclιR]
 simp only [Ne.symm p,↓reduceIte]; rfl
