 letI : DecidableEq (U.RootS u):=Classical.decEq _
 filter_upwards [(SpringR.escape P).eventually_ge_atTop (Fintype.card (RootS U u)),eventually_all.mpr (fun j:RootS U u=> CarvedT_R p B0 M pu A D m U u S V j L)] with f h q g x R v; choose w pW hW using fun i:U.RootS u=> q i x R g
 let T:= ΦCentered p B0 M x R (ΤbandR u) pu A (S x R _) D (V.go ..) g; let X:= ∑ i:U.RootS u, v i • w i
 refine ⟨X,?_,?_⟩; · unfold PaneKeyR; rw [mixInceptR]; change T X=_; unfold X; rw [map_sum]; exact sum_congr rfl (fun i _=> (T.map_smul ..).trans (congrArg (v i • ·) (pW i))) -- tune typeclasses
 let Z:= SpringR P f; let t:= 18+40*m; have hZ:1≤ Z:= SpringR.tall ..; let C:= RankQJ P.par f; have hC:0≤C:= (p.tempo f g).1.le
 apply le_trans (b:= C*(∑ i:U.RootS u,LoomK (v i • w i))) (mul_le_mul_of_nonneg_left (loomer_W _ _) hC); rw [mul_sum]; refine (sum_le_sum (g:=fun _=> ‖v‖*Z^t) (fun i _=>?_)).trans ?_
 · rw [loomer_J,mul_left_comm]; exact mul_le_mul (norm_le_pi_norm _ _) (hW i) (mul_nonneg hC (noLoom _)) (norm_nonneg _)
 rw [sum_const,card_univ,nsmul_eq_mul,mul_left_comm]; refine mul_le_mul_of_nonneg_left ((mul_le_mul_of_nonneg_right h (pow_nonneg (zero_le_one.trans hZ) _)).trans_eq ?_) (norm_nonneg _); change Z*Z^t= Z^(19+40*m); rw [mul_comm,←pow_succ]; congr 1; unfold t; omega
