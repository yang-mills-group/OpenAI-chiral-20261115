include S T
lemma openingFaithSt : ((OnJK) = vesper a.guest.eu (signM • chΞ) omegaCorner fL fR) ∧ ((OnJ)= sighting a.guest.eu (signM • chΞ) fL)∧((OnK) = sighting a.guest.eu omegaCorner fR) ∧ 0<Hx' ∧ Hx' ≤ ((OnJK) - (OnJ) * (OnK)).re :=by
 let M' := T.song.wrap
 let q:=M'.footprints
 have h:∀ e:Fin 2, registeredInk_st (a:=a) u ((![U_J,U_Q] :Fin 2→ UV four) e) (![Jℤ,omegaCorner] e):=by
    intro j; fin_cases j; · exact J_port k X C r p V signM a.guest.i
    exact PSE_port k X C r p V
 have he:(OnJK) =vesper a.guest.eu (signM • chΞ) omegaCorner fL fR:=(dawningSight_st fL fR Yq Tx' S.region.1 yα M'.hr q (fun x i y j=> (M'.distinct x i y j).1) _ _ (chart_ceil k X C r p V ![U_J,U_Q] ![Jℤ,omegaCorner] h)).symm
 have hx (x:UV four)(b:Dialect)(g:_root_.GarnetAct.Cut.Curtain)(h: registeredInk_st (a:=a) u x b): OpeningRightSt (stress:=stress) (layers:=layers) x g=sighting a.guest.eu b g := (generalSight_st g _ _ (chart_ceil k X C r p V (n:=1) (fun _=> x) (fun _=> b) (fun _=> h))).symm
 have hu:(OnJ)=sighting a.guest.eu (signM • chΞ) fL := hx _ _ _ (J_port k X C r p V _ _)
 have hv:(OnK) = sighting a.guest.eu omegaCorner fR:= hx _ _ _ (PSE_port k X C r p V)
 exact ⟨he,hu,hv,S.price.1,by rw [he,hu,hv]; exact S.price.2⟩
#print axioms openingFaithSt
end
lemma estateFaithSt : 0 < Hx ∧ Hx ≤ ((openJK) - (openJ)*(openK)).re:= (openingFaithSt k X C r p V _ _ _ _ _ _ (still_prices k X V) a.guest.gift).2.2.2
