abbrev UnbillVU (y:I→ Cover): MeshN I:=fun u=> y u.1 u.2
lemma rodVU : Injective (UnbillVU (I:=I)):=fun f g p =>funext fun i=>funext fun k=>congrFun p (i,k)
noncomputable abbrev HabVU:Set (SpaceN I):= VantageN⁻¹' Set.univ.pi (fun i=>tsupport (W i).val)
lemma havanaVU : IsCompact (HabVU W):=by
 let M:Set (DiagramR I):= Set.univ.pi (fun i=>tsupport (W i).val); suffices EarthedN '' M=HabVU W by rw[← this]; exact (isCompact_univ_pi (fun i=>(W i).budget)).image (continuous_pi fun x=> by unfold EarthedN; fun_prop)
 apply Set.Subset.antisymm; rintro i ⟨x,v,rfl⟩; exact v
 intro i v; exact ⟨_,(show VantageN i∈ M from v),rfl⟩
lemma riversVU(t:ℕ): (Fintype.piFinset (fun i:I=> P.usedGrid t (W i))).image UnbillVU=DustyN P _ t (havanaVU W):=by
 ext x; rw [Finset.mem_image,dustN]; constructor; rintro ⟨y,v,h⟩; subst x; have hv:= Fintype.mem_piFinset.mp v; intro i h; exact (P.usedPose ..).mp (hv i)
 intro h; exact ⟨TownN x,Fintype.mem_piFinset.mpr (fun i=> (P.usedPose ..).mpr (show P.meshPose t (TownN x i)∈_ from h i (Set.mem_univ _))),rfl⟩
noncomputable abbrev ΞHeightsVU (x:SpaceN I):ℂ:= ((∏ i:I, (W i).val (VantageN x i):ℝ):ℂ)
include alpΙ
lemma SpikeMoneyVU (Y:I→ Cover) (t:ℕ): CustsN P _ (havanaVU W) (ΞHeightsVU W) t (UnbillVU Y) • MoneyPoseN L uF t (TownN (UnbillVU Y)) = ∏ i, P.activation t (W i) (Y i) • P.chartAll (Y i) (uF i t):=by
 let A(i:I):P.Test:=P.chartAll (Y i) (uF i t); let B(i:I):ℂ:=P.activation t (W i) (Y i); let c:=P.macroStep t
 have hg : CustsN P _ (havanaVU W) (ΞHeightsVU W) t (UnbillVU Y) = ∏ i, B i:=by
    change c^Fintype.card (I×Axis) • ((∏ i, (W i).val (P.meshPose t (Y i)):ℝ):ℂ)= ∏ i, ((c^4*(W i).val (P.meshPose t (Y i)):ℝ):ℂ)
    rw [← Complex.coe_smul, smul_eq_mul]; norm_cast -- tune
    rw [prod_mul_distrib, Finset.prod_const,card_univ,Fintype.card_prod,Nat.mul_comm,show Fintype.card Axis=4 from rfl,← pow_mul]
 rw [hg]; change _ • (L.map A).prod=∏ i, B i • A i; rw [← List.prod_toFinset A alpΙ.1,show L.toFinset=univ from Finset.eq_univ_of_forall (fun i=>List.mem_toFinset.mpr (alpΙ.2 i))]; suffices ∀ U:Finset I,(∏ i∈U,B i) • (∏ i∈U,A i)=∏ i∈U,B i • A i from this univ; intro U; /- generalize hy:(Finset.univ:Finset I)=U;-/ induction U using Finset.induction_on with
 | empty => simp
 | insert i q p ih => rw [prod_insert p,prod_insert p,prod_insert p,← ih, ← smul_smul,smul_mul_assoc,mul_smul_comm] -- tune
#print axioms havanaVU
lemma FreightVU (t:ℕ): NativeCostN uF L _ (havanaVU W) (ΞHeightsVU W) t=∏ i, installedN (uF i) (W i) t:=by
 unfold NativeCostN installedN; rw[← riversVU, Finset.sum_image (fun a _ b _ h=> rodVU h),prod_univ_sum]; exact Finset.sum_congr rfl (fun i _=>SpikeMoneyVU uF L alpΙ W i t)
include betΚ
lemma ValuePackVU (v:HabVU W ⊆ VantageN⁻¹' MasksR I) : Tendsto (fun t=> Cε.cash t (∏ i, installedN (uF i) (W i) t)) atTop (𝓝 (∫ x, SpokenN Cε Φ (ΞHeightsVU W) x)):=by
 have hc : Continuous (ΞHeightsVU W):= Complex.continuous_ofReal.comp (continuous_finsetProd _ fun i _=> (W i).smooth.continuous.comp ((continuous_apply _).comp FormalV_N))
 have ht:Function.support (ΞHeightsVU W)⊆HabVU W:=by
    intro x h i p; apply subset_closure; by_contra e; apply h; unfold ΞHeightsVU; rw [prod_eq_zero (mem_univ i) (notMem_support.mp e),Complex.ofReal_zero]
 exact (DiscoverVU Cε uF Φ L alpΙ betΚ _ (havanaVU W) _ ht hc v).congr fun t=>congrArg _ (FreightVU uF L alpΙ W t)
