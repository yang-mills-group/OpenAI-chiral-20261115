lemma PaintIncomeS (X Y:Fin n→ScreensJ P)(p:∀ i,PaintedS B c (X i) (Y i))(x:DiagramR (Fin n)): SπR K.porch Y (dShiftS B x)= (ΑΓ) (SπR K.porch X x):=by
 by_cases v:x∈ CardsR (Fin n); swap; · rw [perim_R _ _ v,perim_R, map_zero]; exact mt (spinTiltS ..).2 v -- direction tune .2 yes
 let Ti (i):=(PaintedS.mem1 B c (p i)); have ht(i): AttainedR 0 (X i):=⟨_, (Ti i).1.choose_spec.1⟩; have hu(i):AttainedR 0 (Y i):=⟨_, (Ti i).2.choose_spec.1⟩; have h:Continuous (sailH Bc c):=(ΑΓ).toLinearMap.continuous_of_finiteDimensional
 apply AlongMesh_S (fun x=> SπR K.porch Y (dShiftS B x)) ((ΑΓ)∘ SπR K.porch X) P ((groundPlotR _ _ hu).comp (spinChartS B n).continuousOn (fun _ i=> (spinTiltS ..).1 i)) (h.continuousOn.comp (g:=ΑΓ) (t:=Set.univ) (groundPlotR _ _ ht) fun _ _=>Set.mem_univ _) v -- tune named g binder
 intro x v; rw [spinAskS]; let L:=List.finRange n; have hL:PolesR L:= deckΦP _; let y(i):=pShiftS B (x i)
 have hy:AskR P y∈ MasksR (Fin n):= by rw [←spinAskS]; exact spinOpenS B _ v
 obtain ⟨F,T,G,W,H⟩:= φ_limits_S B c X Y p x
 have he:= h.continuousAt.tendsto.comp (ΛNamedS K X x L hL v ht F G); let hh:= ΛNamedS K Y y L hL hy hu T W
 exact tendsto_nhds_unique_of_eventuallyEq hh he (H.mono (fun j p0=> A_K _ _ (p0 L) j))
