lemma dtransS (x:DiagramR (Fin n)): dShiftS B⁻¹ (dShiftS B x)=x:=by funext k; unfold dShiftS; rw [inv_inv,Signed.act_inv]
lemma dplaneS (j:Axis)(x:DiagramR (Fin n)) : x ∈ VplaneR (Fin n) (B.perm j)→ dShiftS B x ∈ VplaneR (Fin n) j:=by
 have h(k: Fin n): dShiftS B x k j = if B.flip j then -x k (B.perm j) else x k (B.perm j):=by unfold dShiftS Signed.act; simp
 intro v i k y; apply v; change dShiftS B x i j=dShiftS B x k j at y; rw [h,h] at y; cases d:B.flip j <;> simpa [d] using y
lemma spinOpenS (x:DiagramR (Fin n))(p:x∈ MasksR (Fin n)): dShiftS B x∈ MasksR (Fin n):=fun i=> dplaneS B i _ (p (B.perm i))
lemma spinTiltS (x:DiagramR (Fin n)): x∈ CardsR (Fin n) ↔ dShiftS B x∈ CardsR (Fin n):=by
 have h(B:Signed)(x:DiagramR (Fin n))(p:x∈ CardsR (Fin n)) : dShiftS B x∈ CardsR (Fin n):=by
    obtain ⟨j,v⟩:=Set.mem_iUnion.mp p; obtain ⟨i,rfl⟩:= B.perm.surjective j; exact Set.mem_iUnion.mpr ⟨i,dplaneS B i _ v⟩
 exact ⟨h B x,fun p=> dtransS B x ▸ h B⁻¹ (dShiftS B x) p⟩
lemma spinAskS (x:Fin n→P.VMark): dShiftS B (AskR P x)=AskR P (fun i=> pShiftS B (x i)):=by
 funext i j; unfold AskR Repertoire.clearAbove pShiftS dShiftS Signed.act; dsimp only; split_ifs <;> rfl -- tune
lemma spinChartS(n:ℕ): Continuous (@dShiftS (Fin n) B):=by
 refine continuous_pi fun i=>continuous_pi fun j=>?_
 unfold dShiftS Signed.act; split_ifs <;> fun_prop
