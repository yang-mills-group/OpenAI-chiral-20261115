lemma RushNJ (s:ℕ)(g:f ≤ s)(b:s ≤ Y.uv k): Entourage Y i k w X A b (ValueHJ s p V) (V.Mark s):=by
 induction b using Nat.decreasingInduction with -- Nat.decreasing
 | self=> exact Trophy F p g0 G' V pV w X A r g -- order
 | of_succ s b ih=>
    have a:=g.trans (Nat.le_succ _); let ξ:= F.earth (G'.trans g) b
    let Q:= pV.loop g b; let W':= ξ.sign; let L:= p.birth s; have H:= F.broom (G'.trans g) b
    have V':= Egret Y i k F.kq w X A (V.Mark (s+1)) ξ.U ξ.V ξ.Toll ξ.sign P_ (p.σ (s+1)) (V.Br s) (V.Roll (s+1)) (p.tour s) (p.grade (s+1)) Q b (plaza _ _ _ _ r.zone g) ?v0 (r.camp a b) (ih a) L (g0.unique g b) (p.Pp s) (F.cod s) (g0.voyage g b) ?z (p.paper s) ?hp H.1 H.2 (p.mark s) (r.mark g b) ?uT r.tail -- tune
    case v0=> unfold Xrace; rw [g0.loop s g b]; exact r.camp g b.le
    case z=> rw[g0.loop s g b]; exact g0.force g b.le
    case hp=>rw[g0.loop s g b]; exact g0.hot g b
    case uT=> unfold Xrace; rw [g0.loop s g b]; exact r.proof_m g b
    unfold ValueHJ; rw [pV.ancestry g b,pV.story g b]
    -- only Xrace of function Ask at V billing; not internal.
    let Yt:= (p.σ (s+1)); let U:=F.FrescoBJ p s g b G' V
    change Entourage Y i k w X A b.le (Ask Y i k (P_.F_v (p.σ s)) U.F U.E 0) (RollK p V s b)
    rw [←g0.loop s g b]; exact V' -- occurrences? p.σ s hidden OK
