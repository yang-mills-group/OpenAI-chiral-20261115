lemma all_charts_st (D:∀(i:Axis)(z:Soul), ∀ t>0,(ink).bar t ((P#) (roles.DeckLiftVU k (Ψ i (takesPolySt z)))) = G.bar t ((T i) (takesPolySt z))) (s:ℝ≥0)(p:0<s)(i:Axis)(z:Wage3→ℂ): G.bar s ((T i) z)=(ink).bar s ((P#) (P ((T i) z))):=by
 have h(x:Wage3):G.bar s (choralLeg_st i x)=(ink).bar s ((P#) (P (choralLeg_st i x))):=by
    nth_rw 1 2 [← at_values_st x (choralLeg_st i)]; rw [eM]; exact (D i (ShapeLab.leg x) _ p).symm
 rw [pol_values_st]; simp_rw [map_sum,map_smul,h]
lemma sold_spans_st (D:∀(i:Axis)(z:Soul), ∀ t>0,(ink).bar t ((P#) (roles.DeckLiftVU k (Ψ i (takesPolySt z)))) = G.bar t ((T i) (takesPolySt z))) (s:VoiceU_st)(f:Test4)(hk:G.operator gaugeOrigin_st f ∈ Submodule.span ℂ (Set.range (ink).activate)): G.operator s f∈ Submodule.span ℂ (Set.range (ink).activate):=by
 have h(i:Axis)(y:Wage3→ℂ):= (spanEnough_st (model:=model) G (P ((T i) y)) ((T i) y) fun t p => (all_charts_st k Ψ P J G eL eM D t p i y).symm) f -- instance param!
 nth_rw 1 [← expandDialect_st s]; apply soldSpan_st G; · exact soldRate_st G _ _ _ hk
 exact soldEnsemble_st G _ _ _ (fun j _=> h j _)
