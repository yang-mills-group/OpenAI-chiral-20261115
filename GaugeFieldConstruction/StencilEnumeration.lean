lemma all_priced_st (z:J≠0)(h:compassPiMars stress stillSO_st J=J) : Injective P := dialectRank_st (μ:=_) (roles.DeckPortInvVU k t) Ψ eI z γ eL eM h (far_right_st (stress:=stress) k t Ψ P eM γ) -- μ implicit linear representation
