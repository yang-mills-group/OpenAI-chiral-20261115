lemma all_winter_st (x: Points 1)(h:(Z) 1 x ![J]=0)(z:VoiceU_st): roles.χVX stress vacuum 1 x ![P z]=0:=by
 let B:= Z 1 x; let L:=B.toLinearMap ![J] 0
 have hx(b:ΧiMars): B ![b]=L b:= by unfold L; rw [MultilinearMap.toLinearMap_apply]; congr 1; ext1 i; fin_cases i; simp
 have hc:= Certificate.path.phase_costs
 have hw:= (roles.WarmVU stress vacuum (le_refl _) hc Certificate.path.ward_oracle); let ht:= roles.RotatesΕVU stress _ hc
 have he(i y): L (P ((T i) y))=0:=by
    rw [←hx,eM, roles.BerylStepsPV k t]; exact quiet_allSt (fun i=> Ψ i y) stress (roles.BinSchVU k three t) hw ht x i (γ y)
 change B _=0; rw[hx]; have hU:L (P gaugeOrigin_st)=0:=by rw [eL,←hx]; exact h
 nth_rw 1 [← expandDialect_st z]; simp_rw [map_add,map_sum,map_smul]; simp [he,hU]
