lemma roll_row_st (Z:List (VoiceU_st×Test4))(d:∀ z,soldInkSt u G (P z) z) : u.pocket ((R).evaluates (Z.map fun q=> ((P#) (P q.1),q.2)))=G.row Z:=by
 let L:= Z.map fun q=> (P q.1,q)
 have p:= intoStationSt u G b L (by intro i u; obtain ⟨⟨x,y⟩,_,rfl⟩:= List.mem_map.mp u; exact d x)
 refine Eq.trans ?_ (p.trans ?_); · apply congrArg; apply congrArg; unfold L; rw [List.map_map]; rfl
 apply congrArg; unfold L; rw [List.map_map]; exact List.map_id _
omit b
-- charge decomposition Ward all. at this frame's kernel, using black. no claim beyond point shelf.
lemma activity_st {z:VoiceU_st}{z':Axis→VoiceU_st}{f:Test4}(d:Axis→Test4)(h:∀ z,soldInkSt u G (P z) z){c':ℂ}(hp:c' • G.operator z f=∑ j:Axis,G.operator (z' j) (d j)) : c' • (R).field ((P#) (P z)) f=∑ j:Axis,(R).field ((P#) (P (z' j))) (d j):=by
 have x:= u.sends_scale c' _ _ (h z f); have y:= u.sends_sum (Finset.univ:Finset Axis) _ _ (fun j _=> h (z' j) (d j)); apply LinearMap.ext; intro v; exact u.pocket.injective ((u.via_cash _ _ x v).trans ((DFunLike.congr_fun hp (u.pocket v)).trans (u.via_cash _ _ y v).symm))
-- pencil uniqueness. Even a single Cart's unpadded field identity on this project's Schwinger lift (not requiring any star).
lemma sold_unique_st (x y:UV four)(z:VoiceU_st)(p:soldInkSt u G x z)(v:soldInkSt u G y z): x=y:=by
 by_contra h; obtain ⟨f,t⟩:= model.course.faithful ((P#) x-(P#) y) (sub_ne_zero.mpr fun z=> h ((P#).injective z)); apply t; rw[map_sub,LinearMap.sub_apply]; apply sub_eq_zero.mpr; exact LinearMap.ext fun s=>u.pocket.injective ((u.via_cash _ _ (p f) s).trans (u.via_cash _ _ (v f) s).symm)
abbrev spineRevenueEqSt (x y: Module.End ℂ model.system.operators.domain):ℂ:= inner ℂ model.system.operators.omega ((x*y) model.system.operators.omega)-inner ℂ model.system.operators.omega (x model.system.operators.omega)* inner ℂ model.system.operators.omega (y model.system.operators.omega)
lemma sold_value_pos_st (x:UV four)(y z:Module.End ℂ model.system.operators.domain)(f:Test4)(h:model.system.operators.field ((P#) x) f=z)(p:(spineRevenueEqSt (model:=model) y z).re≠0): x≠0:=by rintro g;rw [g,map_zero,map_zero] at h; apply p; rw [←h]; simp only [spineRevenueEqSt, LinearMap.zero_apply,mul_zero,sub_zero,inner_zero_right]; rfl -- order!
lemma rank_phase_st (eM:∀ i:Axis,∀z:Wage3→ℂ, P ((T i) z)=roles.DeckLiftVU k (Ψ i z)) (j:Axis)(t:roles.LeaseVU k)(σ:ℂ)(p:σ≠0)(d:∀x:Soul, TurnupMars 3 (P ((T j) (takesPolySt x))) = σ • P ((T j) (takesPolySt x)))(g:∀ z:Soul,Ψ j (takesPolySt z)=0 → z=0): Injective (Ψ j):=by
 let Q:= roles.DeckLiftVU k ∘ₗ Ψ j; let θ: (UV four→ₗ⋆[ℂ] UV four) := GaugeFieldConstruction.Calibration.spinFrame four (Signed.mirror 3) ∘ₛₗ (GaugeFieldConstruction.Calibration.shade four)
 have hx(x:Soul): θ (Q (takesPolySt x))=σ • Q (takesPolySt x):=by
    change TurnupMars 3 (roles.DeckLiftVU k (Ψ j (takesPolySt x)))=_; unfold Q; rw [LinearMap.comp_apply]; rw [←eM]; exact d x
 have he(z:Soul)(h:Q (takesPolySt z)=0):z=0:= g z (roles.DeckPortInvVU k t (h.trans (map_zero _).symm))
 exact fun x y u=> completionInj_st θ Q p hx he (congrArg (finger) u)
