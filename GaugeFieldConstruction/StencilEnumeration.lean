lemma ensemble_credit_st (h:soldInkSt u G J gaugeOrigin_st)(g:∀ (i:Axis)(z:Soul), soldInkSt u G (roles.DeckLiftVU k (Ψ i (takesPolySt z))) ((T i) (takesPolySt z))) (z:VoiceU_st): soldInkSt u G (P z) z:=by
 have hp(i:Axis)(x:Wage3): soldInkSt u G (P (choralLeg_st i x)) (choralLeg_st i x):=by
    nth_rw 1 2 [← at_values_st x (choralLeg_st i)]; rw [eM]; exact g i (ShapeLab.leg x)
 have hC(x:VoiceU_st)(s:ℂ)(h:zBoss x): zBoss (s • x):=by rw [map_smul]; exact charges_inkSt u G h s
 have hS{I:Type}(i:Finset I)(x:I→VoiceU_st)(h:∀ j,zBoss (x j)): zBoss (∑ j∈i,x j):=by rw [map_sum]; exact moneyMany_st u G i _ _ fun j _=>h j
 have he(x y:VoiceU_st)(h:zBoss x)(z:zBoss y): zBoss (x+y):=by rw [map_add]; exact sumCharges_st u G h z
 have hk(i:Axis)(x:Wage3→ℂ): zBoss ((T i) x):=by rw [pol_values_st]; exact hS (I:=Wage3) univ (fun j=>x j • choralLeg_st i j) fun j=> hC _ _ (hp i j)
 nth_rw 1 2 [← expandDialect_st z]; exact he _ _ (hC gaugeOrigin_st _ (eL.symm ▸ h)) (hS (I:=Axis) univ (fun i=>cPay_st (choralLeg_st i) (fun v:Wage3=>z (some (i,v)))) fun i=>hk i _)
