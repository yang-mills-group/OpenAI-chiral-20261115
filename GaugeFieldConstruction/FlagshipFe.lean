structure ChSigFe where
 al : Flavor
 σ : Signed
 cr : Bool
-- implement inverses.Left.
namespace ChSigFe
noncomputable instance : Fintype ChSigFe:=Fintype.ofEquiv (Flavor × Signed × Bool) {
 toFun p:=⟨p.1,p.2.1,p.2.2⟩
 invFun p:=(p.al,p.σ,p.cr)
 left_inv _:= rfl
 right_inv _:=rfl }
instance : Mul ChSigFe:=⟨fun z i=>⟨z.al*i.al, i.σ*z.σ, i.cr^^z.cr⟩⟩
instance : Inv ChSigFe:=⟨fun z=> ⟨z.al⁻¹,z.σ⁻¹,z.cr⟩⟩
instance : One ChSigFe:=⟨⟨1,1,false⟩⟩
variable (ω ξ χ:ChSigFe)
instance : Group ChSigFe where
 mul_assoc a b c:=by
   obtain ⟨a,v,b1⟩:=a; obtain ⟨b,w,b2⟩:=b; obtain ⟨c,t,b3⟩:=c; change ChSigFe.mk _ _ _=ChSigFe.mk _ _ _; congr 1; · exact mul_assoc _ _ _
   · exact (mul_assoc _ _ _).symm
   all_goals cases b1 <;> cases b2<;>cases b3<;> rfl
 one_mul x:= by obtain ⟨i,j,r⟩:=x; change ChSigFe.mk (1*i) (j*1) _=_; rw[one_mul,mul_one]; cases r <;> rfl
 mul_one x:= by obtain ⟨i,j,r⟩:=x; change ChSigFe.mk (i*1) (1*j) _=_; rw[mul_one,one_mul]; cases r<;>rfl
 inv_mul_cancel x:= by obtain ⟨i,j,r⟩:=x; change ChSigFe.mk (i⁻¹*i) (j*j⁻¹) _=_; rw [inv_mul_cancel,mul_inv_cancel]; cases r <;> rfl
-- shade / signed / flavor. Use R-real not identify op c inadvertently. Lua old cwd.Pθ.
abbrev VisaZFe (ω:ChSigFe): ℂ→ₗ[ℝ]ℂ:= (sailH (PrimeScriptR ω.σ 0) ω.cr).toLinearMap
-- multiplicative too
abbrev StampZFe (x:ℂ):=sailH (PrimeScriptR ω.σ 0) ω.cr x
lemma stampMulFe(a:ℂ): StampZFe (ξ*ω) a=StampZFe ξ (StampZFe ω a):= Eq.symm (tangoS ..)
lemma stampZonFe(a:ℂ):StampZFe 1 a=a:=by change sailH (PrimeScriptR 1 0) false a=a; unfold sailH; simp only[det_i]; rfl
-- Sigma. signs.
local notation "βQF"=> spinFrame dΩ
local notation "θF"=> UV dΩ
local instance iGpFe (d:GaugeFieldConstruction.Calibration.Floor) : AddCommGroup (UG d):= @Submodule.addCommGroup ℂ (J Row.g) _ _ _ _
local instance iFpFe (d:GaugeFieldConstruction.Calibration.Floor) : AddCommGroup (UF d):= @Submodule.addCommGroup ℂ (J Row.f) _ _ _ _
local instance iXpFe (d:GaugeFieldConstruction.Calibration.Floor) : AddCommGroup (UX d):= @Submodule.addCommGroup ℂ (J Row.x) _ _ _ _
local instance iUpFe (d:GaugeFieldConstruction.Calibration.Floor) : AddCommGroup (UV d):= inferInstanceAs (AddCommGroup (Prod _ _))
abbrev FloriFe (ω:ChSigFe)(x:UV dΩ): UV dΩ:= spinFrame dΩ ω.σ⁻¹ (tiltΓ ω.σ⁻¹ ω.cr dΩ x)
abbrev PhoebeFe (ω:ChSigFe)(x:UV dΩ):UV dΩ:= flavors dΩ ω.al (FloriFe dΩ ω x)
lemma FlossFe (x y:UV dΩ):FloriFe dΩ ω (x+y)=FloriFe dΩ ω x+FloriFe dΩ ω y:=by unfold FloriFe tiltΓ; split <;> simp
lemma phosphFe (x y:UV dΩ):PhoebeFe dΩ ω (x+y)=PhoebeFe dΩ ω x+ PhoebeFe dΩ ω y:=by unfold PhoebeFe; rw[FlossFe,map_add]
lemma flossMoneyFe (a:ℂ)(x:UV dΩ): FloriFe dΩ ω (a • x) = StampZFe ω a • FloriFe dΩ ω x:=by
 unfold FloriFe tiltΓ; split<;>rename_i p
 · rw[(shade dΩ).map_smulₛₗ,map_smul]; congr 1
   rw [grinDet] at p; cases u: ω.cr<;> cases v:detX ω.σ <;> simp only[u,v] at p<;>first | contradiction |(unfold StampZFe sailH; rw [u,v]; rfl)
 rw[map_smul]; congr 1; rw[grinDet] at p; cases u:ω.cr<;>cases v:detX ω.σ<;>simp only [u,v] at p<;>first | (exact (p rfl).elim) | (unfold StampZFe sailH; rw[u,v]; rfl)
lemma PhoSumFe(c:ℂ)(x:UV dΩ): PhoebeFe dΩ ω (c • x)= StampZFe ω c • PhoebeFe dΩ ω x:=by unfold PhoebeFe; rw [flossMoneyFe,map_smul]
lemma FlagrantFe(x:UV dΩ): FloriFe dΩ (ξ*ω) x=FloriFe dΩ ξ (FloriFe dΩ ω x):=by
 unfold FloriFe tiltΓ; change spinFrame dΩ (ω.σ*ξ.σ)⁻¹ (if (ω.cr^^ξ.cr)^^(detX (ω.σ*ξ.σ)⁻¹) then shade dΩ x else x)= _
 rw [grinDet,grinDet,grinDet,det_p,mul_inv_rev,map_mul, Module.End.mul_apply]; cases a:ω.cr <;>cases b:ξ.cr<;> cases t:detX ω.σ<;> cases s:detX ξ.σ<;>first | rfl | (change _= spinFrame _ _ (Calibration.shade _ ((spinFrame _ _) _)); rw[comp_s]; first|rfl|(simp [Calibration.clear]))
lemma FlagrantCFe (x:UV dΩ):FloriFe dΩ ω (flavors dΩ α x)=flavors dΩ α (FloriFe dΩ ω x):=by
 unfold FloriFe tiltΓ; split; · rw [color_s]; exact LinearMap.congr_fun (Calibration.commute ..) _
 exact LinearMap.congr_fun (Calibration.commute ..) _
lemma PledgeMulFe (x:UV dΩ) : PhoebeFe dΩ (ξ*ω) x=PhoebeFe dΩ ξ (PhoebeFe dΩ ω x):=by unfold PhoebeFe; rw [FlagrantFe, show (ξ*ω).al= ξ.al*ω.al from rfl,map_mul,Module.End.mul_apply,FlagrantCFe]
lemma PhZFe (x:UV dΩ): PhoebeFe dΩ 1 x=x:=by
 change flavors _ 1 (spinFrame _ (1:Signed)⁻¹ (tiltΓ _ false dΩ x))=_; rw [map_one, inv_one,map_one]; change (if false^^(detX 1) then shade _ x else x)= x; rw[det_i]; rfl
-- Read unity splitting. orientation anti.
abbrev FeeCoinFe (x:UV dΩ):ℂ:= x.1
lemma PhMoneyFe (x:UV dΩ): FeeCoinFe dΩ (PhoebeFe dΩ ω x)=StampZFe ω (FeeCoinFe dΩ x):=by
 change (tiltΓ ω.σ⁻¹ ω.cr dΩ x).1= _; unfold tiltΓ StampZFe sailH; rw [grinDet]; cases a:ω.cr<;>cases p:detX ω.σ<;>rfl
