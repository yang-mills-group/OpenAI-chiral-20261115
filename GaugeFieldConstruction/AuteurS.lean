abbrev UpShift_S:= 10000
private abbrev CostStepS:=3500 -- ensure k. precision.
variable {I:Type}[Fintype I][DecidableEq I]
variable (u:I→GaugeFieldConstruction.Calibration.Floor)(S:DialsBJ P θ)(V:AxonsJ p B0 M A S D) (X':I→BezelR)(R':I→ Signed × Bool)(L0:I→finsJ)(H':∀ i:I,X' i∈ PerlSetR (u i))
abbrev GridPriceS (m:ℕ) (U:DiagramR I→ℂ):Prop:=∀ (C:ℕ→ CoinsR P) (L:ℕ→ℕ), Tendsto L atTop atTop →∀ (x:DiagramR I)(v:ℕ→I→ Cover), Tendsto (fun i=> RecessS P m (L i) (v i)) atTop (𝓝 x) →x∈ CardsR I →(∀ᶠ i in atTop, AskR P (CountersS P m (L i) (v i))∈ MasksR I) → Tendsto (fun i=> SπR (C i).porch (TapeI p B0 M pu A D m u S V X' R' L0 (L i)) (AskR P (CountersS P m (L i) (v i)))) atTop (𝓝 (U x))
abbrev StampMarketS (m:ℕ) (l:List I)(U:DiagramR I→ℂ):Prop:=∀ (C:ℕ→ CoinsR P) (L:ℕ→ℕ), Tendsto L atTop atTop →∀ (x:DiagramR I)(v:ℕ→I→ Cover), Tendsto (fun i=> RecessS P m (L i) (v i)) atTop (𝓝 x) →x∈ CardsR I →(∀ᶠ i in atTop, AskR P (CountersS P m (L i) (v i))∈ MasksR I) → Tendsto (fun i=> (C i).cash (SportR P m (L i)) (l.map (fun k=> StageμS D m (L i) (X' k) (v i k))).prod) atTop (𝓝 (U x))
include H p S H'
lemma RiseUp_S (g:UpShift_S ≤ m)(c:Fintype.card I ≤3)(l:List I)(h:PolesR l) (U:DiagramR I→ℂ)(t':StampMarketS D X' m l U): GridPriceS p B0 M pu A D u S V X' R' L0 m U:=by
 intro C L s x v ta q r; let K:= (t' C L s x v ta q r); have p':LowSν* Fintype.card I<CostStepS:=(Nat.mul_le_mul_left LowSν c).trans_lt (by decide)
 have h':=(PayrollS p B0 M pu A D Q t u' H m s u S V X' R' L0 H' C CostStepS (le_trans (by decide :26+CostStepS≤ UpShift_S) g) p' l h x v ta q r).add K; rw[zero_add] at h'; exact h'.congr fun i=>sub_add_cancel _ _
omit H p S H'
lemma CardsDis_S {x:DiagramR I}(p:x∈ CardsR I) (u v:I)(h:u≠v) : WithLp.toLp 2 (x u)≠WithLp.toLp 2 (x v):=by obtain ⟨i,v⟩:= Set.mem_iUnion.mp p; intro e; exact h (v (congrArg (fun p:E4=>p i) e))
section pair
variable (u:Fin 2→GaugeFieldConstruction.Calibration.Floor)(X':Fin 2→BezelR)(R':Fin 2→Signed × Bool)(L0:Fin 2→ finsJ)(h':∀ i,X' i∈ PerlSetR (u i))
abbrev DuoS_R (X':Fin 2→BezelR)(x:DiagramR (Fin 2)) :ℂ:= BigP (WithLp.toLp 2 (x 0)) (WithLp.toLp 2 (x 1)) (Phys.dress (ZeckR (X' 0))) (Phys.dress (ZeckR (X' 1)))
include H h'
lemma duoMarket_S : StampMarketS D X' m [0,1] (DuoS_R X'):=by
 intro C L s x v t₀ p₀ _
 have hv(i:Fin 2):=(recess_plotS m s v x t₀ i); let j:=CardsDis_S p₀ 0 1 (by decide)
 apply (PostΔR D Q t u' H m s C (hv 0) (h' 0).1 (hv 1) (h' 1).1 j).congr; intro i; simp only [List.map_cons,List.map_nil,List.prod_cons,List.prod_nil,mul_one]
include p S
lemma ComparesPairS (e:UpShift_S ≤ m): GridPriceS p B0 M pu A D u S V X' R' L0 m (DuoS_R X'):= RiseUp_S p B0 M pu A D Q t u' H m u S V X' R' L0 h' e (by rw[Fintype.card_fin]; omega) _ (by constructor <;> (first | simp| intro i; fin_cases i <;> decide)) _ (duoMarket_S D Q t u' H m u X' h') -- test decidable hazard
end pair
section trio
variable (u:Fin 3→GaugeFieldConstruction.Calibration.Floor)(X':Fin 3→BezelR)(R':Fin 3→Signed × Bool)(L0:Fin 3→ finsJ)(h':∀ i,X' i∈ PerlSetR (u i))
abbrev TrioS_R (X':Fin 3→BezelR)(x:DiagramR (Fin 3)) :ℂ:= Flux.One.prism (WithLp.toLp 2 (x 0)) (WithLp.toLp 2 (x 1)) (WithLp.toLp 2 (x 2)) (Phys.dress (ZeckR (X' 0))) (Phys.dress (ZeckR (X' 1))) (Phys.dress (ZeckR (X' 2)))
include H h'
lemma trioMarket_S (tM:(X' 0).1 ≠ Genre.mixed) : StampMarketS D X' m [0,1,2] (TrioS_R X'):=by
 intro C L s x v t₀ p₀ _
 have hv(i:Fin 3):=(recess_plotS m s v x t₀ i)
 have q:= PostΓR D Q t u' H m s C (hv 0) (h' 0).1 (hv 1) (h' 1).1 (CardsDis_S p₀ 0 1 (by decide)) tM (hv 2) (h' 2).1 (CardsDis_S p₀ 0 2 (by decide)) (CardsDis_S p₀ 1 2 (by decide))
 apply q.congr; intro i; simp only [List.map_cons,List.map_nil,List.prod_cons,List.prod_nil,mul_one,StageμS, mul_assoc]
include p S
lemma ComparesTrioS (e:UpShift_S ≤ m)(tM:(X' 0).1 ≠ Genre.mixed): GridPriceS p B0 M pu A D u S V X' R' L0 m (TrioS_R X'):= RiseUp_S p B0 M pu A D Q t u' H m u S V X' R' L0 h' e (by rw[Fintype.card_fin]) [0,1,2] (by constructor <;> decide) _ (trioMarket_S D Q t u' H m u X' h' tM)
end trio
