lemma PureColorR : JasmineJ (ΟGlow (PrimeScriptR B f0) b P.par) ((S 0 R u).sun L s) ((S 0 (GripR R B b) u).sun L s):=by
 let f(i):= D.path.subSeq i; let pT:= Stencil2Q p B0 M (0:P.VMark) R u L A s s0; let pZ:=Stencil2Q p B0 M (0:P.VMark) (p0r) u L A s s0
 let X:=S 0 R u; let Y:=S 0 (GripR R B b) u
 have iG:=D.path.step.tendsto_atTop; have hp:= iG.eventually (PunchLongJ P s); have he (i:ℕ)(h:ΩPunchJ P (f i) s): JasmineJ φO (pT (f i)) (pZ (f i)):=by
    unfold pT pZ Stencil2Q; rw [dif_pos h,dif_pos h]; exact EqualEpochS p B0 M R u L s0 B b _ _ _ h.1.le -- tune binder
 have ht (x:FrameK (Fin (θ u))):= (V.go 0 R u).tilt L s s0 x; have hy (x:FrameK (Fin (θ u))):= (V.go 0 (GripR R B b) u).tilt L s s0 x
 refine ⟨fun i=>?_,fun i=>?_⟩
 · exact tendsto_nhds_unique_of_eventuallyEq ((ΞHand ..).continuousAt.tendsto.comp (ht i).1) (hy (Oω i)).1 (hp.mono fun j h=>(he j h).1 i)
 exact tendsto_nhds_unique_of_eventuallyEq ((ΞCommission ..).continuousAt.tendsto.comp (ht i).2) (hy (Oω i)).2 (hp.mono fun j h=>(he j h).2 i)
lemma ΨLeashR (v:FrameK (Fin (θ u))) : hoodAJ (ΟGlow (PrimeScriptR B f0) b P.par) (((S 0 R u).rev L s).1 v)=((S 0 (GripR R B b) u).rev L s).1 (Oω v):=by
 let A' r:=S 0 r u; let Z r:= BrJ u (((A' r).sun L s).1); let E r:= ((A' r).rev L s).1; have ht(r)(i): Z r (E r i)=i:= DFunLike.congr_fun ((Lens_R p B0 M 0 r u L A (A' r) D.path (V.go ..) s s0).2.2) i
 have hz(w): Oω (Z R w)=Z (GripR R B b) (Oω w):=by
    let Y:=(A' R).sun L s; let Y':=(A' (GripR R B b)).sun L s; change Oω (_+Y.1 w)= Oω w + Y'.1 (Oω w); rw [← (PureColorR p B0 M R u L A D s0 B b S V).1 w]; exact funext fun i=> map_add .. -- tune
 have he:Function.Injective (Z (GripR R B b)):= LinearMap.injective_iff_surjective.mpr fun i=>⟨_,ht (GripR R B b) _⟩
 apply he; change Z (GripR R B b) (Oω (E R v))= Z (GripR R B b) (E (GripR R B b) (Oω v)); rw [←hz,ht,ht]
lemma PthickiR (t:s≤l) : JasmineJ (ΟGlow (PrimeScriptR B f0) b P.par) (LampsteadJ u (S 0 R u) L s l t) (LampsteadJ u (S 0 (GripR R B b) u) L s l t):=by
 let X:=S 0 R u; let X':=S 0 (GripR R B b) u; let Z:=X.sun L l; let G:= (X.rev L l).1; let Z':=X'.sun L l; let G':=(X'.rev L l).1; let A':=DownJ X.stairs l s t; let E:=DownJ X'.stairs l s t
 have h:= CopalJ p B0 M 0 R u A X D (V.go ..) (f:=f0) le_rfl 0 (GripR R B b) (PrimeScriptR B) b (UsePrimeR P R B b f0) X' (V.go ..) t s0
 have hz(i:FrameK (Fin (θ u))): Oω (G (A'.1 i))= G' (E.1 (Oω i)):=by change hoodAJ _ (((S ..).rev L l).1 _)=_; rw [ΨLeashR p B0 M R u L A D (s0.trans t) B b S V, h.1] -- tune
 refine ⟨hz,fun j=>?_⟩
 change (ΟGlow _ _ _) (A'.2 j+ Z.2 (G (A'.1 j)))=E.2 (Oω j)+ Z'.2 (G' (E.1 (Oω j))); rw [map_add]; exact congrArg₂ (·+·) (h.2 _) (((PureColorR p B0 M R u L A D (s0.trans t) B b S V).2 (G (A'.1 j))).trans (congrArg Z'.2 (hz j)))
