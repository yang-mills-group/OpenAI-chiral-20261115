lemma Feel_S (i:Fin n): AttainedR 0 (X i):= ⟨_, (h i).choose_spec.1⟩
lemma PlenomPhaseS (x:Fin n→P.VMark): ∃ F:ℕ→ Fin n→P.Test,∀ i:Fin n, VistaX (x i) (WayMoveR P (x i) (X i)) (fun r=>F r i):=by
 choose F e using fun i=> SlingV_S (X i) (h i) (x i); exact ⟨fun i j=>F j i,e⟩
omit h
lemma deckΦP (n:ℕ): PolesR (List.finRange n):=by simp [PolesR,List.nodup_finRange]
include h C
lemma PermκS {m:ℕ}(d:Fin m≃Fin n) (x:DiagramR (Fin n)) : SπR C.porch (X ∘ d) (x ∘ d)= SπR C.porch X x:=by
 let D':=fun x:DiagramR (Fin n)=>x ∘ d; have hv:Continuous D':=continuous_pi (fun i=>continuous_apply _)
 have u{v}: D' v∈ CardsR (Fin m) ↔ v ∈ CardsR (Fin n):=by
    simp only [CardsR,Set.mem_iUnion]; refine ⟨fun ⟨j,h⟩=> ⟨j,fun i k q=>?_⟩,fun ⟨i,h⟩=> ⟨i,fun _ _ e=> d.injective (h e)⟩⟩
    obtain ⟨w,rfl⟩:=d.surjective i; obtain ⟨v,rfl⟩:=d.surjective k; exact congrArg d (h q)
 have h'(i):=Feel_S X h i
 by_cases e:x∈ CardsR (Fin n); swap; · rw [perim_R _ _ e,perim_R _ _ (mt u.mp e)] -- tune
 apply AlongMesh_S (SπR C.porch (X ∘ d) ∘ D') (SπR C.porch X) P ((groundPlotR C.porch _ (fun i=> h' (d i))).comp hv.continuousOn fun p i=>u.2 i) (groundPlotR _ _ h') e
 intro x v; let L:=List.finRange m; let J:= L.map d; let y:= x ∘ d; have he:AskR P y∈ MasksR (Fin m):=fun i _ _ h=> d.injective (v i h)
 obtain ⟨F,p⟩:= PlenomPhaseS X h x; let A:= ΛNamedS C (X∘d) y L (deckΦP m) he (fun i=>h' (d i)) (fun i=>F i ∘ d) (fun i=>p (d i)); have hm:PolesR J:= ⟨(deckΦP m).1.map d.injective, fun i=> List.mem_map.mpr ⟨d.symm i,(deckΦP m).2 _,d.apply_symm_apply _⟩⟩
 exact tendsto_nhds_unique_of_eventuallyEq A (ΛNamedS C X x J hm v h' F p) (Eventually.of_forall fun k=> by unfold vistaLim_S J; rw[List.map_map]) -- maybe no goals
omit h -- keep C
lemma UnitδS (x:DiagramR (Fin (n+1)))(q:x ∈ CardsR (Fin (n+1)))(X:Fin n→ScreensJ P)(h:∀ i,VenueY 0 (X i)) : SπR C.porch (Fin.cons (CandΛJ P) X) x= SπR C.porch X (Fin.tail x):=by
 let σ:=CandΛJ P; let Y: Fin (n+1)→ScreensJ P:=Fin.cons σ X
 have hz:(∀ i, VenueY 0 (Y i)):=fun i=>Fin.cases (motive:=fun i=>VenueY 0 (Y i)) ⟨_,Unitφ 0⟩ (fun i=>h i) i
 let D':= fun x:DiagramR (Fin (n+1))=>Fin.tail x
 have hv: Continuous D':=continuous_pi fun i:Fin n=>continuous_apply (Fin.succ i)
 have ht{v}:∀ i,v∈VplaneR (Fin (n+1)) i→D' v∈ VplaneR (Fin n) i:= fun i t j k a=> Fin.succ_injective _ (t a)
 apply AlongMesh_S (SπR C.porch Y) (SπR C.porch X ∘ D') P (groundPlotR _ _ (Feel_S _ hz)) ((groundPlotR _ _ (Feel_S _ h)).comp hv.continuousOn fun _ z=> Set.mem_iUnion.mpr (by obtain ⟨i,v⟩:=Set.mem_iUnion.mp z; exact ⟨i,ht i v⟩)) q
 intro x v; let w:= Fin.tail x; let yp:=AskR P w; let U:= List.finRange n
 have hp:yp∈ MasksR (Fin n):=fun i=> ht i (v i)
 obtain ⟨a,h'⟩:= PlenomPhaseS X h w; let L:=List.finRange (n+1);
 let F:ℕ→ Fin (n+1)→P.Test:= fun i=> Fin.cons (1:P.Test) (a i)
 have H:∀ i, VistaX (x i) (WayMoveR P (x i) (Y i)) (fun r=>F r i):=by
    intro i; refine Fin.cases ?_ (fun k=>?_) i
    · rw [show Y 0= σ from rfl,vacWay_R]; exact VistaS _ _ _ (Unitφ (x 0))
    exact h' k
 have he:= ΛNamedS C Y x L (deckΦP _) v (Feel_S _ hz) F H; exact tendsto_nhds_unique_of_eventuallyEq he (ΛNamedS C X w U (deckΦP _) hp (Feel_S _ h) a h') (Eventually.of_forall fun i=> by unfold vistaLim_S L; rw [List.finRange_succ]; simp [F,U,List.map_map,Function.comp_def]) -- check
