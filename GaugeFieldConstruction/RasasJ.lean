lemma PoiPieceJ (F G:List (Fin (n+1))) (w': Fin (n+1))(c:F.length+G.length=n)(g:(F++w'::G).Pairwise (·<·)): ‖Cap_ZΛ P.run i k (((F.map A).prod * EchoTideJ (f:=f) p w h B0 M Ω x R u (Y w') y)*(G.map D).prod)‖≤ (plumeZ P.par.R.L (P.run.uv k))⁻¹*(ΦWallet p*b)^(n+1):=by
 let Jω:=EchoTideJ (f:=f) p w h B0 M Ω x R u; let Qs:= Y w'; let Z:= Jω Qs y
 -- use cargo_Post from OTHER wired.V using cEra
 have hp (j:Fin (n+1)): CargoBillJ (f:=f) p w h B0 M x R κ L u (Y j) ((fun j=> Jω (Y j) y) j) ((LoomK (SailGateJ p w h B0 M Ω x R u y))*RankQJ P.par (P.run.uv k)) := cEraJ p w h B0 M Ω x R u L (Y j) y κ -- tune
 let pr:= WristQuotaJ p w h B0 M x R u L Hv κ q₀ e _ sat _ hp
 have hE(i')(a:i'∈ G): Commute Z (D i'):=by
    let H:= WristQuotaJ p w h B0 M x R u L Hv κ q₀ e _ sat D hd i'; let h0:= List.pairwise_cons.mp ((List.pairwise_append.mp g).2.1)|>.1 i' a
    exact PostCommutJ (pr w') H (DepositΩ (P:=P) _ e Y sat w' i' h0.ne q₀ (by omega))
 let A'(j:Fin (n+1)):= if j∈ G then D j else A j
 have haG:G.map A'= G.map D:= List.map_congr_left fun i p=> if_pos p
 have hA(f')(u:f'∈F): f'∉G:=fun t=>(List.pairwise_append.mp g|>.2.2 _ u _ (List.mem_cons_of_mem _ t)).false -- tune
 have haF:F.map A'= F.map A:= List.map_congr_left fun i p=> if_neg (hA i p)
 have he:= PoiShipJ p w h B0 M Ω x R u L y Hv κ q₀ e Y sat rK Q q' Sκ b hb pY pK A' w' (F++G) (by rw[List.length_append]; exact c) (?H₃) (fun j t=>?H₄)
 case H₃=>
    -- pairwise LT to nodup perm push last
    have hx:(F++w'::G).Nodup:=g.imp (fun p=> ne_of_lt p); let u:List.Perm (F++w'::G) ((F++G)++[w']):=by rw [List.append_assoc]; exact (show List.Perm ([w']++G) (G++[w']) from List.perm_append_comm).append_left _ -- tune
    exact u.nodup_iff.mp hx
 case H₄=> unfold A'; split
           · exact hd j
           exact ha j
 rw[List.map_append,List.prod_append,haF,haG] at he
 have ht : Commute Z (G.map D).prod:=Commute.list_prod_right (G.map D) Z (by intro x y; obtain ⟨i,a,rfl⟩:=List.mem_map.mp y; exact hE i a) -- tune
 rw [mul_assoc, show EchoTideJ (f:=f) p w h B0 M Ω x R u Qs y*(G.map D).prod= (G.map D).prod * Z from ht.eq,←mul_assoc]; exact he
#print axioms PoiPieceJ
