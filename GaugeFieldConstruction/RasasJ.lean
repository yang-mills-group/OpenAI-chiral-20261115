include Δ
lemma RenTideJ (a L':List (Fin (n+1)))(g:(a++L').Pairwise (·<·))(c:a.length + L'.length=n+1): ‖Cap_ZΛ P.run i k ((a.map A).prod*(L'.map A).prod)-Cap_ZΛ P.run i k ((a.map A).prod*(L'.map D).prod)‖ ≤ (L'.length:ℝ)*((plumeZ P.par.R.L (P.run.uv k))⁻¹*(ΦWallet p*b)^(n+1)):=by
 let s:=P.run.uv k; let C:=Cap_ZΛ P.run i k; let β:Fin (n+1)→ Mark (side P.run i s):=fun j=> EchoTideJ (f:=f) p w h B0 M Ω x R u (Y j) y; let d':= (plumeZ P.par.R.L s)⁻¹*(ΦWallet p*b)^(n+1)
 have heΨ (j:Fin (n+1)): Envelope (β j):=by
    let P0:= WristQuotaJ p w h B0 M x R u L Hv κ q₀ e Y sat β (fun j=>cEraJ p w h B0 M Ω x R u L (Y j) y κ); exact (P0 j).env
 induction L' generalizing a with
 | nil=> rw [List.length_nil]; simp
 | cons i' l ih=>
   let H':=(l.map A).prod; let G:=(l.map D).prod; let M':=(a.map A).prod
   let v:= C (M'*(A i'*H')); let W:= M'*A i'*G; let z:=β i'
   let J':=ih (a++[i']) (by simpa using g) (by simpa only [length_append,length_cons,length_nil, Nat.zero_add] using show a.length+1+l.length=n+1 from (by simp only [length_cons] at c; omega)) -- tune
   have hK:v= C (((a++[i']).map A).prod* (l.map A).prod):=by unfold v M' H'; rw [List.map_append,List.prod_append]; simp[mul_assoc]
   have hx:C (M'*(A i'*G))=C (M'*(D i'*G))+ C (M'*z*G):=by -- res cyc
      let P0:=WristQuotaJ p w h B0 M x R u L Hv κ q₀ e Y sat D hd; have ht(G'):=(P0 G').env
      have hG:Envelope (G):=(Post_ListJ (S:=Finset.univ) D l (fun i _=>Post_LiftJ (P0 i) (subset_univ _))).env
      let R:= WristQuotaJ p w h B0 M x R u L Hv κ q₀ e Y sat A ha
      have hM:Envelope M':=(Post_ListJ (S:=Finset.univ) A a (fun i _=>Post_LiftJ (R i) (subset_univ _))).env
      rw [Δ,add_mul,mul_add,←mul_assoc M' (β i')]; exact Tapestry.plusReader _ _ _ _ (env_mult hM (env_mult (ht i') hG)) (env_mult (env_mult hM (heΨ i')) hG) ⟨h,le_rfl⟩
   change ‖v-C (M'*(D i'*G))‖≤ (↑(l.length+1):ℝ)*_ -- bound
   let Q':=M'*z*G
   have hu:= PoiPieceJ p w h B0 M Ω x R u L y Hv κ q₀ e Y sat rK Q q' Sκ b hb pY pK A D ha hd a l i' (by simp only[length_cons] at c; omega) g
   have h':v-C (M'*(D i'*G))=(v-C W)+C Q':=by unfold W Q'; rw [mul_assoc (M') (A i'),hx]; abel
   have hy :‖v-C W‖≤ (l.length:ℝ)*d':=by apply le_trans _ J'; rw [hK,show ((a++[i']).map A).prod*(l.map D).prod=W from (by unfold W M' G; simp)]
   rw[h']; push_cast; exact (norm_add_le ..).trans ((add_le_add hy hu).trans_eq (by unfold d' s; ring)) -- tune
#print axioms RenTideJ
