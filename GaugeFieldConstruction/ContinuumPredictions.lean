/- Heal opacity: the `qualifications` used by these probes are ALL
    from the exact same pipeline, even for n point prices, not just two.
    Here are triangulation and physical pricing budgets:
-/
structure PriceTheSameFields : Prop where
 can (S:ℕ→ℕ):Tendsto S atTop atTop→∀ X:UV four, StandardPV S (fun _=>roles.OriginsVU X) (roles.RoomsVU X)
 local_price (n:ℕ)(F:Fin n→ΧiMars)(S:ℕ→ℕ)(sF:Fin n→ℕ→ℕ→process.Test) :
    (∀ j,StandardPV S (sF j) (roles.RoomsVU (F j))) → Tendsto S atTop atTop →∀(u:ℕ→ℕ),(∀ᶠ i in atTop,S i≤u i)→
    ∀ (f:Points n→ℂ),Continuous f→∀(g:HasCompactSupport f), tsupport f⊆TerraVU n→
    Tendsto (fun i=> process.singleState 3 (u i) vacuum (RoleCoverPV n sF f g i (u i))) atTop (𝓝 (CarriageVU n F f (roles.χVX stress vacuum)))
 budgets (n:ℕ)(F:Fin n→ΧiMars)(S:ℕ→ℕ)(sF: Fin n→ℕ→ℕ→process.Test):
    (∀ j,StandardPV S (sF j) (roles.RoomsVU (F j))) → Tendsto S atTop atTop →
    ∀ (f:YM.Test n) (U:Fin n→ Set Vantage), (∀ k,IsOpen (U k))→ (∀ (j:Fin n) x,x∈tsupport f→ (x j).ofLp∈ U j)→
    ∀ ε:ℝ,0<ε→∀ᶠ j in atTop,∀ᶠ s:ℕ in atTop,∀ r:ℕ,S s≤r→
      let o:= RookPV n f sF j s r
      o∈ treasuryVU r (⋃ i,U i) ∧
       PollTrackVU.shapeVU (R:=scale) (s:=r) (x:=vacuum) (c:=screens) [(o,⋃ i,U i)]
          (f.applyTo (roles.ViewConePV stress (le_refl _) (T:=continued) n F)) ε
lemma correspondence : PriceTheSameFields (continued:=continued) (vacuum:=vacuum) (stress:=stress) (screens:=screens) (scale:=scale):=by
 let Q:=Certificate.path
 have v:=Q.phase_costs
 exact ⟨roles.FirstRoadPV,fun n F S s T g u p=> roles.WisdomPV stress vacuum v n F S s T u g p,
     fun n F S sF tX hU f U i b ε e=> roles.AnyTablePV stress vacuum _ v Q.ward_oracle n F f U i b Certificate.field_theory Q.trajectory S sF tX hU _ ε e (by rw [dist_self];exact half_pos e)⟩
