variable {K:Calibration}{S:Finset Cover}{w:ℕ}{o:Cover}{d N:Side}{a b:Cover}
def planeQ (w:ℕ)(o:Cover)(i:Axis)(z:ℤ):ℤ:= o i+w*z
local notation "δ"=> planeQ w o
abbrev POSQ(K:Calibration)(i:Axis)(z:ℤ):Prop:= ∃ y:ℤ, z=Heat.gaugeShift K.B y
def CatellaQ (K:Calibration)(w:ℕ)(o:Cover)(d N:Side):Prop:= 0<w ∧ N.val=w*d.val ∧ ∀ (i:Axis)(v:ℤ), POSQ K i (planeQ w o i v) ∨ POSQ K i (planeQ w o i (v+d.val))
def PipeQ (K:Calibration)(w:ℕ)(o:Cover)(x:Cover)(S:Finset Cover):Prop:=∀i,Between K i (planeQ w o i (x i)) (planeQ w o i (x i+1)) S
local notation "ι"=>PipeQ K w o
def buttonQ (d:Side)(x:Cover):dialQ d:=fun i=>↑(x i)
local notation "κp"=>buttonQ d
lemma reflect_pipeQ (h:PipeQ K w o a S)(i:Axis)(v:ℤ) :PipeQ K w o (bent i (2*v) a) (reflectedBox i (planeQ w o i v) S):=by
 intro j; by_cases p:j=i
 · subst j
   convert Between.mirror K i (h i) (planeQ w o i v) using 1 <;> unfold planeQ bent <;> rw [pet_i] <;> ring
 intro y e; obtain ⟨z,t,u⟩:=reflect_stays i _ S e; unfold bent; rw [u j,if_neg p, pet_j _ p]; exact h j z t
lemma reflect_capQ (d:Side)(a:Cover)(i:Axis)(v:ℤ): buttonQ d (bent i (2*v) a)=bendQ d i v (buttonQ d a):=by
 funext j; by_cases p:j=i
 · subst j; rw[bend_here]; unfold bent buttonQ; rw [pet_i]; push_cast; rfl
 unfold bent buttonQ; rw [pet_j _ p]; exact (bend_there d v i (buttonQ d a) p).symm
lemma creviceQ (c:CatellaQ K w o d N)(h:PipeQ K w o b S){j:Axis}{v:ℤ}(p:posQ d j v (buttonQ d b)):Satin.region S N⊆ band N j (planeQ w o j v) K.ℓ:=by
 apply enters_wrapped; intro z t; have ht:= h j z t
 let y:ZMod (2*d.val):=(↑(b j) : ZMod (2*d.val))-(v:ZMod (2*d.val)); let r:=y.val; have hp:r<d.val:=p
 have he:Int.cast (R:=ZMod (2*d.val)) (v+r)= ↑(b j):=by push_cast; rw [show ↑r=y from ZMod.natCast_zmod_val _]; unfold y; ring
 obtain ⟨a,e⟩:= (ZMod.intCast_eq_intCast_iff_dvd_sub ..).mp he
 have hv0:b j + (↑(2*d.val):ℤ)*(-a)=v+r:=by -- tune sign
    rw [mul_neg]; linarith
 let Y:= z j + (↑(2*N.val):ℤ)*(-a); refine ⟨Y,-a,rfl,?_,?_⟩
 · unfold planeQ at *; unfold Y; rw [c.2.1]; push_cast at *; obtain ⟨x,b⟩:=ht; nlinarith
 unfold planeQ at *; unfold Y; rw [c.2.1]; push_cast at *; obtain ⟨x,b⟩:=ht; nlinarith [mul_nonneg (Nat.cast_nonneg (α:=ℤ) w) (show (0:ℤ)≤ (d.val)-(r+1:ℕ) by exact sub_nonneg.mpr (by exact_mod_cast hp))]
#check ZMod.val
-- all locations generated by boundary reflection, starting any color origin
inductive StakeQ (K:Calibration)(w:ℕ)(o a:Cover)(f:Family K) : Cover→Family K→Prop
| start:StakeQ _ w o a f a f
| bends {b:Cover}{F:Family K}(i:Axis)(v:ℤ)(p:StakeQ K w o a f b F): StakeQ K w o a f (bent i (2*v) b) (mirror K i (planeQ w o i v) F)
variable {f F:Family K}{u:ℝ}
lemma StakeQ.lives (h:StakeQ K w o a f b F)(t:InTest K true S false f)(u:PipeQ K w o a S): ∃ T:Finset Cover, InTest K true T false F ∧ PipeQ K w o b T:=by
 induction h with
 | start=>exact ⟨_,t,u⟩
 | bends i v p ih=> obtain ⟨S,t,h⟩:=ih; exact ⟨_,axial K _ _ t,reflect_pipeQ h i v⟩
lemma StakeQ.cash (h:StakeQ K w o a f b F)(t:pay f u):pay F u:=by induction h with|start=>exact t| bends i v p ih=> exact pay_flips _ ih i _
def TwigQ(K:Calibration)(w:ℕ)(o a:Cover)(f:Family K)(d:Side)(x:dialQ d)(F:Family K):Prop:= ∃ b:Cover,buttonQ d b=x ∧ StakeQ K w o a f b F
variable {x:dialQ d}
lemma TwigQ.mirrorQ (h:TwigQ K w o a f d x F)(i:Axis)(v:ℤ): TwigQ K w o a f d (bendQ d i v x) (mirror K i (planeQ w o i v) F):=by
 obtain ⟨b,rfl,e⟩:=h; exact ⟨_,reflect_capQ ..,e.bends i v⟩
lemma TwigQ.borrow (h:TwigQ K w o a f d x F)(p:CatellaQ K w o d N)(t:InTest K true S false f)(u:PipeQ K w o a S){j:Axis}{v:ℤ}(a: posQ d j v x): ∃ T:Finset Cover, InTest K true T false F ∧ Satin.region T N⊆ band N j (planeQ w o j v) K.ℓ:=by
 obtain ⟨b,rfl,e⟩:=h; obtain ⟨T,v',h⟩:= e.lives t u; exact ⟨_,v',creviceQ p h a⟩
#print axioms creviceQ
