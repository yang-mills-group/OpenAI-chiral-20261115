 have hB:0≤ ΦWallet p := (WalletB _).le
 have v:‖I‖≤ (1:ℝ):=P.heat_norm ..
 apply (norm_add_le ..).trans; rw [norm_smul]; refine (add_le_add hp (mul_le_of_le_one_right (norm_nonneg _) v)).trans ?_; rw [mul_comm (LoomK w)]; let Y:= RankQJ P.par f *LoomK w; have hy:0≤Y:=mul_nonneg (p.tempo f hf).1.le (noLoom _) -- tune
 calc ΦWallet p *Y+ ‖z‖ ≤ (ΦWallet p+1)*(Y+‖z‖):=by linarith only [hy,mul_nonneg hB (norm_nonneg z)]
