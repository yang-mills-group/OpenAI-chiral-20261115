lemma FullWaveL:SailsArtL (Fr) (PaidPadL P) where
 rate x j:=by
    obtain ⟨g,v⟩:= eventually_atTop.mp (SailRentL p B0 M R pu A D Q t uH H m Sq Wp L0 J' υ src x j)
    let W:= Wages79R P five 1; have hw(f:ℕ): Wages79R P five f=W^f:=by unfold W Wages79R; rw [pow_one]
    have hW:0≤ W:= pow_nonneg (Real.rpow_nonneg (Nat.cast_nonneg _) _) _
    obtain ⟨n,t⟩:=pow_unbounded_of_one_lt W (one_lt_two (α:=ℝ)); obtain ⟨z,h,t'⟩:= ΨSlashL P
    let U(f:ℕ):= ‖(X77 x) j (AutoPadR P f) (AutoPadR P f)‖
    let a:= (ΦWallet p+1)*2*z^n; let b:=∑ i∈ Finset.range (g+1),U i; have hx:0≤b:=sum_nonneg fun i _=>norm_nonneg _; have hy:0≤a:=by have hb:= WalletB p; unfold a; positivity
    refine ⟨a+b+1,n,by positivity,?_⟩
    intro i e; let f:=scaleWL P i
    have h1:1 ≤ (i:ℝ)⁻¹^n:= one_le_pow₀ ((one_le_inv₀ (show 0<(i:ℝ) from e.1)).mpr (show (i:ℝ)≤1 from (show (i:ℝ)<1 from e.2).le))
    change U f≤ _; by_cases p': g≤f; swap
    · exact le_trans (single_le_sum (f:=U) (fun i _=>norm_nonneg _) (mem_range.mpr (show f<g+1 by omega))) ((show b≤ a+b+1 from (by linarith only[hy])).trans (le_mul_of_one_le_right (by positivity) h1))
    refine (v f p').trans ?_; rw[hw]
    have he: W^f ≤ z^n*(i:ℝ)⁻¹^n:=calc
       _ ≤ ((2:ℝ)^n)^f := pow_le_pow_left₀ hW t.le _
       _ = ((2:ℝ)^f)^n:=by rw [←pow_mul,←pow_mul,mul_comm n]
       _ ≤ (z*(i:ℝ)⁻¹)^n := pow_le_pow_left₀ (by positivity) (t' i e) _
       _ = _:=mul_pow ..
    let k:=ΦWallet p+1; have ht:0≤ k:=add_nonneg (WalletB p).le zero_le_one; apply (mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left he zero_le_two) ht).trans; rw [←mul_assoc k,←mul_assoc]; exact mul_le_mul_of_nonneg_right (show a≤a+b+1 by linarith only [hx]) (zero_le_one.trans h1) -- tune
#print axioms FullWaveL
