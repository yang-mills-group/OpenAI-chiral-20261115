 let E:=AutoPadR P f; obtain ⟨w,z,h,u'⟩:=e hf 0 R; rw [WayNullR] at h; dsimp only; rw[h]; let L:=MeshΦ p B0 M 0 R (ΤbandR five) pu A (Sq 0 R _) D (Wp.go ..) hf w j E E; let I:=(CandΛJ P) j E E
