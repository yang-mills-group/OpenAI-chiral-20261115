lemma AscentTallNX (s:ℕ)(q:f ≤ s)(ζ:s≤Y.uv k) (W:j≤ f) : ∃ V:ChartY Y i k P_, InquiryNX ΓC Tζ s (W.trans q) V:=by
 induction ζ using Nat.decreasingInduction with
 | self=>
    obtain ⟨V,w⟩:=Full_UV F p g0 q (le_trans W q)
    have h:=ΓC.upper
    exact ⟨V,w.gift,w.top,w.mark0,fun {_}=>w.loop, fun {_}=>w.paid,fun {_} l v _=>w.ancestry l v,fun t=>(not_lt_of_ge t h).elim,fun {_} a v _=> w.story a v,fun t=>(not_lt_of_ge t h).elim⟩
 | of_succ s b ih=>
    let z:=s; have hs:s < Y.uv k:=b; have g': j ≤ s:= le_trans W q
    obtain ⟨V,hV⟩:= ih (q.trans (Nat.le_succ _)); obtain ⟨T,pT⟩:=ParentJ s F p g0 q hs g' V (hV.paid le_rfl hs) -- order update
    by_cases tz:s=m
    · subst m
      let U:ChartY Y i k P_:={V with Br:=Function.update V.Br s T}; let P0:= FountNX ΓC Tζ U; let D':ChartY Y i k P_:={U with Mark:=Function.update U.Mark s P0}; let Γ:= FastNX ΓC Tζ D'; let H:ChartY Y i k P_:={ D' with Roll:=Function.update D'.Roll s Γ }
      have h1(s₁:ℕ)(e:s < s₁): H.Mark s₁=V.Mark s₁:=Function.update_of_ne e.ne' ..; have h2(s₁:ℕ)(e:s < s₁): H.Br s₁=V.Br s₁:=Function.update_of_ne e.ne' ..; have h3(s₁:ℕ)(e:s < s₁): H.Roll s₁= V.Roll s₁:=Function.update_of_ne e.ne' ..
      have h_B:H.Roll s= FastNX ΓC Tζ H:=Function.update_self ..
      have gT:F.DayGate p s g' b (H.Roll (s+1)) (H.Br s):=by rw[h3 _ (Nat.lt_succ_self _),show H.Br s=T from Function.update_self ..]; exact pT
      refine ⟨H,hV.gift,(h3 _ b).trans hV.top,(h1 _ b).trans hV.mark0,?_,?_,?_,?_,?_,?_⟩
      · intro s' x e; obtain p|pX:= lt_or_eq_of_le x; swap; · subst s'; exact gT
        rw [h3 (s'+1) (p.trans (Nat.lt_succ_self _)),h2 s' p]; exact hV.loop p e
      · intro s' x e; obtain p₁|pX:= lt_or_eq_of_le x; swap
        · subst s'; -- ancestry F.B receipt same ref via defeq
          exact PayFloorNX g0 ΓC Tζ H W q gT h_B
        have h:= hV.paid (s:=s') p₁ e; unfold CountWise at *; rw [h3 _ p₁]; exact h
      · intro s' x e δ; obtain x'|pX:= lt_or_eq_of_le x; swap; · exact (δ pX.symm).elim
        rw [h3 _ x', hV.ancestry (s:=s') x' e δ]; simp_rw[FrescoBJ,h2 _ x']
      · exact fun _=>h_B
      · intro s' x e δ; obtain x'|pX:= lt_or_eq_of_le x; swap
        · exact (δ pX.symm).elim
        rw [h1 _ x', hV.story (s:=s') x' e δ]; unfold RollK; rw[h1 _ (x'.trans (Nat.lt_succ_self _)),h2 _ x']
      intro e; rw [show H.Mark s=P0 from Function.update_self ..]; unfold P0 FountNX; rw[h1 _ (Nat.lt_succ_self _)]
    let U:ChartY Y i k P_:={V with Br:=Function.update V.Br s T}; let P0:= RollK p U s b; let D':ChartY Y i k P_:={U with Mark:=Function.update U.Mark s P0}; let Γ:= F.FrescoBJ p s (f:=s) le_rfl b g' D'; let H:ChartY Y i k P_:={ D' with Roll:=Function.update D'.Roll s Γ }
    have h1(s₁:ℕ)(e:s < s₁): H.Mark s₁=V.Mark s₁:=Function.update_of_ne e.ne' ..; have h2(s₁:ℕ)(e:s < s₁): H.Br s₁=V.Br s₁:=Function.update_of_ne e.ne' ..; have h3(s₁:ℕ)(e:s < s₁): H.Roll s₁= V.Roll s₁:=Function.update_of_ne e.ne' ..
    have h_B:H.Roll s= F.FrescoBJ p s le_rfl b g' H:=Function.update_self ..
    have gT:F.DayGate p s g' b (H.Roll (s+1)) (H.Br s):=by rw[h3 _ (Nat.lt_succ_self _),show H.Br s=T from Function.update_self ..]; exact pT
    refine ⟨H,hV.gift,(h3 _ b).trans hV.top,(h1 _ b).trans hV.mark0,?_,?_,?_,?_,?_,?_⟩
    · intro s' x e; obtain p|pX:= lt_or_eq_of_le x; swap; · subst s'; exact gT
      rw [h3 (s'+1) (p.trans (Nat.lt_succ_self _)),h2 s' p]; exact hV.loop p e
    · intro s' x e; obtain p₁|pX:= lt_or_eq_of_le x; swap
      · subst s'; -- ancestry F.B receipt same ref via defeq
        exact PayFloor s F p g0 H b W q gT h_B
      have h:= hV.paid (s:=s') p₁ e; unfold CountWise at *; rw [h3 _ p₁]; exact h
    · intro s' x e δ; obtain x'|pX:= lt_or_eq_of_le x; swap; · subst s'; exact h_B
      rw [h3 _ x', hV.ancestry (s:=s') x' e δ]; simp_rw[FrescoBJ,h2 _ x']
    · intro l; have he:=lt_of_le_of_ne l tz; rw [h3 _ he,hV.harvest he]; unfold FastNX; rw [h2 _ he]
    · intro s' x e δ; obtain x'|pX:= lt_or_eq_of_le x; swap
      · subst s'; rw [show H.Mark s=P0 from Function.update_self ..]; unfold P0 RollK; rw[h1 (s+1) (Nat.lt_succ_self _)]
      rw [h1 _ x', hV.story (s:=s') x' e δ]; unfold RollK; rw[h1 _ (x'.trans (Nat.lt_succ_self _)),h2 _ x']
    intro e; have he:=lt_of_le_of_ne e tz; rw [h1 _ he,hV.horizon he]; unfold FountNX; rw [h2 _ he,h1 _ (he.trans (Nat.lt_succ_self _))]
#print axioms AscentTallNX
