abbrev βgZQ (P:Spine)(z:ℝ)(s:ℕ):ℝ:= LαK P.par.R.L z^s
local notation "β0"=> βgZQ P
lemma lowULQ (P:Spine): 1 < (P.par.R.L.val:ℝ):=by exact_mod_cast (show 1< P.par.R.L.val from lt_of_lt_of_le (by decide:1<3) P.par.R.coarse)
lemma RailWQ (P:Spine)(z:ℝ)(s:ℕ):0< βgZQ P z s:=pow_pos (Real.rpow_pos_of_pos (Nat.cast_pos.mpr P.par.R.L.property) _) _
lemma PlusWQ (P:Spine)(u v:ℝ)(s:ℕ):βgZQ P (u+v) s=βgZQ P u s* βgZQ P v s:=by unfold βgZQ LαK; rw[Real.rpow_add (zero_lt_one.trans (lowULQ P)), mul_pow]
lemma MinusWQ (P:Spine)(u:ℝ)(s:ℕ):βgZQ P (-u) s=(βgZQ P u s)⁻¹:=by unfold βgZQ LαK; rw[Real.rpow_neg (zero_lt_one.trans (lowULQ P)).le,inv_pow]
lemma RankSlowPQ (P:Spine)(ε:ℝ)(p:0<ε):∀ᶠ s:ℕ in atTop, max 1 (RankQJ P.par s)⁻¹ ≤ βgZQ P ε s∧0< RankQJ P.par s:=by
 let Y(i):= Scales.y SU.group P.par.R.L (hat P.par.R.L P.par.x i); let W:= LαK P.par.R.L ε; have hW:1<W:= Real.one_lt_rpow (lowULQ P) p; have ht:Tendsto Y atTop atTop:= (Scales.year SU.group P.par.R.L).comp (turnover P.par); -- pressure
 have hu:Tendsto (fun s:ℕ=> Y s* W⁻¹^s) atTop (𝓝 0):=by
    let Z:ℝ:= Vale.billX P.par.R.L; let a:= Y 0; let c:= W⁻¹; have hc: |c| < 1:=by unfold c; rw [abs_of_nonneg (by positivity)]; exact inv_lt_one_of_one_lt₀ hW
    have hpX:Tendsto (fun i:ℕ=> c^i) atTop (𝓝 0):= tendsto_pow_atTop_nhds_zero_of_lt_one (show 0≤ c from by unfold c; positivity) ((abs_lt.mp hc).2)
    have he:=(hpX.const_mul a).add ((tendsto_self_mul_const_pow_of_abs_lt_one hc).const_mul Z); rw [mul_zero,mul_zero,zero_add] at he; refine he.congr (fun i=>?_); have h:Y i=a+Z*i:=by unfold a Y Scales.y betaF hat Z; push_cast; ring
    change a * c^i+Z*(i*c^i)=Y i*c^i; rw[h]; ring
 filter_upwards [ht.eventually_gt_atTop 0, hu.eventually (ge_mem_nhds zero_lt_one)] with i g h; change Y i * W⁻¹^i ≤1 at h
 rw [inv_pow, ←div_eq_mul_inv] at h; let z:= RankQJ P.par i; have H:0<Y i:=g; have hv:z*Y i=1:= (mul_comm ..).trans (Scales.yg2 SU.group _ g)
 have he:z=(Y i)⁻¹:= by apply eq_inv_of_mul_eq_one_left hv -- tune
 unfold z at he; rw [he,inv_inv]; exact ⟨max_le (one_le_pow₀ hW.le) ((div_le_one (by positivity)).mp h),inv_pos.mpr H⟩
lemma CoalTermQ(P:Spine)(ε:ℝ)(p:0<ε): Tendsto (βgZQ P ε) atTop atTop:= tendsto_pow_atTop_atTop_of_one_lt (Real.one_lt_rpow (lowULQ P) p)
lemma RadarPQ (P:Spine)(ε:ℝ)(p:0<ε):∀ᶠ s in atTop,Real.exp (PriceιQ P s:ℝ) ≤ βgZQ P ε s:=by
 let c:=Real.log (P.par.R.L.val:ℝ); have hc:0<c:=Real.log_pos (lowULQ P); filter_upwards [EconomPQ P (ε*c/4) (by positivity)] with i h
 have h: ↑(PriceιQ P i) ≤ c*ε*i :=by rw [show (↑(PriceιQ P i):ℝ)= 4*↑(WorkWJ P i) from (by push_cast; rfl)]; linarith
 exact (Real.exp_monotone h).trans_eq (by unfold βgZQ LαK; rw [mul_comm (c*ε), Real.exp_nat_mul,Real.rpow_def_of_pos (zero_lt_one.trans (lowULQ P))]) -- order comm? exp_nat_mul arg
lemma WarmWagesCQ (P:Spine)(u:D_r)(s:ℕ): Wages79R P u s= βgZQ P ((aptC u:ℝ)+4*Alto) s:=rfl
lemma Sportcq (P:Spine)(d:D_r)(i:ℕ):(ScaleμJ P.par (ΤbandR d).val)^i = βgZQ P (-(aptC d:ℝ)-19/20) i:=by
 have he: ((3:ℝ)+ (ΤbandR d).val)=(aptC d:ℝ):=by exact_mod_cast normandR d
 unfold ScaleμJ GapGain; push_cast; rw [he,inv_pow]; exact (by rw[show -(aptC d:ℝ)-19/20= -((aptC d:ℝ)+19/20) from (by ring), MinusWQ]) -- tune neg_sub
