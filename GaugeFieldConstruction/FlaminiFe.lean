lemma MilitiaFe(e:s ≤ l): SaberFe P α (ArlaFe (s:=s) B0 x R u T D v L0 l) (FlaminaFe (s:=s) B0 x R u T D v L0 F l):=by
 obtain ⟨_,h,y⟩:=WarmStart p B0 M x R u L0 A T D V s0 v e; unfold ArlaFe FlaminaFe; rw [dif_pos e,dif_pos e,h]; let z:= F (UΔ e); refine SaberFe.diff ?_ ((feeP_1 α P).scale (ZΔ e)); rw [PaletteQ,PaletteQ]; rw [(pΦ.2 (UΔ e)).1,← Spin_qFe]; exact root_EΦ α D l _ _
include pu
lemma ArmyFe : (∀ᶠ r in atTop,Sign_S x (FlaminaFe (s:=s) B0 x R u T D v L0 F) r):=by
 filter_upwards [eventually_ge_atTop s, (ΘVenue_S p B0 M x R u pu A T D V s0 v L0).2] with r e k; have hv:=MilitiaFe p B0 M x R u A T D V s0 v α L0 F C pΦ e
 rw [SaberFe.action] at hv; unfold Sign_S; rw[hv]; exact MatrixFe.axP α (Tapestry.locates ..|>.mp (show ζK r∈ _ from k)) -- binder tune
lemma OmilinFe : ∃ X: ℕ→P.Slabs i, Tendsto (fun r=> σκ r i σ τ-X r) atTop (𝓝 0)∧ ∀ᶠ r in atTop,CallBoxJ x σ τ i (κZ r) (X r) r :=by
 obtain ⟨f,gF,f'⟩:=((farWallJ σ τ).and (eventually_ge_atTop s)).exists
 let A' :ℕ→ℝ:= fun r=> ΦWallet p*FlavorRateJ P u f s r (4*C*LoomK v)
 have hz:Tendsto A' atTop (𝓝 0):= by simpa only [mul_zero] using ((arumJ p u (f:=f) (s:=s) (4*C*LoomK v)).const_mul (ΦWallet p)) -- direction r vs t
 have he(r:ℕ)(h:f ≤ r):∃ X:P.Slabs i, CallBoxJ x σ τ i (κZ r) X r∧ ‖σκ r i σ τ-X‖≤ A' r:=by
    let g:=f'.trans h; let w:= F (UΔ g); obtain ⟨Y,vX,vT⟩:=LawΦsJ p B0 M x R u pu L0 A T D V (s0.trans f') σ τ i w (s0.trans g) h gF
    let U:= CandΛJ P i σ τ; let t:= ZΔ g; refine ⟨Y-t • U,by unfold FlaminaFe; rw [dif_pos g]; exact vX.minus ((UnitWallJ x σ τ i r).scale t),?_⟩
    let P':= MeshΦ p B0 M x R u pu A T D V (s0.trans g) (BrJ u (T.sun L0 r).1 w) i σ τ; let a:=(T.sun L0 r).2 w; rw[contractFe]; change ‖P'+(a-t) • U-(Y-t • U)‖≤ _; rw [sub_smul, show P'+ (_-_)-(Y-t • U)=P'+ a • U-Y from ?_,norm_sub_rev]; swap; · abel
    refine vT.trans ?_
    let ρ:= stepRateJ P.par u.val; let T':=p.price s s0 u r; have hw:= (pΦ.2 (UΔ g)).2; have hk: LoomK w ≤ 2*(ρ^(r-s)*LoomK v)*C:=hw.trans (mul_le_mul_of_nonneg_right (WarmStart p B0 M x R u L0 A T D V s0 v g).1 pΦ.1)
    apply mul_le_mul_of_nonneg_left ?_ (WalletB p).le
    calc
      _ ≤ FlavorRateJ P u f r r (2*(2*(ρ^(r-s)*LoomK v)*C)):=by
        have he:= p.price f (s0.trans f') u r; exact mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hk (by norm_num)) (mul_nonneg (mul_nonneg (mul_nonneg (by norm_num) (pow_nonneg he.small _)) (he.hot le_rfl h).le) (pow_nonneg (zero_le_one.trans T'.bound) _))
      _ = _:=by unfold FlavorRateJ ρ; rw[Nat.sub_self,pow_zero]; ring
 choose Z pZ using he; let X:ℕ→ P.Slabs i:=fun r=> if h:f ≤ r then Z r h else 0
 have hX(r:ℕ)(q:f ≤ r) : X r= Z r q:=by unfold X; rw[dif_pos q]
 refine ⟨X,Metric.tendsto_nhds.mpr fun ε e=>?_,(eventually_ge_atTop f).mono (fun i h=> hX i h ▸ (pZ i h).1)⟩
 filter_upwards [eventually_ge_atTop f,hz.eventually (gt_mem_nhds e)] with i h e; rw [dist_zero_right,hX i h]; exact (pZ i h).2.trans_lt e -- gt.N tune
