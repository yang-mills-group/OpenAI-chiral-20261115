    have e: (∑ i:T,v' i • ZeckR i.val)=ZeckR K:=hu; have ha: (∑ i:T,(-v' i) • ZeckR i.val)= -(∑ i:T,v' i • ZeckR i.val):=by
      rw [←sum_neg_distrib]; apply sum_congr rfl; intro i _; exact quNegFe _ _
    rw [ha,e, show (∑ i:Unit,(1:ℂ) • SpineM K.2.2)=SpineM K.2.2 from (by rw [Fintype.sum_unique]; exact one_smul ℂ _ )]; exact add_neg_cancel (_ :GaugeFieldConstruction.Calibration.Shell) |>.symm.symm -- Unit factor solve
