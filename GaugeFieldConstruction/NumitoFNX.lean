lemma ApertureFNX (Y:ℕ→ExposureIndexNX→ ScreensJ P)(T:∀ k,AlliantFNX P (ΤbandR three) m (B,k) (fun f=> Y f k))(X:ℕ→ExposureFrameNX)(Wb: ∃ c>0,∀ᶠ f in atTop,‖X f‖ ≤ c*νζ^f) (j:Axis)(a b:PermWallJ P) : let Sa i:=SportR P m i; let W(i):=costΞJ P j 0 (Sa i) a b (PupilFNX P B (X i) m i)
 (∀ᶠ i in atTop,CallBoxJ 0 a b j (PupilFNX P B (X i) m i) (W i) (Sa i))∧ Tendsto (fun i=>W i- ScanTicketR P (Y i) (X i) j a b) atTop (𝓝 0):=by
 intro Sa W
 obtain ⟨c,hc,Hx⟩:= Wb; let G:=νζ; have hG:1 ≤ G:=rate_bigR p three
 choose D' M' pM w using T
 let q:= Finset.univ.sup D'
 obtain ⟨e,g,z,p'⟩:= ((farWallJ a b).and ((eventually_ge_atTop q).and (eventually_ge_atTop f0))).exists
 let wp(i f):=P.SunPlateNX (B,i) m f
 let DV i f:= costΞJ P j 0 (Sa f) a b (wp i f)
 have ht(i:ExposureIndexNX)(t:ℕ)(h:e ≤ t) : CallBoxJ 0 a b j (wp i t) (DV i t) (Sa t) ∧ ‖DV i t-Y t i j a b‖ ≤ M' i*LegScanNX P (ΤbandR three) m t e:=by
    have hv: D' i ≤ e:= (le_sup (f:=D') (mem_univ i)).trans z; exact w i t (hv.trans h) e hv (h.trans (SportR.hop P m t)) a b j g
 let PI(t:ℕ):= ∑ i:ExposureIndexNX, X t i • DV i t
 have hv(i:ℕ)(e':e ≤ i) : CallBoxJ 0 a b j (PupilFNX P B (X i) m i) (PI i) (Sa i):=by
    have h(t: Finset ExposureIndexNX):CallBoxJ 0 a b j (∑ k∈t,X i k • wp k i) (∑ k∈t,X i k • DV k i) (Sa i):=by
       induction t using Finset.induction with
       | empty=> simpa [CallBoxJ] using ((UnitWallJ (P:=P) 0 a b j (Sa i)).minus (UnitWallJ 0 a b j (Sa i)))
       | insert k t f' ih=> rw [sum_insert f',sum_insert f']; exact (((ht k i e').1).scale _).plus ih
    exact h _
 have hx:∀ᶠ i in atTop,W i=PI i∧CallBoxJ 0 a b j (PupilFNX P B (X i) m i) (W i) (Sa i):=by filter_upwards[eventually_ge_atTop e] with i h; have ht:W i=PI i:=ℓγHeard _ _ _ _ _ (hv _ h); exact ⟨ht,ht.symm ▸ hv _ h⟩
 refine ⟨hx.mono (fun i t=>t.2),?_⟩
 let K(f i):= X f i • (DV i f-Y f i j a b)
 have hQ(i:ExposureIndexNX): Tendsto (fun f=>K f i) atTop (𝓝 0):=by
    have Hp:= (PixelFNX p three m e p' hm).const_mul (c*M' i); rw [mul_zero] at Hp; rw[tendsto_zero_iff_norm_tendsto_zero]; refine squeeze_zero' (Eventually.of_forall fun _=> norm_nonneg _) ?_ Hp
    filter_upwards [Hx,eventually_ge_atTop e] with f a t
    let Q:=LegScanNX P (ΤbandR three) m f e; have H:= (ht i f t).2
    change ‖K f i‖ ≤ _; unfold K; rw[norm_smul]; refine (mul_le_mul ((norm_le_pi_norm _ _).trans (show ‖X f‖ ≤ c*G^f from a)) H (norm_nonneg _) (by positivity)).trans_eq ?_; unfold LegScanNX G; ring -- tune
 have H:Tendsto (fun i=> ∑ x:ExposureIndexNX,K i x) atTop (𝓝 0):=by
    simpa only [sum_const_zero] using (tendsto_finsetSum univ (fun i _=> hQ i))
 apply H.congr'; filter_upwards[hx] with i t
 let V:=X i; let G:=ScanTicketR P (Y i) (X i); change (∑ v:ExposureIndexNX,K i v) = W i- (G j a b); rw[show W i=PI i from t.1]; unfold K; simp_rw [smul_sub]; rw[sum_sub_distrib]; rfl
