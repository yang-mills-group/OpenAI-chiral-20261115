lemma ΓPlateSnapNX (Y:ℕ→ExposureIndexNX→ ScreensJ P)(T:∀ k,AlliantFNX P (ΤbandR three) m (B,k) (fun f=> Y f k))(h:ℝ)(v:0 < h)(Z:∀ᶠ f in atTop, LinearMap.range (ScanTicketR P (Y f))=PZ∧∀ v:ExposureFrameNX,h*‖v‖ ≤ ‖GapHeightR P f (ScanTicketR P (Y f) v)‖) : ∃ Y:ℕ→ ExposureFrameNX, TerraceFNX P (SportR P m) (fun i=> PupilFNX P B (Y i) m i) F ∧ ∃ k>0,∀ᶠ f in atTop,‖Y f‖≤ k*RStepJ P.par (ΤbandR three).val^f:=by
 let HZ(i:ℕ):= ScanTicketR P (Y i); let UZ:= PZ
 let Sa i:= SportR P m i
 let G:=RStepJ P.par (ΤbandR three).val; have hG:1≤G:=rate_bigR p three
 obtain ⟨c,hc,hF⟩:=Sμ
 have he:∀ᶠ i in atTop,∃ z: ExposureFrameNX, HZ i z=F ∧ ‖z‖ ≤ c/h*G^i:=by
    filter_upwards [Z,hF] with i z ht
    obtain ⟨y,p'⟩:= mapScanNX (Y i) UZ (show LinearMap.range (ScanTicketR P (Y i))=UZ from z.1) F Pμ
    let H:= (z.2 y); rw [show ScanTicketR P (Y i) y=F from p'] at H; refine ⟨y,p',?_⟩
    rw[div_mul_eq_mul_div, le_div_iff₀ v,mul_comm]; exact H.trans ht
 let X(i:ℕ):ExposureFrameNX:= if h':∃ z:ExposureFrameNX,HZ i z=F ∧ ‖z‖≤ c/h*G^i then h'.choose else 0
 have Hx:∀ᶠ i in atTop,HZ i (X i)= F ∧ ‖X i‖≤ c/h*G^i:= he.mono fun i h=> by unfold X; rw[dif_pos h]; exact h.choose_spec
 have hw:∃ c>0,∀ᶠ f in atTop,‖X f‖ ≤ c*G^f:= ⟨c/h,div_pos hc v,Hx.mono fun i z=> z.2⟩
 refine ⟨X,?_,hw⟩
 intro j σ τ Y'
 obtain ⟨p',t⟩:= ApertureFNX p m hm B Y T X hw j σ τ -- tune order
 refine ⟨p',?_⟩
 have he:= t.add_const (F j σ τ); rw[zero_add] at he; apply he.congr'; filter_upwards [Hx] with i u; change Y' i- ScanTicketR P (Y i) (X i) j σ τ+_= _; rw[show ScanTicketR P (Y i) (X i)=F from u.1,sub_add_cancel] -- tune
#print axioms ΓPlateSnapNX
