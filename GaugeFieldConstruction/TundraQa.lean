lemma NoonQa (x:YM.Test n)(v:Ember.Rim)(U:Points n→ℂ) : (v.roll x).applyTo U=x.applyTo (fun j=>U (v.r • j)):=by
 let t:=v.roll x; let J(j:Points n):= t j*U j
 let r:=v.r; let y:= v.normed n
 have he:=Measure.integral_comp_smul_of_nonneg volume J r (hR:=v.p.le)
 have hg:Module.finrank ℝ (Points n)= 4*n:=by rw [show Module.finrank ℝ (Points n)= Module.finrank ℝ (Fin n→E4) from (WithLp.linearEquiv 2 ℝ (Fin n→E4)).finrank_eq]; simp [E4,Axis,mul_comm,Module.finrank_pi_fintype] -- tune
 have h(y':Points n): J (r • y')= y⁻¹ • (x y'*U (r • y')):=by unfold J t; rw [Rim.value,Rim.rv, show v.r=r from rfl, inv_smul_smul₀ v.ne]; exact smul_mul_assoc ..
 simp_rw [hg,h,integral_smul] at he
 exact smul_right_injective ℂ (inv_ne_zero (show y≠0 from pow_ne_zero _ v.ne)) he.symm
lemma CutesQa (X:κYFeS P n)(U:Points n→ℂ)(a:CueR X U) (x:YM.Test n)(p':tsupport x⊆ B_Esc n) (C: CoinsR P): Tendsto (fun k=>x.applyTo (X k C)) atTop (𝓝 (x.applyTo U)):=by
 let K:= tsupport x; have h:IsCompact K:=x.hasCompactSupport
 have he(V:Points n→ℂ): x.applyTo V= ∫ p in K,x p*V p:=(setIntegral_eq_integral_of_forall_compl_eq_zero (fun i (p:i∉K)=> (by rw [image_eq_zero_of_notMem_tsupport p,zero_mul]))).symm
 rw [Metric.tendsto_nhds]; intro ε v
 obtain ⟨B,t⟩:=h.exists_bound_of_continuousOn x.continuous.continuousOn; let W:=‖B‖+1; have hp:0<W:= add_pos_of_nonneg_of_pos (norm_nonneg _) zero_lt_one
 filter_upwards [a.coalesces K h p' (ε/W) (div_pos v hp)] with i z
 rw [dist_eq_norm,he,he]; let f:=X i C
 have hU:ContinuousOn U K:= a.smooth.mono p'; have hF:ContinuousOn f K:=(a.down C i).mono p'
 rw [←integral_sub (show Integrable (fun j=>x j*X i C j) (volume.restrict K) from x.continuous.continuousOn.mul hF |>.integrableOn_compact h) (show Integrable (fun j=>x j* U j) (volume.restrict K) from x.continuous.continuousOn.mul hU|>.integrableOn_compact h)]; apply lt_of_le_of_lt (norm_integral_le_integral_norm _); let S(y:Points n):=‖f y-U y‖
 apply lt_of_le_of_lt (b:=W*(∫ j in K,S j)); swap
 · exact (mul_lt_mul_of_pos_left (z C) hp).trans_eq (by field_simp)
 have hv :∀ j:Points n, ‖x j*f j-x j*U j‖= ‖x j‖*S j:=fun j=>by rw[←mul_sub,norm_mul]
 change ∫ j in K, ‖x j*f j-x j*U j‖ ≤ _; simp_rw [hv]; rw [←integral_const_mul]
 exact setIntegral_mono_on (x.continuous.norm.continuousOn.mul (hF.sub hU).norm|>.integrableOn_compact h) (continuousOn_const.mul (hF.sub hU).norm|>.integrableOn_compact h) h.measurableSet (fun j l=> mul_le_mul_of_nonneg_right (((t j l).trans (le_abs_self B)).trans (lt_add_one ‖B‖|>.le)) (norm_nonneg _))
lemma FaintQa (P:Spine): Tendsto (deltaR P) atTop (𝓝 0):=by
 let x:= P.urnMark; have ht:= sparkC_R P 1; simp only [pow_one] at ht; let R:ℝ:=P.par.R.L.val; have he:1 < R:= lt_of_lt_of_le one_lt_two (loftL_R P)
 let r:=R⁻¹; have hr:0 ≤ r:=by unfold r; positivity
 have hw:r < 1:= inv_lt_one_of_one_lt₀ he; let b:= Vale.billX P.par.R.L
 have hx:Tendsto (fun i:ℕ=> (r^i/2)*x i) atTop (𝓝 0):=by
    have v:‖r‖<1:= (Real.norm_of_nonneg hr).trans_lt hw
    have p:=((tendsto_pow_atTop_nhds_zero_of_norm_lt_one v).mul_const (P.par.x/2)).add ((summable_pow_mul_geometric_of_norm_lt_one 1 v).tendsto_atTop_zero.mul_const (b/2)); rw[zero_mul,zero_mul,zero_add] at p; refine p.congr (fun i=> ?_); change r^i*(P.par.x/2)+_ = r^i/2*(P.par.x+i*b); ring
 refine squeeze_zero_norm' (ht.mono fun i p=> ?_) hx; rw[Real.norm_of_nonneg (deltaR_good ..).le, deltaR]; rw [←show P.mellow i=r^i/2 from (by rw [mellow_clock]; unfold r R; simp; ring)]; exact mul_le_mul_of_nonneg_left p (mellow_good ..).le
