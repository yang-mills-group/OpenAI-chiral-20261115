variable (Q:PaysJ q μ0 S₀ I₀ χ mR f n X d R)
include Q
lemma ζAccum (a:f≤ s)(b:s ≤ r)(t:r ≤ n): let S:= PlcJ r s p b; let B:=S₀^(r-s); let B':= I₀^(r-s); SkillJ S B ∧ Bijective S ∧ (∀ i, LoomK i ≤ B'*LoomK (S i))∧ q r≤2^(r-s)*q s ∧ SkillA (AcJ p r s b) (q s*R^(r-s)):=by
 -- induct
 induction b with
 | refl=>
    dsimp only; rw [Plc_self,Nat.sub_self,pow_zero,pow_zero,pow_zero,pow_zero,one_mul,mul_one,Ac_self]; exact ⟨fun i=>by change _ ≤ 1*LoomK _; rw [one_mul]; rfl, Function.bijective_id, fun i=>by rw [one_mul]; rfl,le_rfl,fun i=> by change ‖(0:ℂ)‖≤_; rw [norm_zero]; exact mul_nonneg (Q.hot a t).le (noLoom _)⟩
 | @step j h ih=>
    obtain ⟨c,v,iv,hQ⟩:= pu.turn j (a.trans h) t -- hQ? counts
    obtain ⟨z,vQ,wV,y,H⟩:= ih (by omega)
    dsimp only; rw [Plc_succ _ _ _ h,Nat.succ_sub h,pow_succ',pow_succ',pow_succ',pow_succ']
    let U:= PlcJ j s p h; have hp:=Q.pass (a.trans h) t; let B₀:= R^(j-s); have hJ:= Q.hot a (Nat.le_trans h (by omega)); have hv: 0≤ S₀:=zero_le_one.trans Q.bound; have hξ:0≤ I₀:= Q.invCost
    refine ⟨fun i=> (c (U i)).trans ?_, v.comp vQ, fun i=>?_,hp.1.trans ?_,?_ ⟩ -- order.
    · rw [mul_assoc]; exact mul_le_mul_of_nonneg_left (z i) hv
    · refine (wV i).trans ((mul_le_mul_of_nonneg_left (iv (U i)) (pow_nonneg hξ _)).trans_eq (by rw[LinearMap.comp_apply]; unfold U; ring)) -- ring w.Exp.S
    · exact (mul_le_mul_of_nonneg_left y (show 0≤ (2:ℝ) by norm_num)).trans_eq (mul_assoc ..).symm
    intro i; rw [Ac_step _ _ _ h,LinearMap.add_apply]; refine (norm_add_le ..).trans (le_trans (add_le_add (H i) (hQ (U i))) ?_)
    -- χ q j* S^n ν
    let l:= LoomK i; let Y:= 2^(j-s)*(q s); have hb:=Q.hot (a.trans h) (by omega); let Z':=q s*B₀; have hc :=Q.κPrice
    have hout:χ*(q j)*LoomK (U i) ≤χ*(q s*B₀)*l := by
      refine (mul_le_mul_of_nonneg_left (z i) (mul_nonneg hc hb.le)).trans ?_; rw [←mul_assoc _ (S₀^_)]; apply mul_le_mul_of_nonneg_right _ (noLoom i); rw[mul_assoc]; apply mul_le_mul_of_nonneg_left _ hc
      refine (mul_le_mul_of_nonneg_right y (pow_nonneg hv _)).trans ?_; have h':=(pow_le_pow_left₀ (show 0≤ 2*S₀ from mul_nonneg (by norm_num) hv) (Q.θpay) (j-s)); rw [mul_pow] at h'; exact le_trans (le_of_eq (show _=q s*(2^(j-s)*S₀^(j-s)) from (by ring))) (mul_le_mul_of_nonneg_left h' hJ.le)
    apply (add_le_add_right hout (q s*B₀*l)).trans -- which left/right? tune
    rw [←add_mul]; apply mul_le_mul_of_nonneg_right _ (noLoom i); have he:0 ≤B₀:=pow_nonneg ((mul_nonneg (by norm_num) hv).trans Q.θpay) _; change Z'+χ*Z' ≤ q s*(R*B₀); unfold Z'; nlinarith only [mul_le_mul_of_nonneg_right Q.θunit (mul_nonneg hJ.le he)] -- unfold
#print axioms ζAccum
end
