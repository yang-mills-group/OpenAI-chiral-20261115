variable {E:Type}[LinearOrder E][Fintype E]{T:Type}[AddCommGroup T][Module ℂ T]
variable (Z_:T)
abbrev MatJ := FrameK E→ₗ[ℂ]FrameK E
abbrev OffJ := FrameK E→ₗ[ℂ]ℂ
variable (q:ℕ→ℝ)(μ0 S₀ I₀ χ mR:ℝ)
-- μ0 small = lambda inverse. cost rate fitted to product.
structure StaE where
   C (s:ℕ):MatJ (E:=E)
   a(s:ℕ): OffJ (E:=E)
structure GapE where
   G(s:ℕ): MatJ (E:=E)
   ε(s:ℕ): OffJ (E:=E)
structure TrekJ (f n:ℕ)(U:StaE (E:=E)):Prop where
   turn(s:ℕ)(e:f≤ s)(l:s<n): SkillJ (U.C s) S₀ ∧ Bijective (U.C s) ∧(∀ i, LoomK i≤ I₀ * LoomK (U.C s i))∧ SkillA (U.a s) (χ*(q s))
structure GainJ (f n:ℕ)(U:GapE (E:=E)):Prop where
   turn (s:ℕ)(e:f≤ s)(l:s<n): SkillJ (U.G s) mR ∧ SkillA (U.ε s) (μ0*(χ*q s))
-- SA gross generation.T(U) variant a offset bound χ may >1. increase θ to $(2α)$; need $a$ cumulative ≤ c_S.
structure PaysJ (f n:ℕ)(X d R:ℝ):Prop where
   small : 0≤ μ0
   bound : 1 ≤ S₀
   invCost : 0≤ I₀
   κPrice : 0≤χ
   GPrice : 0≤ mR
   hPrice : 0≤X -- cumulative H,d each, relative
   dust : X≤1/2 -- frame perturb allowed H≤1/2
   hot{s:ℕ}(p:f ≤ s)(t:s ≤ n):0 < q s
   pass{s:ℕ}(p:f ≤ s)(t:s<n):q (s+1)≤2*q s ∧ q s≤2*q (s+1)
   heatH : μ0*S₀*X+mR ≤ X
   heatA : μ0*(2*X+χ*2*X)+ μ0*(χ*2) ≤ X
   θpay : 2*S₀≤ R
   θunit : 1+χ ≤ R -- permits controlling $a_{ts}$ with 2^{t-s}; need sum: induct a_{u+1}≤ old R^n q_f+ χ q_{u} S^n ≤ (1+χ)*R^n q_f
   ψpay : μ0*R<1
   down : 1≤ d -- want price inverse_P inc d.
   theme : 2*(d +χ) * I₀ ≤ d -- recurrence retaining $d.Frames$.
namespace TrekJ
variable {μ0 S₀ I₀ χ q} (p:StaE (E:=E))(f r s n:ℕ)(pu:TrekJ q S₀ I₀ χ f n p) -- $no I?
local notation "C0"=> p.C
local notation "a0"=>p.a
-- rec from fixed arbitrary coefficient floor to any.Pay supplement; all heights.C.Property. use le rec plus proof terms orientation h.Use closed equation.
abbrev PlcJ (p:StaE (E:=E))(a:s ≤ r):MatJ (E:=E) := climbing (X:=fun _=>MatJ (E:=E)) (fun i x=> (p.C i).comp x) a LinearMap.id
abbrev DownJ (a:s≤ r): MatJ (E:=E) × OffJ (E:=E) := climbing (X:=fun _=> MatJ (E:=E) × OffJ (E:=E)) (fun i x=> ((p.C i).comp x.1, x.2+(p.a i).comp x.1)) a (LinearMap.id,0)
abbrev AcJ (a:s ≤ r): OffJ (E:=E):=(DownJ p r s a).2 -- tune order use implicit.Make param.
lemma Plc_self : PlcJ s s p le_rfl=LinearMap.id:=climbing_refl ..
lemma Plc_succ (a:s ≤ r): PlcJ (r+1) s p (a.trans (Nat.le_succ _))= (p.C r).comp (PlcJ r s p a):=climbing_succ .. -- order
lemma DownL (a:s ≤ r): (DownJ p r s a).1= PlcJ r s p a:=by
 induction a with
 | refl=>rw [Plc_self,DownJ,climbing_refl]
 | step h ih=>rw [DownJ,climbing_succ _ _ h, Plc_succ _ _ _ h,← ih]
lemma Ac_self : AcJ p s s le_rfl=0:=by rw [AcJ,DownJ,climbing_refl]
lemma Ac_step(a:s ≤ r) : AcJ p (r+1) s (a.trans (Nat.le_succ _))= AcJ p r s a+ (p.a r).comp (PlcJ r s p a):=by unfold AcJ; rw [DownJ,climbing_succ _ _ a,← DownL p r s a]
