lemma AnyTablePV (z:ℂ)(ε:ℝ)(e:0<ε)(vZ:dist (f.applyTo (E.ViewConePV p q (T:=T) n V)) z< ε/2):∀ᶠ j in atTop,∀ᶠ s:ℕ in atTop,∀ r:ℕ,S s≤r→
      RookPV n f Xo j s r∈ treasuryVU r (⋃ i,U i) ∧ PollTrackVU.shapeVU (R:=K) (s:=r) (x:=v) (c:=C') [(RookPV n f Xo j s r,⋃ i,U i)] z ε:=by
 classical
 rw [show f.applyTo (E.ViewConePV p q (T:=T) n V)=_ from (E.pesosχVU p v q hp _ _ _ _ hX n V f).symm] at vZ
 filter_upwards [(maskedχPV E p v q hp qx n V f).eventually (Metric.isOpen_ball.mem_nhds vZ)] with i' hi
 let x:=FilmPV n i' f; let C:= (⋃ i,U i)
 have Hv:CarriageVU n V x (E.χVX p v)∈ball z (ε/2):=by rw [ForePV]; exact hi
 refine EventuallyRightNX _ fun u hv=>?_
 filter_upwards [hv,E.SpacePricedPV n V S Xo tX x x.hasCompactSupport U i (fun j y v'=> b j y ((DockPV n i' f v').1)), (E.WisdomPV p v hp n V S Xo tX u hU hv x x.continuous x.hasCompactSupport ((DockPV n i' f).trans Set.inter_subset_right)).eventually (Metric.isOpen_ball.mem_nhds Hv)] with s a c l
 refine ⟨c (u s) a,t.queriesVU ?_ (by simp) e ?_⟩
 · simp only[List.mem_singleton]; rintro i rfl; exact c (u s) a
 simp only[List.map_cons,List.map_nil,List.prod_cons,List.prod_nil,mul_one]; exact l
