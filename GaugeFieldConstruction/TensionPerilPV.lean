lemma DockPV (i f) : tsupport (FilmPV n i f)⊆tsupport f ∩ TerraVU n:= Set.subset_inter ((CovePV n).small i f) ((CovePV n).tiny i f)
lemma ForePV (Z:CloudsL) (V:Fin n→ΧiMars)(f:YM.Test n): CarriageVU n V f Z=f.applyTo (fun x=> Z n x V):=by unfold YM.Test.applyTo CarriageVU; simp_rw[mul_comm (f _)]
