lemma TablingPV (z:ℂ)(ε:ℝ)(e:0<ε)(vZ:dist (f.applyTo (E.ViewConePV p q (T:=T) n V)) z< ε/2):∀ᶠ i in atTop,∀ᶠ r:ℕ in atTop,
   E.PurchaseCovePV n V f i r ∈ treasuryVU r (⋃ i,U i) ∧
     PollTrackVU.shapeVU (R:=K) (s:=r) (x:=v) (c:=C') [(E.PurchaseCovePV n V f i r,⋃ i,U i)] z ε:=by
 classical
 rw [show f.applyTo (E.ViewConePV p q (T:=T) n V)=_ from (E.pesosχVU p v q hp _ _ _ _ hX n V f).symm] at vZ
 filter_upwards [(maskedχPV E p v q hp qx n V f).eventually (Metric.isOpen_ball.mem_nhds vZ)] with i' hi
 let x:=FilmPV n i' f; let C:= (⋃ i,U i)
 have Hv:CarriageVU n V x (E.χVX p v)∈ball z (ε/2):=by rw [ForePV]; exact hi
 filter_upwards [(E.EnterpriseVU p v hp n V _ x.hasCompactSupport x.continuous ((DockPV n i' f).trans Set.inter_subset_right)).eventually (Metric.isOpen_ball.mem_nhds Hv), E.rootsVU n V _ x.hasCompactSupport U i (fun j y v'=> b j y ((DockPV n i' f v').1))] with h v0 hx
 refine ⟨hx,t.queriesVU (by simpa using (show P.asked_at h (E.PurchaseCovePV n V f i' h) C ∧ E.PurchaseCovePV n V f i' h∈ enclave P.calibration from hx)) (by simp) e ?_⟩
 simp only[List.map_cons,List.prod_cons,List.map_nil,List.prod_nil,mul_one]; exact v0
variable (S:ℕ→ℕ)(Xo:Fin n→ℕ→ℕ→P.Test)(tX:∀ j,StandardPV S (Xo j) (E.RoomsVU (V j)))(hU:Tendsto S atTop atTop)
noncomputable abbrev RookPV (i s r :ℕ):=RoleCoverPV n Xo (FilmPV n i f) (FilmPV n i f).hasCompactSupport s r
