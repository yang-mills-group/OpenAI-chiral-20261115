abbrev widthζR (P:Spine)(f:ℕ):ℝ:= P.stampPin f 1
lemma widthζR_pos (f:ℕ):(0:ℝ)<widthζR P f:=by unfold widthζR; rw[mellow_firm]; apply mul_pos (P.mellow_good _); have he:0<ruler P.par.block:= ruler_gene _; positivity
lemma widthζR_money (f:ℕ)(z:ℤ) : (P.stampPin f z:ℝ)= widthζR P f *z:=by unfold widthζR; simp only [mellow_firm,Int.cast_mul,mul_one]; ring
lemma widthδR(l:ℕ): widthζR P (SportR P m l) /deltaR P l = (ruler P.par.block:ℝ)/ Richm_R P m l :=by unfold widthζR; rw [mellow_firm]; rw [← Richm_peck,Int.cast_mul,Int.cast_one,mul_one]; field_simp [widthζR_pos, (P.mellow_good _).ne'] -- tune
lemma widthδR_shrinks : Tendsto (fun l=>widthζR P (SportR P m l)/deltaR P l) atTop (𝓝 0):=by simp_rw [widthδR]; exact tendsto_const_nhds.div_atTop (Richm_lit P m)
def LfloorR (P:Spine)(y:ℝ)(f:ℕ):ℤ:= ⌊y/widthζR P f⌋
local notation "dL"=>LfloorR
lemma minutesR (f:ℕ)(y:ℝ):let L:=LfloorR P y f; let A:ℤ→P.meshPin:= P.stampPin f; (A L:ℝ)≤ y ∧ y < (A (L+1):ℝ) ∧ (A (L+1):ℝ)=(A L:ℝ)+widthζR P f:=by
 intro L A; let Z:=widthζR P f; have hz:0<Z:=widthζR_pos f; have ht:(L:ℝ)≤ y/Z:=Int.floor_le _; have hu:y/Z<(L:ℝ)+1:=Int.lt_floor_add_one _; rw [show (↑(A L):ℝ)=_ from widthζR_money f L,show (↑(A (L+1)):ℝ)=_ from widthζR_money f (L+1),Int.cast_add,Int.cast_one]; constructor
 · rw [mul_comm]; exact (le_div_iff₀ hz).mp ht
 refine ⟨?_,?_⟩; · rw [mul_comm]; exact (div_lt_iff₀ hz).mp hu
