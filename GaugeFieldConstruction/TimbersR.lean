lemma crestFloorR (j:Axis)(Y:Bool):∃ u v:ℕ→ PermWallJ P,∃ T:ℕ→ℤ,∃ Z: ℕ→ℕ, WithApR x' L (SportR P m ∘ L) T u v Z j ∧ ReflectPadR P L u (1/2) ∧ ∀ᶠ i:ℕ in atTop,if Y then StallJ P (α i)≤ StallJ P (u i) else StallJ P (u i) ≤ StallJ P (α i):=by
 let T (i:ℕ):=SportR P m (L i); let B (i):=widthζR P (T i); let A (i):=StallJ P (α i); let C (i:ℕ):=x' i j; let D i:= deltaR P (L i); let Z i:= PlethoraJ P (L i); let W i:= (C i:ℝ)-A i; let S i:= LfloorR P (W i) (T i); let g (i):ℤ:=if Y then S i else S i+1
 let g'(i):ℤ:=LfloorR P ((C i:ℝ)+A i) (T i)+1; let w (i):=(g' i-g i).toNat; let u i:= C i-P.stampPin (T i) (g i); let v i:=P.stampPin (T i) (g' i)- C i
 have ht(i:ℕ):let b:ℝ:=u i; let d:ℝ:=v i; A i<d∧ A i-B i≤ b ∧ b ≤ A i+B i ∧ if Y then A i≤b else b ≤ A i:=by
    intro b d; let c:ℝ:= C i; have hr:b = c-(P.stampPin (T i) (g i):ℝ):=rfl; have hp:d=(P.stampPin (T i) (g' i):ℝ)-c:=rfl
    let L (k:ℤ):ℝ:=P.stampPin (T i) k; have h₁:c+A i<L (g' i):=(minutesR (P:=P) (T i) (c+A i)).2.1; refine ⟨?_,?_⟩; · change c+A i < (P.stampPin _ _:ℝ) at h₁; linarith only [h₁,hp] -- L
    let E:= minutesR (P:=P) (T i) (W i); change L (S i) ≤ c-A i∧c-A i<L (S i+1)∧ L (S i+1)=L (S i)+B i at E; change b=c-L (g i) at hr; obtain ⟨h,k,e⟩:=E
    by_cases H:Y
    · rw [if_pos H]; rw [show g i=S i from if_pos H] at hr; have hx:0<B i:=widthζR_pos _; exact ⟨by linarith, by linarith,by linarith⟩
    rw [if_neg H]; rw [show g i=S i+1 from if_neg H] at hr; have hx:0<B i:=widthζR_pos _; exact ⟨by linarith,by linarith,by linarith⟩
 have hu: Tendsto (fun i=>B i/D i) atTop (𝓝 0):= (widthδR_shrinks m).comp pL
 have hv:Tendsto (fun i=>Z i/D i) atTop (𝓝 0):= (R_fit P).comp pL
 have he:Tendsto (fun i=>(A i-B i)/D i) atTop (𝓝 (1/2)):=by simp_rw [sub_div]; simpa using (Filter.Tendsto.sub tP hu) -- tune
 have he':Tendsto (fun i=>(A i+B i)/D i) atTop (𝓝 (1/2)):=by simp_rw [add_div]; simpa using (Filter.Tendsto.add tP hu)
 let a i:PermWallJ P:= if h:0<(u i:ℝ) then ⟨_,h⟩ else Sehya P
 let b i:PermWallJ P:= if h:0<(v i:ℝ) then ⟨_,h⟩ else Sehya P
 have hp:∀ᶠ i in atTop,Z i< (u i:ℝ)∧Z i<(v i:ℝ) ∧ (a i).val=u i∧ (b i).val=v i:=by
    filter_upwards[hv.eventually_lt he (by norm_num)] with i h; have hw:0<D i:=deltaR_good ..; have h:= (div_lt_div_iff_of_pos_right hw).mp h -- tune signature
    obtain ⟨s,e,H,g⟩:=ht i; have hx:=lt_of_lt_of_le h e; have hr:Z i < (v i:ℝ):= lt_trans (lt_of_lt_of_le h (sub_le_self _ (widthζR_pos _).le)) s; have hz:0<Z i:= PledgeJ P _
    exact ⟨hx,hr,by unfold a; rw[dif_pos (hz.trans hx)],by unfold b; rw[dif_pos (hz.trans hr)]⟩
 refine ⟨a,b,g,w,?_,?_ ,?_⟩
 · filter_upwards [hp] with i h; obtain ⟨h,k,l,r⟩:=h
   have hv:g i < g' i:=by
      apply lt_of_not_ge; intro x; have hx:= (minted_le P (T i) (g' i) (g i)).2 x; change Z i<(C i:ℝ)- (P.stampPin (T i) (g i):ℝ) at h; change Z i<(P.stampPin (T i) (g' i):ℝ)-(C i:ℝ) at k; linarith only [hx,h,k,(show 0<Z i from PledgeJ ..)]
   have hf:(w i:ℤ)=g' i-g i:= Int.toNat_of_nonneg (by omega)
   dsimp only; refine ⟨?_,by omega,?_,?_⟩
   · unfold BelowWallJ StallJ; rw [l,r]; exact ⟨h.le,k.le⟩
   · rw[l]; unfold u; change C i-(C i-_)=_; abel
   rw[r]; unfold v; rw [hf,show g i+(g' i-g i)=g' i by ring]; change C i+(_- C i)=_; abel
 · unfold ReflectPadR; apply tendsto_of_tendsto_of_tendsto_of_le_of_le' he he'
   · filter_upwards [hp] with i h; unfold StallJ; rw[h.2.2.1]; exact div_le_div_of_nonneg_right (ht i).2.1 (deltaR_good ..).le
   filter_upwards [hp] with i h; unfold StallJ; rw[h.2.2.1]; exact div_le_div_of_nonneg_right (ht i).2.2.1 (deltaR_good ..).le
 filter_upwards [hp] with i h; unfold StallJ; rw[h.2.2.1]; exact (ht i).2.2.2
