variable {aX bX cX dX:ScreensJ P}
lemma PaintUnitS (P:Spine)(B:Signed)(c:Bool) :PaintedS B c (CandΛJ P) (CandΛJ P) := ⟨_,_,Unitφ 0, Unitφ 0, Eventually.of_forall fun i y=>by rw [map_one, map_one]; exact (show VogueκS _ _ _ 1 1 from Festive.unit)⟩
lemma PaintAddS (s:pAy aX bX)(p':pAy cX dX): PaintedS B c (aX+cX) (bX+dX):=by
 obtain ⟨f,g,h,q,t⟩:=s; obtain ⟨F,G,h',q',t'⟩:=p'; refine ⟨_,_,h.plus 0 h', q.plus 0 q',?_⟩ -- invocation position
 filter_upwards[t,t'] with i t v y; rw [map_add,map_add]; exact VogueκS.plus (t y) (v y)
lemma PaintSmS (p:pAy aX bX)(z:ℂ): PaintedS B c (z • aX) (sailH Bc c z • bX):=by
 obtain ⟨f,g,h,q,t⟩:=p; refine ⟨_,_,VenueZ_S 0 h z, VenueZ_S 0 q (sailH Bc c z),?_⟩; filter_upwards[t] with i t y; rw[map_smul,map_smul]; exact VogueκS.times (t y) z
-- mirror gives adjoint before comp
private lemma Chart0_S (F:P.Test): P.chartAll 0 F=F:= Subtype.ext ((P.followsChart ..).trans (Vacancy.cad_zero _ _ ((marque ..).1 F.property)))
lemma MirrorOpS (u:Axis)(X Y:ScreensJ P)(p': PaintedS (Signed.mirror u) false X Y) : Y u σ τ=Star.star (X u τ σ):=by
 obtain ⟨f,g,h,e,q⟩:= p'; obtain ⟨F,hF,uF⟩:= h.1 u τ σ; obtain ⟨G,hG,uG⟩:=e.1 u σ τ
 have he:Tendsto (fun i=> Star.star (F i)) atTop (𝓝 (Star.star (X u τ σ))):=hF.star
 apply tendsto_nhds_unique_of_eventuallyEq hG he; filter_upwards [uF,uG,q] with i uF uG p
 have hp:=p 0; rw[Signed.act_zero,Chart0_S,Chart0_S] at hp; rw [MirrorTestS hp] at uG
 apply uG.same; have hz:= uF.kissed; -- tune sig
 simpa only [Pi.zero_apply,zero_add,zero_sub,neg_neg] using hz
