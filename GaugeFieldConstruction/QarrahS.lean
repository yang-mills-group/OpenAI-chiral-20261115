abbrev PaintedS (B: Signed)(c:Bool)(X Y:ScreensJ P):Prop:=∃ f g :ℕ→ P.Test, VenueX 0 X f∧VenueX 0 Y g∧∀ᶠ i in atTop,∀ y:Cover,VogueκS P (PrimeScriptR B 0) c (P.chartAll y (f i)) (P.chartAll (B⁻¹.act y) (g i))
