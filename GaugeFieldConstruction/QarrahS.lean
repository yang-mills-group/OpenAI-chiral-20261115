abbrev EnergyW_S (P:Spine)(B:Signed)(c:Bool)(S:CoinsR P) :Prop:=∀ a b:P.Test, VogueκS P (PrimeScriptR B 0) c a b → ∀ f:ℕ,S.cash f b=sailH (PrimeScriptR B 0) c (S.cash f a)
lemma BonusW_S (P:Spine)(B:Signed)(c:Bool): EnergyW_S P B c (ΔΕΡ P):= fun f g h s=> E_frame (f:=f) (g:=g) h s
lemma GlassReadS (i:Axis)(z:ℂ): sailH (PrimeScriptR (Signed.mirror i) 0) false z=Star.star z:=by unfold sailH; simp only [det_t]; rfl -- tune
lemma MirrorTestS {i:Axis}{f g:P.Test}(p:VogueκS P (PrimeScriptR (Signed.mirror i) 0) false f g):g=P.reflectTest i f:=by
 obtain ⟨A,h⟩:= f.property.paid; apply Subtype.ext; change g.val= _; exact Festive.same (s:=plane i 0) ((show (plane i 0)=PrimeScriptR (Signed.mirror i) 0 by unfold plane; rw [zero_smul]).symm ▸ (show Festive _ false f.val g.val from p)) (mirrorFest h i 0)
lemma χGlassS (i:Axis)(x:P.Spectrum0 3): EnergyW_S P (Signed.mirror i) false (SΡχ P x):=by
 intro f g h F; rw [MirrorTestS h,GlassReadS]; let y:=P.otherSpectrum 3 i x; let G:= P.reflectTest i f; change P.singleState 3 F x G= _; change _=Star.star (P.singleState 3 F x f)
 rw [←P.single_agrees 3 i x F G, ← P.single_agrees 3 i x F f] -- tune
 exact (congrArg (P.chi i y) (P.reading_star i F f).symm).trans (map_star ..) -- tune projection
lemma PaintedS.mem1 {a b:ScreensJ P}(s:PaintedS B c a b) : VenueY 0 a ∧ VenueY 0 b:=by obtain ⟨f,g,h,p,q⟩:=s; exact ⟨⟨_,h⟩,_,p⟩
lemma SpunLaunchS (S:DialsBJ P θ)(V:AxonsJ p B0 M A S D) (L:finsJ) (v:FrameK (Fin (θ u))) : PaintedS B c (MeshΦ p B0 M 0 R u pu A (S 0 R u) D (V.go ..) s0 v) (MeshΦ p B0 M 0 (GripR R B c) u pu A (S 0 (GripR R B c) u) D (V.go ..) s0 (pHu v)):=by
 let w:=pHu v; refine ⟨_,_, ΘVenue_S p B0 M 0 R u pu A (S 0 R u) D (V.go ..) s0 v L, ΘVenue_S _ _ _ _ _ _ _ _ _ _ _ _ _ L,?_⟩
 filter_upwards [eventually_ge_atTop s] with i e z; simp only [dif_pos e]; exact EpochLaunchS p B0 M R u L A D s0 B c S V v e z
