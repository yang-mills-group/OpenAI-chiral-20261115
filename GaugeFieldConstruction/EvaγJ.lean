 let T:= F.earth (W.trans a) b
 have u:= tilePCR Y i k T.U T.V T.Toll T.sign P_ (p.σ (s+1)) (V.Br s) (V.Roll (s+1)) (p.tour s) (p.grade (s+1)) d (p.birth s) (g0.unique a b) (p.Pp s) (F.cod s) (g0.voyage a b) ?z (p.paper s) ?hp (F.broom (W.trans a) b).1 (F.broom (W.trans a) b).2 F.vn -- tune position/metavar
