lemma DotVacR (X:P.Slabs i)(a b:ℝ) : DotM_R P i (HeatTaxJ P i a b X)=(P.Eucl i a.toNNReal).val (DotM_R P i X):=by
 let Q:=P.publicH i; change (P.Eucl i _).val (X.val ((P.Eucl i _).val (P.floorVec i)))= _; rw [show (P.Eucl i b.toNNReal).val (P.floorVec i)= _ from (Q.still _) ]; rfl -- maybe RHS unspecified
lemma MonotLeg (X:ScreensJ P)(p:Fuel_J P X) (Z T:PermWallJ P)(a:StallJ P σ≤StallJ P Z): ‖DotM_R P i (X i Z T)‖≤ ‖DotM_R P i (X i σ τ)‖:=by
 let Ω(s t:PermWallJ P):= DotM_R P i (X i s t); suffices ∀ σ τ T:PermWallJ P, Ω σ τ=Ω σ T by
    rw [show DotM_R P i (X i Z T) =Ω Z τ from this Z T τ]; unfold Ω; rw [p i σ τ _ _ a le_rfl,DotVacR]; -- norm bound
    let A:=P.Eucl i (StallJ P Z-StallJ P σ).toNNReal; exact (A.val.le_opNorm (DotM_R P i (X i σ τ))).trans ((mul_le_mul_of_nonneg_right (P.heat_norm i _) (norm_nonneg _)).trans_eq (one_mul ..))
 have h(s t v:PermWallJ P)(q:StallJ P t ≤ StallJ P v): Ω s v=Ω s t:=by
    unfold Ω; rw[p i s t s v le_rfl q,DotVacR,sub_self,Real.toNNReal_zero]; exact show (P.publicH i).Time.E 0 (DotM_R P i (X i s t))=_ from DFunLike.congr_fun ((P.publicH i).Time.eZero) _
 intro A Q B; rcases le_total (StallJ P Q) (StallJ P B) with i|i
 · exact (h A Q B i).symm
 exact h A B Q i
