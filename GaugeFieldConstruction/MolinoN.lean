abbrev Seen1N (x:Vantage):ℂ:= SπR ΞΧ.porch (![X]) (![x]: Fin 1 → Axis→ℝ)
abbrev Seen2N (x y:Vantage):ℂ:= SπR ΞΧ.porch (![X,Y]) (![x,y]:Fin 2→Axis→ℝ)
abbrev Pose1N := ∫ x, SpokenN ΞΧ (![X]) (Terra1N rC) x
abbrev Pose2N := ∫ x, SpokenN ΞΧ (![X,Y]) (Terra2N rC rD) x
lemma levyT1N : Function.support (Terra1N rC) ⊆ Probes1N (tsupport rC.val):=fun x p=> subset_closure (show rC.val _≠0 from fun h=> p ((congrArg (fun x:ℝ=>(x:ℂ)) h).trans Complex.ofReal_zero))
lemma levyT2N : Function.support (Terra2N rC rD) ⊆ Probes2N (tsupport rC.val) (tsupport rD.val):=by
 intro x h; change (Terra2N rC rD x)≠0 at h -- tune
 unfold Terra2N at h; rw [Complex.ofReal_mul] at h; rw [mul_ne_zero_iff] at h; exact ⟨subset_closure (show rC.val _≠0 from fun e=>h.1 ((congrArg (fun x:ℝ=>(x:ℂ)) e).trans Complex.ofReal_zero)),subset_closure (show rD.val _≠0 from fun e=>h.2 ((congrArg (fun x:ℝ=>(x:ℂ)) e).trans Complex.ofReal_zero))⟩
lemma αKΤ1N: Continuous (Terra1N rC):=by have he:= rC.smooth.continuous; unfold Terra1N VantageN; fun_prop
lemma αKΤ2N: Continuous (Terra2N rC rD):=by have he:=rC.smooth.continuous; have ht:=rD.smooth.continuous; unfold Terra2N VantageN; fun_prop
lemma Mask1_S_N (x: DiagramR (Fin 1)): x∈ MasksR (Fin 1):=fun i a b u=> Subsingleton.elim ..
lemma Loot1_S_N (x: DiagramR (Fin 1))(j:Axis)(σ: Fin 1→PermWallJ P): x∈OpenR j σ jNOne:=by
 refine List.pairwise_singleton _ _ -- tune
lemma HappeningL1N (c:VenueX 0 X uF): Tendsto (fun t=> ΞΧ.cash t (installedN uF rC t)) atTop (𝓝 (Pose1N rC ΞΧ X)):=by
 simp_rw [←moneyL1N]; exact SmoothedN ΞΧ _ _ _ (deckΦP _) (fun i=>by fin_cases i; exact c) _ _ 3 (fun _=>AutoPadR P 0) _ (levyT1N rC) (αKΤ1N rC) (fun _ _=>Loot1_S_N ..) (fun _ _=>Mask1_S_N _)
abbrev Pointers2N (x y:Vantage):DiagramR (Fin 2):= ![x,y]
abbrev Pulse1N (x:Vantage):DiagramR (Fin 1):= ![x]
lemma FlitPlot1N (x:MeshN (Fin 1))(t:ℕ): PoseΝ P t (TownN x)= Pulse1N (P.meshPose t (TownN x 0)):=funext fun i=>by fin_cases i; rfl
lemma Fold1N (x:SpaceN (Fin 1)):VantageN x= ![VantageN x 0]:= funext fun i=> by fin_cases i; rfl
lemma Fold2N (x:SpaceN (Fin 2)):VantageN x= Pointers2N (VantageN x 0) (VantageN x 1):=funext fun i=> by fin_cases i <;> rfl
abbrev ScopeL2N (A B:Set Vantage)(σ: Fin 2→ PermWallJ P):Prop:=∀ x∈ A,∀ y∈ B,Pointers2N x y∈MasksR (Fin 2) ∩ OpenR 3 σ jNDuo
lemma HappeningL2N (c:VenueX 0 X uF)(d:VenueX 0 Y uG)(σ: Fin 2 → PermWallJ P)(h:ScopeL2N (tsupport rC.val) (tsupport rD.val) σ): Tendsto (fun t=> ΞΧ.cash t (installedN uF rC t* installedN uG rD t)) atTop (𝓝 (Pose2N rC rD ΞΧ X Y)):=by
 have hf(i): VenueX 0 ((![X,Y]:Fin 2→ ScreensJ P) i) ((![uF,uG]: Fin 2→ℕ→ P.Test) i):=by fin_cases i; exact c; exact d
 have ht(x:SpaceN (Fin 2))(v:x∈Probes2N (tsupport rC.val) (tsupport rD.val)):VantageN x∈MasksR (Fin 2)∩OpenR 3 σ jNDuo:=by rw [Fold2N x]; exact h _ v.1 _ v.2
 simp_rw [←moneyL2N]; exact SmoothedN ΞΧ _ _ _ (deckΦP _) hf _ _ 3 σ _ (levyT2N rC rD) (αKΤ2N rC rD) (fun x v=>(ht x v).2) (fun x v=>(ht x v).1)
