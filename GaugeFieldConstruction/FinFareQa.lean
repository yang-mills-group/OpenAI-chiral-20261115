noncomputable def ΓNickQa(P:Spine): NickleQc where
   e i:=rangePQ P i
   positive:=RangePosQ P
   small:= by simpa only [one_pow,mul_one] using RangeLateQ P 1 zero_le_one (lowULQ P)
lemma DropQa {b:ℝ}(p:b+1 < 0): Tendsto (fun i:ℕ=>((ΓNickQa P).e i)⁻¹ * βgZQ P b i) atTop (𝓝 0):=by
 let A':= βgZQ P; have h:Tendsto (fun i=>2*A' (b+1) i) atTop (𝓝 0):=by
    let L:=P.par.R.L; have p:Tendsto (A' (b+1)) atTop (𝓝 0):=tendsto_pow_atTop_nhds_zero_of_lt_one (Real.rpow_nonneg (Nat.cast_nonneg _) _) ((Real.rpow_lt_one_of_one_lt_of_neg (lowULQ P) p)) -- tune
    simpa only [mul_zero] using p.const_mul 2
 refine squeeze_zero_norm' (Eventually.of_forall (fun i=>?_)) h
 let r:= (ΓNickQa P).e i; rw[Real.norm_of_nonneg (mul_nonneg (inv_nonneg.mpr ((ΓNickQa P).positive i).le) (RailWQ ..).le)]
 have he:LαK P.par.R.L 1=(P.par.R.L.val:ℝ):=Real.rpow_one _
 change _ ≤ 2 * βgZQ P _ _; rw[PlusWQ,mul_comm (βgZQ P b i), ←mul_assoc]; refine mul_le_mul_of_nonneg_right ?_ (RailWQ ..).le; change r⁻¹ ≤ 2*(βgZQ P 1 i); rw[βgZQ,he]; let L' :ℝ:= P.par.R.L.val; have hp:0<2*L'^i:= mul_pos zero_lt_two (pow_pos (zero_lt_one.trans (lowULQ P)) _); exact (inv_le_comm₀ (RangePosQ P i) hp).2 (by simpa only[one_div] using RangeLowQ P i) -- tune
lemma AscendQa (m:ℕ){b:ℝ}(u:0 < m)(p:b < (m:ℝ)): Tendsto (fun i=> ((ΓNickQa P).e i)^m* βgZQ P b i) atTop (𝓝 0):=by
 let L':= LαK P.par.R.L; have he:0<(m:ℝ):=by exact_mod_cast u
 have hw:b/(m:ℝ)<1:= (div_lt_one he).2 p
 have hp:0≤ L' (b/m):=Real.rpow_nonneg (Nat.cast_nonneg _) _; have ht:L' (b/m)<(P.par.R.L.val:ℝ):=lt_of_lt_of_eq (Real.rpow_lt_rpow_of_exponent_lt (lowULQ P) hw) (Real.rpow_one _)
 have h:=(RangeLateQ P _ hp ht).pow m; rw [zero_pow u.ne'] at h; refine h.congr fun i=>?_; rw [mul_pow]; congr 1; unfold L' βgZQ LαK; rw [←pow_mul,pow_mul',← Real.rpow_mul_natCast (by positivity), div_mul_cancel₀ b he.ne']
#check Real.rpow_lt_one
#check Real.rpow_lt_one_of_one_lt_of_neg
#check Real.rpow_natCast_mul
#check Real.rpow_mul_natCast
#check inv_le_comm₀
#print axioms DropQa
