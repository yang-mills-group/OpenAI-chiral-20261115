 refine ⟨hQ.trans hk0, ?_,he⟩
 refine le_trans ((L y).trans (mul_le_mul_of_nonneg_left pΚ (mul_nonneg h₀ (pow_nonneg (zero_le_one.trans T0) _)))) (le_trans ?_ hk0)
 unfold Effortχ Buχ; have ha:0≤ Q^s:=zero_le_one.trans hpQ
 rw [add_zero,show RankQJ P.par f0 * Tδ^(γχ) * r₀=kV*r₀*Tδ^s from (by unfold kV s; ring)]
 exact mul_le_mul (mul_le_mul_of_nonneg_right (le_add_of_nonneg_left (mul_nonneg (by norm_num) hK)) hs) (pow_le_pow_left₀ (zero_le_one.trans T0) T1 _) (pow_nonneg (zero_le_one.trans T0) _) (mul_nonneg (add_nonneg (mul_nonneg (by norm_num) hK) h₀) hs)
