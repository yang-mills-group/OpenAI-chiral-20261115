lemma HoldTariffJ : LoomK (SailGateJ p w h B0 M Ω x R u y)*RankQJ P.par (P.run.uv k) ≤ Effortχ P f0 f r₀ 0 u (P.run.uv k) ∧ (2*RankQJ P.par f+RankQJ P.par (P.run.uv k))*LoomK (SailGateJ p w h B0 M Ω x R u y) ≤ Effortχ P f0 f r₀ A u (P.run.uv k) ∧ ‖SailSubsidyJ p w h B0 M Ω x R u y‖ ≤ Effortχ P f0 f r₀ A u (P.run.uv k) ∧ Effortχ P f0 f r₀ 0 u (P.run.uv k) + A ≤ Effortχ P f0 f r₀ A u (P.run.uv k) :=by
 obtain ⟨p0,v,P1,q',T0,H,T1,H'⟩:= LoadΧJ (f:=f) p w u q₀ -- tune p not include earlier
 let X':=LoomK (SailGateJ p w h B0 M Ω x R u y); let Q:= SThermosΩ P u; let s:=P.run.uv k
 obtain ⟨_,hp,L,e⟩:= sailorVJ p w h B0 M Ω x R u
 let kV:=RankQJ P.par f0; let kh:=RankQJ P.par f; have h₀:0≤ kV:=p0.le; have hK:0≤ kh:=v.le
 have hpQ:1 ≤Q^s:=one_le_pow₀ q'
 have hvS:0≤ Sδ^s:=pow_nonneg (zero_le_one.trans H) s
 have hs:0≤ r₀:=(noLoom _).trans pΚ; have hx₂:A ≤ A*Q^s:=le_mul_of_one_le_right hA hpQ; let F:=Buχ P f0 f r₀ 0
 have he: F*Q^s + A ≤ Buχ P f0 f r₀ A*Q^s:=by unfold F Buχ; change ( (2*kh + kV)*r₀+0)*Q^s+A≤((2*kh+kV)*r₀+A)*Q^s; nlinarith only [hx₂]
 have hk0: Χθ r₀ 0 u s ≤ Χθ r₀ A u s:= (le_add_of_nonneg_right hA).trans he
 have hQ: (2*RankQJ P.par f+RankQJ P.par s)*X' ≤ F*Q^s:=by
    have hr: X' ≤ Sδ^s*r₀:= (hp y).trans (mul_le_mul_of_nonneg_left pΚ hvS)
    have ht:2*kh + RankQJ P.par s≤ (2*kh+kV)*2^s:=by rw [add_mul]; exact add_le_add (le_mul_of_one_le_right (by positivity) (one_le_pow₀ (by norm_num))) e
    let V:=(2*kh+kV)*2^s; refine (mul_le_mul ht hr (noLoom _) (by positivity)).trans ?_; unfold F Buχ; rw [show (2*RankQJ P.par f+kV)*2^s * (Sδ^s*r₀) = ((2*kh+kV)*r₀+0)*(2*Sδ)^s from (by unfold kh; rw [mul_pow]; ring)]; exact mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (mul_nonneg (by norm_num) (zero_le_one.trans H)) H' s) (by unfold kV kh at *; positivity)
 constructor
