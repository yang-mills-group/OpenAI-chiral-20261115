 intro y; have hx:y∈S:= ΩLambVU g S t _ z; exact ⟨hx,(c _ hx).mono fun i u=> zeroWrapVU u (spinRise3ALUV g (f i) (h i) (q i) (fun b x=> p b x i) x)⟩
