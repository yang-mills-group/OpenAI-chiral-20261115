lemma spinRise3ALUV (g:JetVU→Module.End ℂ V)(f:V→Waves)(h:∀ x y,f (x+y)=f x+f y)(q:∀ x y,f (x-y)=f x-f y)(p:∀ b x,f (g b x)= pressA b.val false (f x))(x:V): f (FeatGaugeVU g x)= CarryΓVU (f x):=by
 have hv(b:JetVU)(x:V): f (g b x)=ProperWaitVU b (f x):=p b x
 -- cost avoiding simp expand. abstract f_le
 unfold CarryΓVU
 exact (show ∀ {Y:Type}[AddCommGroup Y][Module ℂ Y](F:JetVU→Module.End ℂ Y)(f:V→Y), (∀ x y,f (x+y)=f x+f y)→(∀ x y,f (x-y)=f x-f y)→(∀ b x,f (g b x)=F b (f x))→ f (FeatGaugeVU g x)= FeatGaugeVU F (f x) from (by intros T d S G f h q p; unfold FeatGaugeVU; simp only [Module.End.mul_apply,LinearMap.sub_apply,LinearMap.add_apply,Module.End.one_apply,h,q,p])) ProperWaitVU f h q hv
lemma spinRise4ALUV (g:JetVU→Module.End ℂ AΦW)(p:∀ b x i,((g b x).2 i).2=(x.2 i).2) (x:AΦW)(i:ℕ): (((FeatGaugeVU g x).2 i).2)=0:=by
 let W:AΦW→ₗ[ℂ]ℂ:= (LinearMap.snd ..).comp ((LinearMap.proj i).comp (LinearMap.snd ..)); exact (MeetFeatVU g (fun _=>1) W (fun b y=>p b y i) x).trans (NilStudyVU _)
end
private lemma prospectVU(x:Waves)(p:ΓProj 1 (CarryΓVU x)=CarryΓVU x) : Genre.gauge.Room (CarryΓVU x):=by
 let W:= CarryΓVU x
 have h:=LiveG3VU x; have h1:= LiveG4VU x
 have h2: (CarryΓVU x).2.2=0:= (congrArg (fun x:Waves=>x.2.2) p).symm
 refine ⟨Prod.ext (Subtype.ext_iff.mp h) (Prod.ext ?_ ?_),?_⟩
 · exact Subtype.ext_iff.mp h1
 · -- L pair Sym
   exact Subtype.ext (congrArg (fun v=>v.val) (show bV2 (CarryΓVU x)=0 from congrArg (fun k:J5=>k.2.1) h2))
 exact congrArg Subtype.val (show bm5 (CarryΓVU x)=0 from congrArg (fun k:J5=>k.2.2) h2)
private lemma zeroWrapVU {x y:Waves}(q:ΓProj 1 y=y)(h:y= CarryΓVU x): Genre.gauge.Room y:=by rw [h] at q ⊢; exact prospectVU _ q
private lemma PelexVU {x: Waves}(p: Genre.gauge.Room x) (c:ℂ): Genre.gauge.Room (c• x):=by
 obtain ⟨u,v⟩:=p
 change chartF _=_ ∧ _; constructor
 · apply Prod.ext
   · change c • _ = (0:Tap.Pal)
     have h0:=congrArg Prod.fst u; rw [show (bV0 x).val=0 from h0,smul_zero]
   apply Prod.ext
   · apply ContinuousLinearMap.ext; intro i; change c • ((bV1 x).val i)= (0:Tap.Pal); rw[show ((bV1 x).val i)=(0:Tap.Pal) from congrArg (fun k: PalOne=> k.2.1 i) u,smul_zero] -- tune
   apply Subtype.ext; apply ContinuousLinearMap.ext; intro i; apply ContinuousLinearMap.ext; intro j; change c • ((bV2 x).val i j)= (0:Tap.Pal); rw [show ((bV2 x).val i j)=(0:Tap.Pal) from congrArg (fun k:PalOne=>k.2.2.val i j) u,smul_zero]
 apply ContinuousLinearMap.ext; intro i; change c • ((bm5 x).val i)= _; rw [v]; exact smul_zero _ -- tune
