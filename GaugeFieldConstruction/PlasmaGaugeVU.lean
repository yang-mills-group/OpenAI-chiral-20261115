lemma VitalSGaugeVU (S:Submodule ℂ V)(g:JetVU→Module.End ℂ V)(t:∀ b x, x∈ S→ g b x∈ S) (z:ℕ→V→ₗ[ℂ]ℂ)(k:∀ b x i,z i (g b x)=z i x)(f:ℕ→V→Waves)(fH:∀ i x y,f i (x+y)=f i x+f i y)(fQ:∀ i x y,f i (x-y)=f i x-f i y)(rH:∀ i c x,f i (c • x)= (c:ℂ) • f i x)(fP:∀ b x i,f i (g b x)= pressA b.val false (f i x))(c:∀ x∈ S,∀ᶠ i in atTop, ΓProj 1 (f i x)= f i x) (h:V→ₗ[ℂ] W)(G: JetVU→Module.End ℂ W)(u:∀ b x,h (g b x)= G b (h x))(T:UV four→ₗ[ℂ] W)(p:∀ b:JetVU, ∀ x, T (spinFrame four b.val x)= G b (T x))(x:V)(q:h x=T ΩPureVU)(v:x∈S):∃ y∈S,h y=T ΩPureVU∧(∀ i,z i y=0)∧∀ᶠ i in atTop, Genre.gauge.Room (f i y):=by
 let K:= (64:ℂ)⁻¹; have hK:(64:ℂ)≠0:=by norm_num
 let L:= FeatGaugeVU g x
 obtain ⟨hc,vc⟩:= semblantVU S f fH fQ g fP c t x v
 refine ⟨K • L,S.smul_mem K hc,?_ ,fun i=>?_,?_⟩
 · unfold L; rw [map_smul,firmNoiseVU g x h G u T p q]; exact inv_smul_smul₀ hK _
 · rw [map_smul,show z i L=0 from (MeetFeatVU g (fun _=>1) (z i) (fun b x=>k b x i) x).trans (NilStudyVU _),smul_zero]
 filter_upwards[vc] with i u'; rw [rH]; exact PelexVU u' K
#print axioms VitalSGaugeVU
end
