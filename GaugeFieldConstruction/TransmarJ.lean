 have hV: SevJ P f (n+1) i x (Y∘V):=fun a b h=>sat _ _ (V.injective.ne h)
 let W':=PoiPriceJ p w h B0 M Ω x R u L y Hv κ q₀ e (Y ∘ V) hV rK Q q' Sκ b hb pY pK (D∘V) K (by simp[K]) (hx.symm ▸ ledgerX (n+1)) (fun i v=> pD _ (p0 ▸ List.mem_map_of_mem v)) -- tune order
 rw [←List.map_map,show K.map _= _ from p0,comp_apply,H] at W'; exact W'
