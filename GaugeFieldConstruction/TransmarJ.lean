lemma paradeΛJ (l: List (Fin (n+1)))(w:Fin (n+1))(d:l.length=n)(q:(l++[w]).Nodup): let K:= (List.finRange n).map Fin.castSucc;∃ P:Equiv.Perm (Fin (n+1)), (K.map P=l) ∧ P (Fin.last n)=w:=by
 intro K; let V:= l++[w]; have he:V.length=n+1:=by simp[V,d]
 let T:Fin (n+1)→ Fin (n+1):= fun i=> V.get (Fin.cast he.symm i); have hx:T (Fin.last n)=w:=by unfold T; rw [List.get_eq_getElem]; apply List.getElem_of_append rfl; exact d
 have hp:Injective T:=fun x y p=> by have h:=q.get_inj_iff.mp (show V.get _= _ from p); exact Fin.cast_injective _ h
 let P:= Equiv.ofBijective T (Finite.injective_iff_bijective.mp hp)
 have hk: K ++ [Fin.last n]=List.finRange (n+1):= List.finRange_succ_last.symm -- tune cast
 refine ⟨P,?_,hx⟩
 change K.map T=l; apply List.append_cancel_right (bs:= [w]); rw [show K.map T++[w]=(K++[Fin.last n]).map T from (by rw [List.map_append,List.map_singleton,hx]),hk]; exact weaveN_J (n+1) _ V he -- tune names
