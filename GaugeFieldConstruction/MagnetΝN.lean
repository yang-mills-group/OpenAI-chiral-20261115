lemma ΡIFaceN (x:FrameK (Fin (θ (ΤbandR three)))):ΓProj 0 (LiPaJ B0 R _ x)=LiPaJ B0 R _ x:=by
 let u:=ΤbandR three; let F:=ThreadΨ B0 u R; change ΓProj 0 (∑ i,x i • F i)=_; rw [map_sum]; have h:=Tsava p B0 M R u pu; exact sum_congr rfl (fun i _=>by rw [map_smul,h.saturated,if_pos (h.ray i)])
omit p pu
lemma ΔᵥN {I:Type} [DecidableEq I](V:I→ScreensJ P)(F:I→ℕ→P.Test)(X:Finset I)(v:∀ i∈X,VenueX x (V i) (F i)) : VenueX x (∑ i∈X,V i) (fun r=>∑ i∈X,F i r):=by
 induction X using Finset.induction_on with
 | empty=> simp only [sum_empty]; simpa only [zero_smul] using VenueZ_S x (Unitφ x) 0
 | @insert i X w ih=>simp only [sum_insert w]; exact VenueX.plus x (v i (mem_insert_self ..)) (ih (fun i p=>v i (mem_insert_of_mem p)))
lemma cartuN (i:Matter.FlavorIndex)(V:Waves)(Z:i.2.1≠i.2.2)(x:Cover) (s:ℕ): (D.M s x (charterWavesN i V)).val∈ BraveryN x i P.calibration:=by
 let F:= charterWavesN i V
 let L:Submodule ℂ P.Test:=(BraveryN x i P.calibration).comap (screenHall P.calibration).val.toLinearMap
 have he: Submodule.span ℂ {g:P.Test|g.val∈_root_.Set.range fun n:ℕ=> P.Araw s x n F} ≤ L:=by
    refine Submodule.span_le.mpr ?_; rintro X ⟨n,v⟩; change X.val∈BraveryN x i P.calibration; rw[←v]; exact DebtCardN _ _ _ Z V (zero_lt_one.trans_le P.par.height) (P.billStamp s).2 (P.billStamp s).1 _
 exact he (Heritor.estabN P D s x F)
