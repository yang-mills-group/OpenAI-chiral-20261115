lemma tendFundsN (iΦ: Matter.FlavorIndex) (F:↥CompassN→ℕ→P.Test)(X: ScreensJ P)(v:∀ i:χK,VenueX x (βChiN i iΦ • X) (F i)) : VenueX x X (fun r=>(Fintype.card χK:ℂ)⁻¹ •∑ i:χK,(βChiN i iΦ) • F i r):=by
 let E(g:χK):ℕ→P.Test:=fun r=>βChiN g iΦ • F g r
 have hp : ∀ i∈(Finset.univ:Finset χK),VenueX x X (E i):=by
     intro i w
     have h:= VenueZ_S x (v i) (βChiN i iΦ); rw [smul_smul,peN,one_smul] at h; exact h
 let c:=Fintype.card χK; have hc:(c:ℂ)≠0:= Nat.cast_ne_zero.mpr Fintype.card_pos.ne'
 have h:= VenueZ_S x (ΔᵥN x (fun _=>X) E Finset.univ hp) (c:ℂ)⁻¹; rw [sum_const,card_univ,← Nat.cast_smul_eq_nsmul ℂ, inv_smul_smul₀ hc] at h; exact h
lemma budgetWordsN (i:Matter.FlavorIndex) (w:i.2.1≠i.2.2)(D1:Waves→ₗ[ℂ]P.Test)(V:Waves)(Z U:P.Test)(X:χK→P.Test)(h:∀ g:χK,X g=D1 (SpinFe (chipUFe g.val) V) - Z + U) : (Fintype.card χK:ℂ)⁻¹ • (∑ g:χK, βChiN g i • X g)= D1 (charterWavesN i V):=by
 unfold charterWavesN; rw[map_smul,map_sum]; apply congrArg
 simp_rw[h,smul_add,smul_sub,sum_add_distrib,sum_sub_distrib]; rw[←sum_smul,←sum_smul,vaneN _ w,zero_smul,zero_smul,add_zero,sub_zero]; exact Finset.sum_congr rfl fun _ _=> (map_smul ..).symm
