lemma ΔChartN (i:Matter.FlavorIndex)(U:Waves)(e:ΓProj 0 U=U): ΓProj 0 (charterWavesN i U)= charterWavesN i U:=by
 unfold charterWavesN; rw [map_smul,map_sum]; apply congrArg; exact Finset.sum_congr rfl fun i' _=> by rw [map_smul,Spin_gateFe,e]
