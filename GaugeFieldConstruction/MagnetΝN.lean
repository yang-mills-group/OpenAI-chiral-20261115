lemma ΔRevenueN (Z: iΦ.2.1≠iΦ.2.2)(iE: ∀ g:χK, TribeFe p B0 M x pu A D g.val Sq Wp three X=βChiN g iΦ • X) : ∃ M0:ℕ→P.Test, VenueX x X.val M0 ∧∀ᶠ s in atTop, ∃ V:Waves, ΓProj 0 V=V∧ M0 s=D.M s (P.adventJ x s) (charterWavesN iΦ V):=by
 let u:=ΤbandR three; let R:Signed × Bool:=(1,false); let T:=Sq x R u; let Qv:=Wp.go x R u; let L:= ΔWallP p B0 M x R u pu A T D Qv (s:=f0) le_rfl -- tune
 obtain ⟨⟨i,z⟩,h⟩:= show X.val∈LinearMap.range L from X.property
 choose F C F0 FL using fun g:χK=> PanEliteFe p B0 M R u pu g.val
 let Gi(g:χK):ℕ→P.Test:=fun r=> FlaminaFe (s:=f0) B0 x R u T D i 0 (F g) r + z • 1
 let W(g:χK):=βChiN g iΦ
 have he(g:χK): VenueX x (W g • X.val) (Gi g):=by
    have H0:= GripPactFe p B0 M x R pu A D _ Q t u' H g.val Sq Wp three i JΩ (C g) υ 0 (F g) ⟨F0 g,FL g⟩ z X h.symm; rw[iE g] at H0; exact H0
 let Qc(r:ℕ): P.Test:=(Fintype.card χK:ℂ)⁻¹ •∑ g:χK,W g • Gi g r
 refine ⟨Qc,tendFundsN x iΦ Gi X.val he,?_⟩
 filter_upwards [eventually_ge_atTop f0] with s e
 let U:= wΔFe u T i 0 e; let x':=P.adventJ x s; let f:ℂ:=↑(RankQJ P.par s); let V:= f • LiPaJ B0 R u U
 let q:P.Test:=(εΔFe u T i 0 e) • 1; refine ⟨V, by unfold V; rw [map_smul,ΡIFaceN p B0 M R pu U],?_⟩ -- tune u definitional
 have ht(g:χK): Gi g s=D.M s x' (SpinFe (chipUFe g.val) V) - q+ z • 1:=by
    unfold Gi FlaminaFe; rw [dif_pos e, PaletteQ]; unfold V; rw [Spin_qFe]; change D.M s x' (f • LiPaJ B0 R u (F g U)) - q + z • 1= _; rw [(FL g U).1]
 exact budgetWordsN iΦ Z _ _ _ _ _ ht
