private lemma distribute_X (A:Buffered.Family (tent Y P')): Tapestry.exhibit Y P' s i A= distribute Y P' s i A:= arranged ..
#check reserved
-- switch along all capacious pairs. no weakening selected.
lemma onLoanJ (r:ℕ)(S:Finset Cover): ∀ᶠ i:ℕ in atTop,∀ k:ℕ,(Y.voyage i).kick≤ k → ∀ h:s+r≤Y.uv k,∀ A:Buffered.Family (tent Y P'), InTest (tent Y P') true S false A→ Tapestry.exhibit Y P' (s+r) i (Tower.train Y P' s r i k S A)= convoy Y i k (show s ≤ s+r from by omega) (Tapestry.exhibit Y P' s i A):=by
 induction r with
 | zero=>exact Eventually.of_forall fun i k _ _ A e=>by change _=convoy (v:=s) _ _ _ _ _; rw [convoy,climbing_refl]; rfl -- tune
 | succ r ih=>
    let B_:= volumeAround P ℓ r S; filter_upwards [ih, turning Y P' (s+r+1) (wingspan P ℓ B_)] with i q u k p g A a
    specialize q k p (show s+r ≤ Y.uv k from by omega) A a
    let X:=Tower.train Y P' s r i k S A; have he:= prepared_train Y P' s S r i k a; have hv:legalAt Y (s+r) i k:= ⟨p,by omega⟩
    rw [convoy]; change Tapestry.exhibit Y P' (s+r+1) i (Tower.block Y P' (s+r) i k B_ X)= climbing (X:=fun t=>Mark (side Y i t)) (fun i' => ascender Y i' i k) (show s ≤ s+r+1 from by omega) _ -- defeq tune
    unfold convoy at q; rw [climbing_succ _ _ (show s≤ s+r from by omega),←q, distribute_X, distribute_X Y _ _ P' X] -- arg order
    exact reserved Y P' (s+r) B_ i k hv he u
#print axioms onLoanJ
lemma CoveLap {f:ℕ}(a:f ≤ s)(b:s ≤ r)(A:Mark (side Y i f)):convoy (v:=r) Y i k (a.trans b) A=convoy (v:=r) Y i k b (convoy Y i k a A):=by
 induction b with
 | refl=> simp only [convoy,climbing_refl]
 | step y ih=> simp_rw [convoy,climbing_succ _ _ (a.trans y),climbing_succ _ _ y]; exact congrArg (ascender Y _ _ _) ih
lemma convoyCut {F G:Mark (side Y i s)}(u:AtSupport false univ F)(v:AtSupport false univ G)(b:s ≤ r)(d:r ≤ Y.uv k) (h':(Y.voyage i).kick ≤ k): convoy Y i k b (F-G)=convoy Y i k b F-convoy Y i k b G:=by
 rw[sub_eq_add_neg, sub_eq_add_neg, ←neg_one_smul ℂ G,←neg_one_smul ℂ (convoy Y i k b G)]; exact (convoy_add Y i k h' u (v.smulM (-1)) b d).trans (congrArg _ (convoy_scale Y i k h' v (-1) b d))
