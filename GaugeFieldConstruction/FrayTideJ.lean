lemma AbideT_J {m:ℕ}(a:f≤ s)(x:X)(c:s ≤ m)(p:m ≤ Y.uv k): AtSupport false (F m x) (convoy (v:=m) Y i k c (A x)):=by
 have he(s:ℕ): Tiling Y i F {x} s=F s x:=by unfold Tiling; rw [singleton_biUnion]
 rw[←he]; apply courier Y i k h F {x} (plaza Y i k F u a) (A x) _ c p; rw [he]; exact e x
#check Montana
lemma HeldCrew (l:List X): AtSupport false (Tiling Y i F l.toFinset s) (l.map A).prod:=by
 induction l with
 | nil=>exact AtSupport.oneM _
 | cons v l ih=> rw[List.map_cons,List.prod_cons]; exact ((e v).mono (fun i p=>mem_biUnion.mpr ⟨v,by simp,p⟩)).mulM (ih.mono (fun i a=>by obtain ⟨v,t,q⟩:=mem_biUnion.mp a; exact mem_biUnion.mpr ⟨v,List.mem_toFinset.mpr (List.mem_cons_of_mem _ (List.mem_toFinset.mp t)),q⟩)) -- tune
include a
lemma ConvPack(l:List X)(p:l.Nodup){r:ℕ}(c:s ≤ r)(p0:r ≤ Y.uv k): convoy (v:=r) Y i k c ((l.map A).prod)= (l.map fun x=>convoy (v:=r) Y i k c (A x)).prod:=by
 induction l with
 | nil=> exact convoy_one Y i k h c p0
 | cons x l ih=>
    rw [List.map_cons,List.prod_cons,List.map_cons,List.prod_cons,← ih (List.nodup_cons.mp p).2]; have he: Tiling Y i F {x} s=F s x:=by unfold Tiling; rw [singleton_biUnion]; -- macro
    exact turnU Y i k h F {x} (plaza Y i k F u a) (A x) (he.symm ▸ e x) c p0 l.toFinset (l.map A).prod (by simpa using (List.nodup_cons.mp p).1) (HeldCrew Y i k s f F u A e h l)
omit u a e
lemma CoveChill {v':Mark (side Y i s)}(p:AtSupport false univ v'){r:ℕ}(ht:s ≤ r)(g:r ≤ Y.uv k): Journey.compass Y i k s v'=Journey.compass Y i k r (convoy Y i k ht v'):=by
 induction ht with
 | refl=> rw [convoy,climbing_refl]
 | step p0 ih=> rw [convoy,climbing_succ _ _ p0]; exact (ih (by omega)).trans (partake Y _ i k ⟨h,g⟩ (convoy_all Y i k h p0 (by omega) p))
include e u a
lemma CoastPack(l:List X)(p:l.Nodup)(g:s ≤ Y.uv k): Journey.compass Y i k s ((l.map A).prod)= Cap_ZΛ Y i k ((l.map fun x=>convoy (v:=Y.uv k) Y i k g (A x)).prod):= by
 rw [← ConvPack Y i k s f F u A e h a _ p g le_rfl]; exact CoveChill Y i k s h ((HeldCrew Y i k s f F u A e h l).mono (subset_univ _)) g le_rfl
#print axioms CoastPack
