lemma EarnΓ_N :∀ᶠ s in atTop,∃ (x y:Vantage), (∀ i:Axis, x i < y i)∧ Pointers2N x y∈ MasksR (Fin 2) ∧ ∃ (σ:Fin 2→PermWallJ P)(δ:ℝ), 0<δ ∧ Pointers2N x y∈OpenR 3 σ jNDuo ∧ JointPointN SΧ (νζ s) (νφ s) x y∈PrecisionYN δ:=by
 obtain ⟨δ,p₀,v⟩:= PointProfitN i; let h:= DutyTrue_N (P:=P) i
 obtain ⟨r,p'⟩:= (h.eventually ((PointMatrix_μN δ).mem_nhds v)).exists
 filter_upwards[(ProfitDeckN p B0 M R pu A D Q t uH H m Sq Wp L0 J' υ SΧ ωΥ i r).eventually ((PointMatrix_μN δ).mem_nhds p')] with s t
 let x:Vantage:=deltaR P s • rεS P r 1; have k(a:Axis):0<x a:= mul_pos (deltaR_good P s) (ΦtickN r a)
 have he: Pointers2N 0 x∈MasksR _:=by intro j i₁ i₂ h; fin_cases i₁ <;> fin_cases i₂ <;> first| exact rfl| exfalso
                                      · exact (k j).ne' (Eq.symm (show 0=x j from h))
                                      exact (k j).ne' h
 have hf:jNDuo.Pairwise (fun i i' => Pointers2N 0 x i 3 < Pointers2N 0 x i' 3):=by change ([0,1]:List (Fin 2)).Pairwise _; simp; exact k 3
 obtain ⟨s,h⟩:= (OpenPatR _ _ P 3 hf).exists; exact ⟨0,x,k,he,_,δ,p₀,h,t⟩
