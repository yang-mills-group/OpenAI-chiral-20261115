open BluffV
lemma BorisQ (d:BandS) : Nonempty (Fin (θ d)):=by
 let i:Matter.FlavorIndex:=(false,0,0); let K:= BluffV.plugC (BluffV.motif (0,0)) i; have v:BluffV.spectral i ≠0:=by
    let A:=Matter.jordan; intro h
    have he:Injective A:=Matter.co_earn; have p':Pi.single i (1:ℂ)=(0:Matter.FlavorIndex→ℂ):= he (h.trans A.map_zero.symm); have k:= congrFun p' i; simp at k
 let Y:Waves:=(K,0,0); have he:Y≠0:=by
    intro h; apply v; have h': K=0:= congrArg Prod.fst h; have hp:=plug_v (BluffV.motif (0,0)) i; unfold K at h'; rw [h'] at hp
    ext a b
    have p:=Matrix.ext_iff.mpr hp ((0:GaugeFieldConstruction.Cauchy.Spin),a) ((0:GaugeFieldConstruction.Cauchy.Spin),b); rw [Submodule.coe_zero,map_zero,Matrix.zero_apply,Matrix.kronecker_apply,show BluffV.motif (0,0) 0 0=1 from (by simp [BluffV.motif]),one_mul] at p; exact p.symm
 have ht: ΓProj d.val Y=Y:=by change MSlot _ _= _; unfold MSlot Y; split_ifs <;> rfl
 have h:= (Tsava p B0 M (1,false) d pu).coframe Y ht; obtain ⟨k,h⟩:=h; by_contra t; letI:=not_nonempty_iff.mp t; apply he; rw[h]; unfold Woof; simp
#print axioms BorisQ
