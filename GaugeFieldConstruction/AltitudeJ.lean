local notation "ΚΨ"=> ΦCentered p B0 M x R u Hv A T D V (s:=f0) le_rfl
#check ResonanceRankJ
lemma RingCeilingJ : Module.finrank ℂ (ResonanceRankJ B0 R u) ≤ Module.finrank ℂ (LinearMap.ker (ΦCentered p B0 M x R u Hv A T D V (s:=f0) le_rfl)):=by
 let S:=D.path
 let W:=p; let u':= u; let Q:= Χρ
 let ν(i:ℕ) (h:ΩPunchJ P (S.subSeq i) f0) := SailGateJ p _ _ B0 M (A _ h) x R u
 let B(i:ℕ)(h:ΩPunchJ P (S.subSeq i) f0) := LinearEquiv.ofBijective (ν i h) ((sailorVJ p _ _ B0 M (A _ h) x R u).1)
 let X(i): Q→ₗ[ℂ] (FrameK (Fin (θ u))):= if h:ΩPunchJ P (S.subSeq i) f0 then (B i h).symm.toLinearMap.comp Q.subtype else Q.subtype
 have ht(i): Injective (X i):=by
    unfold X; split
    next h=> exact (B i h).symm.injective.comp Subtype.val_injective
    exact Subtype.val_injective -- indent
 refine κLiftSliceJ X _ ht ?_; intro p' C k h; apply zeroΓ p B0 M x R u Hv A T D V _ k h p'
 refine Eventually.of_forall ?_; intro i w
 let W:= B (p'.subSeq i) w; dsimp only [X]; rw [dif_pos (show ΩPunchJ P (S.subSeq (p'.subSeq i)) f0 from w)]; change ArtGateJ B0 R u (W (W.symm _))∈ _; rw[W.apply_symm_apply]; exact (C i).property
abbrev UrbanCentJ (G:Submodule ℂ (ScreensJ P)):= Utf0P G
lemma rank_ceilingXJ : Module.finrank ℂ (Utf0P (Panmart p B0 M x R u Hv A T D V f0 le_rfl)) + Module.finrank ℂ (ResonanceRankJ B0 R u) ≤ θ u:=by
 rw[←PanZeroJ]; refine (add_le_add_right (RingCeilingJ p B0 M x R u Hv A T D V) _).trans ?_
 rw[LinearMap.finrank_range_add_finrank_ker, show Module.finrank ℂ (FrameK (Fin (θ u)))=θ u from Module.finrank_fin_fun ..]
#print axioms RingCeilingJ
