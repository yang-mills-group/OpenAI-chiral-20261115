private abbrev κPixelJ (E:Type)[NormedAddCommGroup E][NormedSpace ℂ E][FiniteDimensional ℂ E] := (Module.finBasis ℂ E).equivFun.trans (EuclideanSpace.equiv _ ℂ).symm.toLinearEquiv
lemma κLiftSliceJ (Y:ℕ→E→ₗ[ℂ]F)(Q:Submodule ℂ F) (z:∀ i,Injective (Y i))
  (g:∀ (p:Slow) (C:ℕ→ E)(x:F), Tendsto (fun i=>Y (p.subSeq i) (C i)) atTop (𝓝 x) → x∈ Q) : Module.finrank ℂ E≤ Module.finrank ℂ Q:=by -- Mathlib foundation same variant Depot.Replicating to minimize initial concerns stale. no unrelated dependencies.
 let P:=κPixelJ E; let X:=κPixelJ F; let i:= Module.finrank ℂ E; let j:=Module.finrank ℂ F; let G:= EuclideanSpace ℂ (Fin i); let M:=EuclideanSpace ℂ (Fin j)
 let B(k):= (κPixelJ F).toLinearMap.comp (Y k); let W(k):=LinearEquiv.ofInjective (B k) (X.injective.comp (z k)); let T (k): OrthonormalBasis (Fin i) ℂ (LinearMap.range (B k)):= (stdOrthonormalBasis ..).reindex (finCongr (W k).finrank_eq.symm)
 let C (k):= (T k).repr.symm; let S (k): E ≃ₗ[ℂ] E:= (P.trans (C k).toLinearEquiv).trans (W k).symm
 let R (k): G →L[ℂ] M:= LinearMap.toContinuousLinearMap ((LinearMap.range (B k)).subtype.comp (C k).toLinearEquiv.toLinearMap)
 have H(k):R k∈ Metric.closedBall 0 1:= by rw[Metric.mem_closedBall,dist_zero_right]; refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one fun x=> ?_; rw[one_mul]; exact ((C k).norm_map x).le
 letI:ProperSpace (G→L[ℂ]M):=FiniteDimensional.proper ℂ _
 obtain ⟨A,_,p,hp,hA⟩:=(isCompact_closedBall ..).tendsto_subseq H
 have he(x): Tendsto (fun i=>R (p i) x) atTop (𝓝 (A x)):= (show Continuous fun p:G→L[ℂ]M=>p x from continuous_id.clm_apply continuous_const).continuousAt.tendsto.comp hA
 have h:Injective A:=by
    apply (LinearMap.ker_eq_bot (f:=A.toLinearMap)).mp; apply LinearMap.ker_eq_bot'.mpr; intro x h
    have he:=tendsto_nhds_unique_of_eventuallyEq (he x|>.norm) tendsto_const_nhds (Eventually.of_forall fun i=> ((C (p i)).norm_map x)); rw [show A x=0 from h,norm_zero] at he; exact norm_eq_zero.mp he.symm
 let G₀:= X.symm.toLinearMap.comp (A.toLinearMap.comp P.toLinearMap)
 have h₀:Injective G₀:= X.symm.injective.comp (h.comp P.injective)
 have ht(x): G₀ x∈Q:=by
    apply g ⟨p,hp⟩ (fun i=> S (p i) x) (G₀ x)
    apply Tendsto.congr' _ ((X.symm.toLinearMap.continuous_of_finiteDimensional.continuousAt.tendsto).comp (he (P x)))
    refine Eventually.of_forall fun i=> ?_
    apply X.injective; change X (X.symm _)=_; rw [X.apply_symm_apply]; change (C (p i) (P x)).val=(W (p i) _).val; unfold S; change (C (p i) (P x)).val=(W (p i) ((W (p i)).symm (C (p i) (P x)))).val; rw [(W (p i)).apply_symm_apply]
 exact LinearMap.finrank_le_finrank_of_injective (show Injective (G₀.codRestrict Q ht) from fun i j h=> h₀ (congrArg Subtype.val h)) -- tune
end liftΛ
