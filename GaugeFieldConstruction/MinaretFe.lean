lemma GenreFe(V:Genre)(W:Waves)(h:V.Room W) : V.Room (SpinFe (chipUFe α) W):=by
 let Λ:= chipUFe α; let Y:= SpinFe Λ W
 have hp:chartF W=(0,0,0)→chartF Y=(0,0,0):=by
    intro v; unfold Y; rw [SpinFe_chart,v]; exact Prod.ext (map_zero (τoneFe Λ)) (Prod.ext (ContinuousLinearMap.ext fun i=> map_zero (τoneFe Λ)) (TableF.Lenten.Bank.dual_uni _ _ fun i => map_zero (τoneFe Λ)))
 have hm:(bm5 W).val=0→(bm5 Y).val=0:=by intro v; unfold Y; rw [SpinFe_m,v]; exact ContinuousLinearMap.ext fun i=> map_zero (τoneFe Λ)
 cases V
 · exact ⟨h.1,h.2.1,hm h.2.2⟩
 · exact ⟨h.1,h.2.1,hp h.2.2⟩
 exact ⟨hp h.1, hm h.2⟩ -- syntax
private lemma zero_dollar {E:Type*}[AddCommGroup E](F:E→E)(t:F (0+0) = F 0+F 0):F 0=0:=by rw [add_zero] at t; exact (add_left_cancel ((add_zero _).trans t)).symm
lemma currHoleFe (F:Waves→Waves)(Ψ:F 0=0)(Q:∀ k Y,MSlot k (F Y)=F (MSlot k Y))(G:∀ V:Genre,∀ W,V.Room W→V.Room (F W))(V: Genre)(A:GaugeFieldConstruction.Calibration.Floor)(Y:Waves)(H:HomΓ V A Y): HomΓ V A (F Y):=by
 let X:=F Y; refine ⟨G _ _ H.1,?_⟩
 cases A with
 | three=> exact ⟨H.2.1,(leg_3 _).1 ((Q 0 Y).trans (congrArg F ((leg_3 _).2 H.2.2)))⟩
 | four=>
   have he:MSlot 0 (F Y)=0:=by rw[Q]; rw [show MSlot 0 Y=0 from Prod.ext H.2.2.1 rfl,Ψ]
   exact ⟨H.2.1,congrArg Prod.fst he,(leg_4 _).1 ((Q 1 Y).trans (congrArg F ((leg_4 _).2 H.2.2.2)))⟩
 | five=>
   have ht:MSlot 1 (F Y)=0:=by rw[Q]; rw [show MSlot 1 Y=0 from Prod.ext H.2.1 (Prod.ext H.2.2 rfl),Ψ]
   exact ⟨congrArg Prod.fst ht,congrArg (fun p:Waves=>p.2.1) ht⟩
lemma spinHomFe (V: Genre)(W:Waves)(h: HomΓ V dΩ W): HomΓ V dΩ (SpinFe (chipUFe α) W):=currHoleFe _ (@zero_dollar Waves _ _ (Spin_UFe ..)) (Spin_slotFe α) (GenreFe α) _ _ W h
lemma turnHomFe (X: Shape)(c:Bool)(V:Genre)(W:Waves)(h:HomΓ V dΩ W) : HomΓ V dΩ (cargoν X c W):=by
 let s:= Levier.ray (N:=Reifier) c X; exact currHoleFe (Mason s) (@zero_dollar Waves _ _ (sheen_plus s.s s.charge _ _)) (fun k W=>Slot_sh s W k) (fun V W p=> Genre.trans_B s _ p) _ _ W h -- tune
abbrev StoryΘFe (Y:Waves):= SpinFe (chipUFe ω.al) (cargoν (PrimeScriptR ω.σ 0) ω.cr Y)
abbrev XIdenFe (X:BezelR): BezelR:= (X.1,X.2.1,StoryΘFe ω X.2.2)
lemma XκFe (t:X∈PerlSetR dΩ): XIdenFe ω X ∈ PerlSetR dΩ:=⟨spinHomFe ω.al X.2.1 _ _ (turnHomFe X.2.1 _ _ _ _ t.1), t.2⟩ -- tune
lemma coinsIdenFe (x:UV dΩ)(h:ZeckR X=shells dΩ x): ZeckR (XIdenFe ω X)=shells dΩ (PhoebeFe dΩ ω x):=LaveFe.Flavor_paidFe _ _ _ _ (spin_wire dΩ (Levier.ray (N:=Reifier) ω.cr (PrimeScriptR ω.σ 0)) X.2.2 x h)
