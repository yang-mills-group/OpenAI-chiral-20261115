lemma iconvFe (v:FrameK (RootS U dΩ)): ∃ x:UV dΩ,(shells dΩ x)=EmissionR U dΩ v∧x.1=0:=by
 have hp: EmissionR U dΩ v ∈ UniComR dΩ:=EmOutreach U dΩ ▸ LinearMap.mem_range_self (EmissionR U dΩ) v
 obtain ⟨a,t⟩:= hp.1; refine ⟨a,t,?_⟩; have ht:= hp.2; rw [←t] at ht; exact ht
-- δ rank coefficient output
noncomputable def ζFromFe (U:InterR)(dΩ:D_r) :FrameK (RootS U dΩ)→ₗ[ℂ] UV dΩ where
 toFun v:= (iconvFe dΩ U v).choose
 map_add' v t:=by apply shell_in; rw [(iconvFe dΩ U (v+t)).choose_spec.1,map_add (shells dΩ),(iconvFe dΩ U v).choose_spec.1,(iconvFe dΩ U t).choose_spec.1,map_add]
 map_smul' z t:=by apply shell_in; rw[(iconvFe dΩ U (z • t)).choose_spec.1,map_smul (shells dΩ),(iconvFe dΩ U t).choose_spec.1,map_smul]; try rfl
lemma ζShellsFe (v:FrameK (RootS U dΩ)): shells dΩ (ζFromFe U dΩ v)=EmissionR U dΩ v∧(ζFromFe U dΩ v).1=0:=(iconvFe dΩ U v).choose_spec
lemma dollarInFe : Injective (ζFromFe U dΩ):=by intro i j p; apply EmRank U dΩ; rw [←(ζShellsFe dΩ U i).1,p,(ζShellsFe dΩ U j).1]
lemma dollarOutFe (X:UV dΩ)(h:X.1=0): ∃ v :FrameK (RootS U dΩ),ζFromFe U dΩ v=X:=by
 let S:=shells dΩ; have ht:S X∈ UniComR dΩ:=⟨LinearMap.mem_range_self _ _,h⟩; rw [←EmOutreach U] at ht; obtain ⟨x,e⟩:=ht; exact ⟨x,shell_in dΩ ((ζShellsFe dΩ U x).1.trans e)⟩
abbrev zΔFe (dΩ:D_r): UV dΩ→ₗ[ℂ] ℂ:= LinearMap.fst ..
abbrev CentρFe (d:D_r):= LinearMap.ker (zΔFe d)
lemma SubreachFe : LinearMap.range (ζFromFe U dΩ)= CentρFe dΩ:=by
 apply le_antisymm; · rintro i ⟨v,rfl⟩; exact (ζShellsFe dΩ U v).2
 intro i p; exact dollarOutFe dΩ U i p
lemma MintXFe (j:U.RootS dΩ): EmissionR U dΩ (Pi.single j 1)=ZeckR j.val:=by rw [EmStyle]; unfold BlendSunR; simp; rfl -- tune
lemma ΛQueenFe (t:FrameK (RootS U dΩ)) : ∃ Y, ζFromFe U dΩ Y=PhoebeFe dΩ ω (ζFromFe U dΩ t):=by
 apply dollarOutFe; change FeeCoinFe _ _=_; rw [PhMoneyFe]; exact (congrArg (StampZFe ω) (ζShellsFe dΩ U t).2).trans (map_zero _) -- tune
noncomputable def RibandFe (t:FrameK (RootS U dΩ)) := (ΛQueenFe dΩ ω U t).choose
lemma RibandFe_pays (t:FrameK (RootS U dΩ)): ζFromFe U dΩ (RibandFe dΩ ω U t)=PhoebeFe dΩ ω (ζFromFe U dΩ t):= (ΛQueenFe dΩ ω U t).choose_spec
lemma ΞZeckFe (i:U.RootS dΩ): EmissionR U dΩ (RibandFe dΩ ω U (Pi.single i 1)) = SpineM ((XIdenFe ω i.val).2.2):=by
 let t:Θν:= Pi.single i 1; rw [← (ζShellsFe dΩ U _).1,RibandFe_pays]; apply Eq.symm; exact coinsIdenFe dΩ ω i.val (ζFromFe U dΩ t) (((ζShellsFe dΩ U t).1.trans (MintXFe ..)).symm)
