lemma LeafRankJ (F:LaurelJ): let K:=linkT_J P f s F (Q- (SailSubsidyJ p w h B0 M Ω x R u y) • 1) i k t; CargoBillJ (f:=f) p w h B0 M x R (claimB u l 0) 0 u F (K-EchoTideJ (f:=f) p w h B0 M Ω x R u F y) v ∧ CargoBillJ (f:=f) p w h B0 M x R (claimB u l 0) 0 u F K (Effortχ P f0 f r R0 u (P.run.uv k)):=by
 intro A; let D:=EchoTideJ (f:=f) p w h B0 M Ω x R u F y; let H'':=SailSubsidyJ p w h B0 M Ω x R u y; let κ:= claimB u l 0
 have hA : CargoBillJ (f:=f) p w h B0 M x R κ 0 u F (A-D) v:=by
    intro X _ _ W B Z H ξ vr eL
    let C:=fun _ :X=>x; let T:=fun _:X=>R; let b:=ArenaΨJ (X:=X) κ
    have he: RBuk (P:=P) (k:=k) (f:=f) l b 0 ξ u:=by intro i x t; change (κ i u=Fin.succ 0 ↔ i=l); unfold κ claimB; by_cases g:i=l <;> simp [g] -- tuner
    let hp:=Grip.grip X W C T b B Z H ξ rfl rfl he eL
    rw [TorrentJ p w h B0 M Ω x R u W T C b B Z H ξ rfl rfl,vr] at hp
    unfold A; rw [LinkCutJ _ _ _ F Grip.rise ((ShelterJ.one P x f s i).scale _),ζTowerJ] -- tune args
    · change Circζ P.run i k θ Z f ξ ( _- TideJ P f F H'' • 1- D) v; rw [sub_sub,add_comm ((TideJ P f F H'') • (1:Mark (side P.run i (P.run.uv k))))]; exact hp
    · exact h
    · exact q₀
    · exact e
    · exact Grip.run
    exact h
 refine ⟨hA,?_⟩
 have ht:=HoldTariffJ p w h B0 M Ω x R u y q₀ R0 r (Grip.cost.trans ep) hR
 let X':= CargoStretchJ p w h B0 M x R u 0 κ (cEraJ (f:=f) p w h B0 M Ω x R u 0 F y κ) ht.1; let W:= CargoBillJ.sumUp p w h B0 M x R u 0 κ X' hA
 rw [show EchoTideJ (f:=f) p w h B0 M Ω x R u F y+ (A-D)=A from (by unfold D; abel)] at W; exact CargoStretchJ p w h B0 M x R u 0 κ W ((add_le_add_right ep _).trans ht.2.2.2) -- order tune
include Hv pZ e0
lemma QuarkRankJ (ω:∀ n:ℕ, Collapse_J P n i f → ((n:ℝ)*(plumeZ P.par.R.L (P.run.uv k))⁻¹)*(ΦWallet p* Effortχ P f0 f r R0 u (P.run.uv k))^n≤ ε^n): CiriciJ P f s i k x (Q- (SailSubsidyJ p w h B0 M Ω x R u y) • 1) (ΦWallet p*v+ε) t:=by
 intro n c Y hv
 let T:=fun j:Fin n=>linkT_J P f s (Y j) (Q- (SailSubsidyJ p w h B0 M Ω x R u y) • 1) i k t; let J':=EchoTideJ (f:=f) p w h B0 M Ω x R u; let U(j:Fin n):=T j-J' (Y j) y
 let h0:=Grip.cost
 let Kf:=ΦWallet p*v; have hf:0 ≤ Kf:=mul_nonneg (WalletB _).le h0
 let Aμ:=Effortχ P f0 f r R0 u (P.run.uv k); let τ:= RankQJ P.par (P.run.uv k)
 have Hτ:∀ j:Fin n,CargoBillJ (f:=f) p w h B0 M x R (claimB u l 0) 0 u (Y j) (U j) v∧CargoBillJ (f:=f) p w h B0 M x R (claimB u l 0) 0 u (Y j) (T j) Aμ:=fun j=> LeafRankJ p w h B0 M Ω x R u y q₀ e r v hR R0 ep t Q l Grip (Y j) -- tune order
 have gH:=WristBudgetJ p w h B0 M x R u 0 Hv (claimB u l 0) q₀ e Y hv c U (fun j=>(Hτ j).1) h0
 let Z:=Cap_ZΛ P.run i k (List.ofFn U).prod; let Z':=Cap_ZΛ P.run i k (List.ofFn T).prod
 obtain ⟨h1,h2,h3,h4⟩:= HoldTariffJ p w h B0 M Ω x R u y q₀ R0 r (h0.trans ep) hR; have hQ:0≤τ:= (p.tempo _ w).1.le
 have he: v≤Aμ:=ep.trans ((le_add_of_nonneg_left ((mul_nonneg (noLoom _) hQ).trans h1)).trans h4)
 have Hz :‖Z'-Z‖≤ ε^n:=by
    let κ:= claimB u l 0; apply le_trans _ (ω n c); exact HandboundJ p w h B0 M Ω x R u 0 y Hv κ q₀ e Y hv c Aμ (h0.trans he) pZ 1 (by decide) (fun j _ _=> by unfold κ claimB; split <;> decide) T U h2 (fun j=> (Hτ j).2) (fun j=>CargoStretchJ p w h B0 M x R u 0 κ (Hτ j).1 he) (fun i=> by unfold U; exact Eq.symm (sub_add_cancel ..)) -- tune
 have ht:ε^n+Kf^n ≤ (ΦWallet p*v+ε)^n:=by
    rw [show (ΦWallet p*v+ε)^n=(Kf+ε)^n from rfl, add_comm]; -- tactic may rewrites? changes ε^n+ Kf^n to Kf... yes
    have h:= roomProfitJ c; -- copy via n succ
    have hp(i:ℕ): Kf^(i+1)+ ε^(i+1) ≤ (Kf+ε)^(i+1):=by
       rw[pow_succ Kf,pow_succ ε,pow_succ,mul_add]; exact add_le_add (mul_le_mul_of_nonneg_right (pow_le_pow_left₀ hf (le_add_of_nonneg_right e0.le) _) hf) (mul_le_mul_of_nonneg_right (pow_le_pow_left₀ e0.le (le_add_of_nonneg_left hf) _) e0.le)
    let j:=n-1; have t:j+1=n:=Nat.sub_add_cancel h.1; exact t ▸ hp j -- tune
 change ‖Z'‖≤ _; rw [show Z'= (Z'-Z)+Z from (by abel)]; exact (norm_add_le ..).trans ((add_le_add Hz gH).trans ht)
