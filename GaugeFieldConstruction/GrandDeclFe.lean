   have hp:=(tendsto_finsetSum (Finset.univ:Finset ChSigFe) (fun i _=> (ΡMercatorFe p B0 M R pu A D Q t u' H m Sq Wp dΩ i L0 J' υ (RibandFe dΩ i⁻¹ J' vK) pMm))).const_smul ηAvFe; simpa only [sum_const_zero,smul_zero] using hp
