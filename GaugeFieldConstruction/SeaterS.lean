lemma SpinOrdersS (X Y:I→Axis→ℝ)(j:Axis)(L:List I)(r y:ℝ)(q:L.Pairwise (fun i k=>r≤X k j-X i j))(T:0≤y)(u: Y=y • X) : BuntR (y*r) j L Y:=by
 subst Y; refine q.imp (fun {i k} h=>?_); change y*r≤ y * X k j - y * X i j; rw [←_root_.mul_sub]; exact mul_le_mul_of_nonneg_left h T
lemma OnCardS (x:DiagramR I)(h:x∈ CardsR I)(y:ℕ→I→Axis→ℝ)(v:Tendsto y atTop (𝓝 x))(ε:ℕ→ℝ)(e:Tendsto ε atTop (𝓝 0)) : ∃ j:Axis,∃ l:List I, PolesR l∧ ∀ᶠ i in atTop,BuntR (ε i) j l (y i) :=by
 obtain ⟨j,q⟩:=Set.mem_iUnion.mp h
 obtain ⟨l,a,t⟩:= vplane_w q; refine ⟨j,l,a,?_⟩
 clear a; induction l with
 | nil=> exact Eventually.of_forall (fun i=> List.Pairwise.nil)
 | cons i l ih=>
    obtain ⟨k,V⟩:= List.pairwise_cons.mp t
    have h(k:I):= tendsto_pi_nhds.mp (tendsto_pi_nhds.mp v k) j
    have he(t:I):∀ᶠ P in atTop,t∈l→ ε P≤ y P t j-y P i j:=by
       by_cases p:t∈ l
       · have H:Tendsto (fun P=> y P t j-y P i j-ε P) atTop (𝓝 (x t j-x i j-0)):= ((h t).sub (h i)).sub e; filter_upwards[H.eventually (le_mem_nhds (show 0<x t j-x i j-0 from (by rw[sub_zero]; exact sub_pos.mpr (k t p))))] with i y; exact fun _=>sub_nonneg.mp y -- i shadow
       exact Eventually.of_forall fun i q=>(p q).elim
    filter_upwards[eventually_all.mpr he,ih V] with i h q; exact List.pairwise_cons.mpr ⟨h,q⟩
