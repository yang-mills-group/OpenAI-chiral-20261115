lemma recess_plotS (V':ℕ→ I→ Cover)(x:I→Axis→ℝ)(p:Tendsto (fun i=> RecessS P m (L i) (V' i)) atTop (𝓝 x))(i:I): Tendsto (fun k=>mount ((Richm_R P m (L k))⁻¹) (StopS P m (L k) (V' k i))) atTop (𝓝 (WithLp.toLp 2 (x i))) :=by
