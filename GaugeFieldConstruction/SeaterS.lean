abbrev ScaleSχ (P:Spine)(f:ℕ)(x:I→Axis→ℝ): I→Axis→ℝ:= deltaR P f • x
abbrev RecessS (P:Spine)(m f:ℕ)(x:I→ Cover):I→Axis→ℝ:= (deltaR P f)⁻¹ • (AskR P (CountersS P m f x))
lemma RadarS (P:Spine)(m f:ℕ)(x:I→ Cover): ScaleSχ P f (RecessS P m f x)= AskR P (CountersS P m f x):=smul_inv_smul₀ (deltaR_good ..).ne' _ -- tune
lemma radCompS(f:ℕ)(x:DiagramR I)(i:I)(j:Axis):ScaleSχ P f x i j= deltaR P f * x i j:= rfl
lemma SeatedR (P:Spine)(x:Cover)(f m:ℕ)(i:Axis): |mount ((Richm_R P m f)⁻¹) (StopS P m f x) i- (deltaR P f)⁻¹ * ((P.vtile (SportR P m f) x i):ℝ)| ≤ (Richm_R P m f)⁻¹:=by
 let R:= Richm_R P m f; let s:=SportR P m f; let M:=P.mellow s; let V:= adventJ P 0 s i; let W:=ruler P.par.block*x i
 have ht:|0-M*(V:ℝ)|≤M:=P.spale_J 0 s i
 have hv:((P.vtile s x i):ℝ)=M*W:=P.mellow_firm ..
 have hx: StopS P m f x i= V+W:=rfl
 change |R⁻¹ * ↑(StopS P m f x i)-(deltaR P f)⁻¹* ((P.vtile s x i):ℝ)| ≤ _; rw [hx,hv,← Richm_peck,Int.cast_add]; change |R⁻¹*_-(M*R)⁻¹*_|≤R⁻¹
 have ha:0<M:=P.mellow_good _; have hr:0<R:=Richm_good ..
 rw [show R⁻¹*((V:ℝ)+W) -(M*R)⁻¹*(M*W)= R⁻¹*V by field_simp; ring,abs_mul]; rw [zero_sub, abs_neg,abs_mul,abs_of_pos ha] at ht; rw[abs_of_nonneg (inv_nonneg.mpr hr.le)]
 have hb: |(V:ℝ)| ≤ 1:= le_of_mul_le_mul_left (ht.trans_eq (mul_one M).symm) ha; exact mul_le_of_le_one_right (inv_nonneg.mpr hr.le) hb
