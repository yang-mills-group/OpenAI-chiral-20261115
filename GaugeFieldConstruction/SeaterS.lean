         (f:=fun i'=> (mount ((Richm_R P m (L i'))⁻¹) (StopS P m (L i') (V' i' i))).ofLp) -- tune names
 apply tendsto_pi_nhds.mpr; intro j
 let X(l:ℕ):= RecessS P m (L l) (V' l) i j; have hp:Tendsto X atTop (𝓝 (x i j)):=tendsto_pi_nhds.mp (tendsto_pi_nhds.mp p i) j
 let Q(k:ℕ):= mount ((Richm_R P m (L k))⁻¹) (StopS P m (L k) (V' k i)) j
 apply tendsto_of_tendsto_of_dist hp; refine squeeze_zero (fun _=>dist_nonneg) ?_ (tendsto_inv_atTop_zero.comp ((Richm_lit P m).comp pL)); intro k; change dist (X k) (Q k)≤ _; rw [dist_comm,Real.dist_eq]; exact SeatedR P (V' k i) (L k) m j -- tune order
