structure QueuedTensorSt :Prop where
 shifts (a:Axis)(Z:ClanZN): roles.FontV3_Κ a i Z= roles.StaturePV i (transitionΦN Z) a
 primary (a:Axis): roles.ZleftNX a i none=dF ∧ roles.ZrightNX a i none=dF
 angleRest (a:Axis): TurnupMars a (roles.FloraBinVU i)= roles.FloraBinVU i
 secondary (a:Axis)(Z:ClanZN):
   roles.ZrightNX a i (some Z)=roles.ΔFontVU a i Z∧ roles.ZleftNX a i (some Z)=roles.ΔFaceVU a i Z∧
    ∃ (X Y:UV three), roles.ZrightNX a i (some Z)= roles.DeckLiftVU i X ∧roles.ZleftNX a i (some Z)= roles.DeckLiftVU i Y
 gear: ∃ F:ℕ→process.Test, roles.ExhibitGeVu i F ∧ StandardPV id (fun _=>F) (roles.RoomsVU dF) ∧ ∀ᶠ s in atTop,∀ x:Cover,PureGauge process.calibration (process.chartAll x (F s)) ∧ TruthInkSt process.calibration (cartO (SceneAtN process x) 28) ((process.chartAll x (F s)).val)
 current (a:Axis)(Z:ClanZN): ∃ F:ℕ→process.Test, StandardPV id (fun _=>F) (roles.RoomsVU (roles.FontV3_Κ a i Z)) ∧ ribbonN roles.Dp (transitionΦN Z) (roles.RoomsVU (roles.FontV3_Κ a i Z)) F
 spin_lock (x:UV three): SleepW (stress:=stress) (continued:=continued) (vacuum:=vacuum) dF (roles.DeckLiftVU i x) ∧ SleepW (stress:=stress) (continued:=continued) (vacuum:=vacuum) (roles.DeckLiftVU i x) dF ∧ ∀ (f g:Test4), tensorExperimentGap (model:=model) dF (roles.DeckLiftVU i x) f g=0∧ tensorExperimentGap (model:=model) (roles.DeckLiftVU i x) dF g f=0
 keep_gauge: dF ≠ 0

lemma tensorObstruction : QueuedTensorSt (roles:=roles) (model:=model) (continued:=continued) i:=by
 refine ⟨(fun a z=>congrArg (roles.DeckLiftVU i) (registered_basis a z)),(fun a=>roles.CharterNX _ i E),fun a=>momentRestSt i a E,?_,?_,?_,?_,?_⟩
 · intro a k; obtain ⟨e,f⟩:= roles.ChairDNX a i E k; rw [e,f]; refine ⟨rfl,rfl,_,_, (roles.SpinPortVU i E _ _).symm,(roles.SpinPortVU i E _ _).symm⟩
 · obtain ⟨F,b⟩:= roles.PricesFeVU i; refine ⟨F,b,GuidePricePV id tendsto_id _ _ ?_,b.2.mono ?_⟩
   · exact ⟨b.1.1,b.2.mono fun i h x=> ⟨(h x).1,(h x).2.1⟩⟩
   exact fun s d x=> ⟨sterling_pure _ _ _ (d x).2.2,true_ink_steel _ _ _ (d x).2.2⟩
 · intro a Z; obtain ⟨F,e⟩:= roles.MarkProgramVU i Z _ (StoryZN a Z); exact ⟨F,roles.ΦCataloguedPV Z _ _ _ F e tendsto_id,e⟩
 · intro x; obtain ⟨u,t⟩:= symmetricWard Certificate i E x; exact ⟨u,t,read_zero_tensor Certificate i E x⟩
 rw [roles.FaceAuraVU i E]; exact LinearEquiv.map_ne_zero_iff ..|>.2 ΩFloatsVU
