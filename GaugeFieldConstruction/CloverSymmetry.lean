lemma gateKin_st (z k:DegreeViewNX): tensorExperimentGap (model:=model) (roles.ZleftNX a i z) (roles.ZrightNX a i k) (TagVU T.F.K) (TagVU T.F.L)= roles.LorJointNX stress (le_refl _) (L:=response) (roles.ZleftNX a i) (roles.ZrightNX a i) T.F.K T.F.L z k:=by
 unfold tensorExperimentGap
 rw [actualBill_two_st model.course,actualBill_one_st model.course,actualBill_one_st model.course]; unfold LorJointNX MonoCoinVU PairCoinVU ConjoinVU
 have H₁: TagVU ∘ ![T.F.K,T.F.L] = ![TagVU T.F.K,TagVU T.F.L]:=by ext1 i; fin_cases i<;> rfl
 have H₂(B'): TagVU ∘ ![B'] = ![TagVU B']:=by ext1 i; fin_cases i; rfl
 rw [H₁,H₂,H₂]
structure ComparisonArtSt : Prop where
 diagonal (z:DegreeViewNX): 0 < Complex.re (tensorExperimentGap (model:=model) (roles.ZleftNX a i z) (roles.ZrightNX a i z) (TagVU T.F.K) (TagVU T.F.L))
