lemma CPriceComparisonSt : ComparisonArtSt (model:=model) i a T:=by
 let t:= tensorObstruction Certificate i E; constructor
 · intro z; rw [gateKin_st Certificate i a E T]; exact lt_trans T.F.δ_pos (WicketNX.visibleXN T.worth _)
 intro z; obtain ⟨x,y,h,p⟩:= (t.secondary a z).2.2; rw [h,p,(t.primary a).1,(t.primary a).2]; exact ⟨((t.spin_lock x).2.2 (TagVU T.F.K) (TagVU T.F.L)).1,((t.spin_lock y).2.2 (TagVU T.F.L) (TagVU T.F.K)).2⟩
