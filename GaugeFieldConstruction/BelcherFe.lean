lemma VisigiloFe :∀ᶠ t in atTop, Injective (ΥGapFe P (Σp dΩ) t):=by
 obtain ⟨c,k,l,α,h⟩:=SweetRankR p B0 M pu A D Q t u' H 26 U dΩ Sq Wp le_rfl false 0
 filter_upwards[h,eventually_ge_atTop f0] with m v s₁
 let R:Signed × Bool:= (1,false); let S:= Sq x R (ΤbandR dΩ); let Z:= Wp.go x R (ΤbandR dΩ)
 let X:= AtMarkR p B0 M x pu A D 26 U Sq Wp R s₁ dΩ false 0; let Φ:= PaneKeyR p B0 M x pu A D 26 U dΩ Sq Wp R s₁ false 0
 obtain ⟨Y,V,T⟩:= v x R s₁
 letI : AddCommGroup ↥(Σp dΩ):= @Submodule.addCommGroup ℂ (ScreensJ P) _ _ _ _
 refine (LinearMap.ker_eq_bot (f:= ΥGapFe P (Σp dΩ) m)).mp (LinearMap.ker_eq_bot'.mpr ?_)
 intro y ht
 let σ:=RootApR P m; let a:= y.val; change GapHeightR P m a=0 at ht
 have hu:Focusβ P a=0:=by
    change HeapΨ P.publicH a=_; rw [← PanΨ p B0 M x R (ΤbandR dΩ) pu A S D Z (s:=f0) le_rfl σ σ 3 P.publicH (MeanBylawsJ P) a y.property]
    change inner ℂ _ (GapHeightR P m a)=_; rw[ht]; exact inner_zero_right ..
 obtain ⟨v,h⟩:= show a∈ LinearMap.range Φ from V.symm ▸ (show a∈ Utf0P (Σp dΩ) from ⟨y.property,hu⟩)
 specialize T v; rw[← h] at ht; rw[ht,norm_zero] at T; have hp:v=0:=by by_contra q; exact (mul_pos l (norm_pos_iff.mpr q)).not_ge T.1
 apply Subtype.ext; change a=0; rw [←h,hp,map_zero]
