lemma Spin_slotFe (z:ℕ)(x:Waves):MSlot z (SpinFe (chipUFe gk) x)=SpinFe (chipUFe gk) (MSlot z x):=by
 unfold MSlot; split_ifs
 all_goals first| rfl | omega | skip
 all_goals
   apply FestFe_eq
   · apply Subtype.ext; apply ContinuousLinearMap.ext; intro i; apply ContinuousLinearMap.ext; intro j; rfl
   · apply ContinuousLinearMap.ext; intro i; apply ContinuousLinearMap.ext; intro j; rfl
   · rfl
   · intro i; first | rfl | exact Eq.symm (map_zero (ageFe (chipUFe gk)))
   · intro i; first | rfl | exact Eq.symm (map_zero (ageFe (chipUFe gk)))
   intro j; first| rfl| exact Eq.symm (map_zero (ageFe (chipUFe gk)))
