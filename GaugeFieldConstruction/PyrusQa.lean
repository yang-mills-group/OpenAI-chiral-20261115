noncomputable def SeawayQa (Z:Fin n→ U773):Fathom.Bond n where
    toFun p:= p.applyTo (ΦSrc Z)
    map_add' x y:=by unfold YM.Test.applyTo; rw [← integral_add (BondCostQc x _ (NestRegularQa ..)) (BondCostQc y _ (NestRegularQa ..))]; apply integral_congr_ae; exact Eventually.of_forall fun i=> add_mul (x i) (y i) _
    map_smul' a x:=by unfold YM.Test.applyTo; change _=a*_ ; rw[←integral_const_mul]; exact integral_congr_ae (Eventually.of_forall fun i=> _root_.mul_assoc a (x i) _)
noncomputable abbrev MistQa (x:Points n): MultilinearMap ℂ (fun _:Fin n=> UV five) ℂ:= (KriffS ΠFt (EnterΦS p B0 M pu A D five Sq Wp) (K_Q) (ΦplanR n x)).compLinearMap (fun _=> Bsrc)
