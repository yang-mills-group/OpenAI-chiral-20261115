 fee n:={
    toFun:= fun X=> SeawayQa p B0 M R pu A D Q t uH H m Sq Wp L0 J' υ src X
    map_update_add' Z i x y:=by
       rename_i D'; ext1 w; change w.applyTo _= w.applyTo (ΦSrc (Function.update Z i x))+w.applyTo (ΦSrc (Function.update Z i y))
       unfold YM.Test.applyTo; rw[←integral_add (BondCostQc w _ (NestRegularQa ..)) (BondCostQc w _ (NestRegularQa ..))]; apply integral_congr_ae; apply Eventually.of_forall; intro t'
       dsimp only; rw [←mul_add]; exact congrArg _ ((MistQa p B0 M R pu A D Q t uH H m Sq Wp L0 J' υ src t').map_update_add Z i x y)
    map_update_smul' Z i a y:=by
       rename_i D'; ext1 w; change w.applyTo _= a* w.applyTo (ΦSrc (Function.update Z i y)); unfold YM.Test.applyTo; rw[←integral_const_mul]; apply integral_congr_ae; apply Eventually.of_forall; intro x'; dsimp only; rw[mul_left_comm a (w x')]; exact congrArg (HMul.hMul (w x')) ((ΦHex x').map_update_smul Z i a y) }
 rearr {n} s X p':=by
    change (Fathom.perm s.symm p').applyTo (ΦSrc _) = p'.applyTo _; rw [cost_mirror,Equiv.symm_symm]; refine congrArg _ (funext fun i=>?_)
    exact PermκS _ (fun i=>(Bsrc (X i)).val) (fun k=> Scene_VFe p B0 M pu A D Sq Wp five ((Bsrc) (X k))) s (ΦplanR n i)
noncomputable def ΦAreaQa: AreaQc (EatonQa p B0 M R pu A D Q t uH H m Sq Wp L0 J' υ src) where
    fee n:= NestVKQa p B0 M R pu A D Q t uH H m Sq Wp L0 J' υ src
    reg n L:= NestRegularQa ..
    price n L f:=rfl
    unit n L x e:=by
        let X:=fun i=>(Bsrc (L i)).val
        have h:(fun i=>(Bsrc (Fathom.add (Empire.one five) L i)).val)=Fin.cons (CandΛJ P) X:=by
           funext i; refine Fin.cases ?_ (fun i=>rfl) i; exact congrArg Subtype.val (BasisCoinFe p B0 M R pu A D Q t uH H m Sq Wp five L0 J' υ src) -- tune args
        unfold NestVKQa; rw[h]; exact UnitδS _ _ (SingleEpochQa _ x e) X (fun k=>Scene_VFe p B0 M pu A D Sq Wp five (Bsrc (L k)))
    rearr n s x _ L:= PermκS _ (fun i=>(Bsrc (L i)).val) (fun k=>Scene_VFe p B0 M pu A D Sq Wp five (Bsrc (L k))) s (ΦplanR n x)
