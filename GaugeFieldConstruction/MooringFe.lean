lemma TownCartFe (x:FrameK (Fin (θ (ΤbandR dΩ))))(a:ℕ)(v:U.val=CartoonR p B0 M 0 R (ΤbandR dΩ) pu L0 A (Sq 0 R _) D (Wp.go ..) g m a z x) : (DayShiftP p B0 M pu A D B c dΩ Sq Wp U).val=CartoonR p B0 M 0 B'p (ΤbandR dΩ) pu L0 A (Sq 0 B'p _) D (Wp.go ..) g m a z (ΘH x):=by
 let V:= Wp.go 0 R (ΤbandR dΩ); let s:=SportR P m f; let q:=g.trans (SportR.hop P m f); let z':= WrappR D m f a z; let T:= (Sq 0 R (ΤbandR dΩ)).sun L0 s; let H₀:=ΘH x; let t':=(Sq 0 B'p ΔT).sun L0 s; let Y:= BrJ (ΤbandR dΩ) T.1 x
 have h:=DietΧFe p B0 M R pu A D q Q t u' H Sq Wp dΩ B c U (z' • Y) v; rw[h]; change ΦCentered p B0 M 0 B'p ΔT pu A _ D (Wp.go ..) q (ΘH (z' • Y))=ΦCentered p B0 M 0 B'p ΔT pu A _ D (Wp.go ..) q (z' • BrJ ΔT t'.1 (ΘH x)); apply congrArg (ΦCentered p B0 M 0 B'p ΔT pu A _ D (Wp.go ..) q)
 change ΘH (z' • Y)= z' • BrJ ΔT t'.1 (ΘH x); rw[← timeZsFe p B0 M R ΔT A D q x Sq Wp B c L0]; funext i; let S:=(ΟGlow (PrimeScriptR B 0) c P.par); change S (z' * Y i)= z' * S (Y i); rw [map_mul,PaintSignS B P c z',WrappTurnFe] -- binder
