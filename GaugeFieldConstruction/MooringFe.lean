lemma DietΧFe (x:FrameK (Fin (θ (ΤbandR dΩ))))(v:U.val=ΦCentered p B0 M 0 R (ΤbandR dΩ) pu A (Sq 0 R _) D (Wp.go ..) s0 x): (DayShiftP p B0 M pu A D B c dΩ Sq Wp U).val=ΦCentered p B0 M 0 B'p (ΤbandR dΩ) pu A (Sq 0 B'p _) D (Wp.go ..) s0 (hoodAJ (ΟGlow (PrimeScriptR B 0) c P.par) x):=by
 let F:= DietX p B0 M R pu A D s0 dΩ Sq Wp (x,0); let H':= MeshΦ p B0 M 0 R ΔT pu A (Sq 0 R _) D (Wp.go ..) s0 x
 have ht: F.val= H':=by change H'+ (0:ℂ) • _= _; exact foEnFe P _ _
 let J:ΝPlanR p B0 M 0 pu A D Sq Wp dΩ:=⟨CandΛJ P, show _∈ _ from (foCashFe P ▸ UnitσP p B0 M 0 (1,false) ΔT pu A _ D (Wp.go ..) (s:=f0) le_rfl 1)⟩
 let T:= Heapψ P F.val; let G:= DayShiftP p B0 M pu A D B c dΩ Sq Wp
 have hz: U=F+ (-T) • J:=by apply Subtype.ext; rw[v]; change H'-Heapψ P H' • CandΛJ P= F.val+(-T) • CandΛJ P; unfold T; rw[ht]; exact ShortedFe P _ _ _
 have hp:(G F).val= MeshΦ p B0 M 0 B'p ΔT pu A (Sq 0 B'p _) D (Wp.go ..) s0 (ΘH x):= DietΘFe p B0 M R pu A D s0 Q t u' H Sq Wp dΩ B c F x ht -- tune binder
 rw [hz,DayPlusS p B0 M pu A D Q t u' H,DayScaleS p B0 M pu A D Q t u' H,Cand_BS p B0 M pu A D Q t u' H B c dΩ Sq Wp J rfl]; let X:= (G F).val; let a':= sailH (PrimeScriptR B 0) c; let Z:= MeshΦ p B0 M 0 B'p ΔT pu A (Sq 0 B'p _) D (Wp.go ..) s0 (ΘH x); change X+a' (-T) • _=Z-Heapψ P Z • CandΛJ P; rw[← show X=Z from hp,map_neg, ← show Heapψ P X=a' T from MeritS p B0 M pu A D B c dΩ Sq Wp F]; exact (ShortedFe P _ _ _).symm -- ht Ξ name.Z. expression
