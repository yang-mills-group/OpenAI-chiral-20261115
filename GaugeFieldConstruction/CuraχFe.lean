lemma ΓPagoFe : Tendsto (fun f:ℕ=> dist (GapHeightR P f ((ScopeΦFe p B0 M pu A D Sq Wp dΩ ω (JoltFe p B0 M R pu A D m Sq Wp dΩ L0 J' f (Pi.single iT 1))).val)) (GapHeightR P f (JoltFe p B0 M R pu A D m Sq Wp dΩ L0 J' f (RibandFe dΩ ω J' (Pi.single iT 1))).val)) atTop (𝓝 0):=by
 let i:= iT; let d:=i.val.2.1; let z:Θν:=Pi.single i 1; let X:=XIdenFe ω i.val; let U:= Ωp z; let V(f:ℕ)(a:f0≤f):=TrueDecalFe p B0 M R pu A D m Sq Wp d L0 i.val a; have ht:=J'.sat dΩ i.property
 let g:= XapertureFe p B0 M R pu A D Q t u' H m Sq Wp d ω L0 J' i.val υ pMm (show i.val∈ PerlSetR d from ⟨ht.1,le_rfl⟩); let h:= αizonFe p B0 M R pu A D Q t u' H m Sq Wp dΩ L0 J' X (XκFe dΩ ω i.val ht) pMm U (ΞZeckFe dΩ ω J' i)
 have hi:= (tendsto_inv_atTop_zero.comp (SpringR.escape P)).const_mul 2
 apply squeeze_zero' (Eventually.of_forall fun i=> dist_nonneg) ?_ (show Tendsto _ atTop (𝓝 0) from (by simpa only [mul_zero,zero_add] using hi.add h)) -- inference tune
 filter_upwards [g,eventually_ge_atTop f0] with f j e
 let F:= DecalR p B0 M 0 R pu A D m Sq Wp e d X L0; let H₀:=GapHeightR P f; let Y:= M_k f z
 let P':= ΣpE Y
 have hv: P'.val=(ScopeΦFe p B0 M pu A D Sq Wp d ω (V f e)).val:=(ScopeNstFe p B0 M pu A D Q t u' H Sq Wp d ω J' υ _ dΩ ht.2 _ (JoltRootFe p B0 M R pu A D m Sq Wp dΩ L0 J' i e).symm).symm
 unfold Function.comp; rw [dif_pos e]; let W:= M_k f U
 have hw: BullZFe p B0 M R pu A D m Sq Wp dΩ L0 X f=F:=by unfold BullZFe; rw[dif_pos e]; rfl
 rw [hw,← JoltFe_v p B0 M R pu A D m Sq Wp dΩ L0 J' U e]
 change dist (H₀ P'.val) (H₀ W.val) ≤2*(SpringR P f)⁻¹+ _; refine (dist_triangle _ (H₀ F) _).trans (add_le_add_left ?_ _); rw [dist_comm,hv]; exact j e
