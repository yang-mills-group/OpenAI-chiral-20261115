lemma ΡMercatorFe : Tendsto (fun f:ℕ=> ΧFeMap p B0 M R pu A D m Sq Wp dΩ L0 J' ω f vK) atTop (𝓝 0):=by
 let Τ:=ΧFeMap p B0 M R pu A D m Sq Wp dΩ L0 J' ω; let s:RootS J' dΩ→Θν:= fun i=> Pi.single i 1
 have hx(j:RootS J' dΩ): Tendsto (fun f:ℕ=> Τ f (s j)) atTop (𝓝 0):=by apply tendsto_iff_dist_tendsto_zero.mpr; simp_rw [dist_zero_right]; have he:= ΓPagoFe p B0 M R pu A D Q t u' H m Sq Wp dΩ ω L0 J' υ j pMm; simp_rw[dist_eq_norm] at he; exact he
 let X(p:Θν):Prop:=Tendsto (fun f:ℕ=> Τ f p) atTop (𝓝 0); have hk (a b:Θν)(h:X a)(e:X b): X (a+b):=by
   have he(f:ℕ):Τ f (a+b)=Τ f a+Τ f b:= ΞFiscalFe p B0 M R pu A D Q t u' H m Sq Wp dΩ ω L0 J' υ a b
   unfold X; simp_rw[he]; simpa using Filter.Tendsto.add h e
 have hv(c:ℂ)(a:Θν)(h:X a):X (c • a):=by
   have he(f:ℕ):Τ f (c • a)= StampZFe ω c • Τ f a:=by
     let Z:=ΥGapFe P (ΝPlanR p B0 M 0 pu A D Sq Wp dΩ) f
     unfold Τ ΧFeMap; rw [RibandFe_Z dΩ ω J', (M_k f).map_smul,(M_k f).map_smul,ScopeZmScFe p B0 M pu A D Q t u' H Sq Wp dΩ ω J' υ]; rw [Z.map_smul,Z.map_smul,smul_sub]
   unfold X; simp_rw[he]; simpa using Filter.Tendsto.const_smul h (StampZFe ω c) -- name tune
 have he:X 0:=by
    let y:Θν:=0; have ht(f:ℕ):Τ f y=0:=by
       have hp:=ΞFiscalFe p B0 M R pu A D Q t u' H m Sq Wp dΩ ω L0 J' υ y y (f:=f); unfold y at hp; rw[zero_add] at hp; exact (add_left_cancel ((add_zero _).trans hp)).symm
    unfold X; simp_rw[show (0:Θν)= y from rfl, ht]; exact tendsto_const_nhds
 exact ΓHorizonFe X he hk (fun i c=>hv c (s i) (hx i)) vK
