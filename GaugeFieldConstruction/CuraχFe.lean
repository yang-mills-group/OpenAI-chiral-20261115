private lemma ΓHorizonFe {W:Type}[Fintype W][DecidableEq W](X:(W→ℂ)→Prop)(p:X 0)(q:∀ a b,X a →X b→X (a+b))(t:∀ (i:W) (c:ℂ),X (c • Pi.single i 1))(v:W→ℂ):X v:=by
 let C (i:W):W→ℂ:=Pi.single i (1:ℂ)
 have hp(s:Finset W): X (∑ i∈s,v i • C i):=by
   induction s using Finset.induction with
   | empty=> rw [Finset.sum_empty]; exact p
   | insert i A h P=> rw [Finset.sum_insert h]; exact q _ _ (t ..) P
 have e:=hp univ; rw [show (∑ i:W,v i • C i)=v from (by funext i; rw[Finset.sum_apply]; simp [C,Pi.single_apply])] at e; exact e
