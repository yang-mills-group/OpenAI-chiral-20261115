lemma TangoS (P:Spine)(B C: Signed)(b c:Bool){i:ℕ} (x:FrameK (Fin i) × ℂ): RichL_S P C c (RichL_S P B b x)=RichL_S P (B*C) (b.xor c) x:=by
 refine Prod.ext (funext fun i=>?_) (tangoS ..)
 let X(B:Signed)(b:Bool):= ΟGlow (PrimeScriptR B 0) b P.par; change X C c (X B b _)=X _ _ _; unfold X; simp_rw [PaintSignS]; exact tangoS ..
lemma DrumO (P:Spine){i:ℕ}(x:FrameK (Fin i) × ℂ) :RichL_S P 1 false x=x:=by
 have h(y:ℂ): sailH (PrimeScriptR 1 0) false y=y:=by unfold sailH; simp only [det_i]; rfl
 refine Prod.ext (funext fun i=>?_) (h _); let B:Signed:=1; change ΟGlow (PrimeScriptR 1 0) false P.par _=_; rw[PaintSignS,h]
lemma GripAccel (B C:Signed)(b c:Bool)(R:Signed × Bool): GripR (GripR R B b) C c=GripR R (B*C) (b.xor c):=by
 unfold GripR; apply Prod.ext
 · exact mul_assoc ..
 cases b <;> cases c <;> cases q:R.2 <;> simp [q] -- indentation hazard tune
