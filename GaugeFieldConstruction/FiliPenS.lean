lemma tangoS (B C:Signed)(b c:Bool)(x:ℂ): sailH (PrimeScriptR C 0) c (sailH (PrimeScriptR B 0) b x)= sailH (PrimeScriptR (B*C) 0) (b.xor c) x:=by
