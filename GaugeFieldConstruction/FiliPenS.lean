lemma UnitAbleS (X:B_d): DayShiftP p B0 M pu A D 1 false dF S V X=X:=by
 let R:Signed × Bool:=(1,false); let A'(z):=DietX p B0 M z pu A D (s:=f0) le_rfl dF S V
 obtain ⟨z,h'⟩:=OriginCoreR p B0 M R pu A D _ S V X (s:=f0) le_rfl
 rw [← show A' R z=X from Subtype.ext h']; unfold A'; rw [thetaRevS p B0 M R pu A D _ _ _ _ H, DrumO P, show GripR R 1 false=R from (Prod.ext (mul_one _) rfl)] -- tune order s0 before H
lemma DynBS (x:B_d)(C:Signed)(d:Bool): DayShiftP p B0 M pu A D C d dF S V (B_P x) =DayShiftP p B0 M pu A D (B*C) (c.xor d) dF S V x:=by
 let R:Signed ×Bool:=(1,false); obtain ⟨z,w⟩:= OriginCoreR p B0 M R pu A D _ S V x (s:=f0) le_rfl; rw[←show DietX p B0 M R pu A D _ dF S V z=x from Subtype.ext w]; -- infer h tune
 have h(T:Signed × Bool)(U:Signed)(b:Bool)(x):= thetaRevS p B0 M T pu A D (s:=f0) le_rfl Q t u' H U b dF S V x
 rw[h,h,h,TangoS,GripAccel]
