        have hh(i':ℕ)(a:s≤ i')(x:i'=s): OrbitLO (d0:=U b) (f:=s) p v g A M Yp (Z b) (L b) d Zp (fun t=>wayZJ P.par s t r) false a z=OrbitLO (d0:=U b) (f:=s) p v g A M Yp (Z b) (L b) d Zp (fun t=>wayZJ P.par s t r) false (le_refl s) z:=by subst i'; rfl
        unfold SunLO; rw[hh _ _ (max_self _)]; unfold OrbitLO; rw [Plc_self,Ac_self,LinearMap.zero_apply,map_zero,zero_smul,sub_zero]; rw [show ΟGlow (wayZJ P.par s s r) false P.par=J from ΘShadeQ f s i hG (W x)]
