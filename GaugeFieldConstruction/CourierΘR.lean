lemma grinDet (B:Signed):detX B⁻¹=detX B:=by have h:=det_p B B⁻¹; rw [mul_inv_cancel, det_i] at h; generalize detX B=p at *; generalize detX B⁻¹=q at *; cases p <;> cases q <;> trivial
