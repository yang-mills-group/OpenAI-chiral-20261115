lemma GripDebtS (B:Signed)(c:Bool)(x:ℂ): sailH (PrimeScriptR B 0) c (sailH (PrimeScriptR B⁻¹ 0) c x)=x:=by
 unfold sailH; simp only [grinDet]; split_ifs <;> simp -- tune
lemma RichDeathS (P:Spine)(B:Signed)(c:Bool){q:ℕ}(x:FrameK (Fin q)× ℂ): RichL_S P B c (RichL_S P B⁻¹ c x)=x:=by
 refine Prod.ext (funext fun i=>?_) (GripDebtS B c _)
 let T (B:Signed)(a:ℂ):=ΟGlow (PrimeScriptR B 0) c P.par a; change T B (T B⁻¹ _)=_; unfold T; rw[PaintSignS B⁻¹,PaintSignS B]; exact GripDebtS ..
lemma RoyalOut (F:B_d):∃ A': B_d, Bankedρ B_d B c A' F:=by
 let R:Signed × Bool:=(1,false); let H:= GripR R B c
 obtain ⟨x,h⟩:=OriginCoreR p B0 M H pu A D _ S V F (s:=f0) le_rfl
 let y:=RichL_S P B⁻¹ c x; obtain h' :=EpochRevenueS p B0 M R pu A D (s:=f0) le_rfl B c dF S V y; rw [RichDeathS, show DietX p B0 M H pu A D (s:=f0) le_rfl dF S V x=F from Subtype.ext h] at h'; exact ⟨_,h'⟩ -- h' rw tune
include H
lemma OrbisKR (F A' Y:↥B_d)(p1:bP F A')(p2:bP F Y): A'=Y:=by
 let E:=ΔΕΡ P; let W:= BonusW_S P B c; let h:=EnterΦS p B0 M pu A D dF S V
 let K1:= KriffS (n:=1) B_d h E; let K2:=RowJ_S B_d h E
 apply GlobalRankES p B0 M pu A D Q t u' H dF S V
 · intro i; let z:= dShiftS B⁻¹ i; let X:Fin 1→ScreensJ P:=fun j=>((![F] j):B_d).val
   have ht(P':B_d)(H:bP F P'): K1 i ![P']=(C_S) (K1 z ![F]):=by
      let u:Fin 1→ScreensJ P:=fun j=> (![P'] j).val; change SπR _ u i=(C_S) (SπR _ X z); nth_rw 1 [←show dShiftS B z=i from ?_]; exact PaintIncomeS B c E W X u (by intro i; fin_cases i; exact H) z; simpa using dtransS B⁻¹ i -- order tune
   exact (ht _ p1).trans (ht _ p2).symm
 intro v s p'; let z:= dShiftS B⁻¹ s; obtain ⟨V',r⟩:=RoyalOut p B0 M pu A D B c dF S V v
 have hp(P':B_d)(H:bP F P'): K2 s v P'= (C_S) (K2 z V' F):=by
    unfold K2; rw[RowHoldS,RowHoldS]; let hp:= PaintIncomeS B c E W ![V'.val,F.val] ![v.val,P'.val] (by intro i; fin_cases i; exact r; exact H) z; rw [show s=dShiftS B z from ?_]; -- may z let? no rewrite in let...
    exact hp; simpa using (dtransS B⁻¹ s).symm
 exact (hp _ p1).trans (hp _ p2).symm
