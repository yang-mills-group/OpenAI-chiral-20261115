lemma BronteR (x:DiagramR (Fin n)): StronglyMeasurable (fun a: P.Spectrum0 3=> SugarR P a A_F x) ∧ FondR P A_F x = ∫ a,SugarR P a A_F x ∂P.pillars 3 :=by
 by_cases v:x∈ CardsR (Fin n); swap; · simp_rw[SugarR,FondR,show SπR _ _ x=_ from perim_R (P.publicH) _ v,show ∀ a,SπR (φ a) A_F x=0 from (fun a=> perim_R (φ a) A_F v)]; exact ⟨stronglyMeasurable_const, (integral_zero ..).symm⟩ -- tune
 obtain ⟨j,q⟩:= Set.mem_iUnion.mp v; obtain ⟨L,σ,L',G⟩:=OpenTollR P q
 let w:= OpenR j σ L; obtain ⟨A,W,h⟩:=MeshPhoto_S P x w (Opens_R ..) G
 let V (i:ℕ):= AskR P (A i); let X(a: P.Spectrum0 3):=P.privateH a
 let S:=BodyΘ P A_F j σ; let W'(a:ℕ):= SweepR j σ (A a) L none (legR j (A a) S)
 let F (i:ℕ)(a:P.Spectrum0 3):=SugarR P a A_F (V i); let f (a:P.Spectrum0 3):=SugarR P a A_F x
 have hx(C:CoinsR P):Tendsto (fun i=> SπR C.porch A_F (V i)) atTop (𝓝 (SπR C.porch A_F x)):= ((groundPlotR C.porch A_F e) x v).tendsto.comp (tendsto_nhdsWithin_iff.mpr ⟨W,Eventually.of_forall (fun i=>stanceOrbit_R (h i).2)⟩)
 have he(i:ℕ)(a:P.Spectrum0 3): F i a=P.portion j (P.otherSpectrum 3 j a) (W' i) :=by
    change SπR (X a) _ (V i)=_
    rw [show V i= AskR P (A i) from rfl,S_rawMeshR (X a) j σ _ L A_F e L' (h i).1 (h i).2]
    exact gns_state (P.portion j (P.otherSpectrum 3 j a)) _
 have H(i:ℕ): StronglyMeasurable (F i):=by rw [funext (he i)]; exact (P.axis_portion_cont ..).stronglyMeasurable -- tune args
 have hp(a:P.Spectrum0 3): Tendsto (fun i=> F i a) atTop (𝓝 (f a)):= hx (SΡχ P a)
 let A_μ := 1+∑ i: Fin n, ‖S i‖; let U:= A_μ^L.length; have p:1 ≤ A_μ:=le_add_of_nonneg_right (sum_nonneg fun i _=>norm_nonneg _)
 have H'(i:ℕ)(a:P.Spectrum0 3): ‖F i a‖≤ U:=by
    apply le_trans (le_of_eq (congrArg norm (S_rawMeshR (X a) j σ (A i) L A_F e L' (h i).1 (h i).2))); refine (Vbudget j (X a) (W' i)).trans (short_sS j L (A i) σ _ none A_μ p (fun k=>?_)); unfold legR; rw[ambient_norm]; exact (Finset.single_le_sum (f:=fun i=> ‖S i‖) (fun i _=>norm_nonneg _) (Finset.mem_univ k)).trans (le_add_of_nonneg_left zero_le_one)
 have hZ:Tendsto (fun i=>∫ a,F i a ∂P.pillars 3) atTop (𝓝 (∫ a,f a ∂P.pillars 3)):=tendsto_integral_of_dominated_convergence (fun _=>U) (fun i=>(H i).aestronglyMeasurable) (integrable_const U) (fun i=> Eventually.of_forall (H' i)) (Eventually.of_forall hp)
 refine ⟨stronglyMeasurable_of_tendsto _ H (tendsto_pi_nhds.mpr hp), tendsto_nhds_unique ((hx (ΔΕΡ P)).congr ?_) hZ⟩
 intro i; change FondR P A_F (V i)=_; rw[show F i=_ from funext (he i),P.grants]; exact S_rawMeshR (σρ) j σ (A i) L A_F e L' (h i).1 (h i).2
