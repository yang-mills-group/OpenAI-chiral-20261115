lemma sameNodeS (x:DiagramR (Fin n))(t:Axis→ℝ): SπR cost.porch A_F (fun i=>x i+t)=SπR cost.porch A_F x:=by
 let G:=fun i=>x i+t; by_cases v:x∈ CardsR (Fin n); swap
 · rw [perim_R _ _ v,perim_R]; intro h; obtain ⟨i,w⟩:= Set.mem_iUnion.mp h; exact v (Set.mem_iUnion.mpr ⟨i,fun j k p=>w (add_left_inj .. |>.mpr p)⟩) -- tune
 obtain ⟨i,w⟩:=Set.mem_iUnion.mp v; obtain ⟨L,σ,H,p⟩:=OpenTollR P w; have h:G∈ OpenR i σ L:=by
    refine (show RollBestR _ _ from p).imp (fun {j k} h'=>?_); unfold G; simp only [Pi.add_apply]; linarith
 rw [ηTenderR cost.porch L A_F e i σ _ H p,ηTenderR cost.porch L A_F e i σ _ H h]; let Z:=cost.porch i; let B:=BodyΘ P A_F i σ; let Y:= StageR σ Z B; apply Y.homogeneous
 intro t
 let X:= Z.BrightHab; have ht: X.unit.translation t.val Z.groundHab=Z.groundHab:= (SelectionAnalysis.invariant_glass Z.canopy (daylight (timeMesh P.par)) Z.Time Z.heat_share Z.groundHab).2 ?_ t.val -- tune args
 · unfold OS.Semigroup.unit at ht; simp only at ht -- tune
   let b:= OS.Semigroup.SEP i; change X.edge (t.val i) (X.U (b t.val) Z.groundHab)=_ at ht
   rw [show t.val i=0 from t.property,show b t.val=t from ?_,X.birth] at ht; exact ht
   apply Subtype.ext; change t.val-t.val i • basis i=_; rw [show t.val i=0 from t.property]; simp
 exact ⟨(SelectionAnalysis.lamp_fixed Z.Time Z.Ω).2 (fun t=>by rw [Z.heat,Z.still]), Z.Ω_ready⟩ -- name tune
