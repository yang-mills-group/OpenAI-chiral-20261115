abbrev cashSpotNX (Z:↥CompassN)(p:SU.Slot):ℂ:= YM.GaugeFieldConstruction.pay (sensation Z.val p) 1
lemma sprayΛNX (D:Fin 3× Bool)(i:SU.Slot)(k:i∈colors D): cashSpotNX g' i=GaugeFieldConstruction.pay (Flavor.mark (g'.val D.2) D.1) 1:=by -- ambiguity tag
 have h:family i=D:= (Finset.mem_filter.mp k).2; subst D; unfold cashSpotNX sensation; rw[familySNX]; rfl -- tune
lemma CardPhaseNX : SaberFe P g'.val (P.plaqueStakeNX A0) (βChiN g' A0.2.1 • P.plaqueStakeNX A0):=by
 intro n p
 let N:=P.calibration.c n; let TW:= twist (quantU (TVfe N g'.val)); let k:=A0.2.1; let S:=A0.1; let u:= βChiN g' k
 let a:= A0.2.2.1; let b:= A0.2.2.2; let U:=S.rollNX k a b N p
 change u • U= TW U; unfold U Lead.rollNX; rw[Finset.smul_sum,_root_.map_sum]; apply sum_congr rfl; intro i _; rw [smul_sum,map_sum]; apply sum_congr rfl; intro j _; rw [twist_scalar] -- tune
 let C:=VLeadNX k (S.laps p.1) i j; let x:=S.highlightNX a N i; let y:= S.lowlightNX b N j
 change u • (C • (create x* Fock.remove y)) = C • (TW (create x*Fock.remove y)); by_cases e : C=0; · rw [e,zero_smul,smul_zero,zero_smul]
 obtain ⟨h,h'⟩:= VLead_PNX k e
 let v:= cashSpotNX g' i; let w:=cashSpotNX g' j; have he: Star.star w=w:=by unfold w cashSpotNX; cases sensation g'.val j <;>simp -- tune
 let H:=TVfe N g'.val
 have hp: acts H.val x=v • x:=by unfold x Lead.highlightNX; rw[MatrixFe.rayHP,streetN]
 have hz: acts H.val y=w • y:=by unfold y Lead.lowlightNX; rw [MatrixFe.rayHP,streetN]
 have hx: v*w=u:=by
    unfold v w; rw [sprayΛNX g' _ _ h,sprayΛNX g' _ _ h']; unfold u βChiN βbitN bit; simp only; cases Flavor.mark (g'.val k.1) k.2.1<;> cases Flavor.mark (g'.val k.1) k.2.2<;>simp
 rw [map_mul TW, twist_create,twist_remove,hp,hz,map_smul]; unfold Fock.remove; rw [map_smul,star_smul,he, Matrix.smul_mul,Matrix.mul_smul]; simp_rw [smul_smul]; rw[←hx]; ring_nf -- tune needs ac_rfl
lemma EpochSpurNX (e:EpochEFe P s) : P.publicBill s (P.plaqueStakeNX A0)*βChiN g' A0.2.1=P.publicBill s (P.plaqueStakeNX A0):=by
 rw[mul_comm,← show P.publicBill s _ = _ from (show P.publicBill s (βChiN g' A0.2.1 • P.plaqueStakeNX A0)=βChiN g' A0.2.1 * P.publicBill s (P.plaqueStakeNX A0) from map_smul (EvLB P s) _ _)]; exact e _ _ _ (CardPhaseNX (P:=P) g' A0) -- tune
lemma CardStageNX (e:EpochEFe P (SportR P m s)): SaberFe P g'.val (P.SunPlateNX A0 m s) (βChiN g' A0.2.1 • P.SunPlateNX A0 m s):=by
 let u:= P.ScaleFlagNX m s; let X:= P.plaqueStakeNX A0; let B:=βChiN g' A0.2.1; let V:=u • X; let k:= SportR P m s
 have ht: SaberFe P g'.val V (B • V):=by unfold V; rw[smul_comm]; exact (CardPhaseNX (P:=P) g' A0).scale u
 let c:= P.publicBill k V; have he:B*c=c:=by rw[← show P.publicBill k (B • V) = B*c from map_smul (EvLB P k) _ _]; exact e _ _ _ ht
 let I:= (1:P.Test); change SaberFe P _ (V-c • I) (B • (V-c • I)); rw[smul_sub,smul_smul _ _ I,he]; exact ht.diff ((feeP_1 g'.val P).scale c)
lemma TossStampNX (e:EpochEFe P (SportR P m s))(v:ExposureFrameNX):SaberFe P g'.val (PupilFNX P B v m s) (PupilFNX P B (fun i=>βChiN g' i.1*v i) m s):=by
 let A(i:ExposureIndexNX):= P.SunPlateNX (B,i) m s
 have ht(K:Finset ExposureIndexNX):SaberFe P g'.val (∑ i∈K,v i • A i) (∑ i∈K,(βChiN g' i.1 * v i) • A i):=by
    induction K using Finset.induction with
    | empty=>rw [sum_empty,sum_empty]; exact show SaberFe P g'.val 0 0 from (by simpa only[sub_self] using ((feeP_1 g'.val P).diff (feeP_1 g'.val P)))
    | insert i K h ih=>rw[sum_insert h,sum_insert h,mul_comm (βChiN g' i.1),mul_smul]; exact (((CardStageNX m g' (B,i) e).scale (v i)).together ih)
 exact ht univ
