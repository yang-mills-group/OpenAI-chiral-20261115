 unfold FDeskCQ
 cases z with
 | none=> change WayMoveR _ _ _∈_; rw[vacWay_R]; let h:= (UnitσP p B0 M 0 (1,false) _ pu A _ D (Wp.go 0 (1,false) (ΤbandR u)) (s:=f0) le_rfl (1:ℂ)); rw[show (1:ℂ) • CandΛJ P= _ from (show _= CandΛJ P from (by funext i a b; exact one_smul ℂ _))] at h; exact h
 | some z=> obtain ⟨w,t⟩:=z; have hw:w=_:=hX _ rfl; subst w
            let F:= MeshΦ p B0 M Y R _ pu A _ D (Wp.go Y R (ΤbandR u)) s0 (κEye t)
            have hv:F∈αι Y u:=by
                rw [←orientP_R p B0 M Y R pu A D u Sq Wp s0]; let h:= (Δmk p B0 M Y R _ pu A _ D (Wp.go Y R (ΤbandR u)) s0 (κEye t) 0); have h0:(0:ℂ) • CandΛJ P = 0:=by funext i s t; simp only[Pi.smul_apply,Pi.zero_apply]; exact zero_smul _ _
                rw[h0,add_zero] at h; exact h
            let he:=PanWayR p B0 M Y pu A D u Sq Wp (-Y) F hv; rw[add_neg_cancel] at he; exact he
