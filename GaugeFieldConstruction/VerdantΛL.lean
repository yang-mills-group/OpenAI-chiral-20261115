lemma glideHereΛL: TreeΛL (N:=N) (ΥoneΛL H):=by
 intro n k V h x e
 let U:= H.TinCanL.symm∘ V; have hx:H.TinCanL ∘ U=V:= funext fun i=> H.TinCanL.apply_symm_apply _
 have hv:= H.TinCanL.injective (a₁:=U k) (a₂:=Empire.one four) ((congr_fun hx k).trans h) -- tune
 have he:= ΡCoinΛL H G wZ wX U k hv x e; rw [hx,show H.TinCanL ∘ remΛ k U=remΛ k V from congrArg (remΛ k) hx] at he; exact he
lemma MerryMarchΛL: MeridianΛL p H (Z:=Z) W N s wF FHS where
 corners n V x y u i h:= EastPorousΛL H G wZ wX V x y i h u -- tune args check
 euprice n V x u:= (αRespiteΛL H G wZ wX _ _ u).symm
 unit f:= TrueCoinΛL wU wX (ΥoneΛL H) (glideHereΛL p H G W F N s d wX wE) f (wF).operators (FHS).total _ (FHS).adj (FHS).meets
 field g a b f:= LocalCapeΛL p H wF s FHS d.labels g a b _ -- tune
 symm i j:= congrArg H.TinCanL (ΜΛSymL p i j)
 adj a b:= LocalStarsΛL p H wF d.withStar a b
 conserve:= WConΛL p H G wZ wU wX wE
 conserve_ops a f:= ΓWardHereΛL (Τ_Φ) (WConΛL p H G wZ wU wX wE) _ (FHS).total a _ (FHS).adj (FHS).meets f
 rotates a x f v:= LeafActΛL a f wF FHS (M_ν x) v
 hugs n V k a:= fun x q b e=> HonestWardΛL p H G wZ wX wE V k a q b e
 transWard n V k a X:=⟨ΔSignΛL p H G W F N wZ wU wX wE V k a X,fun h=> h.symm ▸ ΔTrueΛL p H G W F N wZ wU wX wE V k a⟩
 inserted n V k a f:= LeafWHereΛL H (Y:=W) V k a f
 lock U A:= LockerΛSymL FHS _
 localPo U V e A B:= StripeBΛL FHS _ _ e A.property B.property
 localObserveEU U o e B G' Y K Q i a b V:= ΓRibbonΛL H G G' wZ wU wX a b i U o e V
 localObserveW U o e Y K Q i a t:= (LocalDetermineΛL wX i d.inlet.habitat a U o e t).symm
 sameCloud M u q p:= OrbitUniqΛL FHS u (p.trans d.withStar.symm) (q.trans d.labels.symm)
