variable {I J:Type}[Fintype I][Fintype J]
private lemma loaf (e:I ≃J)(v:I→Waves)(q:FrameK J): Woof q (v ∘ e.symm) = Woof (q ∘ e) v:=by unfold Woof; exact Fintype.sum_equiv e.symm _ _ (fun i=>by simp)
lemma MatchB (e:I ≃J)(v:I→Waves)(g:I→ℕ)(u:Planaris g ΓProj j v τ): Planaris (g ∘ e.symm) ΓProj j (v∘ e.symm) τ:=by
 refine ⟨fun i=>u.ray _,fun i=>u.bounded _,fun x p=>?_,fun i n=>u.saturated (e.symm i) n,fun w=>?_⟩
 · obtain ⟨a,v⟩:=u.coframe x p; refine ⟨a∘e.symm,?_⟩; rw [loaf,Function.comp_assoc,e.symm_comp_self ..]; exact v -- tune assoc
 rw [loaf]; apply le_trans (le_of_eq ?_) (u.brake (w ∘ e)); unfold LoomK; exact Fintype.sum_equiv e.symm _ _ (fun i=>by simp)
variable {m B:Side}
open TableF.Lenten.Bank
local notation "vA"=>mid m B
variable (S:Sweep (mid m B))
abbrev gyreJ (S:Sweep (mid m B)): Waves→ Waves := Mason S
private lemma zero_wick : gyreJ S 0=0:=by exact (show ∀ {A:Type}(P:TPack A),letI:=P.G;∀ (f:A→A), f (0+0)=f 0+f 0→ f 0=0 from fun {_} T=>by letI:=T.G; intro f h; rw [add_zero] at h; exact Eq.symm (add_left_cancel ((add_zero _).trans h))) Packs_U _ (sheen_plus ..)
lemma Woof_rot (q:I→Waves)(A:FrameK I): Woof (fun i=>payZ S (A i)) (Mason S∘q) = gyreJ S (Woof A q):=by
 letI:= kinnA; let m:Waves→+ Waves:= {toFun:= Mason S,map_zero':=zero_wick S,map_add':=fun i j=>sheen_plus ..}; unfold Woof; change _=m _; rw [map_sum]; exact sum_congr rfl (fun i _=> (payY_a ..).symm)
lemma payCost (i:ℂ):‖payZ S i‖=‖i‖:=by unfold payZ cSignX; split <;> simp -- tune
abbrev WindRate (τ:ℝ):=τ*(1+tilos)
lemma WindMore (u:0≤τ): τ ≤ WindRate τ:=le_mul_of_one_le_right u (by linarith only [show 0≤tilos from abs_nonneg _]) -- positivity ≥
lemma WindJ (v:I→Waves)(g:I→ℕ)(p:0≤τ)(u:Planaris g ΓProj j v τ):Planaris g ΓProj j (gyreJ S ∘v) (WindRate τ):=by
 have hT:0≤tilos:=abs_nonneg _
 refine ⟨u.ray,fun i=> (sheen_norm ..).trans ((mul_le_mul_of_nonneg_left (u.bounded i) hT).trans (by unfold WindRate; nlinarith only [p])),fun x h=> ?_,fun i t=>?_,fun x=>?_⟩
 · have h':ΓProj j (gyreJ S⁻¹ x)=gyreJ S⁻¹ x:=((Slot_sh (s:=S⁻¹) x j).trans (congrArg _ h)) -- tune
   obtain ⟨w,z⟩:= u.coframe _ h'; refine ⟨fun i=>payZ S (w i),?_⟩
   change _=Woof (fun i=>payZ S (w i)) (Mason S ∘ v); rw[Woof_rot,←z]; exact ( (show Mason S (Mason S⁻¹ x)=x from by rw[lands_t,inv_mul_cancel,lands_o])).symm
 · change MSlot t (Mason S _)= _; rw[Slot_sh,show MSlot t _= _ from u.saturated i t]; split_ifs; rfl; exact (zero_wick S)
 let U:= S⁻¹; let y:=fun i=>payZ U (x i); let v':= gyreJ S∘v; have hx: Mason U ∘ v'= v:= funext fun i=> (show Mason S⁻¹ (Mason S _)= _ from by rw [lands_t,mul_inv_cancel,lands_o]); have he:= Woof_rot U v' x; rw [hx] at he
 rw [show LoomK x=LoomK y from (Finset.sum_congr rfl (fun i _=> (payCost _ _).symm))]; apply (u.brake y).trans; change _* ‖Woof (fun i=>payZ U (x i)) v‖≤ _; rw[he]; apply le_trans (mul_le_mul_of_nonneg_left (sheen_norm _ _ _) p); unfold WindRate; rw [←mul_assoc]; gcongr; linarith only [hT] -- tune
end
