abbrev JωL (θ:BandS→ℕ) := ∀ a:BandS,Fin (θ a)→ ℕ
abbrev TreatyS (θ:BandS→ℕ)(w:SωJ θ)(t:JωL θ)(τ:ℝ):Prop:=∀ i:BandS,Planaris (t i) ΓProj i.val (w i) τ
lemma passportJ :∀ᶠ t:ℝ in atTop,∃ θ w p,TreatyS θ w p t:=by
 obtain ⟨t,h,v⟩:= Tower.VacuumSelection.Spine.Pre_sol; filter_upwards [eventually_ge_atTop t] with s p; have h' := v _ p; have H(i:BandS):∃ m:ℕ,∃ (x:Fin m→ Waves)(t:Fin m→ℕ),Planaris t ΓProj i.val x s:=by
     obtain ⟨I,z,l,b,h⟩:=h' i.val (by have he:=i.isLt; omega); letI:=z; exact ⟨_,_,_, MatchB _ _ (Fintype.equivFin _) b l h⟩ -- tune
 choose D B g v using H; exact ⟨D,B,g,v⟩
