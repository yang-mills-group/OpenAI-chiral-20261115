lemma Foxtail (s:ℕ)(a:f ≤ s)(b:s ≤ u):FundQ p V w s (b.trans hu):=by
 induction b using Nat.decreasingInduction with
 | self=> exact A'
 | of_succ s b ih=>
    let g:=G'.trans a; let u:=Y.uv k -- shadow
    have b':= lt_of_lt_of_le b hu; let W:= F.earth g b'
    let Xκ:= Xrace ((PlaceOf Y i k s).step P.V) P_ (p.σ (s+1)); let S:= Ask Y i k Xκ (V.Br s).R (Lapse (V.Br s).K) 0; let T':=MstepJ s p V
    have z:=P'.turn a b
    have hV:κWork G _ w Xκ:=by unfold Xκ Xrace; rw[g0.loop s a b']; exact r.camp a b'.le
    have hv:Entourage Y i k w ZQ (fun _=>False) b'.le S T':= TripStep Y i k F.kq w ZQ (fun _=>False) (V.Mark (s+1)) W.U W.V W.Toll W.sign P_ _ _ _ _ _ z b' MoTr hV (r.camp (Nat.le_succ_of_le a) b') (ih (Nat.le_succ_of_le a))
    let A:= p.mark s; have hx:= Px s a b; let C:= reflux ((p.birth s).toFinset) (p.Pp s); let R:=ΩBirthJ Y i S A (p.birth s); let M:= BornMarkJ Y i k b'.le T' A (p.birth s)
    have h:T'=M:=by funext i; symm; exact if_neg (by simp[hx]) -- tune occurrences Lean not find A
    have h':R=S:=by
       unfold R; rw[hx]; unfold ΩBirthJ; funext L t; unfold slipListJ; simp only[List.reverse_nil,List.filter_nil,List.map_nil,List.prod_nil]
       rw[Leave_l, show wingR L ([].toFinset)=L from (by simp [wingR,wingX])]; unfold banquetJ; exact act_one .. 
    change Entourage Y i k w ZQ (fun _=>False) _ (Ask _ _ _ (P_.F_v (p.σ s)) (V.Roll s).F (V.Roll s).E 0) (V.Mark s); rw[P'.book a b,P'.lay a b]; let Z:= F.FrescoBJ p s a b' G' V
    change Entourage Y i k w ZQ (fun _=>False) _ (Ask _ _ _ (P_.F_v (p.σ s)) Z.F Z.E 0) (perturbJ Y i Xκ M C); rw[← h]
    refine twist0T _ _ _ _ _ _ _ _ _ (coast_J Y i k F.kq w ZQ (fun _=>False) _ R T' Xκ C hV (h'.symm ▸ hv)) _ ?_
    intro L pX; apply (Papal.actually_ok Y _ _ _ b'.le).mono; intro x ε
    let ht:= g0.loop s a b'; rw[← ht]; exact WarpYL Y i k W.U W.V W.Toll W.sign P_ _ (V.Br s) (V.Roll (s+1)) (p.tour s) (p.grade (s+1)) z (p.birth s) (g0.unique a b') (p.Pp s) (F.cod s) (g0.voyage a b') (by rw [ht]; exact g0.force a b'.le) (p.paper s) (by rw[ht]; exact g0.hot a b') (F.broom (G'.trans a) b').1 (F.broom (G'.trans a) b').2 A (by unfold Xrace; rw[ht]; exact r.proof_m a b') L (gala_ψ Y i w _ hV L pX) x ε
