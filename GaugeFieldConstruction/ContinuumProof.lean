   (continued:=continued) (model:=model) (screens:=screens))
/-- Claims within the theory of this manuscript. See each component
 definition here in the `ContinuumConstruction` namespace. Spine etc. from
 the primary application. `TwoFixedProbeExperiments` statement includes
 the new tests as well as the comparison & retention of that exact receipt;
 not claiming all estimates on approaches discussed in the construction notes. -/
structure OneTheory : Prop where
 bare : BareMeasurementsOnOnePath (scale:=scale) (vacuum:=vacuum) (screens:=screens)
 ranks : ExactRankAndFreePayment
 transfer : StressSpaceOnThisSystem (stress:=stress)
 active : AfterTheLift (stress:=stress)
 trajectory_tests : InteractionEraStressPayments (vacuum:=vacuum) (stress:=stress)
    (screens:=screens) (scale:=scale)
 M1to5 : ActualLimitingBounds (stress:=stress)
 L2 : InOurPhaseSector (vacuum:=vacuum) (stress:=stress)
 reconstruction : ReconstructedFieldSystem (continued:=continued) (model:=model)
    (scale:=scale) (screens:=screens)
 generation : StressGeneratesTranslationsHere (continued:=continued) (model:=model)
 contact_calibration (Z:Lead.Clan): Tendsto (fun s=>process.cFlatstockNX s Z) atTop
    (𝓝 (purePrice Z:ℂ))
 colour : FieldsWithColor (model:=model)
 interaction : TwoFixedProbeExperiments Certificate
 uses_these_fields : PriceTheSameFields (continued:=continued) (vacuum:=vacuum) (stress:=stress) (screens:=screens) (scale:=scale)

/-- Flagship. Actual one primary-Spine theory. No charge operators
 used or asserted here. (Conservation & translation **Ward identity** on
 the same W distributions; see `ContinuumGenerators`.) See `ContinuumPayments`
 for what limiting estimates are (and with what qualifications; in M1to5
 including further powers of profile variables, not generic
 coincident-point bounds). See `ContinuumExperiments` for the fixed probe and
 interaction tests. Choice of variants of the route explicit. -/
theorem satin_theory_with_total_stress_tensor :
  ∃ (nLeaf : ℕ)
    (process : Spine)
    (scale : process.Register)
    (production : YardμN process CostUpVU PolRun PriceArtVU nLeaf)
    (growth : InterR)
    (roles : ConsoleθN production ΓmotVU 0 growth ΓstageVU)
    (axes : Axis → GaugeFieldConstruction.Empire.Across)
    (comparison : Sheds roles.Crew_N axes)
    (approvals : Supplies comparison)
    (stress : Ticket roles.Gamma_N approvals)
    (vacuum : process.Spectrum0 3)
    (costAnalysis : process.Ellis 3 vacuum)
    (c : ℕ → ℕ)
    (collars : ℕ→ℕ)
    (layers : NSF.Boundary.Waves (roles.RadianceVU stress))
    (response : NSF.Boundary.Surface (roles.RadianceVU stress))
    (continued : NSF.Boundary.Surface.Aurora response NSF.LD.drapeL)
    (model : roles.GlowVU stress vacuum (le_refl _) layers response)
    (screens : process.Poll 3)
    (Certificate : Assembled (scale:=scale) (costAnalysis:=costAnalysis) (c:=c)
       (collars:=collars) (continued:=continued) (model:=model) (screens:=screens)),
    OneTheory Certificate:=by
 obtain ⟨n,P,K,d,A,X,T,G,W,p,x,H,c,r,L,R,S,J,q,E⟩:= assembled
 exact ⟨n,P,K,d,A,X,T,G,W,p,x,H,c,r,L,R,S,J,q,E,
   charged_bare E,ranks,active_system,lift_achieved,
   weak_calibration_at_actual_normalization E,estimates_holding_here,
   sector_embedding E,realized E,generates E,wick_asymptotic,
   flavours_of_theory E,earned_here E,correspondence E⟩
#print axioms satin_theory_with_total_stress_tensor
