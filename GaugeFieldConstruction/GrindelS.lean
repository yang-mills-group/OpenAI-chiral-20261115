 obtain ⟨l,u,w⟩:=p j; exact char_R (And.intro u (List.Pairwise.imp (fun h=> sub_pos.mp ((mul_pos (by norm_num: (0:ℝ)<6) v).trans_le h)) w))
lemma PinsEdgeS (P:Spine)(r:ℕ): LobeS (WishGap_S P r) (rεS P r):=by
 intro i; refine ⟨[0,1],deckΦP _,?_⟩; unfold BuntR; simp; rw [τPe]; split_ifs <;> norm_num
