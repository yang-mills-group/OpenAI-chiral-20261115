 have hy(k:Fin 2): Y k ∈ PerlSetR (s k):=by fin_cases k; exact ⟨value1R U u i,le_rfl⟩; exact ⟨value1R U u j,le_rfl⟩ -- binder name tune
 have h:= ComparesPairS p B0 M pu A D Q t u' H m S V s Y a b hy vp
 have G:=PantallaS p B0 M pu A D Q t u' H m (show Tendsto (fun i:ℕ=>i) atTop atTop from tendsto_id) s S V Y a b hy vp (by rw[Fintype.card_fin]; decide) (DuoS_R Y) h (rεS P) zεS (pinΕS P) pinNow (Eventually.of_forall (PinsEdgeS P)) (fun _=> wδ)
