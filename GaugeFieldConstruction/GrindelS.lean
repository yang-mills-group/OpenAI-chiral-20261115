private lemma PortoNightS (x:GaugeFieldConstruction.Calibration.Shell)(h:x∈ UniComR u): Mirror.night x∈ UniComR u:=by
 obtain ⟨⟨a,rfl⟩,p'⟩:=h; exact ⟨⟨_,(Mirror.price u a).symm⟩,show starRingEnd ℂ a.1=0 from (congrArg (starRingEnd ℂ) (show a.1=0 from p')).trans (map_zero _)⟩
-- reflection rank on true columns even with zero relations. unselected. 
lemma CreekKernelS (a: U.RootS u→ℂ)(p:∀ j:U.RootS u, stare (couples (SpineM (PaddleK U u j)) (EmissionR U u a))=0): a=0:=by
 by_contra! h; let w:=EmissionR U u a; have hw:w≠ 0:= fun g=>h ((EmRank U u) (g.trans (map_zero _).symm)); have hz:w∈ UniComR u:= (EmOutreach ..) ▸ LinearMap.mem_range_self _ _; have hn:= PortoNightS u w hz
 rw [←EmOutreach U u] at hn; obtain ⟨z,p'⟩:=hn
 obtain ⟨x,xp⟩:=hz.1; let F:=couples (Mirror.night w) w; have hx:0<(stare F).re:=by
    unfold F; rw[←xp,Mirror.price]; exact Invoice.mirror_positive u x (by rintro e; rw[e,map_zero] at xp; exact hw xp.symm) -- tune
 have he:stare F=0:=by
    unfold F; rw[←p',EmStyle]; unfold BlendSunR; rw [map_sum,LinearMap.sum_apply,map_sum]; exact Finset.sum_eq_zero (fun j _=> by rw[map_smul,LinearMap.smul_apply, map_smul,p,smul_zero]) -- tune rewrite
 rw [he,Complex.zero_re] at hx; exact lt_irrefl _ hx
