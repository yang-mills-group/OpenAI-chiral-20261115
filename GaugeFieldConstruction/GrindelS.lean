lemma Oscense_S (i j:U.RootS u) : Tendsto (fun k=> SπR P.publicH ![pE i k,pE j k] (LεS P k)) atTop (𝓝 (stare (couples (SpineM (PaddleK U u i)) (SpineM (PaddleK U u j))))) :=by
