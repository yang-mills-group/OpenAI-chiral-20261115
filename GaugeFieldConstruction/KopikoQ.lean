 let A1:= fun n=>AskR P (A n); have hv:Tendsto (fun n=> K false (A1 n)) atTop (𝓝[CardsR (Fin (n+1))] K false x):= tendsto_nhdsWithin_iff.mpr ⟨h0.continuousAt.tendsto.comp p, Eventually.of_forall fun i=> stanceOrbit_R (MasksTailQ _ _ _ (V i).1.2)⟩ -- tune spaces
