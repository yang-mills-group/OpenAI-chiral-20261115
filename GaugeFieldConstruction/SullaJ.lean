abbrev ArchBuildJ (F:E→M): FrameK E→ₗ[ℂ] M where
 toFun:= W_s F
 map_add' x y:=by unfold W_s; simp only [Pi.add_apply,add_smul,sum_add_distrib]
 map_smul' x y:=by unfold W_s; simp only[Pi.smul_apply,smul_eq_mul,RingHom.id_apply,Finset.smul_sum,←mul_smul]
lemma Arach_B (F:E→M)(x:E): ArchBuildJ F (κEye x)=F x:=by
 change W_s F _= _; unfold W_s; rw [sum_eq_single_of_mem (s:=univ) x (mem_univ _)]; · rw [show κEye x x=1 from (by simp [κEye,Pi.single_apply]),one_smul]
 intro i _ h; rw [show κEye x i=0 from (by simp [κEye,Pi.single_apply,h]),zero_smul]
def pBanJ (F:E≃ O): FrameK E≃ₗ[ℂ] FrameK O where
 toFun g:= g∘ F.symm
 invFun g:=g ∘ F
 left_inv g:=funext fun i=>by simp
 right_inv g:=funext fun i=>by simp
 map_add' _ _:=rfl
 map_smul' _ _:=rfl
lemma Ban_L (F:E≃ O)(x:FrameK E): LoomK (pBanJ F x)=LoomK x:=by unfold LoomK; refine Fintype.sum_equiv F.symm _ _ ?_; intro i; rfl
lemma Ban_s (F:E≃ O)(x:FrameK O): LoomK ((pBanJ F).symm x)= LoomK x:=Ban_L F.symm x
lemma ban_i (F:E≃ O)(x:E): pBanJ F (κEye x)=κEye (F x):=by
 funext i; obtain ⟨i,rfl⟩:=F.surjective i; change κEye x (F.symm (F i))= _; rw[F.symm_apply_apply]; by_cases h:i=x
 · simp [h,κEye]
 have t:=F.injective.ne h; simp [κEye,Pi.single_apply,h,t]
