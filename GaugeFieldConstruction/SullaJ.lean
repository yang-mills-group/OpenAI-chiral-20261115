 constructor; intro s u b; have h(i:E):= starGap_T s F p g0 G' V pV K (L i) (lt_of_lt_of_le b a) u (χ s u b i)
 let m':=(μδ:ℂ); let T:= SequelJ V K N; let g:= GapPJ V K L; let Y':= GapDJ p V K N L; let S:= GapSJ p V K L; let r:=s+1
 let U: FrameK E→ₗ[ℂ] Mark (side Y i (Y.uv k)):= m' • g s+(T r).comp (Y' s)+(S s).smulRight 1
