lemma Trek_s (a:f≤ s)(b:s<n): Clipζ (q s) X A → Clipζ (q (s+1)) X (κB p g μ0 s A):=by
 let T':= p.a s; let C:=p.C s; let H:=A.1; let d':=A.2; let A':=κB p g μ0 s A
 have T:=Q.pass a b; let Y':=g.G s; let Ω:=g.ε s; let q':=q (s+1); intro ⟨c,dF⟩; constructor
 · intro x; change LoomK (Tt_ • C (H x)+Y' x)≤_; have he:= Q.bound;  
   apply le_trans ((loomer_T _ _).trans (add_le_add_right ((hg.turn s a b).1 x) _)) -- order likely add_le_add_right is left term fixed (per earlier) need right. 
   rw [loomer_J,Complex.norm_real,Real.norm_of_nonneg Q.small]; apply le_trans (add_le_add_left (mul_le_mul_of_nonneg_left ((pu.turn s a b).1 _) Q.small) _)
   let y:=LoomK x; refine le_trans (b:=(μ0*S₀*X+mR)*y) ?_ (mul_le_mul_of_nonneg_right Q.heatH (noLoom x))
   nlinarith only [mul_le_mul_of_nonneg_left (c x) (mul_nonneg Q.small (zero_le_one.trans Q.bound))] -- y
 intro x; change ‖Tt_ • (d' x - T' (H x))+ Ω x‖≤ X*q'*_; have he:= Q.pass a b; let Y:=LoomK x; have hx:0≤ Y:=noLoom _; have v:= (hg.turn s a b).2 x; have hF :=(pu.turn s a b).2.2.2 (H x); let V':=q s; have ht:0 ≤ V':=(Q.hot a b.le).le; have hp:=dF x
 refine (norm_add_le ..).trans (le_trans (add_le_add le_rfl v) ?_); rw [smul_eq_mul, norm_mul,Complex.norm_real,Real.norm_of_nonneg Q.small]; have hz : ‖d' x - T' (H x)‖≤ (X +χ*X)*V'*Y :=by
    have hm : ‖T' (H x)‖ ≤ χ*V'*(X*Y):= hF.trans (mul_le_mul_of_nonneg_left (c _) (mul_nonneg Q.κPrice ht))
    exact (norm_sub_le ..).trans (le_trans (add_le_add hp hm) (le_of_eq (show X*q s*LoomK x+ _ = _ from (by unfold V' Y; ring))))
 refine (add_le_add_left (mul_le_mul_of_nonneg_left hz Q.small) _).trans ?_
 have ha: 0≤ X+χ*X:=add_nonneg Q.hPrice (mul_nonneg Q.κPrice Q.hPrice); have hue:0 ≤ μ0*(X+χ*X)+μ0*χ:=add_nonneg (mul_nonneg Q.small ha) (mul_nonneg Q.small Q.κPrice); let V:= μ0*(X+χ*X)+μ0*χ
 change _+μ0*(χ*V')*Y ≤ X*q'*Y; apply le_trans (le_of_eq (show μ0*((X+χ*X)*V'*Y)+ μ0*(χ*V')*Y= V*V'*Y from (by unfold V; ring)))
 apply mul_le_mul_of_nonneg_right _ hx; have hp:0≤q':= (Q.hot (a.trans (by omega)) b).le; exact (mul_le_mul_of_nonneg_left he.2 hue).trans (le_trans (le_of_eq (show V*(2*q') = (μ0*(2*X+χ*2*X)+ μ0*(χ*2))*q' from (by unfold V; ring))) (mul_le_mul_of_nonneg_right Q.heatA hp))
include a
