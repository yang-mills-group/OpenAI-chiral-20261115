lemma OrbisWorkSt (F A' Y:↥B_d)(p1:bP F A')(p2:bP F Y): A'=Y:=by
 let E:=ΔΕΡ P; let W:= BonusW_S P B c; let h:=EnterΦS p B0 M pu A D dF S V
