   have ht(P':B_d)(H:bP F P'): K1 i ![P']=(C_S) (K1 z ![F]):=by
      let u:Fin 1→ScreensJ P:=fun j=> (![P'] j).val; change SπR _ u i=(C_S) (SπR _ X z); nth_rw 1 [←show dShiftS B z=i from ?_]; exact PaintIncomeSt B c E W X u (by intro i; fin_cases i; exact H) z; simpa using dtransS B⁻¹ i -- order tune
   exact (ht _ p1).trans (ht _ p2).symm
 intro v s p'; let z:= dShiftS B⁻¹ s; obtain ⟨V',r⟩:=RoyalOut p B0 M pu A D B c dF S V v
 have hp(P':B_d)(H:bP F P'): K2 s v P'= (C_S) (K2 z V' F):=by
    unfold K2; rw[RowHoldS,RowHoldS]; let hp:= PaintIncomeSt B c E W ![V'.val,F.val] ![v.val,P'.val] (by intro i; fin_cases i; exact PaintLevelSt B c r; exact H) z; rw [show s=dShiftS B z from ?_]; -- may z let? no rewrite in let...
    exact hp; simpa using (dtransS B⁻¹ s).symm
 exact (hp _ p1).trans (hp _ p2).symm
