lemma φ_limits_St (X Y: Fin n→ScreensJ P)(p:∀ i,PaintWithLevelSt B c (X i) (Y i))(x:Fin n→P.VMark) :let y: Fin n→ P.VMark:=fun i=>pShiftS B (x i)
 ∃ F F':ℕ→Fin n→P.Test, (∀ i, VistaX (x i) (WayMoveR P (x i) (X i)) (fun v=>F v i))∧ (∀ i,VistaX (y i) (WayMoveR P (y i) (Y i)) (fun v=>F' v i))∧∀ᶠ j in atTop,∀ l:List (Fin n), VogueκS P (PrimeScriptR B 0) c (l.map (F j)).prod (l.map (F' j)).prod:=by
 intro y; choose a b h g t using p; let F(s):=fun i=> PoseF_S (x i) (a i) s; let Ty (l):= fun i=> PoseF_S (y i) (b i) l
 refine ⟨F,Ty,fun i=>?_,fun i=>?_,?_⟩
 · exact VistaFootSt (h i) (x i)
 · exact VistaFootSt (g i) (y i)
 filter_upwards[eventually_all.mpr t,eventually_all.mpr fun i=> mint_voxel (x i)] with j q g
 have he(i:Fin n): VogueκS P Bc c (F j i) (Ty j i):=by
    let u:= (g i).choose; have hp: P.vtile j u=x i:= (g i).choose_spec
    have ht: P.vtile j (B⁻¹.act u)=y i:=by rw [←mintShiftS,hp]
    have H:∃ u,P.vtile j u=y i:=⟨_,ht⟩
    unfold F Ty PoseF_S; rw [dif_pos (g i),dif_pos H, show H.choose=B⁻¹.act u from tightPinS P j _ _ (H.choose_spec.trans ht.symm)]; exact q i u
 intro l; induction l with
 | nil=> simpa only[List.map_nil,List.prod_nil] using (show VogueκS P Bc c 1 1 from Festive.unit)
