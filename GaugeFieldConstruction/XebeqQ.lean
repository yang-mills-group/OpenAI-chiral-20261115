abbrev MainFYQ (x:X) : ClaimQX X θ:= soleQ d l x 2 (peersQ D x)
lemma learnMQ (x:X):RégisQ (MainFYQ D d l x):=by
 let F:= D false; let S:= D true
 let K(v:BeamMQ θ):=folkQ (X:=X) v
 let L(v:BeamMQ θ) (k:Bool):= K v k x
 let C:= peersQ D x
 have q(v:BeamMQ θ)(k:Bool): (TolJ Cg θ).kind (L v k)=true:= (Facingκ θ ((tagHQ k) x,v.1) v.2).property.2
 let W:= tag (MainFYQ D d l x) x; let T:=OrbitSailJ θ (tagHQ (X:=X) false); have hp:(TolJ Cg θ).kind (T W)=false:=decide_eq_false (show ((2:finsJ).succ)≠0 from Fin.succ_ne_zero _)
 have h1(p)(t:p∈ C):∃ (v:BeamMQ θ) (k:Bool),p=L v k:= by
    rcases List.mem_append.mp t with w|w <;> obtain ⟨v,t,g⟩:= List.mem_map.mp w
    · exact ⟨v,false,g.symm⟩
    exact ⟨v,true,g.symm⟩
 apply solePaidQ (X:=X)
 · change galaJ _ C; change galaJ _ C; change galaJ (TolHouseJ θ) (tagMQQ F false x ++ tagMQQ S true x); cases F <;> cases S
   · exact List.Pairwise.nil
   · exact List.pairwise_singleton ..
   · exact List.pairwise_singleton ..
   exact List.pairwise_cons.mpr ⟨fun i t=> (List.mem_singleton.mp t).symm ▸ (show (tagHQ false x) < tagHQ true x from Prod.Lex.right x (by decide : false < true)), List.pairwise_singleton ..⟩ -- tune syntax tagHQ
 · change (tagMQQ F false x ++tagMQQ S true x).length ≤ 2; cases F<;>cases S<;>simp [tagMQQ]
 · intro i t; obtain ⟨v,k,rfl⟩:= h1 _ t; rfl
 intro v; obtain ⟨c,k,t⟩:= h1 _ v; exact Bool.noConfusion (hp.symm.trans ((congrArg (TolJ Cg θ).kind t).trans (q c k)))
lemma folk_paidQ (x:X):∀ i∈peersQ D x,(TolJ Cg θ).kind i=true:=by
 intro i t; rcases List.mem_append.mp t with v|v<;> obtain ⟨j,w,e⟩:=List.mem_map.mp v
 · exact (((congrArg (TolJ Cg θ).kind e).symm).trans (Facingκ θ (tagHQ false x,j.1) j.2|>.property.2))
 exact (((congrArg (TolJ Cg θ).kind e).symm).trans (Facingκ θ (tagHQ true x,j.1) j.2|>.property.2))
