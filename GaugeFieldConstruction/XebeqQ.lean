   have hg:= primAJ P.run i k s θ Y (tagHQ false x',d) (hoodAJ (SpinMQ (P:=P) f i (r x')) (UpVecRQ f s A M i k Z L hG G₁ M0)); have ht':PostSupport false univ R:=(ChargedJ.lake _ _ _ hg (fun i _=>hx.owns i)).addM ((PostSupport.of (AtSupport.oneM _)).smulM _)
