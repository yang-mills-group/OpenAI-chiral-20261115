abbrev BeamMQ (θ:BandS→ℕ):= (Σ d:BandS, Fin (θ d))
abbrev ClopPQ (θ:BandS→ℕ):= Option (BeamMQ θ)
def folkQ (l:BeamMQ θ) (b: Bool)(x:X):SailκJ (ChildQ X) θ:= Bootκ θ (tagHQ b x,l.1) l.2 0
def tagMQQ (l:ClopPQ θ)(b:Bool)(x:X): List (SailκJ (ChildQ X) θ) := l.toList.map fun j=>folkQ j b x
