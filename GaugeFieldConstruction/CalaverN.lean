 K : SampleDose
 L : SampleDose
 ε :ℝ
 δ :ℝ
 ε_pos:0<ε
 δ_pos:0<δ
 width:BundlesΝ A_X B_Y ε
 Ac : IsCompact (closure A_X)
 Bc : IsCompact (closure B_Y)
 Aopen:IsOpen A_X
 Bopen:IsOpen B_Y
 Kinside : tsupport K.val ⊆ A_X
 Linside : tsupport L.val ⊆ B_Y
 pK : K.Normalized
 pL' : L.Normalized
 mirror : Fin 2→ PermWallJ P
 balance: ScopeL2N A_X B_Y mirror
 Fcal : ∀ i:ClanZN, ribbonN D (transitionΦN i) (X i) (F i)
 Gcal : ∀ i:ClanZN, ribbonN D (transitionΦN i) (Y i) (G i)
 test : MarketPosΝ K L (Χz σx) X Y∈ PrecisionYN δ
namespace StrongViewN
variable {D:P.Heritor}{X Y:ClanZN→ScreensJ P}
variable (A:StrongViewN σx D X Y)
local notation "kΦ"=> (SΡχ P σx)
abbrev transactionN (t:ℕ):SettingZN:= MarketN A.K A.L A.F A.G (P.singleState 3 t σx) t
abbrev Horizon_μN:= MarketPosΝ A.K A.L kΦ X Y
abbrev CredentialsN (t:ℕ):Prop:= (∀ i:ClanZN,RecordedΝ P (transitionΦN i) A.A_X A.K (A.F i) t) ∧ ∀ i:ClanZN,RecordedΝ P (transitionΦN i) A.B_Y A.L (A.G i) t
lemma agreedN : ∀ᶠ t in atTop, A.CredentialsN t:=by
 refine (eventually_all.mpr (fun k:ClanZN=>?_)).and (eventually_all.mpr (fun k:ClanZN=>?_))
 · exact LateScopeΚN D _ _ _ _ _ A.Kinside A.Aopen (A.Fcal k) (departN k)
 exact LateScopeΚN D _ _ _ _ _ A.Linside A.Bopen (A.Gcal k) (departN k)
lemma scopeN : ScopeL2N (tsupport A.K.val) (tsupport A.L.val) A.mirror:=fun i p j v=> A.balance i (A.Kinside p) j (A.Linside v)
lemma progressN : Tendsto (A.transactionN) atTop (𝓝 A.Horizon_μN):= MatTenderN _ _ (SΡχ P σx) _ _ _ _ (fun i=>(A.Fcal i).1) (fun i=>(A.Gcal i).1) A.mirror A.scopeN
lemma perceptiveN : ∀ᶠ t in atTop,A.transactionN t∈ PrecisionYN A.δ:= A.progressN.eventually ((PointMatrix_μN _).mem_nhds A.test)
abbrev FadedN (t:ℕ)(D':P.Test→ₗ[ℂ]ℂ):Prop:= (∀ i:ClanZN,D' (installedN (A.F i) A.K t)=0 ∧ D' (installedN (A.G i) A.L t)=0) ∧ MarketN A.K A.L A.F A.G D' t=0
lemma auditionN : ∀ᶠ t in atTop,(∃! D:P.Test→ₗ[ℂ]ℂ,P.SameRawProduct t σx D) ∧ ∀ D':P.Test→ₗ[ℂ]ℂ,P.SameRawProduct t σx D'→ A.FadedN t D':=by
 filter_upwards[A.agreedN] with v u; refine ⟨P.thin_comparator .., fun D' p=>?_⟩; exact TintSimN _ _ _ _ (bundleDisΝ A.width A.ε_pos) (A.F) (A.G) v σx u.1 u.2 _ p
lemma certificationN : ∀ᶠ t in atTop,A.CredentialsN t ∧ A.transactionN t∈PrecisionYN A.δ ∧ (∃! Q:P.Test→ₗ[ℂ]ℂ,P.SameRawProduct t σx Q)∧∀ D':P.Test→ₗ[ℂ]ℂ,P.SameRawProduct t σx D' → A.FadedN t D'∧ D' ≠ P.singleState 3 t σx :=by
 filter_upwards[A.agreedN,A.perceptiveN,A.auditionN] with t c p u; refine ⟨c,p,u.1,fun D' k=> ⟨u.2 _ k,?_⟩⟩; intro v; have h:= (u.2 _ k).2; rw[v] at h; let x:ClanZN:=(0,false); have hz:= visibleXN p x; rw [show A.transactionN t=0 from h] at hz; exact lt_irrefl _ (lt_trans A.δ_pos hz)
#print axioms progressN
#print axioms certificationN
end StrongViewN
