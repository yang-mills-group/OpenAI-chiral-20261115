lemma CrestFNX (u:BandS)(m:ℕ)(z:5≤ m) : Tendsto (fun i=> Richm_R P m i^3 * FingerprintNX P u i (SportR P m i)) atTop (𝓝 0):=by
 have hy:= tendsto_inv_atTop_zero.comp (SpringR.escape P)
 apply squeeze_zero' _ _ hy
 · filter_upwards [eventually_ge_atTop f0] with i h
   let s:=SportR P m i; have e:i≤ s:=SportR.hop P m i; let k:= RankQJ P.par; have a:0<k i:=(p.price i h u i).hot le_rfl le_rfl; have b:0 <k s:= (p.price i h u s).hot e le_rfl
   have he:0 ≤ ScaleμJ P.par u.val:= (p.price i h u s).small;
   exact mul_nonneg (pow_nonneg (Richm_good ..).le _) (div_nonneg (mul_nonneg a.le (pow_nonneg he _)) b.le)
 filter_upwards [eventually_ge_atTop f0] with i h
 let s:=SportR P m i; have hz:i≤ s:=SportR.hop P m i; let k:= RankQJ P.par; let W:=SpringR P i; have hv:1 ≤ W:=SpringR.tall ..; have hW:0<W:=zero_lt_one.trans_le hv
 let A:=6*m; let C:= (8*m+1)*3; let T:= ((3+u.val)*8+7)*m; let L:= k s; have hp:Richm_R P m i^3=W^C:= (pow_mul W ..).symm; have hk:0<L:=(p.price i h u s).hot hz le_rfl; have he:k i ≤ W^A * L:= RailInclR p u _ _ h
 let R:= ScaleμJ P.par u.val^(s-i); have hR:0≤R:=pow_nonneg (p.price i h u s).small _; have hq: R≤(W^T)⁻¹:= Sport_gainR P i m u
 change Richm_R P m i^3 * (k i*R/L) ≤ W⁻¹; rw[hp]; refine le_trans (b:=W^C*(W^A * L * (W^T)⁻¹/L)) (by gcongr) ?_
 rw[show W^C*(W^A*L*(W^T)⁻¹/L)=W^(C+A)/W^T from (by have H:L≠0:=hk.ne'; field_simp; rw [pow_add] <;> ring_nf)]
 rw[←one_div,div_le_div_iff₀ (pow_pos hW T) hW,one_mul,←pow_succ]; refine pow_le_pow_right₀ hv ?_
 have ht:31*m ≤ T:= by unfold T; exact Nat.mul_le_mul_right _ (by omega)
 unfold C A; omega
