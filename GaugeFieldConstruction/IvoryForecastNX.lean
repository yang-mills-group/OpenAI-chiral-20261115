lemma LegCFNX (P:Spine)(u:BandS) : RStepJ P.par u.val *2 *ScaleμJ P.par u.val ≤ 1:=by
 let L:ℝ:= P.par.R.L.val; have hp:3 ≤ L:=by unfold L; exact_mod_cast (show (3:ℕ)≤ P.par.R.L.val from P.par.R.coarse)
 let K:ℝ:=3+u.val+2*Alto; let a:ℝ:=3+u.val+19/20
 have he: 2 ≤ L^(3/4:ℝ):=by
    apply le_of_pow_le_pow_left₀ (by decide: (4:ℕ)≠0) (Real.rpow_nonneg (by linarith) _)
    rw [←Real.rpow_mul_natCast (by linarith : (0:ℝ) ≤ L)]; norm_num; change (16:ℝ)≤_
    -- tune conversion
    have hh:L^(3:ℝ)=L^3:=by norm_cast
    try rw [hh]
    exact (show (16:ℝ)≤ (3:ℝ)^3 from by norm_num).trans (pow_le_pow_left₀ (by norm_num) hp 3)
 change _ *2*(L^a)⁻¹ ≤1; rw[← div_eq_mul_inv]; apply (div_le_one (by positivity)).2
 have hs:RStepJ P.par u.val=L^K:=by unfold RStepJ LαK K DimsP; rw [neg_neg]
 rw [hs]; refine (mul_le_mul_of_nonneg_left he (by positivity)).trans ?_
 rw [← Real.rpow_add (by linarith : (0:ℝ)<L)]; exact Real.rpow_le_rpow_of_exponent_le (by linarith) (by unfold K a Alto; linarith)
include p
lemma PixelFNX (m a:ℕ)(q:f0≤ a)(h:5≤ m) : Tendsto (fun i=> RStepJ P.par (ΤbandR u).val^i * Richm_R P m i^3 * FingerprintNX P (ΤbandR u) a (SportR P m i)) atTop (𝓝 0):=by
 let u':=ΤbandR u; let R:= RStepJ P.par u'.val; have ht:1≤ R:= rate_bigR p u
 let T:= CrestFNX p u' m h; let U:= T.const_mul (R^a); rw[mul_zero] at U; apply squeeze_zero' _ _ U
 · filter_upwards [eventually_ge_atTop a] with i k
   let s:=SportR P m i; have e:i≤ s:=SportR.hop P m i; let x:= RankQJ P.par; let w:=k.trans e
   exact mul_nonneg (mul_nonneg (by change 0 ≤ R^_; positivity) (pow_nonneg (Richm_good ..).le _)) (div_nonneg (mul_nonneg ((p.price a q u' s).hot le_rfl w).le (pow_nonneg (p.price a q u' s).small _)) ((p.price a q u' s).hot w le_rfl).le)
 filter_upwards [eventually_ge_atTop a] with i p'
 let s:=SportR P m i; have hz:i≤ s:=SportR.hop P m i; let x:= RankQJ P.par; let T:= p'.trans hz; let r:=ScaleμJ P.par u'.val; let t:=i-a; let W:=Richm_R P m i^3; have hx:0≤W:=pow_nonneg (Richm_good ..).le _; have hr:0≤ r:= (p.price a q u' s).small; have hX:0≤ x i:= ((p.price a q u' s).hot p' hz).le; have hZ:0<x s:= (p.price a q u' s).hot T le_rfl
 have he: x a ≤ 2^t * x i:=by
    have hp(j:ℕ): x a ≤ 2^j * x (a+j):=by
       induction j with
       | zero=>simp
       | succ k ih=>
         have hg:= ((p.price a q u' (a+k+1)).pass (s:=a+k) (by omega) (by omega)).2; exact ih.trans ((mul_le_mul_of_nonneg_left hg (by positivity : (0:ℝ)≤2^k)).trans_eq (by rw[pow_succ]; simp [add_assoc,mul_assoc,x]))
    exact (hp t).trans_eq (by rw [show a+t=i from by unfold t; omega])
 have hf:R^t*x a*r^t ≤ x i:=by calc
    _ ≤ R^t*(2^t*x i)*r^t :=by gcongr
    _ = (R*2*r)^t * x i:=by simp_rw [mul_pow]; ring
    _ ≤ _:= mul_le_of_le_one_left hX (pow_le_one₀ (by positivity) (LegCFNX P u'))
 change R^i*W*(x a * r^(s-a)/x s) ≤ R^a*(W*(x i*r^(s-i)/x s)); rw [show R^i=R^a*R^t from (pow_add R a t ▸ (by rw [show a+t=i from by unfold t; omega]))] -- tune
 rw [show s-a=t+(s-i) from by unfold t; omega,pow_add,show R^a*R^t*W*(x a*(r^t*r^(s-i))/x s)=R^a*(W*((R^t*x a*r^t)*r^(s-i)/x s)) from (by ring)]
 gcongr
