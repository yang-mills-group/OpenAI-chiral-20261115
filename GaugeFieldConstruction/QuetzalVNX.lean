private lemma Charm_lNX {A B:Side}(S:Sweep (mid A B))(σ:I→Seat (mid A B))(σ':O→Seat (mid A B))(F:Finset I→ ForceBudget (mid A B))(F':Finset O→ForceBudget (mid A B))(x:Key I)(p:∀ i:Key I,Sigt Κ i→passingF _ S (WritV σ F i) (WritV σ' F' (Directory.Mantle e S i)))(u:Sigt Κ x):passingF _ S (WritV σ (Lapse F) x) (WritV σ' (Lapse F') (Directory.Mantle e S x)):=by
 have hp:=p 0 (fun _ _=> rfl); rw [show Directory.Mantle e S 0=0 from ?_, ArcU_value,ArcU_value] at hp
 · intro q y d; have h₀:=p x u q y d; rw [plus_Lapse F,plus_Lapse F'] at h₀; change F' ∅ _ _+_ = suit_Y S (_+_) at h₀; rw[map_add] at h₀; -- may fail metavars
   exact add_left_cancel ((congrArg (·+ _) (hp q y d).symm).trans h₀) -- orientation check h expects h0 starts mapped X? write
 funext j; by_cases h:j∈ Set.range e
 · obtain ⟨i,rfl⟩:=h; unfold Directory.Mantle; rw [etaμ,comp_apply]; exact map_zero _ -- tune
 exact outsideμ _ _ _ h -- scope Tides
