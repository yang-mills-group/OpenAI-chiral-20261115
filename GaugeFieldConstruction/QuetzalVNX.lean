 have he: ∀i'∈Κ,T' (e i')= sh T (Z0 i'):=fun i' _=> ((congrArg (pL.σ ν) (qH.own _)).trans (U0.seats ν a le_rfl (P_.own i')))
 intro i' q z; rw [pV.top,pV'.top]; dsimp only [Era]; -- tune
