lemma MountainNX (s:ℕ)(a:n ≤ s)(b:s ≤ Y.uv k): Ωrite s p V D' pL V' e Κ (U s) :=by -- occupancy cards.P
 induction b using Nat.decreasingInduction with
 | self=> exact SunVNX F p g0 G' V pV D' pL gH tg V' pV' e δ qH U Κ Z U0 d0 a
 | of_succ s h ih=>
    let ψV:= U s; let tb:=P_.F_v (p.σ s); let t':= D'.F_v (pL.σ s); have z:= d0.trans a; have x:=Z.trans a; let R:=F.earth (G'.trans z) h;
    by_cases tZ:s=mPrice
    · subst mPrice
      have W(s0:Key I)(g:Sigt Κ s0):= BountifulNX Y s i k c R.a R.b R.pH R.qK R.gate (D s) (t s) u0 Nkey R.U R.V R.Toll R.sign P_ (p.σ (s+1)) (V.Br s) (V.Roll (s+1)) (p.tour s) (p.grade (s+1)) (Tζ.list) (F.cod s) Tζ.tape ΓC.Ξ ΓC.Ζ ΓC.tax (pV.loop z h) D' (pL.σ (s+1)) (V'.Br s) (V'.Roll (s+1)) (pL.tour s) (pL.grade (s+1)) (Tς.list) (F.cod s) (Tς.tape) (pV'.loop x h) (U s) e δ qH Κ U0.rib (U0.crest s a h.le) (pL.grade s) (gH.kind _ x h.le) (by rw [gH.loop s x h,g0.loop s z h]; exact U0.seats s a h.le) (ladderNX F p g0 G' V pV D' pL gH tg V' pV' e δ qH U Κ Z U0 d0 s a h (ih (a.trans (Nat.le_succ s)))) (pΓ a).1 (pΓ a).2 s0 g -- t notation auto bug. rewrite.
      intro i' q y; rw[pV.harvest z,pV'.harvest x]
      let V₁:= FastNX ΓC Tζ V; let Q:= BJoveNX Y i k P_ (p.σ (s+1)) (V.Br s) Tζ.list (F.cod s) ΓC.Ξ ΓC.Ζ Tζ.tape Nwx; let V₂:=FastNX ΓC Tς V'; let P':= BJoveNX Y i k D' (pL.σ (s+1)) (V'.Br s) Tς.list (F.cod s) ΓC.Ξ ΓC.Ζ Tς.tape Nwx
      let K_:=(Γω s).ratio.parent; let e' :=Directory.Mantle (B:=P.block) (m:=mesh (Y.ir i) P.R.L s) e ψV
      let P0:=W i' q; have pv0 (p':Key I) (u:Sigt Κ p'): passingR (Papal.count Y s i) (U s) (WritV (P_.F_v (p.σ s)) V₁.F p') (WritV (D'.F_v (pL.σ s)) V₂.F (e' p'))∧passingF (Papal.count Y s i) (U s) (WritV (P_.F_v (p.σ s)) Q p') (WritV (D'.F_v (pL.σ s)) P' (e' p')):=by rw [← g0.loop s z h, ←gH.loop s x h]; exact W p' u
      exact ⟨(pv0 _ q).1, Charm_lNX e Κ (U s) _ _ Q P' i' (fun i v=>(pv0 i v).2) q⟩
    have W(s0:Key I)(g:Sigt Κ s0):= Bountiful Y s i k c R.a R.b R.pH R.qK R.gate (D s) (t s) u0 Nkey R.U R.V R.Toll R.sign P_ (p.σ (s+1)) (V.Br s) (V.Roll (s+1)) (p.tour s) (p.grade (s+1)) (p.birth s) (p.Pp s) (F.cod s) (p.paper s) (pV.loop z h) (g0.voyage z h) D' (pL.σ (s+1)) (V'.Br s) (V'.Roll (s+1)) (pL.tour s) (pL.grade (s+1)) (pL.birth s) (pL.Pp s) (F.cod s) (pL.paper s) (pV'.loop x h) (gH.voyage x h) (U s) e δ qH Κ U0.rib (U0.crest s a h.le) (pL.grade s) (gH.kind _ x h.le) (by rw [gH.loop s x h,g0.loop s z h]; exact U0.seats s a h.le) (ladderNX F p g0 G' V pV D' pL gH tg V' pV' e δ qH U Κ Z U0 d0 s a h (ih (a.trans (Nat.le_succ s)))) (U0.troupe s a h) (U0.aims s a h) (U0.paper s a h) s0 g -- t notation auto bug. rewrite.
    intro i' q y; rw[pV.ancestry z h tZ,pV'.ancestry x h tZ]
    let V₁:= F.FrescoBJ p s z h G' V; let Q:= BJove Y i k R.U R.V P_ (p.σ (s+1)) (V.Br s) (p.birth s) (p.Pp s) (F.cod s) (p.paper s); let V₂:=F.FrescoBJ pL s x h tg V'; let P':= BJove Y i k R.U R.V D' (pL.σ (s+1)) (V'.Br s) (pL.birth s) (pL.Pp s) (F.cod s) (pL.paper s)
    let K_:=(Γω s).ratio.parent; let e' :=Directory.Mantle (B:=P.block) (m:=mesh (Y.ir i) P.R.L s) e ψV
    let P0:=W i' q; have pv0 (p':Key I) (u:Sigt Κ p'): passingR (Papal.count Y s i) (U s) (WritV (P_.F_v (p.σ s)) V₁.F p') (WritV (D'.F_v (pL.σ s)) V₂.F (e' p'))∧passingF (Papal.count Y s i) (U s) (WritV (P_.F_v (p.σ s)) Q p') (WritV (D'.F_v (pL.σ s)) P' (e' p')):=by rw [← g0.loop s z h, ←gH.loop s x h]; exact W p' u
    exact ⟨(pv0 _ q).1, Charm_lNX e Κ (U s) _ _ Q P' i' (fun i v=>(pv0 i v).2) q⟩
