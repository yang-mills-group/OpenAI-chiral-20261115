    let U':= TogaJ (W:=(L',u)) Pz Q hv p0 V; apply ChargedJ.lift _ U'; unfold V; rw [passLoomJ p w h B0 M Ω x R u]; exact pK
 have H₀(l)(p:l∈F):=pD l p X Y B Z Pz l rfl (Hν l)
 let V0:=Papal.count P.run (P.run.uv k) i; let ΓΨ:=F.toFinset.biUnion fun j=> HaloShip P x f (P.run.uv k) i (Y j)
