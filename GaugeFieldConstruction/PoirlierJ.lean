    apply Post_ListJ; intro l g'; have hu:PostSupport false (HaloShip P x f (P.run.uv k) i (Y l)) (D l):=(hull_F P.run i k f f0 _ _ _ _ _ _ _ P.large θ (ArenaΨJ κ) _ _ (incG θ M) B (p.Z i k w h) Z Pz KT hR l (H₀ l g')).2 (hr l g') -- tune layout inference
    exact Post_LiftJ hu (subset_biUnion_of_mem (fun j=> HaloShip P x f (P.run.uv k) i (Y j)) (List.mem_toFinset.mpr g')) -- tune
 let o:= TokenΩJ P f (P.run.uv k) i x (Y L'); have hg:Disjoint (Pach o) ΓΨ:=by
    have hp:Pach o⊆ HaloShip P x f (P.run.uv k) i (Y L'):=by apply Corona.halo_mono _ (Subset.refl _); have ht:= DuoM (P.run.uv k) f P.par P.width; omega -- include Lift halo
    refine Finset.disjoint_left.mpr ?_; intro q u v; obtain ⟨l,t,wP⟩:=mem_biUnion.mp v
    exact Finset.disjoint_left.mp (DepositΩ (P:=P) (Y:=Y) _ e sat L' l (Ne.symm ((hr l (List.mem_toFinset.mp t)).ne)) q₀ Pz.qk) (hp u) wP -- tune
