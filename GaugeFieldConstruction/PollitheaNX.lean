lemma PriorizesNX(t':ℕ→ℕ)(e:∀ᶠ i in atTop,S i ≤ t' i): Tendsto (fun s=>T.ReceivedNX uX vX s (t' s) (P.singleState 3 (t' s) v)) atTop (𝓝 (E.EuJointNX p v (E.ZleftNX a i) (E.ZrightNX a i) T.F.K T.F.L)):=by -- implicit T binder challenge
   let H:=T.F; have pS:= shelterPairVU H.K H.L (conf 2) (fun x h y z=> (T.story.2.2.1 x (H.Kinside h) y (H.Linside z)).1.1) -- order
   rw [←JuryMakerNX E p v hp _ _ H.K H.L pS]; apply tendsto_pi_nhds.mpr; intro j; apply tendsto_pi_nhds.mpr; intro k
   have f:VenueY 0 (E.RoomsVU ((E.ZleftNX a i) j)):= (E.StemLivesNX i a hJ j).1; have g:= (E.StemLivesNX i a hJ k).2
   let C:=SΡχ P v
   exact (YearCost2_NX S U C t' e _ _ _ _ f (Lx j).permissible g (Vx k).permissible _ _ H.mirror H.scopeN).sub ((YearCost1_NX S U C _ e _ _ f (Lx j).permissible H.K).mul (YearCost1_NX S U C _ e _ _ g (Vx k).permissible H.L))
