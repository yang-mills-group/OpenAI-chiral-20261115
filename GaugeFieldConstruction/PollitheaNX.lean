abbrev ReserveΛNX(s:ℕ):Prop:= (∀ j,P.spacePrice (uX j s) T.F.K ⊆ T.F.A_X ∧ P.spacePrice (vX j s) T.F.L⊆ T.F.B_Y) ∧ ∀t ≥ S s, T.ReceivedNX uX vX s t (P.singleState 3 t v)∈ PrecisionD_NX T.F.δ ∧(∃! A:P.Test→ₗ[ℂ]ℂ,P.SameRawProduct t v A) ∧ ∀ A:P.Test→ₗ[ℂ]ℂ,P.SameRawProduct t v A→ SplitΖNX T uX vX s t A∧ A≠ P.singleState 3 t v
lemma PortFlaresNX :∀ᶠ s in atTop, ReserveΛNX T S uX vX s:=by
    let H:=T.F; let R(s t:ℕ):Prop:= T.ReceivedNX uX vX s t (P.singleState 3 t v)∈ PrecisionD_NX H.δ
    have hx:∀ᶠ i in atTop,∀ t,S i ≤ t → R i t:= EventuallyRightNX _ fun u e=>(PriorizesNX hp hJ T S uX vX U Lx Vx u e).eventually ((WicketNX.PointMatrix_μN H.δ).mem_nhds T.price) -- tune
    filter_upwards[hx,eventually_all.mpr fun i:DegreeViewNX=> campusNX H.A_X H.Aopen H.K _ (Lx i).headed H.Kinside,eventually_all.mpr fun i:DegreeViewNX=> campusNX H.B_Y H.Bopen H.L _ (Vx i).headed H.Linside] with s h₀ h₁ h₂
    refine ⟨fun i=> ⟨h₁ i,h₂ i⟩,?_⟩; intro t p₀; have g:=h₀ t p₀; refine ⟨g,P.thin_comparator .., fun A hA=>?_⟩
    let F(i):= P.prepared t (uX i s) H.K; let G(i):= P.prepared t (vX i s) H.L
    have hf(i): P.beamAsk t (F i) (P.spacePrice (uX i s) T.F.K) ((Lx i).beams s).choose:= ((Lx i).beams s).choose_spec.prepare (((Lx i).enough s).trans p₀) H.K
    have hg(i): P.beamAsk t (G i) (P.spacePrice (vX i s) T.F.L) ((Vx i).beams s).choose:= ((Vx i).beams s).choose_spec.prepare (((Vx i).enough s).trans p₀) H.L
    have he(i): A (F i)=0:= (hf i).fee hA.marginal.factors (Or.inl hA.matter)
    have ht: T.ReceivedNX uX vX s t A=0:=by
        ext1 i; ext1 j
        have p:= (hf i).visitor (hg j).price ((bundleDisΝ H.width H.ε_pos).mono (h₁ i) (h₂ j)); have hx:= p.fee hA.marginal.factors (.inl hA.matter)
        change A (F i*G j)- A (F i)*A (G j)=0; rw [hx,he,zero_mul,sub_self]
    refine ⟨⟨fun i=> ⟨he i,(hg i).fee hA.marginal.factors (.inl hA.matter)⟩,ht⟩,fun u=>?_⟩
    rw [u] at ht; unfold R at g; rw [ht] at g; exact lt_irrefl _ (lt_trans H.δ_pos (WicketNX.visibleXN g none))
