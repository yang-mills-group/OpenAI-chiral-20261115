abbrev MarketN (F G:ClanZN→ℕ→P.Test)(E:P.Test→ₗ[ℂ]ℂ)(t:ℕ):SettingZN := fun i j=> E (installedN (F i) rC t * installedN (G j) rD t) - E (installedN (F i) rC t)*E (installedN (G j) rD t)
abbrev MarketPosΝ (A B: ClanZN→ ScreensJ P):SettingZN:=fun i j=> Pose2N rC rD ΞΧ (A i) (B j)-Pose1N rC ΞΧ (A i)*Pose1N rD ΞΧ (B j)
lemma MatTenderN (F G:ClanZN→ℕ→P.Test)(A B: GradingΝ (P:=P))(h:∀ i,VenueX 0 (A i) (F i))(v: ∀ i,VenueX 0 (B i) (G i))(σ:Fin 2→ PermWallJ P)(u: ScopeL2N (tsupport rC.val) (tsupport rD.val) σ) : Tendsto (fun i=> MarketN rC rD F G (ΞΧ.cash i) i) atTop (𝓝 (MarketPosΝ rC rD ΞΧ A B)):= tendsto_pi_nhds.mpr (fun i=> tendsto_pi_nhds.mpr fun j=> by exact (HappeningL2N (F i) (G j) rC rD ΞΧ (A i) (B j) (h i) (v j) σ u).sub ((HappeningL1N (F i) rC _ (A i) (h i)).mul (HappeningL1N _ _ _ _ (v j)))) -- tune bind
lemma TintSimN (X Y:Set Vantage)(d:Disjoint X Y)(F G:ClanZN→ℕ→P.Test)(s:ℕ)(x:P.Spectrum0 3)(u:∀ i,RecordedΝ P (transitionΦN i) X rC (F i) s)(v:∀ i,RecordedΝ P (transitionΦN i) Y rD (G i) s)(E:P.Test→ₗ[ℂ]ℂ)(h:P.SameRawProduct s x E): (∀ i:ClanZN,E (installedN (F i) rC s)=0∧ E (installedN (G i) rD s)=0) ∧ MarketN rC rD F G E s=0:=by
 have he(i):=AtomScopeN P x s E h (F i) rC (u i); refine ⟨fun i=> ⟨he i,AtomScopeN _ x s E h _ _ (v i)⟩,?_⟩; funext i j; unfold MarketN; rw [ScopeZeroN _ _ _ _ d x _ E h (u i) (v j),he,zero_mul,sub_self]; rfl
