abbrev BundlesΝ (A B: Set Vantage)(ε:ℝ):Prop:=∀ x∈A,∀ y∈ B,∀ i:Axis,x i+ ε≤ y i
lemma bundleDisΝ {A B:Set Vantage}{ε:ℝ}(h:BundlesΝ A B ε)(p:0<ε):Disjoint A B:= Set.disjoint_left.mpr (fun x a b=> not_le_of_gt (lt_add_of_pos_right (x 0) p) (h x a x b 0)) -- implicit x binder tune
lemma RangeScopeΝ {x y:Vantage}(d:∀ i,x i < y i)(σ:Fin 2→PermWallJ P)(h:Pointers2N x y∈MasksR (Fin 2)∩ OpenR 3 σ jNDuo): ∃ (A B:Set Vantage)(ε:ℝ),0<ε∧ IsOpen A∧ IsOpen B ∧ IsCompact (closure A) ∧ IsCompact (closure B) ∧ x∈ A ∧ y∈ B ∧ BundlesΝ A B ε∧ScopeL2N A B σ:=by
 obtain ⟨ε,hε,q⟩:= ((show ∀ᶠ z in 𝓝[>] (0:ℝ), 0<z from self_mem_nhdsWithin).and (eventually_all.mpr fun i:Axis=> (show Tendsto (fun y:ℝ=>y) (𝓝[>] 0) (𝓝 0) from tendsto_id.mono_left nhdsWithin_le_nhds).eventually (gt_mem_nhds (sub_pos.mpr (d i))))).exists -- tune use filter_mono
 let U: Set (Vantage×Vantage):= ⋂ i:Axis, {p:Vantage×Vantage| ε < p.2 i-p.1 i}
 let W: Set (Vantage×Vantage):= (fun (p:Vantage×Vantage)=>Pointers2N p.1 p.2)⁻¹' (MasksR (Fin 2)∩OpenR 3 σ jNDuo)
 have hp: IsOpen (U ∩ W):= (isOpen_iInter_of_finite fun i:Axis=> isOpen_lt (g:= fun p:Vantage×Vantage=> p.2 i-p.1 i) continuous_const (by fun_prop)).inter (((ply_openR _).inter (Opens_R ..)).preimage pointersCΝ) -- tune arg
 obtain ⟨r,g,tG⟩:= Metric.isOpen_iff.mp hp (x,y) (by exact ⟨Set.mem_iInter.mpr q,h⟩)
 let A:=Metric.ball x r; let B:=Metric.ball y r; have ht:A ×ˢ B⊆U∩W:= (show A×ˢ B = Metric.ball (x,y) r from ball_prod_same x y r) ▸ tG
 refine ⟨A,B,ε,hε,Metric.isOpen_ball,Metric.isOpen_ball,(Metric.isBounded_ball.isCompact_closure),(Metric.isBounded_ball.isCompact_closure),Metric.mem_ball_self g,Metric.mem_ball_self g,?_,fun x p y v=>(ht (show (x,y)∈ A ×ˢ B from ⟨p,v⟩)).2⟩ -- declarations tune
 intro x p y v i; exact (le_sub_iff_add_le.mp (((Set.mem_iInter.mp (ht (show (x,y)∈ A ×ˢ B from ⟨p,v⟩)).1 i): ε< y i-x i).le))|>.trans' (add_comm _ _).le -- lr
