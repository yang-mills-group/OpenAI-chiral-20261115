private lemma floQ (l:List I)(f:I→ List I): l.flatMap f=(l.map f).flatten := rfl
lemma CrownYQ (Q:I→Seat Xq)(ε:Iona.Vote Q μ D' L output R q)(v:L.Nodup)(u:∀ i∈L,∀ j∈L, i∉ D' j): R.Perm (output.flatMap (RκQ L D'))∧ q=(output.map (ΓΗQ L μ)).prod:=by
 induction ε with
 | stays l h=> rw [show RκQ [] D'=fun i=>[i] from funext (fun i=>if_neg (by simp)), show ΓΗQ [] μ=fun i=>1 from funext (fun i=>if_neg (by simp))]; simp -- tune lambda
 | withoutK i L o l c x hP pH ih=>
    have sub:L ⊆ L++[i]:= List.sublist_append_left ..|>.subset
    obtain ⟨m,n'⟩:= ih (List.nodup_append.mp v).1 (fun _ p' _ q=>u _ (sub p') _ (sub q))
    have hA(x:I)(w:x∈o): x∈L++[i] ↔ x∈ L:=by simp [show x≠i from fun v=>hP (v ▸ w)]
    rw [floQ,show List.map (RκQ (L++[i]) D') o=o.map (RκQ L D') from List.map_congr_left (fun x h=>by simp only[RκQ,hA x h]),show List.map (ΓΗQ (L++[i]) μ) o=o.map (ΓΗQ L μ) from List.map_congr_left (fun x h=>by simp only[ΓΗQ,hA x h]),←floQ]; exact ⟨m,n'⟩
 | expand i L o l t c hv p h r ih=>
    obtain ⟨v,g,hx⟩:=List.nodup_append.mp v
    have sub: L ⊆ L++[i]:=List.sublist_append_left ..|>.subset
    have hp: i∈L++[i]:=by simp
    have ha(x)(p:x∈D' i):x∉ L++[i]:=fun g=>u _ g _ hp p
    obtain ⟨m,n'⟩:= ih v (fun _ p' _ q=>u _ (sub p') _ (sub q))
    have he: i∉ l:=(List.nodup_cons.mp (List.Nodup.of_map _ r)).1
    let R:= RκQ L D'; let K:= RκQ (L++[i]) D'; let A:=ΓΗQ L μ; let Y:=ΓΗQ (L++[i]) μ
    have hA(x:I)(w:x∈l): x∈L++[i] ↔ x∈ L:=by simp [show x≠i from fun v=>he (v ▸ w)]
    have hz:l.map K= l.map R:=List.map_congr_left (fun i v=>by simp only[K,R,RκQ,hA i v]) -- tune!
    have hp':l.map Y=l.map A:=List.map_congr_left (fun i v=>by simp only[Y,A,ΓΗQ,hA i v])
    have hY:(D' i).flatMap R= D' i:=by
       have e:(D' i).map R= (D' i).map fun i=>[i]:=List.map_congr_left (fun j v=>if_neg (fun h=>ha j v (sub h)))
       rw [floQ,e,←floQ]; exact List.flatMap_singleton' _
    have hF:((D' i).map A).prod=1:=by
       rw [show _= _ from (show (D' i).map A=(D' i).map fun _=>1 from List.map_congr_left (fun j v=> if_neg (fun h=>ha j v (sub h))))]; simp
    constructor
    · refine List.Perm.trans (l₂:=(i::l).flatMap K) ?_ (h.symm.flatMap (fun _ _=> List.Perm.refl _))
      rw [List.flatMap_cons,show K i= D' i from if_pos ‹i∈L++[i]›,floQ,hz,←floQ]; change t.Perm ((D' i++l).flatMap R) at m; simpa only [List.flatMap_append,hY] using m -- local R not found
    change _=(o.map Y).prod; change c=((D' i++l).map A).prod at n'; rw [List.Perm.prod_eq (h.map _),List.map_cons,List.prod_cons,show Y i=(μ i:ℂ) from if_pos ‹i∈L++[i]›]; apply congrArg ((μ i :ℂ)* ·); change c= (l.map Y).prod; rw[hp',n',List.map_append,List.prod_append,hF,one_mul]
