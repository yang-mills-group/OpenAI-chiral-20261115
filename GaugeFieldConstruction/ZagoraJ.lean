lemma HeadWax(l:LaurelJ) {F:Mark (side Y i s)}(m:AtSupport false univ F): AtSupport false univ (HeadΨJ Y f s i l F):=by
 induction l with
 | nil=> exact m
 | cons j l ih=> exact ((ih.refl ..).mono (subset_univ _)) -- namespace tune
#check HeadWax
include fU
lemma HeadBend(l:LaurelJ) (A:Mark (side Y i s)) (e:AtSupport false univ A) (q:Satin.PairIdx Y s i k): ascender Y s i k (HeadΨJ Y f s i l A)= HeadΨJ Y f (s+1) i l (ascender Y s i k A):=by
 induction l with
 | nil=> rfl
 | cons j l ih=>
    let k':=globeJ P f s j; change ascender Y s i k (reflMark j.1 k' _)= reflMark j.1 (globeJ P f (s+1) j) _; rw[ascendTurn Y s i k j.1 k' q (HeadWax Y i s f l e), ih,GlobeTurn s f fU]; -- tune
lemma HeadFund(l:LaurelJ)(A:Mark (side Y i s))(e:AtSupport false univ A)(p:(Y.voyage i).kick≤ k) {r:ℕ}(u:s ≤ r)(v:r≤Y.uv k): convoy (v:=r) Y i k u (HeadΨJ Y f s i l A)= HeadΨJ Y f r i l (convoy (v:=r) Y i k u A):=by
 induction u with
 | refl=>simp only [convoy,climbing_refl]
 | step h ih=> simp_rw [convoy,climbing_succ _ _ h]; unfold convoy at ih; rw [ih (by omega)]; exact HeadBend _ _ _ _ _ (fU.trans h) l _ (convoy_all Y i k p h (by omega) e) ⟨p,v⟩ -- args tune
