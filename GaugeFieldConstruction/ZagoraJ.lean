lemma OathFest(l:LaurelJ) (F:Buffered.Family (tent Y P')): HeadΨJ Y f s i l (Tapestry.exhibit Y P' s i F)=Tapestry.exhibit Y P' s i (VivaJ P f s (tent Y P') l F):=by
 induction l with
 | nil=>rfl
 | cons j l ih=>
    let G:=VivaJ P f s (tent Y P') l F; let k:=globeJ P f s j; change reflMark j.1 k (HeadΨJ _ _ _ _ _ _)=Tapestry.exhibit _ _ _ _ (Tower.mirror _ j.1 k G); rw[ih,present_send,present_send]; exact (fileMirror Y s i P' (F:=G) j.1 k).symm
