abbrev ProngJ := Axis×ℤ
abbrev LaurelJ:= List ProngJ
def globeJ (P:Preparation)(f s:ℕ)(z:ProngJ):ℤ:= (↑P.R.L.val:ℤ)^(s-f)*z.2
def wayZJ (P:Preparation)(f s:ℕ)(l:LaurelJ):Shape:= l.foldr (fun j a=>joinX a (plane j.1 (globeJ P f s j))) (incX 1)
def forgeιJ (P:Preparation)(f s:ℕ)(l:LaurelJ):Shape:= l.foldr (fun j a=>joinX (plane j.1 (globeJ P f s j)) a) (incX 1) -- outward, opposite
abbrev HeadΨJ(Y:Course P (VolumeCape.Dream.Nimbus ℓ))(f s i:ℕ)(l:LaurelJ)(A:Mark (side Y i s)):Mark (side Y i s):= l.foldr (fun j a=> reflMark j.1 (globeJ P f s j) a) A
abbrev VivaJ(P:Preparation)(f s:ℕ)(K:Calibration)(l:LaurelJ)(F:Buffered.Family K):= l.foldr (fun j a=>Tower.mirror K j.1 (globeJ P f s j) a) F
lemma SussexJ (l:LaurelJ) (x:Cover):(wayZJ P f s l).motion ((forgeιJ P f s l).motion x)=x:=by
 induction l with
 | nil=>simp [wayZJ, forgeιJ,incX,Shape.motion]
 | cons j l ih=>
    let H:= plane j.1 (globeJ P f s j); let U':=(wayZJ P f s l); let V:=forgeιJ P f s l; change (joinX U' H).motion ((joinX H V).motion x)=x; rw[palm,palm,←palm H H, show joinX H H= _ from gaugeSquare ..]; change U'.motion ((incX 1).motion (V.motion x))=x; simpa [incX,Shape.motion] using (show U'.motion (V.motion x)=x from ih)
lemma routeScalarJ(l:LaurelJ): (wayZJ P f s l).s= (wayZJ P f f l).s:=by induction l with|nil=> rfl|cons v l ih=> exact congrArg (·* Signed.mirror v.1) ih
variable (fU: f ≤ s)
include fU
local notation "τq"=> Vale.apt (Y.ir i) P.block P.R.L s
lemma GlobeTurn (x:ProngJ): globeJ P f (s+1) x= (P.R.L.val:ℤ)*globeJ P f s x:=by unfold globeJ; rw [show s+1-f=s-f+1 from by omega,pow_succ',mul_assoc]
lemma routeExpandJ (L:LaurelJ): (wayZJ P f (s+1) L)=Shape.broad (Vale.apt (Y.ir i) P.block P.R.L s) (wayZJ P f s L) ∧ (forgeιJ P f (s+1) L)=Shape.broad (Vale.apt (Y.ir i) P.block P.R.L s) (forgeιJ P f s L):=by
 induction L with
 | nil=>simp [wayZJ,forgeιJ,Shape.broad,incX]
 | cons j l ih=>
    have ht:plane j.1 (globeJ P f (s+1) j)= Shape.broad (τq) (plane j.1 (globeJ P f s j)):=by rw [GlobeTurn _ _ fU,plane_broad]; rfl  -- tune indentation
    constructor <;> first
                 | exact (congrArg₂ joinX ih.1 ht).trans (clan_b ..).symm
                 | exact (congrArg₂ joinX ht ih.2).trans (clan_b ..).symm
#check AnalyticBridge.GaussianFieldAlignment.Locations.parent_map
private lemma ΗParent (S:Shape)(x:Seat (side Y i (s+1))): (ZoomJ Y i s).parent ((Shape.broad (Vale.apt (Y.ir i) P.block P.R.L s) S).anon (side Y i (s+1)) x)= S.anon _ ((ZoomJ Y i s).parent x):=by
 let R:=ZoomJ Y i s; let N:=side Y i s; let M:= side Y i (s+1); let b:= wrap (More N) (2 • S.t)
 unfold Shape.anon; rw [show wrap (More M) (2 • (S.broad (τq)).t)=R.embed b from ?_]; have hx:=AnalyticBridge.GaussianFieldAlignment.Locations.parent_map (S:=(PlaceOf Y i 0 s).step P.V) S.s b x; rw [zigZ] at hx; exact hx -- tune
 unfold b; rw [Ratio.embed_wrap]; apply congrArg; exact smul_comm ..
omit fU
lemma routeParent (S:X→ ℕ→Lattice.Cover)(L:X→LaurelJ)(p:FilmθJ Y i X (Strideθ Y i S) f s): FilmθJ Y i X (Strideθ Y i (fun x t=> (forgeιJ P f t (L x)).motion (S x t))) f s :=by
 intro a h hx x; specialize p a h hx x; unfold Strideθ LodgeJ at *; rw [←Shape.anno,←Shape.anno, (routeExpandJ Y i a f h (L x)).2, ΗParent Y i a f h, p] -- tune
