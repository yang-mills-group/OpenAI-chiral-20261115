    unfold LeftPhaseNX RafN RightPhaseNX; rw [← Loft.spin_lift,←shadeLiftQc]; change _=(E.βBunVU five s (Calibration.lift (DegreeNX z) (RafN (DegreeNX z) (ImageQFNX a z)))).val; rw [show (E.βBunVU five s _).val= (E.βBunVU _ s (RafN _ (ImageQFNX a z))).val from HeathQa d.p d.B0 d.M R d.pu E.A E.Dp E.Q N (crayon r) E.H m E.Sq E.Wp (DegreeNX z) α J E.υ s _]
    cases z with
    | none=>
        have hp(i:Floor)(x:UV i): RafN i (-x) = -RafN i x:=by unfold RafN; rw[map_neg,map_neg]
        have hg : TurnupMars PermitAxisVU (-(E.FloraBinVU s))= -(E.FloraBinVU s):=by rw [show TurnupMars PermitAxisVU (-(E.FloraBinVU s))= -(TurnupMars PermitAxisVU (E.FloraBinVU s)) from by unfold TurnupMars; rw[map_neg,map_neg],E.CueRestVU _ e]
        change E.RoomsVU (TurnupMars _ (-(E.FloraBinVU s)))=(E.βBunVU four s (RafN four (-ΩPureVU))).val; rw [hg,map_neg,hp,westHisVU,map_neg]; exact congrArg Neg.neg (E.CaliburBinVU s ΩPureVU)
    | some j=>
