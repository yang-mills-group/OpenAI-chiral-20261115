    have he:= (limSeen2Ν d.p d.B0 d.M R d.pu E.A E.Dp E.Q N (crayon _ ) E.H m E.Sq E.Wp five α J E.υ S' q V H 0 X_s (hr ▸ MasksδS _ _ (PinsEdgeS P b) (Wish_posS P b))).sub ((limSeen1Ν d.p d.B0 d.M R d.pu E.A E.Dp E.Q N (crayon r) E.H m E.Sq E.Wp five α J E.υ S' q V 0).mul (limSeen1Ν d.p d.B0 d.M R d.pu E.A E.Dp E.Q N (crayon r) E.H m E.Sq E.Wp five α J E.υ S' q H X_s))
