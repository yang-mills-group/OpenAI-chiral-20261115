lemma GairBodyNX (s:ℕ)(z:DegreeViewNX): E.RoomsVU (E.GaeaNX a s z)=(E.βBunVU five s (RightPhaseNX a z)).val:=by
    unfold RightPhaseNX; rw [show (E.βBunVU five s (Calibration.lift (DegreeNX z) (ImageQFNX a z))).val=(E.βBunVU (DegreeNX z) s (ImageQFNX a z)).val from HeathQa d.p d.B0 d.M R d.pu E.A E.Dp E.Q N (crayon r) E.H m E.Sq E.Wp (DegreeNX z) α J E.υ s _] -- rw picks which _ !
    cases z with
    | none=> unfold GaeaNX; change E.RoomsVU (-(E.FloraBinVU s))= (E.βBunVU four s (-ΩPureVU)).val; rw[map_neg,map_neg]; exact congrArg Neg.neg (E.CaliburBinVU s ΩPureVU)
    | some k=>exact DeckΛAxisVU E s _
