lemma FareJ (l:List X)(S:X→Mark (side Y i (Y.uv k)))(τS:X→ℝ)(pS:∀ m∈ l, Circζ Y i k θ K f m (S m) (τS m))(tF:l.Pairwise (· < ·)): ‖Cap_ZΛ Y i k (l.map S).prod‖ ≤ (SkyWJ P (side Y i f) f* (inkΛJ u0)^l.length)*(l.map τS).prod:=by
 let h:= ReaderHas Y i k f j D t α c τ u0 Nkey P' θ b u A D0 B F K kF L Rp
 let w:= TolHouseJ (X:=X) θ; let K1:= inkΛJ u0; let b':= RankQJ P f
 let Ω:= SkyWJ P (side Y i f) f; have ht:1 ≤ Ω:=le_add_of_nonneg_right (Real.exp_pos _).le
 have hx:0 ≤ b':=((Pat 0).hot le_rfl kF.qk).le; have hr:1≤K1:= Real.one_le_exp (by linarith[F.vn])
 have he:= Sermon Y i k X (SailκJ X θ) w (K.Mark f) Ω K1 b' hx ht ?k (fun i=> h.owns i) F.kq hr S τS l pS [] (by simpa using tF)
 case k=> intro l t; let D:= BillJ P f (side Y i f) u0 l.length; let q':=b'^l.length
          refine (Earnings F (ΘΚ) kF.arc kF.io K kF.mony _ _ _ Rp f le_rfl kF.qk l ?_).trans ?_; · exact t -- tune
          have hs: BillJ P f (Papal.count Y f i) u0 l.length= ExpWJ P (side Y i f) f*K1^l.length*q':=by
              unfold BillJ q' K1 inkΛJ b'; rw[Real.exp_add, mul_comm (2*u0),Real.exp_nat_mul]; unfold ExpWJ; ring -- defeq count
          rw[hs]; refine mul_le_mul_of_nonneg_right ?_ (pow_nonneg hx _); exact mul_le_mul_of_nonneg_right (le_add_of_nonneg_left zero_le_one) (by apply pow_nonneg; exact zero_le_one.trans hr)
 simpa only [List.map_nil,List.prod_nil,List.length_nil,zero_add,pow_zero,mul_one,one_mul] using he
