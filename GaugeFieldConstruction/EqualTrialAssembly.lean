 legacy_statement : OneTheory Certificate
 handed_prices : SeparatedHandedReadings (scale:=scale) (vacuum:=vacuum) (screens:=screens) (stress:=stress)
 measured (a:Axis): ∀ᶠ i in atTop, roles.LeaseVU i ∧ Nonempty (roles.ArtWordNX stress vacuum (le_refl _) (L:=response) a i)
 all (i:ℕ) (t:roles.LeaseVU i) : FullSector_st (stress:=stress) (vacuum:=vacuum) (model:=model) (continued:=continued) i t ∧ QueuedTensorSt (roles:=roles) (model:=model) (continued:=continued) i
 locks (i:ℕ)(t:roles.LeaseVU i) (a:Axis)(T:roles.ArtWordNX stress vacuum (le_refl _) (L:=response) a i): ComparisonArtSt (model:=model) i a T
 oppose (i:ℕ)(t:roles.LeaseVU i) (a:Axis)(T:roles.ArtWordNX stress vacuum (le_refl _) (L:=response) a i)(q:DegreeViewNX)(z:ℂ):
       (φΑ (roles.ZleftNX a i q) (TagVU T.F.K))≠ z • 1 ∧ (φΑ (roles.ZrightNX a i q) (TagVU T.F.L)) ≠ z • 1
 legacy_thin {A B:SampleDose}{Z W:Lead.Clan}(q:A.Normalized)(p:B.Normalized)(i:ℕ)(e:roles.LeaseVU i)(f:Test4): (process.finalPairing vacuum Z W A B).2.1 ≠ inner ℂ ω ((φΑ (roles.FloraBinVU i) f) ω)
 older_wages {i:ℕ} {M:process.Menagerie}{b:ℕ→ℕ}{z:ℝ}{F G: SampleDose}{D:∀ Z:Lead.Clan, process.VoucherOp vacuum Z (collars i) b}
      (h:LegacyQuantities (scale:=scale) (c:=c) (collars:=collars) i M b z F G D)(x:process.Spectrum0 3) (Z:Lead.Clan)(r:ℕ→ℕ)(U : process.VoucherOp x Z (collars i) r): U.issue= process.electro M Z • (1:(process.ColorHil 3 (process.otherSpectrum 3 3 x)).Op)
lemma tensor_tape_st : TensorPortsSt Certificate:=⟨once_tape_st Certificate,fun N h V u ε pos => LessonGranted Certificate N h V u ε pos,
    fun a=> roles.ArtPolandNX stress vacuum (le_refl _) Certificate.path.phase_costs Certificate.path.ward_oracle model Certificate.field_theory a,
