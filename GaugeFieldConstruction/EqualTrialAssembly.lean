-- comparison also rules out either gauge or transition family charged operator being scalar
private lemma along_rest_tag (F:ΧiMars)(W:ΧiMars)(u v:Test4)(z:ℂ) (h:φΑ F u=z • 1 ∨ φΑ W v=z • 1) : SecondOrient.tensorExperimentGap (model:=model) F W u v=0:=by
 have hp:‖ω‖=1:= model.course.total.norm
 unfold tensorExperimentGap; obtain a|b:=h
 · rw[a]; simp [LinearMap.smul_apply,inner_smul_right, inner_self_eq_norm_sq_to_K,hp]
 rw[b]; simp [LinearMap.smul_apply, inner_smul_right,inner_self_eq_norm_sq_to_K,hp, mul_comm]
lemma noScalar_st (i:ℕ)(a:Axis)(T:roles.ArtWordNX stress vacuum (le_refl _) (L:=response) a i)(t:roles.LeaseVU i)(q:DegreeViewNX)(z:ℂ) : (φΑ (roles.ZleftNX a i q) (TagVU T.F.K))≠ z • 1 ∧ (φΑ (roles.ZrightNX a i q) (TagVU T.F.L)) ≠ z • 1:= by
 refine not_or.mp (fun p=>?_); have hp:=(CPriceComparisonSt Certificate i a t T).diagonal q; rw [along_rest_tag Certificate _ _ _ _ z p] at hp; exact lt_irrefl _ hp
