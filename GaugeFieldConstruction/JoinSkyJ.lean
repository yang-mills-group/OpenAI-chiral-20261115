lemma noK_eta {x:FrameK E}(p:LoomK x ≤0):x=0:=funext fun i=> by apply norm_le_zero_iff.mp; exact (single_k x i).trans p
lemma Close_H (Q:MatJ (E:=E))(H:SkillJ Q (1/2)):let B:MatJ (E:=E):=LinearMap.id (R:=ℂ)+Q; Function.Bijective B ∧ ∀ i:FrameK E,LoomK i≤2*LoomK (B i) :=by
 intro B; have he(i:FrameK E):LoomK i ≤ 2*LoomK (B i):=by
    let K':=B i; have hv:K'=i+Q i:=rfl; have h:=H i
    have ht:=loomer_T K' (-Q i); rw [show K'+ -(Q i)=i from (hv ▸ add_neg_cancel_right ..),loomer_Y] at ht; change _≤_+_ at ht; linarith
 have hv:Injective B:=by
    intro i j hi; have hp:= he (i-j); rw [map_sub,hi,sub_self,loomer_N,mul_zero] at hp; exact sub_eq_zero.mp (noK_eta hp)
 exact ⟨⟨hv,LinearMap.injective_iff_surjective.mp hv⟩,he⟩
