structure ArtBJ (Pu:ℕ→ FrameK E→ₗ[ℂ] T) (f n:ℕ):Prop where
    heat{s:ℕ}(a:f≤ s)(b:s < n)(x:FrameK E): Pu s x=Pu (s+1) (p.C s x) - p.a s x • Z_
structure ArmJ (Pu Gu:ℕ→ FrameK E→ₗ[ℂ] T)(f n:ℕ):Prop where
    edge{s:ℕ}(a:f≤ s)(b:s < n)(x:FrameK E): Gu (s+1) x=M0 • Gu s x+ Pu (s+1) (g.G s x)+g.ε s x • Z_
variable (pA: ArtBJ Z_ p Pk f n)(rG: ArmJ (μ0:=μ0) Z_ g Pk Gk f n)
include pA
lemma PathJ(a:f≤ s)(b:s ≤ r)(t:r≤ n)(x:FrameK E): Pk s x= Pk r (PlcJ r s p b x)- AcJ p r s b x • Z_ :=by
 induction b with
 | refl=>rw [Plc_self,Ac_self,LinearMap.id_apply,LinearMap.zero_apply,zero_smul,sub_zero]
 | @step j h ih=>rw [ih (by omega),Plc_succ _ _ _ h,LinearMap.comp_apply, Ac_step _ _ _ h,LinearMap.add_apply,LinearMap.comp_apply, add_smul,pA.heat (a.trans h) t]; abel
-- residual exact at any consultation.Affine tables.Month. Cannot solve if repeat same Birth label beyond selected interval, requires gaps clean.
abbrev TraceBJ (s:ℕ)(A:ThreadJ (E:=E))(x:FrameK E):T:= Gk s x - Pk s (A.1 x)- A.2 x • Z_
include rG
lemma TraceNJ(a:f≤ s)(b:s ≤ r)(t:r≤ n)(x: FrameK E)(A:ThreadJ (E:=E)): TraceBJ Z_ Pk Gk r (TravelBJ p r s g μ0 b A) x= M0^(r-s) • TraceBJ Z_ Pk Gk s A x:=by -- tune arg order
 induction b with
 | refl=> rw [TravelBJ,climbing_refl, Nat.sub_self,pow_zero,one_smul]
 | @step j h ih=>
    let m:= TravelBJ p j s g μ0 h A; rw [Nat.succ_sub h,pow_succ',mul_smul,←ih (by omega), TravelBJ, climbing_succ _ _ h]
    unfold TraceBJ; change Gk (j+1) x - Pk (j+1) (M0 • (p.C j (m.1 x)) + g.G j x)-(M0 • (m.2 x - p.a j (m.1 x)) + g.ε j x) • Z_= M0 • (Gk j x - Pk j (m.1 x)-m.2 x • Z_); rw [pA.heat (a.trans h) t, rG.edge (a.trans h) t,map_add,map_smul]; simp only [smul_sub,add_smul,sub_smul,← mul_smul,smul_eq_mul,mul_sub]; abel
omit pA rG
