structure FixedCollarPropagation : Prop where
 conforms (k: Lead.Clan) (j:DegreeViewNX) :
     StandardPV A.S (fun s t=> (FZ k j s).full process t) (roles.RoomsVU (ΚV j))∧ StandardPV A.S (fun s t=> (HZ k j s).full process t) (roles.RoomsVU (ΛVΓ j))
 proceeds : Tendsto A.S atTop atTop
 both (k g:Lead.Clan)(t:ℕ→ℕ) : (∀ᶠ s in atTop,A.S s ≤ t s) →
      Tendsto (fun s=> recv∗ (FZ k) (HZ g) s (t s) (process.singleState 3 (t s) vacuum)) atTop (𝓝 Υx)
 heights (k g:Lead.Clan): (∀ᶠ s in atTop, Tendsto (A.IncomeJointNX T k g s) atTop (𝓝 (A.HorizonJointNX T k g s))) ∧
      Tendsto (A.HorizonJointNX T k g) atTop (𝓝 Υx)
 threshold : ∀ᶠ s in atTop,∀ j k:Lead.Clan,T.ReserveΛNX A.S (FZ j) (HZ k) s
 budgets (j k : Lead.Clan): ∀ᶠ s in atTop,∀ t:ℕ,A.S s≤t →
     ∀ (a b:DegreeViewNX),∀ ε :ℝ,0<ε→
     let F := leftRequest i T M A j s t a
     let H := rightRequest i T M A k s t b
     F.1∈ treasuryVU t F.2 ∧ H.1∈ treasuryVU t H.2 ∧ F.2⊆T.F.A_X ∧ H.2⊆T.F.B_Y ∧
     ProcurementVU (R:=scale) (c:=screens) vacuum t ε [F] ∧
     ProcurementVU (R:=scale) (c:=screens) vacuum t ε [H] ∧
     ProcurementVU (R:=scale) (c:=screens) vacuum t ε [F,H]
 Eu : Υx ∈ PrecisionD_NX T.F.δ
 Minkowski : Ωx ∈ PrecisionD_NX T.F.δ
 rankW : LinearIndependent ℂ (Eleft (model:=model) i T) ∧ LinearIndependent ℂ (Eright (model:=model) i T)
 momentum (j k:DegreeViewNX):
      let U := Eleft (model:=model) i T j
      let V := Eright (model:=model) i T k
      let P:= model.system.momentum.region FlameVUV
      Ωx j k=inner ℂ U (P V) ∧ P U=U ∧ P V=V
 momentumE (x y:Vantage): x ∈ T.F.A_X → y ∈ T.F.B_Y →
      let H:=(process.privateH vacuum 3)
      let S:= LightLiftL H
      let G:= roles.JointΖNX stress vacuum ΚV ΛVΓ (PortsVU x y)
      ∃ U V: DegreeViewNX→H.DegreeHab, LinearIndependent ℂ U∧LinearIndependent ℂ V∧
       ∀ i j:DegreeViewNX, S.ℚmeasure.region FlameVUV (V j)=V j∧ S.ℚmeasure.region FlameVUV (U i)=U i ∧
        G i j=inner ℂ (U i) (S.ℚmeasure.region FlameVUV (V j))

