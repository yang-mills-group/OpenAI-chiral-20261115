lemma paid_apertures (q:roles.LeaseVU i) : FixedCollarPropagation (screens:=screens) (scale:=scale) (model:=model) i T M A:=by
 let H:= Certificate.path; have V:= H.phase_costs; have W:= A.FaithfulNX V q T
 have L:= A.celebratedΖNX q
 refine ⟨fun k j=> ⟨roles.FieldWisePV (L k j).1, roles.FieldWisePV (L k j).2⟩, A.fundedΓNX, A.purchasesNX V q T, fun k z=> ⟨A.HeartlandNX q T costAnalysis k z, A.HeartPolkaNX V q T costAnalysis k z⟩, W, ?_, T.price,T.worth, roles.intrinsicD_NX stress vacuum _ model timeAxis i T,roles.VoltageJointNX stress vacuum _ model timeAxis i T,fun x y a b=> roles.PositionJointNX stress vacuum _ V model timeAxis i T H.candidate H.lane x y a b⟩
 intro k g; filter_upwards [W] with s w t p j r e l F U
 have he:=H.trajectory
 have qF : F.1∈ treasuryVU t F.2 :=
    ⟨(((L k j).1.beams s).choose_spec.prepare (((L k j).1.enough s).trans p) T.F.K).price, process.prepared_color _ _ _⟩
 have qU : U.1∈ treasuryVU t U.2 :=
    ⟨(((L g r).2.beams s).choose_spec.prepare (((L g r).2.enough s).trans p) T.F.L).price, process.prepared_color _ _ _⟩
 have Hg:= w k g; have C: F.2 ⊆ T.F.A_X:= (Hg.1 j).1; have D:U.2⊆T.F.B_Y:= (Hg.1 r).2
 have u(Q:List (MeterQueryVU process))(v:∀ i∈Q,i.1∈ treasuryVU t i.2)(q:Q.Pairwise (fun a b=>Disjoint a.2 b.2)): ProcurementVU (R:=scale) (c:=screens) vacuum t e Q:= he.queriesVU v q l (show _ from (by rw [dist_self]; exact half_pos l))
 exact ⟨qF,qU,C,D,u _ (by simpa using qF) (by simp),u _ (by simpa using qU) (by simp),u _ (by simpa using (And.intro qF qU)) (by simpa using (bundleDisΝ T.F.width T.F.ε_pos).mono C D)⟩
#print axioms paid_apertures

abbrev TwoFixedProbeExperiments : Prop:= ∀ᶠ i in atTop, ∃ (M:process.Menagerie)(b:ℕ→ℕ)(a:ℝ)(F G: SampleDose) (D:∀ Z:Lead.Clan, process.VoucherOp vacuum Z (collars i) b)
      (T:ExperimentAtScale (stress:=stress) (vacuum:=vacuum) (response:=response) i)
      (X:ΓGrowthNX roles vacuum timeAxis i M (collars i)), roles.LeaseVU i ∧
     LegacyQuantities (scale:=scale) (c:=c) (collars:=collars) i M b a F G D ∧ ContrastHere Certificate i T ∧
     FixedCollarPropagation (model:=model) (scale:=scale) (screens:=screens) i T M X

lemma earned_here : TwoFixedProbeExperiments Certificate:=by
 have h:= Certificate.path
 have u:= h.review.2.2.2.1
 have k:∀ᶠ s in atTop,process.calibration.ℓ < collars s:= (eventually_gt_atTop process.calibration.ℓ).mono (fun s p => p.trans_le (u s))
 filter_upwards [exact_legacy_receipt Certificate,k, roles.ArtPolandNX stress vacuum (le_refl _) h.phase_costs h.ward_oracle model Certificate.field_theory timeAxis] with s g v q
 obtain ⟨M,b,a,F,G,D,W⟩:=g; obtain ⟨p,⟨T⟩⟩:=q; obtain ⟨L⟩:=roles.OpensΓNX stress vacuum le_rfl h.phase_costs h.ward_oracle timeAxis s p M _ v Certificate.extra_births (by decide)
 exact ⟨M,b,a,F,G,D,T,L,p,W,on_this_experiment Certificate s T,paid_apertures Certificate s T M L p⟩
#print axioms earned_here
