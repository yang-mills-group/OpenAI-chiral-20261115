 let C:= C₀ i; let G:= ΦplanR n (v i); let X:=ScaleSχ P (sc i) G; let d:=deltaR P (sc i); let a:Fin n→PermWallJ P:=fun _=>w i; let T:=TapeI p B0 M pu A D m u S V' X' R' L0 (sc i)
 have ha(k:Fin n):AttainedR 0 (T k):= AttS_R ..
 let A₀:=BodyΘ P T j a; let L:=StageR a (C.porch j) A₀; have hx:BuntR (4*StallJ P (w i)) j l X:=by
    rw [show 4*StallJ P (w i)= d*(4*(StallJ P (w i)/d)) from (by field_simp [show d≠0 from (deltaR_good ..).ne'])]; exact SpinOrdersS G X _ _ _ _ hp (deltaR_good ..).le rfl
 unfold CycleΔR Scroll_S; rw [ηTenderR C.porch l T ha j a X g (hikeπR C.porch _ _ _ _ hx (σ:=a) (fun _=> le_rfl) A₀ (w i).2).1] -- rew under n hazard adjust
 refine le_trans (CensusAmtR (C.porch j) a A₀ X l (mP i) (zero_le_one.trans (one_le_pow₀ (SpringR.tall ..))) (fun k=> h k (a k) j (sc i) f (SportR.hop ..) le_rfl)) ?_
