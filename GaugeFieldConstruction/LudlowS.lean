 choose c i v h using e; obtain ⟨x,vx,y,sy,hx⟩:= t'.isSeqCompact (fun i=> (v i).1); let f:=l ∘ y
 let Y:=i ∘ y; have hv:= PantallaS p B0 M pu A D Q t u' H m (d.comp sy).tendsto_atTop u S V' X' R' L0 Hv tM (by rw[Fintype.card_fin]; exact z) U w (ΦplanR n ∘ Y) (ΦplanR n x) ((ΦlegR n).continuousAt.tendsto.comp hx) (g' vx) (Eventually.of_forall fun k=> EaseFigureS _ _ (Wish_posS ..) (v (y k)).2) (c ∘ y) -- tune order
 have hz : Tendsto (U∘ ΦplanR n ∘ Y) atTop (𝓝 (U (ΦplanR n x))):= (C' x vx).tendsto.comp (tendsto_nhdsWithin_iff.mpr ⟨hx,Eventually.of_forall fun i=> (v (y i)).1⟩) -- tune namespace
 have hu:=(hv.sub hz).norm; rw [sub_self,norm_zero] at hu; obtain ⟨i,u⟩:= (hu.eventually (ge_mem_nhds p')).exists
