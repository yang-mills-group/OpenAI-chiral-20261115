 let mP(i:ℕ):= SpringR P (sc i)^LowSν; let w(i:ℕ):= AutoPadR P (sc i); have he:Tendsto (fun i=> 4*(StallJ P (w i)/deltaR P (sc i))) atTop (𝓝 0):=by
    have ht:= ((R_fit P).comp z).const_mul 4; rw [mul_zero] at ht; exact ht
 obtain ⟨j,l,g,F⟩:= OnCardS (ΦplanR n x) s (fun i=>ΦplanR n (v i)) ((ΦlegR n).continuousAt.tendsto.comp y) _ he
 have hv(i:Fin n):= z.eventually (SpendS_R p B0 M (R' i) pu A D Q t u' H m S V' (u i) (L0 i) (X' i) (Hv i) (le_trans (by decide:26≤ UpShift_S) tM) 26 (by decide))
