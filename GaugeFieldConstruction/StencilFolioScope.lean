 let Q(i:Axis)(x:ZKey):= meterSymbolSt y.P ΧΞ κ eΞ choral i x v
 let F(p:skit)(v:ℕ):= τβ p v; let x₀:= gaΞ; let W:= a.guest.eu
 have h(i j:Axis)(q:skit)(x y':ZKey)(s:TallSceneSt (y:=y) v q): ‖(Ψv) (↑ω v i x) (↑ω v j y') q - estimates_line_st i j x y' (τβ q v)‖ ≤ δ*(‖x‖*‖y'‖):=by
    let a₀:= a.guest.atx; have u₀:= a.guest.gift.song.ticket
    have hp:∀ i:Axis,∀ z:Soul,∀ s:ℝ≥0,0<s→(gaΞ).bar s (choral i z)= (ΣΞ i rayPost y.M ΧΞ rayP 3 μ z) s s:=by intro j z l v; exact shineJ y.P rayPost rayP y.M z j y.ht.tendsto_atTop WΞ eΞ ΧΞ qv l v
    have hC:= windowSightSt y.P y.M ΧΞ κ eΞ a.guest.atx rayPost rayP i j gaΞ W a.guest.mink rfl u₀ choral hp x y' v q s.1
    have he(x:Dialect)(t:Vantage): roles.χVX stress a.guest.atx 1 (Polaris.dot t) ![PCI x]=axisSweep W (fun _:Fin 1=>x) (dot t):= (surfaceInkSt k X C r p V (Polaris.dot t) ![PCI x] (fun _:Fin 1=>x) (fun i=> by fin_cases i; exact hπpi.sends_chars _) (dawn_one_st _)).symm
    let L:= wL v; have hL:0<L:= clockP y.P _
    have hT:Polaris.straight 3 L q:=by unfold Polaris.straight; linarith only [show 60* L ≤ q true 3-q false 3 from s.1.gap,hL]
    have hx:‖(Ψv) (PCI (Q i x)) (PCI (Q j y')) q-estimates_line_st i j x y' (τβ q v)‖ ≤ δ*(‖x‖ *‖y'‖):=by
       unfold polTimelineSt; rw[he,he, ←surfaceInkSt k X C r p V (Polaris.cameo q) ![PCI (Q i x),PCI (Q j y')] ![Q i x,Q j y'] (fun t=>by fin_cases t; exact hπpi.sends_chars _; exact hπpi.sends_chars _) (dawn_pair_st _ (wL v) hL hT)]; refine le_trans ?_ (d.portrait 3 (a.guest.atx) costAnalysis q false _ (fun _=>rayP) 3 i j x y' s.2 s.1); apply le_of_eq; rw[hC]; rfl
    exact hx
