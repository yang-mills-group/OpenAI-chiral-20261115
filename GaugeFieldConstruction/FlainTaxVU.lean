noncomputable def BindL_VU : (FrameK (Fin (θ (ΤbandR dΩ))) × ℂ)→ₗ[ℂ]ΝPlanR p B0 M 0 pu A D Sq Wp dΩ:= LinearMap.codRestrict _ (Blanks p B0 M pu A D dΩ Sq Wp s0 R) (fun y=>OriginFreshR ..)
lemma SteadyVU: Surjective (BindL_VU p B0 M R pu A D s0 Sq Wp dΩ):= fun u=> by obtain ⟨Ω,t⟩:=OriginCoreR p B0 M R pu A D dΩ Sq Wp u s0; exact ⟨Ω,Subtype.ext t⟩ -- tune variable order
noncomputable def PrepLMVU (s t:ℕ): (FrameK (Fin (θ (ΤbandR dΩ))) × ℂ)→ₗ[ℂ]P.Test:=(if p:s≤t then (LaunchLJ B0 0 R _ 0 (Sq 0 R _) D s t p).comp (LinearMap.fst ..) else 0)+(LinearMap.snd ..).smulRight (1:P.Test)
lemma mapsTaxVU (y:FrameK (Fin (θ (ΤbandR dΩ))) × ℂ)(t:ℕ): (PrepLMVU B0 R D Sq dΩ s t y) = PrestVU B0 R D Sq dΩ y s t:=by
 by_cases p:s≤t <;> unfold PrepLMVU PrestVU <;> (first| rw [dif_pos p,dif_pos p]|rw [dif_neg p,dif_neg p])
 <;> rfl -- tune
noncomputable abbrev PutFieldVU (e:ΝPlanR p B0 M 0 pu A D Sq Wp dΩ):= (LinearMap.exists_rightInverse_of_surjective (BindL_VU p B0 M R pu A D s0 Sq Wp dΩ) (LinearMap.range_eq_top.mpr (SteadyVU p B0 M R pu A D s0 Sq Wp dΩ))).choose e
noncomputable def BirdTaxVU:= (LinearMap.exists_rightInverse_of_surjective (BindL_VU p B0 M R pu A D s0 Sq Wp dΩ) (LinearMap.range_eq_top.mpr (SteadyVU p B0 M R pu A D s0 Sq Wp dΩ))).choose
lemma SalaryVU (x:ΝPlanR p B0 M 0 pu A D Sq Wp dΩ): PerformerVU (PrestVU B0 R D Sq dΩ (BirdTaxVU p B0 M R pu A D s0 Sq Wp dΩ x) s) x.val:=by
 let V:= BindL_VU p B0 M R pu A D s0 Sq Wp dΩ; let Ω:= BirdTaxVU p B0 M R pu A D s0 Sq Wp dΩ; let J:=V (Ω x); have e:J=x:=LinearMap.congr_fun (((LinearMap.exists_rightInverse_of_surjective V (LinearMap.range_eq_top.mpr (SteadyVU p B0 M R pu A D s0 Sq Wp dΩ))).choose_spec)) x
 have hp := ΘVenue_S p B0 M 0 R ΔT pu A (Sq 0 R _) D (Wp.go ..) s0 (Ω x).1 0
 refine ⟨?_,(eventually_ge_atTop s).mono fun r p' i=>BoothVU B0 R D Sq dΩ _ _ p' i⟩
 exact (congrArg Subtype.val e) ▸ (show VenueX 0 J.val (PrestVU B0 R D Sq dΩ (Ω x) s) from hp.plus 0 (VenueZ_S 0 (Unitφ _) _)) -- tune
