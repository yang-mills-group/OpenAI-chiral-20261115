lemma gridHarvest_R (u:Tendsto (fun i=>mount ((Richm_R P m (L i))⁻¹) (A i) 3) atTop (𝓝 (1/2))): Tendsto (fun i=> mount ((Richm_R P m (L i))⁻¹) (TurnCompR P (A i))) atTop (𝓝 PositiveBα) ∧
 Tendsto (fun i=> mount ((Richm_R P m (L i))⁻¹) (RiseMirrorR 3 (TurnCompR P (A i)))) atTop (𝓝 (-PositiveBα)):=by
 let z(i:ℕ):=(Richm_R P m (L i))⁻¹; let a(i:ℕ):=TurnCompR P (A i); let w(i:ℕ):= mount (z i) (a i)
 have hp(j:Axis)(q:j≠3): Tendsto (fun i:ℕ=> w i j) atTop (𝓝 0):=by
   rw [tendsto_zero_iff_norm_tendsto_zero]; let C:ℝ:= ruler P.par.block; have p:Tendsto z atTop (𝓝 0):=tendsto_inv_atTop_zero.comp ((Richm_lit P m).comp pL)
   refine squeeze_zero (fun _=>norm_nonneg _) (fun i=>?_) (show Tendsto (fun i=>|z i| *C) atTop (𝓝 0) from (by simpa using (p.abs.mul_const C)))
   rw[Real.norm_eq_abs]; change |z i*(a i j:ℝ)|≤_; rw[abs_mul]; apply mul_le_mul_of_nonneg_left _ (abs_nonneg _); unfold C a; exact_mod_cast inclinationR P (A i) q
 have hP:Tendsto (fun i:ℕ=> w i 3) atTop (𝓝 (1/2)):= u.congr fun i=> by change z i*((A i) 3:ℝ)= _; change _=z i*(a i 3:ℝ); rw[show a i 3=(A i) 3 from inclineΓ ..]
 have W (F:ℕ→E4)(x:E4)(p:∀ i:Axis,Tendsto (fun n=>F n i) atTop (𝓝 (x i))):Tendsto F atTop (𝓝 x):=(show Continuous (fun p:Axis→ℝ=> (WithLp.toLp 2 p:E4)) by fun_prop).continuousAt.tendsto.comp (show Tendsto (fun i=>(F i).ofLp) atTop (𝓝 x.ofLp) from tendsto_pi_nhds.mpr p)
 constructor <;> apply W -- tune
 · intro j; change Tendsto (fun i=>w i j) _ _; simp only[PositiveBα,PiLp.smul_apply,smul_eq_mul,τPe]; split_ifs with h; · subst j; simpa using hP
   rw [mul_zero]; exact hp j h
 intro j; simp only[PositiveBα,PiLp.neg_apply,PiLp.smul_apply,smul_eq_mul,τPe]; split_ifs with h
 · subst j; rw [mul_one]; apply hP.neg.congr; intro i; change -(_*_)= z i*(↑(RiseMirrorR 3 (a i) 3):ℝ); rw [RiseDirR,if_pos rfl, Int.cast_neg,mul_neg]; rfl -- tune
 rw [mul_zero,neg_zero]; apply (hp j h).congr; intro i; change _=z i*(RiseMirrorR 3 (a i) j:ℝ); rw [RiseDirR,if_neg (Ne.symm h)]; rfl
abbrev HarkenR (P:Spine)(x:P.VMark)(s:ℕ)(v:ℤ) :Cover:= P.adventJ x s+(ruler P.calibration.B*(-v)) • Lattice.step 3
variable {T1:ℕ→ P.VMark}{z':ℕ→PermWallJ P} {j:ℕ→ℤ}
lemma harkenPlotR (G:Tendsto (fun i=> StallJ P (z' i)/deltaR P (L i)) atTop (𝓝 (1/2)))
 (h:∀ᶠ i in atTop,A i=HarkenR P (T1 i) (SportR P m (L i)) (j i) ∧ T1 i 3 - (z' i).val= P.stampPin (SportR P m (L i)) (j i)): Tendsto (fun i=> mount ((Richm_R P m (L i))⁻¹) (A i) 3) atTop (𝓝 (1/2)):=by
 let z(i:ℕ):=(Richm_R P m (L i))⁻¹; let F i:=StallJ P (z' i); let X i:= mount (z i) (A i) 3; let s (i:ℕ):=SportR P m (L i); let D i:=deltaR P (L i)
 have he:∀ᶠ i in atTop,|X i - F i/D i| ≤ z i :=by
    filter_upwards[h] with i u; let S:= s i; let O:= (T1 i 3:ℝ); let M:= P.mellow S; let k:= P.adventJ (T1 i) S 3; let L₀:= ruler P.par.block; let V:=j i
    have hv:0<M:=P.mellow_good _; have ht:=P.spale_J (T1 i) S 3; have p:M*(Richm_R P m (L i))=D i:=Richm_peck ..; have hz: z i* D i= M:=by unfold z; rw [←p]; field_simp [(Richm_good P m (L i)).ne']
    have hh: O-F i=M*(L₀*V:ℤ):=by
       have hx:O-F i=(P.stampPin S V:ℝ):=congrArg Subtype.val u.2; exact hx.trans (P.mellow_firm ..)
    have hf:A i 3=(k+L₀*(-V):ℤ):=by rw [u.1]; unfold HarkenR; simp; try rfl
    have hy:0 < D i:= deltaR_good ..; apply le_of_mul_le_mul_right (a:=D i) _ hy -- tune signature.
    rw [←abs_of_nonneg hy.le,←abs_mul,abs_of_nonneg hy.le, _root_.sub_mul, div_mul_cancel₀ _ hy.ne'] -- direction tune
    change |z i*(A i 3:ℝ)*D i - F i| ≤ _; rw[hf,mul_right_comm, hz]; rw [show M * ((↑(k+L₀ * -V):ℝ))-F i=M*k-O by push_cast at *; linear_combination hh]
    rw[abs_sub_comm]; exact ht
 let E(i:ℕ):= X i-F i/D i; have hp:Tendsto E atTop (𝓝 0):=by
   rw [tendsto_zero_iff_norm_tendsto_zero]; exact squeeze_zero' (Eventually.of_forall fun i=>norm_nonneg _) he (tendsto_inv_atTop_zero.comp ((Richm_lit P m).comp pL))
 let g:=hp.add G; rw [zero_add] at g; exact g.congr fun i=> sub_add_cancel (X i) _
