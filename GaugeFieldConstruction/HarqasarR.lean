 obtain ⟨h,t'⟩:= gridHarvest_R m pL p; have he: -PositiveBα≠ PositiveBα:=fun h=>by have hz:=RobustGapR; rw [h,sub_self] at hz; exact Wick.exposed hz.symm -- tune
 have V:= AdventLoanR D Q t u' H m pL t' h he (cruiseHomR 3 _ _ _ P0) P1 -- tune
 rw [ΦOrientationR sF x X pe, ← Mirror.price, ←pe,BigP,RobustGapR] at V; apply V.congr; intro i
 let S:=SportR P m (L i); let w:=InclιR P (A i); let G:=SportRockR D m (L i) (aptC d) (RiseMirrorR 3 (A i)) a (cargoν (plane 3 0) false X); let U:=SportRockR D m (L i) (aptC d') (A i) b Y
 rw [←PublicRide (s:=S) (G*U) w,map_mul,RockRidesR,RockRidesR, EraShadeR]
