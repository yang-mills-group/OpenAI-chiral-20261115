namespace FusingQz
variable (Y:Submodule ℂ (ScreensJ P))(e:EarlyAll_S Y)(K:CoinsR P) (X:DiagramR (Fin n))(r:Fin n→Y)(j:Fin n)
local instance modCQ: Module ℂ (↥Y):=Submodule.module Y
local instance addCQ: AddCommGroup (↥Y):=Submodule.addCommGroup Y
-- module coercions.Multiplication.Caution parser with pi
lemma ΓqualQ (A:Fin n→ScreensJ P)(h:∀ i, A i∈Y) (x:ScreensJ P)(p:x∈ Y): SumBill_S K Y X (Function.update (fun i=>⟨A i,h i⟩) j ⟨x,p⟩)=SπR K.porch (Function.update A j x) X:=by
 unfold SumBill_S; congr 1; funext i; by_cases u:i=j; · subst i; simp only [Function.update_self] -- tune instance.Classical
 simp only [Function.update_of_ne u]

include e
private lemma ΓacoQ (A:Fin n→ ScreensJ P)(h:∀ i,A i∈Y)(x y: ScreensJ P)(v:x∈Y)(w:y∈Y)(c:ℂ): SπR K.porch (Function.update A j (c • x+y)) X= c*SπR K.porch (Function.update A j x) X+ SπR K.porch (Function.update A j y) X:=by
 rw[←ΓqualQ Y K X j A h _ (Y.add_mem (Y.smul_mem c v) w),←ΓqualQ Y K X j A h _ v,←ΓqualQ Y K X j A h _ w]; exact ΚPlusS K Y e X (fun i=>⟨_,h i⟩) j ⟨_,v⟩ ⟨_,w⟩ c
lemma UpZeroQ (A:Fin n→ ScreensJ P)(h:∀ i,A i∈Y): SπR K.porch (Function.update A j 0) X=0:=by
 have a:= ΓacoQ Y e K X j A h 0 0 Y.zero_mem Y.zero_mem 1
 have v: (1:ℂ) • (0:ScreensJ P)=0:=by funext i j k; exact one_smul ℂ (0:P.Slabs i)
 rw [v,add_zero,one_mul] at a; exact (add_eq_left.mp a.symm) -- tune order
lemma ΛpayQ {G:Type}[Fintype G](c:G→ℂ)(F:G→ ScreensJ P)(q:∀ i,F i∈ Y)(A:Fin n→ ScreensJ P)(h:∀ i,A i∈Y): SπR K.porch (Function.update A j (∑ i:G,c i • F i)) X= ∑ i:G,c i*SπR K.porch (Function.update A j (F i)) X:=by
 suffices v:∀ S:Finset G,SπR K.porch (Function.update A j (∑ i∈S,c i • F i)) X= ∑ i∈S,c i*SπR K.porch (Function.update A j (F i)) X from v _
 intro S; induction S using Finset.induction_on with
 | empty=>rw[sum_empty,sum_empty]; exact UpZeroQ Y e K X j A h
 | insert a s ha ih=> rw[sum_insert ha,sum_insert ha, ΓacoQ Y e K X j A h _ _ (q a) (Y.sum_mem (fun i _=>Y.smul_mem (c i) (q i))),ih]
#print axioms ΛpayQ
-- slot representations: convert head via Fin.cons outer any.F.No Plenum.P Twist second with swap.Advert
lemma HectorQ {G:Type}[Fintype G](c:G→ℂ)(F:G→ ScreensJ P)(q:∀ i,F i∈ Y)(A:Fin n→ScreensJ P)(h:∀ i,A i∈ Y)(X: DiagramR (Fin (n+1))) : SπR K.porch (Fin.cons (∑ i:G,c i • F i) A) X=∑ i:G,c i*SπR K.porch (Fin.cons (F i) A) X:=by
 let P0:Fin (n+1)→ScreensJ P:= Fin.cons 0 A; have he(x:ScreensJ P): Function.update P0 0 x=(Fin.cons x A):=by funext i; cases i using Fin.cases; rw[Function.update_self]; rfl; next k=> rw [Function.update_of_ne (Fin.succ_ne_zero k)]; simp only[P0,Fin.cons_succ]
 have u(i:Fin (n+1)): P0 i∈Y:=by cases i using Fin.cases; exact Y.zero_mem; next j=> simpa only [P0,Fin.cons_succ] using h j
 rw [←he,ΛpayQ Y e K X 0 c F q P0 u]; simp_rw[he]
lemma HectorΡQ {G:Type}[Fintype G](c:G→ℂ)(F:G→ ScreensJ P)(q:∀ i,F i∈ Y)(Z:ScreensJ P)(t:Z∈Y)(A:Fin n→ScreensJ P)(h:∀ i,A i∈Y)(X:DiagramR (Fin (n+2))) : SπR K.porch (Fin.cons Z (Fin.cons (∑ i:G,c i • F i) A)) X=∑ i:G,c i*SπR K.porch (Fin.cons Z (Fin.cons (F i) A)) X :=by
 let P0:Fin (n+2)→ScreensJ P:= Fin.cons Z (Fin.cons 0 A); let T0:=Fin.succ (0:Fin (n+1)); have he(x: ScreensJ P): Function.update P0 T0 x= Fin.cons Z (Fin.cons x A):=by
    funext i; cases i using Fin.cases
    rw [Function.update_of_ne (Ne.symm (Fin.succ_ne_zero _))]; rfl
    next j=>
     cases j using Fin.cases
     rw[show (0:Fin (n+1)).succ=T0 from rfl,Function.update_self]; rfl
     next k=> simp only [T0,P0,Function.update_of_ne (show k.succ.succ≠T0 from fun e=> Fin.succ_ne_zero _ (Fin.succ_injective _ e)), Fin.cons_succ]
 have u(i: Fin (n+2)): P0 i∈Y:=by cases i using Fin.cases; exact t; next j=>cases j using Fin.cases; exact Y.zero_mem; next k=>simpa only[P0,Fin.cons_succ] using h k
 rw [←he,ΛpayQ Y e K X T0 c F q P0 u]; simp_rw[he]
#print axioms HectorΡQ
