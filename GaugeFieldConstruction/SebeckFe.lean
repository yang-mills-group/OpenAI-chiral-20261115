lemma jointFe {F F' G G':P.Test}(p:SaberFe P gi F F')(q:SaberFe P gi G G')(v:DuskFe P s)(e:DuskFe P r) (h:P.Habitable i F s A' B' X)(n:P.Habitable i F' s A' B' Z)(w:P.Habitable i G r A' B' Y)(l:P.Habitable i G' r A' B' U) : inner ℂ (DotM_R P i X) (DotM_R P i Y)=inner ℂ (DotM_R P i Z) (DotM_R P i U):=by
 obtain ⟨k,uH,uG,uK,uY⟩:= (h.event.and (n.event.and (w.event.and l.event))).exists
 obtain ⟨a,t,b,j,k0,U1,U2⟩:= uH; obtain ⟨L1,L2⟩:=uK.for_me j k0; obtain ⟨O1,O2⟩:=uG.for_me j k0; obtain ⟨T1,T2⟩:=uY.for_me j k0
 unfold DotM_R; rw [replica_L i _ U1 L1 U2 L2, replica_L i _ O1 T1 O2 T2]
 have hv: SaberFe _ _ _ _ := SaberFe.makeFe p s (k-s) (fun i t=> (v i t).1)
 apply Eq.symm
 exact (v k a).2 _ _ _ (((hv.moving i (-t)).flip i).mul ((SaberFe.makeFe q r (k-r) (fun i t=> (e i t).1)).moving i (-t)))
lemma dotdistFE {F F' G G':P.Test}(p:SaberFe P gi F F')(q:SaberFe P gi G G')(v:DuskFe P s)(e:DuskFe P r)(h:P.Habitable i F s A' B' X)(n:P.Habitable i F' s A' B' Z)(w:P.Habitable i G r A' B' Y)(l:P.Habitable i G' r A' B' U) : dist (DotM_R P i X) (DotM_R P i Y)= dist (DotM_R P i Z) (DotM_R P i U):=by
 let A:= DotM_R P i X; let B:= DotM_R P i Y; let C:= DotM_R P i Z; let D:= DotM_R P i U
 have he : inner ℂ (A-B) (A-B)=inner ℂ (C-D) (C-D):=by
   simp only [inner_sub_left,inner_sub_right]; unfold A B C D; rw [jointFe i p p v v h n h n,jointFe i p q v e h n w l,jointFe i q p e v w l h n,jointFe i q q e e w l w l]
 rw [inner_self_eq_norm_sq_to_K,inner_self_eq_norm_sq_to_K] at he; change (↑‖A-B‖:ℂ)^2= (↑‖C-D‖:ℂ)^2 at he; rw [←Complex.ofReal_pow,←Complex.ofReal_pow] at he; rw [dist_eq_norm,dist_eq_norm]; exact (pow_left_inj₀ (norm_nonneg _) (norm_nonneg _) (by omega)).1 (Complex.ofReal_injective he)
end
abbrev ClanFe (gi:Flavor)(x:P.VMark)(X Y:ScreensJ P):Prop:=∃ F G:ℕ→P.Test, VenueX x X F∧VenueX x Y G∧∀ᶠ i in atTop,SaberFe P gi (F i) (G i)
lemma dot_contFe : Continuous (DotM_R P i):=by unfold DotM_R; exact continuous_subtype_val.clm_apply continuous_const
namespace ClanFe
variable {X Y Z U: ScreensJ P}{F G:ℕ→P.Test}
variable (υ:∀ᶠ t in atTop,DuskFe P t)
include υ
lemma Staying (p:ClanFe gi x X Y)(q:ClanFe gi x Z U) : dist (DotM_R P i (X i σ τ)) (DotM_R P i (Z i σ τ))=dist (DotM_R P i (Y i σ τ)) (DotM_R P i (U i σ τ)):=by
 obtain ⟨A,B,W,h,u⟩:=p; obtain ⟨C,D,Y',T,p⟩:=q; obtain ⟨f,k,l⟩:=W.1 i σ τ; obtain ⟨f',k',l'⟩:=h.1 i σ τ; obtain ⟨r,w,j⟩:=Y'.1 i σ τ; obtain ⟨r',w',j'⟩:=T.1 i σ τ
 let R:= dot_contFe (P:=P) i; refine tendsto_nhds_unique_of_eventuallyEq ((R.continuousAt.tendsto.comp k).dist (R.continuousAt.tendsto.comp w)) ((R.continuousAt.tendsto.comp k').dist (R.continuousAt.tendsto.comp w')) ?_
 filter_upwards[υ,u,p,l,l',j,j'] with k H h e c d i' x; exact dotdistFE i h e H H c d i' x
variable {i}
lemma fixedFe {F F':P.Test}{A B:P.Slabs i}(p:ClanFe gi x X Y)(q:SaberFe P gi F F')(v':DuskFe P s)(h: CallBoxJ x σ τ i F A s)(e:CallBoxJ x σ τ i F' B s) : dist (DotM_R P i (X i σ τ)) (DotM_R P i A)=dist (DotM_R P i (Y i σ τ)) (DotM_R P i B):=by
 obtain ⟨F,G,Q,L,u⟩:=p; obtain ⟨f,k,l⟩:= Q.1 i σ τ; obtain ⟨f',k',l'⟩:=L.1 i σ τ; let Z:=DotM_R P i; have he:= dot_contFe (P:=P) i
 refine tendsto_nhds_unique_of_eventuallyEq ((he.continuousAt.tendsto.comp k).dist (tendsto_const_nhds (x:=Z A))) ((he.continuousAt.tendsto.comp k').dist (tendsto_const_nhds (x:= Z B))) ?_
 filter_upwards [υ,u,l,l'] with i' hP k l w; exact dotdistFE i k q hP v' l w h e
lemma preservesFE (p: ClanFe gi x X Y):Heapψ P X=Heapψ P Y:=by
 obtain ⟨A,B,W,h,u⟩:=p; let σ:= Sehya P; let V:= VirtueJ P.publicH 3; have hv:= livingJ P.publicH 3
 obtain ⟨f,k,l⟩:=W.1 3 σ σ; obtain ⟨f',k',l'⟩:=h.1 3 σ σ
 refine tendsto_nhds_unique_of_eventuallyEq (hv.continuousAt.tendsto.comp k) (hv.continuousAt.tendsto.comp k') ?_
 filter_upwards [υ,u,l,l'] with t p h k u; change V _=V _; unfold V; rw [CallΨJ P.publicH (MeanBylawsJ P) k, CallΨJ P.publicH (MeanBylawsJ P) u]; exact ((p t le_rfl).2 _ _ _ h).symm
omit υ
lemma violinFe (x:P.VMark)(gi:Flavor) : ClanFe gi x (CandΛJ P) (CandΛJ P):= ⟨_,_,Unitφ x,Unitφ x,Eventually.of_forall fun _ i j=> (map_one (twist _)).symm⟩
lemma scalesFe (p:ClanFe gi x X Y)(z:ℂ):ClanFe gi x (z • X) (z • Y):=by obtain ⟨F,G,q,H,v⟩:=p; exact ⟨_,_,VenueZ_S x q z,VenueZ_S x H z,v.mono fun i e=>e.scale z⟩
lemma addsFe (p:ClanFe gi x X Y)(q:ClanFe gi x Z U): ClanFe gi x (X+Z) (Y+U):=by obtain ⟨F,G,h,t,u⟩:=p; obtain ⟨D,V,w,j,v⟩:=q; exact ⟨_,_,VenueX.plus x h w,VenueX.plus x t j, (u.and v).mono fun i x=> x.1.together x.2⟩
