abbrev DuskFe (P:Spine) (r:ℕ): Prop:=∀ t≥r,P.FrozenFe t∧P.EpochEFe t
lemma duskTrueFe(P:Spine)(C:Clip→ℝ)(τ:ℝ)(O:Oath.BellPrice.PinRack→Badge)(Q:TintDemand)(N:ℕ)(H:Armature C τ O P Q N):∀ᶠ s in atTop,DuskFe P s:=by
 obtain ⟨u,p⟩:= eventually_atTop.1 ((aspenFe _ _ _ _ _ _ H).and (inevitE _ _ _ _ _ _ H))
 exact (eventually_ge_atTop u).mono fun i v z k=> p z (v.trans k)
