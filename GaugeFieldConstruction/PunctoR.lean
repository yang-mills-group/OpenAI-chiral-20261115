abbrev BazaarP (f:ℕ)(q:f0 ≤ f) (d:D_r)(R:Signed × Bool):= Panmart p B0 M x R (ΤbandR d) pu A (S x R _) D (V.go x R _) f q -- `g unused` remove
abbrev TivieraR (d:D_r):= BazaarP p B0 M x pu A D S V f0 le_rfl d ((1,false): Signed × Bool)
lemma orientP_R (g:f0≤ f):BazaarP p B0 M x pu A D S V f g u R= TivieraR p B0 M x pu A D S V u:=by
 rw[show BazaarP p B0 M x pu A D S V f g u R= _ from PantryForever p B0 M x R _ pu A (S x R _) D (V.go x R _) le_rfl g]; exact le_antisymm (PlanΘJ p B0 M x R _ pu A _ D _ _ _ le_rfl _ _ _) (PlanΘJ p B0 M x _ _ pu A _ D _ _ _ le_rfl _ _ _)
lemma TieRiseR (e: ΤbandR u≤ΤbandR Ev2): TivieraR p B0 M x pu A D S V u ≤ TivieraR p B0 M x pu A D S V Ev2:= PlanΘJ p B0 M x _ _ pu A _ D _ _ _ e _ _ _
