lemma VoiceT_R (R0: Waves)(h:LegL R0 u):∃ Z: FrameK (Fin (θ (ΤbandR u))), LiPaJ B0 R (ΤbandR u) Z= R0∧ LoomK Z ≤ |G| * ‖R0‖:=by
 have a:= Tsava p B0 M R (ΤbandR u) pu; obtain ⟨i,h⟩:= (Tsava p B0 M R (ΤbandR u) pu).coframe _ (show ΓProj (metK u) R0=R0 from h); refine ⟨i,h.symm,(a.brake i).trans ?_⟩; rw[←h]; exact mul_le_mul_of_nonneg_right (le_abs_self _) (norm_nonneg _)
variable {o}
include pu p
lemma WallReachR (X:BezelR)(h:X∈PerlSetR u):∃ Z:FrameK (Fin (θ (ΤbandR u))),LiPaJ B0 R (ΤbandR u) Z= X.2.2∧ LoomK Z ≤ |G| * ‖X.2.2‖:= VoiceT_R p B0 M R pu u _ (sortNatR _ _ _ h.2 (HorseR _ _ X.1 h.1)) -- parser .. tweak
noncomputable def InvolveR(X:BezelR):FrameK (Fin (θ (ΤbandR u))):=if t:X∈ PerlSetR u then (WallReachR p B0 M R pu u _ t).choose else 0
lemma bills_R (X:BezelR)(h:X∈PerlSetR u): LiPaJ B0 R (ΤbandR u) (InvolveR p B0 M R pu u X)= X.2.2∧ LoomK (InvolveR p B0 M R pu u X)≤|G| * ‖X.2.2‖:=by unfold InvolveR; simp only [dif_pos h]; exact (WallReachR p B0 M R pu u _ h).choose_spec
abbrev DecalR (g:f0≤ f)(u:D_r) (X:BezelR)(L:finsJ):=CartoonR p B0 M x R (ΤbandR u) pu L A (S x R _) D (V.go x R _) g m (aptC X.2.1) X.1 (InvolveR p B0 M R pu u X)
include g
lemma DecalZoneR (X:BezelR)(L:finsJ): DecalR p B0 M x R pu A D m S V g u X L∈Utf0P (TivieraR p B0 M x pu A D S V u):=by
 let v:=g.trans (SportR.hop P m f); let K:= InvolveR p B0 M R pu u X; let Z:=S x R (ΤbandR u); let F:=ΦCentered p B0 M x R _ pu A Z D (V.go ..) v
 rw [← orientP_R p B0 M x R pu A D u S V v]; unfold BazaarP; rw [← PanZeroJ]; exact ⟨(WrappR D m f (aptC X.2.1) X.1 • BrJ (ΤbandR u) (Z.sun L (SportR P m f)).1 K),rfl⟩ -- F infer Lean
lemma DecalBudgetsR (X:BezelR)(h:X∈PerlSetR u)(L:finsJ): TakesR p B0 M x pu A (DecalR p B0 M x R pu A D m S V g u X L) (|G| * ‖X.2.2‖) X.2.2 X.2.1 (ΤbandR u) X.1 D g m R (S x R _) (V.go x R _):=by
 obtain ⟨z,t⟩:=bills_R p B0 M R pu u X h; exact ⟨rfl,L,_,z.symm,t,rfl⟩
-- ensure pad Norm.Polarization variants `V = grade input or top.Clock`
abbrev RankJointR (q:Bool)(g:f0≤ f)(d:D_r)(X:BezelR)(L:finsJ) : ScreensJ P := if q then DecalR p B0 M x R pu A D m S V g d X L else DecalR p B0 M x R pu A D m S V g X.2.1 X L
lemma RankRentR (L:finsJ)(q:Bool)(X:BezelR)(h:X∈ PerlSetR u): let d:= (if q then u else X.2.1)
 let k:=ΤbandR d
 aptC X.2.1 ≤3+k.val∧ k ≤ ΤbandR u ∧ TakesR p B0 M x pu A (RankJointR p B0 M x R pu A D m S V q g u X L) (|G| * ‖X.2.2‖) X.2.2 X.2.1 k X.1 D g m R (S x R k) (V.go x R k):=by
 intro d k; have ht:ΤbandR X.2.1 ≤ ΤbandR u:=h.2; by_cases H:q; · subst q; exact ⟨(by rw [←normandR]; exact Nat.add_le_add_left ht 3),le_rfl, DecalBudgetsR p B0 M x R pu A D g m u S V X h L⟩ -- tune order
 have hq:q=false:=Bool.not_eq_true _ |>.mp H; subst q; exact ⟨(normandR X.2.1).symm.le,ht,DecalBudgetsR p B0 M x R pu A D g m X.2.1 S V X ⟨h.1,le_rfl⟩ L⟩
lemma RankPaysR (L:finsJ)(q:Bool)(X:BezelR)(h:X∈ PerlSetR u): RankJointR p B0 M x R pu A D m S V q g u X L ∈ Utf0P (TivieraR p B0 M x pu A D S V u):=by
 unfold RankJointR; split_ifs; · exact DecalZoneR ..
 have he:Utf0P (TivieraR p B0 M x pu A D S V X.2.1)≤ Utf0P (TivieraR p B0 M x pu A D S V u):=inf_le_inf_right _ (TieRiseR p B0 M x pu A D _ _ S V h.2) -- orientation
 exact he (DecalZoneR ..)
