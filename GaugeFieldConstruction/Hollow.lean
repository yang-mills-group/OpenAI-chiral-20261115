lemma gableπ (H:InkD (mid P B))(T:Pane (mid P B))(v:lyric G t' W H Y Z p₁ p₂ q₁ q₂ T Tg ≠ 0):∃ Q':Palot.leaf (Site (Domain N B)),Stilo.beamH Q'.val= primeY (kR:=kR) Y Z O ∧ Q'.val ⊆ ΦR ∧ Zμ ⊆ Q'.val:=by
 let O':= oQ; let A:=halo kR (hatY S Y); let X:= halo kR (hatY S Z)
 have h: fyL G true W tU Y p₁ q₁≠0:= fun z=> v (by simp [lyric,z]); have h':fyL G false W tU Z p₂ q₂≠0:= fun z=> v (by simp [lyric,z])
 have q:=quip Tg W g_ t' kR i p₁ q₁ Y Qx pR hv hiZ hY S' hy hΩ Zμ hK true h; have hz:=quip Tg W g_ t' kR i p₂ q₂ Z Qx pR hv hj hZ S' hy hΩ Zμ hK false h'
 have ht:oQ∈ Zμ:= hK (halo_subset _ _ (mem_singleton_self _)); let Q':= Zμ∪A∪X; refine ⟨⟨Q',oQ,mem_union_left _ (mem_union_left _ ht)⟩,?_ , Finset.union_subset (Finset.union_subset hZ' (quench Tg W g_ t' kR i p₁ q₁ Y Qx pR hv hiZ hY S' hy hΩ true h)) (quench Tg W g_ t' kR i p₂ q₂ Z Qx pR hv hj hZ S' hy hΩ false h'), Subset.trans subset_union_left subset_union_left⟩
 unfold primeY mark_l; rw [hQ, mastH _ _ q, mastH (Zμ∪A) X]; exact hz.imp id fun h v=>h (Disjoint.mono_left subset_union_left v)
