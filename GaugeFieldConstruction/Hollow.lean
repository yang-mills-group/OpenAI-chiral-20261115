lemma hoard (h:0<radiusB x)(tM:kR=95*radiusB x) (A:Support (Domain N B))(p:A=Lattice.halo (1000*radiusB x) {S.ratio.parent i.val.1})(H:InkD (mid P B))(Uz:Pane (mid P B))(Zκ:Support (Domain N B))(u:Zκ=Lattice.halo kR ((inspected i.val.2).image S.ratio.parent)): let Pt:=ancient (S:=S) Xρ H W t' p₁ p₂ kR (Stilo.beamH Zκ) Tg Uz; (∑ j∈Area (N:=N) (B:=B) Zκ A,Pt (Stilo.beamH j.val))=(∑ i∈Xρ,∑ j:Rock (mid N B),∑ k:Rock (mid N B),lineY j k (lyric G t' W H i.1 i.2 p₁ p₂ j k Uz Tg)) ∧∀ j:MA, j ∉ Area (N:=N) (B:=B) Zκ A → Pt (Stilo.beamH j.val)=0:=by
 intro Pt; have hh:oQ ∈ (inspected i.val.2).image S.ratio.parent:= mem_image_of_mem _ (mem_union_left _ i.property)
 have ht: Lattice.halo (45*(1+radiusB x)) {oQ} ⊆ Zκ:= u.symm ▸ Corona.halo_mono (by omega) (Finset.singleton_subset_iff.mpr hh)
 have hc: Zκ ⊆ ΦR:= by rw [u]; intro v w; obtain ⟨z,t,g⟩:=halo_spec.mp w; obtain ⟨t,H,rfl⟩:=mem_image.mp t; have hz:=short_patch hy hΩ i.property H; rw [separation_comm] at hz; exact halo_spec.mpr ⟨oQ,mem_singleton_self _, (separation_triangle ..).trans (le_trans (add_le_add hz g) (by unfold ventK; omega))⟩
 have he(i': Support (Domain P B)×Support (Domain P B))(y:i'∈ Xρ):= girth Tg W g_ t' kR i p₁ p₂ i'.1 i'.2 Qx pR hv hiZ hj (mem_product.mp y).1 (mem_product.mp y).2 S' hy hΩ Zκ ht hc A (by rw [p]; apply Corona.halo_mono (by unfold ventK; omega) (Finset.Subset.refl _)) H Uz
 unfold Pt ancient; simp_rw [Finset.sum_apply]; rw [Finset.sum_comm (s:=Area (N:=N) (B:=B) Zκ A)]; exact ⟨sum_congr rfl fun i v=>(he i v).1,fun i v=> sum_eq_zero fun j u=>(he _ u).2 i v⟩
