lemma girth (A:Support (Domain N B))(u:ΦR⊆ A)(H:InkD (mid P B))(T:Pane (mid P B)): let Wq:= Stilo.beamH Zμ; let Zq:=fun r s=> lyric G t' W H Y Z p₁ p₂ r s T Tg; let X:= curbY (S:=S) (primeY (kR:=kR) Y Z Wq) Zq; (∑ j ∈ Area (N:=N) (B:=B) Zμ A,X (Stilo.beamH j.val))=(∑ j:Rock (mid N B),∑ k:Rock (mid N B),lineY j k (Zq j k)) ∧∀ j:MA, j ∉ Area (N:=N) (B:=B) Zμ A→ X (Stilo.beamH j.val)=0:=by
 intro Wq Zq X; by_cases he:∃ a b,Zq a b≠0
 · obtain ⟨l,k,p⟩:=he; obtain ⟨j,y,t,w⟩:= gableπ Tg W g_ t' kR i p₁ p₂ l k Y Z Qx pR hv hiZ hj hY hZ S' hy hΩ Wq Zμ rfl hK hZ' H T p
   have ht(j':MA)(p:j'≠j): Stilo.beamH j'.val ≠ Stilo.beamH j.val:= fun i=> p (Subtype.ext (((bay_beam _).symm.trans (congrArg Stilo.bay i)).trans (bay_beam _)))
   change (∑ j∈Area (N:=N) (B:=B) Zμ A,X (Stilo.beamH j.val))=_ ∧_; have h:j∈Area (N:=N) (B:=B) Zμ A:= mem_filter.mpr ⟨mem_univ _,w,t.trans u⟩; unfold X curbY; rw [←y, sum_eq_single_of_mem j h (fun i v e=> Pi.single_eq_of_ne (ht _ e) _),Pi.single_eq_same]; exact ⟨rfl,fun j' w=> Pi.single_eq_of_ne (ht j' (fun i=>w (i.symm ▸ h))) _⟩
 have ht(a b):Zq a b=0:=Classical.not_not.mp (fun hp=> he ⟨a,b,hp⟩); simp [X,curbY,ht,lineY]
