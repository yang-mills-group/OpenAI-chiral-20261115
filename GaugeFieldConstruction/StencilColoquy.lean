 choose X₀ hZ using (fun (i:Axis)(w:Wage3)=> chargedCurrent (P:=P) Y W e L h sC i x p hp (ShapeLab.leg w) k t)
 refine ⟨fun j=> cPay_st (X₀ j),fun i z j l r=>?_ ⟩
 let U':=padBillSt Y x k j l r; let T:= contoBill P h e i p M L hp j (P.advocate 3 x j) W (u:=StallJ P l) (r:=StallJ P r) l.2 r.2
 change U' (cPay_st (X₀ i) (takesPolySt z))= T z; simp_rw [pol_values_st,map_sum,map_smul, takesPolySt, show ∀ w:Wage3, U' (X₀ i w) = T (ShapeLab.leg w) from (fun w=> (hZ i w j l r)), Complex.coe_smul]; exact LinearMap.congr_fun (ShapeLab.columns_map T) z
