lemma WearingOneN (X:ScreensJ P) (F:ℕ→P.Test)(h:VenueX 0 X F):∃ k:ℕ→ℝ,Tendsto k atTop (𝓝 0) ∧∀ᶠ s in atTop,∀ (r:CoinsR P)(x:Cover), ‖r.cash s (P.chartAll x (F s))-Seen1N r X (P.meshPose s x)‖≤ k s:=by
 let L:=jNOne; let k:=fun _:Fin 1=>AutoPadR P 0; obtain ⟨B,h0,H⟩:=VistaScopesN (![F]) (![X]) L (deckΦP 1) (fun i=>by fin_cases i; exact h) 3 k; refine ⟨B,h0,?_⟩; filter_upwards [H] with s p C x
 let y:Fin 1 → Cover:= fun _=>x
 specialize p C y (Mask1_S_N _) (Loot1_S_N _ 3 k); have ht:PoseΝ P s y= ![P.meshPose s x]:=funext fun i=> by fin_cases i; rfl
 have he: MoneyPoseN L (![F]) s y=P.chartAll x (F s):= List.prod_singleton -- tune
 rw[ht,he] at p; exact p
lemma WearingTwoN (X Y:ScreensJ P)(u:VenueX 0 X uF)(v:VenueX 0 Y uG)(σ: Fin 2 → PermWallJ P):∃ k:ℕ→ℝ,Tendsto k atTop (𝓝 0) ∧∀ᶠ s in atTop,∀ (r:CoinsR P)(x y:Cover), Pointers2N (P.meshPose s x) (P.meshPose s y)∈ MasksR (Fin 2) ∩ OpenR 3 σ jNDuo → ‖r.cash s (P.chartAll x (uF s)*P.chartAll y (uG s))-Seen2N r X Y (P.meshPose s x) (P.meshPose s y)‖≤ k s:=by
 let L:=jNDuo; obtain ⟨B,h0,H⟩:= VistaScopesN (![uF,uG]) (![X,Y]) L (deckΦP 2) (fun i=>by fin_cases i; exact u; exact v) 3 σ; refine ⟨B,h0,?_⟩; filter_upwards [H] with s p C x y g; let l:Fin 2 → Cover:= ![x,y]
 have ht: PoseΝ P s l= Pointers2N (P.meshPose s x) (P.meshPose s y):=funext fun i=> by fin_cases i <;> rfl
 specialize p C l (ht ▸ g.1) (ht ▸ g.2); rw [ht] at p; have he: MoneyPoseN L (![uF,uG]) s l=P.chartAll x (uF s)*P.chartAll y (uG s):=by change [_,_].prod = _; rw [List.prod_cons,List.prod_singleton]; rfl
 rw [he] at p; exact p
lemma RateGridN (pc:rC.Normalized) (P:Spine): Tendsto (fun i=>P.gridMass rC i) atTop (𝓝 1) ∧ Tendsto (fun i:ℕ=>∑ k∈P.usedGrid i rC,P.activation i rC k) atTop (𝓝 1):=by
 refine ⟨(show (∫ x,‖rC.val x‖)=1 from (integral_congr_ae (Eventually.of_forall fun x:Vantage=> Real.norm_of_nonneg (pc.1 x))).trans pc.2) ▸ gridMass_limit P rC,?_⟩
 have ht:=P.sum_dose rC; rw [show doseMass rC=1 from pc.2, Complex.ofReal_one] at ht; exact ht
lemma PoseBound1N (h: ∀ x∈tsupport rC.val,‖Seen1N ΞΧ X x-R‖ ≤ ε)(Q:rC.Normalized)(p:VenueX 0 X uF) : ‖Pose1N rC ΞΧ X - R‖≤ ε:=by
 obtain ⟨c,T,G⟩:=WearingOneN X uF p; obtain ⟨g,v⟩:=RateGridN rC Q P
 have F:= (HappeningL1N uF rC ΞΧ X p).sub (v.mul_const R); rw [one_mul] at F
 have ht:= g.mul (T.add_const ε); rw [zero_add,one_mul] at ht; apply le_of_tendsto_of_tendsto F.norm ht
 filter_upwards [G] with i h'; unfold installedN; rw [map_sum,Finset.sum_mul, ← Finset.sum_sub_distrib]; change _ ≤ P.gridMass rC i * (c i+ε); unfold gridMass; rw [Finset.sum_mul]
 refine (norm_sum_le ..).trans (sum_le_sum ?_); intro y t; let w:=P.meshPose i y; rw [map_smul,smul_eq_mul,← mul_sub,norm_mul]; exact mul_le_mul_of_nonneg_left ((norm_sub_le_norm_sub_add_norm_sub _ (Seen1N ΞΧ X w) R).trans (add_le_add (h' ΞΧ y) (h w ((P.usedPose ..).1 t)))) (norm_nonneg _)
lemma PoseBound2N (σ:Fin 2→ PermWallJ P)(U:ScopeL2N (tsupport rC.val) (tsupport rD.val) σ)(h:∀ x∈tsupport rC.val,∀ y∈tsupport rD.val,‖Seen2N ΞΧ X Y x y-R‖≤ ε)(H₁:rC.Normalized)(H₂:rD.Normalized)(pX:VenueX 0 X uF)(pY:VenueX 0 Y uG) : ‖Pose2N rC rD ΞΧ X Y-R‖≤ ε:=by
 obtain ⟨c,T,G⟩:=WearingTwoN uF uG X Y pX pY σ; obtain ⟨g,v⟩:=RateGridN rC H₁ P; obtain ⟨b,e⟩:=RateGridN rD H₂ P
 have F:= (HappeningL2N uF uG rC rD ΞΧ X Y pX pY σ U).sub ((v.mul e).mul_const R); rw [one_mul,one_mul] at F
 have ht:= (g.mul b).mul (T.add_const ε); rw [zero_add,one_mul,one_mul] at ht; apply le_of_tendsto_of_tendsto F.norm ht
 filter_upwards [G] with i h'; change ‖ΞΧ.cash i (installedN uF rC i* installedN uG rD i)-(∑ k∈P.usedGrid i rC,P.activation i rC k)*(∑ k∈P.usedGrid i rD,P.activation i rD k)*R‖≤ P.gridMass rC i *P.gridMass rD i*(c i+ε)
 unfold installedN; rw [Finset.sum_mul,map_sum, Finset.sum_mul,Finset.sum_mul,← Finset.sum_sub_distrib]; unfold gridMass; -- now sum_mul outer
 rw [Finset.sum_mul,Finset.sum_mul]
 refine (norm_sum_le ..).trans (sum_le_sum ?_); intro k p; rw [Finset.mul_sum,map_sum,Finset.mul_sum,Finset.sum_mul,← Finset.sum_sub_distrib,Finset.mul_sum,Finset.sum_mul]; refine (norm_sum_le ..).trans (sum_le_sum ?_); intro j r
 let M:= P.meshPose i k; let Y':=P.meshPose i j; have hp:= (P.usedPose ..).1 p; have he:= (P.usedPose ..).1 r
 rw [smul_mul_assoc,mul_smul_comm,map_smul,map_smul,smul_eq_mul,smul_eq_mul,←mul_assoc (P.activation i rC k) (P.activation i rD j) _,← mul_sub,norm_mul,norm_mul]; have hq:= (norm_sub_le_norm_sub_add_norm_sub _ (Seen2N ΞΧ X Y M Y') R).trans (add_le_add (h' ΞΧ k j (U _ hp _ he)) (h _ hp _ he)); exact mul_le_mul_of_nonneg_left hq (by positivity)
