lemma YolkQ (hM:M.Roll s=⟨RumQ s F p G' V (d0.trans a) b Z₁ Q₁ L μ W,Lapse (VolQ s F p G' V (d0.trans a) b Z₁ Q₁ L μ W)⟩)(hN:N.Roll s=⟨RumQ s F pL tg V' (Z.trans a) b Z₂ Q₂ L' μ' W',Lapse (VolQ s F pL tg V' (Z.trans a) b Z₂ Q₂ L' μ' W')⟩): Ωrite s p₁ M Y₂ p₂ N κ κv (U s) := by
 let σ:= Y₁.F_v (p₁.σ s); let σ':=Y₂.F_v (p₂.σ s)
 have h(d:B): σ' (κ d)=sh (U s) (σ d):=by
    have t:(Yv) (Z₁ d)=σ d:= by unfold σ F_v; simp only [comp_apply, w₁.emb.own]; rw [w₁.track]
    have e':D'.F_v (pL.σ s) (Z₂ (κ d))=σ' (κ d):=by unfold σ' F_v; simp only[comp_apply,w₂.emb.own]; rw[w₂.track]
    rw [← e', ← t,uQ.cards]; unfold F_v; simp only[comp_apply,qH.own]; exact U0.seats s a b.le _
 have u := DominoQX s F p g0 G' V pV D' pL gH tg V' pV' e δ qH U Κ Z U0 d0 a b Y₁ p₁ Z₁ t₁ Q₁ L μ W w₁ Y₂ p₂ Z₂ t₂ Q₂ L' μ' W' w₂ κ κv uQ -- tune.
 have he(A:Finset B)(v:A∈realm_C σ)(p:A.Nonempty):∃ i:B,A={i}:=by
    obtain ⟨i,x⟩:=p; exact ⟨i,Finset.eq_singleton_iff_unique_mem.mpr ⟨x,fun j v'=> (show Set.InjOn σ _ from (mem_filter.mp v).2) v' x (uQ.grip j i)⟩⟩ -- type.Spec
 intro i' t C
