 intro l v pk; obtain e|Q:= Finset.eq_empty_or_nonempty l
 · subst l; rw[image_empty]; change passingF _ _ (Lapse Φ₁ ∅) (Lapse Φ₂ ∅); rw [Lapse, Lapse,if_pos rfl,if_pos rfl]; intro i t p; exact Eq.symm (map_zero ..) -- tune
