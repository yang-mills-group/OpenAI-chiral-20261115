variable {E:Type}[Fintype E][LinearOrder E](fκ:ℂ→+*ℂ)
abbrev hoodAJ (x:FrameK E):FrameK E:=fun i=>fκ (x i)
abbrev JiveJ (F H: MatJ (E:=E)):Prop:=∀ i,hoodAJ fκ (F i)=H (hoodAJ fκ i)
abbrev JerkJ (F H:OffJ (E:=E)):Prop:=∀ i,fκ (F i)=H (hoodAJ fκ i)
abbrev JasmineJ (F H:ThreadJ (E:=E)): Prop:= JiveJ fκ F.1 H.1∧ JerkJ fκ F.2 H.2
lemma Jive_b (F H:MatJ (E:=E))(h:∀ i j:E,H (κEye i) j=fκ (F (κEye i) j)): JiveJ fκ F H :=by
 intro x; funext j; rw [loomer_single x]; change hoodAJ fκ _ j=_; unfold hoodAJ; -- unfold both
 rw [loomer_single]; unfold W_s; simp only[Finset.sum_apply,Pi.smul_apply,smul_eq_mul,map_sum,map_mul,h] -- tune instance κ
lemma ηJone (F:OffJ (E:=E))(x): F x= W_s (fun i=> F (κEye i)) x:=by unfold W_s; nth_rw 1 [Καone x]; rw [map_sum]; simp_rw[map_smul]
lemma Jr_a (F H:OffJ (E:=E))(h:∀i:E, H (κEye i)= fκ (F (κEye i))): JerkJ fκ F H:=fun i=>by rw [ηJone F i,ηJone H]; simp only[W_s,smul_eq_mul,map_sum,map_mul,hoodAJ,h]
structure JasperJ (F F':StaE (E:=E)) (f n:ℕ):Prop where
   post{s:ℕ}(e:f ≤ s)(l:s<n): JiveJ fκ (F.C s) (F'.C s)∧JerkJ fκ (F.a s) (F'.a s)
variable (Pu Qu:StaE (E:=E))(F G:GapE (E:=E))(qf:f≤n)(H:JasperJ fκ Pu Qu f n)(wΧ:∀s:ℕ,f≤ s→s<n→JiveJ fκ (F.G s) (G.G s)∧ JerkJ fκ (F.ε s) (G.ε s))
include H
lemma billΦ (s r:ℕ)(a:f ≤ s)(h:s ≤ r)(x:r ≤ n): JasmineJ fκ (DownJ Pu r s h) (DownJ Qu r s h):=by
 induction h with
 | refl=>rw [DownJ,DownJ,climbing_refl,climbing_refl]; exact ⟨fun i=> rfl,fun i=> map_zero _⟩
 | @step j y ih=>
    let A:= DownJ Pu j s y; let B:=DownJ Qu j s y
    obtain ⟨e,V⟩:= H.post (a.trans y) x; obtain ⟨z,g⟩:= ih (by omega)
    rw [DownJ,DownJ, climbing_succ _ _ y, climbing_succ _ _ y]; refine ⟨fun i=> (e (A.1 i)).trans ?_,fun i=>?_⟩
    · exact congrArg (Qu.C j) (z i)
    change fκ (A.2 i + Pu.a j (A.1 i)) = _; rw [map_add]; exact congrArg₂ (·+·) (g i) ((V (A.1 i)).trans (congrArg (Qu.a j) (z i)))
variable (A B: ThreadJ (E:=E)) (l:ℝ)
lemma hike_J (T:ℂ)(x y:FrameK E): hoodAJ fκ (T • x+y)=fκ T • hoodAJ fκ x+ hoodAJ fκ y:= funext fun i=>(map_add fκ (T*x i) (y i)).trans (congrArg (·+fκ (y i)) (map_mul fκ _ _))
include wΧ
variable (uT:fκ (l:ℂ)=(l:ℂ))
include uT
lemma Jasθ (b:f≤ s)(u:s<n)(p:JasmineJ fκ A B): JasmineJ fκ (κB Pu F l s A) (κB Qu G l s B):=by
 obtain ⟨x,y⟩:=H.post b u; let V:=hoodAJ (E:=E) fκ; obtain ⟨pv,hQ⟩:=wΧ s b u; refine ⟨fun i=>?_,fun i=>?_⟩
 · let k':=V i; change V ((l:ℂ) • Pu.C s (A.1 i) + F.G s i)= (l:ℂ) • Qu.C s (B.1 k') + _; rw [show V _= _ from hike_J fκ Pu Qu H _ _ _,uT,x,p.1,pv]
 change fκ ((l:ℂ)*(A.2 i-Pu.a s (A.1 i))+ F.ε s i)= ↑l* (B.2 (V i)-Qu.a s (B.1 (V i)))+_; rw[map_add,map_mul,map_sub,uT,hQ,p.2,y,p.1] -- tune
lemma GlowJ (s r:ℕ)(a:f ≤ s)(b:s ≤ r)(v:r ≤ n)(p:JasmineJ fκ A B): JasmineJ fκ (TravelBJ Pu r s F l b A) (TravelBJ Qu r s G l b B):=by
 induction b with
 | refl=>rw [TravelBJ,TravelBJ,climbing_refl,climbing_refl]; exact p
 | step h ih=>rw [TravelBJ,TravelBJ,climbing_succ _ _ h, climbing_succ _ _ h]; exact Jasθ _ fκ Pu Qu F G H wΧ _ _ l uT (a.trans h) v (ih (by omega)) -- tune
#print axioms billΦ
#print axioms GlowJ
#check hike_J
