 unfold T Fragment; rw [Module.finrank_pi_fintype]; simp only [sum_const,card_univ]; change Fintype.card VFlavorNX * _≤ _; have ht:Fintype.card VFlavorNX=18:=by norm_num [VFlavorNX,Matter.FlavorIndex,Matter.Link,Matter.Generation]
