 have h: UniComR three ≤ LinearMap.range Y:=by
    rintro i ⟨⟨⟨x,a,b,c⟩,rfl⟩,t⟩; have h:x=0:=t; subst x; exact ⟨b,(by rw [show a=0 from Subsingleton.elim ..,show c=0 from Subsingleton.elim ..]; rfl)⟩ -- tune
 letI:FiniteDimensional ℂ (LinearMap.range Y):= Module.Finite.range _
 refine (Submodule.finrank_mono h).trans ((LinearMap.finrank_range_le Y).trans ?_)
 have hp: Module.finrank ℂ (UF three) ≤ 4:=by
    change Module.finrank ℂ (Row.Record.space Row.B) ≤ _; unfold Row.Record.space; apply (LinearMap.finrank_range_le _).trans; change Module.finrank ℂ (Axis→ℂ)≤ _; rw [Module.finrank_pi]; simp
 letI : AddCommGroup (UF three) := @Submodule.addCommGroup ℂ _ _ _ _ _ -- instance tune
