lemma DiverseVistaPV (k:K ⊆ VantageN⁻¹' MasksR I) : ∃ c:ℕ→ℝ,Tendsto c atTop (𝓝 0) ∧ ∀ᶠ s in atTop, ∀ (Cε:CoinsR P)(i:MeshN I), i∈DustyN P K (u' s) pμ → ‖Cε.cash (u' s) (MoneyPoseN L (fun i=> Fcost i s) (u' s) (TownN i))- SπR Cε.porch X (PoseΝ P (u' s) (TownN i))‖≤ c s:=by
 choose L' σ eL b using fun u:K=> OpenTollR P (k u.2 3)
 let U(u:K): Set (SpaceN I):=VantageN⁻¹'OpenR 3 (σ u) (L' u)
 obtain ⟨q,h⟩:= pμ.elim_finite_subcover U (fun u=> (Opens_R ..).preimage FormalV_N) (fun x v=> Set.mem_iUnion.mpr ⟨⟨x,v⟩,b ⟨x,v⟩⟩)
 choose C T Z using fun u:K=>LicenseSizedPV X Fcost S pX (L' u) (eL u) u' e 3 (σ u)
 refine ⟨fun t=>∑ u∈q, |C u t|,by simpa only [abs_zero, sum_const_zero] using tendsto_finsetSum q (f:=fun i t=> |C i t|) (fun u _=> (T u).abs),?_⟩ -- tune
 filter_upwards [(eventually_all_finset q).2 (fun i _=> Z i)] with s w c i g
 let t:=u' s
 have he:= (dustN P K t pμ i).1 g
 obtain ⟨u,l,p⟩:= Set.mem_iUnion₂.mp (h he)
 have hs: PoseΝ P t (TownN i)=VantageN (atTick (P.macroStep t) i):=TownPoseN P t i
 have hy: MoneyPoseN L (fun i=> Fcost i s) t (TownN i)= MoneyPoseN (L' u) (fun i=> Fcost i s) t (TownN i):=(List.Perm.map _ (poles_permR alpΙ (eL u))).prod_eq
 change ‖c.cash t _ - _‖ ≤ _
 rw [hy]; exact (w u l c (TownN i) (hs ▸ k he) (hs ▸ p)).trans ((le_abs_self _).trans (Finset.single_le_sum (f:=fun u=> |C u s|) (fun u _=> abs_nonneg _) l))
#print axioms DiverseVistaPV
include pS
lemma WillPayPV (W':SpaceN I→ℂ)(a:Function.support W'⊆K)(h:Continuous W')(k:K⊆ VantageN⁻¹' MasksR I) : Tendsto (fun t:ℕ=> Cε.cash (u' t) (NativeCostN (fun i=> Fcost i t) L K pμ W' (u' t))) atTop (𝓝 (∫ x, SpokenN Cε X W' x)):=by
 let g:=SpokenN Cε X W'
 let W(t):=∑ i∈ DustyN P K t pμ,CustsN P K pμ g t i
 have ht:Tendsto W atTop (𝓝 (∫ x,g x)):= HarvestᵥN P K pμ _ (PricedN _ (fun i=>((pX i).compareX).choose) _ (fun i=> ((pX i).compareX).choose_spec) K pμ (fun x v=> Set.mem_iUnion.mpr ⟨0,k v 0⟩) W' a h) (WickableN _ _ K W' a) -- tune
 have he:Tendsto u' atTop atTop:=tendsto_atTop_mono' atTop e pS
 apply (tendsto_iff_of_dist ?_).2 (ht.comp he)
 obtain ⟨c,G,e0⟩:= DiverseVistaPV X Fcost S pX L alpΙ u' e K pμ k -- tune
 have hv:=((TariffsᵥN P K pμ W' h a).comp he).mul G; rw [mul_zero] at hv
 refine squeeze_zero' (Eventually.of_forall (fun v=>dist_nonneg)) ?_ hv; filter_upwards [e0] with f u; let t:= u' f; let F:=DustyN P K t pμ; let z:=CustsN P K pμ W' t
 change dist (Cε.cash t (NativeCostN (fun i=>Fcost i f) L K pμ W' t)) (∑ i∈F,CustsN P K pμ g t i) ≤ (∑ i∈F,‖z i‖)*c f
 unfold NativeCostN; rw [map_sum,dist_eq_norm]; rw [show DustyN P K t pμ=F from rfl,← sum_sub_distrib,Finset.sum_mul]
 refine (norm_sum_le ..).trans (sum_le_sum ?_); intro i l
 let p:=TownN i; let k':= atTick (P.macroStep t) i; have he:PoseΝ P t p= VantageN k':=TownPoseN P t i
 have x':k'∈K:=(dustN _ _ _ _ _).1 l; have ha:= u Cε i l; change ‖Cε.cash t (MoneyPoseN L _ t p)- SπR Cε.porch X (VantageN k')‖≤ _ at ha
 have y: CustsN P K pμ g t i=z i*SπR Cε.porch X (VantageN k'):=by unfold CustsN; exact (smul_mul_assoc _ _ _).symm -- tune
 rw [y,map_smul]; change ‖z i * _-z i *_‖≤ _; rw [←mul_sub,norm_mul]; exact mul_le_mul_of_nonneg_left ha (norm_nonneg _)

omit pμ
lemma ValuePathPV (W:I→SampleDose) (v:HabVU W ⊆ VantageN⁻¹' MasksR I) : Tendsto (fun t=> Cε.cash (u' t) (∏ i, installedN (Fcost i t) (W i) (u' t))) atTop (𝓝 (∫ x, SpokenN Cε X (ΞHeightsVU W) x)):=by
 have hc : Continuous (ΞHeightsVU W):= Complex.continuous_ofReal.comp (continuous_finsetProd _ fun i _=> (W i).smooth.continuous.comp ((continuous_apply _).comp FormalV_N))
 have ht:Function.support (ΞHeightsVU W)⊆HabVU W:=by
    intro x h i p; apply subset_closure; by_contra e; apply h; unfold ΞHeightsVU; rw [prod_eq_zero (mem_univ i) (notMem_support.mp e),Complex.ofReal_zero]
 exact (WillPayPV X Fcost S pX L alpΙ u' e _ (havanaVU W) pS Cε _ ht hc v).congr fun t=>congrArg _ (FreightVU (fun i=> Fcost i t) L alpΙ W (u' t))

