lemma WindP₂Fe : TarFleckFe p B0 M pu A D Sq Wp five (![TintZFe p B0 M R pu A D m Sq Wp L0 J' four rK,TintZFe p B0 M R pu A D m Sq Wp L0 J' dY none,TintZFe p B0 M R pu A D m Sq Wp L0 J' dZ kM]) (fun i=>Flux.One.prism (i 0) (i 1) (i 2) (FT rK) (FY none) (FZ kM)):=by
 let U:= Equiv.swap (0:Fin 3) 1; have ht: U 0=1:= Equiv.swap_apply_left ..; let Ω: Fin 2→Fin 3 := U ∘ Fin.succ; have hv: Ω 0=0:=Equiv.swap_apply_right (0:Fin 3) 1; have he: Ω 1=2:= Equiv.swap_apply_of_ne_of_ne (show (2:Fin 3)≠0 by decide) (by decide) -- implicit Classical
 refine CrescoFe p B0 M pu A D Sq Wp five _ _ (WinPairFe p B0 M R pu A D Q t uH H m Sq Wp L0 J' tM four dZ rK kM) _ U (fun i=>by rw[ht]; rfl) ?_ _ ?_
 · intro i j; change (![CrF rK, CrY none,CrZ kM] (Ω j):ℕ→B_Q) i= _; rcases (show j=0 ∨ j=1 from by fin_cases j <;> decide) with rfl | rfl; · rw [hv]; rfl
   rw[he]; rfl
 intro i h; change BigP (LeapRFe Ω i 0) (LeapRFe Ω i 1) _ _=_; rw [LeapSatFe _ _ _ _ hv, LeapSatFe _ _ _ _ he, Bloom1Fe]
 exact Eq.symm (TriOneFe _ _ _ _ _ (BloomFee ..) (FGapΩFe i h 0 1 (by decide)) (FGapΩFe i h 0 2 (by decide)) (FGapΩFe i h 1 2 (by decide))).1
lemma WindP₃Fe : TarFleckFe p B0 M pu A D Sq Wp five (![TintZFe p B0 M R pu A D m Sq Wp L0 J' four rK,TintZFe p B0 M R pu A D m Sq Wp L0 J' dY jM,TintZFe p B0 M R pu A D m Sq Wp L0 J' dZ none]) (fun i=>Flux.One.prism (i 0) (i 1) (i 2) (FT rK) (FY jM) (FZ none)):=by
 let U:= (Equiv.swap (0:Fin 3) 2).trans (Equiv.swap 0 1); have ht:U 0=2:=by simp [U,Equiv.swap_apply_def] -- tune
 let Ω:Fin 2→Fin 3:= U ∘ Fin.succ
 have hv:Ω 0=0:=by simp [Ω,U,Equiv.swap_apply_def]
 have he:Ω 1=1:=by simp [Ω,U,Equiv.swap_apply_def]
 refine CrescoFe p B0 M pu A D Sq Wp five _ _ (WinPairFe p B0 M R pu A D Q t uH H m Sq Wp L0 J' tM four dY rK jM) _ U (fun i=>by rw[ht]; rfl) ?_ _ ?_
 · intro i j; change (![CrF rK,CrY jM,CrZ none] (Ω j):ℕ→B_Q) i=_; rcases (show j=0 ∨ j=1 from by fin_cases j <;> decide) with rfl | rfl; · rw [hv]; rfl
   rw[he]; rfl
 intro i h; change BigP (LeapRFe Ω i 0) (LeapRFe Ω i 1) _ _=_; rw[LeapSatFe _ _ _ _ hv, LeapSatFe _ _ _ _ he,Bloom1Fe]; exact Eq.symm (TriOneFe _ _ _ _ _ (BloomFee ..) (FGapΩFe i h 0 1 (by decide)) (FGapΩFe i h 0 2 (by decide)) (FGapΩFe i h 1 2 (by decide))).2
