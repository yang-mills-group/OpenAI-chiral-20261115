lemma μPrimerMFe (x: RuneFe J' dY): TarFleckFe p B0 M pu A D Sq Wp five (![TintZFe p B0 M R pu A D m Sq Wp L0 J' dX none,TintZFe p B0 M R pu A D m Sq Wp L0 J' dY x]) (fun i=> BigP (i 0) (i 1) (SiftZFe J' dX none) (FY x)):=by
 let H':=ΔηOneΛFe p B0 M R pu A D Q t uH H m Sq Wp L0 J' tM dY x -- tune order!
 refine CrescoFe p B0 M pu A D Sq Wp five _ _ H' _ (Equiv.refl _) (fun _=>rfl) (fun f j=>by fin_cases j; rfl) _ ?_
 intro i h; change (FY x).1=_; rw[Bloom1Fe]; exact (OnePairFe _ _ (FGapΩFe i h 0 1 (by decide)) (FY x)).1.symm
lemma μPrimerKFe (x: RuneFe J' dX): TarFleckFe p B0 M pu A D Sq Wp five (![TintZFe p B0 M R pu A D m Sq Wp L0 J' dX x, TintZFe p B0 M R pu A D m Sq Wp L0 J' dY none]) (fun i=> BigP (i 0) (i 1) (SiftZFe J' dX x) (FY none)):=by
 let H':=ΔηOneΛFe p B0 M R pu A D Q t uH H m Sq Wp L0 J' tM dX x
 let u:=Equiv.swap (0:Fin 2) 1; have ht:u 0=1:=Equiv.swap_apply_left ..; have hv:u (Fin.succ 0)=0:=Equiv.swap_apply_right (0:Fin 2) 1
 refine CrescoFe p B0 M pu A D Sq Wp five _ _ H' _ u (fun i=>by rw [ht]; rfl) (fun i j=>by rw[Subsingleton.elim j 0,hv]; rfl) _ ?_
