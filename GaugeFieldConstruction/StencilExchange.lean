variable (J:JMap V)(z: Remembers G J)
include f z
private lemma coastStar_st (y:V)(k:Test4): let y':= J y
 (ord).field ((P#) (e y')) (YM.Boundary.Probe.bar k)=(ord).field ((P#) (TurnupMars 3 (e y))) (YM.Boundary.Probe.bar k):=by
 intro y'; let g:=YM.Boundary.Probe.bar k
 apply LinearMap.ext; intro a; apply ext_inner_left ℂ; intro b
 have he: model.system.J ((P#) (e y))= (P#) (TurnupMars 3 (e y)):=by rw [model.withStar]; let P:=(P#); change P (TurnupMars 3 (P.symm _))= _; rw [P.symm_apply_apply]
 rw [←he]; let x:=(P#) (e y);
 calc
   inner ℂ b _ = inner ℂ (u.pocket b) (u.pocket ((ord).field ((P#) (e y')) g a)) := (u.pocket.inner_map_map ..).symm
   _ = inner ℂ (u.pocket ((ord).field x k b)) (u.pocket a) := by
      rw [u.via_cash _ _ (f _ g), u.via_cash _ _ (f y k)]; exact (G.sharp J z (y,k) (u.pocket b) (u.pocket a)).symm
   _ = _:= by rw [u.pocket.inner_map_map]; exact model.course.adj ..
lemma every_barred_st (x:V): e (J x)=TurnupMars 3 (e x):=by
 let A:=e (J x); let B:=TurnupMars 3 (e x);
 suffices h:(P#) (e (J x))-(P#) (TurnupMars 3 (e x))=0 from (P#).injective (sub_eq_zero.mp h)
 by_contra h; obtain ⟨F,hp⟩:= model.course.faithful _ h
 apply hp; rw [map_sub,LinearMap.sub_apply]; apply sub_eq_zero.mpr
 let g:= YM.Boundary.Probe.bar F; have hx: YM.Boundary.Probe.bar g=F:=by ext x; simp only [g,YM.Boundary.Probe.bar_at, star_star]; -- may C.conj tune
 nth_rw 1 2 [←hx]; exact coastStar_st u G e f J z x g
#print axioms every_barred_st
