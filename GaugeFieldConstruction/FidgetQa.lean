abbrev GapNestQa (P:Spine)(Z:Bool→P.VMark): E4:= WithLp.toLp 2 ((AskR P Z) true-(AskR P Z) false)
lemma EquatorQa (P:Spine)(x:E4)(s:ℕ)(p:guild x)(u:AnnulusQc (rangePQ P s) x): x ∈ closure ((Set.range (GapNestQa P))∩{y:E4| guild y ∧ AnnulusQc (rangePQ P s) y}):=by
 let S:= {y:E4| guild y}; let U:= {y:E4| AnnulusQc (rangePQ P s) y}; have he:IsOpen S:= by rw[show S=⋂ i:Axis,{y:E4| y i≠0} from (by ext; simp [S,guild])]; apply isOpen_iInter_of_finite; intro i; exact isOpen_ne_fun (Payroll.proj i).continuous continuous_const -- tune
 let V(X:DiagramR (Fin 2)):E4:= WithLp.toLp 2 (X 1-X 0); have hV:Continuous V:= by unfold V; fun_prop
 let X:DiagramR (Fin 2):=![0,x.ofLp]; have hX:V X=x:=by unfold V X; simp
 obtain ⟨Y,t',b⟩:=MeshPhoto_S P X _ (((he.inter (annOpenQc _)).preimage hV)) (show V X∈S∩U by rw[hX]; exact ⟨p,u⟩)
 have v:Tendsto (fun i=> V (AskR P (Y i))) atTop (𝓝 x):=by rw [← hX]; exact hV.continuousAt.tendsto.comp t' -- rw replaces x inside Y? dependent local
 apply mem_closure_of_tendsto v; filter_upwards with i; let Z:Bool→P.VMark:=fun b=> if b then Y i 1 else Y i 0; exact ⟨⟨Z,rfl⟩,(b i).1⟩
lemma tattooQa (s:ℕ)(Z:Bool→P.VMark)(p:AnnulusQc (rangePQ P s) (GapNestQa P Z)): TattooQ P s Z:=by
 let x:= GapNestQa P Z; let e:= rangePQ P s; have he:0<e:=RangePosQ P s; have hx:‖x‖<2*e:=p.high
 change (∀ i:Axis, |x i| ≤ 3*e)∧∃ i:Axis,e/2 ≤ |x i|
 refine ⟨fun i=> (show |x i| ≤ ‖x‖ from PiLp.norm_apply_le x i).trans (by linarith),?_⟩ -- args
 by_contra! v
 have hv:‖x‖^2 ≤ ∑ i:Axis,(e/2)^2:=by rw[PiLp.norm_sq_eq_of_L2]; exact sum_le_sum fun i _=> pow_le_pow_left₀ (norm_nonneg _) (show ‖x i‖ ≤ e/2 from (v i).le) _
 rw [Finset.sum_const,Finset.card_univ] at hv; change _≤ (4:ℕ) • (e/2)^2 at hv; rw [nsmul_eq_mul] at hv; norm_num at hv; have hz:e<‖x‖:=p.low; nlinarith
