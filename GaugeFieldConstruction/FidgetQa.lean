abbrev AxeQa (i:E4):Axis→ℝ:=i.ofLp
abbrev WaxCaq (Z:Bool→P.VMark)(t: Points (n+1)):Axis→ℝ:= AxeQa (head t) - AskR P Z false
abbrev VectorQa (Z:Bool→P.VMark)(t:Points (n+1)): DiagramR Bool:= fun i=> AskR P Z i + WaxCaq Z t
