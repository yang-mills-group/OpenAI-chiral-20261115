lemma AmmarQa(Z:Bool→P.VMark)(x:Points (n+1)): Fin.cons (VectorQa Z x false) (ΦplanR n (Fathom.riders x))= ΦplanR (n+1) x:=by
 funext i; refine Fin.cases ?_ (fun i=>rfl) i; change AskR _ Z false + (AxeQa (head x) - _)= AxeQa _; rw[add_sub_cancel]; rfl -- tune
lemma ShiftRotorQa (Z:Bool→P.VMark)(x:Points (n+1)): Fin.cons (VectorQa Z x false) (Fin.cons (VectorQa Z x true) (ΦplanR n (Fathom.riders x))) = ΦplanR (n+2) (rearrange rotor (LensQc (GapNestQa P Z) x)):=by
 let L:= LensQc (GapNestQa P Z) x; funext i; refine Fin.cases ?_ ?_ i
 · change _= AxeQa (L (rotor 0)); rw [head']; rw[show L (Fin.succ 0)=x 0 from LensIp ..]; exact congrFun (AmmarQa Z x) 0
 intro j; refine Fin.cases ?_ ?_ j
 · change VectorQa Z x true=AxeQa (L (rotor (Fin.succ 0))); rw [true',show L 0=x 0+GapNestQa P Z from Lens0p ..]; unfold VectorQa WaxCaq; change _= AxeQa (x 0) + (AskR P Z true-_); unfold head; abel -- tune
 intro k; change _= AxeQa (L (rotor k.succ.succ)); rw [external',show L k.succ.succ=x k.succ from LensIp ..]; rfl
lemma CashGripQa (Z:Bool→P.VMark)(x:Points (n+1))(s:ℝ)(c:ΦplanR (n+1) x∈ CoalQ P (n+1) s)(v:LensQc (GapNestQa P Z) x∈ generic (n+2)): ShapeGripQ P s (VectorQa Z x) (ΦplanR n (Fathom.riders x)):=by
 change Fin.cons _ _ ∈ MasksR _∧Fin.cons _ _∈ CoalQ P (n+1) s; rw [AmmarQa, ShiftRotorQa]; exact ⟨aukQc rotor _ v,c⟩
lemma coilCaq (L:Fin n→UV five)(X:UV five): Ve (Fathom.add X L)=Fin.cons (Bsrc X).val (Ve L):=funext fun i=> Fin.cases rfl (fun i=>rfl) i
lemma SpectusQa (A' B' F':UV five)(I:HintQc)(Z:Bool→P.VMark)(v:Points (I.n+1))(u: LensQc (GapNestQa P Z) v∈ generic (I.n+2)): DayQc (Lsx) I A' B' (LensQc (GapNestQa P Z) v)-(Lsx).fee _ (Fathom.add F' I.x) v=SμCash P (VectorQa Z v) (Bsrc A').val (Bsrc B').val (Bsrc F').val (Ve I.x) (ΦplanR I.n (Fathom.riders v)):=by
 unfold DayQc; rw [←(Lsx).rearr _ rotor _ u, on_labels]
 change SπR (K_Q).porch (Ve (Fathom.add A' (Fathom.add B' I.x))) (ΦplanR _ (rearrange rotor (LensQc (GapNestQa P Z) v))) - SπR (K_Q).porch (Ve (Fathom.add F' I.x)) (ΦplanR _ v)= _
 rw[coilCaq,coilCaq,coilCaq,← ShiftRotorQa,← AmmarQa Z] -- tune inference
