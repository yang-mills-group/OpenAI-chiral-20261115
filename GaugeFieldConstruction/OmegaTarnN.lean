abbrev jNOne := List.finRange 1
abbrev jNDuo := List.finRange 2
abbrev ξOneN (x:Cover):MeshN (Fin 1):=fun i=> x i.2
abbrev ξTwoN (x y:Cover):MeshN (Fin 2):=fun i=>if i.1=0 then x i.2 else y i.2
-- flattened probes and Support rectangles.
variable (ιSet ΚSet:Set Vantage)
abbrev Probes1N := {x:SpaceN (Fin 1)| VantageN x 0∈ιSet}
abbrev Probes2N := {x:SpaceN (Fin 2)| VantageN x 0∈ιSet∧VantageN x 1∈ΚSet}
abbrev Terra1N (x:SpaceN (Fin 1)):ℂ:=↑(rC.val (VantageN x 0))
abbrev Terra2N (x:SpaceN (Fin 2)):ℂ:= ↑(rC.val (VantageN x 0)* rD.val (VantageN x 1):ℝ)
lemma packL1N (K:Set Vantage)(p:IsCompact K):IsCompact (Probes1N K):=by
 let k(x:Vantage):SpaceN (Fin 1):=fun i=> x i.2; have ht:Continuous k:=continuous_pi fun i=> continuous_apply _; have hp:k '' K= Probes1N K:=by
    apply Set.Subset.antisymm; rintro _ ⟨x,v,rfl⟩; exact v
    rintro x t; refine ⟨_,(show VantageN x 0∈K from t),?_⟩; funext i; change x (0,i.2)=_; rw [show (0,i.2)=i from Prod.ext (Subsingleton.elim ..) rfl]
 rw [←hp]; exact p.image ht
lemma packL2N (v:IsCompact ιSet)(w:IsCompact ΚSet): IsCompact (Probes2N ιSet ΚSet):=by
 let k(x:Vantage×Vantage):SpaceN (Fin 2):= fun i=>if i.1=0 then x.1 i.2 else x.2 i.2; have ht:Continuous k:= continuous_pi fun i=>by unfold k; split_ifs <;> fun_prop
 have he(x:Vantage×Vantage): VantageN (k x) 0=x.1∧VantageN (k x) 1=x.2:= ⟨funext fun i=>if_pos rfl,funext fun i=>if_neg (by decide :(1:Fin 2)≠0)⟩
 suffices k '' (ιSet×ˢΚSet)=Probes2N ιSet ΚSet by rw[←this]; exact (v.prod w).image ht
 apply Set.Subset.antisymm; rintro x ⟨y,h,rfl⟩; exact ⟨(he y).1.symm ▸ h.1, (he y).2.symm ▸ h.2⟩ -- HEq
 intro x h; refine ⟨(VantageN x 0,VantageN x 1), ⟨h.1,h.2⟩,?_⟩; funext ⟨i,j⟩; fin_cases i; exact if_pos rfl; exact if_neg (by decide :(1:Fin 2)≠0)
lemma rigidL1N :Function.Injective ξOneN:= fun _ _ h=>funext fun i=> congrFun h (0,i)
lemma mintageL1N(t:ℕ)(x:Cover): ξOneN x∈DustyN P (Probes1N (tsupport rC.val)) t (packL1N _ rC.budget) ↔ x∈P.usedGrid t rC:=by
 rw [dustN,P.usedPose]; rfl
lemma coverL1N (t:ℕ) : (P.usedGrid t rC).image ξOneN=DustyN P (Probes1N (tsupport rC.val)) t (packL1N _ rC.budget):=by
 ext x; rw [Finset.mem_image]; constructor; rintro ⟨y,h,rfl⟩; exact (mintageL1N _ _ _).2 h -- tune
 intro h; let y:Cover:= fun i=> x (0,i); have ht:ξOneN y=x:=by funext p; change x (0,p.2)=_; rw [show (0,p.2)=p from Prod.ext (Subsingleton.elim ..) rfl]
 exact ⟨y,(mintageL1N _ _ _).1 (ht.symm ▸ h),ht⟩
abbrev installedN (t:ℕ):P.Test :=∑ k∈P.usedGrid t rC,P.activation t rC k • P.chartAll k (uF t)
lemma moneyL1N (t:ℕ) : NativeCostN (![uF]) jNOne _ (packL1N _ rC.budget) (Terra1N rC) t = installedN uF rC t:=by
 unfold NativeCostN installedN
 rw [←coverL1N rC,Finset.sum_image (fun _ _ _ _ h=> rigidL1N h)]
 apply Finset.sum_congr rfl; intro k _
 rw [show MoneyPoseN _ _ _ _=P.chartAll k (uF t) from ?h]; congr 1
 · let W:=P.macroStep t; change W^Fintype.card (Fin 1 × Axis) • (rC.val (P.meshPose t k):ℂ) = P.activation t rC k; rw [← Complex.coe_smul,activation,Fintype.card_prod,(show Fintype.card Axis=4 from rfl),Fintype.card_fin,one_mul,smul_eq_mul,Complex.ofReal_mul]
 case h => change ([P.chartAll k (uF t)]:List P.Test).prod=_; rw [List.prod_singleton]
lemma TollL2N (x y:Cover): let K:=ξTwoN x y; TownN K 0=x∧TownN K 1=y:= ⟨funext fun i=>if_pos rfl,funext fun i=>if_neg (by decide :(1:Fin 2)≠0)⟩
abbrev UnfN (x:Cover × Cover):=ξTwoN x.1 x.2
lemma rigidL2N : Function.Injective UnfN:=by
 intro a b h; have hp:= TollL2N a.1 a.2; have hv:= TollL2N b.1 b.2; exact Prod.ext (hp.1.symm.trans ((congrArg (fun v=>TownN v 0) h).trans hv.1)) (hp.2.symm.trans ((congrArg (fun v=>TownN v 1) h).trans hv.2))
lemma poseN_uniq (x:MeshN (Fin 2))(t:ℕ): VantageN (atTick (P.macroStep t) x)=fun i=> P.meshPose t (TownN x i):=rfl
lemma mintageL2N(t:ℕ)(x:Cover × Cover): UnfN x∈DustyN P (Probes2N (tsupport rC.val) (tsupport rD.val)) t (packL2N _ _ rC.budget rD.budget) ↔ x∈ P.usedGrid t rC ×ˢ P.usedGrid t rD:=by
 rw [dustN,Finset.mem_product,P.usedPose,P.usedPose]; change (_ ∧ _)↔ _; have he:TownN (UnfN x) 0=x.1∧TownN (UnfN x) 1=x.2:=TollL2N ..; rw [poseN_uniq]; dsimp only; rw[he.1,he.2]
lemma coverL2N (t:ℕ) : (P.usedGrid t rC ×ˢ P.usedGrid t rD).image UnfN=DustyN P (Probes2N (tsupport rC.val) (tsupport rD.val)) t (packL2N _ _ rC.budget rD.budget):=by
 ext x; rw [Finset.mem_image]; constructor; rintro ⟨y,h,rfl⟩; exact (mintageL2N rC rD t y).2 h
 intro h; let y:Cover×Cover:= (TownN x 0,TownN x 1); have ht:UnfN y=x:=by funext ⟨i,j⟩; fin_cases i; exact if_pos rfl; exact if_neg (by decide :(1:Fin 2)≠0)
 exact ⟨y,(mintageL2N rC rD t y).1 (ht.symm ▸ h),ht⟩
lemma moneyL2N (t:ℕ) : NativeCostN (![uF,uG]) jNDuo _ (packL2N _ _ rC.budget rD.budget) (Terra2N rC rD) t = installedN uF rC t * installedN uG rD t:=by
 unfold NativeCostN installedN
 rw [←coverL2N rC rD,Finset.sum_image (fun _ _ _ _ h=> rigidL2N h),Finset.sum_product,Finset.sum_mul]
 apply Finset.sum_congr rfl; intro k _; rw [Finset.mul_sum]; apply Finset.sum_congr rfl; intro j _
 have hp:=TollL2N k j; let y:=UnfN (k,j); change CustsN _ _ _ _ _ y • MoneyPoseN _ _ _ (TownN y) =_
 rw [smul_mul_assoc,mul_smul_comm,smul_smul]; have hz:MoneyPoseN jNDuo (![uF,uG]) t (TownN y)=P.chartAll k (uF t)*P.chartAll j (uG t):=by
    change [P.chartAll (TownN (ξTwoN k j) 0) (uF t), P.chartAll (TownN (ξTwoN k j) 1) (uG t)].prod=_; rw [hp.1,hp.2]; simp
 rw [hz]; congr 1; unfold CustsN StampScaleN Terra2N
 rw [poseN_uniq]; have hp:TownN y 0=k∧TownN y 1=j:=TollL2N ..; dsimp only; rw [hp.1,hp.2,←Complex.coe_smul,Fintype.card_prod,Fintype.card_fin, show Fintype.card Axis=4 from rfl,smul_eq_mul]; simp only [activation]; push_cast; ring
#print axioms moneyL1N
#print axioms moneyL2N
