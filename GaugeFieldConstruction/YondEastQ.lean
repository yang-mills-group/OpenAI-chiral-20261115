 let v':=((),Ω0.rank ()); let xE:=(KernelSailJ (BusCQ x')); let kQ:= OrbitSailJ θ (BusCQ x'); let B:= starTagQ Ω0 (); let F':= nameLift Tℓ (TolJ X θ) kQ xE (EmbassyJ_sail θ (BusCQ x')) B; let V₀:= M'.Mark s
 let E:= EarnRQ f s A M i k Z (fun _:Unit=>[]) L M0 hG ((),Ω0.rank ()) (starTagQ Ω0 ()); let R:= EarnRQ f s A M i k Z r L M' hG (x',Ω0.rank ()) F'; let F:=ΓPrimary P.run i k θ M' (x',Ω0.rank ()) s; let b:= κEye (Ω0.label ()); let K:= (Ω.work x').map (Y.Mark s)|>.prod
 have Hp:= OrionXQ f s p A M i k v g Z r L T ι Y M' Ω q qY hG z0 gU Ω0 Y0 M0 p0 q0 x' uX qU qP tE tp -- tune
 let μ:ℂ:=MintRateQ ι; have eq:E.1 b=Q:=rfl; have e: hoodAJ O b=b:=by
    ext j; unfold hoodAJ b κEye; simp only [Pi.single_apply]; split <;> first|exact map_zero O|exact map_one O
 have hp':JasmineJ O E R:=Hp; have ht: hoodAJ O Q=R.1 b:=(hp'.1 b).trans (congrArg _ e); have hz:O d=R.2 b:=(hp'.2 b).trans (congrArg _ e)
 have z: V=F (R.1 b)+R.2 b • 1:=by unfold V; rw[ht,hz, ← rootCostQ f s p A M i k v g Z r L T ι Y M' Ω hG z0 gU qU _ _ _]
 let S:= (ScaleμJ P.par (Ω0.rank ()).val)^(s-f) * RankQJ P.par f
