 have hM:0 <MintRateQ ι:=Real.exp_pos _; have hz0: μ≠0:= by unfold μ; exact_mod_cast hM.ne'
 let H:= ChargedJ.smul μ⁻¹ hv; rw [←sub_add_eq_sub_sub, ← z,hμ,smul_sub, smul_smul,inv_mul_cancel₀ hz0,one_smul] at H; have h:‖μ⁻¹‖=Real.exp (ι:ℝ):=by rw [norm_inv, show ‖μ‖=_ from Complex.norm_real (MintRateQ ι),Real.norm_of_nonneg hM.le,MintRateQ,Real.exp_neg,inv_inv]
 rw[h] at H; exact H
