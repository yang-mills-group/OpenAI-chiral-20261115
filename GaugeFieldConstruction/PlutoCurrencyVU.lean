noncomputable abbrev chosenLoomVU (i:ℕ)(c:SΝΨ):P.Test:= SelectLoomVU (fun j=> installedN (AΞ.F j) AΞ.K i) c
noncomputable abbrev chosenCastVU (i:ℕ)(c:SΝΨ):P.Test:= SelectCastVU (fun j=> installedN (AΞ.G j) AΞ.L i) c
lemma trueAtVU (i:ℕ)(v:SΝΨ)(h:v≠0)(e:AΞ.transactionN i∈PrecisionYN AΞ.δ) : Constr4VU (P.singleState 3 i σx) (AΞ.chosenLoomVU i v) (AΞ.chosenCastVU i v) ≠0:= TruePricesVU _ _ _ v h AΞ.δ_pos e
lemma sidesLiveVU (i:ℕ)(v:SΝΨ)(h:v≠0)(e:AΞ.transactionN i∈PrecisionYN AΞ.δ) : AΞ.chosenLoomVU i v≠0∧ AΞ.chosenCastVU i v≠0:=by
 let X:=P.singleState 3 i σx; have hz:= AΞ.trueAtVU i v h e; refine ⟨fun H=> hz ?_, fun H=> hz ?_⟩
 · rw[H,map_zero (Constr4VU X)]; rfl
 rw [H,map_zero]
lemma cuffsVU (i:ℕ)(v:SΝΨ)(p:AΞ.CredentialsN i) : AΞ.chosenLoomVU i v∈ treasuryVU i AΞ.A_X ∧ AΞ.chosenCastVU i v∈ treasuryVU i AΞ.B_Y:=by
 exact ⟨Subalgebra.sum_mem _ (fun j _=>Subalgebra.smul_mem (treasuryVU i AΞ.A_X) (PaidCertN _ _ _ _ _ _ (p.1 j)|>.symm) _),Subalgebra.sum_mem _ (fun j _=>Subalgebra.smul_mem (treasuryVU i AΞ.B_Y) (PaidCertN _ _ _ _ _ _ (p.2 j)|>.symm) _)⟩ -- tune symm
variable {r':SampleDose}{uF:ℕ→P.Test}{Z':Set Vantage}
open Six
lemma postTenderVU (q:Matter.FlavorIndex)(S:ℕ)(h:RecordedΝ P q Z' r' uF S): (installedN uF r' S).val∈ CurrencyVU P.calibration:=by
 let Q:=(CurrencyVU P.calibration).comap (screenHall P.calibration).val.toLinearMap
 change installedN uF r' S ∈Q; exact Q.sum_mem fun i h' => Q.smul_mem _ (braveryCurrencyVU (SceneAtN P i) _ _ (h i h').1.2.2.1)
lemma accountLiveVU (i:ℕ)(v:SΝΨ)(e:AΞ.CredentialsN i) : (AΞ.chosenLoomVU i v).val∈CurrencyVU P.calibration ∧ (AΞ.chosenCastVU i v).val∈ CurrencyVU P.calibration:=by
 let Q:=(CurrencyVU P.calibration).comap (screenHall P.calibration).val.toLinearMap
 change AΞ.chosenLoomVU i v∈ Q∧ AΞ.chosenCastVU i v∈Q; exact ⟨Q.sum_mem (fun j _=>Q.smul_mem _ (postTenderVU _ i (e.1 j))), Q.sum_mem (fun j _=>Q.smul_mem _ (postTenderVU _ i (e.2 j)))⟩
abbrev supportedMixedVU (P:Spine)(i:ℕ)(X:Set Vantage)(f:P.Test):Prop:= f∈ treasuryVU i X∧ f.val∈CurrencyVU P.calibration ∧ ¬ PureGauge P.calibration f∧ ¬ PureMatter P.calibration f
lemma drawListVU (i:ℕ)(e:AΞ.CredentialsN i)(w:AΞ.transactionN i∈PrecisionYN AΞ.δ):∀ v:SΝΨ,v≠0→ supportedMixedVU P i AΞ.A_X (AΞ.chosenLoomVU i v)∧supportedMixedVU P i AΞ.B_Y (AΞ.chosenCastVU i v):=by
 intro v g
 obtain ⟨α,β⟩:= AΞ.cuffsVU i v e; obtain ⟨hf,hg⟩:= AΞ.accountLiveVU i v e; obtain ⟨af,bg⟩:= AΞ.sidesLiveVU i v g w
 exact ⟨⟨α,hf,velvetCoinVU (apportVU _ _ _ α).1 hf af,velvetGramVU (apportVU _ _ _ α).1 hf af⟩,β,hg, velvetCoinVU (apportVU _ _ _ β).1 hg bg,velvetGramVU (apportVU _ _ _ β).1 hg bg⟩
lemma currencyReceiptVU :∀ᶠ i in atTop,∀ v:SΝΨ,v≠0→ supportedMixedVU P i AΞ.A_X (AΞ.chosenLoomVU i v)∧ supportedMixedVU P i AΞ.B_Y (AΞ.chosenCastVU i v) ∧ Constr4VU (P.singleState 3 i σx) (AΞ.chosenLoomVU i v) (AΞ.chosenCastVU i v) ≠0 :=by
 filter_upwards[AΞ.agreedN,AΞ.perceptiveN] with i w p v he
 exact ⟨(AΞ.drawListVU i w p v he).1,(AΞ.drawListVU i w p v he).2,AΞ.trueAtVU i v he p⟩
