lemma EyeletQ : RunTailQ f s p A M i k v g Z r L T ι Y hG z0 gU x' (linkT_J P f t (r x') (NewFlagQ (P:=P) ι F G') i k v2) (ExFeeQ P f s ι d cost e₀ e₁):=by
 let μ:ℂ:=MintRateQ ι
 let S:=RFGripQ f s A M i k Z r L Y hG M0 x' D d l; let U:=(CandBQ s i k (D false) false x' Y); let V:=(CandBQ s i k (D true) true x' Y); let R:=(linkT_J P s t (QTapeQ P f s (r x')) (F false) i k v2); let Q:=(linkT_J P s t (QTapeQ P f s (r x')) (F true) i k v2); let W:= linkT_J P s t (QTapeQ P f s (r x')) G' i k v2; let O:= SpinMQ (P:=P) f i (r x')
 have E:= RakeCq f s p A M i k v g Z r L T ι Y q hG z0 gU Y0 M0 q0 x' tE tp D d l VR H₀ v0 -- order
 have e: O (μ⁻¹)=μ⁻¹:=by unfold μ O SpinMQ; rw [map_inv₀,νGlow, inkPay,inkR]
 have hV: linkT_J P f t (r x') (NewFlagQ (P:=P) ι F G') i k v2= R*Q - μ⁻¹ • W:= by
    change linkT_J _ _ _ _ _ _ _ _=_; rw [←e]; exact (CanvasHQ f s i k g Z r ι hG x' tE tp t v1 v2 F G' VP VF μ⁻¹).2 -- order
 rw [hV, show R*Q- μ⁻¹ • W=(U*V- μ⁻¹ • S)+(((R-U)*Q+U*(Q-V))+(-μ⁻¹) • ((W-S)*1)) from (by rw [mul_one,neg_smul,smul_sub]; rw[_root_.sub_mul,_root_.mul_sub]; abel)]
 let Yb:=CostResMQ P f s ι d; let M₁:= CoatMQ P d f s ι; let Τ:= 1+ RankQJ P.par s
 let H:= PourMQQ f s p A M i k v g Z r L T ι Y q hG z0 gU x' tE tp d l v0 -- tune
 have u(b:Bool): Circζ P.run i k θ Y s (tagHQ b x') (CandBQ s i k (D b) b x' Y) Τ:=by
    have h₀:0≤NU:=sq_nonneg _; unfold CandBQ; cases (D b)
    · apply ChargedJ.lift (P:=1) (_:1≤Τ) ChargedJ.one; exact le_add_of_nonneg_right h₀
    rename_i j; have v:=ChargedJ.coin (c:=NU) (x:=(tagHQ b x')) (M:=Y.Mark s) (F:=TolHouseJ θ) (folkQ j b x') rfl; simp [tagMQQ]; exact v.lift (le_add_of_nonneg_left zero_le_one) -- lift order implicit ·?, simp nuance
 have h:= ChargedJ.add (show ChargedJ _ _ _ _ (Q-V) e₀ from Au) (u true); rw [sub_add_cancel] at h
 let H1:= Enterprise.add (H (R-U) Q _ _ Aq h) (H U (Q-V) _ _ (u false) Au); let H3:=(H (W-S) 1 _ _ Ap ChargedJ.one).scale (-μ⁻¹)
 apply Enterprise.lift (Enterprise.add E (H1.add H3)); change Yb+(M₁* (cost*(e₀+ Τ))+M₁*(Τ*e₀)+‖-μ⁻¹‖*(M₁*(e₁*1))) ≤ Yb+M₁*(cost*(e₀+Τ)+Τ*e₀+ Real.exp (ι:ℝ)*e₁)
 have he:‖μ⁻¹‖=Real.exp (ι:ℝ):=by rw[norm_inv, show ‖μ‖= _ from Complex.norm_real (MintRateQ ι),Real.norm_of_nonneg (show 0≤MintRateQ ι from (Real.exp_pos _).le),MintRateQ,Real.exp_neg,inv_inv]
 rw [norm_neg,he]; apply le_of_eq; ring
