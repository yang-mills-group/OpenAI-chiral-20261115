lemma FlatτJ (u:f ≤ s)(h:s < Y.uv k)(i':I)(z:i'∉ (p.birth s).toFinset): V.Mark s i'=MstepJ s p V i' :=by
 let A:= (p.birth s).toFinset; let U:=Sc s
 rw [pV.story u h]
 unfold RollK TygerJ perturbJ; -- W₂.S case
 simp_rw [reflux,MatD, show i'∉ _ from z,false_and,if_neg not_false,sub_zero]; -- tune
 rw[sum_eq_single_of_mem (s:=pipe_ζ U i') i' (mem_filter.mpr ⟨mem_univ _,rfl⟩), if_pos rfl,one_smul]; · exact if_neg z
 intro i s v; rw [if_neg v,zero_smul]
include g0
lemma BirthζJ (u:f ≤ s)(h:s < Y.uv k)(i':I)(z:i'∈ (p.birth s).toFinset): V.Mark s i'=convoy Y i k h.le (p.mark s i')-V.Mark s (p.Pp s i'):=by
 let A:= (p.birth s).toFinset; let L:= p.Pp s; let U:=Sc s; have t:L i'∉ A:= Troop_no _ _ _ (g0.voyage u h) _ z -- tune
 have H:U (L i')=U i':= Troop_w _ _ _ _ (g0.voyage u h) i' z -- tune impl parent
 rw [FlatτJ s F p G' V pV u h (L i') t] -- order. defeq
 rw [pV.story u h]; unfold RollK TygerJ perturbJ; simp_rw [reflux,sub_smul, sum_sub_distrib]; -- tune
 refine congrArg₂ (·-·) ?_ ?_
 · rw[sum_eq_single_of_mem (s:=pipe_ζ U i') i' (mem_filter.mpr ⟨mem_univ _,rfl⟩),if_pos rfl,one_smul]; · exact if_pos z
   intro j' b t; rw [if_neg t,zero_smul]
 rw [sum_eq_single_of_mem (s:=pipe_ζ U i') (p.Pp s i') (mem_filter.mpr ⟨mem_univ _,H⟩),MatD,if_pos ⟨z,rfl⟩,one_smul]; · exact if_neg t
 intro j' b t; rw [MatD,if_neg (fun x=>t x.2),zero_smul]
