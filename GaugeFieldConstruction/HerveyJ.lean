lemma RainArid (j:I): (P_.MatchRow (((Γω s).ratio.parent) ∘ (p.σ (s+1))) (V.Br s).M (ScaleFJ s p V) j).2.2 = AridJ s p V j:=by
 let L:=Sc s; let B:= ScaleFJ s p V; let X:= Eye j; let G:= Aimζ s p V; let R:=Λt_ s; let Q:= G_s ((V.Br s).M); -- tune
 have hp (j':I):G X j'=if L j'= L j then R j' j else 0:=by
    change (∑ k'∈pipe_ζ L j',R j' k'*X k')=_; by_cases h:L j'= L j
    · rw [sum_eq_single_of_mem (s:=pipe_ζ L j') j (mem_filter.mpr ⟨mem_univ _,h.symm⟩), if_pos h,show X j=1 from Pi.single_eq_same ..,mul_one]; intro i' a b; rw[show X i'=0 from Pi.single_eq_of_ne b _,mul_zero]
    rw [if_neg h]; refine sum_eq_zero fun i' a=>?_ ; rw [show X i'=0 from Pi.single_eq_of_ne (fun v'=>h ( (v' ▸ (mem_filter.mp a).2).symm)) _,mul_zero] -- cast
 unfold Directory.MatchRow AridJ ΔSinJ departA α_ξ
 rw [Prod.snd_sum,Prod.snd_sum]; change (∑ i'∈pipe_ζ L j,R i' j*Q i')=∑ i', G X i'*Q i'; unfold pipe_ζ; rw [sum_filter]; simp_rw [hp]; simp only [ite_mul,zero_mul]
lemma HerbJ (j:I): MstepJ s p V j =(∑ i'∈ pipe_ζ (oceanJ (k:=k) s p) j,ScaleFJ s p V i' j • (V.Mark (s+1) i'))- AridJ s p V j • 1:=by
 let Yp:=Ψt_ s; let R:= ScaleFJ s p V; let Δ:=Sc s; let T:=pipe_ζ Δ j; let M:= (V.Br s).M; let Q:= G_s M; unfold MstepJ Modern_P perturbJ ΔArz; simp_rw[smul_add, sum_add_distrib]; rw [← RainArid]; unfold MatchRow; rw [Prod.snd_sum,Prod.snd_sum, Finset.sum_smul]; -- combine sign
 change _+(∑ i'∈ T,R i' j • ((-Q i') • (1:Mark (side Y i (Y.uv k)))))= _; simp_rw [←mul_smul,mul_neg, neg_smul,sum_neg_distrib,sub_eq_add_neg]; rfl -- tune sign
