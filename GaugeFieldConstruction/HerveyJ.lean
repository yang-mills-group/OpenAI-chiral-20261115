lemma PursueJ : (Ψt_ s) x.val= (Qx (s+1)) (RoadFJ s p V K x) - AridJ s p V x.val • 1 :=by -- one scope
 rw [HerbJ]; refine congrArg₂ (·-·) ?_ rfl; let D:= ScaleFJ s p V
 refine shift_p P_ _ x.val K true x.property.1 _ _ ?_ ?_ -- tune
 · intro i' t; rw [ScaleFJ,Day_C]; unfold DayP; rw[dif_neg (not_and_or.mpr t),zero_smul]
 intro j; rw[ScaleFJ,Day_C]; unfold DayP; rw[dif_pos j.property]
lemma AhGap : (Ψt_ s) z.val= ((Qδ:ℂ) • (V.Mark (s+1) z.val + (Qx (s+1)) (RoadGJ s p V K z))) - AridJ s p V z.val • 1 :=by
 rw [HerbJ]; apply congrArg (·- _); let Y0:= V.Mark (s+1); let X:= (V.Br s).T; let R:= RoadGJ s p V K; let Q:ℂ:=Qδ; let T:=pipe_ζ (Sc s) z.val; let Z(i':I):ℂ:= if e:P_.own i'=K∧ P_.kind i'=true then Q*(R z ⟨i',e⟩) else 0; have u(i':I):(Λt_ s) i' z.val= Z i'+ if i'=z.val then Q else 0:=Day_G ..
 simp_rw [u,add_smul,sum_add_distrib]; rw [sum_eq_single_of_mem (s:=T) (f:=fun j:I=>(if j=z.val then Q else 0) • Y0 j) z.val (mem_filter.mpr ⟨mem_univ _,rfl⟩),if_pos rfl, smul_add, add_comm _ (Q • _)]; rotate_left; · intro i' _ h; rw [if_neg h,zero_smul]
 change Q • _ + _ = Q • _+ Q • ∑ i':P_.Pname K,_; rw [smul_sum]
 refine congrArg (Q • Y0 z.val + · ) (shift_p P_ _ z.val K true z.property.1 _ _ ?_ ?_)
 · intro i' h; unfold Z; rw [dif_neg (not_and_or.mpr h),zero_smul]
 intro i'; unfold Z; rw [dif_pos i'.property,mul_smul]
