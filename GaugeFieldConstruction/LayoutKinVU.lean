lemma LivePhaseVU (s':ℕ)(U:Pane (nP s')) (p:okP s' U) : let m:=P.diagonalDepth s'
    let W:=Lat.frame SU.matter (Cube.links U) (anticut (nP s'))
    let D:=spar P.par.K.j Vale.babyM U
    Safe W.H ∧ D=portW (Tulip.helix _).symm (projector W.H) ∧
      Sea D (changeM (m:=Vale.mesh (P.run.ir (rᵏ s')) P.par.R.L (P.diagonalDepth s')) P.par.U U Vale.babyM) ∧
      portW (Tulip.helix _).symm W.overlap * D=cutM (Tset (nP s')) * D ∧
      ∀ (x:Site (nP s')) (a:SpinIdx) (g:Fin 3) (t:SU.Ten ⊕ SU.F), (think (Tset (nP s'))).term ((x,a),g,t)=
        if a∈plusHalf then Fock.put ((x,a),g,t) else -Fock.takeF ((x,a),g,t) := P.bare_chiral _ _ U p
lemma MultiSpeciesVU (g:SU.E)(j:Fin 3) :
    (SU.matter g).val=(1:Op (Fin 3)) ⊗ₖ Join.both (ExTwo.wedgeOp (SU.fund g)) (cc (SU.fund g)) ∧
    Fintype.card Lead.Clan=6 ∧
    (∀ i:SU.Ten, Window.family (j,Sum.inl i)=(j,true)) ∧
    (∀ i:SU.F, Window.family (j,Sum.inr i)=(j,false)) ∧
    (Window.colors (j,true)).card=10 ∧ (Window.colors (j,false)).card=5:=six_families g j
