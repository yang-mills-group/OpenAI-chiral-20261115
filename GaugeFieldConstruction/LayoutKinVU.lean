private lemma exposesVU (t k:ℕ)(h:(P.run.voyage (rᵏ t)).kick ≤ hᵏ t)(e:k≤P.diagonalDepth t)(f:P.Test) : let F:=exhibit P.run P.large k (rᵏ t) f.val; let N:=side P.run (rᵏ t) k; let ΛF:=(P.run.voyage (rᵏ t)).CapeT k;
    let G:=(Dᶠ t).gram k
    let Cκ:=fun z:Orbit (side P.run (rᵏ t) k) => inner ℂ (mateK (side P.run (rᵏ t) k)) (acts (F (z.1,ΛF z)) (denZ G P.par.U ΛF z))
    let d:=partitionZ G P.par.U ΛF
    Integrable Cκ (city (side P.run (rᵏ t) k)) ∧ d≠0 ∧ Journey.sharp P.run P.large k (rᵏ t) (hᵏ t) f.val=(∫ z,Cκ z∂city (side P.run (rᵏ t) k))/d:=P.input_formula _ _ _ f h e
