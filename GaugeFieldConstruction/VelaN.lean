lemma pointersCΝ: Continuous (fun p:Vantage×Vantage=> Pointers2N p.1 p.2):= continuous_pi fun i=> by
 fin_cases i; exact continuous_fst; exact continuous_snd
lemma pinsCΝ:Continuous (fun p:Vantage=>Pulse1N p):= continuous_pi fun i=> by fin_cases i; exact continuous_id
lemma Plane1RateN (v:VenueY 0 X): Continuous (Seen1N ΞΧ X):=by
 apply continuous_iff_continuousAt.mpr; intro x
 let k:= Pulse1N x; exact (((groundPlotR ΞΧ.porch _ (fun i=> show AttainedR 0 ((![X]:Fin 1→ ScreensJ P) i) from (by fin_cases i; exact ⟨_,v.choose_spec.1⟩)) k (Set.mem_iUnion.mpr ⟨0,Mask1_S_N k 0⟩)).continuousAt ((prosc_R _).mem_nhds (Set.mem_iUnion.mpr ⟨0,Mask1_S_N k 0⟩))).comp (pinsCΝ.continuousAt))
lemma Plane2RateN (v:VenueY 0 X)(w:VenueY 0 Y)(h:Pointers2N xφ yφ∈CardsR (Fin 2)):ContinuousAt (fun k:Vantage×Vantage=> Seen2N ΞΧ X Y k.1 k.2) (xφ,yφ):=by
 let J:Fin 2→ ScreensJ P:= ![X,Y]; let W:(Vantage × Vantage)→ DiagramR (Fin 2):=fun x=>Pointers2N x.1 x.2;
 have he: ContinuousAt (SπR ΞΧ.porch J) (W (xφ,yφ)):= ((groundPlotR ΞΧ.porch J (fun i=>by fin_cases i; exact ⟨_, v.choose_spec.1⟩; exact ⟨_, w.choose_spec.1⟩) _ h).continuousAt ((prosc_R _).mem_nhds h)) -- Ω?
 exact he.comp (show ContinuousAt W (xφ,yφ) from pointersCΝ.continuousAt)
abbrev SelectDoseN (x:Vantage)(i:ℕ):SampleDose := DoseTravel.slider x (DoseTravel.chosen x i)
abbrev Alpha1ℓN (x:Vantage)(i:ℕ) := tsupport (SelectDoseN x i).val
lemma narrowT2N {K:Set (Vantage ×Vantage)}(b: K∈ 𝓝 (xφ,yφ)):∀ᶠ i in atTop, Alpha1ℓN xφ i ×ˢ Alpha1ℓN yφ i⊆K:=by
 obtain ⟨A,v,B,w,d⟩:= mem_nhds_prod_iff.mp b; filter_upwards [DoseTravel.concentrates xφ A v, DoseTravel.concentrates yφ B w] with i a b; exact (Set.prod_mono a b).trans d
lemma Alate1N (F:VenueY 0 X)(x:Vantage) : Tendsto (fun i:ℕ=> Pose1N (SelectDoseN x i) ΞΧ X) atTop (𝓝 (Seen1N ΞΧ X x)):=by
 refine Metric.tendsto_nhds.mpr ?_; intro ε e
 obtain ⟨Q,g⟩:= F; let Z:= Seen1N ΞΧ X
 let U: Set Vantage:= Z⁻¹' Metric.ball (Z x) (ε/2)
 have h: U∈ 𝓝 x:= (Plane1RateN ΞΧ X ⟨Q,g⟩).continuousAt.tendsto (Metric.ball_mem_nhds (Z x) (half_pos e)) -- tune map
 filter_upwards[DoseTravel.concentrates x U h] with i k
 rw [dist_eq_norm]; refine lt_of_le_of_lt ?_ (half_lt_self e); exact PoseBound1N Q _ ΞΧ X _ (ε/2) (fun y p=>(show ‖Z y-Z x‖<ε/2 from lt_of_eq_of_lt (dist_eq_norm ..|>.symm) (show dist (Z y) (Z x)<ε/2 from k p)).le) (DoseTravel.prescribed ..) g
lemma Alate2N (F: VenueY 0 X)(G:VenueY 0 Y)(σ: Fin 2 → PermWallJ P) (h:Pointers2N xφ yφ∈ MasksR (Fin 2)∩ OpenR 3 σ jNDuo) : Tendsto (fun i:ℕ=>Pose2N (SelectDoseN xφ i) (SelectDoseN yφ i) ΞΧ X Y) atTop (𝓝 (Seen2N ΞΧ X Y xφ yφ)):=by
 obtain ⟨Q,g⟩:=F; obtain ⟨T,k⟩:=G
 let z:Vantage × Vantage:= (xφ,yφ); let Z(p:Vantage × Vantage):= Seen2N ΞΧ X Y p.1 p.2; let W(p:Vantage×Vantage):= Pointers2N p.1 p.2
 let K:Set (Vantage×Vantage):= W⁻¹' (MasksR (Fin 2)∩OpenR 3 σ jNDuo)
 have v:K∈ 𝓝 z:= pointersCΝ.continuousAt.tendsto (((ply_openR ..).inter (Opens_R ..)).mem_nhds h) -- tune
 apply Metric.tendsto_nhds.mpr; intro ε e
 let U:Set (Vantage×Vantage):= Z⁻¹' Metric.ball (Z z) (ε/2)
 have w:U∈ 𝓝 z:= (Plane2RateN ΞΧ X Y ⟨Q,g⟩ ⟨T,k⟩ (Set.mem_iUnion.mpr ⟨3,h.1 3⟩)).tendsto (Metric.ball_mem_nhds (Z z) (half_pos e))
 filter_upwards[narrowT2N v, narrowT2N w] with i l c
 rw[dist_eq_norm]; refine lt_of_le_of_lt ?_ (half_lt_self e); exact PoseBound2N Q T _ _ ΞΧ X Y _ _ σ (fun x q y b=>l (show (x,y)∈_ from ⟨q,b⟩)) (fun x t y u=> (lt_of_eq_of_lt (dist_eq_norm ..|>.symm) (show dist (Z (x,y)) (Z z)<ε/2 from c (show (x,y)∈ _ from ⟨t,u⟩))).le) (DoseTravel.prescribed ..) (DoseTravel.prescribed ..) g k
