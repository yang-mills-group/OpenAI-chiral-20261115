lemma ElevPFe : ElevFe p B0 M pu A D Sq Wp dΩ dΦ Y (JoltFe p B0 M R pu A D m Sq Wp dΩ L0 J' f vK)= JoltFe p B0 M R pu A D m Sq Wp dΦ L0 J' f (LivΓFe J' dΩ dΦ Y vK):=by
 by_cases w:f0 ≤ f; swap; · unfold JoltFe; rw [dif_neg w,dif_neg w]; change ElevFe _ _ _ _ _ _ _ _ _ _ Y 0=0; rw[map_zero]
 let G:= ElevFe p B0 M pu A D Sq Wp dΩ dΦ Y; let S(d):= JoltFe p B0 M R pu A D m Sq Wp d L0 J' f; let A:=G.comp (S dΩ); let B:= (S dΦ).comp (LivΓFe J' dΩ dΦ Y)
 exact WaxLiveFe id A B A.map_add B.map_add (fun a b=> A.map_smul a b) (fun a b=> B.map_smul a b) (fun i=>Subtype.ext (by
   change (S dΩ _).val=(S dΦ (LivF _)).val; rw [LivΨFe]; unfold S; rw[JoltRootFe p B0 M R pu _ D m Sq Wp dΩ L0 J' i w, JoltRootFe p B0 M R pu _ D m Sq Wp dΦ L0 J' _ w])) vK -- A shadow.
