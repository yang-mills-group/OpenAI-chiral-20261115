lemma LivRibandFe : LivΓFe J' dΩ dΦ Y (RibandFe dΩ ω J' vK)=RibandFe dΦ ω J' (LivΓFe J' dΩ dΦ Y vK):=by
 let A:=RibandFe dΩ ω J'; let B:=RibandFe dΦ ω J'; let Φ:=LivF; let C:= StampZFe ω
 refine WaxLiveFe C (fun i=>Φ (A i)) (fun i=> B (Φ i)) (fun i j=>?_) (fun i j=>?_) (fun z t=>?_) (fun z t=>?_) (fun i=>?_) vK -- order
 · unfold A; rw[RibandFe_plus,map_add]
 · unfold B; rw[map_add,RibandFe_plus]
 · unfold A; rw [RibandFe_Z, map_smul]
 · unfold B; rw [map_smul,RibandFe_Z]
 apply EmRank J' dΦ; unfold Φ A B; rw[LivΨFe,ΞZeckFe]; rw[←show EmissionR J' dΩ (RibandFe dΩ ω J' (Pi.single i 1))=SpineM (XIdenFe ω (RingF i).val).2.2 from ΞZeckFe ..]; -- tune
 -- Naturality of Emission!
 let w:= RibandFe dΩ ω J' (show FrameK (RootS J' dΩ) from Pi.single i 1)
 change EmissionR J' dΦ (∑ j:RootS J' dΩ, w j • (Pi.single (RingF j) 1:FrameK (RootS J' dΦ)))= ∑ j:RootS J' dΩ, w j • ZeckR j.val
 rw[map_sum]; apply sum_congr rfl; intro i _; rw [map_smul,MintXFe]
