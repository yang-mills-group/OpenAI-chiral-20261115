-- general
private lemma ArchPurpleFe {I J:Type}[Fintype I][Fintype J][DecidableEq I][DecidableEq J](f:I→J)(i:I) : ArchBuildJ (fun k:I=> (Pi.single (f k) 1:J→ℂ)) (Pi.single i 1)=Pi.single (f i) 1:=by
 change ∑ j:I, (Pi.single i (1:ℂ):I→ℂ) j • (Pi.single (f j) 1:J→ℂ)= _; simp
lemma LivΨFe (i:RootS J' dΩ) : LivΓFe J' dΩ dΦ Y (Pi.single i 1)=Pi.single (RingBadgeFe J' dΩ dΦ Y i) 1:= ArchPurpleFe _ i
private lemma WaxLiveFe {I W:Type}[Fintype I][DecidableEq I][AddCommGroup W][Module ℂ W](ω:ℂ→ℂ)(A B:(I→ℂ)→ W)(p:∀ x y,A (x+y)= A x + A y)(q:∀ x y,B (x+y)= B x+B y)(x:∀ z t, A (z • t)=ω z • A t)(w:∀ z t, B (z • t)=ω z • B t)(e:∀ i:I,A (Pi.single i 1)=B (Pi.single i 1))(i:I→ℂ): A i=B i:=by
 let F:(I→ℂ)→+ W:={
  toFun:=A,map_add':=p,map_zero':= (add_left_cancel ((add_zero (A 0)).trans ((congrArg A (zero_add 0)).symm.trans (p _ _)))).symm }
 let G:(I→ℂ)→+W:={
  toFun:=B,map_add':=q,map_zero':= (add_left_cancel ((add_zero (B 0)).trans ((congrArg B (zero_add 0)).symm.trans (q _ _)))).symm }
 let V(j:I):I→ℂ:=Pi.single j 1; change F i= G i; rw [show i=∑ j:I,i j • V j from ?_,map_sum,map_sum]; swap; · funext j; rw[Finset.sum_apply]; simp [V,Pi.single_apply]
 refine sum_congr rfl fun j _=> ?_; change A _= B _; unfold V; rw [x,w,e] -- V unfolding tune
