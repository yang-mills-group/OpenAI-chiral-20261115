def CoatMQ (P:Spine)(d:BandS)(f s ι:ℕ):ℝ:= let q:=RankQJ P.par s; (1+ q⁻¹)^2 * ManaFee P d f s ι
local notation "Kν"=> RunTailQ f s p A M i k v g Z r L T ι Y hG z0 gU
local notation "Tm"=> MintRateQ ι
lemma PourMQQ (v0:3*s≤P.run.uv k)(F F':Mark (side P.run i (P.run.uv k)))(a b:ℝ)(hF:Circζ P.run i k θ Y s (labelQ x' false) F a)(hz:Circζ P.run i k θ Y s (labelQ x' true) F' b): RunTailQ f s p A M i k v g Z r L T ι Y hG z0 gU x' (F*F') (CoatMQ P d f s ι*(a*b)):=by
 let Pq:=Kν; let PP:=ManaFee P d f s ι; let C:=Pq x'; let M0:=RankQJ P.par s; have q0:0<M0:=(p.price f z0 d s).hot hG le_rfl; have vq:0≤PP:=mul_nonneg (Real.exp_pos _).le (add_nonneg (mul_nonneg (pow_nonneg (p.price f z0 d s|>.small) _) (sq_nonneg _)) (mul_nonneg (by norm_num) (sq_nonneg _)))
 let K:=CoatMQ P d f s ι; let KL:=(1+M0⁻¹); have hh:K=KL^2*PP:=rfl; have hi:1≤KL:= le_add_of_nonneg_right (inv_nonneg.mpr q0.le); have hK:0≤K:=mul_nonneg (sq_nonneg _) vq
 have ht(a b:ℝ)(p:1≤KL*a)(q:1≤KL*b): PP≤ K*(a*b):=by calc
     _ ≤ (KL*a*(KL*b))*PP:= le_mul_of_one_le_left vq ((one_le_mul_of_one_le_of_one_le p q))
     _ = _ := by rw [hh]; ring
 let up:=labelQ x' false; let Yv:=labelQ x' true
 have hψ:1≤KL*M0:=by unfold KL; rw[add_mul,inv_mul_cancel₀ q0.ne']; linarith
 have hb:=errorWXQ f s p A M i k v g Z r L T ι Y q hG z0 gU x' tE tp d u -- tune args order.. need all layouts.
 change Enterprise _ _ _ (F*F') (K*(a*b)); have h1:=ChargedJ.paid hz q0.le; unfold Circζ at hF hz
 induction hF with
 | one=>
    rw [one_mul,one_mul]; clear h1; induction hz with
    | one=> exact (hb [] (by simp [galaJ]) (by simp) (by simp) v0).lift ((ht 1 1 (by simpa using hi) (by simpa using hi)).trans (by simp))
    | coin j v=>
       have E: ClaimQX.Fore j=x':=congrArg (@bay_HQ X) v
       refine (Enterprise.lift ?_ (show PP≤ K*M0 from (ht 1 M0 (by simpa using hi) hψ).trans_eq (by rw[one_mul])))
       simpa using hb [j] (List.pairwise_singleton ..) (by simp) (fun i v=> by simp [List.mem_singleton.mp v,E]) v0 -- rewrite E tune
    | add t v ih hh=> apply Enterprise.lift (Enterprise.add ih hh); linarith
    | lift v t ih=> exact ih.lift (mul_le_mul_of_nonneg_left v hK)
    | smul z t ih=> apply Enterprise.lift (ih.scale z); rw [mul_left_comm]
 | coin j v=>
    clear h1; induction hz with
    | one=>
       have E: Fore j=x':=congrArg (@bay_HQ X) v; rw[mul_one,mul_one]; have h:=hb [j] (List.pairwise_singleton ..) (by simp) (fun i v=> by simp [List.mem_singleton.mp v,E]) v0; simp at h; exact h.lift ((ht M0 1 hψ (by simpa using hi)).trans_eq (by rw[mul_one]))
    | coin i q=>
       have H: Fore j=x':=congrArg (@bay_HQ X) v; have hp: Fore i=x':=congrArg (@bay_HQ X) q; have hw: galaJ (TolHouseJ θ) [j,i]:=by unfold galaJ; simp only[List.map_cons,List.map_nil,v,q]; refine List.pairwise_cons.mpr ⟨?_,List.pairwise_singleton ..⟩; intro i t; rw[List.mem_singleton.mp t]; exact Prod.Lex.right _ (by decide : false < true)
       have hz:= hb [j,i] hw (by simp) (fun q v=>by simp at v; rcases v with rfl|rfl<;> assumption) v0; simp only[List.map_cons,List.map_nil,List.prod_cons,List.prod_nil,mul_one] at hz; exact hz.lift (ht _ _ hψ hψ)
    | smul z t ih=> rw[Algebra.mul_smul_comm]; exact (ih.scale z).lift (le_of_eq (by ring))
    | add v w ih y=> rw[mul_add]; apply Enterprise.lift (ih.add y); apply le_of_eq; ring
    | lift v t ih=> exact Enterprise.lift ih (mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left v q0.le) hK)
 | add v w i j=> rw [add_mul]; exact (i.add j).lift (le_of_eq (by ring))
 | smul z v y=> rw[Algebra.smul_mul_assoc]; exact (Enterprise.scale z y).lift (le_of_eq (by ring)) -- .lift notation?
 | lift v x y=> exact Enterprise.lift y (mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right v h1) hK)
#print axioms PourMQQ
