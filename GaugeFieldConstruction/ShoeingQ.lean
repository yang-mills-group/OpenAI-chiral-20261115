lemma errorWXQ (v0:3*s≤P.run.uv k): RunTailQ f s p A M i k v g Z r L T ι Y hG z0 gU x' ((U.map (Y.Mark s)).prod) (ManaFee P d f s ι):=by
 have H:= PyxidQ P f s Z i k hG gU.le ι tp tE; have R:= CityCq s p A M i k _ _ (L ∘tip_HQ) T H v0 (z0.trans hG); unfold SalaryJ PlateZ at q; have H':=(RushNJ ηQ _ q.arc q.io Y q.mony _ _ _ R s le_rfl gU.le).stamped
 obtain ⟨W,pW⟩:= AptlCQ x' d u U g0; let C:= soleQ d u x' W U
 have he:(C.tag x')=Bootκ θ (x',d) u W.succ:= rfl
 refine .coin C _ _ (?z) (solePaidQ x' d u U wU g0 wL W pW) ?_
 case z=> apply (show ∀ L:List (SailκJ (ChildQ X) θ), PostSupport false univ ((L.map (Y.Mark s)).prod) from (fun l=> by induction l with|nil=>exact PostSupport.of (AtSupport.oneM _)| cons j s ih=>exact (H'.owns j).mulM ih))
 intro P' α q; let S:=C.tag x'; have pp:P'.turnOn x'=true:=α.turn.symm.trans (by simp [C, soleQ]); let δ:=ScaleμJ P.par d.val; let k':=δ^(s-f)*RankQJ P.par f+2*RankQJ P.par s; have hk:0≤k':=add_nonneg (mul_nonneg (pow_nonneg ((p.price f z0 d s).small) _) (sq_nonneg _)) (mul_nonneg (by norm_num) (sq_nonneg _)); let rV:=MintRateQ ι; let η:ℂ:=rV; have hμ:0< rV:= Real.exp_pos _; have He:η≠0:=by unfold η; exact_mod_cast hμ.ne'
 constructor
 · exact mul_nonneg (Real.exp_pos _).le hk
 intro pB h; have p₀:= AnnualQw f s p A M i k v g Z r L T ι Y pB P' hG z0 gU h (x',d) (C.tag x') rfl; have τ: P'.work x'=U:=α.work.symm.trans rfl; let A:= (U.map (Y.Mark s)).prod
 have hq:pB.Mark s (C.tag x')= η • A:=by rw [α.tag, ← feeBookQ f s p ‹SωJ θ› M i k v g Z r L T ι Y pB P' hG z0 gU x' h pp,τ]; -- tune p A shadow
 have H' := ChargedJ.smul η⁻¹ p₀; rw [hq,smul_smul,inv_mul_cancel₀ He,one_smul,norm_inv, show ‖η‖=_ from Complex.norm_real rV,Real.norm_of_nonneg hμ.le,show rV=Real.exp (-(ι:ℝ)) from rfl,Real.exp_neg,inv_inv] at H'; exact H'
