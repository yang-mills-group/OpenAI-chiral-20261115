 (W:ℕ → Type*)(Y:∀ n:ℕ, W n→ P→ℂ) (hp:∀ i (j:W i), ContinuousOn (Y i j) K) (S:ℕ→ Set P)(q:∀ i, IsClosed (S i)) (B:ℕ→ℝ)(t:∀ i, 0≤B i)
 (hU:Tendsto (fun i=> B i*μ.real (K ∩ S i)) atTop (𝓝 0)) (u:∀ᶠ i in atTop,∀ j:W i,∀ p∈ K, ‖Y i j p‖≤B i) (w:∀ ε>0,∀ᶠ i in atTop,∀ j:W i,∀ p∈ K \ S i, ‖Y i j p‖≤ ε): ∀ ε>0,∀ᶠ i in atTop,∀ j:W i, ∫ p in K, ‖Y i j p‖ ∂μ< ε:=by
 intro ε hε; let e:= ε/4; have he:0<e:=by unfold e; positivity
 let d:= 1+ μ.real K; have hz:μ.real K < d:=lt_one_add _ -- tune
 have hh:0<d:=measureReal_nonneg.trans_lt hz
 have ht:0<e/d:=div_pos he hh
 filter_upwards[u,w (e/d) ht,hU.eventually (ge_mem_nhds he)] with i H h' g j
 let F:=Y i j; let f (p:P):= ‖F p‖; let T:=K ∩ S i; have a:T ⊆ K:=Set.inter_subset_left; let A:=K \ S i; have hA:A⊆ K:=Set.sdiff_subset; have ha:MeasurableSet A:=h.measurableSet.diff (q i).measurableSet
 have hT:IsCompact T:=h.inter_right (q i); letI: IsFiniteMeasure (μ.restrict K) := ⟨by rw [Measure.restrict_apply MeasurableSet.univ,Set.univ_inter]; exact h.measure_lt_top⟩; have hF:IntegrableOn f K μ:=(hp i j).norm.integrableOn_compact h
 have hτ(h_:Set P)(A:ℝ)(m:h_⊆ K)(p:MeasurableSet h_)(y:∀ p∈h_, f p≤ A) : ∫ i in h_, f i ∂μ ≤ μ.real h_* A:=by rw [show μ.real h_*A=∫ _ in h_, A ∂μ from (setIntegral_const A).symm]; exact setIntegral_mono_on (hF.mono_set m) ((show IntegrableOn (fun _=>A) K μ from integrable_const _).mono_set m) p y -- tune
 have hΔ:= hτ A _ hA ha (h' j); have hv:= hτ T _ a hT.measurableSet (fun x z=>H j x z.1); change ∫ i in K, f i ∂μ< _; rw [show K=A∪T by unfold A T; ext x; simp,setIntegral_union (show Disjoint A T from Set.disjoint_left.mpr (fun _ h k=>h.2 k.2)) hT.measurableSet (hF.mono_set hA) (hF.mono_set a)];
 apply lt_of_le_of_lt (add_le_add hΔ hv); rw [mul_comm (μ.real T)]; have hg:μ.real A*(e/d)≤e:=((mul_le_mul_of_nonneg_right ((measureReal_mono hA h.measure_lt_top.ne).trans hz.le) ht.le).trans_eq (by field_simp)); linarith only [hg,show B i*μ.real T≤e from g,(show e+e<ε from (by unfold e; linarith only [hε]))]
