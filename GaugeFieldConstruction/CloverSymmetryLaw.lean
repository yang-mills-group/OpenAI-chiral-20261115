noncomputable abbrev turnSystem (p:ΧiMars):=((roles.PerD_VU stress (le_refl _)).TinCanL p) -- charge
abbrev SleepW (X Y:UV four): Prop:=
   (∀ x:Points 2,x∈conf 2→ sepCost hΞ x X Y=0) ∧
   (∀ x:NSF.Boundary.Full 2,x∈ NSF.Boundary.tube 2→ continued.emit ((xΞ).TinCanL ∘ ![X,Y]) x=0) ∧
   response.W 2 ((xΞ).TinCanL ∘ ![X,Y])=0
local notation "Sl"=> SleepW (stress:=stress) (continued:=continued) (vacuum:=vacuum)
lemma symmetricWard (x:UV three) : SleepW (stress:=stress) (vacuum:=vacuum) (continued:=continued) dF (roles.DeckLiftVU i x) ∧ SleepW (stress:=stress) (vacuum:=vacuum) (continued:=continued) (roles.DeckLiftVU i x) dF :=by
 let T:= roles.WarmVU stress vacuum (le_refl _) Certificate.path.phase_costs Certificate.path.ward_oracle; let V:= roles.RotatesΕVU stress vacuum Certificate.path.phase_costs
 rw [roles.FaceAuraVU _ E, low_slotPrice_st _ E]
 exact reapedGlow_st (Shed:=(xΞ)) stress T V model.inlet.heat model.inlet.joints Certificate.field_theory.1 _ _ _ vFieldFeatVU

local notation "phi"=>model.system.operators.field
local notation "state"=>model.system.operators.omega

noncomputable abbrev tensorExperimentGap (X Y:UV four)(f g:Test4) := inner ℂ model.system.operators.omega (model.system.operators.field ((xΞ).TinCanL X) f (model.system.operators.field ((xΞ).TinCanL Y) g model.system.operators.omega)) - inner ℂ model.system.operators.omega (model.system.operators.field ((xΞ).TinCanL X) f state)*inner ℂ state (model.system.operators.field ((xΞ).TinCanL Y) g state)
lemma solitary_pay (f:Test4): inner ℂ state ((phi) (turnSystem (stress:=stress) dF) f state)=0:=by
 have he : response.W 1 ((xΞ).TinCanL ∘ ![dF])=0:= zeroDistrib hΞ (roles.WarmVU stress vacuum (le_refl _) Certificate.path.phase_costs Certificate.path.ward_oracle) (xΞ) model.inlet.heat model.inlet.joints Certificate.field_theory.1 (![dF]) (fun x h=> roles.forswearVU _ _ (le_refl _) Certificate.path.phase_costs Certificate.path.ward_oracle i E x)
 change inner ℂ state ((phi) ((xΞ).TinCanL dF) f state)=_; rw [actualBill_one_st model.course,he]; rfl
local notation "Aκ" x:max f:max=> ((phi) (turnSystem (stress:=stress) x) f)
