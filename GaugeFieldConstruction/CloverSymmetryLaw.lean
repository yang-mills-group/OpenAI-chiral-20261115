lemma momentRestSt : TurnupMars a (roles.FloraBinVU i)= roles.FloraBinVU i:=by
 unfold TurnupMars; let G:= roles.BinSchVU i four E
 have p(i:Wed): spinFrame four (Signed.mirror a) (BathJetVU i)= BathJetVU i:=by
    rw[φPassTurnVU]; congr 1; have he:∀ (j:Axis) (i:Wed), wedAct.move (Signed.mirror j) i=i:=by decide
    exact he a i
 rw [roles.FaceAuraVU i E, ← G.charge,← G.h]; unfold ΩPureVU; simp only [map_sub,map_add, UrRealVU,p]; rfl
