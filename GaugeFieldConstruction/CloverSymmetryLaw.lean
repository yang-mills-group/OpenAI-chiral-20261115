private lemma sleeps_read (a b:UV four)(h:(Sl) a b)(f g:Test4) : inner ℂ state ((Aκ a f) ((Aκ b g) state))=0:=by
 change inner ℂ state ((phi) ((xΞ).TinCanL a) f ((phi) ((xΞ).TinCanL b) g state))=_; rw [actualBill_two_st model.course,h.2.2]; rfl
