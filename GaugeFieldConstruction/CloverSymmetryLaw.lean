lemma reflected_basis_st (Z:UV three): ∃ V:UV three, TurnupMars a (roles.DeckLiftVU i Z) = roles.DeckLiftVU i V:=by
 let L:=(roles.BinSchVU i three E).c; refine ⟨L.symm (spinFrame three (Signed.mirror a) (Calibration.shade three (L Z))),?_⟩
 rw [low_slotPrice_st i E, low_slotPrice_st i E, L.apply_symm_apply]; exact fittedTurn_st ..
-- supplementary whole sector.Scope for the symbolic obstruction. Anchor (one chosen) has full Pose Gear as well.
structure FullSector_st : Prop where
 chirality (a:Axis) (Z:UV three) : ∃ V:UV three, TurnupMars a (roles.DeckLiftVU i Z) = roles.DeckLiftVU i V
 lights (X:UV four)(h:X∈tensorC_st)(Y:UV three): SleepW (stress:=stress) (continued:=continued) (vacuum:=vacuum) ((roles.BinSchVU i four E).c X) (roles.DeckLiftVU i Y) ∧ SleepW (stress:=stress) (continued:=continued) (vacuum:=vacuum) (roles.DeckLiftVU i Y) ((roles.BinSchVU i four E).c X)
 void_single (X:UV four)(h:X∈tensorC_st)(f:Test4): inner ℂ state ((Aκ ((roles.BinSchVU i four E).c X) f) state)=0
 toys (X:UV four)(h:X∈tensorC_st)(Y:UV three)(f g:Test4) : tensorExperimentGap (model:=model) ((roles.BinSchVU i four E).c X) (roles.DeckLiftVU i Y) f g=0∧ tensorExperimentGap (model:=model) (roles.DeckLiftVU i Y) ((roles.BinSchVU i four E).c X) g f=0
lemma globalTensorSt : FullSector_st (stress:=stress) (vacuum:=vacuum) (model:=model) (continued:=continued) i E:=by
 have t(X:UV four)(h:X∈tensorC_st)(Y:UV three): (Sl) ((BinC) X) (roles.DeckLiftVU i Y) ∧ (Sl) (roles.DeckLiftVU i Y) ((BinC) X):=by rw[low_slotPrice_st i E]; exact fullLock_st stress _ _ (roles.WarmVU stress vacuum (le_refl _) Certificate.path.phase_costs Certificate.path.ward_oracle) (roles.RotatesΕVU stress vacuum Certificate.path.phase_costs) h _ model.inlet.heat model.inlet.joints Certificate.field_theory.1
 have he(X:UV four)(h:X∈tensorC_st)(f:Test4):inner ℂ state ((Aκ ((BinC) X) f) state)=0:=by
    change inner ℂ state ((phi) ((xΞ).TinCanL ((BinC) X)) f state)=_; rw [actualBill_one_st model.course]; let T:= roles.WarmVU stress vacuum (le_refl _) Certificate.path.phase_costs Certificate.path.ward_oracle
    rw [zeroDistrib _ T _ model.inlet.heat model.inlet.joints Certificate.field_theory.1 (![(BinC) X]) (fun x p=> fullFirst_st stress _ _ T (roles.RotatesΕVU stress vacuum Certificate.path.phase_costs) h x)]; rfl
 refine ⟨fun a z=> reflected_basis_st Certificate i a E z,t,he,?_⟩
 intro X h Y f g; unfold tensorExperimentGap; rw [sleeps_read Certificate _ _ (t X h Y).1,sleeps_read Certificate _ _ (t X h Y).2,he _ h]; simp
