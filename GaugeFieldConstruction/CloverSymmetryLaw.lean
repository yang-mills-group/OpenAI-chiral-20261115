-- LowInc comparison for slots of height 3
private lemma low_slotPrice_st (x:CogPV): roles.DeckLiftVU i x=LowIncPV ((roles.BinSchVU i three E).c x):=Calibration.inject four ((roles.DeckPortVU i E x).trans (LowFivePV _).symm)
