variable {n:Side}{i j:Mark n}{S T:Finset (Seat n)}{w:Bool}
lemma Post_LiftJ (i': PostSupport w S i)(t:S⊆T):PostSupport w T i:=by
 have h:S⊆T:=t; let U:= modesIn n S; let G:= modesIn n T
 refine ⟨i'.env,fun _ _ p q=>i'.dep _ _ (agrees_mono p h) (agrees_mono q h),fun x=>?_⟩
 have hk:U⊆G:=modes_monotone t; have he: ∀ {a} {l:Bool},Fock.Sector U l a→Fock.Sector G l a:=by
   intro a l v; induction v with
   | zero=> apply Sector.zero
   | one=> apply Sector.one
   | up j h=> exact .up j (hk h)
   | down j h=> exact .down j (hk h)
   | scale h v u=> exact u.scale v
   | add _ _ p q=> exact p.add q
   | mul _ _ p q=> exact p.mul q
 exact he (i'.trade _)
lemma PostCommutJ (h:PostSupport false S i)(u:PostSupport false T j)(p:Disjoint S T): Commute i j:=by
 have hr:Disjoint (modesIn n S) (modesIn n T):= Finset.disjoint_left.mpr (fun i h u=> Finset.disjoint_left.mp p ((modes_at ..).1 h) ((modes_at ..).1 u))
 change i*j=j*i; funext x; change i x*j x=j x*i x; simpa only [Sector.grainB,Bool.false_and,reduceCtorEq,ite_false,one_smul, Bool.false_eq_true] using Sector.apart (h.trade x) (u.trade x) hr
lemma Post_ListJ {E:Type} (u: E→Mark n)(l:List E) (p:∀ i∈l,PostSupport false S (u i)): PostSupport false S (l.map u).prod:=by induction l with |nil=> exact PostSupport.of (AtSupport.oneM _)|cons i l ih=> exact (p i List.mem_cons_self).mulM (ih (fun i h=>p i (List.mem_cons_of_mem _ h)))
lemma WardJDisj {i₀:ℕ} {l m: Finset (Seat (Journey.side Y i₀ (Y.uv k)))} (h:WardEnd Y (Y.uv k) i₀ l m) : Disjoint l m:=Finset.disjoint_left.mpr fun x a q=>by have u:= (Nat.zero_le _).trans_lt (h x a x q); rw [separation_self] at u; omega
end
