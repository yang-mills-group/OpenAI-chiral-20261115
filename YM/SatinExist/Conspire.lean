/-! Continuing the interaction-direction work: first projections earned. -/
abbrev EpochPair (P:Spine) : Prop:= ∃ C:Afterglow.Hierarchy.Call P.par P.width,∃ W:Afterglow.Hierarchy.Wicket P.par P.width, Afterglow.Hierarchy.Rolled P.run P.large P.period P.cutoff W C
abbrev IndigoPrice (P:Spine):Prop:= EpochPair P ∧ Defer P.par
theorem installAge {RΘ:Preparation→Prop}(FΘ: CommissionVector RΘ) (X:Supplier)(e u:ℝ)(p:0<u) :
    ∃ (P:Spine) (R:P.Register), uniform P R X e u ∧ P.Roster ∧ P.NightCop ∧ EpochPair P ∧ RΘ P.par :=by
  obtain ⟨x,c,q⟩:= Papal.audit_weather 4 (by decide)
  obtain ⟨Λ,l,Z,v,pL,S,Q,A0,Xφ,K,H,Y,U,Pr,Lo,k,d,w,C,t,a,k',I,E,L,B,T',t',W,A,Uo⟩:=
      Papal.refinery FΘ e (min x u) (lt_min c p) X
  let V:= W.univ_; obtain ⟨q',h'⟩:= purchase_line Y H V; obtain ⟨D,a₀,b,hh,Q',h,x₀⟩:= SlabMark.subPoll Y H V h'; let G:GroundExtension (i:=a) (k:=k') (E:=E) Y H := ⟨D,q'∘a₀,b,hh,h⟩
  let P:Spine:=⟨Λ,l,Y,H,a,k',I,E,V,G⟩
  obtain ⟨x',v₀⟩:=q Λ.d Λ.dpos.le (pL.trans (min_le_left ..))
  exact ⟨P,⟨(L,B,T',t'),W⟩,⟨⟨K,v,pL.trans (min_le_right ..),A, ⟨k,d,w,Z,C,t,Q,S⟩,
        x', (Λ.kJ.symm ▸ v₀: Procurement Λ.K.j x' Λ.d)⟩, A0⟩,
      ⟨U,Pr,Lo⟩, x₀,Uo, Xφ⟩

/-- For passing also further purchases through the election. -/
theorem transAge {RΘ:Preparation→Prop}(F:CommissionVector RΘ)(Y:Supplier)(L M:ℝ)(p:0<M)(z:ℕ→ℕ):
 ∃ (P:Spine)(K:P.Register), uniform P K Y L M ∧ P.Roster ∧ P.NightCop ∧ EpochPair P ∧ RΘ P.par ∧∃ (c r:ℕ→ℕ)(x:P.Spectrum0 3),z≤r ∧ ∃ J:P.Ellis 3 x, P.Experiment K c r x J ∧ P.Transmission x c r := by
 obtain ⟨P,K,T,x,vPoll,Up,T'⟩:= installAge F Y L M p
 obtain ⟨r,e,c,B,q,y,m',α,t,a,b,g,R,w⟩:= Prototype.summit_on P K T 1 one_pos z
 obtain ⟨n,x₀,H,U,V,T₀,G,J,A,E,F⟩ := w.exists
 let Φ:Spine.Experiment P K c r x₀ J:=⟨B,T₀,H,A,E⟩
 exact ⟨P,K,T,x,vPoll,Up,T',c,r,x₀,e,J,Φ,Spine.trans6 Φ⟩
theorem phoenix (X: TintDemand)(Y:Supplier)(L M:ℝ)(p:0<M)(z:ℕ→ℕ) :
    ∃ n_:ℕ, ((2:ℝ)*Ione.strive_E 6 ≤ (n_:ℝ)) ∧ ∃ (P:Spine)(K:P.Register), uniform P K Y L M ∧ P.Roster ∧ P.NightCop ∧ IndigoPrice P ∧ TintCommercial n_ (crayon X) P.par ∧
     Meritorious P.par ∧15 ∣ P.par.R.L.val∧ P.par.R.L.val %16 =1 ∧ (∀ᶠ s:ℕ in atTop,∀ i k:ℕ,(P.run.voyage i).kick ≤ k→s≤P.run.uv k→VLine P.run s i k (SectorNext.Remainder.Scales.merit P.par.R.L (hat P.par.R.L P.par.x s))) ∧
      Yoke.Dispatchers P.par ∧
     (∃ C≥(1:ℝ), Yoke.Drawbill P.par C ∧ ∀ᶠ s:ℕ in atTop,∀ᶠ i:ℕ in atTop,∀ k:ℕ, (P.run.voyage i).kick ≤ k→s≤P.run.uv k→Yoke.ShelterCost C P.run s i k)∧
     (∃ A:ℝ, Chronicle P.run A ∧ ∀ᶠ f:ℕ in atTop,∀ r:ℕ, f < r→ ∀ v:ℕ,r ≤ v → ∀ᶠ i:ℕ in atTop, ∀ k:ℕ,(P.run.voyage i).kick ≤ k → v≤ P.run.uv k→ Yoke.PaysTilt P.run i k f r v A) ∧
    ∃ (c r:ℕ→ℕ)(x:P.Spectrum0 3),z≤r ∧ ∃ J:P.Ellis 3 x, Spine.Experiment P K c r x J ∧ P.Transmission x c r ∧
        ∀ (U V : Doorway) (order : Orders), U.Later V order 0 → ∀ᶠ i : ℕ in atTop,
          ∃ (a : ℝ) (F G : SampleDose), F.Normalized ∧ G.Normalized ∧
            tsupport F.val ⊆ U.invites ∧ tsupport G.val ⊆ V.invites ∧
            P.ReturnsSix x (c i) (r i) a F G ∧ P.FixedSatinReadings K x (c i) (r i) a F G := by
  obtain ⟨n_,wn⟩:= exists_nat_gt ((2:ℝ)*Ione.strive_E 6)
  obtain ⟨P,K,h,hs,vPoll,Uo,⟨⟨⟨Uq,A,M₀,g0,h0⟩,X',Y'⟩,Dh⟩,c,r,x,hv,J,w,Xt⟩ := transAge (Yoke.dispatch_commission (Yoke.draw_grants (prince (crayon X) n_))) Y L M p z
  refine ⟨n_,wn.le,P,K,h,hs,vPoll,⟨Uo,Uq⟩,A,M₀,g0,h0, ?_,Dh,?_,?_, c,r,x,hv,J,w,Xt,?_⟩
  · simpa only [one_mul] using line_merit P.run 1 zero_lt_one M₀
  · have ht:1 ≤ X':=by obtain ⟨a,b,N,e,f,Ra,Rb,t⟩:=Y'.bought; rw [Ra]; nlinarith only [sq_nonneg (45*(1+b)),sq_nonneg (1+b)]
    exact ⟨X',ht,Y',Yoke.costs P.run M₀ Dh Y' (zero_le_one.trans ht)⟩
  · obtain ⟨Pay,kC,Γ,Tξ,u,v,s,q,y,p1,p2,πx,m⟩:= A.fromCrew; obtain ⟨A',t⟩:= crisps P.run Pay kC Γ Tξ y (sky_Line P.run (m.marble (by rw [P.par.kJ]; exact ⟨2,rfl⟩) P.par.kJ.ge u v q s p1 p2 2 (by simpa using wn.le)) hs.prepared) q s πx hs.prepared; exact ⟨A',t,Yoke.purchase_series P.run t⟩
  intro U V order sep
  let b : Fin 3 → Bool := fun _ => false
  obtain ⟨p, e, _he, _inside, hcost⟩ := authorize b
  filter_upwards [packs_within_rectangles Xt (Metric.ball p e) b hcost U V order sep] with i hi
  obtain ⟨a, F, G, hF, hG, hR, hU, hV, _⟩ := hi.2
  exact ⟨a, F, G, hF, hG, hU, hV, hR, P.reviewWardContrast K x _ _ a F G hR⟩
#check phoenix
#print axioms phoenix

open QuadClock
lemma az_consumption (X:TintDemand)(Y:Supplier)(L M:ℝ)(p:0<M)(d:ℝ)(w:0<d)(z:ℕ→ℕ):
 ∃ (n_:ℕ)(P:Spine)(K:P.Register), uniform P K Y L M ∧ P.Roster ∧ P.NightCop ∧ IndigoPrice P ∧ TintCommercial n_ (crayon X) P.par ∧
     Meritorious P.par ∧15 ∣ P.par.R.L.val∧ P.par.R.L.val %16 =1 ∧
     Yoke.Dispatchers P.par ∧
     (∀ e:ℝ,0<e→∀ᶠ s in atTop,(∀ j:Axis,∃ x:Cover, Plans j x s P ∧ P.repeatBill (Spine.twiceT x j) s)∧ P.repeatBill (Yoke.scout P.par e s) s)∧
     ∃ C≥(1:ℝ), Yoke.Drawbill P.par C ∧ (∀ᶠ s:ℕ in atTop,∀ᶠ i:ℕ in atTop,∀ k:ℕ, (P.run.voyage i).kick ≤ k→s≤P.run.uv k→Yoke.ShelterCost C P.run s i k)∧
     ∃ A:ℝ, Chronicle P.run A ∧ (∀ᶠ f:ℕ in atTop,∀ r:ℕ,∀ (e:f<r), ∀ v:ℕ, ∀ (u:r≤v), EarnedClockPlot P C A f r v e u) ∧
     ∃ c r:ℕ→ℕ, z≤r ∧ ∀ᵐ x∂ P.pillars 3,
      (∃ J:P.Ellis 3 x, Spine.Experiment P K c r x J) ∧ P.Transmission x c r ∧
        (∀ᶠ i in atTop,Yoke.canonWeight/32 ≤ (Yoke.scout P.par d (c i):ℝ)^8 * (P.pulseQ 3 Yoke.witnessZ (c i) (Yoke.CheckPoint P.par d (c i)) 0 x).re) ∧
        ∀ (U V : Doorway) (order : Orders), U.Later V order 0 → ∀ᶠ i : ℕ in atTop,
          ∃ (a : ℝ) (F G : SampleDose), F.Normalized ∧ G.Normalized ∧
            tsupport F.val ⊆ U.invites ∧ tsupport G.val ⊆ V.invites ∧
            P.ReturnsSix x (c i) (r i) a F G ∧ P.FixedSatinReadings K x (c i) (r i) a F G := by
  obtain ⟨n,i,P,K,Q,r,v,T,t,g,pr,tq,U,G,⟨C,p',c,D⟩,⟨A,y,q⟩,_⟩:= phoenix X Y L M p z
  obtain ⟨v',f,q1,L'⟩:= P.further_stage K z d Q D w
  refine ⟨n,P,K,Q,r,v,T,t,g,pr,tq,G,?_,C,p',c,D,A,y,?_, v',f,q1,?_⟩
  · intro e u; filter_upwards [(eventually_all_finset univ).mpr (fun j _=> P.offers_plans j e u), P.weather_bill e u] with i p q
    exact ⟨fun j=> (p j (mem_univ _)).2,q⟩
  · filter_upwards [P.treasury_plot A C D y] with f p r e u z; obtain ⟨b,a,l,h⟩:=P.penny_p (p r e u z); exact ⟨b,a,l,h,fun j x y c=> ⟨P.vision j x h y c v,P.caucus j x h y z e.le c v⟩⟩
  filter_upwards [L'] with x p; obtain ⟨⟨J,Jh⟩,g⟩:=p; have β:= trans6 Jh
  refine ⟨⟨J,Jh⟩,β, g.mono fun i u=> P.bill_positive d _ u.le,?_⟩
  intro U V order sep
  let b : Fin 3 → Bool := fun _ => false
  obtain ⟨p, e, _he, _inside, hcost⟩ := authorize b
  filter_upwards [packs_within_rectangles β (Metric.ball p e) b hcost U V order sep] with i hi
  obtain ⟨a, F, G, hF, hG, hR, hU, hV, _⟩ := hi.2
  exact ⟨a, F, G, hF, hG, hU, hV, hR, P.reviewWardContrast K x _ _ a F G hR⟩
end YM.CF.Buffered.Afterglow.Tower.VacuumSelection
#print axioms YM.CF.Buffered.Afterglow.Tower.VacuumSelection.az_consumption

