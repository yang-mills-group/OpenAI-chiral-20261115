lemma floor_t : Ø∈ Wheat (camp S_):=by rw [Wheat]; simp
lemma bredP : (insert Ø (perm_p v'))∪ kperm v'=v':=by
 ext i; simp only [mem_union,mem_insert,perm_p,kperm,mem_filter]; constructor; swap
 · intro p; obtain ⟨h,v⟩:= mem_filter.mp p; rw [Nat.even_iff] at v; by_cases w:i.card=0
   · exact Or.inl (Or.inl (Finset.card_eq_zero.mp w))
   by_cases t:i.card=2; · exact Or.inl (Or.inr ⟨mem_filter.mpr ⟨h,(Nat.even_iff).mpr v⟩,t⟩) -- simp mem_Filter!
   exact Or.inr ⟨mem_filter.mpr ⟨h,(Nat.even_iff).mpr v⟩,by omega⟩
 rintro ((rfl|⟨h,g⟩)| ⟨p,v⟩); exact floor_t _; exact h; exact p
lemma sole : Ø ∉ perm_p v':=fun p=>by simpa using (mem_filter.mp p).2
lemma sealed :Disjoint (insert Ø (perm_p v')) (kperm v'):=by
 refine Finset.disjoint_left.mpr (@fun zT hz hH=>?_)
 have hx : 4 ≤ (zT:Finset (Dwell (mid P B))).card:=(mem_filter.mp hH).2
 rcases mem_insert.mp hz with rfl|w
 · simp at hx
 have hh:zT.card=2:=(mem_filter.mp w).2
 omega
end
lemma warm_p (v:n₀): LA v= (WR {Ø}) v+((WR (perm_p θ)) v + (WR (kperm θ)) v):=by
 dsimp only; unfold lump
 conv_lhs=> rw [← bredP i.1.val.2, sum_union (sealed i.1.val.2),sum_insert (sole i.1.val.2)]
 rw [add_assoc, Finset.sum_singleton]
