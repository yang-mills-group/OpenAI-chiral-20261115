lemma trek_v (DΦ:Finset (Scree.Hub (mid P B)))(i:Bool): (∑ p∈ DΦ,κ' (p,i))≤ Fintype.card (Site (mid P B))*(16*δ):=by
 let J(v:PE):Roc (mid P B):=(v,i); have ht:Injective J:=fun a b h=>Prod.mk.inj h|>.1
 let I:=Roc (mid P B); let W(x:Site (Domain P B)):=univ.filter (fun i:I=> i.1.val.1=x); let XkC:= fun i:I=>Y.p.mass i.1.val.2 (κ' i); have hl:∀ i: I,κ' i ≤ XkC i:=fun i=> le_mul_of_one_le_left (pα.lightsP i) (Real.one_le_exp (mul_nonneg Y.p.exponent_pos.le (by positivity)))
 rw [show (∑ j ∈DΦ,κ' (j,_))=_ from (Finset.sum_image (s:=DΦ) (g:=J) (f:=κ') (fun i _ j _ p=>ht p)).symm]
 refine le_trans ((sum_le_sum fun i _=>hl i).trans (sum_le_sum_of_subset_of_nonneg (subset_univ _) (fun i _ _=>(pα.lightsP i).trans (hl i)))) ?_; rw [←sum_fiberwise_of_maps_to (s:=univ) (g:=fun i:I=> i.1.val.1) (t:=univ) (fun i _=>mem_univ _)]
 apply le_trans (sum_le_sum (fun i _=>pα.pay i)); rw [sum_const,card_univ,nsmul_eq_mul]; change (Fintype.card (Site (More (mid P B))):ℝ)*δ≤_; rw [site_card]; simp [More,site_card]; nlinarith -- tune sizes
