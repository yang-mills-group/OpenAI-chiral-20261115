lemma mar_v(p:i=i): BeaconP (K:=K.j) Y S:=by
 have hv(t:Bool)(i:Scree.Hub (mid P B)): clan_X t Y i=0:=by cases t <;> simp [clan_X,Feu.Corset.actionZ,pΦ,hΦ] -- tune names
 refine ⟨?_,fun i s Y h V p=> (by rw [hv,hv]; exact Eq.symm (map_zero _)),fun j=>?_⟩
 · intro H; let U:= dawn_D S Y.p; have hh(U:Scree.Hub (mid P B)): coverNumber Y.p.B (moveHub H U).val.2= coverNumber Y.p.B U.val.2:=by
      let B:= (boxA H).symm; change coverNumber _ (U.val.2.map (boxA H).symm.toEmbedding) =_; rw [Finset.map_eq_image]; refine Push.Local.cover_map B ?_ _ U.val.2; intro x y; change separation (B x) (B y)= separation x y; unfold B; rw [←sitU]; apply sitT -- tune 
   symm; apply Eq.symm; apply Finset.eq_of_subset_of_card_le; · exact fun j p=>by obtain ⟨i,v,rfl⟩:=Finset.mem_image.mp p; refine mem_filter.mpr ⟨mem_univ _,?_⟩; unfold Short; rw [hh]; exact (mem_filter.mp v).2
   rw [card_image_of_injective U (Haro.pure_s _)] -- tune rw goal U defeq
 have hx:StackL (clan_X j Y) (dawn_D S Y.p)=0:=by
    apply Finset.sum_eq_zero; intro i p; rw [hv]; ext u v; unfold orbitPH; rw [Matrix.of_apply,Prism.port_eq]; split; rfl; simp [Pastry.crumb] -- inspect simp
 rw [hx]; have hz : heroP (0: Op (Single (mid P B)))=0:=by
    unfold heroP Haro.loft Haro.tapH matPH; funext p; apply sum_eq_zero; intro i _; simp [Scroll.tap] -- tune
