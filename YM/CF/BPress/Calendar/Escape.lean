lemma post {X:P.Between d J.n}(A: X.n ≤ (mid m B).val) : Wish (launch X T) P.H (First V) (Second V):=⟨(P.ν.speed _ W.health (tGr.trans (min_le_left ..)) (X.care.ok.trans A)).1,binderT M⟩ -- syntax
