abbrev limit (Y: Earning X)(x:ℝ):= Perk.κPort Y.Ξ (radiusB x)
abbrev stipend (Y: Earning X)(x:ℝ):= Dust.dustC Y.Ξ (g x) (peakZ R.L x) (radiusB x)
def treasure (Y:Earning X)(x:ℝ):= Perk Y.Ξ (radiusB x) (limit Y x) (g x) (peakZ R.L x)
lemma broad : (∀ᶠ x:ℝ in atTop, treasure Y x)∧ NPL (stipend Y)∧PL (fun x=> (limit Y x)⁻¹):=by obtain ⟨a,b,c⟩:=Perk.harvest _ leafC (leaf_pos.mono fun i p=>p.le) Y.Ξ; exact ⟨c,b.const_mul 3,a⟩
lemma rate_pos(y:ℝ) : 0 < limit Y y:=by have ht:= Y.Ξ.pos; unfold limit Perk.κPort; exact div_pos (lt_min (Spark.beam_p _) (half_pos ht)) (by norm_num) -- tune
