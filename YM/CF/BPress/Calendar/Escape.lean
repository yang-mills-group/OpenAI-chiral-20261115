lemma horoscope (L: Wish (launch X T) P.H (First V) (Second V))(h_: treasure Y x)(u: height Y≤h)(v:T.p.supportExponent=1)(p':T.p.B=radiusB x): ∃ f: Edition (launch X T), Passports (launch X T) T (drama U T) L f (value Y) (p/2) Y.t (g x) (limit Y x) (stipend Y x):=by
 let V':=launch X T; let u0:= scope_I M.close; obtain ⟨K,e,G⟩:=Y.able; obtain ⟨s⟩:=Primary.Book.books L G (show Pec.Lac T.J.I _ _ from u0.2) e; obtain ⟨z,v0⟩:=Y.choir m T M.rest; let P':= show Stellar V' Y.tender Y.voice T.J.I from ⟨s,z⟩; have h:0≤ h:=zero_le_one.trans ((star_le Y.Ξ).trans u); have he:= M.coverR _ _ _ h; obtain ⟨x',k⟩:=accounting (Beta V') V'.decks Y.Ξ P.H (payA P.H (First V) (Second V)) (stream 1) highPrice Y.wax (wish V' L) (show Perk Y.Ξ T.p.B (limit Y x) (g x) (peakZ R.L x) from p'.symm ▸ h_) he (hush_h M.mint h) u v; refine ⟨Passports.castP L P' x' (g x),?_⟩; rw [stipend,show radiusB x= _ from p'.symm]; -- danger rewriting affects `p`, H. use suff.
 exact Passports.settled L P' x' k G v0 Y.mono -- tune arguments
