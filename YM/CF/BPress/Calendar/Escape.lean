def highPrice :Pledge:= Sight.price (max 1 priceTone)
include P in
lemma p_pearl (s:p≤ W.pearl.q): p/2 < U.p:= (by have ht:P.qX>0:= P.pre; exact (show p/2<p from by linarith [P.slack]).trans_le (s.trans (W.pearl.roof.trans U.small))) -- tune include P
lemma payPe (s:p≤ W.pearl.q): P.qX < W.pearl.q:=by apply P.slack.trans_le; exact (half_le_self (by linarith [P.slack,P.pre])).trans s
def jewel (W:GivenX V U):Pledge:= ⟨levelQ W.C,cashU W.C,level_p W.C,W.C.posB.trans_le (le_max_right ..)⟩
structure Earning where
 tender:Pledge
 Ξ:Pledge
 able :∃ Y:Pledge,Primary.Fare.bought (Y.plus (ζPearl (jewel W))) tender∧ Shale.Grant Y P.H (payA P.H (First V) (Second V)) (stream 1) highPrice X.R X.ε Tenant.quota
 wax : ∀ {N:Side}{D:Type}[TopologicalSpace D]{F:Form N D}, Treasury F P.H (payA P.H (First V) (Second V)) (stream 1) highPrice Ξ X.ε X.R
 t:ℝ -- max allowed Shell (margin may use $p$ above)
 voice:Pledge
 ktest:ℝ
 mono: Shell.plot (p/2) U.p d t ktest
 choir (M:Side)(Y:GramM (mid M B)): U.roundZ ≤ (mid M B).val→∃ H: Hymn M B d U.p,Solo H (drama U Y) ktest voice.rate voice.price
private lemma shellP (u: ℝ)(v:1≤u): ∃ V:Pledge, ∀ (M:Side)(Y: GramM (mid M B)),U.roundZ ≤ (mid M B).val→ ∃ H:Hymn M B d U.p,Solo H (drama U Y) u V.rate V.price:=by
 obtain ⟨C,p,H⟩:=launder U 1 u v; refine ⟨⟨Jet.radF U,C+1,Jet.rad_pos U,by linarith⟩,fun M Y t=>?_⟩; obtain ⟨T,g⟩:=Solo.voiceSpin (H M t Y.J.M); exact ⟨T,⟨g.duet,g.bills.weaken (by linarith : C ≤ C+1),g.prime⟩⟩ -- tune Cash lemma name
lemma escape (f:p ≤ W.pearl.q): Nonempty (Earning X):=by
 obtain v:= solid.1.trans_le X.care.supportK; obtain t:= X.care.grant; obtain u:= X.care.alive; obtain ⟨Y,y⟩:= Shale.lease X.R X.ε Tenant.quota u X.care.small Form.paid v.le t P.H (payA P.H (First V) (Second V)) (stream 1) highPrice -- tune binder order includes ε d explicit
 obtain ⟨Q,k⟩:= Primary.Fare.purchase (Y.plus (ζPearl (jewel W))); obtain ⟨O,o⟩:= prechoice P.H (payA P.H (First V) (Second V)) (stream 1) highPrice u v.le t; obtain ⟨T,b,g⟩:=Shell.grows W.health (p_pearl (P:=P) f); obtain ⟨φ,z⟩:= shellP (U:=U) _ g.bill; exact ⟨⟨Q,O,⟨Y,k,y⟩,o,T,φ,b,g,z⟩⟩
