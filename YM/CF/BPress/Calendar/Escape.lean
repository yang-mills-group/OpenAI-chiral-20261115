lemma leafC : NPL (peakZ s):=by
 have p :NPL (SectorNext.Remainder.Scales.g SU.group s):=⟨fun k=>by simpa only [pow_zero,mul_one,lscale,SectorNext.Remainder.Scales.b] using SectorNext.Remainder.Scales.tally_g SU.group s k 0⟩; exact p.mul npl_temp.pl
lemma leaf_pos : ∀ᶠ y:ℝ in atTop,0<peakZ s y:=( (eventually_gt_atTop (0:ℝ)).and ((SectorNext.Remainder.Scales.year SU.group s).eventually_gt_atTop 0)).mono (fun _ t=> mul_pos (SectorNext.Remainder.Scales.gauge SU.group s t.2) (temp_pos t.1)) -- tune explicit binder h y
