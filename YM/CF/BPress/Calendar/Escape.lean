lemma born_t {c:ℝ}(u:0≤ c)(H: StageC P.tone P.qH X.δ X.z (era X x) c)(k0:Dusk (era X x) Q X.z)(S: Stamp A Q (exhibit X C) (launch X T)): Born A Q (exhibit X C) (launch X T):=⟨S,fun z=>refLicence z A X.z Q X.book (H.drop _ u) k0 C,W.health.le,P.ν.above⟩ -- tune
lemma land (g:X.age≤(mid m B).val)(S:Born A Q (exhibit X C) (launch X T))(U:Dusk (era X x) Q X.z)(L:Wish (launch X T) P.H (First V) (Second V)) : Huon.Pilot.Banner S X.widthM X.strength:= by
 have h := X.wide.trans U.summer; unfold Hazel.Warm at h; exact ⟨X.wage,fun z l=> (X.bias z l).power g (B:=era X x) (A:=A) rfl (by omega) S rfl rfl L.pen⟩
