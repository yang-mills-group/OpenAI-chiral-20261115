lemma oph_V: FΘ =fun _ _=>0:=by
 funext ⟨p,q⟩ c; unfold Jade.loam blazon; split; swap; rfl
 apply Subtype.ext; rw [vig_all]; let g:= (Stake.Grit D_ uF P_ w' (p,q) c).stageT x H.post (subtK (r:=r) S i); have hx:g.voice=0:=congrArg Subtype.val (can_a V F Z U W P_ H uF w' D_ c q p i eQ)
 change Scion.reconL.symm (Scion.tempo g) O= (0:FC _); rw [show Scion.tempo g=0 from ?_,map_zero]; rfl
 funext j; unfold Scion.tempo; split; swap; exact rfl
 rw [hx,map_zero,LinearMap.zero_apply,zero_mul]; rfl
include vU
lemma still : I'=0:=by
 funext x; by_cases h: Rue.Gates (Rue.litres Xs.p.threshold (Stilo.bay O) (penn S (subtK (r:=r) S i)).flags) (Stilo.bay O) x.1; swap; · exact vU.wherep x h
 obtain ⟨U',t,y⟩:=h; let X:Orbit (mid N B):= (U',x.2); have hy:= vU.levy x X y (fun i _=> rfl); have hp:=vU.visor X t; rw [oph_V V F Z U W P_ H uF w' D_ i O eQ] at hp; exact hy.trans (hp.symm.trans (integral_zero ..))
