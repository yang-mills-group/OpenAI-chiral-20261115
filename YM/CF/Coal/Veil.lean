lemma can_a : (G' U').bodyL x H.post (subtK (r:=r) S i)=0:=by
 unfold Eire.Dress.bodyL Eire.lure; rw [Feu.husk_p S,prod_singleton]; change sheer S x Y _ _ _ _ _ _= _; unfold sheer; dsimp only; split; swap; rfl
