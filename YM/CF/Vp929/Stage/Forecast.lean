 apply philosophical T.toFocus Ty Vq hv T.fair (show Present (w:=w) (K:=K) S b A (εLeaf R.L x/3) nₐ (dwidth R x) x h p' from ⟨hP,hB,fun v t=>⟨T.ledge _ (u v t).1, (u v t).2⟩⟩) _ hs; have he:= T.deemed.leads; have ht:εLeaf R.L x/3≤(taxP).s:= ((le_mul_of_one_le_left (by linarith [T.buy] :0≤ εLeaf R.L x/3) (by linarith [T.deemed.lend.spanK] :1 ≤ (taxP).length+2))).trans T.deemed.lend.scale; exact le_trans (mul_le_mul_of_nonneg_left ht (by norm_num : (0:ℝ) ≤ 6)) he
