lemma chartμ {S:Set ℂ}(b:ℂ→ℂ)(A:ℂ→Pair (Corr η))(W:Arcμ x h p' w K S b A): Queries S (fun z=> Ωk (b z) (A z)) ∧ Census S (fun z=> PE (b z) (A z)) ∧ Query (fun _=>Set.univ) S (fun z=> PA (b z) (A z)):=by
