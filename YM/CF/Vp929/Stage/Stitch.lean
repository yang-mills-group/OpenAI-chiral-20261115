 refine ⟨I,fun i D s=>⟨?_ , ?_⟩,fun i=> Uℓ i,fun i=>?_⟩
 · unfold I; split; next h=> subst D; exact H i
   next h=> exact K _ _ (mem_filter.mpr ⟨mem_univ _,nonempty_iff_ne_empty.mpr h,s⟩)
 · exact Seed.livings i t.seed D s
 rw [show Vow.hymn I=Vow.hymn X from ?_]; exact W _; funext i; refine sum_congr rfl (fun j p=>?_); exact if_neg (Finset.Nonempty.ne_empty (mem_filter.mp p).2.1)
