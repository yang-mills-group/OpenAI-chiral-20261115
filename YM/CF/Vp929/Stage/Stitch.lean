 obtain ⟨M,X,H,X'⟩:=x; obtain ⟨L,U,T,T'⟩:=y
 refine ⟨M+L,fun i D v=>?_,fun i=>?_,fun i=>?_⟩
 · have ht:= moveFr z (U i D v); rw [t,one_mul] at ht; exact tray_add (X _ _ v) ht
 · change tallB (urnL M+urnL L) _ _ _ ≤ _; rw [tall_add]; exact add_le_add (H i) (T i)
 rw [show Vow.hymn (M+L)= Vow.hymn M+Vow.hymn L from funext fun i=>by unfold Vow.hymn; simp_rw [Pi.add_apply,sum_add_distrib],tall_add]; exact add_le_add (X' _) (T' _)
