lemma staple : ∀ᶠ x in atTop,∀ (N0:ℕ),n₀+1 ≤ N0 → ∀ (m n:Side) (w:Location (R:=R) B m n)(p p':BudgetPoint)(o:Pitching w D x)(Z0:Cellar N0 o p p' c (allF R.L x) ag Cg), Birthdays (R:=R) p x J.roomX ∧ Cease p (V.L.path (w.lag+1)) K.top.clip Aχ Γχ K.below.width K.below.paths V.W.bar (Scree.mid m B)∧ ∀ (r:ℝ)[Nonempty (ΘS r)],0<r→Nonempty (Stakehouse (V:=V) (h:=h) p J w b0 b1 b2 r):=by
 let G:= D.room; have he:0< J.roomX:= J.ht.trans_le D.room
 obtain ⟨a,b,X⟩:= Rill.cozy 6 he; have hb:K.below.clip.direct ≤ 1:=by rw [V.L.below]; exact s.direct
 filter_upwards [purse_K HI Hq hb,Work.E01.radiusB_tendsto.eventually_ge_atTop (J.n + 15 + cipherK J.n), (sizeK.tempo R.L).spine.eventually (ge_mem_nhds X.peta), (Scales.year SU.group R.L).eventually_gt_atTop 0] with x S hv P h' N0 n1 m n w p p' o u0
 have lo:= (u0.request).boot; obtain ⟨tQ,vQ,hD,hz,hV⟩:= S; obtain ⟨P₁,v,X₁⟩:= let_X HI x; change _=6 at P₁; change _=2 at v; change _=1 at X₁; have Q:p=epoch x:= bud_y p _ (lo.power.trans v.symm) (lo.order.trans P₁.symm) (lo.exponent.trans X₁.symm) (lo.threshold.trans tQ.symm) (lo.B.trans vQ.symm)
 have H:p.B=radiusB x:=lo.B; have Z:6 ≤ p.B:=by omega
 let k:Birthdays (R:=R) p x J.roomX:= ⟨lo.order,Q,Z,he,h',by omega⟩
 have hx:κs=K.below.clip:= by rw [V.L.below]
 refine ⟨k,originate (Z0:=u0) s (by rw [Q,hx]; exact hD) (by rw [Q,hx]; exact hz) (Q.symm ▸ hV) Z, fun r _ p=> ownX (Z0:=u0) s pH p n1 k (by omega) (by omega) (lo.order.symm ▸ X) (lo.threshold.symm ▸ P)⟩
