 let q:= Z0.request
 let X:= Xs (Scales.y SU.group R.L x)
 have hu:= (q.sound).leanJ.1; rw [W.h2,W.h4,W.h1,W.h3] at hu
 obtain ⟨T',l,e⟩:= Cour.demand _ V.pos1.le V.pos2.le _ hu w.output.M
 have h:= he.number
 have H: n₀ ≤ (Scree.mid m B).val:=by have ht: n₀*2 ≤ _ := Nat.mul_le_mul (Nat.le_trans (Nat.le_add_right n₀ 1) hN) h; have hs:= ht.trans q.size; change _ ≤ (Scree.mid m B).val*2 at hs; omega
 obtain ⟨K_,pK⟩:= s.forms T' (Scree.mid m B) r0 J.roomX v H he.pleasant pH
 have hp:= rise_F V s.k U W X q.sound Z0.toLid.still.size T' r0 l e J.hr.le
 have hρ:= mul_le_mul_of_nonneg_right s.mind.fresh v.le
 obtain ⟨O,F,t⟩:= laurel_h hp pK v s.pen hρ
 exact ⟨T',l,e,⟨q.rocket.paid,he.pleasant,D.high,q.pole,ξ0,ξ1,k,vk,hh,H_, Nat.le_trans (by decide : 3 ≤6) he.ballast, by rw [q.boot.power]; decide, fair_P K_,hp,s.pos,s.pen,O,F,t,hρ⟩⟩

