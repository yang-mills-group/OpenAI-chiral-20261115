def baseOffset (b:ℝ)(F:Corr ηt):ℂ:= if h:Sch b (F,0) then (s.robe_s h).2.2.2.2.choose else 0
abbrev operate : Operation ι ηt:= ⟨s.RepCorr,s.RepΔ,(fun b F x=> s.baseOffset b F+x),fun b G=>(s.pickW b (G,0)).1⟩
local notation "Ax0"=> s.operate
lemma RepReal (p0:Sch Bβ XG)(v:ℂ):let A:=s.operate; let X:=A.output V w p β G v; Canonical Shf X K.j ∧ Launch p p' w U q J.d (A.realArr β G) G β (A.posted β G) v (A.offset β G v) (A.wave β G) ∧  (A.arrays Bβ XG).2=0 ∧ (A.Δ Bβ XG).im=0 ∧ |(A.offset β G v).re-v.re| ≤ κZ:=by
 intro A X; obtain ⟨a,z,k,qa,x⟩:= s.robe_s p0
 obtain ⟨c,c'⟩:= (s.careτ p0).1.1.crown
 let t:= s.baseOffset β G; have ht:t=(s.robe_s p0).2.2.2.2.choose:=by unfold t baseOffset; rw [dif_pos p0]
 have Pz :=(s.robe_s p0).2.2.2.2.choose_spec; rw [←ht] at Pz; let r:Launch p p' w U q J.d (A.realArr β G) G β (A.posted β G) v (A.offset β G v) (A.wave β G):=(by simpa only [zero_add] using Pz.1.adjust v)
 exact ⟨⟨c,c'⟩,r, Prod.ext qa k,z, (by change |(t+v).re-v.re|≤ _; rw [Complex.add_re,add_sub_cancel_right]; exact Pz.2)⟩
lemma taxed (p0:Sch y F){d:ℝ}(x0:s.maxU ≤ d)(j0:s.maxV≤ d): Both (fun P=>Charged p w.output K.j R.L.val h d P) (s.operate.arrays y F) :=by
 obtain ⟨t,u⟩:= (s.careτ p0).1; obtain ⟨v,q⟩:= s.maxL_E p0; exact ⟨⟨⟨ Fixed.Voltage.upgradeI _ _ t.house.tax x0, Fixed.Voltage.upgradeD _ _ v j0⟩, t.house.theme,t.warped⟩, ⟨Fixed.Voltage.upgradeI _ _ u.house.tax x0, Fixed.Voltage.upgradeD _ _ q j0⟩,u.house.theme,u.warped⟩
