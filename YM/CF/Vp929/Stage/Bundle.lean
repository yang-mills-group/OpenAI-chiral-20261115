private lemma Ω0 : s.pA 0=0∧s.hood 0=0∧s.hoodZ 0=0:= ⟨s.LogicA.dormant,funext fun i=>funext (fun x=>(s.logic_X i x).dormant), funext fun i=>funext fun D=>funext fun V=> (s.logic_Z i D V).dormant⟩
