lemma robe_s (p0:Sch Bβ XG): let b:=s.standby Bβ XG; let Δ:=Θχ Bβ XG; let F:= τE Bβ XG; let R:=zZ Bβ XG; Dark Utrue R.1 p h s.maxV ∧ Δ.im=0∧ R.2=0∧ F.2=0∧ ∃v:ℂ,Launch p p' w U q J.d (F.1,R.1) G β Δ.re 0 v Λχ.1 ∧ |v.re|≤ κZ :=by
 intro i Δ F R; let r₀:= i.1; obtain z: i=rePoint r₀:= s.real_I (s.sleepsW p0).1.1 (s.real_pick p0); have hi':sunny (rePoint r₀):= z ▸ s.homely p0
 let E:=s.pF Bβ XG; let U:=s.gear Bβ XG; let Q:= s.pA E.1
 obtain ⟨r,_,_,_,_,_,x0,x1,x2,hb,-⟩:= house_real (A0:=s.A0) s.qL s.s s.Th s.S0 s.Ty s.coin.full p0 r₀ hi'
 rw [←z] at x0 hb; change E.2=0 at x0
 have pZ: (s.pF Bβ XG).2=0:= x0; have hz':s.τz Bβ XG=Zβ (rePoint r₀) Bβ XG:= congrArg (fun i=>Zβ i Bβ XG) z; have h0: U=(U.1,0):=Prod.ext rfl (show U.2=0 from (congrArg s.hoodZ x0).trans s.Ω0.2.2); have ht:makeK (A0:=s.A0) (Lp:=s.Lp) s.Ty Bβ (rePoint r₀) XG (U.1,0)= R:= (by rw [←z,←h0]; rfl)
 have H:Δ.re=(Zβ (rePoint r₀) Bβ XG).re-Q:= by unfold Δ RepΔ; rw [hz',Complex.sub_re,prob_re,prob_re]
 obtain ⟨pp,pR,xζ,v,t'⟩:= movie_pass s.qL s.s s.Th s.S0 s.Ty s.coin s.pH s.Mp r₀ hi' p0 (s.hood E.1) U.1 Q (s.careτ p0).1.1.piece.delivers (s.feeQ p0).1 (s.careτ p0).1.1.piece.zealed
 rw [ht] at pp v t'
 have he: r₀.val=Λχ.1:=congrArg Prod.fst (intent0 Λχ (mem_ball_zero_iff.mp (s.half_room (s.sleepsW p0).1.1)).le)
 refine ⟨pp,?_,v, ?_,?_⟩
 · unfold Δ RepΔ; rw [hz',Complex.sub_im,xζ,prob_im,pZ,s.Ω0.1,sub_zero]
 · change E.2+s.hood E.2=0; rw [x0,s.Ω0.2.1,add_zero]
 obtain ⟨bp,eh,hc⟩:=t'; refine ⟨bp,?_,hc⟩
 rw [H,←he]; change Launch p p' w _ _ _ (F.1,R.1) G β _ 0 bp r₀.val;
 have hpz:F.1=(VE (rePoint r₀) Bβ XG).1+s.hood E.1:= by change (VE i _ _).1+s.hood E.1=_; rw [z]
 rw [hpz]; exact eh
abbrev RepCorr (b:ℂ)(F:FL):= (((s.RepE b F).1,(s.RepK b F).1),((s.RepE b F).2,(s.RepK b F).2))
lemma RepTrail {F:ℂ→Pair (Corr (mid n B))}{b:ℂ→ℂ}(A:Arcμ x h p' w K S b F): HoloCorr S (fun z=> s.RepCorr (b z) (F z))∧ DifferentiableOn ℂ (fun z=>s.RepΔ (b z) (F z)) S :=by obtain ⟨u,t,q⟩:= s.move_ζ A; exact ⟨⟨u,q⟩,t⟩
lemma maxL_E(p0:Sch y F): Both (fun T=>Dark Utrue T p h s.maxV) (s.RepK y F):=by

 let u:= movie_wake (A0:=s.A0) s.qL s.s s.Th s.S0 s.Ty F s.coin s.pH _ (s.homely p0) p0 (s.feeQ p0)
 obtain ⟨Z,f,G,i,v,pD,g,l,m,b,t,xA,-⟩:= Pitching.Focus.travel h _ (s.homely p0) y F p0 (dr).floor; let k(z):=s.RepK (f z) (G z); have ht:k Complex.I=s.RepK y F:=by unfold k; rw [t,xA]
 let A:Arcμ x h p' w K Z f G:=⟨v.openT.cover,pD,g,fun z p=>(b z p).2⟩; refine ht ▸ screen_true v.openT (s.move_ζ A).2.2 v.openT.comet ?_ (show Both (fun T=>Dark primeU T p h s.maxV) (k Complex.I) from ht.symm ▸ u)
 intro x e; change Both _ (k x); let X:=G x; have hm: k x=s.RepK ((f x).re:ℂ) (X.1,0):=by
    obtain ⟨h,h'⟩:= v.form x e; exact congrArg₂ s.RepK (Complex.ext rfl h') (Prod.ext rfl h)
 have hh:Sch ((f x).re:ℂ) (X.1,0):=
    by
       obtain ⟨u,v'⟩:= v.form x e; rw [show ((f x).re:ℂ)= f x from (show f x=((f x).re:ℂ) from Complex.ext rfl v').symm,show (X.1,0)=G (x:ℂ) from (Prod.ext rfl (Eq.symm u))]; exact (b x e).2
 obtain ⟨AXp,htr,A',-⟩:= s.robe_s hh; rw [hm]; refine ⟨AXp,?_⟩; rw [A']; exact Fixed.Voltage.upgradeD p Utrue (Vale.lye Utrue p h).2 (Display.coin (darkest_Team (dr).floor) _ _ AXp)
