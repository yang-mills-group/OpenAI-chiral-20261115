lemma replant {Gd: IT→ Cipher ι} (Y:GramM η) {M:IT→ Mt}(T: ∀ i,Dress w.G S' d z' (20*radiusB x) (M i) Y Δ Θ)
 (q':0∈ tsupport (Uκ))
 (e1 : ∀ i:IT, let z:=(Aq.list K0).toFinset; let Hκ:= (Ω' i).stageT x o.muster.post z; let B:=(T i).stageT x o.muster.post z; B.knots=Hκ.knots ∧ B.voice=Hκ.voice ∧ B.rhythm=Hκ.rhythm)
 (hyp:∀ i∈ Aq.list K0, Woody 6 (Aq.plank K0 Y T i) 0 (Wq i))(g:∀ᶠ i in 𝓝 (0:IT), Gd i=vigor ((T i).stageT x o.muster.post (Aq.list K0).toFinset) O): Aq.PlantP K0 O Wq Gd:= by
 let u':= Classical.choice (Z.voteP hF hb)
 have m:= (Aq.rake u' K0 O U₁ F' ArK T' Z hb hF ts speed height subv zF U0 q').1
 let f(i:IT): Mg:= (T i).stageT x o.muster.post (Aq.list K0).toFinset; let B(i:IT): Mg:= (Ω' i).stageT x o.muster.post (Aq.list K0).toFinset
 refine ⟨f,⟨?_,?_,?_,?_⟩,g⟩
 · rw [funext (fun i=> show (f i).knots=(B i).knots from (e1 i).1)]; exact m.transit
 · rw [funext (fun i=> show (f i).voice=(B i).voice from (e1 i).2.1)]; exact m.omega
 · obtain ⟨y',p,z⟩:=m.eta; exact ⟨_,p,fun i hi=> (Eventually.of_forall (fun x=>show (f x).rhythm i=(B x).rhythm i from congrFun (e1 x).2.2 i)).and (z i hi)|>.mono (fun i v=>v.1.trans v.2)⟩
 refine ⟨((Aq.list K0).map (Aq.plank K0 Y T)).prod,wphys ℓ Wq (Aq.plank K0 Y T) hyp,fun i hi=>?_⟩; exact Eventually.of_forall (fun v=> (Yaw.fields_b Θ (Aq.Lk K0) (Aq.Lr K0) (Aq.Lw K0) Y M T (Aq.nubK K0) (Aq.axe K0 O U₁ F' ArK T' Z hb hF ts speed height subv zF U0 q') (Aq.nubW K0) v).symm)
