-- If no quorum of Sat exceedances, can pay zero. Implementation: in PlantP set one body to zero (via multiplication by an erasure indicator); beam output rate then ≤0.
def eraseSat (St: Sat S'): F₁→ℝ := fun i=> if i=ignite St then 0 else 1
local notation "βE"=> eraseSat (w:=w) (V:=V) (D:=D) (x:=x)

lemma clear_p (i:Sat S')(j:F₁) : 0 ≤ βE i j:= by unfold eraseSat; split; exact le_rfl; exact zero_le_one
include u Z hb hF
lemma free (h₀:0≤ Wq) (i:Sat S')(hi:i∈ Wray.steep ℓ)(hq: 0∈ tsupport G → Aq.PlantP K0 O (fun j=>βE i j • Wq j) G): Woody 6 (fun x=>(G x).val) 0 0:=by
 let S:= fun j=> βE i j • Wq j; have u':0≤ S:=fun j=>smul_nonneg (clear_p i j) (h₀ j); obtain ⟨K,p,v,t⟩:= Aq.power u S K0 (Z.full β hb F hF).fire u'
 have ht:rateT Xp K≤0:= by
   apply v.trans_eq; change payH (dawnT _ _ _ _ _ (fun j=>βE i j • Wq j)) ℓ=0;
   rw [pay_dawn_price,List.prod_eq_zero_iff.mpr (show (0:ℝ)∈List.map (βE i) (Aq.list K0) from List.mem_map.mpr ⟨ignite i,(iced ℓ i).1 hi,if_pos rfl⟩),zero_smul]
 refine (t E O G hq).mono (fun j=>?_); apply le_of_not_gt; intro v; apply (not_lt_of_ge (ht O)); exact sum_pos' (fun j _=>mul_nonneg ((stokes (zero_le_one.trans D.high)).fee _) (p _ j)) ⟨j,mem_univ _,mul_pos (pow_pos (zero_lt_one.trans_le D.high) _) v⟩
