 · rw [Set.indicator_of_mem h]; apply P.well; intro t; have ht':= Aq.rose K0 Ot U₁ F' ArK T' Z hF M hp r S ht pB lv he U0 (fun _=>1) (g t) (fun i v j=>?_)
   · simpa only [one_smul] using ht'
   · rw [one_smul]; exact (S j).pension _ (Z.toLid.crew _ (ease hp r j)).1 i

 rw [Set.indicator_of_notMem h]; change ¬(∀ i∈satTokens K0, Bravo Ξ i T'.2.1.2 (luceL R c.blips x/2)) at h; obtain ⟨i,v,t⟩:= (not_forall.mp h).imp (fun i=>fun g=> Classical.not_imp.mp g)
 let u':= Classical.choice (Z.voteP hF (led hp)); apply Aq.free u' K0 Ot Z (led hp) hF Lp Zκ (Aq.deck_pos S Z hF (ease hp r) (zero_le_one.trans M.weather.positive) zero_le_one) i (Aq.steep_k K0 ▸ v)
 intro h; apply Aq.rose K0 Ot U₁ F' ArK T' Z hF M hp r S ht pB lv he U0 (eraseSat (x:=x) i) (g h)
 intro a e j; apply (S j).denied (Aq.monkG K0 U₁ (Z.peer (ease hp r j) T')) (Z.toLid.crew _ (ease hp r j)).1 _ a; intro h; exact t (towardS _ _ _ h (Z.toLid.scaling_p (ease hp r j)) (Z.toLid.rune_enroll (ease hp r j)).2)
theorem lien : ∃ T, Lien Aq p κ 0 bκ (τB/2) c (fun t P=>Z.pattern t P hF z (Β z)) T := by
 let S(r:ℝ)(i: VolumeRate.panel nₐ): Vote o (pillar nₐ z t r i) c:= Classical.choice (Z.voteP hF (ease hp r i))
 let W:= Classical.choice (Z.voteP hF (led hp)); have w':= (Z.toLid.crew _ (led hp)).1
 choose X Uv using fun r:ℝ=> Aq.pledge (Aq.deck Bv (1/8) (S r) 1) w' W (Aq.deck_pos _ Z hF (ease hp r) (zero_le_one.trans M.weather.positive) zero_le_one)
 have u:0<bκ:= discount_pos M.patron
 have ps:= M.payment; rw [← Fintype.card_coe] at ps
 haveI := Ledge.neBot (z:=z) M.lane
 obtain ⟨Y,e,Wv⟩:= Merit.basis (u:=X) (s:=centers z t) (fun r=> Aq.invoice (S r) Z hF (ease hp r) M.purse M.step ps (zero_le_one.trans M.weather.positive) (by exact zero_add (1/8)) u _ (Uv r).nonneg (Uv r).bill) (fun i=>mul_pos (Aq.prize_pos _ _) (pow_pos u _)) (fun i=>pow_pos (zero_lt_one.trans_le D.high) _)
 refine ⟨Y,Wv,?_⟩; intro K0 O Uz F' Au Su O' Lw_ t' s z₀ F u
 apply Merit.converged (s:=centers _ _) (hc:=fun U:Ωs=> (earnS o c K0).indicator (fun _=>U K0 O) Su) _ e
 · let G := path K0 O' Uz F' Au Su Z hF z (Β z)
   by_cases R:0∈tsupport G
   · filter_upwards [support_t K0 O' Uz F' Au Su Z hF hp R] with r rr; exact Aq.petals Z hF M r K0 O Uz F' Au Su hp (S r) (X r) (Uv r) t' s z₀ F u (fun _=>rr)
   exact Eventually.of_forall fun r=> Aq.petals Z hF M r K0 O Uz F' Au Su hp (S r) (X r) (Uv r) t' s z₀ F u (fun h=> (R h).elim)
 · by_cases p:Su∈earnS o c K0; simp_rw [Set.indicator_of_mem p]; fun_prop; simp_rw [Set.indicator_of_notMem p]; exact continuous_const
