private abbrev solar (F:LΛ) := sunY (RP) Xi0 (fun p:(Roc (Scree.mid n B)× Aura (Scree.mid m B))=> ∑ i:Ξm with i.1=p.1 ∧ i.2.1=p.2,F i)
private abbrev sunrise (F:LΛ) := sunY univ (EpR (N:=mid m B) x) (fun t=> ∑ i:Ξm with lift_I i=t,F i)
/- Additional regular (after writ) & mark. They are truly linear. -/
abbrev radix (A:A₂) : RegBudget ι:= writP (sunrise (x:=x) (S0 A) - solar (o:=o) (S0 A))
abbrev gyre (L:LΛ) : Cusp (Scree.mid m B):= soot_T univ ref_A (ref_B x) (ref_Q x) (oV ∘ L)
abbrev rose(A:A₂) : Cusp ι:= writY (gyre (x:=x) (S0 A))
local notation "fx"x:max=> radix (p:=p) (p':=p') (o:=o) Vq x
local notation "gx"x:max=> rose (p:=p) (p':=p') (o:=o) Vq x
private lemma sunrise_sub (F G:LΛ): sunrise (x:=x) (F-G) = sunrise (x:=x) F-sunrise (x:=x) G:=by funext i; unfold sunrise sunY; simp only [Pi.sub_apply,sum_sub_distrib]
private lemma solar_sub (F G:LΛ): solar (o:=o) (F-G)= solar (o:=o) F-solar (o:=o) G:=by funext i; unfold solar sunY; simp only [Pi.sub_apply,sum_sub_distrib]
lemma radix_sub (A B:A₂) :fx (A-B)=fx A - fx B:=by unfold radix; rw [sun_sub,sunrise_sub,solar_sub]; simp_rw [map_sub]; abel
lemma radix_smul (A:A₂)(t:ℝ) : fx (t • A)= t • fx A:=by
 have ht(F:LΛ): sunrise (x:=x) (t • F)= t • sunrise (x:=x) F:=by unfold sunrise sunY; funext w; simp only [Pi.smul_apply,smul_sum]
 have hu(F:LΛ): solar (o:=o) (t • F)= t • solar (o:=o) F:=by unfold solar sunY; funext w; simp only [Pi.smul_apply,smul_sum]
 unfold radix; rw [←Complex.coe_smul t A,sun_scale,Complex.coe_smul,ht,hu,←smul_sub,map_smul]
private lemma spanned (k:Aura ι)(x:Support (More ι))(p q:Copy ι): Vow.flick k (p-q) x= Vow.flick k p x-Vow.flick k q x:= by unfold Vow.flick; split; rfl; exact (sub_self _).symm
lemma rose_sub (A B:A₂): gx (A-B)=gx A - gx B:=by
 have hh(A B:LΛ): gyre (x:=x) (A-B)= gyre (x:=x) A- gyre (x:=x) B:=by
    unfold gyre soot_T; rw [←sum_sub_distrib]; refine sum_congr rfl fun i _=>?_ ; funext j T; unfold stroke chasmR; by_cases he:j=ref_Q x i; · subst j; simp only [Pi.sub_apply,Pi.single_eq_same,Function.comp_apply]; rw [show oV (A i-B i)=oV (A i)-oV (B i) from rfl,spanned,spanned]; abel
    simp_rw [Pi.sub_apply,Pi.single_eq_of_ne he, Pi.zero_apply,sub_self]
 unfold rose; rw [sun_sub,hh,map_sub]
lemma rose_smul (A:A₂)(t:ℝ): gx (t•A)= t • gx A:=by
 have heS(k:Aura ι)(x:Support (More ι))(p: Copy ι):Vow.flick k (t•p) x=t • Vow.flick k p x:=by unfold Vow.flick; split; rfl; exact (smul_zero _).symm
 have hh(A:LΛ):gyre (x:=x) (t • A)= t • gyre (x:=x) A:=by
    unfold gyre soot_T; rw [smul_sum]; apply sum_congr rfl; intro i _; funext j T; unfold stroke chasmR; by_cases he:j=ref_Q x i; · subst j; simp only [Pi.smul_apply,Pi.single_eq_same,Function.comp_apply]; rw [show oV (t • A i)= t • oV (A i) from rfl,heS,heS]; exact Eq.symm (smul_sub ..)
    simp_rw [Pi.smul_apply,Pi.single_eq_of_ne he, Pi.zero_apply,smul_zero]
 unfold rose; rw [←Complex.coe_smul t A,sun_scale,Complex.coe_smul,hh,map_smul]

lemma radix_zero: fx 0=0:= by simpa using radix_smul (p:=p) (p':=p') (o:=o) Vq 0 0
lemma rose_zero : gx 0=0:=by simpa using rose_smul (p:=p) (p':=p') (o:=o) Vq 0 0
abbrev radixLin : A₂ →ₗ[ℝ] RegBudget ι := {
 toFun:= fun x=> fx x
 map_add':= fun a b=>(sub_eq_iff_eq_add').1 ((radix_sub Vq (a+b) a).symm.trans (show fx (a+b-a)= fx b by rw [add_sub_cancel_left]))
 map_smul':= fun t X=> radix_smul Vq X t }
abbrev roseLin : A₂ →ₗ[ℝ] Cusp ι:={
 toFun := fun x=> gx x
 map_add':= fun a b=>(sub_eq_iff_eq_add').1 ((rose_sub Vq (a+b) a).symm.trans (show gx (a+b-a)=gx b by rw [add_sub_cancel_left]))
 map_smul':= fun t X=> rose_smul Vq X t }

lemma turn_L(E:RegBudget ι)(A:Cusp ι)(hp: YM.CF.Py.Lunar (H:=Up β) (Uφ:=Lz) (Y:=Ys β F) (X:=Xs β) V o.SheepR D.D Vq C' D.X D.jp Ty E A): writ_E E=writ_E (Placement o Ty Lz)+radixLin (p:=p) (p':=p') (o:=o) Vq (pennies F.1) ∧ writ_K A=roseLin (p:=p) (p':=p') (o:=o) Vq (pennies F.1):=by
 obtain ⟨f,hv,hQ,hz⟩:=hp.pay; let G:= S0 (pennies F.1); have he: f=G:=by funext i V'; apply Subtype.ext; rw [hv,birth]
 subst f; let L:= forge_P (H:=Up β) (Y:=Ys β F) (X:=Xs β) V o.SheepR D.D Vq C' D.X D.jp
 have hu(x:Ξm)(g:x ∉ L) : G x= 0 := by
    funext i; apply Subtype.ext; rw [hv, show glasp _ _ _ _ _ _ _ _=0 from not_not.mp fun t=> g (mem_filter.mpr ⟨mem_univ _,t⟩),thaw_v]; rfl
 have hm(e:Ξm→Prop)[DecidablePred e]:(∑ i∈ L with e i,G i)= ∑ i with e i,G i:= sum_subset (filter_subset_filter _ (subset_univ _)) (fun i v p=>hu i (fun tt=>p (mem_filter.mpr ⟨tt,(mem_filter.mp v).2⟩)))
 have hν (e:Ξm→Prop)[DecidablePred e] (v:Pane ι): (∑ i∈L with e i,G i v) =∑ i with e i,G i v:=by simpa only [Finset.sum_apply] using congrFun (hm e) v
 constructor
 · have hx: E=Placement o Ty Lz+(sunrise (x:=x) G-solar (o:=o) G):= by
       rw [hz]; unfold Placement EdvP sunrise solar sunY tray_R; change (fun _=>_) + (fun _=>_) = _
       funext i v; unfold L at hm hν; dsimp only [Pi.add_apply,Pi.sub_apply]; simp only [Eρ,car_A,hm,Finset.sum_apply,sum_sub_distrib,hν]; abel
   rw [hx,writ_k]; rfl
 rw [hQ]; change writ_K _= writ_K (gyre (x:=x) G); congr 1; apply sum_subset (subset_univ _); intro i u p; simp_rw [comp_apply, hu i p]; have he(X:Aura ι): Vow.flick X (oV (0:Pane ι→ Cipher ι))=fun t=>0:=funext fun j=>by unfold Vow.flick; split<;>rfl
 unfold stroke chasmR; rw [he,he]; simp; rfl
