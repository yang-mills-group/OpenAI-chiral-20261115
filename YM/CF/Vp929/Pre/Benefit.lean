abbrev slipCC (p:BudgetPoint)(A: Pair PA) := give_X p (noteD A) - (old_Q A.1,old_Q A.2)
lemma slipCC_real : slipCC p (Lz,0)= (slipP p Lz,0):= by
 rw [slipCC,noteD,show (nixV (cone_f (0:PA)))=0 from funext (fun i=>by simp [nixV,cone_f]),real_X]; refine Prod.ext rfl ?_; change _=0; simp only [Prod.snd_sub,zero_sub]; change -old_Q (0:PA)=0; simp only [neg_eq_zero]; funext i; simp [old_Q]
