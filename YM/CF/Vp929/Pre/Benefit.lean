lemma flora : let V:= noteD (AΦ z); let X:= veilG (fun z=>AΦ z) z; Both (fun F=>MonoQ p h (Τ'+1) F Υ) V ∧ Both (fun F=>MonoQ p h (Τ'+1) F Υ) X:= by
 obtain ⟨A,g⟩:=(Uq.PM_bill (p₁.merit z u).1 (A₀ z) (p₁.merit z u).2 w₀).1; obtain ⟨B,s⟩:=(Uq.PM_bill (p₁.merit z u).1 (A₀ z) (p₁.merit z u).2 w₀).2; let hp:= Young Uq (P z u).1.seed g; let ht:= Young Uq (P z u).2.seed s; exact ⟨⟨hp.1,ht.1⟩,⟨hp.2.2,ht.2.2⟩⟩
lemma market : Both (fun F=>MonoQ p h Τ' F (φ+Υ)) (spendCP (AΦ z)):= by
 let H:=flora Uq Ty hγ p₁ w₀ u P; let l:= hγ.audit Uq (show (0:ℝ)≤1 from zero_le_one) (by norm_num);
 obtain ⟨G,w⟩:= give_earns (hγ.usable Uq) D.high (hγ.ps Uq) (p:=p) (u:=Τ') (f:=noteD (AΦ z)) ⟨MonoQ.purse H.1.1 l,MonoQ.purse H.1.2 l⟩; rw [Z.request.boot.B] at G w
 exact ⟨MonoQ.sub G (MonoQ.fade H.2.1 (le_add_of_nonneg_right zero_le_one) (zero_le_one.trans D.high)),MonoQ.sub w (MonoQ.fade H.2.2 (le_add_of_nonneg_right zero_le_one) (zero_le_one.trans D.high))⟩
omit u
lemma rallied (h:IsOpen S) : Census S fun z=>spendCP (AΦ z):= by
 let V:= p₁.applied Uq w₀ h
 let H:Census S fun z=> noteD (AΦ z):= fun i v=> veilX_chart V h i ∅ (Set.mem_univ _) v
 let l:= hγ.audit Uq (show (0:ℝ)≤1 from zero_le_one) (by norm_num); refine (give_shows (hγ.usable Uq) D.high (hγ.ps Uq) ?_ h H).minus h (veilG_chart V h); exact fun z u=> ⟨MonoQ.purse ((flora Uq Ty hγ p₁ w₀ u P).1.1) l,MonoQ.purse ((flora Uq Ty hγ p₁ w₀ u P).1.2) l⟩
include u
lemma gains (Rs:Resident (m:=Scree.mid n B) S A₀ b): Both Cash.poise (spendCP (AΦ z)):= by
 refine Thorough.poiseGerm Rs.openT u _ (rallied Uq Ty hγ p₁ w₀ P Rs.openT.cover) (fun x h=>?_ )
 let H₀:= ((p₁.merit x h).2.1); let g:= P x h; obtain ⟨T,t⟩:=(Uq.PM_bill (p₁.merit x h).1 (A₀ x) (p₁.merit x h).2 w₀).1; let R:=(g.1.livelihood Uq Ty hγ t zero_le_one (by norm_num)).1
 let V:=Rs.form x h; let W:= AΦ (x:ℂ); have e: W=(W.1,0):= Prod.ext rfl ?_; swap
 · have h:b x=(b x).re:= Complex.ext rfl V.2; have ht:A₀ x=((A₀ x).1,0):= Prod.ext rfl V.1; unfold W; rw [h,ht, echo]

 change Both _ (slipCC p W); rw [e,slipCC_real]; refine ⟨R,?_⟩; have hp:= Cash.poiseSub R R; rw [sub_self] at hp; exact hp
omit u P w₀ p₁

variable {X:Pair (Corr (Scree.mid n B))}
lemma polis (U:Factory (w:=w) (K:=K) (p':=p') (nₐ:=nₐ) (t:=t) (x:=x) (h:=h) z s X)(v0: 6*s≤f) : Both (fun T=> Spirit p o T Ty) (Ψ z X) ∧ Both (fun G=>MonoQ p h Τ' G (φ+Υ) ∧ Cash.poise G) (spendCP (Ψ z X)):=by
 let F(x):= fluid z x; obtain ⟨A₁,u₁⟩:=domes Uq z X U; have h':2*(3*s)≤ f:=by linarith
 let hp:= u₁.openT.comet; let V u w:= prosperous Uq Ty u A₁ h' w u₁; let W1:= V Complex.I hp; obtain ⟨u,g⟩:= market Uq Ty hγ A₁ h' hp V; obtain ⟨W,v⟩:=gains Uq Ty hγ A₁ h' hp V u₁
 have he: z= fluid z Complex.I:= (Complex.re_add_im z).symm; have ht: X= orbital X Complex.I:= by simp [orbital]

 let k: Ψ z X= Ψ (fluid z Complex.I) (orbital X Complex.I):= congrArg₂ _ he ht; rw [k]; exact ⟨W1,⟨u,W⟩,⟨g,v⟩⟩
