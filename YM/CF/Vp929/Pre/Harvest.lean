lemma priced : ArmsK p (cone_f Lz) (pence_v p Cp h) h:= by
 refine ⟨fun i D0 h t=> pL.every Uq i u D0 t,fun i G h t=>?_⟩; refine ⟨fun q=>?_ ,fun x v=>?_⟩
 · unfold cone_f; apply sum_eq_zero; intro j wq; have hp:Θ' j=G:= (mem_filter.mp wq).2; subst G; exact (pL.spruce j i t).readV h q
