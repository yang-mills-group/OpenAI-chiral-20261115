lemma livings (Dm: Support (Domain m B))(q:Dm⊆ O.val): Stax.Lives p δ_ O Dm ((cone_f Lz) O Dm):= by
 intro i h; unfold cone_f at h; rw [Finset.sum_apply] at h; obtain ⟨j,t,v⟩:=exists_ne_zero_of_sum_ne_zero h; have ht:(Θ' j)= Dm:=(mem_filter.mp t).2; subst Dm; exact (pL.spruce j O q).lives i v
lemma course : Bake.Turf (nixV (cone_f Lz)):= by
 intro i j t; unfold nixV cone_f; rw [Finset.sum_apply,Finset.sum_apply]; apply sum_congr rfl; intro k u; have h:Θ' k=∅ := (mem_filter.mp u).2; exact (pL.spruce k i (by rw [h]; exact empty_subset _)).turf h j t
