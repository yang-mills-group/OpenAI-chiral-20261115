lemma Trefoil.mint (R:Scree.Hub (Scree.mid m B))(e:Θ' i=∅)(x:R.val.2=O.val): PressB p R (fun V=> Lz i O (V,Ty)) h (Cq (R.val.1)):= by
 let A:=g.theme; refine ⟨fun V' W p=> A.same _ _ (x ▸ p) (fun _ _=> rfl), fun V'=>x.symm ▸ A.lit _, A.keeps.comp (measurable_id.prodMk measurable_const), fun V' p=>?_,Cp i O,u.nonnegative i O,fun W v j=>?_,le_rfl⟩
 · let v:= Lattice.gauge p V'; exact (g.turf e (v,threadG p Ty) Ty|>.symm).trans (A.gaugeX (V',Ty) p)
 have ht:=Uq.high_bo i O (W,Ty) g u (e.symm ▸ empty_subset _) _ (x ▸ R.prop) j (by rw [e,sdiff_empty,←x]; exact v)
 rw [e] at ht; have he(y:tangD (Scree.mid m B)):openG p (∅:Support (Domain m B)) y=y:=by funext i; simp [openG,Lattice.halo]
 simp_rw [he] at ht; exact ht
include p₀
lemma Trefoil.worth : Vow.Medal p O.val (Θ' i) (Lz i O) h (taxV p Cp h O i):= by
 by_cases he: (Θ' i).Nonempty
 · let D₀:Force ι:= ⟨(knotD O, (Θ' i)),he,p₀⟩; let HH (V W:Pane ι)(τ ν: Ids ι) := @g.theme.same (V,τ) (W,ν)
   have hP : ForceB p D₀ (Lz i O) h (Cq (fastV O)):= ⟨HH, g.theme.lit, g.readV he, g.theme.keeps,fun V nv=> (g.lives V nv).2, fun V τ=> g.theme.gaugeX (V,τ),Cp i O,u.nonnegative i O,fun W v j=> Uq.high_bo i O W g u p₀ _ (knotD O).property j v,le_rfl⟩
   exact (rimP hP (zero_le_one.trans D.high)).2
 let e:=not_nonempty_iff_eq_empty.mp he; let Ty:=Classical.arbitrary (Ids ι)
 have eq : Lz i O = oV (fun V=> Lz i O (V,Ty)):= funext (fun V=> g.turf e V Ty); rw [e,eq]; exact rimR (Trefoil.mint Uq Ty i O g u (knotD O) e rfl) (zero_le_one.trans D.high)
