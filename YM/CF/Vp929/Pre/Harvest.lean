private lemma high_bo(o:Seat (Scree.mid m B))(l:o∈O.val)(j:Finset (Dwell (Scree.mid m B)))(p0:pingS p.threshold (O.val\ (Θ' i)) V0.1): Signs p o (fun y:tangD (Scree.mid m B)=>crumb (Β (increment V0.1 (openG p (Θ' i) y), V0.2)).val j) (Cp i O j):= by
 by_cases e:Θ' i ⊆ flags p.threshold V0.1
 · simp_rw [Rill.padP]; refine u.hoist i O V0 ?_ ?_ o ?_ j; · simpa only [bay_beam] using p₀
   · rw [bay_beam]; exact ⟨p0,e⟩
   simpa only [bay_beam] using l
 suffices H0:∀ y:tangD (Scree.mid m B), Lz i O (increment V0.1 (openG p (Θ' i) y), V0.2)=0 by
    simp_rw [H0]; exact Prism.hail ((by simp only [show crumb (0:Cipher ι).val j=0 from by simp [crumb], norm_zero]; exact u.nonnegative i O j): ‖crumb (0: Cipher ι).val j‖≤ Cp i O j)
 intro y; by_contra q; let A:= increment V0.1 (openG p (Θ' i) y); let pA:Θ' i⊆ flags p.threshold A:=(g.lives (A,V0.2) q).2; have ht:(Θ' i)∩ flags p.threshold A=(Θ' i)∩ flags p.threshold V0.1:= by
    apply flags_agree; intro eo e t; unfold A RG.increment openG; rw [if_neg ?_]; simp
    exact fun v=> Finset.disjoint_left.mp v (mem_insert_self ..) ((Corona.halo_mono (by have h:= Uq.hefty;omega) (Subset.refl _)) (Yaw.touchK _ e))
 exact e (fun x v=> (mem_inter.mp (ht ▸ show x∈ Θ' i∩ flags p.threshold A from mem_inter.mpr ⟨v,pA v⟩)).2)
