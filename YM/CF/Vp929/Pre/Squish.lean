lemma splat (β₁:ℝ)(u:(β₁:ℂ)∈ ℓ'): Both (fun x=> Yb x k) (AΩ β₁ Xu):= by
 let S:= ball (0:ℂ) (nR+1); let T (w'):= orbital Xu w'
 let U:= fun w'=>AΩ (β₁:ℂ) (T w'); have ht:0 ≤ ff/3:= (PU.1.toCost).nonneg D.high
 have hw : Present (w:=w) (K:=K) S (fun _=>(β₁:ℂ)) T s nₐ t x h p':= by
    refine ⟨differentiableOn_const _,foot _ isOpen_ball,fun x h=>⟨u,?_⟩⟩; have v:=mem_ball_zero_iff.mp h; refine ⟨Charged.mono (PU.1.add (PU.2.smul x.re (zero_le_one.trans D.high)) (zero_le_one.trans D.high)) ?_ ,(PU.2.smul x.im (zero_le_one.trans D.high)).mono ?_⟩<;> (apply le_trans _ hT.scale; nlinarith [ (Complex.abs_re_le_norm x).trans v.le, (Complex.abs_im_le_norm x).trans v.le])
 have W z h:= Ap (β₁:ℂ) _ (hw.merit z h)
 have hx (w:ℝ)(pL:|w| ≤1): Both (fun x=> Yb x b₀) (U w):=by unfold U T orbital; simp only [Complex.ofReal_re,Complex.ofReal_im,zero_smul]; exact Ab _ u _ ((PU.1.add (PU.2.smul w (zero_le_one.trans D.high)) (zero_le_one.trans D.high)).mono (by nlinarith))
 have hv:= Hp.tilt_knots B₀.coin (B₀.pA.le.trans B₀.worth) hT.spanK (U:=U) ⟨isOpen_ball,hP0 _ isOpen_ball _ _ hw,wq,W⟩ W (fun i p=>by
    rw [show (i:ℂ)/8=((i:ℝ)/8:ℝ) from by push_cast; rfl]; refine hx _ ?_ ; rw [abs_of_nonneg (by positivity)]; have p:(i:ℝ)<6:=by exact_mod_cast p
    linarith)
 let hi: U Complex.I=AΩ (β₁:ℂ) Xu:=congrArg _ (by change T Complex.I=Xu; unfold T orbital; simp); rw [hi] at hv; exact ⟨Display.grow Hp _ hv.1 B₀.yield,Display.grow Hp _ hv.2 B₀.yield⟩
lemma sewing (w0:ℝ)(u:0<w0)(ht:|zt.im|≤ w0)(bQ:∀ x∈ball (zt.re:ℂ) (5*w0), x∈ℓ')(v:(Real.log (2*wq)-Real.log (2*k))* (|zt.im| /w0)/Real.log 3 ≤ Real.log 2): Both (fun x=> Yb x (4*k)) (AΩ zt Xu):= by
 let z0:= zt.re; let S:= ball (0:ℂ) (5*w0); let b(w:ℂ):= (z0:ℂ)+w
 have hx:ff/3≤ s:= ((le_mul_of_one_le_left (by linarith [Uq.buy]) (by linarith [hT.spanK]:1≤nR+2))).trans hT.scale
 let A:Present (w:=w) (K:=K) S b (fun _=>Xu) s nₐ t x h p':=⟨differentiableOn_const _|>.add differentiableOn_id, holoCorr_const ..,fun y ty=>⟨bQ _ ?_ ,PU.1.mono hx, PU.2.mono hx⟩⟩
 swap; · simpa only [S,mem_ball,b,z0,dist_eq_norm,add_sub_cancel_left,sub_zero] using ty
 have h0(x:ℝ)(p:|x|≤ 2*w0): Both (fun x=>Yb x k) (AΩ (b x) Xu):=by
    have u:(x:ℂ) ∈ S:= mem_ball_zero_iff.mpr (by rw [Complex.norm_real,Real.norm_eq_abs]; linarith)
    have he: b x=((zt.re+x:ℝ):ℂ):=by push_cast; rfl
    rw [he]; exact splat Uq Yb G AΩ Hp hP0 Ap Ab B₀ hT PU _ (he ▸ (A.merit x u).1)
 let V(x):= AΩ (b x) Xu; let W x u:= Ap _ _ (A.merit x u)
 rw [show AΩ zt Xu= V (Complex.I*zt.im) from ?_]; swap; · apply congrArg (fun z=> AΩ z Xu) (by unfold b z0; rw [mul_comm]; exact (Complex.re_add_im _).symm)
 apply Hp.offPivot B₀.pA B₀.worth ⟨isOpen_ball,hP0 _ isOpen_ball _ _ A,wq,W⟩ W h0 u ht; simpa only [mul_div_assoc] using v
