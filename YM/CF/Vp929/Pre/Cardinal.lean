lemma grantFair : ∃ γ:ℝ→ℝ,sizeK R.L 1 γ∧ Jade.warmK γ∧∀ᶠ x in atTop,∀ p:BudgetPoint,Fair p R x (X x) (γ x) (S x) := by
 let G(x):= burnΩ x; let T (x):=1000*|G x|+ X x; let A: sizeK R.L 1 T:= ((iFX (sustain (σ':=fun _=>1) u (sizeK.mild R.L 1) pX)).scale 1000).accrue u; have ht:Jade.warmK T:= feeWarm A (pX.mono fun x t=> by unfold T; have h:=t.1; positivity)
 refine ⟨T,A,ht,?_⟩
 let v:∀ᶠ x in atTop, FeeBook (radiusB x) (T x) 1:= feeBook A ht; filter_upwards [v,pX,pS,(B₀ 1).spine.eventually (ge_mem_nhds zero_lt_one)] with x t v q h p; have u:degreePrice (radiusB x) (X x) 1<1:=v.2.trans_lt (by norm_num); have hP:0<X x:=v.1; have he:0 ≤ reserveT 2 6 (radiusB x) 1:=by unfold reserveT coin_n stilK; positivity
 refine ⟨q,h,t,?_ ,?_⟩
 · unfold value_; rw [pow_zero,mul_one]; exact mul_nonneg he (mul_nonneg hP.le (inv_nonneg.mpr (sub_nonneg.mpr u.le)))
 unfold T G burnQ; simp only [one_mul]; linarith [le_abs_self (chi_f 6 * value_ R x (X x))]
