include R u pX B₀
lemma moreLow (k:ℕ): sizeK R.L (k+1) (fun x=> moreF R x (X x) (S x)):= sustain u ((B₀ k).scale (2:ℝ)) pX
include hγ pG
lemma slack (k:ℕ) : sizeK R.L (k+1) (fun x=> shiftW R x (X x) (S x) (γ x)):= by
 unfold shiftW; simpa only [show 1+k=k+1 from Nat.one_add k] using (((feeK hγ pG).scale 2 |>.tint (B₀ k)).accrue (Nat.add_comm k 1 ▸ moreLow u pX B₀ k))
omit hγ pG B₀
lemma coinY {c:ℕ}{F:ℝ→ℝ}(pS:sizeK R.L c S)(pc:sizeK R.L (c+1) F) : sizeK R.L (c+1) (fun x=> coinW R x (X x) (S x) (F x)):= (((pS.tint (valueK u pX)).scale _)).accrue (reservesK (pc.accrue pc))
include hγ pG B₀
lemma buoy (k:ℕ): sizeK R.L (k+1) (fun x=> moreE R x (X x) (γ x) (S x)):= coinY (X:=X) u pX ((B₀ k).scale 2) (slack u hγ pX pG B₀ k)
def largage (R:Patch)(x:ℝ):= (Rround R.L x)^2

abbrev r_F (R:Patch)(c:Estimate)(x κ σ:ℝ):= |c.H x+moreF R x κ σ| + Scales.g SU.group R.L x^3
abbrev r_M (R:Patch)(c:Estimate)(x κ σ:ℝ):= |c.Fκ x+moreF R x κ σ|+ Scales.g SU.group R.L x^3
abbrev r_A (R:Patch)(c:Estimate)(x κ σ h Pay γ:ℝ):= |sharpA R c Pay x h (εLeaf R.L x)+shiftW R x κ σ γ|+Scales.g SU.group R.L x^3

abbrev majorTp (P C:ℝ):= rayTop C P +1
abbrev r_T (R:Patch)(P C x:ℝ):= majorTp P C / R.L.val * εLeaf R.L x
