omit hγ pG u pX B₀
include R
private lemma gZ0(k:ℕ) : sizeK R.L k (fun x=>Scales.g SU.group R.L x^k):=by simpa only [one_mul] using (sizeK.main R.L).square k
lemma lTp (P C:ℝ):0< majorTp P C:=by unfold majorTp rayTop; positivity
lemma r_t_s (P C:ℝ) : sizeK R.L 2 (r_T R P C):=(low (R:=R)).scale _
include u pX B₀ E
lemma r_f_s : sizeK R.L 1 (fun x=>r_F R c x (X x) (S x)):= (iFX (E.H.accrue (moreLow u pX B₀ 0))).accrue ((gZ0 3).low (by norm_num))
lemma r_m_s : sizeK R.L 3 (fun x=>r_M R c x (X x) (S x)):= (iFX (E.Fκ.accrue (moreLow u pX B₀ 2))).accrue (gZ0 3)
include hγ pG Thick_U
lemma r_a_s : sizeK R.L 1 more_A:= (iFX ((φRise0 E Thick_U Pay).accrue (slack u hγ pX pG B₀ 0))).accrue ((gZ0 3).low (by norm_num))
omit B₀
lemma wine_s (hp:1≤h)(hρ:0<ρ)(C_t:ℝ): sizeK R.L 0 (fun x=> wineT R c C_t A Pay x ρ h (Yf x) (X x) (γ x) (T_φ x)) ∧ sizeK R.L 0 (fun x=> wineA R c Pay x h (Yf x) (X x) (γ x) (T_φ x)):=by
 let hs':= sustain u (sizeK.mild R.L 1) pX; let v:= (feeK hγ pG).accrue hs'; let w0:= coinY u pX (sizeK.mild R.L 1) v; exact ⟨(prizeQ (k:=0) ((shineK E C_t Pay A hρ hp).1.low (by omega)|>.accrue w0)).accrue (w0.low (by norm_num)),(prizeQ (k:=0) ((φRise0 E Thick_U Pay).accrue v)).accrue (v.low (by norm_num))⟩
omit Thick_U
include B₀
lemma tube_p (C_t:ℝ)(h0:0<ρ)(hp:1≤h) : ∀ᶠ x in atTop, sharpE R c C_t A Pay x ρ h (Yf x)+ moreE R x (X x) (γ x) (S x) ≤ r_T R Pay C_t x ∧ Scales.g SU.group R.L x^3 ≤ r_T R Pay C_t x:= by
 let v:= (shineK E C_t Pay A h0 hp).2; let D:=tenor_Q _ _ (Litt.gain (buoy u hγ pX pG B₀ 2)) (by positivity: (0:ℝ)<16/R.L.val)
 let Dα:=tenor_Q _ _ (Litt.gain (gZ0 (R:=R) 3)) (by have he:= lTp (R:=R) Pay C_t; positivity:(0:ℝ)< majorTp Pay C_t /R.L.val *16)
 filter_upwards [D,Dα,v] with x H v e; refine ⟨(add_le_add e H).trans_eq ?_, v.trans_eq ?_⟩<;>unfold r_T majorTp εLeaf <;>ring

omit E hγ pG
