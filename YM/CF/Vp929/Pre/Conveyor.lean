 rename_i d; apply Eq.symm; by_contra p₁; obtain ⟨x,_⟩:= Salt.permit A0 hv o.bags o.vista (Gμ i) (Stilo.beamH j.val) (Lz (Gμ i) j) (pT.quiet _ _).toLullT u p₁; exact d ((Stilo.beam_l ..).1 ((Feu.fit_s S' i _ _).1 x))
