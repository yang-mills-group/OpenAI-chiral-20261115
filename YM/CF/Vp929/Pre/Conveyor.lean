 unfold Vow.march; change (if _ then if pingS p.threshold j.val u.1 then Lz (Gμ i) j (u.1,Ty) else 0 else 0)= _
 by_cases H:pingS p.threshold j.val u.1; swap; · rw [if_neg H,if_neg H]; split <;> rfl
 rw [if_pos H,if_pos H]; split
