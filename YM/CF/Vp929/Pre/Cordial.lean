include Uq hh hγ Ty
lemma economy (u:Charged p' w.input K.j R.L.val h ff F): DuesQ Utrue p h (LE F) BE ∧ Packed p h UP (LA F) BA ∧ ZealQ (LA F):= by
 let y:= Scales.y SU.group R.L x; let X:= Banker.PhiM Z y F; let Q:= Z.toLid.living; let hE:= Uq.master Ty Q hv hh hγ u
 obtain ⟨C,v⟩:= Banker.oldAcquire Z (gross_shape u Uq.cost) Q M
 let P:=hE.spirit.localW Uq Ty hγ v zero_le_one (by norm_num)
 have h0: LE F= pre_E (p:=p) (p':=p') (o:=o) Ty hv X F-tapped p o Ty X:=by unfold pre_E; abel
 have h1: LA F = pre_A (p:=p) (p':=p') (o:=o) Ty hv X F-Cash.owe Ty (slipP p X):=by unfold pre_A; abel
 rw [h0,h1]; refine ⟨?_ ,hE.priced.buys.sub P.2,Cash.zealSub hE.zeal (Cash.zealO _)⟩
 rw [sub_eq_add_neg]; apply Ione.addT p hE.priced.claim; simpa only [neg_one_smul,abs_neg,abs_one,one_mul] using Fixed.Voltage.crestV p Utrue P.1 (-1)
variable {r Kt:ℝ}
local notation "IQ" s:max F:max=> Charged p' w.input K.j R.L.val h s F
lemma ration (u:IQ r F)(t: r≤ Kt*ff)(tv:0<Kt) : DuesQ Utrue p h (LE F) (Kt* BE) ∧ Packed p h UP (LA F) (Kt * BA) ∧ ZealQ (LA F):=by
 let H:= Kt⁻¹ • F; have he: IQ ff H:=(u.smul Kt⁻¹ (zero_le_one.trans D.high)).mono (by rw [abs_of_nonneg (by positivity)]; exact (inv_mul_le_iff₀ tv).mpr t)
 have hg: Lunar.pennies F.1=Kt • Lunar.pennies H.1:= Eq.symm (show Kt • Lunar.pennies H.1=_ from (show _ from smul_inv_smul₀ tv.ne' _)); obtain ⟨A,B,C⟩:= economy Uq Ty hv hh hγ he
 have he: LE F=Kt • LE H:=by unfold noncash_E; rw [hg,map_smul]
 have hx: LA F=Kt • LA H:=by unfold noncash_A; rw [hg,map_smul]
 rw [he,hx]; refine ⟨?_ ,?_,?_⟩
 · simpa [abs_of_pos tv] using Fixed.Voltage.crestV p Utrue A Kt
 · simpa [Complex.coe_smul, abs_of_pos tv] using B.scale (Kt:ℂ)
 intro s p t j D v u; exact (congrArg (Kt • ·) (C s p t j D v u)).trans (map_smul ..).symm

def wineT (R:Patch)(c:Estimate)(C_t A Pay x ρ h ff κ γ k:ℝ):= k*(sharpE R c C_t A Pay x ρ h ff+coinW R x κ 1 (ticket_f (radiusB x) γ 1+burnQ R x κ 1))+coinW R x κ 1 (ticket_f (radiusB x) γ 1+burnQ R x κ 1)
def wineA (R:Patch)(c:Estimate)(Pay x h ff κ γ k:ℝ):= k*(sharpA R c Pay x h ff+ (ticket_f (radiusB x) γ 1+burnQ R x κ 1))+ (ticket_f (radiusB x) γ 1+burnQ R x κ 1)
