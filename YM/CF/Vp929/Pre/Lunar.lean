private lemma char_sub (H Q F:InkD η)(p:F 1=H 1-Q 1)(a b:Rock η): CharM F a b 1 = CharM H a b 1 - CharM Q a b 1:=by
 unfold Haro.CharM mileT; ext i j : 1; simp only [p,Matrix.sub_apply,Matrix.of_apply,Prism.port_eq]; split; exact (sub_self _).symm
 refine Eq.trans ?_ (mul_sub ..); exact congrArg _ (Mew.chipV _|>.map_sub ..)
private lemma char_smul (H F:InkD η)(w:ℂ)(p:F 1=w•H 1)(a b:Rock η): CharM F a b 1=w • CharM H a b 1:=by
 unfold Haro.CharM mileT; ext i j : 1; simp only [p,Matrix.smul_apply,Matrix.of_apply,Prism.port_eq]; split; exact (smul_zero _).symm
 rw [smul_eq_mul, ←mul_left_comm]; rfl
lemma ξ_sub (F G:A₂)(i:Ξm): ξ (F-G) i= ξ F i - ξ G i := by
 unfold seedling glasp beam_C; split; swap; exact (sub_self _).symm
 unfold Oath.wavy Oath.turnB; simp_rw [←sum_sub_distrib]; refine sum_congr rfl fun j _=>sum_congr rfl fun k _=>sum_congr rfl fun x _=>?_ ; unfold heat_K; split; swap; exact (sub_self _).symm
 unfold Haro.lyric; rw [char_sub _ _ (p:=?_ ),mul_sub,sub_mul]; unfold actionZ; split; rfl; exact (sub_self _).symm
lemma ξ_smul(F:A₂)(w:ℂ)(i:Ξm): ξ (w•F) i= w • ξ F i:= by
 unfold seedling glasp beam_C; split; swap; exact (smul_zero _).symm
 unfold Oath.wavy Oath.turnB; simp_rw [smul_sum]; refine sum_congr rfl fun j _=>sum_congr rfl fun k _=>sum_congr rfl fun x _=>?_ ; unfold heat_K; split; swap; exact (smul_zero _).symm
 unfold Haro.lyric; rw [char_smul,mul_smul_comm,Matrix.smul_mul]; unfold actionZ; split; rfl; exact (smul_zero _).symm
private lemma ω_gate (i j: Single ι): Flour univ (gateY i j):=by rw [Oath.reel]; refine (Flour.point ?_).smul _; simp [Haro.tray,Wheat]
abbrev sun (o:Pitching w D x)(A:A₂): Youth m n B → InkD (Scree.mid m B):= fun i U=> ⟨cars_P i.2.2.1 i.2.2.2 U (seedling (p:=p) (p':=p') o Vq A i), by change Flour univ (cars_P _ _ _ _); unfold cars_P lineY; exact Flour.sum _ (fun a _=> Flour.sum _ fun b _=> (ω_gate _ _).smul _)⟩
