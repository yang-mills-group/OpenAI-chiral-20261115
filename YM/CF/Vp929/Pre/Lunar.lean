lemma sun_sub(F G:A₂): S0 Vq o (F-G)= S0 Vq o F - S0 Vq o G:=by
 funext i U; apply Subtype.ext; change cars_P _ _ _ _= cars_P _ _ _ _ -cars_P _ _ _ _; rw [ξ_sub]; unfold cars_P Haro.taxi lineY; simp only [sub_mul, Matrix.sub_apply, sub_smul,sum_sub_distrib]
lemma sun_scale(F:A₂)(z:ℂ): S0 Vq o (z • F)= z • S0 Vq o F:=by
 funext i U; apply Subtype.ext; change cars_P _ _ _ _= z • cars_P _ _ _ _; rw [ξ_smul]; unfold cars_P Haro.taxi lineY; simp only [Matrix.smul_mul,Matrix.smul_apply, smul_eq_mul,mul_smul,smul_sum]
