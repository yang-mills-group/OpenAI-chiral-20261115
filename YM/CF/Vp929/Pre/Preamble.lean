lemma philosophical : Sees S (fun z=>Aφ z) ∧ Census S (fun z=>Zρ z) ∧ Query (fun _=> Set.univ) S fun z=>Zα z:=by
 have pL:∀ z∈ S,Both (fun x=>Spirit p o x Ty) (Aφ z):= fun z h=> (polis Uq Ty hγ (A_ω.merit z h) u).1
 have hx:2*s≤f:=by by_cases k:0≤ s; linarith; linarith [Z.start]
 let T:= Present.applied Uq A_ω hx q_ω
 let H:= rallied Uq Ty hγ A_ω hx pL q_ω
 let V_ψ(z:ℂ):= (Lunar.pennies (A₀ z).1.1,Lunar.pennies (A₀ z).2.1)
 have v:Form S V_ψ:= Form.piForm S V_ψ (fun i=> (A_ω.corr.1 i 1).form q_ω)

 let hK:=Cash.on_claim q_ω Ty H p
 let T2:= veilP_chart T q_ω o Ty
 let H0:= Census.plus q_ω (census_writ q_ω T2) hK
 let HW(i:Scree.Hub ι)(U:Pane ι): Form S (fun z=> (((LE (A₀ z).1) i U), (LE (A₀ z).2) i U)):= by
    apply v.probe (LinearMap.toContinuousLinearMap ((LinearMap.proj U).comp ((LinearMap.proj i).comp (Lunar.radixLin (p:=p) (p':=p') (o:=o) Vx))))
 let HX (i:Aura ι)(Dv:Support (Domain m B))(U: Orbit ι) :Form S (fun z=>(((LA (A₀ z).1) i Dv U),(LA (A₀ z).2) i Dv U)):= by
    exact v.probe (LinearMap.toContinuousLinearMap ((LinearMap.proj U).comp ((LinearMap.proj Dv).comp ((LinearMap.proj i).comp (Lunar.roseLin (p:=p) (p':=p') (o:=o) Vx)))))
 refine ⟨T,fun i V=> (((H0 i V).form q_ω).add (HW i V)).holo q_ω,fun i D _ V=> (((Cash.on_lit q_ω Ty H i D (Set.mem_univ _) V).form q_ω).add (HX i D V)).holo q_ω ⟩
