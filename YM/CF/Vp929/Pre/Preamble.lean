lemma billingReal (z:ℝ)(F:Corr η):
 VΛ z (F,0)=(pre_E (o:=o) (p':=p') (p:=p) Ty Vx (Banker.Phi Z z F) F, 0) ∧ LΛ z (F,0)=(pre_A (p:=p) (p':=p') (o:=o) Ty Vx (Banker.Phi Z z F) F,0):=by
 simp only [Pre_T,Pre_A,echo,slipCC_real]; constructor <;> (refine Prod.ext rfl ?_)
 · change writP (Placement o Ty (0:PZ))+ Cash.earn Ty p (0:Pax ι) + LE 0=0; rw [show Placement o Ty (0:PZ)=0 from funext fun i=>funext (fun V=>by unfold Placement sunY; simp), map_zero]; have he : LE 0=0:=map_zero _; have h:Cash.earn Ty p (0:Pax ι)=0:=by have H:= Cash.subEarn (P:=p) (F:=0) (G:=0) Ty; rw [sub_zero,sub_self] at H; exact H
   rw [he,h,add_zero,add_zero]
 change Cash.owe Ty (0:Pax ι) + LA 0=0; have he : LA 0=0:= map_zero _; have h:Cash.owe Ty (0:Pax ι)=0:=by have H:= Cash.subOwe (F:=0) (G:=0) Ty; rw [sub_zero,sub_self] at H; exact H
 rw [he,h,add_zero]
