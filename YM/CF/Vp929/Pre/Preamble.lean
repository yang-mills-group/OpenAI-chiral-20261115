lemma roughBill (U:Factory (w:=w) (K:=K) (p':=p') (nₐ:=nₐ) (t:=t) (x:=x) (h:=h) z s X)(v0:6*s≤f)(l:s≤ a*ff)(u0:0<a): let A:= Ψ z X; let E:=VΛ z X; let K:=LΛ z X; HeartScope o p Ty A.1 E.1 K.1 Υ Υ (cBE a) (cBA a) ∧ HeartScope o p Ty A.2 E.2 K.2 Υ Υ (cBE a) (cBA a):=by
 obtain ⟨H,V⟩:= Uq.polis Ty hγ U v0
 obtain ⟨⟨C₁,S⟩,⟨C₂,W'⟩⟩:= Uq.PM_bill U.1 X U.2 (by by_cases t:0≤ s; linarith; linarith [Z.start]); intro T E0 K0
 have hw (T:PZ)(G: Corr (Scree.mid n B))(F:Pax ι)(cp:Kx) (e:Spirit p o T Ty)(pF:MonoQ p h Τr F ρu)(q:Cash.poise F)(u:Harvest p h κ 1 T cp)(v:Charged p' w.input K.j R.L.val h s G): HeartScope o p Ty T (L_T (p:=p) (p':=p') (o:=o) Ty Vx T F G) (L_A (p:=p) (p':=p') (o:=o) Ty Vx F G) Υ Υ (cBE a) (cBA a) :=by
     obtain ⟨vF,vK,vΨ⟩:=ration Uq Ty Vx hv hγ v l u0
     let P:= Young Uq e.seed u; let H:= pertains Uq Ty e.seed u e; let K:= Cash.priceRun D.high Ty pF q; refine ⟨e,⟨P.1,P.2.1,?_ ,?_⟩, Cash.zealAdd (Cash.zealO Ty) vΨ⟩
     · let L:= Ione.addT p (Ione.addT p H K.1) vF; unfold L_T; convert L using 1 <;> first|rfl|skip
       unfold wineT coinW; rw [Z.request.boot.order,Z.request.boot.power,Z.request.boot.B]; exact add_comm ..
     unfold L_A wineA; rw [add_comm (a* _)]; exact K.2.add vK
 exact ⟨hw _ _ _ _ H.1 V.1.1 V.1.2 (S) (U.2.1),hw _ _ _ _ H.2 V.2.1 V.2.2 W' (U.2.2)⟩
