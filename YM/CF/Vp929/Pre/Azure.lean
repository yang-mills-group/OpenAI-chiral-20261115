-- Total numeric cost for ready uses at exponent gap one. parameter γ.
abbrev burnQ (R:Patch)(x κ t:ℝ) : ℝ:= Vow.chi_f 6*(t * value_ R x κ)
structure Fair (p:BudgetPoint)(R:Patch)(x κ γ σ:ℝ) :Prop where
 σ_p:0<σ
 σ₁:σ≤1
 book : FeeBook (radiusB x) γ 1
 beam : 0≤ value_ R x κ
 gain : 1000*(chi_f 6 *value_ R x κ) ≤ γ
variable (hk:Fair p R x κ γ σ)
local notation "Υ" t:max=> burnQ R x κ t
variable (hp:Spirit p o Lz Ty)(gx: Harvest p h κ tα Lz Cp)

include hp
lemma Spirit.dueTurf : Cash.poise (nixV (cone_f Lz)):=⟨Seed.course hp.seed,hp.musk⟩
lemma Spirit.aged : Cash.poise (old_Q Lz) := by
 refine ⟨fun i V τ=>?_ , hp.oak⟩; unfold old_Q; rw [Finset.sum_apply,Finset.sum_apply]; apply sum_congr rfl; intro j t; have he: Θ' j=∅:= elder_q j (mem_filter.mp t).2; exact ((hp.seed).spruce j i (by rw [he]; exact empty_subset _)).turf he V τ
omit hp
include Uq hk
lemma Fair.usable: FeeBook p.B γ 1:= by rw [Z.request.boot.B]; exact hk.book
lemma Fair.audit (t:0≤tα)(ht:tα ≤ 100): Υ tα ≤ γ / 2 := by unfold burnQ; nlinarith [hk.gain,hk.beam,spicy_f 6, hk.book.coal]
omit hk
lemma Young (hp:Seed p Lz)(u:Harvest p h κ tα Lz Cp): MonoQ p h (UP+1) (nixV (cone_f Lz)) (Υ tα) ∧ Marked p h (UP+1) (cone_f Lz) (Υ tα) ∧ MonoQ p h (UP+1) (old_Q Lz) (Υ tα) := by
 let H:= Seed.begin Uq u hp; simpa only [burnQ, Z.request.boot.order] using H
include hk
lemma Fair.ps :0≤ UP:= by unfold Cash.prominence; linarith [p.exponent_pos]

lemma FeePoise {F:Pax ι} (u: Cash.poise F)(t:MonoQ p h (UP+1) F γ): Cash.poise (FeeD p F):= by
 refine ⟨Bake.turfK _ u.1,fun s i V=>?_ ⟩; obtain ⟨T,H,V0⟩:= (hk.usable Uq).seats D.high t; exact spinsE s i _ V (fun j=> u.2 s j V) V0 D.high H (hk.ps Uq) 0
abbrev slipP (p:BudgetPoint)(L:Px) := (FeeD p (nixV (cone_f L))- old_Q L)

abbrev tapped (p:BudgetPoint)(o:Pitching w D x)(Ty:Ids ι)(L:Px) : RegBudget ι:= writP (Placement o Ty L)+Cash.earn Ty p (slipP p L)
def coinW (R:Patch)(x κ u a:ℝ):= wren_K 6 2*(u*value_ R x κ)+ reserveT 2 6 (radiusB x) 1*(a+a)
local notation "Ψt"=> tapped p o Ty Lz
variable (hT:0≤tα)(bt:tα≤100)
local notation "φ"=> ticket_f (radiusB x) γ 1
local notation "λa" u:max=> (ticket_f (radiusB x) γ 1 + burnQ R x κ u)
lemma counterPos : ticket_f (radiusB x) γ 1≥0:=by unfold ticket_f; refine mul_nonneg hk.book.coal.le (by exact inv_nonneg.mpr (sub_nonneg.mpr hk.book.rate.le))
include hp gx hT bt
lemma Spirit.livelihood: Cash.poise (slipP p Lz) ∧ MonoQ p h UP (slipP p Lz) (φ+burnQ R x κ tα) := by
 obtain ⟨hf,hc,he⟩:=Young Uq hp.seed gx; have hb:= (hk.audit Uq hT bt).trans (half_le_self hk.book.coal.le); let F:= hf.purse hb; refine ⟨Cash.poiseSub (FeePoise Uq hk hp.dueTurf F) hp.aged,by
    have G:MonoQ p h UP (FeeD p (nixV (cone_f Lz))) φ:= by
       have H:= (hk.usable Uq).fee (hk.ps Uq) D.high F; simpa only [Z.request.boot.B] using H
    exact G.sub (he.fade (le_add_of_nonneg_right zero_le_one) (zero_le_one.trans D.high))⟩
lemma Spirit.localW : DuesQ Utrue p h (Ψt) (coinW R x κ tα (φ+burnQ R x κ tα)) ∧ Packed p h UP (Cash.owe Ty (slipP p Lz)) (φ+burnQ R x κ tα):=by
 obtain ⟨uP,tP⟩:= hp.livelihood Uq Ty hk gx hT bt; let Q:=Cash.priceRun D.high Ty tP uP
 let H:=pertains Uq Ty hp.seed gx hp; unfold coinW; conv in wren_K _ _ => rw [← Z.request.boot.order,←Z.request.boot.power]
 rw [show reserveT 2 6 (radiusB x) 1=reserveT p.power p.order p.B 1 from by rw [Z.request.boot.order,Z.request.boot.power,Z.request.boot.B]]; exact ⟨Ione.addT p H Q.1,Q.2⟩
omit hp gx hT bt
local notation "Kψ"=> (2*ticket_f (radiusB x) γ 1*σ+ burnQ R x κ (2*σ))
def shiftW (R:Patch)(x κ σ γ:ℝ) := 2*ticket_f (radiusB x) γ 1*σ+ burnQ R x κ (2*σ)
lemma differs {α:Harvest p h κ 1 Lz Cp}(v:Spirit p o Lz Ty)(T:PZ)(g:Spirit p o T Ty)(X Y: Kx)(t:Harvest p h κ 1 T X)(pΔ:Harvest p h κ (2*σ) (Lz-T) Y):
 MonoQ p h UP (slipP p Lz-slipP p T) (Kψ) ∧ IncX Utrue (Ψt - tapped p o Ty T) p h (coinW R x κ (2*σ) (Kψ)) ∧ Packed p h UP (Cash.owe Ty (slipP p Lz)-Cash.owe Ty (slipP p T)) (Kψ) := by
 let L:=v.minus Ty T g; obtain ⟨hf,_,hE⟩:= Young Uq L.seed pΔ; rw [coneSub T] at hf; rw [vintage T] at hE
 have hr:MonoQ p h UP (FeeD p (nixV (cone_f Lz))-FeeD p (nixV (cone_f T))) (2*ticket_f p.B γ 1*σ):=by
    apply (hk.usable Uq).comparison (hk.ps Uq) D.high hk.σ_p hk.σ₁ ((Young Uq g.seed t).1.purse (hk.audit Uq zero_le_one (by norm_num)))
    exact hf.purse (by unfold burnQ; nlinarith [hk.σ_p,mul_le_mul_of_nonneg_left hk.gain hk.σ_p.le,mul_pos hk.σ_p hk.book.coal])
 have hw:MonoQ p h UP (slipP p Lz-slipP p T) (Kψ):=by
    have h':= hr.sub (hE.fade (le_add_of_nonneg_right zero_le_one) (zero_le_one.trans D.high)); rw [Z.request.boot.B] at h'; unfold slipP; rwa [show FeeD _ (nixV (cone_f Lz))-old_Q Lz-(FeeD _ (nixV (cone_f T))-old_Q T)= (FeeD p (nixV (cone_f Lz))-FeeD p (nixV (cone_f T))) - (old_Q Lz-old_Q T) by abel]

 have hw1:= v.livelihood Uq Ty hk α zero_le_one (by norm_num); let hw2:= g.livelihood Uq Ty hk t zero_le_one (by norm_num); obtain ⟨Vt,Vk⟩:= Cash.priceRun D.high Ty hw (Cash.poiseSub hw1.1 hw2.1)
 rw [Cash.subEarn] at Vt; rw [Cash.subOwe] at Vk
 let H:= pertains Uq Ty L.seed pΔ L; unfold coinW; conv in wren_K _ _=> rw [←Z.request.boot.order,←Z.request.boot.power]
 rw [show reserveT 2 6 (radiusB x) 1=reserveT p.power p.order p.B 1 from by rw [Z.request.boot.order,Z.request.boot.power,Z.request.boot.B]]
 refine ⟨hw,?_ ,Vk⟩; unfold tapped; have H':∀ (A B:PZ),writP (Placement o Ty A)-writP (Placement o Ty B)=writP (Placement o Ty (A-B)):=fun A B=>by rw [Placement_sub,map_sub]
 let Y(F:PZ):=Cash.earn Ty p (slipP p F); rw [show _+Y Lz-(_+Y T)= writP (Placement o Ty (Lz-T))+(Y Lz-Y T) from ?_]
 · exact Ione.addT p H Vt
 rw [←H']; abel
