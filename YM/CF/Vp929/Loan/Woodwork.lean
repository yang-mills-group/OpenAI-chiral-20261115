lemma decidedly(A:Orbit ι): (ξ Tint) A=ᵐ[μπ] Z.grand K0 O' hF Q A:= by
 filter_upwards [tone_p (S:=S') (mul_pos D.pilot.high (Scales.pos ..) :0<Sp)] with i r; unfold prep; rw [Set.indicator_of_mem (show i∈ Brink S' Sp from r),one_smul]
lemma novel_real(A:Orbit ι) : novelM Z hF Q K0 P0 A= ∫ i, Z.grand K0 O' hF Q A i∂μπ:= integral_congr_ae (decidedly ..)
include M
lemma sprinkler [IsFiniteMeasure μπ](A:Orbit ι)(h:A.1∈Φ_): Integrable (prep P0 K0 Sp χ Tint A) μπ ∧ Integrable (prep P0 K0 Sp χ (squall Z Q) A) μπ:= by
 let T:= commune Z hF; let X:= Classical.choice (master_docket (Aq:=T) Z hF Q M); let Y:= Classical.choice (diff_docket (Aq:=T) Z hF Q M);
 exact ⟨X.live P0 K0 (light_master ..) Z.request.boot (fun _ _=>measurable_const) A h, Y.live P0 K0 (light_master ..) Z.request.boot (wind_m Z hF Q) A h⟩
local notation "Rp"=> Appel.point G5 Sp/Appel.point G5 ℓ
private lemma lit_ratio (A:Orbit ι) (S:Ω): Z.tiny K0 O' hF Q A S=(Rp)^(tokenFuel K0 S) • Z.grand K0 O' hF Q A S:= by
 let v:= Z.toLid.ZoomB Q; rw [RCLike.real_smul_eq_coe_smul (K:=ℂ)]; let x:ℂ:= ↑(Rp); have hp:= shot_orientation Z.toLid M Q
 let k:=tokenFuel K0 S
 have e:Z.tiny K0 O' hF Q A S= _ :=Z.ratio_master K0 O' hF S A Q _ (Z.toLid.fend Q (Z.toLid.scaler Q)) rfl rfl
 change _= (↑((Rp)^k):ℂ) • _; rw [e, Complex.ofReal_pow,←hp,Complex.ofReal_div];
private lemma eqU (A:Orbit ι): (∫ i,Z.tiny K0 O' hF Q A i∂Z.epoch Q) =∫ i, (if textP Ξ' i ℓ then (pivotV Z Q Ξ' K0 i:ℝ) • Z.grand K0 O' hF Q A i else 0)∂ μπ:= by
 let f(v:Orbit ι):Ω→Cipher ι:= fprefix O' Sp (Z.grand K0 O' hF Q) v; let Px(s:Ω):=(Rp)^tokenFuel K0 s • f A s
 have hz:1≤ℓ:= coast Z.toLid M Q; have hs:ℓ≤Sp:= Pilot.hat_zoom ..; have hp:= zero_lt_one.trans_le hz; have ht:= hp.trans_le hs
 have hg(i:Ω)(p:Fairy S' Sp i): f A i=Z.grand K0 O' hF Q A i:= root_prefix O' _ ht.le (fun i v h=> Z.reset_r K0 O' hF Q (Lt₂) (Z.toLid.choice Q hF) Z.master_pond _ h v) i p _
 have H:Measurable (uncurry f):=measurable_prefix O' _ ((light_master Z hF Q).bore K0 (Stilo.beamH P0.val))
 have hu: Measurable (fun i : Ω=> (A,i)):= Measurable.prodMk measurable_const measurable_id; have hh:= H.comp hu; let Avv:= ((show Measurable (fun _:Ω=> Rp) from measurable_const).pow (Z.fuel_m K0 hF)); have he:= (show Measurable Px from Measurable.smul Avv (show Measurable (fun i:Ω=>f A i) from hh))
 calc
   _=∫ i,Px i∂plummy S' ℓ:=by
      apply integral_congr_ae; filter_upwards [tone_p (S:=S') hp] with i p; unfold Px; rw [hg i (show Fairy S' Sp i from p.trans hs)]; exact lit_ratio P0 K0 Z hF Q M _ _
   _=∫ i,(if textP Ξ' i ℓ then (Rp)^(booths Ξ' S').card • Px i else 0) ∂μπ:= pour_hat Ξ' ℓ hp hs _ he.stronglyMeasurable (fun i=>?_)
   _=_:= by
      apply integral_congr_ae; filter_upwards [tone_p (S:=S') ht] with i p; unfold Px; rw [hg i p]; split; · rw [smul_smul,←pow_add]
      rfl
 unfold Px; rw [show tokenFuel K0 (yearT i Ξ')=tokenFuel K0 i from rfl]; exact congrArg ((Rp)^tokenFuel K0 i •·) (pay_prefix ..).symm
lemma heat_p [IsFiniteMeasure μπ] (A:Orbit ι)(q:A.1∈Φ_): novelM Z hF Q K0 P0 A+ Ustar A= moon Z hF (β:ℂ) K0 P0 A:=by
 have hp:= sprinkler P0 K0 Z hF Q M A q
 let P0':= port P0 K0 μπ Sp χ; have Hm:= tone_p (S:=S') (mul_pos D.pilot.high (Scales.pos ..):0<Sp)
 change _= Z.precip K0 O' hF β A; rw [Z.precip_real K0 O' hF Q,eqU P0 K0 Z hF Q M]; unfold novelM Docket.port; rw [←integral_add hp.1 hp.2]; apply integral_congr_ae; filter_upwards [Hm] with i p; unfold prep; rw [Set.indicator_of_mem (show i∈Brink S' Sp from p),Set.indicator_of_mem (show i∈Brink S' Sp from p),one_smul]; unfold squall windfall; split
 · rw [RCLike.real_smul_eq_coe_smul (K:=ℂ)]; push_cast; rw [sub_smul,one_smul]; abel
 rw [neg_smul,one_smul,add_neg_cancel]
