 refine ⟨e.nonnegative,?_ ,?_⟩; · intro o m Yt hn; simpa only [one_mul] using e.meter o m Yt hn
 intro t O; let AP:= (Stilo.bay (Stilo.beamH O.val)); let u':=(cook S' t.toLeft).flags
 have he(i:Orbit ι)(h:i.1∈ Rue.litres p.threshold AP u'):=(eq t O i h); have hr(X:BudgetPoint):X= X:=rfl
 refine ⟨⟨u.lit _ _, fun _ _=> u.localP _ _ _ _,?_ ,fun i h=>u.no _ _ _ h,fun i h=> (he i h).2.symm.trans (u.toll t O i h)⟩,fun i ht hg=>?_ ,fun V=>e.hoist _ _ _⟩
 · intro i; rw [bay_beam]; exact u.shape ..
 by_cases h: flags p.threshold i.1∩AP=u'; swap; · have H: Cellar.region t (Stilo.beamH O.val) f hv Lx i=0 := funext (fun u=>Jade.end_t (X:=Xs β) (Y:=Ys β F) V X D.Z o.SheepR o.bags o.vista hv Lx t (Stilo.beamH O.val) _ h _ _); let μ:= plummy S' (X.hat R x); change Integrable (Cellar.region t (Stilo.beamH O.val) f hv Lx i) μ∧(∫ x,Cellar.region t (Stilo.beamH O.val) f hv Lx i x ∂μ)=_; rw [H,turnL, if_neg h]; exact ⟨integrable_zero ..,integral_zero ..⟩
 have hl:i.1∈Rue.litres p.threshold AP u':=by
    apply And.intro ((Rue.shoreK _ _ hg _).mp (Finset.disjoint_left.mpr fun z v p=>?_)) (show u'⊆ flags p.threshold i.1 from h ▸ inter_subset_left)
    exact (mem_sdiff.mp v).2 (show _∈ u' from h ▸ mem_inter.mpr ⟨p,(mem_sdiff.mp v).1⟩)
 exact ⟨(he i hl).1,(he i hl).2.symm.trans ((u.toll _ _ _ hl).trans (if_pos h).symm)⟩
