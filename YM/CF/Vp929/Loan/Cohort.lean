 letI := Plume.plum_p S' (mul_pos D.pilot.high (Scales.pos ..):0<℘0); let U:= Classical.choice (diff_docket (Aq:=commune Z hF) Z hF Q M); refine ⟨_,U.harvest (light_master Z hF Q) Z.request.boot (wind_m Z hF Q) (by nlinarith [M.pulse]) (discount_pos M.patron) ⟨fun i O x y v h=> congrArg₂ (fun v (t:Cipher ι)=> v-t) (pT.localP _ _ _ _ v h) (pM.localP _ _ _ _ v h),fun i O=> (pT.lit _ _).sub (pM.lit _ _),?_ ,?_,?_ ⟩ ⟩
 · intro i o V p; change Pt i o V - P i o V=0; rw [pT.no i o V p,pM.no i o V p,sub_self]
 · intro i o V q; change _= Pt i o V - P i o V; rw [← pT.toll _ _ _ q, ← pM.toll _ _ _ q,←heat_p o i Z hF Q M V q, add_sub_cancel_left]
 intro i o V; change Flour _ ((Pt i o V).val-(P i o V).val); rw [sub_eq_add_neg, ← neg_one_smul ℂ]; exact (pT.shape _ _ _).add ((pM.shape _ _ _).smul _)
