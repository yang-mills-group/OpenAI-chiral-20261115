def crudeE (T: Estimate)(κ b:ℝ)(p:ℝ)(x':ℝ) (i:Finset D') := κ*degreePrice (radiusB x) κ 1 ^0*(1-degreePrice (radiusB x) κ 1)⁻¹/(b^K0.toRight.toRight.toLeft.card * ((stake p:Raid D') i) * Trees.currency (radiusB x) (23/4) P0.val)
include M Z hp
local notation "Sq" i => crudeE P0 K0 c κ bκ h x i
lemma radiusE {T:Ωs} (Aq:Dialect o p' f F Pν)(b:Lien Aq p κ 0 bκ Hm c (Ψκ z) T)(i:Finset D') : T K0 P0 i ≤ Sq i:= by
 have H:=b.toll.radius (fun i=>mul_pos (Aq.prize_pos i 0) (pow_pos (discount_pos (x:=x) (R:=R) (c:=c) M.patron) _)) (fun i=> pow_pos (zero_lt_one.trans_le D.high) _) K0 P0 i; simp_rw [prize_formula,rev,Aq.steep_k,zero_mul,Real.exp_zero,one_mul] at H
 exact H
lemma crisp (s:Ω)(Lx:Orbit ι)(hl:Lx.1∈Φ_)(e:Fairy S' Hm s)(i:Finset D'): ‖crumb (((B_ z Lx) s)).val i‖ ≤ max 0 (Sq i) :=by
 rw [Z.fume_fairy K0 O' hF z s Lx e]; by_cases k: CQ⊆Ξ'; swap; · rw [Z.empty_till K0 O' hF k Lx s]; exact le_trans (by rw [show Pastry.crumb ((0:Cipher ι).val) i=0 from rfl,norm_zero]) (le_max_left _ _)
 let v:= era (S:=S') (r:=z') s.2.2; let A:=commune Z hF v; obtain ⟨T,t⟩:= A.lien Z hF M hp; obtain ⟨oκ,g⟩:=P0.prop; have xx:= ( t.stem_t K0 P0 Lx.1 oκ Lx.2 s e rfl k (by rwa [bay_beam]) hl).haveP i; let G:= tuneW (p:=p) K0 O' Lx.1 oκ Lx.2 s (Ψκ z)
 have hu:= Yaw.skim xx; have Q: G 0=(Z.pattern K0 O' hF z (latticeFieldEstimatesB o z) Lx s):= by unfold G tuneW; dsimp only; rw [map_zero,Vmove]; simp
 change ‖crumb (G 0).val i‖≤ _ at hu; rw [Q] at hu; refine hu.trans (le_trans ?_ (le_max_right _ _));
 by_cases h:s∈earnS o c K0; · rw [Set.indicator_of_mem h]; exact radiusE P0 K0 Z hF M hp A t i
 rw [Set.indicator_of_notMem h]; exact (t.toll.p K0 P0 i).trans (radiusE P0 K0 Z hF M hp A t i)
def roughH (T:Estimate)(κ b h x':ℝ):=∑ i:Finset D',max 0 (crudeE P0 K0 T κ b h x' i)* ‖poke i‖
lemma boundH (s:Ω)(Lx:Orbit ι)(hl:Lx.1∈Φ_)(e:Fairy S' Hm s): ‖(B_ z Lx) s‖≤ roughH P0 K0 c κ bκ h x:=by
 let F:= (B_ z Lx) s; change ‖F.val‖≤ _; nth_rw 1 [(fineShape F).allP]; exact (norm_sum_le ..).trans (Finset.sum_le_sum (fun i _=> (norm_smul _ _).trans_le (mul_le_mul_of_nonneg_right (crisp P0 K0 Z hF M hp s Lx hl e i) (norm_nonneg _))))
