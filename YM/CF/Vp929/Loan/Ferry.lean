 unfold rev; rw [(Aq i').steep_k]; let D₀:= yotel i'; let B:= bκ^t.toRight.toRight.toLeft.card; let E:=(Aq i').prize t (1/8); have he:= monadLit (Aq:=Aq) (Pν:=i') P t M; have v:E≥1:= he.2.2; have hx:= he.1.trans he.2.1
