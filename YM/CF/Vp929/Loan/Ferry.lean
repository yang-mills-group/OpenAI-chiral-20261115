 have s:= monadLit (Aq:=Aq) (Pν:=Pν) P0 K0 M; have hQ:1≤ W:=s.2.2; have hB:0 ≤ cB:= pow_nonneg (discount_pos (x:=x) (R:=R) (c:=c) M.patron).le _
 have hz:0≤ K:= mul_nonneg M.pulse.le (Real.exp_pos _).le; have x:= (locked_m K0 (c:=c) (o:=o) (Pν:=Pν)); let q:= fun _ :Ω=> K*W; let q':Ω→ℝ:= fun _=>1
 rw [show dam (Aq:=Aq) P0 K0 Z Q Pν σ=q+(J.indicator q') from rfl, show Lkk.indicator (q+J.indicator q')=fun x=> Lkk.indicator q x + Lkk.indicator (J.indicator q') x from Lkk.indicator_add ..,show Lkk.indicator (J.indicator q')=(Lkk∩J).indicator q' from by rw [Set.indicator_indicator],integral_add ((integrable_const _).indicator ht) ((integrable_const _).indicator (ht.inter he)),integral_indicator ht,integral_indicator (ht.inter he), show (∫ x in Lkk,q x∂μπ)=_ from setIntegral_const (K*W), show (∫ x in Lkk∩J,q' x∂μπ)=_ from setIntegral_const (1:ℝ)]
 simp only [smul_eq_mul,mul_one]; have p₁:(μπ).real Lkk≤ yotel Pν * cB:=by unfold cB rev; rw [(Aq Pν).steep_k]; exact lure_b K0 M.patron (Lt₂) (by linarith only [M.margin]) Pν
 have p₂:(μπ).real (Lkk∩J) ≤ yotel Pν * cB*K:= by
   unfold cB rev K; rw [mul_assoc,(Aq Pν).steep_k]; have H:= (poor Z Q Ξ' M K0 Pν); unfold J; exact le_trans H (le_of_eq (by rw [bay_beam]))
 refine (add_le_add (mul_le_mul_of_nonneg_right p₁ (mul_nonneg hz (zero_le_one.trans hQ))) p₂).trans ?_; calc
 _ ≤ yotel Pν*(W*cB)*(2*σ)* sh P0.val := by
      have hh:=le_mul_of_one_le_right (a:= yotel Pν*cB*K) (mul_nonneg (mul_nonneg measureReal_nonneg hB) hz) hQ; unfold K at *; nlinarith only [hh]
 _ ≤ _:= by unfold B₀; rw [←mul_assoc (yotel _) _ (2*σ)]; exact mul_le_mul_of_nonneg_left s.2.1 (mul_nonneg (mul_nonneg measureReal_nonneg (mul_nonneg (zero_le_one.trans hQ) hB)) (mul_nonneg (by norm_num) M.pulse.le))
