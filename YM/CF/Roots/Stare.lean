lemma τMood {ι:Type*}(x:ι→Orbit (mid N B))(y:ι→Orbit (mid P B))(F:ι→Phys (mid P B))(p:∃ Z:ℝ,∀ i,‖F i‖ ≤Z)(T:S.ratio=ratio G)(H:S.patch.Branches S.kernel SU.group):∃ Z':ℝ,∀ i:ι,‖lynx K S G G₁ G₁ G₀ Y q kL Xp (x i) (y i) (F i)‖≤Z':=by
 letI:MeasurableSpace ι:= ⊤; have hg:∀ i:Set ι, MeasurableSet i:= fun _=>MeasurableSpace.measurableSet_top -- tune.In
 obtain ⟨A,t⟩:=p; have hf:RG.Envelope F:=⟨fun _ _=>hg _,_,t⟩; let L(i:ι):=(ΦK (x i) (y i)) (F i)
 let cn(Q:Forest (ratio G))(j:ι):= coal_X (K:=K) (Y:=Y) (G₀:=G₀) (G₁:=G₁) (kL:=kL) (q:=q) (x j) Q (y j) (F j); let Tt(j:ι):= S.density Y.beta (y j).1 (x j).1; let n(Q:Forest (ratio G))(j:ι):=Tt j • scaleZ Xp (cn Q j); have hz:RG.Envelope Tt:=by unfold Tt StepData.density; exact RG.Envelope.sum univ _ (fun Q=>env_tagged Y.beta Q H (fun _ _=>hg _) (fun _ _=>hg _))
 have hp(Q):RG.Envelope (n Q):=by
    refine Env.scale hz (pole_w (cn Q) _ (scaleW _ Xp).continuous ?_); obtain ⟨s,a,h,d,H,u,g⟩:= hΩ.wick; apply heat_k hΩ.power _ H u g hΩ.pe hΩ.size (fun i:ι=>(seine G Q q kL (G₁ (y i)) (G₀ (x i)), G₀ (x i))) F (fun j=> hΩ.trial ..) (fun _ _=>hg _) hf -- `g` direction
 have he:L=(fun z=> ((Fintype.card (Forest (ratio G)):ℝ)⁻¹) • ∑ Q:Forest (ratio G), n Q z):=by funext z; unfold L lynx; simp_rw [ContinuousLinearMap.smul_apply, ContinuousLinearMap.sum_apply,Complex.coe_smul]; rfl
 change ∃ _, ∀ _,‖L _‖≤_
 have h:RG.Envelope L:=by rw [he]; exact Env.scale (H:=fun _=>_) (Envelope.const _) (Env.total _ hp)
 exact h.cost
