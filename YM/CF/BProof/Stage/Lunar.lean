def cant (t:VX):Op SU.Slot:= if Short S H₀.p i.1.1.val.2 then wavy (S:=S) (x:=x) Qw M'.X Jp.ink ((H.post+90)*radiusB x) (fun _ _=>t) i.1.1 (Stilo.beamH (hostX (l:=((H.post+90)*radiusB x)) S i.1).val) (Stilo.beamH i.2.1.val) i.2.2.1 i.2.2.2 else 0
def miles (p q: Prism.Rock (mid P B)) : VX→ₗ[ℂ] Op SU.Slot where
 toFun:= Prism.mileT p q true false
 map_add' a b:= by ext x y; unfold Prism.mileT Prism.portB; simp only [Matrix.of_apply,Matrix.add_apply,Subalgebra.coe_add]; rw [act_add,inner_add_right]
 map_smul' a b:= by ext x y; unfold Prism.mileT Prism.portB; simp only [Matrix.of_apply,Matrix.smul_apply]; change inner ℂ _ (acts (a • b.val) _)=_; rw [act_smul,inner_smul_right]; rfl
