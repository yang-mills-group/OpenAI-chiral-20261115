def cantL : VX→ₗ[ℂ] Op SU.Slot where
 toFun:=cant (H:=H) V M' D_ Qw C' Xp₀ Jp i
 map_add' a b:= by
    unfold cant; split_ifs; swap; · exact (zero_add _).symm
    unfold Oath.wavy Oath.turnB; have he(y v:Prism.Rock (mid P B)): Haro.CharM (fun _=>a+b) y v 1=Haro.CharM (fun _=>a) y v 1+ Haro.CharM (fun _=>b) y v 1:= (miles y v).map_add _ _; simp_rw [←sum_add_distrib]; refine sum_congr rfl (fun _ _=> sum_congr rfl (fun _ _=>sum_congr rfl (fun j _=>?_ ))); unfold heat_K lyric; split; swap; · exact (zero_add _).symm
    rw [he,mul_add,add_mul]
 map_smul' a b:= by
    unfold cant; split; swap; · exact (smul_zero ..).symm
    unfold Oath.wavy Oath.turnB; have he(y v:Prism.Rock (mid P B)): Haro.CharM (fun _=>a • b) y v 1=a • Haro.CharM (fun _=>b) y v 1:= (miles y v).map_smul a b; change _= a • _; simp_rw [smul_sum]; refine sum_congr rfl (fun _ _=> sum_congr rfl (fun _ _=>sum_congr rfl (fun j _=>?_ ))); unfold heat_K lyric; split; swap; · exact (smul_zero ..).symm
    rw [he,mul_smul_comm,smul_mul_assoc]
def cars (U: Pane (mid N B)) : Op SU.Slot→ₗ[ℂ] FC (Dwell (mid N B)) where
 toFun:= cars_P i.2.2.1 i.2.2.2 U
 map_add' a b :=by unfold cars_P lineY Haro.taxi; rw [add_mul]; simp_rw [Matrix.add_apply,add_smul,sum_add_distrib]
 map_smul' a b:=by unfold cars_P lineY Haro.taxi; rw [smul_mul_assoc]; simp_rw [Matrix.smul_apply]; change _= a • _; simp_rw [smul_sum,smul_eq_mul,mul_smul]
abbrev colt_Ω (U:Pane (mid N B)) : Cipher (mid P B)→ₗ[ℂ] Cipher (mid N B):= LinearMap.leftInverse (eat_c (n:=Dwell (mid N B))) ∘ₗ ((cars i U) ∘ₗ cantL (H:=H) V M' D_ Qw C' Xp₀ Jp i)
