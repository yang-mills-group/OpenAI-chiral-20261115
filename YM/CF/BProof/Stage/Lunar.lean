lemma colt_work (Fv:Youth N P B→InkD (mid N B)) (p:∀ t:Youth N P B,∀ v:Pane (mid N B),(Fv t v).val=cars_P t.2.2.1 t.2.2.2 v (glasp (H:=H) (Y:=H₀) (X:=H₁) V M' D_ Qw C' Xp₀ Jp t)) (U:Pane (mid N B)) : Fv i U=colt_Ω (H:=H) V M' D_ Qw C' Xp₀ Jp i U (actionZ H₀ i.1 1):=by
 change _= eat_c.leftInverse ((cars i U) (glasp (H:=H) (Y:=H₀) (X:=H₁) V M' D_ Qw C' Xp₀ Jp i)); rw [show cars i U _=(Fv i U).val from (p i U).symm]; exact (LinearMap.leftInverse_apply_of_inj (LinearMap.ker_eq_bot.mpr Subtype.val_injective : (eat_c (n:=Dwell (mid N B))).ker=⊥) (Fv i U)).symm
