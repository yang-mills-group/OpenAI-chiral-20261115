abbrev stakeH (K:ℕ):ℝ:= flavor*flavor*γD K
lemma mercy(p:Prism.Rock (mid N B)) : ∑ i:Rock (mid N B), joinV (Scree.tariff P0 (posG p) L) (manifest k Zaux p i) ≤ (stakeH k * L^2)*(flavor * ξ) :=by
 let V:= (posG p); let H:= stakeH k *L^2; have he:0 ≤ H :=by unfold H stakeH flavor γD; have hv:=wheels_p (n:=k); have ht:=p0; positivity
 let CQz(j:Rock (mid N B)) := (1+(separation V (posG j):ℝ))^P0.power
 have hx(j) : joinV (Scree.tariff P0 (posG p) L) (manifest k Zaux p j)= H*(CQz j *bow Zaux p j):=by
    unfold manifest; simp_rw [joinVsum];
    let Vu:= γD k*bow Zaux p j; have hv(i v:SU.Slot): joinV (Scree.tariff P0 (posG p) L) (Pi.single (Haro.tray (p,i) (j,v)) Vu)=CQz j*L^2*Vu:=by unfold joinV; simp_rw [Pi.single_apply,mul_ite, mul_zero]; rw [sum_ite_eq']; unfold Haro.tray; rw [if_pos (mem_univ _),rope P0.power _ p j i v L P0 rfl]; simp [CQz,V,Haro.amt] -- tune
    trans ∑ _ : SU.Slot,∑ _ : SU.Slot, CQz j*L^2*Vu; exact sum_congr rfl fun i _=> sum_congr rfl fun v _=> hv i v; simp only [sum_const,card_univ,nsmul_eq_mul]; unfold H stakeH Vu flavor; ring
 have hp(u:SU.Slot) :(∑ j:Rock (mid N B),∑ v:SU.Slot,CQz j *‖Zaux (p,u) (j,v)‖) ≤ ξ:=by
    have hx:= hv' (p,u); unfold Tap.paidX at hx; rw [Fintype.sum_prod_type] at hx; exact hx
 simp_rw [hx,←Finset.mul_sum]; apply mul_le_mul_of_nonneg_left _ he; simp_rw [bow,mul_sum]; rw [sum_comm]; exact (sum_le_sum (fun i _=>hp i)).trans_eq (by simp [flavor]) -- tune
