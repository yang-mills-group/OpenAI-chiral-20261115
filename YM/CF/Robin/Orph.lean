lemma convXi (W':Orbit (mid N B))(Z:Orbit (mid P B))(v:Phys (mid P B))(P':Haro.SpaceM)(D:Girt.BaseL U G Y G₀ G₁ q kL): inner ℂ (mateK _) (lynx K S G G₁ G₁ G₀ Y q kL P'.val W' Z v)= S.density Y.beta Z.1 W'.1 • beamL (mid P B) v:=by
 let Q:= (ratio G); letI : Nonempty (Forest Q):= Tree.select Q (D.power.symm ▸ R.odd_side)
 let A:ℝ:=S.density Y.beta Z.1 W'.1; let UΨ(i) := coal_X (K:=K) (Y:=Y) (G₀:=G₀) (G₁:=G₁) (q:=q) (kL:=kL) W' (i:Forest Q) Z v -- coal_X private? public
 let L:=beamL (mid N B); have hg(i):L (A • scaleZ P'.val (UΨ i))=A • beamL _ v:=by
    rw [map_smul,show L (scaleZ ..)= _ from Scree.shoulderL (N:=mid N B) P' (UΨ i)]
    refine congrArg (fun x:ℂ=>A • x) ?_
    have hx:= Spire.shuttle G D.power D.size _ (D.trial i (G₁ Z) W') D.pe Y.J.M; exact (hx.2 (cartsL (switchG G).symm v)).trans (Fock.sigh (switchG G).symm.toEmbedding _ (shelfG ..) _ _) -- may need unfolding
 have hp:Fintype.card (Forest Q)≠0:=Fintype.card_ne_zero
 change L _=_; unfold lynx; simp_rw [ContinuousLinearMap.smul_apply, ContinuousLinearMap.sum_apply,Complex.coe_smul]; rw [map_smul,map_sum]; change (Fintype.card (Forest Q):ℝ)⁻¹ • (∑ i,L (A • scaleZ P'.val (UΨ i)))=A • beamL _ v; simp only [hg,sum_const,card_univ,nsmul_eq_mul,Complex.real_smul,Complex.ofReal_natCast,Complex.ofReal_inv]; rw [←mul_assoc]; rw [inv_mul_cancel₀ (by exact_mod_cast hp),one_mul] -- maybe ←mul_assoc only once
end erase
