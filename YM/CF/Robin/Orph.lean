lemma colP(l:List J) :Integrable (fun (v:Orbit (mid N B)× Orbit (mid P B))=> (lynx K S G G₁ G₁ G₀ Y q kL Xp v.1 v.2) (tipI (fun z=> Scree.denZ (RΓ z) U G₁ v.2) l)) ((Scree.city _).prod (Scree.city _)) :=by
 let T':= Orbit (mid N B) × Orbit (mid P B); let Ζ:=fun z=> uncurry (integrated U G₀ (RΓ z) G₁ G S q kL Xp); let L(v:T'):= lynx K S G G₁ G₁ G₀ Y q kL Xp v.1 v.2; let D(z:Key J):=Ωz z; have hp'(v): River (fun z=> D z v):=by
    let R:= fun (_:J)=> ()
    have he {E:Type}[NormedAddCommGroup E][NormedSpace ℂ E][CompleteSpace E]{g:Key J→E}(p:River g): Law_C R 0 [] g g:=⟨p,p,fun i u=>by rw [List.sublist_nil.mp u]; rfl⟩
    exact (pulse_H (N:=P) (B:=B) V R 0 [] (by simp [ψS]) _ _ _ _ _ _ _ _ _ _ v (fun i x=> he (h_ i x)) (fun i x=>he (hL ..)) (fun i x=> he (hK ..)) (he hp)).1 -- tune
 have hu(x:T') : (fun z=> Ζ z x)= (L x) ∘ fun z=> D z x.2 := funext (fun z=>part_β ..)
 let A:= ↑(hill J) × T'; let i'(i:A) :Key J:= i.1.val; let X(x:A):=x.2.1; let Y'(x:A):=x.2.2; let F(i:A):=D (i' i) (Y' i)
 obtain ⟨w,t⟩:=τMood V hΩ Xp X Y' F (mentor_W V _ _ _ s0 hΩ ht uLamp hp Y' i' (fun i=> i.1.property)) hT H
 let μ:Measure T':=(Scree.city _).prod (Scree.city _); have hv(z)(v:z∈hill J):AEStronglyMeasurable (Ζ z) μ:=by
    obtain ⟨K⟩:= Neon.EBay V h hΩ _ _ _ _ (uLamp z v); exact (Girt.buoy K S hT H Xp).meas.aestronglyMeasurable
 have hf(z)(v:z∈hill J):∀ᵐ x∂μ,‖Ζ z x‖ ≤ max w 0:= ae_of_all _ fun x=>(show Ζ z x= (L x) (D z x.2) from congrFun (hu x) z) ▸ ((t (⟨⟨z,v⟩,x⟩:A)).trans (le_max_left ..)) -- identity rw expected
 obtain ⟨p,t,h⟩:= rivA Ζ μ (fun x=>by rw [hu]; exact sc_V (hp' _) (L x)) hv (le_max_right ..) hf l
 have ht(v:T'):tipI (fun z=>Ζ z v) l=(L v) (tipI (fun z=>D z v.2) l):=by rw [hu]; exact sim_H (hp' _) (L v) l roots
 simp_rw [ht] at t; exact t
