lemma feast_ξ : tallyT F1Q=Roots.snow σ' C (fun l=>tallyT (N:=P) (B:=B) (hΨ l)) lA:=by
 let Kμ:(Orbit (mid N B))→ Phys (mid N B):= F1Q; let L:= beamL (mid N B); let Z' (l:List J)(v:(Orbit (mid N B))×(Orbit (mid P B))):= lynx K S G G₁ G₁ G₀ Y q kL Xμ.val v.1 v.2 (hΨ l v.2); let G'(l:List J)(v:(Orbit (mid N B))):=∫ y:(Orbit (mid P B)),Z' l (v,y) ∂(Scree.city (mid P B))
 let M:= (innerSL ℂ (mateK (mid N B))) -- tune
 have hk(v:(Orbit (mid N B))): M (Roots.snow σ' C (fun i=> G' i v) lA)=Roots.snow σ' C (fun i=> L (G' i v)) lA := (tally_l σ' C M _ _).symm
 have hZ(l:List J): (∫ v:(Orbit (mid N B)), L (G' l v) ∂(Scree.city (mid N B)))= ∫ i:(Orbit (mid N B))×(Orbit (mid P B)), L (Z' l i) ∂(((Scree.city (mid N B))).prod (Scree.city (mid P B))):=by
    have ht:=piτ l; rw [L.integral_comp_comm (piτ l), integral_prod (Z' l) ht]; exact L.integral_comp_comm ht.integral_prod_left
 have ht(l:List J):(∫ i:(Orbit (mid N B))×(Orbit (mid P B)), L (Z' l i) ∂(((Scree.city (mid N B))).prod (Scree.city (mid P B))))= tallyT (N:=P) (B:=B) (hΨ l) :=by
    rw [integral_prod_symm _ (L.integrable_comp (piτ l)),tallyT]; apply integral_congr_ae; refine ae_of_all _ fun i=>?_ ; change (∫ v:(Orbit (mid N B)), L (Z' l (v,i)) ∂Scree.city _)=_; simp_rw [show ∀ v,L (Z' l (v,i))=S.density Y.beta i.1 v.1 • beamL (mid P B) (hΨ l i) from fun v:(Orbit (mid N B))=> convXi V v i (hΨ l i) Xμ hΩ, integral_smul_const]; have hp:= (S.isKernel H Y.beta).integrable i.1; rw [Scree.city,integral_prod]; swap; · exact hp.comp_fst (depot (mid N B))
    simp only [integral_const, probReal_univ,one_smul,(S.isKernel H Y.beta).total,one_smul]
