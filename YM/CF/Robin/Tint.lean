 induction lA generalizing FΩ with
 | nil=> exact ⟨h _,rfl⟩
 | cons i s ih=>
    let G(k:J)(x:A):=Roots.snow σ' C (fun l=>FΩ (k::l) x) s; let U(k:J):=fun x:A=> C k i • G k x; have hp(k):Integrable (U k) μ :=(ih (fun l=> FΩ (k::l)) fun l=>h (k::l)).1.smul _ -- check
