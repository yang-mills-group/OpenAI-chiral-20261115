lemma sails {E₀ v:ℝ} (T:Investment P E₀ v)(W:Dispatchers P)(Z:Meritorious P)(d m:ℕ)(p:0<A)(l:0<α)(a:α≤1) :
    ∀ᶠ s:ℕ in atTop,∀ᶠ v:ℕ in atTop, let i:=iA v; let k:=kA v; ViewTickets (E:=E₀) Y s i k H d A ∧ evenPose Y s i ∧ ∀ (B:ℕ)(F:Hookah (side Y i s))(ρ:ℝ) {I:Type u}[Fintype I] (V:Vessel SU.group (More (side Y i s)) I) (Φ:(I→ℝ)→ℂ), Broom Y s i k V A α ρ B d m F Φ → ‖Journey.compass Y i k s F.x-seatT Y s i k V Φ ρ‖ ≤ chip (hat P.R.L P.x s) (-3) := by
 filter_upwards [gala Y U Q T W Z d p l a,dye_funds P d m A p] with s h u
 filter_upwards [h, (U.pick.grow_i.comp Q.growsA).tendsto_atTop.eventually (bone_pose Y (nontrivial_spin P) s)] with v t e
 intro i k; obtain ⟨c,r,p,v,t⟩:= t; exact ⟨v,e, fun B F f I i' W Φ l=> t B F _ l.tickets (l.receive Y s i k W u p.paid e v)⟩

