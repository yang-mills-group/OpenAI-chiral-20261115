include Y1
lemma silky (pb:Plush Z0 Λr): Silks J p p' x Λr q (articles (Z0:=Z0) Ty Vq) w Ω:=by
 constructor; intro β F t u Z pE Δt μ E k; obtain ⟨v,h,H⟩:= reside Ty T Vq hv t Ω Y1 u pE Δt μ E k
 let pB:= T.member (matured Ty T Vq hv _ t).1 t.1; let ϒ:=retail (F:=F) (Z0:=Z0) Y1 pB
 have hp:v.re=Real.log ‖ϒ‖+μ:=expn ϒ _ _ (by change _=ϒ* _; exact (h.trans (by rw [show (Pitching.input (V:=V) (w:=w) p' β F).v=0 from rfl,Complex.exp_zero,mul_one])))
 refine ⟨v,⟨fun i s=>(H i s).symm⟩,(by rw [hp,show Real.log ‖ϒ‖+μ-QuoteV V w β=(Real.log ‖ϒ‖ - QuoteV V w β)+μ by ring]; exact (abs_add_le _ _).trans (add_le_add_left (pb.sap Y1 β F (matured Ty T Vq hv _ t).1 pB) _))⟩
