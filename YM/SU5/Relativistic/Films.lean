lemma Launch.uniqueRe {F:Corr ηt}{E:Corr ι}{u v b:ℂ}{g:SpaceM}{Δ:ℝ} (H:Launch p p' w U q J.d E F β Δ u v g) (Hτ:Launch p p' w U q J.d E F β Δ u b g)(pA:p.threshold>0) (P0: RocketV V m n U W J w.coarse w.G q) : v.re=b.re:=by
 let Xs:= w.buildOut V p (β+w.movement V-Δ) E; let y:Orbit ι := (1,Classical.arbitrary _)
 have he:Rue.FleetS p.threshold y.1:=fun j=>by change SU.group.chord (faceValue (1:Config SU.group (More _)) j) ≠_; rw [SectorNext.Vacuum.chord_suc]; exact pA.ne
 have hv: denZ (Xs 0) U w.coarse y≠0:=by
    let x:= Xs 0; let p':=spar K.j x.J.M (w.coarse y); have hp:=J.gran.trans P0.size; have h':= (P0.paid.paid y).shrink J.hr.le; have hY:IsStarProjection p':= (U.broadness _ hp x.J.M).projection _ h'
    unfold denZ; apply smul_ne_zero (Complex.exp_ne_zero _); change acts (tank p' (x.board y)) (relV _ _ _) ≠ 0
    rw [GramM.board, fuel_one x.p x.K y (show RG.flags x.p.threshold y.1=∅ from ?_), Graph.shape p' _ 1 hY,tank_eq p' 1 hY,map_one,mul_one]; swap
    · change RG.flags p.threshold y.1=∅; apply Finset.eq_empty_iff_forall_notMem.mpr; intro i g; obtain ⟨p,i_p,Vcq⟩:= (flags_spec ..).mp g; rw [show SU.group.chord (faceValue y.1 p)=0 from SectorNext.Vacuum.chord_suc p] at Vcq; exact lt_asymm pA Vcq
    letI : NormedAlgebra ℚ (FC (Single ι)):= NormedAlgebra.restrictScalars ℚ ℝ (FC (Single ι))
    have hu(A:FC (Single ι))(v:Wave (Single ι))(e:v≠0): acts (exp A) v ≠0:= fun p=> e (by
        have he:=congrArg (acts (exp (-A))) p; rw [← act_mul, ← exp_add_of_commute (x:=-A) (y:=A) (Commute.refl A).neg_left,neg_add_cancel,NormedSpace.exp_zero,act_one,map_zero] at he; exact he)
    apply hu; unfold relV; apply hu; apply norm_ne_zero_iff.mp; rw [(sea_g hp (w.coarse y) h' _).2]; exact one_ne_zero
 have hf(z:ℂ): denZ (Xs z) U w.coarse y=Complex.exp z • denZ (Xs 0) U w.coarse y:=by
    simpa only [zero_add] using mountR U w.coarse (Xs z) y 0 z
 have hQ: Real.exp v.re= Real.exp b.re := by rw [←Complex.norm_exp,←Complex.norm_exp]; congr 1; exact smul_left_injective ℂ hv ((hf v).symm.trans (((H.wear y he).trans (Hτ.wear y he).symm).trans (hf b))) -- orientation
 exact Real.exp_injective hQ
