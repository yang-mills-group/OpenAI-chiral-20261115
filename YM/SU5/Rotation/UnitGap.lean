/-!
# The two *whole-word* computations on this character

The domain for the obstruction is `Reconstruction.Pol`, i.e. the existing system
of gauge-invariant resolution polynomials with physical support and overlapping
products. Finite-stencil/table version of smearing, §2 of f9574346; even per slot.
We do not identify the pinhole at 0 with the pinhole of its lift!
-/
set_option autoImplicit false
set_option synthInstance.maxSize 30000
set_option maxRecDepth 6000
set_option maxHeartbeats 400000
set_option quotPrecheck false
noncomputable section

namespace YM.CF.Buffered.Afterglow.Tower.Reconstruction.RotationObstruction
open Function Filter Metric NormedSpace SU Lat Lattice Wilson Cube Finset Mir Phase MeasureTheory RP Reflect Advance Nacre Spire Scroll Peaks Rush Tulip Skye Window Vale Girt
open Push.SectorMeasure RG Lifted Scree ProbabilityTheory Py Py.Rate LocalLimit FullBill Sound Common
open scoped Topology Matrix MatrixOrder Matrix.Norms.L2Operator BigOperators Kronecker ComplexOrder InnerProductSpace NNReal ENNReal Classical
attribute [local instance] opCStarAlgebra
open Preparation Journey Satin Heat Fock Analysis SlabMark Vacancy SatinVerification
open Tapestry Tapestry.Altitude PhaseChoice
open Exhibition Tower.Selected Tapestry.RotationGap
open PiTensorProduct (tprod)

variable {Λ:Preparation} {l:ℕ} (Y:Course Λ (VolumeCape.Dream.Nimbus l)) (H:Real.exp 1 ≤ Λ.x)
variable {a b:ℕ→ℕ} {I:ℕ→Family (tent Y H)→ℕ→ℂ} {E:ℕ→Family (tent Y H)→ℂ} {L:Rack Λ l} {B: Clay Λ l}
local notation "K" => tent Y H
local notation "Δ" => Dome (tent Y H)

section contact
variable (D: Exhibition Y H a b I E L B) (p : Face ℤ)
local notation "X₀" => RotationGap.plaque (tent Y H) p
local notation "A" => liftD Y H 0 D
local notation "S₀" => RotationGap.sites p
local notation "S₁" => followBox (Λ:=Λ) (l:=l) (RotationGap.sites p)

/-- Slot 0 plaquette. -/
def coarseW : Altitude.Cloud (Dome (tent Y H)) := pinhole (Dome (tent Y H)) 0 (plaque (tent Y H) p)

/-- Slot 0 versus slot 1 (no inverse yet). -/
def differenceJ : Altitude.Cloud (Dome (tent Y H)) :=
  coarseW Y H p - pinhole (Dome (tent Y H)) 1 (liftD Y H 0 D (plaque (tent Y H) p))

/-- The bounded Borel inverse as an admissible finer test. -/
def inverseV : Altitude.Cloud (Dome (tent Y H)) :=
  pinhole (Dome (tent Y H)) 1 (reciprocalD Y H 0 D p)

/-- The local mixed-level observable that will retest motion. -/
def retestJ := differenceJ Y H D p * inverseV Y H D p

-- At the footprint itself, which has no open slack. `PolAt` uses handstamp.
local notation "U₀" => footprint Λ l 0 (RotationGap.sites p)
local notation "J" => retestJ Y H D p
local notation "W" => coarseW Y H p

lemma coarse_in : W ∈ PolAt Y H 0 U₀ :=
  oneSlotWell Λ K l true (handstamp U₀) _ 0 (by simp)
    ((keeps ..).2 ⟨RotationGap.sites p, plaque_bay _ _ true, has_footprint Λ l 0 S₀⟩)
    (plaque_enclave (tent Y H) p)

lemma up_kept : printedHere Λ l 1 S₁ (handstamp U₀) :=
  shielding Λ l 0 _ S₀ (has_footprint Λ l 0 S₀)

lemma average_in : pinhole Δ 1 ((A) X₀) ∈ PolAt Y H 1 U₀ :=
  oneSlotWell Λ K l true (handstamp U₀) _ 1 (by simp)
    ((keeps ..).2 ⟨S₁, D.risePay Y H 0 S₀ (plaque_bay K p true),up_kept (Λ:=Λ) (l:=l) p⟩)
    (D.riseGauge Y H 0 (plaque_enclave (tent Y H) p))

lemma difference_in : differenceJ Y H D p ∈ PolAt Y H 1 U₀ :=
  (PolAt Y H 1 U₀).sub_mem (polAt_up Y H (by decide : (0:ℕ) ≤ 1) (coarse_in ..))
    (average_in ..)

lemma inverse_in : inverseV Y H D p ∈ PolAt Y H 1 U₀ :=
  oneSlotWell Λ K l true (handstamp U₀) _ 1 (by simp)
    ((keeps ..).2 ⟨S₁, reciprocalD_bay Y H 0 D p, up_kept (Λ:=Λ) (l:=l) p⟩) (reciprocalD_enclave Y H 0 D p)

lemma retest_in : J ∈ PolAt Y H 1 U₀ := (PolAt Y H 1 U₀).mul_mem (difference_in ..) (inverse_in ..)

lemma word_in : J * W ∈ PolAt Y H 1 U₀ := (PolAt Y H 1 U₀).mul_mem (retest_in ..)
  (polAt_up Y H (by decide : (0:ℕ) ≤ 1) (coarse_in ..))

/-- Ambient algebra generated by **all** slots ≥1; allow also non-singlets amongst
those polynomials. Exactly the all-space jetty restricted to that level set. -/
def highOnly : Subalgebra ℂ (Altitude.Cloud (Dome (tent Y H))) :=
  jetty Λ l K true Set.univ (Set.Ici 1)

def highOnlyAt (n:ℕ) : Subalgebra ℂ (Altitude.Cloud (Dome (tent Y H))) :=
  jetty Λ l K true Set.univ (Set.Ici 1 ∩ Set.Iic n)

theorem highOnly_generated : highOnly Y H = Algebra.adjoin ℂ (⋃ i∈ Set.Ici 1,
    (pinhole Δ i) '' Set.univ) := by
  unfold highOnly
  rw [generating]
  simp_rw [fullKeep,vestibuleFull]; rfl

lemma high_short (n:ℕ) : highOnlyAt Y H n ≤ boardedDB K n := jettyBan ..
lemma runs_out {x : Altitude.Cloud Δ} (hx : x ∈ highOnly Y H) :
    ∃ n:ℕ, 1 ≤ n ∧ x ∈ highOnlyAt Y H n := by
  obtain ⟨n,h⟩ := entrusted Λ l K true Set.univ (Set.Ici 1) hx
  exact ⟨n+1,by omega,admits Λ l K true Set.univ Set.univ _ _
    (Set.inter_subset_inter_right (Set.Ici 1) (Set.Iic_subset_Iic.mpr (by omega : n ≤ n+1)))
    Set.Subset.rfl h⟩

lemma inverse_high (n:ℕ) (h : 1 ≤ n) : inverseV Y H D p ∈ highOnlyAt Y H n :=
  pokes (Set.Ici 1 ∩ Set.Iic n) (fun i => keep Λ l i K true Set.univ)
    (show 1∈ Set.Ici 1 ∩ Set.Iic n from ⟨by simp,h⟩)
    (show reciprocalD Y H 0 D p ∈ keep Λ l 1 K true Set.univ by
      rw [fullKeep,vestibuleFull]; exact Algebra.mem_top)

local notation "V" n:max => vistaFinish Y H n D

private theorem oneMore (n:ℕ) {x} (hx:x∈ boardedDB K n) :
    vistaFinish Y H (n+1) D x = (liftD Y H n D) ((V n) x) :=
  Decking.joins (vistaDressing Y H D) n x (auxiliaryPad K) hx

private theorem coarse_step (x : Dome K) : (V 1) (pinhole Δ 0 x) = (A) x := by
  rw [oneMore Y H D 0 (short_pinhole 0 x)]
  congr 1; unfold vistaFinish; rw [Decking.outcrop]; rfl

private theorem last (n:ℕ) (f : Altitude.Cloud Δ) (h : f ∈ boardedDB K n) (g : Dome K) :
    (V n) (f * pinhole Δ n g) = (V n) f * g := (vistaDressing Y H D).last (auxiliaryPad K) f n h g

/-- Prefix identity on the overlapping `J*W`: multiply the two slot-zero emissions
before advancing. Then multiply in slot 1, not once more through the kernel. -/
theorem JW_one : (V 1) (J * W) = 1 := by
  let f := pinhole Δ 0
  let g := pinhole Δ 1
  let y := (A) X₀
  have hz : W=f X₀ := rfl
  have he : W∈ boardedDB K 1 := Altitude.climbs Δ (by decide : (0:ℕ) ≤ 1) (inside_budget Y H (coarse_in Y H p))
  have h : (V 1) (differenceJ Y H D p * W) = varianceD Y H 0 D p := calc
    _ = (V 1) (f (X₀^2)) - (V 1) (W * pinhole Δ 1 y) := by
      unfold differenceJ; rw [_root_.sub_mul, map_sub, hz, map_pow, pow_two]
      change (V 1) (f X₀ * f X₀) - (V 1) (g y * f X₀) = _; rw [mul_comm (g y) (f X₀)]
    _ = varianceD Y H 0 D p := by
      unfold f; rw [RotationObstruction.last Y H D 1 W he y, coarseW, coarse_step, coarse_step]
      simp only [varianceD,pow_two,y]
  rw [retestJ,mul_right_comm, inverseV,last Y H D 1 _
    ((boardedDB K 1).mul_mem (inside_budget Y H (difference_in ..)) he) _,h]
  exact reciprocalD_inv ..

theorem JW_above (n:ℕ) (v : 1 ≤ n) : (V n) (J * W) = 1 := by
  induction n, v using Nat.le_induction with
  | base => exact JW_one ..
  | succ n h ih => rw [oneMore Y H D n (Altitude.climbs Δ h (inside_budget Y H (word_in ..))), ih]; exact D.onePlaster Y H n

/-- Already just the difference is annihilated in any such prefix. -/
private lemma pure_diff (n:ℕ) (x : sequenceOf K) (t:x 0=1) (h:Altitude.Enough n x)
    (hn:1 ≤ n) : (V n) (differenceJ Y H D p * tprod ℂ x)=0 := by
  let u := update (1:ℕ→Δ) (0:ℕ) X₀ * x
  let y := (A) X₀
  let v := update (1:ℕ→Δ) (1:ℕ) y * x
  let Q := vistaDressing Y H D
  have he (m:ℕ) (hm:1 ≤ m) : Q.finish m u = Q.finish m v := by
    induction m, hm using Nat.le_induction with
    | base =>
      change (A) (u 0) * u 1 = (A) (v 0) * v 1
      simp [u,v,t,D.onePlaster Y H,y]
    | succ i hi ih =>
      have hz : u (i+1) = v (i+1) := by
        simp [u,v,update_of_ne (show i+1≠1 by omega)]
      rw [Decking.finish, Decking.finish, ih, hz]
  rw [differenceJ, coarseW, _root_.sub_mul, map_sub]
  refine sub_eq_zero.mpr ?_
  have ha : pinhole Δ 0 X₀ * tprod ℂ x = tprod ℂ u := PiTensorProduct.tprod_mul_tprod ..
  have hb : pinhole Δ 1 y * tprod ℂ x = tprod ℂ v := PiTensorProduct.tprod_mul_tprod ..
  have hx : Altitude.Enough n u := ((enough_slot 0 X₀).taller n.zero_le).together h
  have hy : Altitude.Enough n v := ((enough_slot 1 y).taller hn).together h
  change (Q.crown _ n) _ = (Q.crown _ n) (pinhole Δ 1 y * tprod ℂ x)
  rw [ha,hb]; simp only [Q.reckon_paid n (auxiliaryPad K) hx, Q.reckon_paid n (auxiliaryPad K) hy, he n hn]

private lemma diff_word (n:ℕ) (hn : 1 ≤ n) {x : Altitude.Cloud Δ} (hx:x∈ highOnlyAt Y H n) :
    (V n) (differenceJ Y H D p * x)=0 := by
  let r := Set.Ici 1 ∩ Set.Iic n
  let F (i:ℕ) := keep Λ l i K true Set.univ
  apply boarded (P:={x | Officer r F x}) (M:=fun x=> (V n) (differenceJ Y H D p * x)=0) ?_
    ?_ ?_ ?_ hx
  · intro x (h : Officer r F x)
    exact pure_diff Y H D p n x (h.forbids 0 (by simp [r])) (h.visible r F Set.inter_subset_right) hn
  · rw [mul_zero,map_zero]
  · intro x y _ _ hx hy; rw [mul_add,map_add,hx,hy,zero_add]
  intro z x _ hx; rw [Algebra.mul_smul_comm,map_smul,hx,smul_zero]

theorem J_annihilates (n:ℕ) (hn : 1 ≤ n) {x : Altitude.Cloud Δ} (hx:x∈ highOnlyAt Y H n) :
    (V n) (J * x)=0 := by
  rw [retestJ,mul_assoc]; exact diff_word Y H D p n hn
    ((highOnlyAt Y H n).mul_mem (inverse_high Y H D p n hn) hx)

theorem J_finishes (n:ℕ) (hn : 1 ≤ n) : (V n) J = 0 := by
  simpa only [mul_one] using J_annihilates Y H D p n hn (highOnlyAt Y H n|>.one_mem)

-- Barycenter computation of the whole words, also not a product of readings.
theorem mean_paid : vistaTake Y H D (J * W)=1 ∧
    ∀ x∈highOnly Y H, vistaTake Y H D (J*x) = 0 := by
  constructor
  · rw [vistaCall Y H 1 _ D (inside_budget Y H (word_in ..)), JW_one, planet1]
  intro x hx
  obtain ⟨n,hn,h⟩ := runs_out Y H hx
  rw [vistaCall Y H n _ D ((boardedDB K n).mul_mem
    (Altitude.climbs Δ hn (inside_budget Y H (retest_in ..))) (high_short Y H n h)),
    J_annihilates Y H D p n hn h, map_zero]
end contact

section read
variable {T:ℕ→ℕ→Tariff} {t:ℕ→Tariff} (D:Fashion Y H a b I E L B T t)
    (G:GroundExtension (i:=a) (k:=b) (E:=E) Y H) (C:∀ j:Axis, Tower.Arena Y H G.history.circuit j 0 false)
    (χ: (displayAlgebra Y H D.univ_ G.history G.clipped 0 false (C 0)) →⋆ₐ[ℂ] ℂ)
    (p:Face ℤ)
local notation "J" => retestJ Y H D.toExhibition p
local notation "W" => coarseW Y H p
local notation "S" => sch Y H D G C χ
local notation "U₀" => footprint Λ l 0 (RotationGap.sites p)

theorem selected_JW : (S) (J * W)=1 := by
  rw [sch_mark Y H D G C χ 1 (inside_budget Y H (word_in ..)),JW_one,Tower.Selected.response,
    show fieldArg Y H 1=1 from rfl, located_one, map_one]

theorem selected_JZ {x : Altitude.Cloud (Dome (tent Y H))} (h:x∈highOnly Y H) :
    (S) (J*x)=0 := by
  obtain ⟨n,hn,h⟩ := runs_out Y H h
  rw [sch_mark Y H D G C χ n ((boardedDB K n).mul_mem
    (Altitude.climbs Δ hn (inside_budget Y H (retest_in ..))) (high_short Y H n h)),
    J_annihilates Y H D.toExhibition p n hn h, Tower.Selected.response,
    show fieldArg Y H 0=0 from rfl,map_zero,map_zero]

/-- Unit gap on the actual physical algebra: these two gauge singlets on the same physical
support as the plaquette, and this very exhibition D, panel system, character. Targets `x`
include all gauge-invariant polynomials of **any** higher resolutions (even all ambient ones).
No restriction to single pinholes, nor a norm-bound qualification. -/
theorem unit_gap :
    W ∈ Pol Y H U₀ ∧ J ∈ Pol Y H U₀ ∧ (S) (J*W) = 1 ∧ ∀ x∈highOnly Y H, (S) (J*x)=0 :=
  ⟨pol_of_level Y H (coarse_in ..), pol_of_level Y H (retest_in ..), selected_JW ..,
    fun _ h => selected_JZ Y H D G C χ p h⟩

/-- Contact is different from the reflected selected form. In fact J in the reflected
form, for such a positive-time placement, gives **zero** against W. This is all on the
`Pol` algebra. -/
theorem J_reflected (h : footprint Λ l 0 (RotationGap.sites p) ⊆ flank 0 0) :
    (S) ((Sunlight.oppose Λ 0 (PhaseChoice.atZero Λ) (tent Y H)) J * W)=0 := by
  let j' : PolAt Y H 1 (flank 0 0) := ⟨J,isotone Y H h (retest_in ..)⟩
  let w' : PolAt Y H 1 (flank 0 0) := ⟨W,isotone Y H h
    (polAt_up Y H (by decide : (0:ℕ) ≤ 1) (coarse_in ..))⟩
  have hj : preparePoly Y H D 0 1 j'=0 := by
    apply Subtype.ext
    change ((vistaFinish Y H 1 D.toExhibition) J).val = 0
    rw [J_finishes Y H D.toExhibition p 1 le_rfl]; rfl
  have he : locatePoly Y H D G C χ 0 1 j'=0 := by
    unfold locatePoly; rw [LinearMap.comp_apply,LinearMap.comp_apply,hj,map_zero,map_zero]
  exact ((poly_gram Y H D G C χ 0 j' w').symm).trans (by rw [he,inner_zero_left])
end read
