-- T= (305+305+1)^4 as in Magi.till_q with l=5. `b` at this point = p.B.
abbrev reach305 : ℕ := (305+305+1)^4
lemma noncashRange (E:RegBudget ι)(A:Cusp ι)(hp: YM.CF.Py.Lunar (H:=Up β) (Uφ:=Lz) (Y:=Ys β F) (X:=Xs β) V o.SheepR D.D Vq C' D.X D.jp Ty E A)
    (t:∀i∈ forge_P (H:=Up β) (Y:=Ys β F) (X:=Xs β) V o.SheepR D.D Vq C' D.X D.jp, coverNumber p.B (ref_Q x i).val ≤ reach305): Test.OnlyHere p reach305 (noncash_E (p:=p) (p':=p') (o:=o) Vq F) :=by
 obtain ⟨f,hv,hQ,hz⟩:=hp.pay; let G:= S0 (pennies F.1); have he: f=G:=by funext i V'; apply Subtype.ext; rw [hv,birth]
 subst f; let L:= forge_P (H:=Up β) (Y:=Ys β F) (X:=Xs β) V o.SheepR D.D Vq C' D.X D.jp
 have hu(x:Ξm)(g:x ∉ L) : G x= 0 := by
    funext i; apply Subtype.ext; rw [hv, show glasp _ _ _ _ _ _ _ _=0 from not_not.mp fun t=> g (mem_filter.mpr ⟨mem_univ _,t⟩),thaw_v]; rfl
 have a0 : Test.OnlyHere p reach305 (earthBranch (x:=x) G) := by
   intro i v; apply sum_eq_zero; intro j h
   apply sum_eq_zero; intro s p
   apply hu; intro l; have ht:= t s l
   apply v.not_ge; apply le_trans _ ht; apply Corona.cover_mono
   rw [←(mem_filter.mp h).2,←(mem_filter.mp p).2]
   exact (show (ref_B x s).val ⊆ (ref_Q x s).val from subset_union_right) -- defeq
 have a1 : Test.OnlyHere p reach305 (sunBranch (o:=o) G) := by
   intro i v; apply sum_eq_zero; intro j h
   apply sum_eq_zero; intro s p
   apply hu; intro l; have ht:=t s l
   apply v.not_ge; apply le_trans _ ht; apply Corona.cover_mono
   rw [←(mem_filter.mp h).2,keep_h, ← (mem_filter.mp p).2.2]
   exact (show (ref_A s).val ⊆ (ref_Q x s).val from subset_union_left)
 exact (a0.sub a1).writ
end Lunar

variable (hv:Rill.Arch w.G d) (hm:hv.val=1){γ:ℝ}
variable (tF:Charged p' w.input K.j R.L.val h ff F)
include Uq Q hm tF Ty
-- stat/cell receipt on forge at these inputs, no extra hypothesis on Lunar itself.
lemma noncashLimited : Test.OnlyHere p Lunar.reach305 (noncash_E (p:=p) (p':=p') (o:=o) hv F) := by
 obtain ⟨T,g,E,G,Bx,q,e,-⟩:= Uq.sharp Ty Q tF
 have pB:Bx=hv:= Subtype.ext (q.trans hm.symm); subst Bx
 apply Lunar.noncashRange Ty hv E G e
 let u:= Uq.press_f tF
 let Zb:= Z.toLid.crew β Q|>.1
 let U0:=Uq.layout.full β Q F u
 obtain ⟨Qx,Qv,Fq⟩:= Pig.sail_t V (H₀:= Ys β F) (H₁:= Xs β) (M_:=o.SheepR)
 intro i t; have Kz:= till_q V D.pilot D.Z U0.statv o.SheepR Zb D.D hv Qx Qv Fq C' D.X D.jp i t
 refine (Corona.cover_mono Kz p.B).trans ?_; have hp:= Z.request.boot.B; rw [← hp]; exact Corona.tile _ 305 p.B p.B_pos
