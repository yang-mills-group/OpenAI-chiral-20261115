 -- simultaneous all customers. real finite valuation at actual chosen periods, THE true operator at s NOT
 -- made constant in i,k! Instead import estimate to pressure of unit norm limit charts later.
 offers (z:SU.Slot) : let F:=taggin Y s i k q d w (grain (payout d q w)) z
      (∀ X:Fields _,‖F.frame X‖≤C) ∧ ∀(f:Buffered.Family (tent Y H))(l:ℕ)(s0:ℤ)(j:Axis), exhibit Y H s i f=F.frame →
            2*Mural.gong (tent Y H)*u*l ≤ (Papal.count Y s i).val → (Papal.count Y s i).val ≤4*Mural.gong (tent Y H)*u*l→
                ‖sharp Y H s i k (banner j u s0 l f)‖ ≤ Real.exp (-3000 * (l:ℝ))

