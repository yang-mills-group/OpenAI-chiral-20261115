lemma sees_sun (X W:Sky K)(P V':(J₀ j).Op)(d d' s s':Gt)(Z:(Q j) (m₁ (eject j (-s)) X) d P)
    (T:(Q j) (m₁ (eject j (-s')) W) d' V') (h:s+d ≤ s'): ∃ h': X*W∈D univ,
       osValue Y H V G a (C a) χ ⟨X*W,h'⟩= inner ℂ Ω ((Π₀ j) P ((S).E (Real.toNNReal ((s'-(s+d): Gt):ℝ)) ((Π₀ j) V' Ω))):= by
 let q:D' j:=⟨1,domain_one ..⟩; let p:=eject j s; let x:=eject j s'; let f:=x+eject j d'
 have a0:x-(p+eject j d)=eject j (s'-(s+d)):= by unfold x p; simp only [sub_eq_add_neg,← eject_neg,selectRay]
 have hq : (Vo j) q=Ω:= comesHome Y H V G C a χ j; obtain ⟨hp,he⟩:= purchases Y H V G j (C j) (w j) (F.present j) _ _ _ _ P V' p f p x q q Z T (by simp) (by rw [a0,eject_at]; exact (show (0:Gt) ≤_ from sub_nonneg.mpr h)) (by unfold f; simp)
 have e0(v:Sky K)(s:Gt): (m₁ (eject j s)) (m₁ (eject j (-s)) v)= v:= by rw [move_sum,selectRay,add_neg_cancel,eject_zero,move_by_zero]
 have hv : tab K p p x f ((θ j) (1:Sky K)) (m₁ (eject j (-s)) X) (m₁ (eject j (-s')) W) 1= X*W:=by unfold tab x p; rw [flipMark_unit,move_unit,move_unit,e0,e0,mul_one,one_mul]
 let y:D univ:=⟨_,hp⟩; have hY: y.val=X*W:= hv; refine ⟨hY ▸ y.property,?_⟩
 rw [← os_across Y H V G a (C a) χ j (C j),show (⟨X*W,_⟩: D univ)=y from Subtype.ext hY.symm]; rw [hq,sub_self,a0,bridge_time,show f-(x+eject j d')=0 from sub_self _] at he
 rw [show (Pr j) 0=1 from ?_] at he; exact he
 rw [show (0:placement Λ)=eject j 0 from (eject_zero ..).symm,bridge_time]; rw [AddSubgroup.coe_zero,Real.toNNReal_zero, OS.Semigroup.eZero]; rfl
