import YM.SU5.Reconstruction.Seams.Lift
import YM.SU5.Reconstruction.Cone.Pressure
/-!
# Slit analyticity in the physical transverse direction generated by the forward cone

YP(S) in OS sense; no mixing with only real-time. -/
set_option autoImplicit false
set_option quotPrecheck false
noncomputable section
namespace YM.ConePrice
namespace Sail
open Function Set Filter MeasureTheory Measure InnerProductSpace Spectral OS Semigroup Real Boundary Probe
open scoped BigOperators NNReal ENNReal Topology InnerProductSpace ComplexOrder Classical
variable {H : Hilbert} {a : Axis} (S : OS.Semigroup H a) (P : Forward S)
variable (x : Cross a) (hx : ‖x‖ ≤ 1) (t:ℝ≥0) (p:0<t)
local notation "Y"=> S.ℚmeasure
local notation "ρ" v:max=> S.ℚmeasure.diagonal v
local notation "I"=> Complex.I

def slit (t:ℝ) : Set ℂ := {x | |x.im| < t}
lemma slit_open (t:ℝ): IsOpen (slit t) := isOpen_lt (by fun_prop) continuous_const
lemma slit_connected (t:ℝ): IsPreconnected (slit t):= by
  have h : slit t = {x : ℂ | x.im<t} ∩ {x:ℂ| -t<x.im} := by ext x; simp only [slit,abs_lt,mem_inter_iff,mem_setOf_eq]; exact and_comm
  rw [h]; exact ((convex_halfSpace_lt Complex.imCLM.toLinearMap.isLinear t).inter (convex_halfSpace_gt Complex.imCLM.toLinearMap.isLinear (-t))).isPreconnected
lemma slit_ground (u:ℝ)(h:0<u)(x:ℝ): (x:ℂ)∈ slit u := by simp [slit,h]

def sees (t:ℝ≥0) (x : Cross a) (z:ℂ)(u:E4) : ℂ:= Complex.exp (((inner ℝ u x.val:ℝ):ℂ)*z*I-((u a:ℝ):ℂ)*((t:ℝ):ℂ))
noncomputable def fare (v : H) (z:ℂ): ℂ:= ∫ u:E4, sees t x z u ∂ρ v
include hx
lemma mantle {u:E4} (b:u∈front a) {z:ℂ} (_s: z∈ slit (t:ℝ)) :
    ‖sees t x z u‖ ≤ Real.exp (-((t:ℝ)-|z.im|)*u a):=by
  unfold sees; rw [Complex.norm_exp,Real.exp_le_exp]; simp only [Complex.sub_re,Complex.mul_re,Complex.mul_im,Complex.ofReal_re,Complex.ofReal_im,Complex.I_re,Complex.I_im,mul_zero,zero_mul,sub_zero,add_zero,mul_one,zero_sub]
  -- CS
  have hb:0≤u a:= (norm_nonneg _).trans b
  have hp : |inner ℝ u x.val|≤ u a:= by rw [cone_mean]; exact (abs_real_inner_le_norm (SEP a u) x).trans ((mul_le_of_le_one_right (norm_nonneg _) hx).trans b)
  have h := mul_le_mul_of_nonneg_right hp (abs_nonneg z.im); rw [←abs_mul] at h; linarith [abs_le.mp h|>.1]
omit p
include P
lemma field_integrable (v:H){z:ℂ}(s:z∈ slit (t:ℝ)) : Integrable (sees t x z) (ρ v) := by
  apply (integrable_const (1:ℝ) (μ:=ρ v)).mono' (by unfold sees; fun_prop)
  refine (forward_ae S v P).mono (fun u h=> (mantle x hx t h s).trans (Real.exp_le_one_iff.mpr ?_)); exact mul_nonpos_of_nonpos_of_nonneg (neg_nonpos.mpr (sub_pos.mpr (show |z.im|<(t:ℝ) from s)).le) ((norm_nonneg _).trans h)
include p
lemma candid : Candidate (slit (t:ℝ)) (fare S x t) (fun i:ℝ=> (S.U (i • x)).comp (S.E t)) := by
  let I₀ :0< (t:ℝ) := p
  refine ⟨slit_open _,slit_connected _,slit_ground _ (show 0<(t:ℝ) from p),fun v =>?_ ,fun v z s=>?_,fun v b=>?_⟩
  · refine DifferentiableOn.analyticOnNhd ?_ (slit_open _)
    intro z h; change |z.im|< (t:ℝ) at h
    apply DifferentiableAt.differentiableWithinAt; let V:= ρ v; let w (z:ℂ)(p:E4):= sees t x z p; let g(z:ℂ)(u:E4):= Complex.I*((inner ℝ u x.val:ℝ):ℂ)*sees t x z u
    let δ : ℝ := ((t:ℝ) - |z.im|)/2; let A:= slit ((t:ℝ)-δ); have H₁ : 0<δ:= by unfold δ; linarith
    have hf (p:E4)(q:ℂ) : HasDerivAt (fun z => w z p) (g q p) q:= by
      convert (((((hasDerivAt_id' q).const_mul ((inner ℝ p x.val:ℝ):ℂ)).mul_const Complex.I).sub_const (((p a:ℝ):ℂ)*(t:ℝ))).cexp) using 1 <;> try rfl -- tune parentheses
      unfold g sees; ring
    refine (hasDerivAt_integral_of_dominated_loc_of_deriv_le (F:=w) (F':=g) (μ:=V) (bound:=fun _=>δ⁻¹)
      ((slit_open _).mem_nhds (show z∈A by change |z.im|< (t:ℝ)-δ; unfold δ; linarith))
      (Eventually.of_forall fun _=> by unfold w sees; fun_prop) (field_integrable S P x hx t v h) (by unfold g sees; fun_prop)
      ?_ (integrable_const _) (ae_of_all _ (fun u (x : ℂ) _=> hf u x))).2.differentiableAt
    filter_upwards [forward_ae S v P] with u p y b
    change |y.im|<(t:ℝ)-δ at b
    simp only [g,norm_mul,Complex.norm_I, Complex.norm_real,one_mul,Real.norm_eq_abs]; have hu:0≤u a:= (norm_nonneg _).trans p
    have hs : |inner ℝ u x.val| ≤ u a := by rw [cone_mean]; exact (abs_real_inner_le_norm (SEP a u) x).trans ((mul_le_of_le_one_right (norm_nonneg _) hx).trans p)
    have hv:= mul_le_mul hs (mantle x hx t p (z:=y) (show |y.im|<(t:ℝ) by linarith)) (norm_nonneg _) hu
    refine hv.trans ?_
    have hp: u a*δ ≤ ((t:ℝ)-|y.im|)*u a:= by nlinarith
    rw [neg_mul,Real.exp_neg,←div_eq_mul_inv,inv_eq_one_div,div_le_div_iff₀ (Real.exp_pos _) H₁, one_mul]
    linarith [Real.add_one_le_exp (((t:ℝ)-|y.im|)*u a)]
  · unfold fare; rw [← all_norm S]; refine (norm_integral_le_integral_norm _).trans ?_
    have h : ∀ᵐ u:E4 ∂ ρ v, ‖sees t x z u‖ ≤ (1:ℝ) := (forward_ae S v P).mono (fun u h=> (mantle x hx t h s).trans (Real.exp_le_one_iff.mpr (mul_nonpos_of_nonpos_of_nonneg (by apply neg_nonpos.mpr; linarith [show |z.im|<(t:ℝ) from s]) ((norm_nonneg _).trans h))))
    simpa only [integral_const,smul_eq_mul,mul_one] using integral_mono_ae (field_integrable S P x hx t v s|>.norm) (integrable_const (1:ℝ)) h
  unfold fare; rw [ContinuousLinearMap.comp_apply,damped]
  apply integral_congr_ae; apply ae_of_all; intro w
  change sees t x (b:ℂ) w= _
  unfold sees plane; change _=Complex.exp ((↑(inner ℝ w (b • x.val)):ℂ)*I)*_
  rw [real_inner_smul_right,Complex.ofReal_mul,←Complex.exp_add]
  congr 1; ring_nf; simp [sub_eq_add_neg]

noncomputable def transverse := sailing (fare S x t) (candid S P x hx t p) -- include all binder issues
lemma transverse_anal : AnalyticOnNhd ℂ (sailing (fare S x t) (candid S P x hx t p)) (slit t) := hol_sail _ (candid S P x hx t p)
@[simp] lemma on_strip (i:ℝ) : sailing (fare S x t) (candid S P x hx t p) (i:ℂ)=(S.U (i • x)).comp (S.E t):= sailing_real ..
lemma cost_strip (i:ℂ)(g:i ∈ slit (t:ℝ)): ‖transverse S P x hx t p i‖≤4 := sailing_cost _ _ _ g
end Sail
end YM.ConePrice
