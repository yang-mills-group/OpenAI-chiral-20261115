private lemma cruiseSight (s0:0≤ (s:ℝ))(X₀:Finset Axis)(e:j∉X₀)(r:E4) (u v:Axis→Gt)(M:(G₀ j).Op)(h:Sight Y H V G C a χ j u v M) : MapsTo (BC (∑ i∈X₀,r i • basis i) M) FP FP:= by
 induction X₀ using Finset.induction_on generalizing M u v r with
 | empty=> rw [Finset.sum_empty,parcel_zero]; exact fun i v=> awakeAt Y H V G C a χ F j z b Z p d v0 s A A' f0 f1 c Q' c₀ A0 p0 p1 qW _ _ M h s0 _ v
 | insert k Xr d' ih=>
    rw[Finset.sum_insert d',add_comm]; intro y hy
    let t:=∑ i∈Xr,r i • basis i; let U₁(x:ℝ):= (x • basis k : E4); let α(x:ℝ):= BC (t+U₁ x) M y
    have u' : Continuous (fun x:ℝ=> t+ U₁ x):= by unfold U₁; fun_prop
    have hc: Continuous α:= by
       unfold α parcelUp; simp_rw [mul_apply_eq_comp]; exact strollWalk _ (fun _=>Picket.mobile ..) (fun X0=> ((Sq).unit.moves X0).comp u') _ (M.continuous.comp (((Sq).unit.moves y).comp u'.neg)) -- tune paths
    apply closure_minimal (t:=α⁻¹' (FP:Set (G₀ j))) _ ((closedFellowship ..).preimage hc) (daylight Tx (r k))
    intro pT αT; change BC _ M _ ∈ FP; rw [parcel_add]; have hv:j≠k:=by rintro rfl; simp at e
    exact ih (by simp at e; exact e.2) r _ _ _ (aheadSight Y H V G C a χ F j k hv u v ⟨pT,αT⟩ M h) hy -- infer
lemma supportClub (s0:0≤ (s:ℝ))(B:(G₀ j).Op)(kB:B∈ Θ) : MapsTo B FP FP:= by
 apply clause FP (closedFellowship ..) (Wing Y H V G C a χ j univ) (wing_star Y H V G C a χ F j univ) _ B kB
 rintro _ ⟨u,v,r,M,h,b0,rfl⟩
 let Rs:= ∑ i∈Finset.univ.erase j,r i • basis i
 have he:(r j) • basis j+Rs=r:= by
   unfold Rs; trans ∑ i:Axis,r i • basis i
   · exact Finset.add_sum_erase _ (fun i=>r i • basis i) (Finset.mem_univ j)
   ext1 i; simp
 have hh:∀ t1:ℝ,MapsTo (Pt (t1 • basis j)) FP FP:= fun t i s'=> fromHeat Sq FP (closedFellowship ..) i (fun k=> cool Y H V G C a χ F j z b Z p A A0 k i s') t
 rw [←he,parcel_add]; -- r rewriting also inside Rs?
 intro t t'; unfold BridgeClub.parcelUp -- caution unfold inner BC
 rw [←neg_smul]; apply hh (r j); -- tune
 exact cruiseSight Y H V G C a χ F j z b Z p d v0 s A A' f0 f1 c Q' c₀ A0 p0 p1 qW s0 (Finset.univ.erase j) (by simp) r _ _ _ h (hh (-(r j)) t')
lemma surveyComplete (s0:0≤ (s:ℝ))(k₁:owns_it Θ (Ω j))(h:A0 (Ω j)= Aq (Ω j)): A0= Aq:=by
 ext1 v; let hx:= extension FP (closedFellowship ..) (Ω j) Θ k₁ (followUnit Y H V G C a χ F j z b Z p A A0 h) (supportClub Y H V G C a χ F j z b Z p d v0 s A A' f0 f1 c Q' c₀ A0 p0 p1 qW s0) v
 let ht:= (truthful ..).1 (sickle Y H V G C a χ j z Z A A0 hx) 0
 rw [ (Sq).eZero ] at ht; exact ht
