private lemma selfMoves (x:Xo)(n:ℕ)(v:x.val = tz a (n:ℤ) f)(z:ℂ) (h:Θα f=z • f)(u:ℕ):
    inner ℂ ((A) x) ((A) (walkC Y H a true u x))= z • (Reflect.chord true • ((Τ).pulse s (f*(tz a ((u:ℤ)+(n+n:ℤ)) f)))) :=by
 rw [measures_here]; let t:= 2*(n:ℤ); let k:= 2*(u:ℤ); let w:=k+(2*t); let y:= chime K a w f
 unfold poleForm; change (Τ).pulse s (Reflect.chord _ • (Θα _ * C₀ a k x.val))=_
 have hu:t+(k+t)=w:=by unfold w; ring
 have he: chime K a t (Θα x.val * C₀ a k x.val)= z • (f*y):=by
    rw [chime_product,v]; change chime K a t (Θα (chime K a t f)) * chime K a t (C₀ a k (C₀ a t f))= _; rw [march_flip a true p,march_sums a true (axial K a 0 p),add_neg_cancel,march_zero a true (axial K a 0 p), march_sums a true p,march_sums a true p,h,hu,Algebra.smul_mul_assoc]
 let φ' : TestFamily (tent Y H) true (Reflect.chord true • (Θα x.val * C₀ a k x.val)) := printedS Y H a true x (walkC Y H a true u x)
 let hF: TestFamily (tent Y H) true (f*y) := tariff_leg Y H true p (flow_port K a w p)
 rw [← (Τ).parity s a n φ',chime_scale,he,(Τ).scale s (hF.scale z),(Τ).scale s hF, smul_comm]
 change z • _=(z • _); unfold y; rw [show w=(2* ((u:ℤ)+(n+n:ℤ))) from (by unfold w k t; ring)]
include B T D
private lemma pose_dry (x:Xo)(n:ℕ)(v:x.val=tz a (n:ℤ) f)(z:ℂ)(h:Θα f=z • f): No ((A) x)=0:=by
 let f':= ((A) x); have ht:= singles Y H V G a true s C j χ p (story_zero Y H V G D a s C j χ B T p)
 let β(i:ℕ):= i+(n+n)
 let D0(g:ℕ):= whenly da s g
 let T':= (ΘS); have he: inner ℂ f' (No f')=0:=tendsto_nhds_unique ((tendsto_const_nhds (x:=f')).inner (𝕜:=ℂ) ((truth T' f').comp (show Tendsto D0 atTop atTop from (by unfold D0 whenly; exact tendsto_natCast_atTop_atTop.atTop_mul_const (mill_pos (dainty Λ) s))))) (by
    let hb:Tendsto β atTop atTop:= tendsto_atTop_atTop.mpr fun x=>⟨x,fun y v=> v.trans (Nat.le_add_right ..)⟩; convert ((((ht.comp hb).const_smul z)).congr fun i=> ?_) -- infer equality side
    · simp
    · change z • ( Reflect.chord true • _) = inner ℂ f' ((ΘS).E (D0 i) f'); rw [show (ΘS).E (D0 i) f'=(A) (walkC Y H a true i x) from ages_pose ..]; unfold f'; rw [selfMoves Y H V G D a s C j χ p x n v z h]; unfold β; push_cast; rfl)
 apply (inner_self_eq_zero (𝕜:=ℂ)).1
 have hc:(No).adjoint=No:= (cue_project _).2
 rw [←hc, ContinuousLinearMap.adjoint_inner_left, hc,show No (No f')= No f' from ?_ ] -- rc needed
 exact he
 exact DFunLike.congr_fun (cue_project (ΘS)).1.eq _
