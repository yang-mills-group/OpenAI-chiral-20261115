lemma cold_decompose (x:Xo) : No ((A) x)=0:=by
 obtain ⟨Z,v,y'⟩:= atSouth Y H a true x; let P':= axial K a 0 v; obtain ⟨n,q⟩:= right_fit Y H a true P'
 let y:Xo:=⟨_,q⟩; let x':= walkC Y H a true n x; let Q':=No
 let T':= reflectedBox a 0 Z ∪ Z; have V₂:InTest K true T' true x.val:= v.mono Finset.subset_union_right; let t:=Θα x.val; have v':InTest K true T' true t:= P'.mono Finset.subset_union_left; have ht:Θα t=x.val:= reversal (tent Y H) a 0 v
 have h₁:=pose_dry Y H V G D a s C j χ B T (V₂.add v') (x'+y) n (chime_plus ..|>.symm) (1:ℂ) (by rw [one_smul,mirror_plus,ht,add_comm x.val])
 have hh': x'.val - y.val= tz a (n:ℤ) (x.val - t):=by
    rw [sub_eq_add_neg x.val,← neg_one_smul ℂ t,chime_plus,chime_scale,neg_one_smul, sub_eq_add_neg]; rfl
 have h₂:=pose_dry Y H V G D a s C j χ B T (InTest.subOp V₂ v') (x'-y) n hh' (-1:ℂ) (by rw [neg_one_smul, Tower.foil _ ,ht]; change t-x.val= _; abel -- tune indentation
                 )
 rw [map_add,map_add] at h₁; rw [map_sub,map_sub] at h₂
 have hx:No ((A) x')=0:=by have ht:= add_eq_zero_iff_eq_neg.mp h₁; rw [← sub_eq_zero.mp h₂] at ht; exact (smul_eq_zero.mp (Eq.trans (two_smul ℂ _) (add_eq_zero_iff_eq_neg.mpr ht))).resolve_left (by norm_num)
 let B':=whenly da s n; exact ( (show No ((A) x)=No ((A) x') from by rw [← ages_pose Y H V G D a true s Τ (voter_credit Y H V G D a true C j χ)]; exact (DFunLike.congr_fun (skyPulse (ΘS) B') _).symm).trans hx)
lemma odd_nocold : cue (ΘS)=0:=by
 apply badges_ext Y H V G D a true 0 Τ; intro i h x; exact cold_decompose Y H V G D a i C j χ B T x
lemma cold_space_clears(x:Works Y H V G D a true Τ)(t:ℕ→ℝ≥0)(T1:Tendsto t atTop atTop)(w:ℕ→ OS.Cross a): Tendsto (fun i:ℕ=> (ΘS).E (t i) ((ΘS).U (w i) x)) atTop (𝓝 0):=by
 have h:=clock_frost (ΘS) (all_light Y H V G D a true C j χ B T) t w x T1; rw [odd_nocold] at h; exact h

