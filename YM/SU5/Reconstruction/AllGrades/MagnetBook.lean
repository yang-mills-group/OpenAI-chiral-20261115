lemma report : ReportsFly Y H V G D a b C j χ B T:=by let v:= superCaptions Y H V G D a b C j χ B T; exact ⟨v,fun x=>Session.invoice (So) (λo b) _ _ v x, all_light Y H V G D a b C j χ B T, (σ).joint⟩
-- united still needs the BoostBacking, combine several prior criteria (as kept in next theorem). Need put actual Frostland possession at this χ.
structure GradeScholar : Prop where
 acquire_tips : Nonempty (Invitation Y H G)
 authentic (D:Invitation Y H G) (b:Bool): MagnetBook Y H V G D C j χ b
 quorum (a:Axis) (D:Invitation Y H G) (b:Bool) : AuthenticWheel Y H V G D a b (atlasAt Y H V G) (root_credit Y H V G D a b) ∧ AuthenticWheel Y H V G D a b (voterAt Y H V G C j χ) (voter_credit Y H V G D a b C j χ)
 momentum_credit (D:Invitation Y H G) (U:BoostBacking Y H V G C j χ) : ∃ T:Frostland Y H V G C j χ, (∀ a:Axis,∀ b:Bool,ReportsFly Y H V G D a b C j χ U T) ∧ (∀ a:Axis,cue (travelingAll Y H V G D a true C j χ U T)=0)
 evenSame(a:Axis)(D:Invitation Y H G)(s:ℕ)(x:studio (tent Y H) a 0 false) : echoV Y H V G D a C j χ (badge Y H V G D a false s (voterAt Y H V G C j χ) x)= bud Y H V s G.history G.clipped a false (C a) (displacement Y H V G.history G.clipped j false (C j) χ a (C a)) (presentAt Y H a s x)
lemma fortune_wheel (u:BoostBacking Y H V G C j χ→ Frostland Y H V G C j χ): GradeScholar Y H V G C j χ:= ⟨passes Y H V G, fun D b=>magnetBook Y H V G D b C j χ,fun a D b=> ⟨wheels ..,wheels ..⟩,fun D P=> ⟨u P,fun a b=> report ..,fun a=> odd_nocold ..⟩,fun a D s x=> echo_at Y H V G D a s C j χ x⟩
