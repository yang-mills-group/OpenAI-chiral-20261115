private lemma curvedAhead {s t:ℕ}(i:s≤t)(x: studio (tent Y H) a 0 b){p: Sk l'.val}{n:ℕ}(h:p.val=Θ l'.val 0 (C₀ l'.val (2* -(n:ℤ)) (Θ a 0 x.val))) :
    (Ht l'.val i p).val= Θ l'.val 0 (C₀ l'.val (2*(-((MeshClock.acts da s t n):ℤ))) (Θ a 0 (hP i x).val)):=by
 rw [home_label,h]; let V₁:=(atSouth Y H a b x).choose_spec.1; let v':= axial (tent Y H) a 0 V₁; rw [flight_halo Y H V s G D (flow_port K l'.val _ v'), flight_chime Y H V s G D v', flight_halo Y H V s G D V₁, mul_zero]; unfold MeshClock.acts; push_cast; rw [show _ ^ (t-s)*(2*(-(n:ℤ)))=2*(-(((dainty Λ).L:ℤ)^(t-s) * (n:ℤ))) from ?q] -- tune Hc exponent parentheses
 all_goals try rfl
 case q=> change (Λ.R.L.val:ℤ)^_*_ =2*(-((Λ.R.L.val:ℤ)^_*_)); ring
private lemma curvedLater {s t:ℕ}(i:s≤t)(x:studio (tent Y H) a 0 b){p: Sk l'.val}{n:ℕ}(h:p.val=C₀ l'.val (2*(n:ℤ)) x.val) :
    (Ht l'.val i p).val= C₀ l'.val (2*((MeshClock.acts da s t n):ℤ)) (hP i x).val:= by
 rw [home_label,h, flight_chime Y H V s G D (atSouth Y H a b x).choose_spec.1]; let e:(Λ.R.L.val:ℤ)^(t-s)*(2*n)=2*((MeshClock.acts da s t n):ℤ):=by unfold MeshClock.acts; push_cast; change _=2*((Λ.R.L.val:ℤ)^_*_); ring
 rw [e]; rfl
