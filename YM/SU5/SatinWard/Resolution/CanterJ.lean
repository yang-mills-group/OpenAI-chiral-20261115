 obtain ⟨⟨t,h⟩,t1,R₁,zf,R,B,F,Ht⟩:= audited _ _ _ _ _ _ _ _ _ _ _ _ _ h h0 g0 y W' Q Q' q q' 0 (fun _=> nullTux Y Γ Τ R'.positivity)
