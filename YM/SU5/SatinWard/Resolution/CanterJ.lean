 have ht:∃ T,Sprouts Y A m Τ (g+1) i k T G':= ⟨t,h⟩
 let ξ':ι₀:=Classical.arbitrary _; have he:(fun t=>auraSpin Y i (g+1) j t z)=earnBy G' X (.inl ξ'):=by
    funext t; rw [show auraSpin Y i (g+1) j t z=topBeam G' t A0 from ?_]; swap; ·
       unfold G' A0; rw [bedtime, Q'.symm_apply_apply z]
    unfold topBeam earnBy; rw [Fintype.sum_sum_type]; simp only [X,ShapeLab.cols_apply,Sum.elim_inl,Sum.elim_inr,zero_smul,sum_const_zero,add_zero]
