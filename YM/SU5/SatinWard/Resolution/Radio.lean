private lemma archway {J q p d:ℝ}{F X Y A' W:ℂ} (h:0<q)(b: 1 ≤ J)(udnn:0 ≤ d)(upnn:0≤p)(u:q=‖W‖)(e:p/J ≤ q/2) (v:‖X-W‖≤ p/J) (g:‖Y-A'*W‖≤ d/J)(f: J * ‖Y-F*X‖≤1): ‖F-A'‖ ≤ ((1+d+‖A'‖*p)*2/q)/J :=by
 have hf:0<J:=zero_lt_one.trans_le b
 have hk:‖Y-F*X‖ ≤1/J:=(le_div_iff₀ hf).2 ((mul_comm ..).ge.trans f) -- orientation
 have hy:q/2 ≤ ‖X‖:=by have u:= abs_norm_sub_norm_le X W|>.trans (v.trans e); obtain ⟨c,_⟩:=abs_le.mp u; linarith
 let V':=(F-A')*X; have ht: V'= -(Y-F*X)+(Y-A'*W)+ A'*(W-X):=by unfold V'; ring
 have hw: ‖V'‖≤ (1+d+‖A'‖*p)/J:=by
    rw [ht,add_div,add_div]; refine (norm_add_le ..).trans (add_le_add ((norm_add_le ..).trans (add_le_add ((norm_neg _).le.trans hk) g)) ?_); rw [norm_mul,mul_div_assoc]; exact mul_le_mul_of_nonneg_left (by rwa [norm_sub_rev]) (norm_nonneg _)
 unfold V' at hw; rw [norm_mul] at hw; have hx:= (mul_le_mul_of_nonneg_left hy (norm_nonneg (F-A'))).trans hw
 apply (le_div_iff₀ hf).mpr; apply (le_div_iff₀ h).mpr; linarith only [(le_div_iff₀ hf).mp hx]
