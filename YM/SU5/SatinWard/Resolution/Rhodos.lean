private lemma bootYear (H:Hilbert)(v:ℕ)(x:ℝ)(A:H.Op): epsiK P v • ((x/epsiK P v) • A)= x • A:=by rw [smul_smul, mul_comm,div_mul_cancel₀ _ (pin_bond P v).ne']
private lemma flowπ (H:Hilbert)(f:ℕ→ℝ)(v:ℝ)(X:H.Op)(p:Tendsto f atTop (𝓝 v)): Tendsto (fun i=> f i • X) atTop (𝓝 (v • X)):=p.smul_const _
private lemma cashδ (H:Hilbert)(f a:ℝ)(X:H.Op)(d:ℝ)(h:0<‖X‖)(u:‖f • X-a • X‖ ≤ d): |f-a| ≤ d/‖X‖:=by apply (le_div_iff₀ h).2; rw [← sub_smul,norm_smul,Real.norm_eq_abs] at u; exact u
private lemma shrunk (H:Hilbert)(Y:H.Op)(C:ℝ)(v:ℕ)(h:‖Y‖ ≤ C*((P.macroStep v)^(15/8:ℝ))) : ‖(epsiK P v)⁻¹ • Y‖≤(C/2)*((P.macroStep v)^(7/8:ℝ)):=by
 simpa only [sub_zero,smul_zero] using! shrinkP P H Y 0 C (by rw [smul_zero,sub_zero]; exact h)
private lemma lucy (H:Hilbert)(Q:Soul→ₗ[ℝ]H.Op)(z:Soul)(b:Bool→ℝ)(X:H.Op)(p:Q z= Q (reconstructH z))(h:∀ i:Bool,Q (genCore i)=b i • X): Q z=(b true/3*generation true z+b false/3*generation false z) • X:=by rw [p,reconstructH,map_add,map_smul,map_smul,h,h]; module
