lemma pulseWard (v:z∈depth)(α:0< l)(p':0<r) : tideX P η q p M i x pT e K z l r=0:=by
 obtain ⟨s,t,h,h'⟩:= singularVisit P η M W l r α p'; obtain ⟨C,hC,T⟩:= trivialTrace P η M W t pT e K C₁; let F:=tideX P η q p M i x pT e K z l r; let f:=fun v=> incomeX P η q p M i x pT e K z v l r
 refine tendsto_nhds_unique (accomplish P η q p M i x W t pT e K T₁ H' a₀ x₁ J Lh R h h' z) (?_ : Tendsto f atTop (𝓝 0))
 rw [tendsto_zero_iff_norm_tendsto_zero]; let c:=C*‖z‖/2; have u₀:Tendsto (fun i=>c *((P.macroStep i)^(7/8:ℝ))) atTop (𝓝 0):=by simpa using (lapseT P).const_mul c
 refine squeeze_zero' (Eventually.of_forall fun _=>norm_nonneg _) ((eventually_gt_atTop s).mono (fun v' g=>?_)) u₀; have h₀:=clockP P s; let V:=f v'; have he:=T _ p _ x _ g l r (by linarith only [h,h₀]) (by linarith only [h',h₀]) z v
 let y:= (tideRaw P η q p M i x pT e K z l r v'); let u:=P.ColorHil i x; have hx:‖(epsiK P v')⁻¹ • y‖≤(C*‖z‖/2)*((P.macroStep v')^(7/8:ℝ)):=shrunk P (P.ColorHil i x) y (C*‖z‖) v' (he.trans_eq (by ring))
 exact hx

