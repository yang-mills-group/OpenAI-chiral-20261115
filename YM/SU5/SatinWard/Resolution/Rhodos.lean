theorem chiralWard : ∃ A: Soul→ₗ[ℝ]ℝ, (∀ z∈depth,A z=0)∧ ∀ (i:Axis)(q:Cover)(p:ResidualPermit q)(x:P.Spectrum0 i)(z:Soul)(l r:ℝ),0<l→0<r→tideX P η q p M i x pT e K z l r= (A z) • rawPSE P M i x p W.tally l r:=by
 have h(b:Bool): (genCore b) ∈ pureHeart:= by apply Submodule.subset_span; cases b<;>simp
 choose b hb d using (fun g:Bool=>coreClock P η M W pT e K T₁ H' a₀ x₁ J Lh R C₁ y (genCore g) (h g))
 let u:= (b true/3) • generation true+(b false/3) • generation false
 have hp(x:Soul): u x=(b true/3)*generation true x+(b false/3)*generation false x:=rfl
 refine ⟨u,fun z p=>?_, fun i q p x z l r a w=>?_⟩; · rw [hp,depth_iff z |>.1 p true,depth_iff z|>.1 p false]; ring
 obtain ⟨Q,F⟩:=stageLevel P η q p M i x W pT e K T₁ H' a₀ x₁ J Lh R a w; let X:=rawPSE P M i x p W.tally l r; have he(i':Bool): Q (genCore i')=b i' • X:= (F _).symm.trans (coreMetric P η q p M i x W pT e K T₁ H' a₀ x₁ J Lh R C₁ (genCore i') (h i') (hb i') a w)
 rw [F z,hp z]; have ht : Q z=Q (reconstructH z):=sub_eq_zero.mp ((Q.map_sub z (reconstructH z)).symm.trans ((F _).symm.trans (pulseWard P η q p M i x W pT e K T₁ H' a₀ x₁ J Lh R C₁ (z-reconstructH z) (blendRem z) a w)))
 -- keep $Tint call.LF$. explicit composition avoids expensive module normalization on the physical space. preserve g density.
 exact lucy (P.ColorHil i x) Q z b X ht he
