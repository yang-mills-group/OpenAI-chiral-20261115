lemma singularVisit (l r:ℝ)(p:0<l)(k:0<r):∃ s:ℕ,f0 ≤ s∧4*moonClock P s≤ l∧ 4*moonClock P s≤ r:=by
 obtain ⟨s,t,h⟩:= ((eventually_ge_atTop f0).and ((small_clock P W.tally).eventually (inter_mem (gt_mem_nhds (show (0:ℝ)<l/4 by positivity)) (gt_mem_nhds (show (0:ℝ)<r/4 by positivity))))).exists
 refine ⟨s,t,?_⟩; have hp:moonClock P s < l/4 ∧ moonClock P s<r/4:= h; constructor<;>linarith only [hp.1,hp.2]
