lemma coreMetric {V:ℝ}(Vt:Tendsto (fun v:ℕ=> arcYear P η M W pT e K C₁ z βz v) atTop (𝓝 V))(a:0<l)(b:0< r):
 tideX P η q p M i x pT e K z l r= V • rawPSE P M i x p W.tally l r:=by
 obtain ⟨s,p',h,t⟩:= singularVisit P η M W l r a b; obtain ⟨C,hc,T⟩:= bodyCert P η M z W p' pT e K T₁ H' a₀ x₁ J Lh R C₁ βz; let V':= T _ p i x l r h t; let z':= (lapseT P).const_mul C; rw [mul_zero] at z'; let F:=fun i₀:ℕ=>αYear i₀ z βz; let d:= fun v:ℕ=>C*((P.macroStep v)^(7/8:ℝ)); exact tendsto_nhds_unique (tendedR (X:=Fκ z l r) (K:=Κ₀ l r) (d:=d) (f:=F) z' ((eventually_gt_atTop s).mono fun n w=> (norm_sub_rev _ _).trans_le (V' n w))) (flowπ (P.ColorHil i x) F V (Κ₀ l r) Vt)
