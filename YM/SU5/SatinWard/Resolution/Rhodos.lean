lemma coreClock : ∃ a:ℝ, Tendsto (fun v:ℕ=> arcYear P η M W pT e K C₁ z βz v) atTop (𝓝 a)∧ ∃ C:ℝ,0≤C∧∀ᶠ v in atTop,|arcYear P η M W pT e K C₁ z βz v-a| ≤ C*((P.macroStep v)^(7/8:ℝ)):=by
 let q:Cover:=fun _=>1; have qa: ResidualPermit q:= ⟨fun _=> odd_one,fun _=> by decide⟩; obtain ⟨s,p,l,uL,w⟩:= grain_gaugeK P η q qa M 3 W K T₁ H' y Lh -- order?
 let x':=P.advocate 3 y 3; obtain ⟨C,hc,h⟩:= bodyCert P η M z W p pT e K T₁ H' a₀ x₁ J Lh R C₁ βz; let v':= h _ qa 3 x' l l uL uL
 let X:= rawPSE P M 3 x' qa W.tally l l; let F(n:ℕ):= arcYear P η M W pT e K C₁ z βz n; let Y:=tideX P η q qa M 3 x' pT e K z l l; have e:∀ᶠ v in atTop,‖F v • X-Y‖ ≤ C*((P.macroStep v)^(7/8:ℝ)):= (eventually_gt_atTop s).mono (fun v r=> (norm_sub_rev _ Y).trans_le (v' v r))
 let t:= (lapseT P).const_mul C; rw [mul_zero] at t
 obtain ⟨a,h,g⟩:=constrict (show Tendsto (fun n=>C*(P.macroStep n)^(7/8:ℝ)) atTop (𝓝 0) from t) e w
 have hw:0<‖X‖:=w; refine ⟨a,g,C/‖X‖,by positivity,?_⟩; filter_upwards [e] with i z
 rw [h] at z; let y:= cashδ (P.ColorHil 3 x') (F i) a X _ hw z; exact y.trans_eq (by ring)
