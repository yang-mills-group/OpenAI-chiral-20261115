lemma lapseT : Tendsto (fun v=> (P.macroStep v)^(7/8:ℝ)) atTop (𝓝 0):=by
 convert! Tendsto.rpow P.macroStep_zero (tendsto_const_nhds (x:=(7/8:ℝ))) (Or.inr (?_)) ; · rw [Real.zero_rpow (by norm_num)]
 norm_num
