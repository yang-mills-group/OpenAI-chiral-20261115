 let x:=epsiK P v; have he:0<x:=pin_bond P v
 rw [show (epsiK P v)⁻¹ • a-b=(x:ℝ)⁻¹ • (a-x • b) from ?_, norm_smul, Real.norm_of_nonneg (by positivity:(0:ℝ)≤x⁻¹)]; refine (mul_le_mul_of_nonneg_left h (inv_nonneg.mpr he.le)).trans_eq ?_; rw [sprint_inc]; change x⁻¹*(u*(1/2*x*_))=_; field
 rw [smul_sub, inv_smul_smul₀ he.ne']
