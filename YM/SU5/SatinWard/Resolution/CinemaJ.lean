lemma visit_F (i:Bool)(z:ZKey): λ₀ (Uβ p) i z= λ₀ p i z:=by
 unfold censusRay; refine sum_congr rfl (fun u _=> congr_arg (z u • ·) (?_)); unfold scepter; apply P.locate_same; intro a v'; unfold flarePlay; split_ifs; · rfl
 simp [Pi.add_apply, lipRise,YM.basis,v', PiLp.single_apply]
include Fz E
lemma busking (r:0<χ)(z:ZKey)(g:‖z‖=1) : ¬Steady (P.seasons j (Ψ★ j)) (œ (λχ p (!b) z)):=by
 intro q; let Z:= λχ p (!b) z; let B:= λχ p b (starKey z); let y:=(Uβ p);
 have he:= Fz.enough p b uB tp E z g; have ht: outlay P M k T₁ a₀ Θv x₁ j tμ y b uB tp v z= outlay P M k T₁ a₀ Θv x₁ j tμ p b uB tp v z:=by
    unfold y outlay duetCX; rw [visit_F,visit_F]
    exact congr_arg (fun k:ℂ=> cashPeak j tμ*k.re) (Steady.seam _ (ξ▶) B Z _ _ (imMemo ..) q) -- signature
 have hw:= he.2; change χ ≤ _ - outlay P M k T₁ a₀ Θv x₁ j tμ y b uB tp v z at hw; rw [ht,sub_self] at hw; exact r.not_ge hw
omit Fz E
lemma census_scale (i:Bool)(a:ℂ)(z:ZKey): (λχ p i (a • z))= a • (λχ p i z):=by unfold censusRay; rw [smul_sum]; simp_rw [Pi.smul_apply,smul_eq_mul,smul_smul]
include Fz E
lemma instrument (r:0<χ)(z:ZKey)(u:z≠0): ¬ Steady (P.seasons j (Ψ★ j)) (œ (λχ p (!b) z)):=by
 intro q; let A:ℂ:= (↑(‖z‖):ℂ)⁻¹; let x:=A • z; have hx:‖x‖=1:=by unfold x A; rw [norm_smul,norm_inv,Complex.norm_real,Real.norm_of_nonneg (norm_nonneg _), inv_mul_cancel₀ (norm_ne_zero_iff.mpr u)]
 apply busking P M k j T₁ p b a₀ x₁ uB Θv tp tμ E Fz r x hx -- order E F. 
 rw [show λχ p (!b) x=A • (λχ p (!b) z) from census_scale ..,map_smul]; exact hold_color (P.seasons j (Ψ★ j)) _ q _
