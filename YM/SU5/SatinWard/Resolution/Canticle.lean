lemma fresh_hour: ∃ E:ℝ,0<E∧∀ v:ℕ,s<v→∀ (i:Axis)(x:P.Spectrum0 i)(p:skit), Polaris.straight i T p→ DualWing P i T v p →
   let t(j:Axis)(b:Bool):= Cruise P i x (priceX P pHw e j rayPost M K rayP i x z) (pricedPSE P M i x rayP W.tally) (portraitΩ P v p j b) T; let F:= pricedPSE P M i x rayP W.tally; let κ:= (Vχ z:ℂ)
   ‖(∑ i:Axis,(t i true-t i false))- ((↑(P.macroStep v):ℂ)*2*κ)* Cruise P i x F F p T‖ ≤ (E*(P.macroStep v)^(15/8:ℝ))*‖F T T‖ := by
 obtain ⟨C,hc,TΞ⟩:= whistler P η M W ht7 pHw e K T₁ H' a₀ x₂ J₂ Lh R Vχ Hχ; let E:= C*(1+‖z‖); refine ⟨E,by unfold E; positivity,fun v f i x p h w=>?_⟩; intro t F κ
 have hp:0<T:=by linarith only [clockP P s,hL] -- notation U
 let Krho := siren P p T i x F; let L:= (P.ManyF i x).Op; let V'(t:Axis)(b:Bool): L:= receiptAura P η rayPost rayP M z i x pHw e K v t b T T; let Ψ:= (2*P.macroStep v*Vχ z);
 have e₀:0<NormQ v:=Real.rpow_pos_of_pos (P.macroStep_pos v) _
 let qEuro(k:Axis)(b:Bool):|wingNext P k v b i| < T:= (clearθ P i k b v).trans_lt (feelP P η M W ht7 hL f.le)
 have hK(j:Axis)(b:Bool): t j b= Krho (V' j b):= toval P p T i x _ _ (conto_lag P pHw e j rayPost M K rayP i x z W) hp h _ (qEuro j b) (w j b) -- order h before p etc
 let L₀:= Auriga.soaring P η rayPost rayP M z i x pHw e K v T T; have hk:= TΞ v f z rayPost rayP i x T T hL hL; let B:= L₀-(Ψ:ℂ) • F T T; have hf: ‖B‖≤ E*(NormQ v) :=by
    have hE: ‖B‖≤ C*‖z‖* (NormQ v):= by unfold B; rw [Complex.coe_smul]; exact hk
    refine hE.trans (mul_le_mul_of_nonneg_right (?_: C*‖z‖ ≤ E) (le_of_lt e₀)); unfold E; linarith only [hc]
 have hφ:(↑(P.macroStep v):ℂ)* 2 *κ* Cruise P i x F F p T= Krho ((Ψ:ℂ) • F T T):=by rw [map_smul]; change _= ((Ψ:ℂ))* Cruise P i x F F p T; congr 1; unfold Ψ κ; push_cast; ring -- `scepter` exactly op booking. h0
 simp_rw [hK]; rw [hφ]; rw [←show Krho L₀=(∑ i:Axis,(Krho (V' i true)-Krho (V' i false))) from ?_] -- direction opposite
 rw [←map_sub]; exact (waveΩ P p T i x F B).trans (mul_le_mul_of_nonneg_right hf (norm_nonneg _))
 unfold L₀ Auriga.soaring; simp only [map_sum,map_sub]; rfl
