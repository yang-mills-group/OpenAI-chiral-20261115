structure Camera (β:ℕ→ℝ)(V: Soul→ₗ[ℝ] ℝ) (v n:ℕ)(mu:Axis)(G:skit)(r:ℝ):Prop where
  coordinates : ∃ b:Bool,G= duePoint P n v mu b ∨ (mu=2 ∧ G=ript (duePoint P n v 3 b))
  spatial : mu≠3
  roof : Coast (windowχ P v) G
  signatures : |r|=1
  treasury : 0< stepTimeH P (ventSeed P W.tally β v) n (V z)
  audience : ∃ᶠ x in ae (P.pillars 3),(stepTimeH P (ventSeed P W.tally β v) n (V z))/16 ≤ r*((face_spice P M z 3 mu W.tally pHw e K x G (windowχ P v)).re)
-- fake suppress field naming collision V macro, signatures Greek.
theorem bestView : ∀ᶠ n in atTop, ∃ (i:Axis) (G:skit)(x:ℝ), Camera P M z pHw W e K β Vχ v n i G x:=by
 filter_upwards [ruby P M z pHw W e K T₁ H' J₂ Lh R Vχ Hχ Jv Y] with n h
 obtain ⟨v0,i,G,p,o,ℓ',x⟩:= h; let f(a:P.Spectrum0 3):= (buoy i G a).re; let t₁:=o.quest.1; let t₂:=o.quest.2; let T:= (windowχ P v); let V₀:= coverEra P v; let tR:= ∫ x,f x∂Θ
 let c':= Cμ n v; let hr: c'/8 ≤ |tR|:=by
    let Y₁:= (real_mean P M z 3 i W.tally pHw W e K T V₀ G t₁ t₂ R'); change (MR i G).re=tR at Y₁; rw [←Y₁]; exact x
 let t:= mood tR; have hp:= GarnetAct.presence Θ f (scanner P M z 3 i W.tally pHw W e K T V₀ G t₁ t₂ R').2.re (c'/8) (div_pos v0 (by norm_num)) hr; refine ⟨i,G,t,ℓ',p,o,mood_abs,v0,?_⟩; refine hp.mono fun x h=>?_ ; change c'/16 ≤ t*(starNY i G x).re; rw [face_cost P M z i pHw W e K T₁ H' J₂ Lh R Vχ Hχ Jv G Y x, show c'/16=c'/8/2 from (by ring)]; exact h
