variable (pv:skit) (Y:Teller P M W.tally β v)
lemma coverEra (v:ℕ):0< windowχ P v:= mul_pos (by norm_num) (clockP ..)
include Y T₁ H' R Lh J₂ Vχ Hχ Jv
/- One of the final spatial cameras eventually accepts, on all these authority heights collectively.
 Tilt choice only if cannot satisfy along earlier σ-spatial opportunities. -/
theorem ruby : ∀ᶠ k:ℕ in atTop, (0<Cμ k v) ∧ ∃ (i:Axis)(G:skit),i≠3 ∧ Coast (windowχ P v) G ∧
   (∃ b:Bool,G= duePoint P k v i b ∨(i=2∧G= ript (duePoint P k v 3 b))) ∧ (Cμ k v)/8 ≤ |(MR i G).re|:=by
 filter_upwards [inspector P M z pHw W e K T₁ H' J₂ Lh R Vχ Hχ Jv Y] with k h
 obtain ⟨h1,p,zF⟩:=h; let Vκ:= Cμ k v; let WT:= WQ v; have ht:0<WT:= coverEra ..; let d:= (fun i b=>Qv k v i b); let B i b:= fun x: P.Spectrum0 3=> (buoy i (d i b) x).re; have hx (i:Axis)(b:Bool): Integrable (B i b) Θ:= (scanner P M z 3 i W.tally pHw W e K WT ht (d i b) (p i b).1.quest.1 (p i b).1.quest.2 R').2.re
 obtain ⟨j,b,y⟩:= proofDesk (V:=Vχ z) Θ B hx Vκ h1 (ae_of_all _ zF); let Hr:= p j b; have hf:(residentC P M z 3 j W.tally pHw e K WT (d j b)).re= ∫ x:P.Spectrum0 3,B j b x ∂ Θ := real_mean P M z 3 j W.tally pHw W e K WT ht (d j b) Hr.1.quest.1 Hr.1.quest.2 R'; refine ⟨h1,?_⟩; rw [←hf] at y; by_cases w:j=(3:Axis)
 · subst j; let Z' := Qv k v 3 b; let u:=sideways P M z W.tally pHw W e K WT ht Z' R' Hr.1.quest Hr.2.quest; refine ⟨2,ript Z',by decide,Hr.2,⟨b,Or.inr ⟨rfl,rfl⟩⟩,?_⟩; change Vκ/8≤ |(MR 2 (ript Z')).re|; change Vκ/8≤ |(residentC P M z 3 3 W.tally pHw e K WT Z').re| at y; rw [u] at y; simpa only [Complex.neg_re,Complex.star_def,Complex.conj_re,abs_neg] using y
 exact ⟨j,d j b,w,Hr.1,⟨b,Or.inl rfl⟩,y⟩
include Y
lemma face_cost (x:P.Spectrum0 3) : starNY mu pv x=buoy mu pv x:=by
 unfold face_spice; rw [Polaris.cargo]; let k:= moonClock P (f★ v); have h:0<k:= clockP ..; let f:=centroid P M z 3 pHw W e K (windowχ P v) T₁ H' J₂ Lh R Vχ Hχ Jv Y.anchor (by change 4*k≤10*k; linarith only [h]) (pv true) (P.advocate 3 x 3); rw [f,mul_zero,sub_zero]
