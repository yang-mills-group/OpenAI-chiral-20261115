variable (F':Dirfield (side Y i v) G)(J:Axis)
include F' h
private lemma coverStar (j:Axis) (x:Site Λ) : pupilAim Y G j d0 h x= (((μ^(v-s):ℝ)*(1/2:ℝ)) • (G-fun j:Axis=> ShapeLab.columns (spinClass Y v i j) d0)) j (upRoot Y i h x):=by unfold pupilAim armF; rw [Pi.smul_apply,Pi.smul_apply,mul_smul]; rfl
lemma dirRead (p: SeatsPriced A Y s i k v (pupilAim Y G J d0 h) c') : TwistP Y i s v (pupilAim Y G J d0 h):=by
 intro i' z; refine ⟨σm (Signed.mirror i') J,normUnit ..,fun x=> ?_⟩
 let T:ℝ:=μ^(v-s)*(1/2:ℝ); have Fg:= (eye_at Y d0 F').minus T; have ht(j):∀ x':Site (side Y i s),pupilAim Y G j d0 h x' = (((μ^(v-s):ℝ)*(1/2:ℝ)) • (G-fun j:Axis=> ShapeLab.columns (spinClass Y v i j) d0)) j (upRoot Y i h x'):= fun x=>coverStar Y h d0 F' j x
 rw [ht,ht,heel_swing]; unfold T at Fg; exact Fg.tagged J i' _ _ ((ht J x) ▸ p.fieldT x)
lemma directionMove (j:Axis)(p:SeatsPriced A Y s i k v (pupilAim Y G (X.s.perm j) d0 h) c') : transportT X (pupilAim Y G (X.s.perm j) d0 h)= (σm X.s j) • (pupilAim Y G j d0 h):=by
 funext x; let T:ℝ:=μ^(v-s)*(1/2:ℝ); have Fg:= (eye_at Y d0 F').minus T; let V:= (X.plan).mills (side Y i s) x; let y:= upRoot Y i h V; let q:= coverStar Y h d0 F'; have hx: X.plan.mills _ y= upRoot Y i h x:= by unfold y V; rw [heelingTurn,X.fence]
 have H: AtSupport false univ ((((μ^(v-s):ℝ)*(1/2:ℝ)) • (G-fun j:Axis=> ShapeLab.columns (spinClass Y v i j) d0)) (X.s.perm j) (upRoot Y i h V)):= by rw [←q]; exact p.fieldT V
 have ht: X.bill ((((μ^(v-s):ℝ)*(1/2:ℝ)) • (G-fun j:Axis=> ShapeLab.columns (spinClass Y v i j) d0)) (X.s.perm j) y)= (σm X.s j) • (((μ^(v-s):ℝ)*(1/2:ℝ)) • (G-fun j:Axis=> ShapeLab.columns (spinClass Y v i j) d0)) j (X.plan.mills _ y):=Fg.turned X j y H
 change X.bill (pupilAim Y G (X.s.perm j) d0 h V)= (σm X.s j) • (pupilAim Y G j d0 h x); rw [q,q,←hx]; exact ht
lemma directionRead (p:Satin.PairIdx Y v i k) (H:SeatsPriced A Y s i k v (pupilAim Y G 3 d0 h) c'): TwistP Y i s v (pupilAim Y G J d0 h) ∧ SeatsPriced A Y s i k v (pupilAim Y G J d0 h) c':=by
 suffices Q:SeatsPriced A Y s i k v (pupilAim Y G J d0 h) c' from ⟨dirRead Y A h d0 F' J Q,Q⟩
 by_cases g:J=3; · exact g.symm ▸ H
 let R:Ramp:=⟨3,J,g⟩; have he:R.s.perm J=3:=R.sba; let V:=pupilAim Y G J d0 h
 let q:= transportT R (pupilAim Y G (R.s.perm J) d0 h); let c:= σm R.s J
 have hx:q= c • V:= directionMove Y A R h d0 F' J (he.symm ▸ H)
 have ht: c= -1:=by unfold c StressFlux.sign; rw [R.fee_b]; rfl
 have hz: SeatsPriced A Y s i k v (c • V) c':= hx ▸ (SeatsPriced.transported _ _ (he.symm ▸ H) R ⟨p.1,p.2.le⟩)
 rw [ht] at hz; simpa only [neg_one_smul,neg_neg] using SeatsPriced.scale Y A hz (-1) (by simp : ‖(-1:ℝ)‖=1) -- negative of negative.
omit F' h
