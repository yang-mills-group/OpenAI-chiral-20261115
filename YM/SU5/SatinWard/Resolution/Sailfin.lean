lemma starSparks (p:Satin.PairIdx Y v i k): SwingP Y i s v (armF Y (paintClass Y v i k) Z' D0Z h):=by
 rw [atlasEta Y h D0Z p]; intro j d v'; unfold pressureArm; have hb:{N:Side}→∀ (f g:Mark N)(d:ℤ),reflMark j d (f-g)=reflMark j d f-reflMark j d g:= fun _ _ d=>funext fun i=> theta_sub ..
 rw [mirrorCoin,mirrorCoin,hb, heel_swing,q.tagged _ _ _ (u _), show reflMark j _ (glowMark Y i v (multiplier D0Z) _) = _ from facingGlows _ (D0Z (.inl true)) (D0Z (.inl false)) _ _ _]; rfl
lemma starTiles (p:Satin.PairIdx Y v i k): transportT X (armF Y (paintClass Y v i k) Z' D0Z h) = pressureArm Y Z' (localFace X.s (multiplier D0Z)) h:=by
 rw [atlasEta Y h D0Z p]; funext x; unfold transportT pressureArm; rw [tiltCoin, tiltCoin,show X.bill (_-_) = X.bill _-X.bill _ from funext fun _=>theta_sub ..,q.turned _ _ (u _), tiltedGlows,heelingTurn]; rw [X.fence]
