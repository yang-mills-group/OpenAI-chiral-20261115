lemma atlasEta (p:Satin.PairIdx Y v i k): Landscape D0Z = pressureArm Y Z' (multiplier D0Z) h:=by
 funext x; unfold pressureArm armF; let y:=upRoot Y i h x; have hx(x:Sι):(ShapeLab.columns (paintClass Y v i k) D0Z) x=glowMark Y i v (multiplier D0Z) x:=by
    rw [ShapeLab.cols_apply,Finset.sum_apply]; change (ShapeLab.columns (fun j=>paintClass Y v i k j x) D0Z) =_ -- rw defeq? brittle
    rw [glowDome Y x p.2.le]; rfl
 dsimp only; rw [hx]
