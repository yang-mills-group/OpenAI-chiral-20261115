 obtain ⟨C,h,hq⟩:=issue_vitt P η M W ht7; let p₀:= (1+‖U‖); have hp0:0<p₀:=by unfold p₀; positivity
 let w₀:=(8:ℝ)*ageBudget P η A (yardF cloverFrame) H s; let β:=2*(owedP (totalBudget A (Announcement Wage4 η)) (Vp)); let f:=|paceAria P A H|; let t:= |β|+f * |w₀|; have u:0≤t:=by unfold t f; positivity
 refine ⟨p₀*t*C,mul_nonneg (by positivity) h.le,fun q p i x v s₁ l r a1 a2=>?_⟩
 let p':= ht7.trans s₁.le; let X':= (Ψw v U w p'); have hx:= (issue_core P η M U p' W pT e K Dτ w).choose_spec
 let T:= monthκ P v U * (κj v)⁻¹; let D':= gatherG X'; let D₂:= T*D'; let E:= (μ^(v-s))⁻¹; let A':=(W.tally.date.stock _ p').2; let V:= (rawSolo P M i x p pseV A' f0 p'); let Kvision:= rawPSE P M i x p W.tally; let Cℓ:= Lζ v; let t₀:= tideRaw P η q p M i x pT e K U l r v; have he:‖t₀-(D₂) • V l r‖≤T*wageMonth P η A H s v:=hx.2 q p i x s ht7 s₁ l r a1 a2 A'
 have eo:= sprint_pos κ; have e':0<E:=by unfold E; positivity
 have hB:0 ≤ T:=(mul_pos (month_pos P U) (inv_pos.mpr (intLive _))).le; have hv: |D₂| ≤ T*f:=by
    rw [show D₂=T*D' from rfl,abs_mul,abs_of_nonneg hB]; exact mul_le_mul_of_nonneg_left ((show |D'|= ‖D'‖ from (Real.norm_eq_abs _).symm).trans_le ((gather_norm X').trans (hx.1.trans (le_abs_self _)))) hB
 have hy: ‖Cℓ⁻¹ • Kvision l r-V l r‖≤ w₀*E:=by
    let hs:=clockP P s; let hp:= psLimit P pT M K i x p W.tally ht7 s₁ (by linarith only [hs,a1] :moonClock P s ≤ l) (by linarith only [hs,a2] : moonClock P s ≤ r) A' p'; rw [← Complex.ofReal_inv,Complex.coe_smul] at hp; refine hp.trans_eq ?_; unfold w₀ E; ring
 change ‖t₀- ((URU v U w)) • Kvision l r‖≤ _; rw [scriptQ,dif_pos p']; change ‖t₀-(D₂*Cℓ⁻¹) • Kvision l r‖≤_; rw [←smul_smul D₂ (Cℓ⁻¹)]; apply le_trans (diamond _ _ _ _ D₂ _ _ _ rfl he hy hv) -- adjust
 have hu:wageMonth P η A H s v= β *E:=rfl
 rw [hu]
 change T*(β* E)+T*f*(w₀* E) ≤ _; calc
    _ ≤ T*E*t:=by unfold t; linarith only [mul_le_mul_of_nonneg_left (le_abs_self β) (mul_nonneg hB e'.le), mul_le_mul_of_nonneg_left (le_abs_self w₀) (mul_nonneg (mul_nonneg hB e'.le) (show 0≤f from abs_nonneg _))]
    _ ≤ (p₀*t*C)* _:= ?_
 let q':= mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left (hq v s₁.le) hp0.le) u; unfold T monthκ; unfold p₀ at *; linarith only [q'] -- linarith position goal? may succeed before call
