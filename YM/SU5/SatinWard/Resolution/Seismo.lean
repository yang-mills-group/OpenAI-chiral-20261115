    rw [he]; exact (show ‖U‖≤ (1:ℝ)+‖U‖ from le_add_of_nonneg_left zero_le_one).trans (le_mul_of_one_le_left (by positivity: (0:ℝ) ≤ 1+‖U‖) (one_le_pow₀ (unit_live _))) -- name b ambiguous
