 let u:= κj v; let Q:=gatherG c; have hu0:0<u:=intLive _; let P':= t s o e' q p i x l r uL vL z 1 Mezzo.Concert.one; have hh:rotor (Mezzo.Concert.one).gate d=d:= rotor_one ..;
