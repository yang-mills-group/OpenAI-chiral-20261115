 obtain ⟨C,m,F1,E1,T⟩:= quickEarn P η M vo W pT e K T₁ H' a₀ x₁ J Lh R
 let v:= T s u _ p i x z _ _ (by linarith only [h₁,h]:2*t≤l) (by linarith only [h₂,h]:2*t≤r)
 have hz: HasFDerivAt G (fderiv ℝ G 0) 0:= ((all_val P i x v).real_Dx 0).differentiableAt.hasFDerivAt
