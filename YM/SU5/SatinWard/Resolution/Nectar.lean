 obtain ⟨s,u,h₁,h₂⟩:= singularVisit P η M W l r α β₁; let t:=moonClock P s; have h:0<t:=clockP ..; let F:= (Zκ vo) z; let Y:= (Ι vo) z; let G:=ρP (Y l r); let Lζ:= freshF P i (-home P q f0) x; let Kζ:= fun a:Vantage=> P.locate i x a (F l r)
