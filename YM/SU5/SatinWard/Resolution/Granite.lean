private lemma floorPay(u v:ℝ)(a: 0 < v): let k:ℤ:= Int.floor (u/v); |u-k*v| ≤ v:=by
 intro k; have h:(k:ℝ)≤u/v:= Int.floor_le _; have h':u/v<(k:ℝ)+1:= Int.lt_floor_add_one _; rw [div_lt_iff₀ a] at h'; rw [le_div_iff₀ a] at h; rw [abs_le]; constructor<;> linarith only [h,h',a]
lemma granite_layout : ∃ (u:Bool→ Cover), let L:= fun i=> geoAt P v (L₀ i+ζ • u i); lensDraft p L (τ v)∧ P.laysM ∘ P.vtile v ∘ u=appendage P L₀ L v:=by
 let u(i:Bool)(j:Axis):=Int.floor ((p i j-(q₀) i j)/τ v); let K(i):= L₀ i+ζ • u i; let B(i) := geoAt P v (K i); have h(i:Bool)(j:Axis): B i j=(q₀) i j+P.tock v (u i j):=geo_tick ..; refine ⟨u,fun j i=>?_,?_⟩
 · change |_ -B i j|≤ τ v; rw [h,P.tock_price,←sub_sub]; exact floorPay _ _ (P.macroStep_pos _)
 funext i j; change P.tock v _ = B i j - (q₀) i j; rw [h]; abel
