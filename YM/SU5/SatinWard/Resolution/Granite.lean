lemma loom_transmit (w:lensDraft p g★ (τ v)): Addressing (X✶ b) (X✶ (!b)) (d★ p) μ (R♛ v) Q:=by
 obtain ⟨u,f⟩:=loom_principal P p b Br; refine ⟨hμ,Φs.magnify.1,u,f.trans gQ,?_⟩; rw [←geoB]; let R':= R♛ v; let Q':= ℓ (fρ v); have hz:0<Q':=clockP ..; have hv:0<R':=(scale_corridor P).1; let G:Bool→ Vantage:=g★; let f':=G b-G (!b)-(p b-p (!b))
 change ‖d★ G - d★ p‖≤ μ/R'; rw [show d★ G-d★ p=loomDay f' Q' from by ext i; change Q'⁻¹*_ - Q'⁻¹*_ = Q'⁻¹*( _-_); rw [mul_sub]]
 have hh: ‖f'‖≤2*τ v:= by
      apply (pi_norm_le_iff_of_nonneg (mul_nonneg zero_le_two (P.macroStep_pos _).le)).mpr; intro i; have hm(k:Bool):|p k i-G k i|≤τ v:=w i k; unfold f'; simp only [Pi.sub_apply,Real.norm_eq_abs,abs_le]; constructor<;> linarith only [abs_le.mp (hm b),abs_le.mp (hm (!b))]
 apply (loom_upper ..).trans; rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (by positivity:(0:ℝ)≤ Q'⁻¹)]; apply (mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hh (inv_nonneg.mpr hz.le)) zero_le_two).trans; refine le_trans (?_: _ ≤ 4*(ζ:ℝ)/R') (div_le_div_of_nonneg_right money₁ hv.le)
