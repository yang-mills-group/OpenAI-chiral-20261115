 intro l r' z z' F' D X a₀ T₀
 have u':= T₂.proves Y v (Z ∘ X) (T₁.order.tendsto_atTop.comp a₀) T₀
 have ht:=(q.2 l r' z z' a₀ T₀ u' q.1).2; let F:= wardInk P T₂.tally j x M a qa q.1 D.2.2 l r'; refine (norm_sub_le_norm_sub_add_norm_sub _ F _).trans ((add_le_add ?_ ht).trans_eq (show 1/PAYx v + (1+E)/PAYx v=(2+E)/(PAYx v) from by ring))
