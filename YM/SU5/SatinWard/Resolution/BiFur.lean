noncomputable abbrev barkE (P:Spine)(b:Bool) :ℝ:= if b then 180*(bmass P.jump128:ℝ)/Real.pi^2 else 60*(bmass P.jump128:ℝ)/Real.pi^2
lemma bark (b':Bool) : influ (sectF b') P.jump128=(↑(barkE P b'):ℂ):=by -- b' undeclared in header. add.
 cases b' <;> unfold barkE influ IndexMag.medalD; · rw [show sectF false={4} from rfl,IndexMag.factorsD.2.1,if_neg Bool.false_ne_true]; norm_num; ring
 rw [show sectF true={2} from rfl,IndexMag.factorsD.1,if_pos rfl]; norm_num; ring
lemma bark_pos (b:Bool):0 < barkE P b:=by have h:0<bmass P.jump128:=pow_pos (Nat.mul_pos (by norm_num) (Nat.mul_pos (by norm_num) P.par.block.property)) _; unfold barkE; split <;> positivity
lemma title_stamp(v:ℕ)(z:Soul):(Wχ v) z=(2*P.macroStep v)*psScale P W.tally v*P.par.h^2 *(temp (YΩ v))⁻¹^2 * Vχ ((Bv v).symm z):=rfl
