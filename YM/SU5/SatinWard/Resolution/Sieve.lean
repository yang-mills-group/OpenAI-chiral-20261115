lemma wheel_call (k:Axis) : ∃ c:Bool,Ordered p k c (60*q◁):=by
 let h:= (Br.shelter k).1; rcases le_total (p false k-p true k) 0 with t|t
 · refine ⟨false,?_⟩; apply Ordered.mk; change _ ≤ p true k-_ ; rw [abs_of_nonpos t,neg_sub] at h; exact h
 exact ⟨true,⟨h.trans (abs_of_nonneg t).le⟩⟩
omit Br
