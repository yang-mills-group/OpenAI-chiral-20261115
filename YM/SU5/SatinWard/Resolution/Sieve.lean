lemma order_close (h:Ordered p j b (60*q◁))(w:lensDraft p qv (P.macroStep v)): Ordered qv j b (40*q◁):=by
 have x:=rent_tick P ρ Φs; refine ⟨?_⟩; have hp := abs_le.mp (w j b); have hq:= abs_le.mp (w j (!b)); linarith only [h.gap,x,hp,hq,clockP P (fρ v)]
lemma pr_zero: lensDraft p p (P.macroStep v):=fun i b=> by simp only [sub_self,abs_zero]; exact (P.macroStep_pos _).le
include Br t₀
lemma wheel_plenum: P.Plenum N [b,!b] (appendage P L₀ p v):=by
 refine ⟨fun j'=>?_⟩; obtain ⟨i,h⟩:=wheel_call P p Br j'; exact ⟨[i,!i],(both_perm b).symm.trans (both_perm i),ordered_life P j' q ρ Φs N L₀ t₀ p i (order_close P j' ρ Φs p i p h (pr_zero P ρ Φs p))⟩ -- both_perm b may duplicate include fields signatures
