lemma grid_plenum: P.Plenum N [b,!b] (appendage P L₀ qv v):=by
 refine ⟨fun j'=>?_⟩; obtain ⟨i,h⟩:=wheel_call P p Br j'; exact ⟨[i,!i],(both_perm b).symm.trans (both_perm i),ordered_life P j' q ρ Φs N L₀ t₀ qv i (order_close P j' ρ Φs p i qv h Pr)⟩
-- TAX throughout interpolation chart using real-valued `memMosaic`. WHISKEY
include J uBank Q' hμ T₁
lemma drift_walk :‖(pⓕ qv)-(pⓕ p)‖ ≤ 4*(8*U*(ζ:ℝ)/(R♛ v)):=by
 let dW(i:Finset Axis)(b:Bool)(j:Axis):= if j∈i then qv b j else p b j; let t:=8*U*(ζ:ℝ)/(R♛ v); let amt(u):=artReceipt P a₀ x₁ N L₀ u β v
 have e(s:Finset Axis): ‖amt (dW s)-amt p‖ ≤ s.card*t:=by
    induction s using Finset.induction_on with
    | empty=> simp [dW]
    | insert a s g ih=>
         rw [Finset.card_insert_of_notMem g,Nat.cast_add_one,_root_.add_mul,one_mul,add_comm]; obtain ⟨i,h⟩:=wheel_call P p Br a; have v(s:Finset Axis):Ordered (dW s) a i (40*q◁) := order_close P a ρ Φs p i (dW s) h (fun j b=> by unfold dW; split; exact Pr j b; exact (pr_zero P ρ Φs p j b)); apply (norm_sub_le_norm_sub_add_norm_sub (amt (dW (insert a s))) (amt (dW s)) (amt p)).trans -- tune formula order
         apply add_le_add _ ih; apply drift_tax P a q ρ T₁ uBank Φs hμ Q' N L₀ t₀ (dW (insert a s)) i (dW s) a₀ x₁ J (v _) (v _) -- args order
         · intro i j h; by_cases w:j∈s<;> simp [dW,h,w]
         intro b; unfold dW; simpa [g,abs_sub_comm (a:=qv b a)] using Pr a b -- lemma
 specialize e univ; rwa [show dW univ=qv from (funext fun i=>funext fun j=> by simp [dW]),show ((univ:Finset Axis).card:ℝ) =4 from by simp [Axis]] at e
