lemma rent_tick : P.macroStep v ≤ q◁:=by let d:=windowLaw P ρ (Φs.money.1.trans Φs.money.2.le); let L':=loans_le P ρ Φs.money.1 Φs.money.2.le; apply le_trans _ L'; have w:0≤Wₗ:=mul_nonneg (by positivity) (P.macroStep_pos _).le; linarith only [w,d]
