 have H1:= powerColor P pHw e mu rayPost M K rayP i U z W h h; have H0:= hey_budget P rayPost rayP M i U ρ pHw K h h; let tPV:=tendsto_pi_nhds.mp hG
 refine ⟨(cruise_w P pv T i U (A☆ U) (B☆ U) (F':=fun n=>A◇ U n) (T':=fun n=>B◇ U n) H1 H0 hG).congr' ?_, (solo_w P T i U (A☆ U) (F':=fun n=> A◇ U n) H1 (E false)).congr' ?_, (solo_w P T i U (B☆ U) (F':=fun n=> B◇ U n) H0 (E true)).congr' ?_⟩; all_goals filter_upwards [f] with n e
