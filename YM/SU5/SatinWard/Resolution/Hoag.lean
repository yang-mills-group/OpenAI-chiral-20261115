 refine ⟨q,fun x i c p=>?_⟩; intro Z; obtain ⟨u,f,W0⟩:=earning_pt P i v -- let binder shadow
 let a:ℂ:= ↑(corridorR P v:ℝ); let N:ℂ:=(a:ℂ)^8*Z; obtain t: Disp (polishQ P v) B N (↑(posix (loomDay (selenoid (moonClock P (corridorHeight P v)) false-selenoid (moonClock P (corridorHeight P v)) true) (moonClock P (corridorHeight P v)))):ℂ):= (hx x i _ f).2 false u c p |>.1
 have he:‖N-(↑A:ℂ)‖≤ B/polishQ P v:= by rw [W0] at t; exact t.amount
 have hu:= faderP P v; let V:=(↑A:ℂ)-N; have h': V.re≤ B/polishQ P v:= (Complex.re_le_norm _).trans ((norm_sub_rev ..).trans_le he)
 have hp:A-N.re= V.re:=by unfold V; simp
 change A/2<N.re; have tAA:A-N.re<A/2:=by rw [hp]; refine h'.trans_lt ?_; rw [div_lt_iff₀ (by positivity)]; have e:= (div_lt_iff₀ ht).1 h; nlinarith only [e]
