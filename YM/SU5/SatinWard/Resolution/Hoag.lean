 obtain ⟨B,hB,Bp⟩:= rank_awake P K W.tally M Lh T₁ H' 100 (by norm_num); let A:= posix selant; have ht:0< A:= optic_pos _ cogent
 filter_upwards [Bp, (polish_late P).eventually_gt_atTop (B*2/A)] with v p h
