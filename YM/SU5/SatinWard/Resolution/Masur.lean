lemma fluxLedgerM {J:Type} [DecidableEq J] (f:Tab J)(j:ticket D' 1 (Xp s) 2 f)(fD:f.terms≤D)(ρ:Tab.holds (tent Y H) y f):
    AffordInk Y 4 1 s i k H D' (Z*f.cookP y (tent Y H)) (Chip Y y i k s (mulT T' f) q):=by
 let a:=(Chip Y y i k s (mulT T' f) q); let L':=f.cookP y K; let M':= L'; let A:=Fℓ; let Z':=supplyF N y f
 let f₁: exhibit Y H s i L'=toMark Z':= Week.shown Y s i H f.w f.cover y f.tax
 have f':InTest K true D' false L':= f.thermal j y; let ZP:=Z*L'; have hv:exhibit Y H s i ZP= toMark (A*Z'):=by unfold ZP; rw [actual_product,z',f₁]; rfl
 have hT:=terrain Y H (Y.ir i) s; refine ⟨A',_,_,T,q,hw,pQ,A*Z', ?_,hv⟩; let W:= P.V.L.roof (Y.uv k-s); let B:=P.V.L.mood (Y.uv k-s)
 have h₁:(R'T).p=Ψ:= (prices_plot Y s i k e).1; have a₁:ts=(Ψ).threshold:=(Y.meter.boot s).1.symm; rw [h₁]; unfold Chip
 refine horn_M T rT B (P.V.L.tied (Y.uv k-s)) L (W.2.1 (More N)) (W.2.2 (More N)) U bI (cheque Y C₀ e) x j0 l₀ a₁.symm (Y.meter.boot s).2.1.symm pB (prices_plot Y s i k e).2.2.2.1 hx hw q A' pQ mail g0 f hy j fD K hT t' V ?_ ?_
 · exact hv ▸ exhibited Y H s i D' (show InTest K true D' false ZP from InTest.mul u' f') -- order & union
 intro g V'; have he:covariant (toMark A):= angleProof Y U bI C₀ x e j0; let M:=(momentm Y i s); have hz:covariant (exhibit Y H s i L'):= Week.displayed_covariant hT (ρ M); rw [f₁] at hz; simp only [toMark,Pi.mul_apply,map_mul]; exact congrArg₂ (· * ·) (he g V') (hz g V')
