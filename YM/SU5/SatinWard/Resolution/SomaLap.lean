 let Z(n:ℕ):= pathArc P η s v q i j l A H (P.nomadic (f n)) (P.engine (f n))
 have t:∀ᶠ n in atTop,∃ x, Z n x:=by filter_upwards [(P.stockGo.comp p).eventually v0, p.eventually (marches P (v+1))] with s t h using t _ h
 obtain ⟨z,h⟩:=eventually_atTop.mp t; choose T u using fun n:ℕ=> h (n+z) (by omega)
 obtain ⟨x,v,d,g,y⟩:=(isCompact_closedBall (0:Coords Wage3) (torrid P q A H)).tendsto_subseq (fun n=> mem_closedBall.mpr ((dist_zero_right (T n)).trans_le (u n).sizeZ))
 exact ⟨fun x=> d x+ z,(fun i j h=>by exact Nat.add_lt_add_right (g h) z),x,⟨T ∘ d,y,fun n=>u (d n)⟩⟩
