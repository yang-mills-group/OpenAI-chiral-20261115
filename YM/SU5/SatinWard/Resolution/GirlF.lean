section Loans
variable (w:InkCover P.J Chi.canonical P.h P.N0 Pay ξC Γϕ Tξ n P.P) (flag:∀ i k, ((Y.voyage i).X k).Prepared P.P P.delay)
variable {s i k:ℕ}
local notation "xt" => hat P.R.L P.x
include w flag
abbrev ClockSong(Y:Course P F)(s i k:ℕ)(g:UNI SU.Slot):Prop := let V:Orbit (cell (Y.ir i) P.block P.R.L s)→ Phys (cell (Y.ir i) P.block P.R.L s):=denZ (RootBook Y i k s) P.U ((Y.voyage i).CapeT s); ∀ᵐ x∂ city _,performance (singlet _) g (V x) =V x -- section? `include` harmless?
theorem ring_sale : ∀ᶠ s:ℕ in atTop,∀ (i k:ℕ), s<Y.uv k→ (∀ g:UNI SU.Slot, Concert g→ ClockSong Y (s+1) i k g)→ ((∀ g:UNI SU.Slot, Registrar g→ twist g ((Coord i k).wave s).val= ((Coord i k).wave s).val) ∧ (∀ g:UNI SU.Slot, Concert g→ ClockSong Y s i k g)):=by
 filter_upwards [(turnover P).eventually w.rotation_schedule] with s e i k hi hF
 let v:= Y.meter.a s; let a:= hat P.R.L P.x s; let L:= P.R.L
 let m₀:= Y.ir i; let m:= mesh m₀ P.R.L s; let n₁:= mesh m₀ P.R.L (s+1); let Y' := Y.voyage i; let D:=Coord i k; let ρ:= Actual Y.meter Y'.funds Y'.CapeT (gaugeFreq P (Y.tile*P.M)) (Y.uv k)
 let K:= ρ.toSpine.address s
 obtain ⟨p,b,h,g⟩:= flag i (Y.uv k)
 have hk:=h.toRealQ; let Zq:= ρ; have hh:ρ.active P.P b s=ρ.gram P.P b s:= p.success P.H hk s hi (p.paysStep P.H h s hi)
 have hv:= p.request s hi
 let E:= e m n₁ K v (Y.meter.a (s+1)) hv (b.read (s+1)).re (ρ.chargeLevel P.P b (s+1)) (ρ.offset P.P b (s+1)) (hat_step s ▸ (p.beta_ok P.H hk _ hi).2) (p.flow (p.charged P.H hk _ hi))
 have hx:(RootBook Y i k s)=ρ.active P.P b s:=by unfold RootBook; rw [g.gramZ, hh]
 have ht:RootBook Y i k (s+1)=ρ.gram P.P b (s+1):=congrFun g.gramZ _ -- tune direct field ∀?
 rw [g.waveZ]
 let T:=ρ.wave P.P b s
 have he(j:UNI SU.Slot)(x:Registrar j): twist j T.val=T.val:=coatWave T.val (fun i=> T.property.firm _) (fun i r l=> by
    refine E i r l ?_; have hl:=hF i r; unfold ClockSong at hl; rw [ht,ρ.gram_fine P.P b s hi] at hl; exact hl) j x
 refine ⟨he,fun j x=>?_⟩
 have hs:=(p.active_law P.H hk s hi).2.2.1; unfold ClockSong; rw [hx]
 filter_upwards [ae_fleet (n:=cell m₀ P.block L s) hv.isle] with z hz
 have hF₁:= hF j x; unfold ClockSong at hF₁; rw [ht] at hF₁
 have hZ:=hs z hz
 -- at this stove even at full Query.Time
 rw [show denZ _ _ _ _=_ from hZ]; change performance _ j (Scree.stove _ _ _ _ _ _ _ _ _ _) = _; rw [←stove_rose _ _ _ _ _ _ _ _ _ x _ hF₁ _ ,he j x.gate]
 exact K.count.symm ▸ P.R.odd_side
end Loans
