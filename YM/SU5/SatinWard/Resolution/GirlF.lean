lemma heightCurtain(i k:ℕ)(z:Orbit (cell (Y.ir i) P.block P.R.L (Y.uv k)))(g:UNI SU.Slot) (h:Concert g): performance (singlet _) g (denZ (RootBook Y i k (Y.uv k)) P.U ((Y.voyage i).CapeT (Y.uv k)) z)=denZ (RootBook Y i k (Y.uv k)) P.U ((Y.voyage i).CapeT (Y.uv k)) z:=by
 by_cases e:flags ((Y.meter.a (Y.uv k)).threshold) z.1=∅; swap; · unfold RootBook; rw [Y.whole, Vale.capP,Set.indicator_of_notMem]; rw [map_zero]; exact e
 obtain ⟨-,f0,t,hf,p,-⟩:=top_system Y i k z e; unfold RootBook; rw [p,map_smul]; apply congrArg; refine performance_commit _ _ ?_ hf ?_ _ h
 · rw [t]; exact carts_p _ f0.projection
 intro r v; rw [t]; exact twirls_projector _ _ v f0
variable (ink:InkCover P.J Chi.canonical P.h P.N0 Pay ξC Γϕ Tξ n P.P)
variable (flag:∀ i k, ((Y.voyage i).X k).Prepared P.P P.delay)
include ink flag
theorem exactly_flavor : ∀ᶠ s:ℕ in atTop,∀ (i k:ℕ), s≤Y.uv k→ (∀ g:UNI SU.Slot, Concert g→ClockSong Y s i k g)∧(s<Y.uv k→ ∀ g:UNI SU.Slot, Registrar g→ twist g (((Y.voyage i).X (Y.uv k)).wave s).val= (((Y.voyage i).X (Y.uv k)).wave s).val):=by
 filter_upwards [eventually_forall_ge_atTop.mpr (ring_sale Y ink flag)] with s u i k h -- name?
 obtain ⟨l,e⟩:∃ l:ℕ,Y.uv k=l+s:=⟨Y.uv k-s,by omega⟩
 induction l generalizing s with
 | zero=> refine ⟨fun g v=>?_ ,fun x=>by omega⟩; rw [Nat.zero_add] at e; rw [←e]; exact ae_of_all _ (fun z=> heightCurtain Y i k z g v)
 | succ l ih=>
    have hx:s+1 ≤ Y.uv k:=by omega
    obtain ⟨a,b⟩:= u s le_rfl i k hx (ih (s+1) (fun t h=>u t (by omega)) hx (by omega)).1; exact ⟨b,fun _=> a⟩
end apply
