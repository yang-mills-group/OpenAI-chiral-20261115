lemma earns_power (V:ℝ)(h:E≤V) : QuickQuest P i x X₀ V:= ⟨k.norms.trans h,fun a b=>(k.transits a b).trans (mul_le_mul_of_nonneg_right h (Real.rpow_nonneg (P.macroStep_pos _).le _))⟩ -- include k
include k
lemma poised : Spark (timeMesh P.par) (propLn (I:=Axis) (timeMesh P.par)) E (charterL P i x X₀) (7/8:ℝ):=by
 refine ⟨(norm_nonneg _).trans k.norms, fun x=>?_, fun z a v=>?_⟩; · exact (P.charter_cost ..).trans_le k.norms
 let Tt:=σ v; let p₁:=P.vtile v (incMove a true); let q:=(propLn (timeMesh P.par) a v); have hu:q=p₁:=posArc ..; let W:= evenBreath P i x v a X₀; have hg:P.vtile v (incMove a false)=-q:=negArc ..;
 change ‖ℛ (z+q) X₀+ℛ (z-q) X₀-(2:ℝ) • ℛ z X₀‖≤_
 have hx:ℛ z W= ℛ (z+q) X₀+ ℛ (z-q) X₀-(2:ℝ) • ℛ z X₀:=by unfold W evenBreath; rw [←Complex.coe_smul,P.charter_sub,P.charter_add,P.charter_smul,P.charter_sum,P.charter_sum,Complex.coe_smul,hg,sub_eq_add_neg z,hu]
 rw [←hx,P.charter_cost]; convert k.transits v a using 3; rfl; norm_num
