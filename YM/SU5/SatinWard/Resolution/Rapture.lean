 Earned P i x F ∧ Resident (P.ColorHil i x) (Rotunda.royal P i x F) V (timeMesh P.par) ∧ (∀ y: Vantage,freshF P i (-home P p' f0) x (Rotunda.royal P i x F y)= P.locate i x y G) ∧ Resident (P.ManyF i x) (fun u:Vantage=> P.locate i x u G) V (timeMesh P.par):=by
 obtain ⟨C,m,hC,hm,h⟩:=quickEarn P η M vo W pT e K T₁ H' a₀ x₁ J Lh R
 let f(s:ℕ):=2*moonClock P s; obtain ⟨C',e0,k',u⟩:= GrowthClock.window f f0 m (2*moonClock P f0) (fun i q=> (mul_le_mul_of_nonneg_left (W.tally.loans f0 le_rfl i q) zero_le_two).trans_eq (mul_left_comm ..)) (show Tendsto f atTop (𝓝 0) from (by simpa [f] using (small_clock P W.tally).const_mul (2:ℝ))) hm (mul_pos (by norm_num) (clockP P f0))
 refine ⟨C*C',mul_pos (by positivity) e0,k',fun a p j x u₀ d hd x1 l r a1 a2=>?_⟩; intro Xv Yv Q
 obtain ⟨s,u,w,F⟩:= u d hd x1
 let K':= h s u a p j x u₀ l r (w.trans a1) (w.trans a2); have z:QuickQuest P j x Xv Q:= earns_power P j x K' Q (by unfold Q; refine mul_le_mul_of_nonneg_right ?_ (norm_nonneg _); exact (mul_le_mul_of_nonneg_left F (by positivity :0≤C)).trans_eq (by ring)) -- ?_ instead _
 exact ⟨entitlement P j x z, all_val _ _ _ z,fun u'=>(actualE _ _ _ z _ u').symm, completes _ _ _ z _⟩
