lemma posArc (n:ℕ)(a:Axis): propLn (timeMesh P.par) a n= P.vtile n (step a):=by funext i; unfold propLn vtile; by_cases h:a=i<;>simp [h,notch_zero, Ne.symm] -- notation `∥` .parse `a : Fin 4` and `SMul etc`. next
lemma negArc (n:ℕ)(a:Axis): P.vtile n (-(step a))= - propLn (timeMesh P.par) a n:=by
 let c:= P.vtile n; have ht: c 0=0:= funext fun i=> notch_zero ..; refine add_right_cancel (?_ : P.vtile n (-(step a))+propLn (timeMesh P.par) a n= -propLn (timeMesh P.par) a n+propLn (timeMesh P.par) a n); rw [neg_add_cancel,posArc,←P.tile_add,neg_add_cancel]; exact ht -- tactic args
