private lemma medusa(K:Side)(C d:ℝ): Grade (-2/5) (monthly K C d):=by
 let P:= (Grade.scaleB (3*(C*(4*BPress.Spin.sphereRate/d))) (Grade.radiusBill.mul (tuition_b K))); refine Grade.cash (f:=_) (P.grow (by norm_num)) ?_; filter_upwards with x; unfold monthly; apply le_of_eq; congr 1; ring
lemma sell_point (b C d B':ℝ): ∀ᶠ x:ℝ in atTop, FloraCup q R L b C d B' x :=by
 let u:=Grade.scaleB (ivy b 2) (medusa L C d); let v:= Grade.scaleB (ivy b 4) (Grade.mul (medusa L C d) (b:=0.2*micr) (Grade.scaleB B' (Grade.pitch _)))
 let y:= Grade.scaleB (3*C) (Grade.scaleB B' (Grade.pitch (0.2*micr)))
 filter_upwards [colorsUp (q:=q) R L b 0 1 B' zero_lt_one,u.cost_p (show -2/5< -(8*micr) by norm_num [micr]),v.cost_p (show (-2/5+0.2*micr)< -(8*micr) by norm_num [micr]), (Grade.block (3*C)).cost_p (show 0<0.35*micr by norm_num [micr]), y.cost_p (show (0.2*micr)<0.35*micr by norm_num [micr]),celestial L R q b 2] with x W0 hv hx hb ht W1
 exact ⟨W0.tone,W1,(le_abs_self _).trans hv,(le_abs_self _).trans hx,W0.outer_,W0.peakD,(le_abs_self _).trans hb,(le_abs_self _).trans ht,W0.growth⟩
