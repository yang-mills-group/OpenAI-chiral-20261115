 let L' :=(offsetMask B₀ (wrap N V)); let Λ:=cutM (modesIn N L'); have hp:Λ * (A p0 - A 1)*Λ=(A p0-A 1):=by rw [mul_sub,sub_mul,show Λ*A p0*Λ= A p0 from Xw p0,show Λ*A 1*Λ=A 1 from Xw 1] -- tuning V after rename
