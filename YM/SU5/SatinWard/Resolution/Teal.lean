 ‖(↑(V◎ d.2.2 v):ℂ) - (-(influ χ' P.jump128))‖ ≤ E/(Υκ v):=by
 let q:Cover:=fun _=>1; have qa: ResidualPermit q:= ⟨fun _=> odd_one,fun _=> by decide⟩; let x:= P.advocate 3 y 3; obtain ⟨s,p,l,uL,w⟩:= grain_gaugeK P η q qa M 3 W K T₁ H' y Lh; obtain ⟨B,hB,u⟩:= finaleB P T₁ p 3 x M q qa H' K W e χ' Lh -- order
 let X:= rawPSE P M 3 x qa W.tally l l; have hp:0<‖X‖:=w; refine ⟨(3+B)/‖X‖,by positivity,?_⟩
 filter_upwards [u,wuxYear P η M W p pT e K T₁ H' a₀ x₁ J Lh R Lx (baseZ (A:=A) (H:=H) P)] with v u t; intro F d Z uh HX
 have he:= (HX.spentZ P η); let a0:= V◎ d.2.2 v; let V0:= flamingo P T₁ 3 x M q qa K W e d.2.2 v l l; have h:2*moonClock P s ≤ l:=by linarith only [clockP P s,uL]
 suffices hx:‖((a0:ℂ) • X)-(-(influ χ' P.jump128)) • X‖≤ 1/Υκ v +(2+B)/(Υκ v) by rw [←sub_smul,norm_smul] at hx; refine ((le_div_iff₀ hp).mpr hx).trans_eq ?_; ring
 rw [Complex.coe_smul]; refine (norm_sub_le_norm_sub_add_norm_sub _ V0 _).trans (add_le_add ((norm_sub_rev ..).trans_le (t q qa 3 x l l uL uL d.2.2 ?_)) (u l l h h uh HX)); refine le_trans ?_ he; rw [Prod.norm_def,Prod.norm_def]; exact (le_max_right ..).trans (le_max_right ..)
#print axioms contactAv
