 obtain ⟨E,e₁,t⟩:= frisk P η M W ht7 pT e K T₁ H' a₀ x₁ J Lh R
 filter_upwards [premium P η M W (E*|B|) (by positivity), sigmaxκ P,eventually_gt_atTop s] with v h u g
 intro q p i y l r α β₀ z zV
 let lℓ:= clockP P s; let p₁:= (Bv v).symm z; let L:= incomePrice P η M W pT e K z v Vχ; let x:=cycleρ (η:=η) v P f0 _ W.tally; let Y:=rawPSE P M i y p W.tally l r; let Z:=tideAcc P η q p M i y pT e K p₁ l r v; let F:= (Bv v).symm z
 have hg:0 ≤ ((P.macroStep v)^(15/8:ℝ)) := Real.rpow_nonneg (P.macroStep_pos _).le _; have hZ:= (pastκ P η pT e K (ht7.trans_lt g) z).trans (mul_le_mul_of_nonneg_left (zV.trans (le_abs_self _)) (pow_nonneg (tour_pos _).le _)); have hk:= sigmaxκ P; have he:0< Υκ v:= u.2.1 -- η
 have hp:= (t v g _ p i y l r α β₀ F).1; let B' :=(2*P.macroStep v) • (Vχ F • Y)
 rw [Lx.2 q p i y l r (by linarith only [α,lℓ]) (by linarith only [β₀,lℓ])] at hp
 have eP:‖Z-B'‖ ≤ E*‖F‖*((P.macroStep v)^(15/8:ℝ)):= hp
 have hy: L • Y = x • B':= by change (x*((2:ℝ)*P.macroStep v)*Vχ F) • _=_; rw [← smul_smul, ← smul_smul]
 change ‖((↑(psScale P W.tally v):ℂ)*(↑(ja_scale P v):ℂ)) • Z- L • Y‖≤ _; rw [←Complex.ofReal_mul]; rw [hy,Complex.coe_smul]; change ‖(psScale P W.tally v *ja_scale P v) • Z-(psScale P W.tally v *ja_scale P v) • B'‖ ≤_; rw [←smul_sub,norm_smul,Real.norm_eq_abs]
 apply le_trans (mul_le_mul_of_nonneg_left (eP.trans (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hZ e₁.le) hg)) (abs_nonneg _)) _; rw [abs_mul,le_div_iff₀ he]; linarith only [h]
