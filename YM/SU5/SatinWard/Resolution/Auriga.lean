lemma hush_me (w:γ≠0): SingleF P i x (PS x) 0 l=0:=by
 let vν(v:ℕ):=2*P.macroStep v; let t:= (PS x) l l; let g:ℝ:=V U; have hx:0<l:=by linarith only [h₁,clockP P s]
 have he(v:ℕ)(h:s<v): Q (soaring P η q p M U i x pT e K v l l)=0:=by
    unfold soaring; rw [map_sum]; refine sum_eq_zero ?_; intro j _; rw [map_sub]; let f:= V; let h(b:Bool): Valence P i x ((vΣ v j b) l l)=Valence P i x ((Fξ j x) l l):= potVal P l i x _ (conto_lag P pT e j _ M K p i x U W) hx (wingNext P j v b) ((clearθ P i j b v).trans_lt (feelP P η M W ht7 h₁ h.le)); rw [h true,h false,sub_self] -- order.Beacon.
 obtain ⟨E,h,b⟩:=whistler P η M W ht7 pT e K T₁ H' a₀ x₁ J Lh R V L
 have hv: ∀ᶠ v:ℕ in atTop,‖((↑g:ℂ) * (Q t))‖ ≤ (E*‖U‖/2)*(P.macroStep v)^(7/8:ℝ) := by
    filter_upwards [eventually_gt_atTop s] with v z; have h':=b v z U q p i x l l h₁ h₁; let y:= soaring P η q p M U i x pT e K v l l; let x' := earnH P i x (y-(vν v*g) • t); rw [←Complex.coe_smul (vν v*g) t, map_sub,map_smul,show Q y=0 from he v z, zero_sub,norm_neg] at x'; have pY:=P.macroStep_pos v
    have e': (vν v)*‖((↑g:ℂ) * (Q t))‖≤ E*‖U‖* (ΞAA v) :=by
       have h₀: ‖y-((↑(vν v*g):ℂ) • t)‖ ≤ E*‖U‖* (ΞAA v):=by rw [Complex.coe_smul]; exact h'
       let hX:= x'.trans h₀
       rw [Complex.ofReal_mul,mul_smul,norm_smul,Complex.norm_real, Real.norm_of_nonneg (by unfold vν; positivity)] at hX; exact hX
    let F:= P.macroStep v; unfold vν at e'; rw [show (ΞAA v)= F * (Ξx v) from by unfold F; rw [show (15/8:ℝ)=1+7/8 from (by ring), Real.rpow_add pY,Real.rpow_one]] at e'; apply le_of_mul_le_mul_left (?_: (F) * _ ≤ _*_) pY; unfold F at *; linarith only [e'] -- arithmetic binder
 -- limit. CP.H. P.g.Price not assumed for Lease. clear estimates.T.Named.RealX in ℋ arbitrary e.Clock
 let u:=lapseT P; have h' := hv; rw [shift_act]; change Q t= 0; apply (mul_eq_zero.mp (?_: (↑g:ℂ)*Q t=0)).resolve_left (Complex.ofReal_ne_zero.mpr w); apply norm_le_zero_iff.mp; apply ge_of_tendsto _ h'; simpa using u.const_mul (E*‖U‖/2)
