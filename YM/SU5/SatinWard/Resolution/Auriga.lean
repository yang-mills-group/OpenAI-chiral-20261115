lemma whistler : ∃ E:ℝ,0<E∧∀ v:ℕ,s<v→∀ (u:Soul)(q:Cover)(p:ResidualPermit q)(i:Axis)(x:P.Spectrum0 i)(l r:ℝ),4*σs≤ l→ 4*σs≤ r→
   ‖soaring P η q p M u i x pT e K v l r- (2*P.macroStep v * V u) • (pricedPSE P M i x p W.tally l r)‖≤ E*‖u‖*(P.macroStep v)^(15/8:ℝ) :=by
 obtain ⟨E,h,u'⟩:=frisk P η M W ht7 pT e K T₁ H' a₀ x₁ J Lh R; refine ⟨E,h,fun v hv z q p i x l r a b=>?_⟩; let H:=freshF P i (-home P q f0) x; let F:= (ΞAA v); let d:=clockP P s; let w:=V z; let g:= tideAcc P η q p M i x pT e K z l r v; let U:= rawPSE P M i x p W.tally l r; let K':= (2*P.macroStep v)
 have ht:= (u' v hv q p i x l r a b z).1; change ‖g- K' • _‖≤ _ at ht; rw [L.2 q p i x l r (by linarith only [a,d]) (by linarith only [b,d]),smul_smul] at ht; have he:‖g-(K'*w) • U‖ ≤ E * ‖z‖* F:= ht
 have hT:H g= soaring P η q p M z i x pT e K v l r:=by unfold g tideAcc evdiv soaring; rw [map_sum]; apply sum_congr rfl; intro j _; unfold H; rw [map_sub]; simp only [tilt_pack P η q p M z _ _ i x pT e K] -- ti order size
 rw [←hT]; change ‖H g-(K'*w) • H U‖≤_; rw [←map_smul,←map_sub]; exact (stintR P i x _ _).trans he
