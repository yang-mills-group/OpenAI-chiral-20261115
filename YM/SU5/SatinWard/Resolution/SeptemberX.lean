 intro f; let S:= (G◁ d.2.2); let Q:= F◁; let W:=G◁ W*; let Z:=vigor; let Z':=(Z:ℂ); let m:=moonClock P (corridorHeight P v); let l:=4*m; let β0:= (home P a v j); have h:= Dq.money.1.trans Dq.money.2.le; have ht:0< Z:=charge P ρ h; have hδ:0 < m:=clockP P _; let h0:= loans_le P ρ Dq.money.1 Dq.money.2.le; let xz:= (Tone.shape j w'); have qH: Strip P v q x* W xz:=planted P M j qa w' q
 have hx: (kinWidth P:ℝ)*P.macroStep v≤ m:=by linarith only [windMoney P ρ h,h0,P.macroStep_pos v]
 have he:W.realWidth P j ≤ m:=by rw [kinMoney P j q x* W xz qH]; exact hx
 have hs:S.realWidth P j ≤ m:=by unfold S JpriceApp; rw [real_cloak]; exact hx
