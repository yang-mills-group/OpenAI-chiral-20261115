 let W₁:=Fⓡ Q; let W₂:=Fⓡ S; let Wm:=Z'⁻¹ • Fⓡ W; let l0:=24*q◁
 have heP: ‖W₁-W₂‖ ≤ Q*:=by
    rw [←P.charter_cost j x (chair P M a (le_refl v)),P.charter_sub]; let b:= ((hX.current _ j x Dq.money.1 Dq.money.2 a qa q).2.2 j|>.raw v le_rfl (l+β0) (l-β0) (by unfold l; linarith only [h₁.2,hδ]) (by unfold l; linarith only [h₁.1,hδ]))
    have e(F:P.Apron)(t:F.s=v): lined P M j x v a (le_refl v) F (l+β0) (l-β0) = Υ (chair P M a (le_refl v)) (Fⓡ F):=by unfold lined; rw [t]; change Υ _ (P.rawBase j x F (l+β0-β0) (l-β0+β0))=_; rw [add_sub_cancel_right,sub_add_cancel]
    rw [one_smul,e _ rfl,e _ rfl] at b; exact b
 let pB:= quietArm (H:= P.ColorHil j x) ω₁; let pK:= Marble.seam ξ ω₁ l0; let uB:=W₁-W₂; let Rℓ:=corridorR P v
 have hr:=Real.sqrt_nonneg (2*D0); let hW:= pay_armK P j x q ρ T₁ x* W qH Dq (by norm_num) (by norm_num: (20:ℝ) ≤ 64) U; have hW: Rℓ^3*‖pB Wm‖≤ Real.sqrt (2*D0):= hW
 let K0:=Vκ; have g (F:P.Apron)(h:F.s=v)(w:F.realWidth P j ≤ l):f F.F=(Rℓ:ℂ)^6* (K0 * pK (Fⓡ F) Wm):=by unfold f oldLens; rw [keenJ,soulS,bumper_s P M j x qa q ρ T₁ Dq w' F h w (by linarith only [he,hδ])] -- order Dq vs. vb
 have hx: f Q.F-f S.F=(Rℓ:ℂ)^6* K0*pK (W₁-W₂) Wm:=by rw [g _ rfl hv,g _ rfl (by unfold l;linarith only [hs,hδ])]; rw [show pK (W₁-W₂) Wm=pK W₁ Wm-pK W₂ Wm from (by unfold pK; rw [sub_eq_add_neg W₁,←neg_one_smul ℂ,Marble.seam_add,Marble.seam_smul]; simp; abel)]; ring
 change ‖f Q.F-f S.F‖ ≤_; rw [hx,norm_mul,norm_mul,norm_pow,Complex.norm_real,Real.norm_of_nonneg (zero_le_one.trans Dq.magnify.2.1)]; let p':= (Marble.arm_bound ξ ω₁ l0 (imPrev ..) uB Wm).trans (mul_le_mul_of_nonneg_right ((Marble.arm_dagger ξ ω₁ (imPrev ..) _).trans (mul_le_mul_of_nonneg_left (heP.trans (le_abs_self _)) (by norm_num))) (norm_nonneg _))
 let w:=(pulseMonth P η A H (corridorHeight P v) v); have hz:0≤Rℓ:=zero_le_one.trans Dq.magnify.2.1; linarith only [mul_le_mul_of_nonneg_left p' (show 0≤ Rℓ^6 *‖K0‖ by positivity), mul_le_mul_of_nonneg_left hW (show 0≤ ‖K0‖*2* Rℓ^3 *|w| by positivity)] -- may fail def
