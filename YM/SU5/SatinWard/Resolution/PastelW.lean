lemma linkNext (h:s<v) : dist (Y♯ z v u r) (Y♯ z (v+1) u r) ≤ ‖STar v z‖*bondMonth P η A s v:=by -- norm is `norm` syntax
 obtain ⟨o,w⟩:= W.tally.poses s h₀ a qa; let k':f0<v:= h₀.trans_lt h; let b:= W.stamps s v a o h₀ h.le qa w; let f':= W.stamps s (v+1) a o h₀ (Nat.le_trans h.le (Nat.le_succ _)) qa w
 rw [dist_comm,dist_eq_norm,capPay P p e j a M k qa i x z k'.le, capPay P p e j a M k qa i x z (k'.le.trans (Nat.le_succ _)),steps P p e k k',mul_comm]; exact ontoMonth P p e j a M k qa i x b k'.le (STar v z) q p' f' h₀ h (W.tally.date.stock s h₀).1.1 _
lemma chorded (h:s<v): Tendsto (fun v=> Y♯ z v u r) atTop (𝓝 (limUnder atTop (fun v=> Y♯ z v u r)))∧ dist (Y♯ z v u r) (limUnder atTop (fun v=> Y♯ z v u r)) ≤ 2*‖STar v z‖*bondMonth P η A s v:=by
 let F(v:ℕ):=Y♯ z v u r; let B(n:ℕ):=F (n+v); let c:= ‖STar v z‖*bondMonth P η A s v; let φ:= (spinFrame 3).pulseBase P.par.R.L; have hφ:0 < φ:=div_pos receipt_pos ((spinFrame 3).chi_pos _); have hk:= sprint_pos P.par.R.L; have hZ(n:ℕ):0 ≤ bondMonth P η A s n:=(wbal P M W h₀ n).le; have hc:0≤c:= mul_nonneg (norm_nonneg _) (hZ _)
 have hx(n:ℕ):dist (B n) (B (n+1)) ≤ c*(1/2:ℝ)^n:=by
    unfold B F; rw [Nat.add_right_comm n 1 v]; apply (linkNext P p e j a M k qa i x z W h₀ q p' (h.trans_le (Nat.le_add_left v n))).trans
    have hh:= winLeft P p e k (h₀.trans_lt h) (Nat.le_add_left v n) z; refine (mul_le_mul_of_nonneg_right hh (hZ _)).trans ?_
    change φ^(n+v-v)*‖STar v z‖*(β₄ (n+v)) ≤ c*(1/2:ℝ)^n
    have hw:n+v-s=n+(v-s):=by omega
    calc
        _ = c*(φ/μ)^n:=by unfold c bondMonth; rw [hw,Nat.add_sub_cancel,pow_add,mul_inv_rev,div_pow φ μ n, div_eq_mul_inv (φ^n)]; ring -- c expands obstruct includes β₄
        _ ≤ _:= mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (by positivity) (stampLoss P M W) _) hc
 obtain ⟨x,t⟩:= cauchySeq_tendsto_of_complete (cauchySeq_of_le_geometric _ c (by norm_num : (1/2:ℝ)<1) hx); have h':= dist_le_of_le_geometric_of_tendsto₀ _ c (by norm_num) hx t; have h'':dist (F v) x ≤ c/(1-1/2):=by simpa only [B,Nat.zero_add] using h'
 have hA:Tendsto F atTop (𝓝 x):=(tendsto_add_atTop_iff_nat v).mp t; change Tendsto F _ _ ∧ dist (F v) (limUnder atTop F)≤ _; rw [hA.limUnder_eq]; refine ⟨hA,h''.trans_eq ?_⟩; unfold c; ring
