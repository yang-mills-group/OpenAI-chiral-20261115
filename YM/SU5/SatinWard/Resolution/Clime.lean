 have hV:‖δp‖ *K'≤1:= le_trans (b:=p^5*(‖δp‖*K')) (le_mul_of_one_le_left (by positivity) (one_le_pow₀ hp)) (by linarith only [hu0]);
 have hz:‖(↑U:ℂ)⁻¹ • (δp • S)‖ ≤ (1+b*(K₀+1))/U:=by
    rw [norm_smul,norm_inv,Complex.norm_real, Real.norm_of_nonneg hx.le, inv_mul_eq_div]; apply div_le_div_of_nonneg_right ((norm_le_norm_sub_add ..).trans (add_le_add (heS.trans hV) (?_ : ‖ζp • F‖ ≤ _))) hx.le; rw [norm_smul]; exact mul_le_mul fp e (norm_nonneg _) hb
 rw [show (δp*νp) • D - (-ωp) • O=(↑U:ℂ)⁻¹ • (δp • S) -(I • Y-ωp • O) from ?_]; · apply (norm_sub_le ..).trans; refine (add_le_add hz hf).trans_eq ?_; ring
 rw [hp₀, mul_smul (U:ℂ),mul_smul ((U:ℂ)),smul_add,smul_add]; let h: (↑U:ℂ)≠0:=by exact_mod_cast hx.ne'
 simp_rw [smul_comm δp (U:ℂ),inv_smul_smul₀ h, neg_smul]; rw [show I • Y=δp • (I • Q₀) from smul_comm I δp _, mul_smul δp]; -- tune
