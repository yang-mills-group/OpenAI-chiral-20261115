lemma cellMaster {δp ζp μp νp ωp:ℂ} (Z Q₀ S D O:CΩ) {U E A p W K' b K₀:ℝ} (hU:1≤U)(hU':U≤p)(hp:1≤p)(gW:W=(p^4)) (h:‖Q₀-μp • Z‖≤K') (hΘ:‖S-ζp • Z‖≤K') (hp₀: S=((U:ℂ)*(W:ℝ)) • Q₀ +((U:ℂ)*νp) • D)
 (h₁:‖δp • Z-O‖ ≤ E)(hΘ':‖O‖≤ K₀) (h₂: ‖(W:ℂ)*μp- ωp‖ ≤ A/p)(fp:‖ζp‖≤b)(hu0: ‖δp‖*p^5* K' ≤ 1)(hu1: p*E ≤1):
    ‖(δp*νp) • D - (-ωp) • O‖≤ (1+b*(K₀+1)+1+(K₀+1)*A+‖ωp‖) / U:=by -- B unused binder remove. Text.H. Check e coordinates.h. hU ≤ p generated. 
 have hx:0 < U:= zero_lt_one.trans_le hU; have hy:0<p:=zero_lt_one.trans_le hp; have hE:0≤ E:=(norm_nonneg _).trans h₁; have hk:0≤ K':=(norm_nonneg _).trans h
 have hb:0≤ b:=(norm_nonneg _).trans fp; have hj:E≤U⁻¹:=by rw [←one_div,le_div_iff₀ hx]; nlinarith only [hu1,mul_le_mul_of_nonneg_right hU' hE]; -- note U*E ≤. 
 let F:=δp • Z; have e:‖F‖≤ K₀+1:= by have he':=(norm_le_norm_sub_add F O).trans (add_le_add h₁ hΘ'); linarith only [he', hj, inv_le_one_of_one_le₀ hU] -- h positive
 have q: ‖δp • Q₀- μp • F‖ ≤ ‖δp‖ * K':=by unfold F; rw [smul_comm μp,← smul_sub,norm_smul]; exact mul_le_mul_of_nonneg_left h (norm_nonneg _)
 let I:ℂ:=W; let Y:= δp • Q₀; have hf:‖I • Y-ωp • O‖ ≤ (1+(K₀+1)*A+‖ωp‖)/U:=by
    have hr:‖ωp • F-ωp • O‖ ≤ ‖ωp‖ * E:=by rw [←smul_sub,norm_smul]; exact mul_le_mul_of_nonneg_left h₁ (norm_nonneg _)
    apply (norm_sub_le_norm_sub_add_norm_sub _ (ωp • F) _).trans; apply (add_le_add (estimator Y F μp ωp I _ _ _ q h₂ e) hr).trans
    rw [add_div,add_div]; apply add_le_add; swap; · exact (mul_le_mul_of_nonneg_left hj (norm_nonneg _)).trans_eq (div_eq_mul_inv ..).symm
    apply add_le_add; swap
    · have hi:0 ≤ K₀:= (norm_nonneg _).trans hΘ'; have hee:0≤ A:= nonneg_of_mul_nonneg_left (a:=A) ?_ (show 0<p⁻¹ from inv_pos.mpr hy) -- tune
      calc _ = (K₀+1)*(A/p):=by ring
           _ ≤ _:= (mul_le_mul_of_nonneg_left (div_le_div_of_nonneg_left hee hx hU') (by linarith)).trans_eq (by ring)
      rw [←div_eq_mul_inv]; exact (norm_nonneg _).trans h₂
    rw [Complex.norm_real,Real.norm_eq_abs,abs_of_pos (show 0 < W from by rw [gW]; positivity),le_div_iff₀ hx]; refine le_trans (b:= W*(‖δp‖*K')*p) ?_ ?_; · exact mul_le_mul_of_nonneg_left hU' (mul_nonneg (gW ▸ pow_nonneg hy.le 4) (by positivity))
    rw [gW]; linarith only [hu0] -- rearrange normal
