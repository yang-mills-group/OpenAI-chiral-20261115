lemma sum_income (g: Cover→ P.Test): Integrable (fun p:Vantage=>(S★ v) (g (T_ v p))) F.ppm ∧ (S★ v) (FogC P F v g)=∫ p:Vantage,(S★ v) (g (T_ v p))∂ F.ppm:=by
 let f:= (S★ v) ∘ g; have he:= Curtain.sampler F (P.macroStep v) (P.macroStep_pos _) f; refine ⟨he.1,?_⟩; rw [show (∫ p:Vantage,(S★ v) (g (T_ v p))∂F.ppm)=∑ x∈ Seats P v F, tallyV P F v x • (f x) from he.2,FogC,map_sum]; refine Finset.sum_congr rfl fun i _=>?_ ; rw [map_smul,Complex.coe_smul]; rfl
lemma pair_income (f g:Cover→ P.Test): Integrable (fun v':Vantage×Vantage=> (S★ v) (f (T_ v v'.1)*g (T_ v v'.2))) Ω ∧
 (S★ v) (FogC P F v f * FogC P G v g)=∫ x':Vantage× Vantage,(S★ v) (f (T_ v x'.1)*g (T_ v x'.2))∂ (F.ppm.prod G.ppm):=by
 let y x y:= (S★ v) (f x*g y); have ht:= resample F G (P.macroStep v) (P.macroStep_pos _) y; refine ⟨ht.1,?_⟩; rw [show (∫ p:Vantage × Vantage,y (T_ v p.1) (T_ v p.2)∂ Ω)=∑ x∈Seats P v F,∑ z∈Seats P v G,(tallyV P F v x*tallyV P G v z) • y x z from ht.2]; unfold FogC; rw [sum_mul,map_sum]; refine Finset.sum_congr rfl fun x _=> ?_; rw [mul_sum,map_sum]; refine Finset.sum_congr rfl fun i _=>?_; rw [Algebra.smul_mul_assoc,Algebra.mul_smul_comm,map_smul,map_smul, Complex.coe_smul,Complex.coe_smul, smul_smul]
lemma camper (pv:skit)(w:ℝ)(hw:0<w)(h:Supported F G pv (w/2)):∀ᶠ v:ℕ in atTop, Rich P v (closedBall (pv false) w) (A★ v) false∧ Rich P v (closedBall (pv true) w) (B★ v) true:=by
 filter_upwards [Freeport.both P M z mu ρ pHw e K F G w hw pv h] with v p; refine ⟨rich_sell P _ v _ _ false (?_),rich_sell P _ v _ _ true (?_)⟩; · exact fun a h=>rich_scale P _ v (rich_scale P _ v (p.1 a h) _) _
 exact fun a h=> rich_scale P _ v (p.2 a h) _
