 refine ⟨1+W,le_add_of_nonneg_right W.coe_nonneg,fun x=>?_⟩; have he:= h.le_mul_dist x 0; simp only [dist_zero_right,map_zero] at he; exact he.trans (mul_le_mul_of_nonneg_right (le_add_of_nonneg_left zero_le_one) (norm_nonneg _)) -- sub?
