 have hv:0<V* μ^f0:=mul_pos wp (pow_pos (sprint_pos _) _); have hu:0<C':=mul_pos w (pow_pos (zero_lt_one.trans_le (unit_live _)) _); have hv':0<P':=by unfold P'; positivity
 have tB:0< σ₁:=Real.rpow_pos_of_pos (P.macroStep_pos _) _; let E:= (V* μ^f0+P'*σ₁*C'); refine ⟨Y₁*E, mul_pos (zero_lt_one.trans_le hw) (add_pos hv (mul_pos (mul_pos hv' tB) hu)),fun v p' z=>?_⟩
 let L':= xa i; let S:= G_ z; let T:= P.physicalEnergy i L'; let A' : T.Credits 0 S:=can_lag P pT e vo q M K p i L' z W
 let h:= hor_width P η q p M W (v:=v) (s:=f0) le_rfl p'.le
 have ht': 2*d ≤ l:= by change 2*d ≤ 4*d; linarith only [show 0 < d from clockP ..]
 let v₀:= l- σ v-d; have hv:d ≤ v₀:=by unfold v₀; change 4*d- _- _ ≥ _ ; linarith only [h, (show 0<d from clockP ..)]
 let Ψ:= leapX P i i L' S l l v; let dΨ:= (m⚕ v) z
