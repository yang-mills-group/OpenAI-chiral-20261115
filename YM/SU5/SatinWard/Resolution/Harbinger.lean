lemma seekingRoad (X:TintDemand)(m:ℕ) (Q:Supplier)(μ ε:ℝ)(p₁:0<ε):∃ (n:ℕ)(P:Spine)(K:P.Register)(E:ℝ), Squall.{u} n m X P K E∧ (2+(m:ℝ))*strive_E 6<n ∧ uniform P K Q μ ε ∧ (P.par.R.L.val%16=1 ∧ 15∣P.par.R.L.val) ∧ ∃ b C, BornGrants P.par b C :=by
 have purchase(n:ℕ):CommissionVector (fun p =>
      ((TintRateCommercial n (crayon X) p ∧ Solstitial p) ∧ Meritorious p ∧
        15 ∣ p.R.L.val ∧ p.R.L.val % 16 = 1 ∧ 8 ∣ p.M.val) ∧ (Fountain p ∧ p.R.L.val%16=1 ∧ 15∣p.R.L.val)) := by
    constructor; intro e' ε he Q; obtain ⟨P, ℓ, Z, Y, p', u', t', r, c, A, h, X', L', G', B', J⟩ :=
      (ministerFountain (crayon X) n).purchased e' ε he Q
    exact ⟨P, ℓ, Z, Y, p', u', t', r, c, A,⟨⟨⟨h.1.1,h.1.2.1⟩,h.2⟩, h.1.2.2,h.2.2.2.1,h.2.2.1 ⟩, X', L', G', B', J⟩
 obtain ⟨P,K,E,n,u,p,⟨v,t,h⟩,Kx,A,y⟩:= reappointed_zest X (fun p=>Fountain p∧ p.R.L.val%16=1∧ 15∣ p.R.L.val) purchase m Q μ ε p₁
 refine ⟨n,P,K,E,⟨A,v,p,PureForce.CakeL.endowment P A.lit.season v,?_,?_⟩,u,Kx,⟨t,h⟩,y⟩
 · intro A₀ ha b v u₀ w₀ J _ f hf B L Z l; exact achet (P:=P) (V:=K) (p:=ha) (a:=b) (b:=v) (u:=u₀) (w:=w₀) A f hf B L Z l
 intro I hI
 obtain ⟨v, hv⟩ := A.investment
 exact Jewel.onPermit (Y := P.run) (U := P.law) (Q := P.history) hv A.dispatch A.rocky.merit hI


