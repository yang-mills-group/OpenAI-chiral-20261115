 rw [giveY]; unfold gaugeKin rangeHue silenceE; simp_rw [boutique];
 have h:puBand (∑ i:Era,(z i:ℂ) • convey i) Fq =∑ i:Era,(z i:ℂ)*puBand (convey i) Fq:=by unfold puBand; simp_rw [Matrix.sum_apply, Matrix.smul_apply, smul_eq_mul,sum_mul, mul_sum,mul_assoc]; rw [sum_comm]
 rw [h,mul_sum,mul_sum]; apply sum_congr rfl; intro x _; ring -- gaugeKin.definition nested `64*(polSpin*puBand)`, rw h ok
