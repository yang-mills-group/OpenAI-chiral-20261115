lemma pClinic(z:GKey) :‖oldLens P M j x qa w' (v:=v) (G◁ z).F-gaugeKin j (dynamicSpin (Ωκ z)) j Z✲ (lofty j)‖ ≤ (urg D0*‖Ωκ z‖)/(polishQ P v):=by
 have he:= Dq.magnify; have hz:tLine=tLine:=rfl; have hy:= royaltyAddress P j (tauprint P M qa) v (by simpa using he.1); let E:=Ωκ z; have hx:0< polishQ P v:=zero_lt_one.trans_le (faderP ..)
 have hh(i:Wage3) : ‖G_{i}-K✦ i‖ ≤ D0/(polishQ P v):=((U.rank (Tone.shape j i) (Tone.shape j w') _ _ _ hy j x).amount).trans (div_le_div_of_nonneg_left U.positive hx he.2.2)
 rw [lensCar,hleft,← sum_sub_distrib]; let C:=urg D0; let a:= ‖E‖*(D0/(polishQ P v)); refine (norm_sum_le ..).trans ((sum_le_sum (g:=fun (_:Era)=>a) ?_).trans_eq (?_)) -- syntax `_`? meta lean resolves
 · intro i _; rw [←mul_sub,norm_mul]; rw [Complex.norm_real]; apply mul_le_mul (norm_le_pi_norm E i) (hh i) (norm_nonneg _) (norm_nonneg _)
 simp only [sum_const,card_univ,nsmul_eq_mul,a,E,C,urg]; ring
