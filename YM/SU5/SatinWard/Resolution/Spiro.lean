 unfold gaugeKin; rw [boutique,boutique];
 have ht:puBand F G=puBand G F:= by unfold puBand; rw [←Equiv.sum_comp (Equiv.prodComm SU.Slot SU.Slot) (fun i:slotPair=> G i.1 i.2 * F i.2 i.1)]; exact sum_congr rfl (fun i _=>mul_comm ..)
 rw [ht]
