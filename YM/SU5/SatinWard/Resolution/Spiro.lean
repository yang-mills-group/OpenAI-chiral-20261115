lemma heroSong(z:GKey) : (G◁ z).F=∑ i:Era,(z i:ℂ) • ((vigor:ℂ) • (Υ$ i)):=by
 apply Subtype.ext; let f:=∑ i:Era,(z i:ℂ) • ((vigor:ℂ) • (Υ$ i)); change spineField P.par P.calibration v j z tLine= (screenHall _).val f; unfold f spineField; rw [map_sum,ShapeLab.cols_apply, Finset.sum_apply]; apply sum_congr rfl; intro x _; change z x • (vigor • _)= (z x:ℂ) • ((vigor:ℂ) • gardenFlower P.calibration tLine j (convey x)) -- meta? change left `_` 
 rw [Complex.coe_smul,Complex.coe_smul]; done
lemma heroLease(z:GKey): keenJ P v (G◁ z).F=∑ i:Era, (((Ωκ z) i):ℂ) • (Υ$ i):=by unfold keenJ; rw [heroSong,smul_sum]; apply sum_congr rfl; intro x _; change _= ((hZcost P v*z x:ℝ):ℂ) • _; rw [←mul_smul,←mul_smul,equated]; unfold hZcost; push_cast; apply congr_arg (· • (Υ$ x)); ring -- may fail Op smul
