private lemma seamLinear {H:Hilbert}{j:Axis}(S:OS.Semigroup H j)(v:H)(d:ℝ)(X Y:Era→H.Op)(x y:ZKey) : Marble.seam S v d (∑ i:Era, x i • X i) (∑ i:Era,y i • Y i)= ∑ i:Era,∑ j:Era,x i*y j*Marble.seam S v d (X i) (Y j):=by
 let F(Z:H.Op)(u:H.Op):= Marble.seam S v d Z u; let Γ(Z: H.Op): H.Op→ₗ[ℂ]ℂ:= ⟨⟨_,seam_add_right S v d Z⟩,fun z p=> seam_smul_right S v d z Z p⟩; let Φ(Z:H.Op): H.Op→ₗ[ℂ]ℂ:= { toFun:= (F · Z),map_add' i j:= seam_add S v d i j Z,map_smul' z A:= seam_smul S v d z A Z}; let t:=∑ i:Era, y i • Y i; change Φ t _ = _; rw [map_sum]; apply sum_congr rfl; intro i _; rw [map_smul]; change x i * Γ (X i) t= _; unfold t; rw [map_sum,mul_sum]; apply sum_congr rfl; intro j _; rw [map_smul,mul_assoc]; rfl
