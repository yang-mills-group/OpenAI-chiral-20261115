lemma Aurora_ledger :∃ C:ℝ,0 < C ∧∀ᶠ v:ℕ in atTop, ‖Wχ v‖≤ C ∧∀ i:Bool,
 ‖(↑((Wχ v) ((fun b:Bool=>coreTrace b P.jump128) i)):ℂ) + influ (sectF i) P.jump128‖≤ C/(stemS (hat P.par.R.L P.par.x v)):=by
 let r:=P.jump128; have hh:0<r:= Nat.mul_pos (by norm_num) P.par.block.property
 let q:Cover:=fun _=>1; have qa: ResidualPermit q:= ⟨fun _=> odd_one,fun _=> by decide⟩; let x':= P.advocate 3 y 3; let CW := W.covers
 choose E e₁ t using fun b:Bool=> contactAv P η M W pT e K T₁ H' a₀ x₁ J Lh R Lx y (sectF b)
 choose F f₁ h using fun i:Bool=> dirVisit P M 3 x' qa W.tally T₁ H' K W.living.2.2.1 Lh i hh φ b
 obtain ⟨G,g,H⟩:=view_trace r hh
 let S:=∑ i:Bool,F i; have hs(i):F i ≤ S:=single_le_sum (fun i _=>(f₁ i).le) (mem_univ _); let T:=∑ i:Bool,E i; have ht(i):E i ≤ T:=single_le_sum (fun i _=>(e₁ i).le) (mem_univ _); have ws:0<S:=(f₁ true).trans_le (hs _); have wt:0<T:=(e₁ true).trans_le (ht _)
 let U(b:Bool):ℂ:= -(influ (sectF b) P.jump128); let Z:=2*G* (2*T+‖U true‖+‖U false‖); have hZ:0< Z:=by unfold Z; positivity
 let Y:=Z+T+Z*S; refine ⟨Y,(by unfold Y; positivity),?_⟩
 filter_upwards [eventually_ge_atTop f0,(polish_late P).eventually_ge_atTop (4*G*S), eventually_all.mpr t,eventually_all.mpr h,tempTrip P] with v u e0 l r' x
 let z'(i:Bool):=coreTrace i r; choose f p B W₀ tq using (fun i=> W.progression (sectF i) v u D pT)
 obtain ⟨_,_,s0,x0,_⟩:=x _ rfl
 let a:= Wχ v; let X':= polishQ P v; let b':=(V♙ v); have hx0:0<b':= zero_lt_one.trans_le s0; let SZ(i:Bool):=hZone P v (W₀ i).2.2; let H0(i:Bool) := l i ((p i).tendsto_atTop) (tq i); let C:(Soul→L[ℝ]ℝ):=a; have hx:0<X':=zero_lt_one.trans_le (faderP ..)
 have hg(i:Bool): ‖(↑(a (SZ i)):ℂ)-U i‖ ≤ T/b':=by unfold a SZ; rw [title_value P η M u W pT e K Vχ Lx]; exact (H0 i).trans (div_le_div_of_nonneg_right (ht _) hx0.le)
 have hh(i:Bool): ‖SZ i-z' i‖ ≤ S/X':= (r' i ((p i).tendsto_atTop) (tq i) (W.proves _ _ _ (pT.comp ((p i).tendsto_atTop)) (tq i))).trans (div_le_div_of_nonneg_right (hs _) hx.le)
 obtain ⟨hr,H₂⟩:=accrual a z' G S (T/b') X' g.le ws.le (by positivity) U hx e0 SZ hh hg (H a fun z v=> title_dead P η M W pT e K Vχ Lx v)
 have hz:T/b'≤ T:=div_le_self wt.le s0; have ht':2*G*(2*(T/b')+‖U true‖+‖U false‖) ≤ Z:= mul_le_mul_of_nonneg_left (by linarith only [hz]) (by positivity)
 constructor; exact ((hr.trans ht').trans (show Z ≤ Y from by unfold Y; nlinarith only [ws,wt,hZ])); intro i; rw [← sub_neg_eq_add]; refine (H₂ i).trans ( (add_le_add_right (?_:2*G*(2*(T/b')+ ‖U true‖+‖U false‖)*(S/X')≤Z*(S/b')) (T/b')).trans ?_)
 · exact mul_le_mul ht' (div_le_div_of_nonneg_left ws.le hx0 x0) (by positivity) hZ.le
 rw [←mul_div_assoc,←add_div]; refine div_le_div_of_nonneg_right (?_) hx0.le; unfold Y; linarith only [hZ]
