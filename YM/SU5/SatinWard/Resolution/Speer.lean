 let q:=lapQ P.run v; let X:=polishQ P v; have hq:0<q:= (W.tally.date.stock _ hp).1.1; unfold hZcost; have he:LampRead.canyon P v=q⁻¹*X^4:=by unfold LampRead.canyon jHull chillInt; rw [BPress.drift_eq, mul_inv_rev,inv_inv]; unfold X polishQ; rw [coin_scale,mul_comm]
