 let KΓ:= (Fintype.card Wage3:ℝ); let c:=KΓ*T; have hp:0<c:=mul_pos (Nat.cast_pos.mpr Fintype.card_pos) (zero_lt_one.trans_le h) -- Nonempty Wage3 maybe only from using instance. need `count_pos_J` token
