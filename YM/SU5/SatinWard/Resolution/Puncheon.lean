 let ν:= μ^s*Quota⁻¹^v; change _ ≤ c*D'/w₀*μ^s*(w₀*(Quota⁻¹)^v)*‖z‖
 calc
    _ ≤ KΓ*(T*w*(Xv*‖z‖)):=by gcongr
