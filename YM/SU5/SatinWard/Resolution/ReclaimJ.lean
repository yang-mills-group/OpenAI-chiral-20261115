 have p:= ShapeLab.columns_map F; simp_rw [smul_comm (g _:ℂ) C, hh]; rw [←smul_sum]; exact congrArg (fun A:H=> C • A) (by let h:=DFunLike.congr_fun p g; rw [ShapeLab.cols_apply] at h; exact h)
