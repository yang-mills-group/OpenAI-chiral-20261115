def rosette (X:UNI SU.Slot)(p:Registrar X)(v:cc X.val=X.val) (Q:μ):μ:=by
 refine ⟨twist X Q.val, ?_⟩; refine (show Mind _ from ⟨fun g=>?_,?_,?_⟩)
 · have ht:= Q.property.firm g; nth_rw 1 2 [←p g]; rw [←map_mul,ht,map_mul]
 · rw [←map_star,Q.property.adj]
 rw [twist_formula,cc_mul,cc_mul,cc_star,v,Q.property.realV]

