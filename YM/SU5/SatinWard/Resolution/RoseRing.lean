include kL
lemma wave_no_roll : twist Lτ (s.operate.wave β G).val=(s.operate.wave β G).val:=by
 let i:=Pδ; let j:=rosette Lτ pL.gate kL i.1; let k: Eμ:= (j,0); have hi:= s.real_pick q₀; have he: k.1.val= twist Lτ i.1.val:=rfl
 obtain ⟨a,pH⟩:= (s.sleepsW q₀).1; have hk:k∈closedBall (0:Eμ) (r/2) := mem_closedBall_zero_iff.mpr (by calc
    _ = ‖i‖:= by rw [Prod.norm_def, Prod.norm_def]; rw [show i.2=0 from hi]; rw [show ‖k.1‖=_ from (twist_norm Lτ i.1.val)]; rfl
    _ ≤ _:= mem_closedBall_zero_iff.mp a)
 have hz:k=i:= (s.sleepsW q₀).2.1 _ ⟨hk,by
    have hv:= tests_aperture s q₀ pL hp hG i k a hk hi rfl he -- includes kL? inspect
    refine Prod.ext (Subtype.ext (hv.symm.trans ?_)) ((s.real_aim q₀ k hk rfl).trans rfl)
    rw [show Wp _ _ i=i from pH]; exact he.symm⟩
 change twist Lτ i.1.val=_; rw [←he,hz]
