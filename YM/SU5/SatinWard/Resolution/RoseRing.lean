lemma tests_aperture (x₀ y₀:Eμ)(a:x₀∈closedBall (0:Eμ) (r/2))(b:y₀∈closedBall (0:Eμ) (r/2))(ht:x₀.2=0)(hg:y₀.2=0)
 (v:y₀.1.val=twist Lτ x₀.1.val): twist Lτ (Wp (β:ℂ) (G,0) x₀).1.val=(Wp (β:ℂ) (G,0) y₀).1.val:=by
 obtain ⟨-,uP,d₀,vx,Q,L₀⟩:=s.emits q₀ x₀ a ht u; obtain ⟨-,uK,d₁,vx',Q',L₁⟩:=s.emits q₀ y₀ b hg u
 let Z:Orbit ι:=(1, Classical.arbitrary (Ids ι)); have hz:w.coarse Z=1:= Vale.Grace.Robes.solar Z _ hp.rocket.paid p hp.pole (UVNext.CouplingReset.flags_one p); have ph:= (hp.rocket.paid.paid Z).shrink J.hr.le; let pP:= J.gran.trans hp.rocket.size ; let V0:=Sx β (G,0) x₀; let V1:= Sx β (G,0) y₀; let S₀:= spar K.j w.output.M (w.coarse Z)
 let C:=changeM U (w.coarse Z) w.output.M
 let XT:=w.buildOut V p (β+ w.movement V-d₀) (V0.1,Q) vx; let XU:=w.buildOut V p (β+w.movement V-d₁) (V1.1,Q') vx'
 let D:=deckF Lτ ι
 let Wτ:Teller SU.group:= K
 let hu0:=clear_identity (n:=ι) p
 have he: denZ XU U w.coarse Z=D (denZ XT U w.coarse Z):=by
     unfold XU XT D; rw [(L₁.wear ..),L₀.wear, v, stove_rose _ _ X0 _ _ _ _ _ _ pL (w.count.symm ▸ R.odd_side) hG]; exacts [hu0,hu0] -- if extra goals?
 let e' (H:RegBudget ι):= exponentL p H 1
 have h₂: IsStarProjection S₀:=(U.broadness _ pP _).projection _ ph; have h₃: Sea S₀ C:= Spire.sea_g pP _ ph _
 have hp0 (g:UNI SU.Slot): twist (singlet ι g) S₀= S₀:=by unfold S₀; rw [hz,Dial.spar,profile_trivial, funde_flat K.j s.s.k,Mezzo.twistLook, map_one]
 have hC:D C=C:= performance_commit (singlet ι) C h₂ h₃ (fun g _=>hp0 g) _ pL
 let U₁:=singlet ι Lτ; let T:= paintR false false U₁
 let e₀:=e' V0.1; let e₁:= e' V1.1
 have hS(B:Corr ι) (b:ℝ)(t:ℂ): let L:=w.buildOut V p b B t; denZ L U w.coarse Z= Complex.exp (L.betaL w.coarse Z) • acts (tank S₀ (exp (e' B.1))) C:=by
     intro L; have hn : Hest.boat (0:Op (Single ι)) = 0:=by simpa using Eq.symm (Hest.boats (n:=Single ι) (∅:Finset Unit) (fun _ =>0)) -- params
     rw [show denZ L _ _ _=_ from Plum.sun_reader Z (UVNext.CouplingReset.flags_one p) pP ph]; unfold Plum.traceWater; rw [hz, BPress.Spin.aim_zero, hn, add_zero] -- might also rewrite β, etc
     -- after unfolding saw argument.
     unfold C S₀; rw [hz]
 rw [show denZ XT _ _ _ =_ from hS _ _ _, show denZ XU _ _ _=_ from hS _ _ _, map_smul] at he
 have hc:Complex.exp (XU.betaL w.coarse Z) • acts (tank S₀ (exp e₁)) C= Complex.exp (XT.betaL w.coarse Z) • acts (tank S₀ (exp (T e₀))) C:=by
     refine Eq.trans he (congrArg (Complex.exp _ • ·) ?_)
     change acts (quantU U₁).val (acts (tank S₀ (exp e₀)) C)=_; rw [Fock.swivel]; change acts _ (D C)=_
     letI:NormedAlgebra ℚ (Cipher ι):=NormedAlgebra.restrictScalars ℚ ℝ _; rw [hC, ← map_exp T (Girt.spinM _), show twist (quantU U₁) (tank S₀ (exp e₀)) = tank S₀ (T (exp e₀)) from (Scree.appleT h₂ h₂ false false U₁ (hp0 Lτ) (exp e₀))]
 let hx:= Plum.rootExp h₂ h₃ hc
 have htS : twist (singlet ι Lτ) ((1-S₀)*StackL V0.1 univ*S₀)=((1-S₀)*StackL V1.1 univ*S₀):=by
     rw [Plum.harvest_stack p,Plum.harvest_stack p,map_mul,map_mul,map_sub,map_one,hp0, show twist U₁ (orbitPH (e₀))= orbitPH (T e₀) from Eq.symm (Haro.paral ..)] -- tune
     exact hx.symm
 have hxU:=hp.boot; unfold S₀ at htS; rw [hz] at htS; obtain eU:= Test.TestW.SpinMeter.price_represent hp.frequency Lτ uP (dr).floor hp.boot.power s.s.k uK htS
 change twist Lτ (_ + _) = y₀.1.val + _; rw [map_add,v]; exact congrArg (_ + ·) eU
