 have hv(i:Axis) : 60*U ≤ p (!b) i - p b i ∧ p (!b) i - p b i ≤3700*U:=by obtain ⟨x,w⟩:=q i; exact ⟨(le_div_iff₀ h).mp ((by rw [div_eq_inv_mul]; exact x): (60:ℝ)≤ (p (!b) i-p b i)/U), (div_le_iff₀ h).mp ((by rw [div_eq_inv_mul]; exact w) :(p (!b) i-p b i)/U≤ 3700)⟩
 refine ⟨⟨(hv j).1⟩,⟨fun i=>?_⟩⟩; cases b
 · rw [abs_sub_comm,abs_of_nonneg (show 0 ≤ p true i-p false i from le_trans (by positivity) ((hv i).1:_*((U:ℝ))≤ _))]; exact hv i
 rw [abs_of_nonneg (show 0 ≤ p false i-p true i from le_trans (by positivity) ((hv i).1:_*((U:ℝ))≤ _))]; exact hv i
