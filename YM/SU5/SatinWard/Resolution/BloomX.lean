lemma verticalTariff (g:ℝ)(q:0≤g)(x:ZKey)(p:‖x‖=1): dutyM (starKey x) x g ≤ 324*g:=by
 let f(i j:Wage3):=‖(starKey x i)*x j‖*g; have he(i j:Wage3): f i j≤ g:=by unfold f; rw [norm_mul]; apply mul_le_of_le_one_left q; have he(i):‖x i‖≤ 1:=(norm_le_pi_norm ..).trans_eq p; refine mul_le_one₀ (?_) (norm_nonneg _) (he _); rw [show (starKey x i)=star (x i) from rfl,norm_star]; exact he _
 unfold dutyM; apply le_trans (sum_le_sum (g:= fun i=>∑ _j:Wage3,g) (fun i _=> sum_le_sum (fun j _=> he i j))); simp only [sum_const,card_univ,Orchid.spanMeter,nsmul_eq_mul]; push_cast; linarith
lemma pole_dev (U Z:ℂ)(A B:ℝ)(q:(Z:ℂ)=A)(e:‖U-Z‖ ≤ B) : |cashPeak j tμ*((U).re-A)|≤B:=by
 rw [abs_mul,(show |cashPeak j tμ|=1 from by unfold cashPeak; split <;> norm_num),one_mul]; apply le_trans ?_ e; subst Z; exact Complex.abs_re_le_norm (U-↑A) -- definally? le
