lemma Faye_now : Ordered p j b (60*q◁) ∧ Breezeway p (q◁) 60 3700:=Faye j b (clockP ..) p fun i=> ⟨E.bot i,(E.top i).trans (by norm_num)⟩
lemma Faye_flam : Ordered (Uβ p) j b (60*q◁) ∧ Breezeway (Uβ p) (q◁) 60 3700:=by
 refine Faye j b (clockP ..) _ fun i=>?_ ; rw [flareHe]; let f:=lipRise j i; change 60≤ (d◁).ofLp i+f∧ (d◁).ofLp i+f ≤3700; let p:=E.bot i; let t:=E.top i; unfold f lipRise; simp only [WithLp.ofLp_add,Pi.add_apply,PiLp.smul_apply, YM.basis, PiLp.single_apply]; split_ifs <;> (simp only [smul_eq_mul, mul_one,mul_zero, add_zero]; constructor <;> linarith)
