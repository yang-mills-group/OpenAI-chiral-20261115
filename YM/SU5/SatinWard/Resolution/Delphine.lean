lemma speedT (e:Monitored P η v P.jump128 f0 M HX)
 (p₁:16*(deltaWing P (rentWidth P P.jump128 v):ℝ)*P.macroStep v≤ moonClock P s)(p₂:3*P.macroStep v≤ moonClock P s)
 (q:PAYx v≥1)(b₁:PAYx v ≤ polishQ P v) (k':‖(δ v:ℂ)‖*(Xᵤ v)^5 * wageMonth P η A H s v ≤ 1)(u₀:(Xᵤ v)*(2*|δ v| *(4*ageBudget P η A C H s * (μ ^ (v-s))⁻¹)) ≤ 1)
 (mC:ℝ) (hv:‖((↑((polishQ P v)^4 * gatherG D.1):ℂ) - influ Dχ P.jump128)‖≤ mC/(polishQ P v)) (uf:f0 ≤ v): ‖wardPolar P ρ j x M a qa HX uf u₁ d₁- minusMeter Dχ • ℘ u₁ d₁‖≤ (gigantic (starBudgetT v) mC)/ Play v:=by
 let q₀:= (ρ.date.stock _ uf).2; let X₁:=soloV P v q₀ a qa pseV; let Q':=cloakF P M qa (HX.earnedZ P η none) v; let S:=cloakF P M qa (logStarCore P η HX) v; let Zp(F:P.Apron):= lined P M j x f0 a uf F u₁ d₁
 let D':= evdiv P j x (fun k:Axis=> lined P M j x f0 a uf (cloakF P M qa (HX.earnedZ P η (some k)) v)) v u₁ d₁
 let ν0:= (↑(δ v):ℂ); let h:=e.current s j x s₁ hs a qa q₀; obtain ⟨hx,hq,h'⟩:= syzygy_tokens P (ρ.date.stock v uf).1.1; let Qℓ:= q
 have a0: ℓ s ≤ u₁:=by linarith only [clockP P s,hu]
 have a1: ℓ s ≤ d₁:=by linarith only [clockP P s,hd]
 let α:= gatherG D.1; let β₀:= gatherG D.2.1; let Z:=Xᵤ v; let γ:=starBudgetT v; let θo:=PAYx v
 have hp: Zp S= (((↑θo:ℂ)* ((Z^4:ℝ):ℂ)) • Zp Q')+ ((↑θo:ℂ)*(↑(ja_scale P v):ℂ)) • D':=by rw [← hq,← show ((↑(hueW P.par.R.L (Ω v)):ℂ)/(jHull P.par.R.L (Ω v):ℂ))= _ from h']; exact clockLine P η HX a qa M j x uf p₁ p₂ hu hd
 have hD: ‖(β₀:ℂ)‖≤ γ:=by rw [Complex.norm_real]; let z:=HX.spentZ P η; refine (gather_norm D.2.1).trans ((?_:_ ≤ ‖D‖).trans (z.trans (le_abs_self _))); change ‖D.2.1‖ ≤ _; rw [Prod.norm_def,Prod.norm_def]; exact (le_max_left ..).trans (le_max_right ..)
 have hρ := (brush P T₁.order.tendsto_atTop M δN j x qa ρ s₁ a0 a1 hs).2; rw [dist_eq_norm] at hρ -- hρ pair statement includes ∀. apply .2
 refine cellMaster (Zp X₁) (Zp Q') (Zp S) D' (℘ u₁ d₁) q b₁ (q.trans b₁) rfl (show ‖Zp Q'-(α:ℂ) • _‖≤_ from h.1.raw f0 uf u₁ d₁ a0 a1) (show ‖Zp S-(β₀:ℂ) • _‖ ≤ _ from h.2.1.raw f0 uf u₁ d₁ a0 a1) hp ?tK ?hK ?hL hD k' u₀
 case tK=> rw [cast_chime P M j x qa ρ uf] at hρ; exact hρ
 case hK=> exact OS.Semigroup.Credits.pay₂ (S:=P.physicalEnergy j x) (pse_lag P T₁.order.tendsto_atTop M δN j x qa ρ) (mul_pos (by norm_num) (clockP P s)) hu hd
 case hL=> rwa [Complex.ofReal_mul (_^4:ℝ)] at hv
