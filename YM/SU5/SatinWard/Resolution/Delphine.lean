-- `tabulate` also for all lag orientations. approximation price on least-Pane current SpinAxis. declaration Part.JX.Rotate.Word.
lemma savings (e:Monitored P η v P.jump128 f0 M HX) (p₂:3*P.macroStep v≤ moonClock P s)
 (q:PAYx v≥1)(u:‖(δ v:ℂ)* ((ja_scale P v):ℝ)‖*(8*|pulseMonth P η A H s v|)* PAYx v ≤ 1) (uf:f0≤ v): ‖wardInk P ρ j x M a qa uf D.2.2 u₁ d₁- wardPolar P ρ j x M a qa HX uf u₁ d₁‖≤1/PAYx v:=by
 let q₀:= (ρ.date.stock _ uf).2; let K':=pulseMonth P η A H s v; let Tv:= PAYx v
 let F'(k:Axis):= fun z=>galley P j x v (incMove k z) (standJ P j x M a qa uf D.2.2 k) u₁ d₁
 let G'(k:Axis):= fun z=>galley P j x v (incMove k z) (lined P M j x f0 a uf (cloakF P M qa (HX.earnedZ P η (some k)) v)) u₁ d₁ -- LinHeat uf binder differs due notation
 have hT:0<Tv:=zero_lt_one.trans_le q
 have he(i b): ‖F' i b-G' i b‖≤ |K'|:= by
    let d:=incMove i b; have ht:(ℓ s) ≤ u₁+P.tock v (d j) ∧ ℓ s ≤ d₁-P.tock v (d j):=by
       have hv:=abs_le.mp (inc_wallet P (v:=v) j i b); exact ⟨by linarith only [p₂,hu,hv.1,clockP P s],by linarith only [p₂,hd,hv.2,clockP P s]⟩
    unfold F' G' galley; rw [norm_sub_rev, ← P.charter_sub, P.charter_cost]; let e':= ((e.current s j x s₁ hs a qa q₀).2.2 i|>.raw f0 uf _ _ ht.1 ht.2); rw [one_smul] at e'; exact e'.trans (le_abs_self _)
 let f':= (∑ i:Axis, ((F' i true-G' i true)-(F' i false-G' i false)))
 change ‖d♙ v • (∑ i:Axis,(F' i true-F' i false))- d♙ v • (∑ i:Axis,(G' i true-G' i false))‖≤ _; rw [←smul_sub]; rw [show (∑ i:Axis,(F' i true-F' i false))-(∑ i:Axis,(G' i true-G' i false))=f' from ?_,norm_smul]; swap; · unfold f'; simp_rw [sum_sub_distrib]; abel
 rw [le_div_iff₀ hT]; refine le_trans ?_ u; apply mul_le_mul_of_nonneg_right _ hT.le; refine mul_le_mul_of_nonneg_left ((norm_sum_le ..).trans ?_) (norm_nonneg _); refine le_trans (sum_le_sum (fun i _=> (norm_sub_le ..).trans (add_le_add (he i true) (he i false)))) ?_; rw [sum_const,card_univ,nsmul_eq_mul]; change _ ≤8*|K'|; rw [show Fintype.card Axis = 4 from by decide]; push_cast; nlinarith -- normcast
omit hs HX hu hd
