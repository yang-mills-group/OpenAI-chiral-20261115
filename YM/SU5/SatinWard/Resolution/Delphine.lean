/-- Positive-estimator price of the divergence AND its true marked matter approximation before projecting. Uses simultaneously per-s (fixed s after f0) all lags s-costed and ANY further budget valuations at later $v$. Multiply either of those approximations by 1 to use the lag assertion, with tolerance E/StemS. -/
lemma frameAffairs (a0:0<V₀) (hP:64≤P.par.R.L.val) (χ: LitCurrent.Chamber.Division) (W₀ Uw:ℝ) : ∃ e:ℝ,0≤e ∧∀ᶠ v:ℕ in atTop, f0≤ v∧∀ u₁ d₁:ℝ, 2*ℓ s ≤ u₁→2*ℓ s≤ d₁→∀{F' d} {k:ℕ → ℕ}, Tendsto k atTop atTop→∀ (E:Ceremo P η v P.jump128 f0 V₀ W₀ Uw H A χ (Z ∘ k) F' d),Monitored P η v P.jump128 f0 M E→ ∀ uf:f0 ≤ v,
  ‖wardPolar P ρ j x M a qa E uf u₁ d₁- (-(influ χ P.jump128)) • ℘ u₁ d₁‖≤ e/PAYx v ∧ ‖wardInk P ρ j x M a qa uf d.2.2 u₁ d₁ - (-(influ χ P.jump128)) • ℘ u₁ d₁‖ ≤ (1+e)/PAYx v:=by
 obtain ⟨w,p,h⟩:= Lantern.lumen_v P M j x qa ρ T₁ H' δN a0 hP χ P.jump128 Uw W₀; let C₁:= 1+ |baseZ (A:=A) (H:=H) P| *(w★+1)+1+(w★+1)*w+‖influ χ P.jump128‖; refine ⟨C₁,by unfold C₁; positivity,?_⟩; filter_upwards [h, windowSettle P ρ s₁ hP P.jump128,tabulatedEra P ρ s₁,eventually_gt_atTop s] with v vK p zK t0
 refine ⟨s₁.trans t0.le,?_⟩
 intro u₁ d₁ u' d' F d k hk E M' u
 let h0:= vK hk E M'; let V':=(zK.2.1); obtain ⟨a₁,a₂,a₃,a₄,a₅⟩:=zK
 have ht:= speedT P ρ T₁ s₁ j x M a qa H' E t0 δN u' d' M' p.1 p.2 a₁ a₂ a₃ a₄ w h0 u
 refine ⟨ht,?_⟩; rw [add_div]; exact (norm_sub_le_norm_sub_add_norm_sub _ (wardPolar P ρ j x M a qa E u u₁ d₁) _).trans (add_le_add (savings P ρ s₁ j x M a qa E t0 u' d' M' p.2 a₁ a₅ u) ht)
#print axioms frameAffairs
