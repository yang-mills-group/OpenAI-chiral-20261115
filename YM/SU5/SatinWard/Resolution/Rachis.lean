theorem silver (H:0<χ)(z:Soul)(hz:z≠0)(e0:b=false): (∑ i:ι', Eξ i z) ≠ 0:=by
 subst b
 intro w; let k1:= (Tstar v); let j':= k1 z; have h:j'≠0:=fun f=>hz (k1.injective (f.trans (map_zero ..).symm)); let d':= silenceE j'; have hp:d' ≠ 0 :=fun f=> h (funext (fun i=>Complex.ofReal_eq_zero.mp (congrFun f i)))
 let d0:ℂ:= (↑(‖d'‖):ℂ)⁻¹; let d:= d0 • d'; have U:‖d‖=1:=by unfold d d0; rw [norm_smul,norm_inv,Complex.norm_real,Real.norm_of_nonneg (norm_nonneg _), inv_mul_cancel₀ (norm_ne_zero_iff.mpr hp)]
 let u₀:= Classical.arbitrary ι'; let a:=fMo u₀; let r₀:ι' → Bool→ Cover:=fun i j=>cond j (fMo i) a; have W(i:ι')(j:Bool):ResidualPermit (r₀ i j):=by cases j; exact PMo u₀; exact PMo i
 let t₀(i:ι')(b:Bool)(z:ZKey):=censusRay P M k j (Ψ★ j) T₁ p (r₀ i) Θv (W i) b tμ v θ z
 let A':=t₀ u₀ false (starKey d); let X(i):= ℛ (p true) (Eξ i z); let L(i):= d0 • (η★ • (X i)); let D:= vistaGap p j false θ
 have hxa(i): t₀ i false (starKey d)= A':=rfl
 have vc(i): t₀ i true d=L i:= by
    have xα:censusRay P M k j (Ψ★ j) T₁ p (r₀ i) Θv (W i) true tμ v θ d=t₀ i true d:=rfl
    rw [←xα];    unfold d d'; rw [census_scale P M k j T₁ p a₀ x₁ (r₀ i) Θv (W i) tμ true d0 _, realize P M k j (Ψ★ j) T₁ p (r₀ i) Wκ Θv (W i) tμ true j',show (Tstar v).symm j'=z from k1.symm_apply_apply _]; rfl -- order ambiguity on census_scale incl a0 x1; may goals unresolved
 let M₁ : (P.ManyF j (Ψ★ j)).Op→ₗ[ℂ]ℂ:=⟨⟨_,seam_add_right sW (ξ▶) D A'⟩,fun z p=>seam_smul_right sW (ξ▶) D z A' p⟩
 let f₁ := cashPeak j tμ; let τM(i):ℝ:= f₁*(M₁ (L i)).re; have t(i): χ ≤ τM i:=by
    refine le_trans (Fz.enough p false (r₀ i) (W i) E d U).1 (le_of_eq ?_); unfold outlay duetCX; change f₁*(Marble.seam sW (ξ▶) D (t₀ i false (starKey d)) (t₀ i true d)).re=f₁*(Marble.seam sW (ξ▶) D A' (L i)).re; rw [hxa,vc]
 have ty: (∑ i:ι', τM i)=0:=by
    let Y':(P.ManyF j (Ψ★ j)).Op →ₗ[ℂ] (P.ManyF j (Ψ★ j)).Op := ⟨⟨_,P.locate_add j (Ψ★ j) (p true)⟩,fun a u=>P.locate_smul _ _ _ u a⟩
    have he:(∑ i:ι',L i)= d0 • (η★ • Y' (0: (P.ManyF j (Ψ★ j)).Op)):=by unfold L; rw [←smul_sum,←smul_sum,←w,map_sum Y']; rfl
    -- Y' 0=0
    rw [map_zero,smul_zero,smul_zero] at he; unfold τM; rw [←mul_sum,←Complex.re_sum,←map_sum, he, map_zero]; simp -- name Complex.re_sum
 have ge:0 < ∑ i:ι', τM i:=Finset.sum_pos (fun i _=> H.trans_le (t i)) Finset.univ_nonempty
 rw [ty] at ge; exact (lt_irrefl _) ge
