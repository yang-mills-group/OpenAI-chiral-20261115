private lemma dispersion {i':Type*}[NormedAddCommGroup i'][NormedSpace ℝ i'][CompleteSpace i'](t:Soul→ₗ[ℝ] i') (a:∀ z:Soul,t z=0→ z=0): ∃ C:ℝ,1≤C∧∀ z:Soul,‖z‖≤ C*‖t z‖:=by
 have hx: Function.Injective t :=LinearMap.ker_eq_bot.mp (LinearMap.ker_eq_bot'.mpr a)
 have hf:IsClosed (Set.range (t.toContinuousLinearMap)):= by rw [show Set.range t.toContinuousLinearMap= (t.range:Set i') from (LinearMap.coe_range _).symm]; exact (t.range).closed_of_finiteDimensional
 obtain ⟨W,h⟩:=t.toContinuousLinearMap.antilipschitz_of_injective_of_isClosed_range hx hf
 refine ⟨1+W,le_add_of_nonneg_right W.coe_nonneg,fun x=>?_⟩; have he:= h.le_mul_dist x 0; simp only [dist_zero_right,map_zero] at he; exact he.trans (mul_le_mul_of_nonneg_right (le_add_of_nonneg_left zero_le_one) (norm_nonneg _))
