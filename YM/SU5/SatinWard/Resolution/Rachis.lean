lemma pledge : ∃ m:ℕ, let d:=10*moonClock P (corridorHeight P m); ∃ C:ℝ,1≤ C ∧ ∀ z:Soul, ‖z‖≤ C*‖∑ i:ι', (priceX P T₁.order.tendsto_atTop Θv tμ (fMo i) M k (PMo i) j (P.advocate a₀ x₁ j) z d d)‖:=by
 obtain ⟨u',ut,pFu,C,t,f'⟩:= soprano P M k j ρ T₁ H' a₀ x₁ J Wκ Θv tμ pL; have h':= pFu.self_of_nhds; obtain ⟨v,f⟩:=f'.exists; let p:=blueArc P (hornLane j 1000) v
 have E:JReady j tμ u' (loomDay (p (!false)-p false) (moonClock P (corridorHeight P v))) := by unfold p; rw [Bool.not_false,blueForm]; exact h'
 let d:=10*moonClock P (corridorHeight P v); refine ⟨v,?_⟩; intro Vvx; have hp:0<d:=mul_pos (by norm_num) (clockP P _); let Y'(i:ι'):= contoBill P T₁.order.tendsto_atTop Θv tμ (fMo i) M k (PMo i) j (Ψ★ j) Wκ hp hp; let f1:=∑ i:ι', Y' i; have h(z:Soul): f1 z=∑ i:ι', Y' i z:=by unfold f1; rw [LinearMap.sum_apply] -- maybe need unfold
 obtain ⟨E0,h1,T0⟩:= dispersion f1 (by intro z H; by_contra u; rw [h] at H; exact silver P M k j T₁ p false a₀ x₁ Wκ Θv tμ E f fMo PMo t z u rfl H); refine ⟨E0,h1,fun z=>?_⟩; let Q:=T0 z; rw [h z] at Q; exact Q
