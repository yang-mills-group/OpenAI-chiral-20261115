lemma orderWidth : T₀★ < r:= by
 rw [stamp_width P j q c t sT]; linarith only [windowLaw P ρ (Φs.money.1.trans Φs.money.2.le), loans_le P ρ Φs.money.1 Φs.money.2.le, P.macroStep_pos v, clockP P (fρ v)]
lemma arm_relax (h:r≤u)(q':r≤d) : ‖quietArm (ω⟠) (η★ • (P.rawBase j x t u d))‖≤ q★ :=by
 let l:= τ★ Vx ((r)-T₀★) ((r)-T₀★); let hR:=scale_corridor P (v:=v); let e:= 𝔅⁻¹ • l; let z:= 𝓓^4
 have he: ‖quietArm (ω⟠) (z • e)‖ ≤ q★:=by rw [map_smul,norm_smul, show ‖z‖=μ✩^4 from by unfold z; rw [norm_pow,Complex.norm_real, Real.norm_eq_abs,abs_of_nonneg hR.1.le]]; exact pay_arm P j x q ρ T₁ c t sT Φs hμ Q' uBank -- argument order `sT before Φs` RadiusT.
 have hh:=orderWidth P j q ρ T₁ c t Φs sT hμ Q' uBank -- order here
 rw [P.rawBase_step j x t hh.le hh.le h q',show η★ • (τ★ (P.rawBase j x t r r) (u-r) (d-r)) = (τ★ (z • e) (u-r) (d-r)) from ?_]; refine le_trans (Marble.arm_sand_cost (ξx) _ (imPrev P j x) ..) he -- need q Immutable
 unfold e z l; unfold sand; rw [← smul_smul, Algebra.mul_smul_comm, Algebra.mul_smul_comm, Algebra.smul_mul_assoc, Algebra.smul_mul_assoc]; rfl
lemma arm_abs (h:r≤u)(q':r≤d): ‖△ (η★ • (P.base j x t u d))‖≤ q★:=by
 rw [←P.reprise_rawBase, ←P.reprise_smul]; exact (push_arm_cost ..).trans (arm_relax P j x q ρ T₁ c t Φs sT hμ Q' uBank h q')
lemma arm_absStar (h:r≤u)(q':r≤d): ‖△ (star (η★ • (P.base j x t u d)))‖≤ q★:=by
 rw [star_smul, show star η★=η★ from by simp, show star (P.base j x t u d)= P.base j x (t.kiss P j) d u from ((by rw [P.base_kiss]; rfl): P.base j x (t.kiss P j) d u= star (P.base j x t u d)).symm]; exact arm_abs P j x q ρ T₁ ((plane j 0).motion c) (t.kiss P j) Φs (Stamped.kissed P j q c t sT) hμ Q' uBank q' h
