lemma co_prism (z:GKey)(p:z≠0) : hueV j z ≠0:=by
 intro h; let K:= silenceE z; have hx: K≠0:= (fun e=> p (funext (fun i=>Complex.ofReal_injective (by simpa only [Pi.zero_apply, Complex.ofReal_zero, K,silenceE] using (congrFun e i)))))
 have he: starKey K=K:=funext (fun i=>Complex.conj_ofReal _)
 let x:=dynamicSpin z; let pℓ:= gaugeKin j x j x (lofty j); have hv:pℓ=0:=by unfold pℓ x; rw [hleft]; apply sum_eq_zero; intro q _; rw [bExchange]; exact mul_eq_zero_of_right _ (congrFun h q) -- syntax
 unfold pℓ x at hv; rw [giveY] at hv; change gaugeKin j (rangeHue K) j (rangeHue K) _=0 at hv; rw [gaugeKin,boutique,polKernel,show puBand _ _=(quireM K:ℂ) from (by have hx:=quireSale K; rwa [he] at hx)] at hv; let d:= (clear_quadratic K hx).ne'; refine mul_ne_zero (show (64:ℂ)≠0 by norm_num) (mul_ne_zero (Complex.ofReal_ne_zero.mpr (kinCash j)) (Complex.ofReal_ne_zero.mpr d)) hv
lemma heartPrism : ∃ C:ℝ,0 < C∧∀ u v:GKey,‖u-v‖≤ C * ‖hueV j u-hueV j v‖:=by
 obtain ⟨K,hk,t⟩:= (LinearMap.exists_antilipschitzWith (hueV j)) (LinearMap.ker_eq_bot'.mpr (fun x h=> by_contra (fun e=> co_prism j x e h)))
