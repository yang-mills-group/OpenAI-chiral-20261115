 intro S'; let G:= (ν); let X:=P.ManyF j x -- notation X earlier variable bien?
 let U':=pⓐ b p; let V':=pⓐ (!b) p; let l:=q◁; have hv:0<l:=clockP ..
 let p':=δ✩ p; let v':=δ✩ qv; have hz(p:Bool→ Vantage)(qN:Ordered p j b (40*l)): l ≤ vistaGap p j b θ:=by unfold vistaGap; change q◁ ≤_; change 0< q◁ at hv; let w:=qN.gap; unfold l at w; linarith
 have ht(i:Bool):pⓐ i qv=pⓐ i p:= P.locate_same j x (fun l g=> (tT i _ g).symm) _; have he: |p'-v'|≤ 2*τ v:=by unfold p' v' vistaGap; rw [abs_le]; constructor<;> linarith only [(abs_le.mp (h b)).1,(abs_le.mp (h b)).2,(abs_le.mp (h (!b))).1,(abs_le.mp (h (!b))).2];
 let VAR:= Marble.touch (ν) Ω (imMemo ..) (q◁) (p') (v') hv (hz p qN) (hz qv qN') U' V'; unfold S'; rw [muster P j x q ρ Φs N L₀ t₀ p b qN, muster P j x q ρ Φs N L₀ t₀ qv b qN', ht b,ht (!b)]; apply VAR.trans; change _≤ Real.sqrt (2*U)*(2/l*(2*τ v)*Real.sqrt (2*U)); rw [Real.norm_eq_abs]; have hm:= scepter_bound P j x q ρ T₁ uBank Φs hμ Q' N L₀ t₀ p; refine mul_le_mul (hm b).2 (?_) (by positivity) (Real.sqrt_nonneg _); exact mul_le_mul (mul_le_mul_of_nonneg_left he (div_nonneg zero_le_two (show 0≤q◁ from hv.le))) (hm _).1 (norm_nonneg _) (mul_nonneg (div_nonneg zero_le_two (show 0≤q◁ from hv.le)) (mul_nonneg zero_le_two ((P.macroStep_pos _).le)))
