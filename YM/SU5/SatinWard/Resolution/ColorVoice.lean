lemma capPlus (t:f0 ≤ v)(o:s≤v)(w z:Soul) : Y♯ (w+z) v u r=Y♯ w v u r+Y♯ z v u r:=by
 obtain ⟨c,d⟩:=W.tally.poses s h₀ a qa; rw [capPay P p e j a M k qa i x _ t,capPay P p e j a M k qa i x _ t,capPay P p e j a M k qa i x _ t]; rw [map_add]; exact prime_add P j a M qa i x (W.stamps s v _ _ h₀ o qa d) t q p' _ _ -- repeat' rw may blow
lemma capScale (t:f0 ≤ v)(o:s≤v)(w z:Soul) (g:ℝ): Y♯ (g • w) v u r= g • Y♯ w v u r:=by
 obtain ⟨c,d⟩:=W.tally.poses s h₀ a qa; rw [capPay P p e j a M k qa i x _ t, capPay P p e j a M k qa i x _ t,map_smul]; exact prime_scale P j a M qa i x (W.stamps s v a c h₀ o qa d) t q p' _ _
