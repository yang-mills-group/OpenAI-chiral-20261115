lemma price_cost (c:s<v):‖priceX P p e j a M k qa i x ((STar v).symm z) u r - annoFace P i x v (home P a v) (ρ z j v) u r‖ ≤ 2*‖z‖ * bondMonth P η A s v:=by
 let h:=h₀.trans c.le; rw [←encodeFront P i a M x h _ u r rfl]; unfold priceX; rw [← P.locate_sub,P.locate_cost, ← P.reprise_sub]; exact (P.reprise_pay ..).trans (harmonyLimit P p e j a M k qa i x z W h₀ q p' c h)
