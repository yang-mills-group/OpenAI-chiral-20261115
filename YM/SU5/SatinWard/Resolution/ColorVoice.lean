noncomputable def freshF (m:Axis)(t: Vantage)(X:P.Spectrum0 m): (P.ColorHil m X).Op →L[ℝ](P.ManyF m X).Op := by
 let Q: (P.ColorHil m X).Op →ₗ[ℂ](P.ManyF m X).Op:= { toFun v:= P.locate m X t (P.reprise m X v), map_add' z w:=by rw [P.reprise_add,P.locate_add], map_smul' a z:=by rw [P.reprise_smul,P.locate_smul]; rfl }
 exact ((Q.mkContinuous 1 (fun x=>by change ‖P.locate m X t (P.reprise m X x)‖≤ _; rw [P.locate_cost,one_mul]; exact P.reprise_pay ..)).restrictScalars ℝ)
lemma freshCutt (t: Vantage)(V:(P.ColorHil i x).Op): freshF P i t x V=ℛ t (Φ V):=rfl
lemma eu_x (u1:f0≤v): freshF P i (-(home P a f0)) x (capitalize P p e j a M k qa i x z v u r)= annoFace P i x v (home P a v) (ρ (STar v z) j v) u r:=by rw [capPay P p e j a M k qa i x _ u1]; exact encodeFront P i a M x u1 (ρ (STar v z) j v) u r rfl
noncomputable def realFreshF (z:Soul)(v:ℕ)(u r:ℝ): (P.ManyF i x).Op:= annoFace P i x v (home P a v) (ρ (STar v z) j v) u r
include W hx hz'
lemma powerColor : Tendsto (fun v=>realFreshF P p e j a M k qa i x z v u r) atTop (𝓝 (ΞPrice z u r)):=by
 let p':=freshF P i (-(home P a f0)) x; refine Tendsto.congr' ?_ ((p'.continuous.tendsto (Ξ z u r)).comp (can_presence P p e j a M k qa i x z W hx hz'))
 filter_upwards [eventually_ge_atTop f0] with v h; exact eu_x P p e j a M k qa i x z h
noncomputable def contoBill : Soul→ₗ[ℝ](P.ManyF i x).Op:= (freshF P i (-(home P a f0)) x).toLinearMap.comp (canBill P p e j a M k qa i x W hx hz')
lemma cantorBill : ΞPrice z u r= contoBill P p e j a M k qa i x W hx hz' z:=rfl
