lemma can_add (x y:Soul) (kμ:Axis)(x':P.Spectrum0 i) : cantabile P p e kμ a M k qa i x' (x+y) u r=cantabile P p e kμ a M k qa i x' x u r+cantabile P p e kμ a M k qa i x' y u r:=by
 refine bornMan (H:=P.ColorHil i x') (fun z v=>capitalize P p e kμ a M k qa i x' z v u r) (fun z=>cantabile P p e kμ a M k qa i x' z u r) (fun z=>can_presence P p e kμ a M k qa i x' z W hx hz') x y ?_
 filter_upwards [ (small_clock P W.tally).eventually (inter_mem (gt_mem_nhds hx) (gt_mem_nhds hz')),eventually_ge_atTop f0] with v hv hx; exact capPlus P p e kμ a M k qa i x' W hx (le_of_lt hv.1) (le_of_lt hv.2) hx le_rfl x y
lemma can_tune (x:Soul)(b:ℝ) (kμ:Axis)(x':P.Spectrum0 i) : cantabile P p e kμ a M k qa i x' (b • x) u r=b • cantabile P p e kμ a M k qa i x' x u r:=by
 refine bornReg (H:=P.ColorHil i x') (fun z v=>capitalize P p e kμ a M k qa i x' z v u r) (fun z=>cantabile P p e kμ a M k qa i x' z u r) (fun z=>can_presence P p e kμ a M k qa i x' z W hx hz') x _ ?_
 filter_upwards [(small_clock P W.tally).eventually (inter_mem (gt_mem_nhds hx) (gt_mem_nhds hz')),eventually_ge_atTop f0] with v hv hx; exact capScale P p e kμ a M k qa i x' W hx (le_of_lt hv.1) (le_of_lt hv.2) hx le_rfl x x _
