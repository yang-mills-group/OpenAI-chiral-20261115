private lemma bornMan {H:Hilbert}(F:Soul→ ℕ→ H.Op) (W:Soul→ H.Op)(h:∀ x,Tendsto (F x) atTop (𝓝 (W x)))(x y:Soul)(p:∀ᶠ v in atTop,F (x+y) v=F x v+F y v): W (x+y)= W x+W y:=tendsto_nhds_unique (h (x+y)) (((h x).add (h y)).congr' (EventuallyEq.symm p)) -- include W ghost remove
omit W in
private lemma bornReg {H:Hilbert}(F:Soul→ ℕ→ H.Op)(W:Soul→ H.Op)(h:∀ x,Tendsto (F x) atTop (𝓝 (W x)))(x:Soul)(a:ℝ)(p:∀ᶠ v in atTop,F (a • x) v=a • F x v): W (a • x)=a • W x:=tendsto_nhds_unique (h (a • x)) (((h x).const_smul a).congr' (EventuallyEq.symm p))
