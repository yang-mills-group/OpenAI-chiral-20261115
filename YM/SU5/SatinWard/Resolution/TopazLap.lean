 obtain ⟨V,Z,p⟩:= fiscal_meter P η M W 
 let f:=4*soulQuote P η A s; let a:=unitX P; let t:= (σ 0)^(15/8:ℝ); have hz:0< t:=Real.rpow_pos_of_pos (P.macroStep_pos _) _; have ht:0<soulQuote P η A s:=mul_pos (Real.exp_pos _) (mul_pos (quote_live _) (healthy P M W ht7)); have hp:= sprint_pos P.par.R.L
 let B:= f* (V*(sprintCost P.par.R.L)^s)/t; refine ⟨B,(by unfold B f; positivity),fun v g=>?_ ⟩; unfold bondMonth; rw [monad_eq]; calc
    _ =f*((unitX P)^v*(sprintCost P.par.R.L^(v-s))⁻¹):=by unfold f; ring
    _ ≤ f*(V * sprintCost P.par.R.L^s * ((julyP P)⁻¹)^v):=by
         refine mul_le_mul_of_nonneg_left (le_trans (mul_le_mul_of_nonneg_right ?_ (show 0 ≤ (sprintCost P.par.R.L^(v-s))⁻¹ from by positivity)) (p _ _ g)) (by unfold f; positivity)
         exact le_mul_of_one_le_right (pow_nonneg (zero_le_one.trans (unit_live _)) _) (turquoise ..)
    _ =_:=by change f* _ = B*(t* (julyP P)⁻¹^v); unfold B; field -- may not know power logical
