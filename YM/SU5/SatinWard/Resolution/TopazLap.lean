 let j:= κgrow P η pT e K U (ht7.trans_lt u); rw [capPay P pT e vo q M K p i x U (ht7.trans u.le),norm_sub_rev]; let z:= (Bv v); let t:= harmonyLimit P pT e vo q M K p i x (z U) W ht7 hl hr u (ht7.trans u.le); rw [show (Bv v).symm (z U)=U from z.symm_apply_apply _] at t; refine t.trans ((mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left j zero_le_two) (wbal P M W ht7 v).le).trans_eq ?_); unfold unitX; ring -- try rewrite
