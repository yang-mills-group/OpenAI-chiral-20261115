theorem frisk : ∃ E:ℝ,0<E∧∀ v:ℕ,s<v→∀ (q:Cover)(p:ResidualPermit q)(i:Axis)(x:P.Spectrum0 i)(l r:ℝ),4*moonClock P s≤ l→4*moonClock P s≤ r→∀ z:Soul,
 let d:= (2*P.macroStep v) • tideX P η q p M i x pT e K z l r
 let t:= E*‖z‖*(P.macroStep v)^(15/8:ℝ)
 ‖tideAcc P η q p M i x pT e K z l r v-d‖≤ t ∧ ‖tideRaw P η q p M i x pT e K z l r v-d‖≤ t:=by
 choose E h f using fun i:Axis=> shadowMint P η M i W ht7 pT e K T₁ H' a₀ x₁ J Lh R
 let C:=∑ i:Axis,E i; have hx(i:Axis):E i ≤ C:= single_le_sum (fun i _=> (h i).le) (mem_univ _)
 obtain ⟨F,w,W'⟩:=wrack_time P η M W ht7; have he:0<C:=(h 0).trans_le (hx 0)
 refine ⟨8*F+8*C,(by positivity),fun v g q p i x l r hl hr z=>?_⟩; intro d t
 let X(j:Axis):= cantabile P pT e j q M K p i x z; let Y(j):= capitalize P pT e j q M K p i x z v; let zQ:=‖z‖*(ΞAA v); let p0:= tideAcc P η q p M i x pT e K z l r v; let p1:= tideRaw P η q p M i x pT e K z l r v; let m(j:Axis)(b):=galley P i x v (incMove j b) (X j) l r; let n(j:Axis)(b):=galley P i x v (incMove j b) (Y j) l r; let Lt(j):= tangentD P i x (X j) l r j; let Z(j:Axis):=m j true-m j false; let R(j:Axis):=n j true-n j false
 have hp:0 < (ΞAA v):=Real.rpow_pos_of_pos (P.macroStep_pos _) _; have hv:0≤zQ:=by unfold zQ; positivity
 have YZ(j:Axis)(b):‖n j b-m j b‖ ≤ F*zQ:=by
    let y:= hor_width P η q p M W ht7 g.le; have w:=abs_le.mp (inc_wallet P (v:=v) i j b); unfold n m galley; rw [P.charter_dist]; let V:= spareL P η q p M z j i x W ht7 pT e K g (by linarith only [w.1,y,clockP P s,hl]: moonClock P s ≤ l+P.tock v (incMove j b i)) (by linarith only [w.2,y,clockP P s,hr]:moonClock P s≤ r- P.tock v (incMove j b i)); exact V.trans ((mul_le_mul_of_nonneg_right (W' v g.le) (norm_nonneg _)).trans_eq (by unfold zQ; ring)) -- `tₖ` ν notation v binder original! Lean syntax hygiene section includes hidden costs. check
 have h1(j:Axis): ‖R j-Z j‖ ≤ 2*(F*zQ):=by unfold R Z; rw [sub_sub_sub_comm]; refine (norm_sub_le ..).trans ?_; nlinarith only [YZ j true,YZ j false]
 have hx'(j:Axis)(b): ‖m j b-X j l r-(eitherPole P b v) • Lt j‖ ≤ C*zQ:= by exact (f j v g.le q p i x b l r hl hr z j).trans ((mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right (hx j) (norm_nonneg _)) hp.le).trans_eq (by unfold zQ; ring))
 have h2(j:Axis): ‖Z j-(2*P.macroStep v) • Lt j‖ ≤ 2*(C*zQ):= differenceH _ _ _ _ _ _ (hx' j true) (hx' j false) -- K notation use macro.T.`?
 have h3: ‖p0-d‖ ≤ 8*(C*zQ):=by change ‖(∑ j:Axis,Z j) - (2*P.macroStep v) • (∑ j:Axis,Lt j)‖≤ _; rw [Finset.smul_sum,←Finset.sum_sub_distrib]; refine (norm_sum_le ..).trans (le_trans (Finset.sum_le_sum fun i _=>h2 i) ?_); simp; linarith -- simp pOK
 have h4: ‖p1-p0‖ ≤ 8*(F*zQ):= by change ‖(∑ j:Axis,R j)-(∑ j:Axis,Z j)‖≤ _; rw [←Finset.sum_sub_distrib]; refine (norm_sum_le ..).trans (le_trans (Finset.sum_le_sum fun i _=>h1 i) ?_); simp; linarith
 have ht:t=8*(F*zQ)+8*(C*zQ):=by unfold t zQ; ring
 rw [ht]; exact ⟨h3.trans (le_add_of_nonneg_left (by positivity)), (norm_sub_le_norm_sub_add_norm_sub _ p0 _).trans (add_le_add h4 h3)⟩
