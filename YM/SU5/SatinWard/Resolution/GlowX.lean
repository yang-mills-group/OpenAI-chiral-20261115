lemma statSpin [Nonempty η] :
 ‖arity P ti i x (Pse ((Bv v).symm Kℓ)) v l r- Pse ((Εw v)⁻¹ • (Bv v).symm U) l r‖ ≤ dayNum P η s v vo A H:=by
 let V':= ht7.trans f0'.le; let W':=U
 let t:= motionLap P η q p M W' vo ti i x V' W ht7 hl hr K lι f0' tD pZ
 let S:= δ₀; have hc:= clockP P s
 have h₁: S≤ l:=by linarith only [hl,hc]
 have h₂:S≤r:=by linarith only [hr,hc]
 have hu(i:Axis)(b:Bool): S ≤ l+P.tock v (incMove ti b i) ∧ S ≤ r-P.tock v (incMove ti b i):=by
    obtain ⟨o,h⟩:= W.tally.poses s ht7 q p; have hZ:= hor_3 P q (W.stamps s v q o ht7 f0'.le p h)
    have e:=(abs_le.mp (inc_wallet P (v:=v) i ti b)); unfold S; constructor<;> linarith only [e.1,e.2,hl,hr,hZ,hc]
 let psZero(b):= galley P i x v (incMove ti b) (Pse ((Bv v).symm Kℓ)) l r; let Y'(b):= galley P i x v (incMove ti b) (Hψ V' Kℓ) l r
 let u:= Ψε v; let z:= arity P ti i x (Pse ((Bv v).symm Kℓ)) v l r
 have hp(b:Bool): ‖Y' b-psZero b‖≤2*u:=by unfold Y' psZero galley; rw [P.charter_dist,norm_sub_rev]; refine (harmonyLimit P pT e vo q M K p i x Kℓ W ht7 (hu i b).1 (hu i b).2 f0' V').trans_eq ?_; rw [leg_norm,mul_one]
 let y:= Hψ V' W' l r; let T':=arity P ti i x (Hψ V' Kℓ) v l r
 have hv:‖T'-z‖ ≤ 4*u:=by
    rw [show T'-z= (Y' true-psZero true)+(Y' false-psZero false) from (by unfold T' z arity psZero Y'; abel)]; exact (norm_add_le ..).trans ((add_le_add (hp true) (hp false)).trans_eq (by ring))
 -- argument `t` real shift, using real is equivalent norm.New cost.Vessel. output included.
 let k:0<c:= intLive _; have he:‖y-Pse ((Bv v).symm W') l r‖ ≤ (2*u) * |Tτ|:=by
    rw [norm_sub_rev]; refine (harmonyLimit P pT e vo q M K p i x W' W ht7 h₁ h₂ f0' V').trans ?_; rw [mul_right_comm]; exact mul_le_mul_of_nonneg_left ((tempered P _ _ _ _ _ _ pZ).trans (le_abs_self _)) (by exact mul_nonneg zero_le_two (wbal P M W ht7 v).le)
 rw [can_tune P pT e q M K p i W (hc.trans_le h₁) (hc.trans_le h₂)]; exact clearSt _ _ _ _ z y T' _ k t he hv
