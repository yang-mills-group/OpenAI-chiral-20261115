 obtain ⟨vo,ho⟩:= lawn (P:=P.par) (d:=x) (b:=b) p₀
 let t':= RecruitW.enter P.run Γ Pay kC Tξ n m Z V F W g.order g.Jade M0 cloverFrame (yardF cloverFrame) ℌ Α (fun i k s=> paintClass P.run s i k) hz.2.2.1 hz.2.2.2.1 μ _ _ hL fp (stretch_funded _).choose_spec Lg (L₀.report η (strollϕ Wage4) (strollCost _).1 (strollCost _).2) fh fa vo ho -- G/T order: enter B Chill then G. vo then ho
 have z:∀ᶠ v in atTop,∀ᶠ i in atTop,∀ k,v<P.run.uv k→∀ (X:Soul),‖X‖≤1→Sonata X → preBank Y (boreLeg P.par (ballField P.par a b x)) (ballField P.par a b x) cloverFrame v i k (duetSong Y v i j X):=by
