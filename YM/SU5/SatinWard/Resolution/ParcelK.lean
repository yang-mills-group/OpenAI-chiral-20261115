lemma turnRay (w:f0 ≤ v): let vtx(b:Bool): Cover:= Dovetail.ac2.s.act (y b);
 P.E v (market P M z 3 ρ pHw e K v y).val= -star (P.E v (market P M z 2 ρ pHw e K v vtx).val):=by
 intro vtx; rw [payable_marketE P M z 3 ρ pHw e K y w,payable_marketE P M z 2 ρ pHw e K vtx w]; exact ionVisit _ _ _ (accounts P (y false) M ((v★ v) z) (ρ.date.stock v w).2 (y true))
