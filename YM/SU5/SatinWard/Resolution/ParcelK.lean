theorem sideways: Ωk 3 pv= - star (Ωk 2 (ript pv)):=by
 let V':=tideMark P pv; let T1:=scanner P M z 3 3 ρ pHw W e K T h pv p1.1 p1.2 R; let u(v:ℕ)(b:Bool) := ac2.s.act (V' v b); have h':Tendsto (fun v:ℕ=>landingY P v (u v)) atTop (𝓝 (ript pv)):=by
    simp_rw [u,turn_landing]; exact ript_cash.continuousAt.tendsto.comp (tide_in P pv)
 have T2:=meanPair P M z 3 2 ρ pHw W e K T h (ript pv) u1.1 u1.2 R u h'; exact tendsto_nhds_unique T1.1 (T2.2.star.neg.congr' ((eventually_ge_atTop f0).mono (fun i t=> (turnRay P M z ρ pHw e K (V' i) t).symm)))
