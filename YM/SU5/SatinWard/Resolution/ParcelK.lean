private lemma rent_air {f: ζX → ℂ}(F:ℕ→ P.Test)(h:∀ x:ζX,Tendsto (fun n:ℕ=> P.singleState 3 n x (F n)) atTop (𝓝 (f x)))(p:∀ᶠ n:ℕ in atTop,∀ x:ζX, ‖P.singleState 3 n x (F n)‖ ≤ T):
 Integrable f (P.pillars 3)∧ Tendsto (fun n:ℕ=> P.E n (F n).val) atTop (𝓝 (∫ x,f x∂(P.pillars 3))):=by
 let V n (x:ζX):= xE 3 n x (F n); have he(n:ℕ): AEStronglyMeasurable (V n) (Eν):=(litC P n (F n)).aestronglyMeasurable; have hv₀: ∀ᵐ x∂(P.pillars 3), Tendsto (fun n:ℕ=>V n x) atTop (𝓝 (f x)):=ae_of_all _ h; let u:= aestronglyMeasurable_of_tendsto_ae atTop he hv₀; refine ⟨Integrable.of_bound u T (ae_of_all _ (fun x=>le_of_tendsto (h x).norm (p.mono (fun _ q=>q x)))),?_⟩; simp_rw [means_mark]; exact tendsto_integral_filter_of_dominated_convergence (fun _=> T) (Eventually.of_forall he) (p.mono fun _ q=>ae_of_all _ q) (integrable_const _) hv₀
include h hT broadH R M W e K pHw hG
