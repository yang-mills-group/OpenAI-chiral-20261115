 obtain ⟨C',u,E⟩:= uplift P M z i mu ρ pHw W e K T h pv hT broadH R yG hG; refine rent_air P C' _ (?_) (E.mono fun _ q x=>(q x).2.1); exact fun x=> (session_pair P M z i mu ρ pHw W e K x T h pv hT broadH R yG hG).1
