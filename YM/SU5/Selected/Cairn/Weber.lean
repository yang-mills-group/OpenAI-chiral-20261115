abbrev enter:= min Mileage.austere valée -- enough for guard alignment + CPA prices & projection
lemma enter_p:0<enter:= lt_min Mileage.aust_p valley_hot
lemma lower_e: Avoriaz enter:=by
 intro p; filter_upwards [vale p] with i q; obtain ⟨γ,g,w⟩:= q; refine ⟨γ,g,?_⟩; filter_upwards [w] with N v; exact ⟨fun b M X u=> v.vent b M X (u.shrink (min_le_right ..)),fun b M L X Y p t=> v.plank b M L X Y (p.shrink (min_le_right ..)) (t.shrink (min_le_right ..))⟩
-- geometry Timeline carry only lattice size.
def TipC := Tower.Selection.Season.DStar +1
lemma tip_gt : 0<TipC:= lt_add_of_pos_of_le (Dais.Span.delay (show 1 ≤ (4:ℕ) from by decide)).choose_spec.1 zero_le_one -- name
structure PriceE (T:ℝ)(Ω:ℝ)(W:Tour)(A:Giant) (Z:A.Notes→basisRule)(C γ:ℝ): Prop where
 exact_t : W=A.TourA
 degree : 20≤A.rank
 year:Year A Z -- abbrev Year
 slope:1≤C
 eligible: Tools T (coastCap C) (wageL C) (Giant.americans W A.beams A.rank) Ω A.rank A.debt.val
 gamma : 0<γ
 clear: Giant.Clear A.rank A.debt.val (coastCap C)
 pay : ∀ᶠ U in mounts, let N:=U.2; let M:=U.1; Winter 4 enter N γ A.debt.val A.snowLine ∧ (TilePure (N:=N) M→ Loft Z A.n A.Whistle A.TourA.blueprint enter γ C A.debt.val (tideU A.rank) A.orderL A.t M N)
def guardFee (A:Giant):= (CF.Pannier.Chancel.Attic.rent' A.rank A.debt.val)⁻¹ * (scot A.debt.val)⁻¹ -- Attic namespace short open parent?
lemma metroBank (Ω:ℝ)(W:Tour) :∃ (D:ℝ)(A:Giant)(Z:A.Notes→basisRule)(C γ:ℝ),PriceE TipC Ω W A Z C γ∧D=guardFee A:=by
 -- choose without elabor omega huge.
 let c:ℕ:=20; let y:=tideU c; let k:=2*(y+1)+2
 obtain ⟨Z,p⟩:= Crest.Rail.requests W.Wp W.blueprint (show k≥3 by unfold k; omega) W.elevation; obtain ⟨B,v⟩:= (Rail.exact_line Z k).exists; obtain ⟨C,u,l⟩:= lodge Z W.Wp W.seats W.elevation W.blueprint y lower_e enter_p p; -- order tune
 have hu:1≤ Giant.wageL C:= Tender.toll_pos (show 0 ≤ coastCap C from (by unfold coastCap; positivity))
 have hc:100≤ coastCap C:= Giant.capCost C u; obtain ⟨d,⟨⟨t,e⟩,v'⟩,j⟩:= ((l.and (clearout c _ (show 0≤coastCap C by linarith))).and (mirabilis TipC (americans W B c) (wageL C) (coastCap C) Ω c (by linarith) hu) |>.and (eventually_gt_atTop 0)).exists -- parentheses choose match
 obtain ⟨γ,f,x⟩:= t; let A:Giant:= ⟨W,B,⟨d,j⟩,c⟩; exact ⟨_, A,Z,C,γ,⟨rfl,le_rfl,v,u,v',f,e,x⟩,rfl⟩
#print PriceE.mk
noncomputable def grouping (B:Side)(v:ℕ) : Tour:= ⟨⟨v+1,by omega⟩, B⟩
def ordersZ (Ω:ℝ)(U:Supplier): Supplier:=fun K p X V B d T W M J l Z=>
 let ℓ:=4*r₃ p.L ((Aliases.finite_brix K.j p.L p.odd_side).choose) (Journey.distanceLaw l) p.J+1
 let A:=grouping B (2*(ℓ+4*B.val)); max (U K p X V B d T W M J l Z) (metroBank Ω A).choose
abbrev crew:= grouping P.block (addgap (tent Y H))
lemma stamps_bill (Ω:ℝ)(A':ℝ)(z:Supplier)(p:decorate (ordersZ Ω z) P l A' ≤ P.h): decorate z P l A' ≤ P.h ∧ ∃ (A:Giant)(Z:A.Notes→basisRule) (C γ:ℝ),PriceE TipC Ω (crew Y H) A Z C γ ∧ guardFee A≤ P.h := by
 have hp : (metroBank Ω (crew Y H)).choose ≤ P.h:= (le_max_right _ _).trans p; obtain ⟨A,Z,C,γ,v,f⟩:= (metroBank Ω (crew Y H)).choose_spec; exact ⟨(le_max_left ..).trans p, A,Z,C,γ,v,f ▸ hp⟩
