private lemma priceB(Vv:Hilbert){a:Axis}(F:OS.Semigroup Vv a)(x:Vv)(f g:Vv.Op)(z:Bool→Vv.Op)(p:z false=star f)(h:z true=g)(v:ℂ): inner ℂ x ((Alps.trip F z [false,true] (fun i=> if i=true then v else 0)) x)= inner ℂ (f x) ((Alps.balcony F v) (g x)):=by
 rw [Alps.trip, Alps.trip,Alps.trip, p,h,if_pos rfl, if_neg Bool.false_ne_true,mul_one,Alps.balcony_zero,one_mul]; exact show _ from ContinuousLinearMap.adjoint_inner_right f x ((Alps.balcony F v) (g x)) -- star notation
variable (u w:ℕ)(f:Entry Y H s 3 false u)(g:Entry Y H s 3 false w)(p:0<u)(q₀:0<w)(vv: Neutral (tent Y H) f.val.val)(tt: Neutral (tent Y H) g.val.val)
