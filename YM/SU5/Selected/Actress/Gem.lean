local notation "B'"=> L₀ s w g q₀
include V Q Qc C U'
lemma forge (z:ℂ) : Ξ u w f g p q₀ vv tt z= inner ℂ X₀ ((Alps.balcony J' z) X₁):=by
 let L:K':= ⟨s,u,p,f,vv⟩; let Z:K':= ⟨s,w,q₀,g,tt⟩; let u'' (i:Bool) := if i=true then Z else L.rev Y H 3 false; let v := κ₀ (u'' false); have he₁: κ₀ (L.rev Y H 3 false)=star (κ₀ L) := Actress.Label.rest Y H V Q Qc 3 false (C 3) U' L; have he: κ₀ (u'' false) = star (κ₀ L) := (congrArg κ₀ (show u'' false=L.rev Y H 3 false from if_neg Bool.false_ne_true)).trans he₁
 have hx:κ₀ (u'' true)=κ₀ Z:=congrArg κ₀ (show u'' true=Z from if_pos rfl)
 exact (priceB U'.H J' Ω A' B' (fun i=> κ₀ (u'' i)) he hx z).trans (congrArg₂ (inner ℂ) (Actress.service_u Y H V Q Qc 3 false (C 3) U' s u f p) (congrArg (Alps.balcony J' z) (Actress.service_u Y H V Q Qc 3 false (C 3) U' s w g q₀)))
omit V Q Qc C U' in

-- exact gluing complex moments to UTC operator algebra. Identity noncomm continues as spill. Same witnesses. Avoid infer δ in shape supports.
private lemma costW(Q':Hilbert){a:Axis}(F:OS.Semigroup Q' a)(x y:Q')(t:ℝ≥0)(c:ℂ)(p:ℂ→ℂ)(h:∀ z,p z=inner ℂ x ((Alps.balcony F z) y))(g:inner ℂ x (F.E t y)=c): p (↑(t:ℝ)*Complex.I)=c:=(h _).trans (by rw [Alps.balcony_high,g]) -- auto section params? omit

structure Deposit (ξ:ℝ): Prop where
 minted: Crossed Y H V Q Qc C s e F F' χ r X d v x y ξ
 bill: ∃ (u w:ℕ)(f:Entry Y H s 3 false u)(g:Entry Y H s 3 false w)(p:0<u)(q:0<w)(t: Neutral K f.val.val)(t':Neutral K g.val.val),
    let Δ':= aperture Y H V Q Qc C s χ U' u w f g p q t t'
    Steams Y H V Q Qc 3 (C 3) (boundaryT A K d v) s U' f.val g.val (λ₀ d v) (λ₁ d v) (V₀ d v) (V₁ d v) ∧ (∀ i:ℝ, Δ' i= Alps.fare (J') Ω (L₀ s u f p) (L₀ s w g q) i) ∧
    (∀ n:ℕ, Δ' (((whenly (timeMesh Λ) s (1+n):ℝ≥0) :ℝ)*Complex.I)=(κ 3) ((λ₀ d v)* relocate K 3 (n:ℤ) (λ₁ d v)))∧
    (∀ i:ℝ, ∃ t:ℝ, t≠i∧ (ρ₀)/2< ‖Δ' t-Δ' i‖)∧ (∀ (s' w':ℕ)(b:0<w'),¬ Commute (L₀ s' w' (SlabMark.identity Y H s' 3 false w') b) (L₀ s u f p))
#print Deposit.mk
lemma gemstone (h:Crossed Y H V Q Qc C s e F F' χ r X d v x y ξ) : Deposit Y H V Q Qc C s e F F' χ r X d v x y U' ξ:=by
 obtain ⟨u,w,f,g,p,q,v₁,v₂,h₀,t,hℓ⟩:= spill Y H V Q Qc C s e F F' χ r X d v x y U' h -- χ Vv etc
 let P':= Ξ u w f g p q v₁ v₂; let Vv:=Alps.fare J' Ω (L₀ s u f p) (L₀ s w g q); let X':= (Γ₀ f.val); let Y':= (Γ₀ g.val); let S:=J'
 let o(z:ℂ):P' z=inner ℂ X' ((Alps.balcony S z) Y') := forge Y H V Q Qc C s χ U' u w f g p q v₁ v₂ z
 have he(i:ℝ): P' i=Vv i:= (o i).trans (by rw [Alps.balcony_floor]; exact (Alps.utc S Ω (Actress.fix_ground Y H V Q Qc _ _ _ U') _ _ X' Y' (Actress.service_u Y H V Q Qc 3 false (C 3) U' s u f p) (Actress.service_u Y H V Q Qc 3 false (C 3) U' s w g q) i).symm)
 exact ⟨h,u,w,f,g,p,q,v₁,v₂,h₀,he,fun i=>costW U'.H S X' Y' (whenly (timeMesh Λ) s (1+i)) _ _ o (h₀.slide i),fun i=> let u':= Classical.choose_spec (t i); ⟨Classical.choose (t i), u'.1, by change _ < ‖P' (Classical.choose (t i):ℝ)-P' (i:ℝ)‖; rw [he i, he (Classical.choose (t i))]; exact u'.2⟩,hℓ⟩
