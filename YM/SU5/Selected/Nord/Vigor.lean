    unfold Rv Stake.pulseZ; rw [Complex.norm_exp,Complex.sub_re, Complex.ofReal_re]; -- tune
 have ht:=farW Z0.toLid C Q; have he:0<prefactor (w.step V) G5 β:= prefactor_pos _
 have hs: 0 < (shotM L H β)^Fintype.card Y1.park.Free:= pow_pos (mul_pos (spare_pos _ D.localPrice (Z0.toLid.pos Q)) (point_p (lt_of_lt_of_le zero_lt_one (coast Z0.toLid C Q)))) _
 refine ⟨H, ht,?_⟩; rw [libre,dif_pos Q, jumpT, ← retailG]; unfold retail; rw [norm_mul, norm_mul,Complex.norm_real,Complex.norm_real, Real.norm_of_nonneg he.le,Real.norm_of_nonneg hs.le, hE, Real.log_mul (mul_pos he hs|>.ne') (Real.exp_pos _|>.ne'),Real.log_exp]; ring
