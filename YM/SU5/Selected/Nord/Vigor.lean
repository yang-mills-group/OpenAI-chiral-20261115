lemma hallOut : CrankOut J p p' x (libre (Z0:=Z0) Y1) q art w Ω:=by
 constructor; intro β F t u Z pE Δt μ E k; obtain ⟨v,h,H⟩:= reside Ty T Vq hv t Ω Y1 u pE Δt μ E k
 let pB:= T.member (matured Ty T Vq hv _ t).1 t.1; let ϒ:= retail (F:=F) (Z0:=Z0) Y1 pB
 have he: (Complex.exp v)= ϒ * ((Real.exp μ:ℝ):ℂ):= by simpa only [show (Pitching.input (V:=V) (w:=w) p' β F).v=0 from rfl, Complex.exp_zero, mul_one] using h -- tune
 have hf : ϒ≠0:=by intro ez; apply Complex.exp_ne_zero v; rw [he,ez,zero_mul]
 have hp:v.re= Real.log ‖ϒ‖+μ:=by rw [←Real.log_exp v.re, ← Complex.norm_exp, he, norm_mul,Complex.norm_real,Real.norm_of_nonneg (Real.exp_pos _).le,Real.log_mul (norm_ne_zero_iff.mpr hf) (Real.exp_pos _|>.ne'),Real.log_exp] -- tune
 exact ⟨v,⟨fun x hx=>(H x hx).symm⟩,by unfold libre; rw [dif_pos pB]; exact hp⟩
