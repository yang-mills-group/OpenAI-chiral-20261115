namespace LocalLimit.Preparation
open FullBill
variable {P:Preparation}{F:(s:Side)→ Scree.Loom s→Prop}(Y:Course P F)
local notation "tape" i:max => Y.voyage i
abbrev RootBook(i k:ℕ): Vestal (Y.ir i) P.block P.R.L:= ((Y.voyage i).X (Y.uv k)).gram
abbrev HighAge(s k:ℕ):= Y.uv k -1-s
abbrev Peck(i k s:ℕ):Tube SU.group (P.V.L.op (HighAge Y s k) (kint (Y.ir i) P.block P.R.L s)):= P.V.L.mint (HighAge Y s k) (kint (Y.ir i) P.block P.R.L s)
abbrev Stem(i k s:ℕ) := P.V.L.op (HighAge Y s k) (kint (Y.ir i) P.block P.R.L s)
local notation "Y_" s:max=> hat P.R.L P.x s
lemma oracle (s i k:ℕ)(p:s < Y.uv k):
    (RootBook Y i k (s+1)).path=(Peck Y i k s).up ∧ (RootBook Y i k s).path=(Peck Y i k s).down ∧ (RootBook Y i k (s+1)).funds=P.K.top.clip ∧ (RootBook Y i k s).funds=P.K.top.clip ∧
    ∀ t, Rue.FleetS (RootBook Y i k s).p.threshold t.1 → stove P.U ((tape i).CapeT s) (RootBook Y i k (s+1)) ((tape i).CapeT (s+1)) (apt (Y.ir i) P.block P.R.L s) (Stem Y i k s) Chi.canonical P.J.d (((tape i).X (Y.uv k)).wave s).val t= denZ (RootBook Y i k s) P.U ((tape i).CapeT s) t:=by
 let Q:= (Y.voyage i).X (Y.uv k); have he:= Q.pull.owns (s+1) p; have hx:= Q.pull.owns s p.le
 refine ⟨he.path.symm.trans (congrArg P.V.L.path (show Y.uv k-(s+1)= HighAge Y s k from (by unfold HighAge; omega))), hx.path.symm.trans (congrArg P.V.L.path (show Y.uv k - s=HighAge Y s k+1 from (by unfold HighAge; omega))), he.fund.symm,hx.fund.symm,Q.pull.wear _ p⟩
private lemma logB {u:ℝ}(p:0<u)(B:ℝ): ∃ Y:ℝ,∀ a b:ℝ,Y≤a→Y≤b→|a-b| ≤ B→ |Real.log a-Real.log b| ≤ u:=by
 let w:=max 1 (B/u); refine ⟨w,?_⟩; have hp:0<w:=lt_max_of_lt_left zero_lt_one; have hw:= le_max_right 1 (B/u)
 have he(a b:ℝ)(ha:w≤a)(hb:w≤b)(t:a-b≤ B) : Real.log a-Real.log b ≤ u := by
    have ht:=hp.trans_le hb; have hx:=hp.trans_le ha; rw [← Real.log_div hx.ne' ht.ne']; apply (Real.log_le_sub_one_of_pos (div_pos hx ht)).trans; rw [sub_le_iff_le_add,div_le_iff₀ ht]; nlinarith only [(div_le_iff₀ p).mp hw,t,mul_le_mul_of_nonneg_right hb p.le]
 intro a b Q D Z; rw [abs_le] at Z ⊢; refine ⟨?_,he _ _ Q D Z.2⟩; linarith only [he _ _ D Q (show b-a≤B by linarith only [Z.1])]
private lemma large_β (B:ℝ): ∀ᶠ s in atTop,∀ i k, s≤ Y.uv k→ B ≤ (RootBook Y i k s).beta:=by
 filter_upwards [(turnover P).eventually_ge_atTop (2*B)] with s v i k h; have hp:= ((tape i).X _).pull.sift s h; exact le_trans (by linarith : B≤ (Y_ s)/2) hp.1
lemma close_β (ε:ℝ)(hp:0<ε) : ∀ᶠ s in atTop,∀ i k, s<Y.uv k→ |Real.log (RootBook Y i k s).beta-Real.log (RootBook Y i k (s+1)).beta| ≤  ε:=by
 let C:= P.K.top.drift+ billX P.R.L +P.W.z + |billC P.R.L|; have h0:Tendsto P.δ atTop (𝓝 0):=by simpa only [pow_zero,one_mul] using P.app.post 0
 obtain ⟨A,hA⟩:= logB hp (C+1)
 filter_upwards [(h0.comp (turnover P)).eventually (ge_mem_nhds zero_lt_one), large_β Y A,(tendsto_add_atTop_nat 1).eventually (large_β Y A)] with s v t g i k w
 apply hA _ _ (t i k w.le) (?_ : A ≤ (RootBook Y i k (s+1)).beta); swap; · exact g i k w
 let U:= Y.voyage i; let Q:= U.X (Y.uv k); have he:= Q.pull.shift s w; have hx:= Q.due.fee s w; let W := P.W.arm (Y.meter.large.trans U.funds) (Y.uv k); have ht : |W.move s| ≤ C:= move_pay P.V P.W P.W.z W (P.W.pose _ _) w; have hD:= Q.pull.price s w; have hv: P.δ (Y_ s) ≤ 1:= v; change Q.pilot s = _ + W.move s at hx; change |(Q.gram s).beta-(Q.gram (s+1)).beta| ≤ _; have hp: |Q.fee s| ≤ (1:ℝ):=hD.trans hv; rw [abs_le] at ht hp ⊢; constructor <;> linarith only [ht.1,ht.2,hx,he,hp.1,hp.2]
-- checkout retains actual P chart. eventual in s uniform every i and any supported k even before kick. use in cp7B. Any Θ H in Phi-axis price. This doesn't compare full PT yet.
theorem grainPrice (ε:ℝ)(he:0<ε):∃ A> (0:ℝ),∀ᶠ s in atTop,∀ i k,s< Y.uv k → let T:= Stem Y i k s; let X:=RootBook Y i k s; let X':=RootBook Y i k (s+1); ∀ F: Monk SU.group T,∀ b≥A, 0< (baseX (Peck Y i k s) (hat P.R.L P.x s) (bareStores _) F.park F.k 1).det ∧
 |(Real.log (prefactor T SU.group X'.beta * (shotM P.L b X'.beta)^Fintype.card F.park.Free) + Corne.arcD (Peck Y i k s) (Y_ s) F)- (Perks.schedule P.L (More (P.Ctor (Y.ir i) (s+1))) (P.V.L.H (HighAge Y s k)) X'.beta-Perks.schedule P.L (More (P.Ctor (Y.ir i) s)) (P.V.L.H (HighAge Y s k+1)) X.beta)| ≤ ε* Perks.bulk (More (P.Ctor (Y.ir i) (s+1))):=by
 obtain ⟨A,h,g⟩:= jade_prec P.V P.chart ε he; refine ⟨A,h,?_⟩; filter_upwards [(turnover P).eventually_ge_atTop A, (tendsto_add_atTop_nat 1).eventually (large_β Y A),large_β Y A, close_β Y (cup SU.group ε) (cup_pos he)] with s v r l d i k t; intro T X X' F b D
 rw [retailG]
 exact g _ _ (kint _ _ _ _) (HighAge Y s k) F.park F.k (Y.meter.clear (Y.voyage i).funds _ s).1.pace _ _ _ _ v (r i k t) (h.trans_le (l i k t.le)) D (d i k t)
