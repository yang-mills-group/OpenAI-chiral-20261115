theorem jade_prec (ε:ℝ)(he:0<ε) : ∃ A > (0:ℝ),∀ (c f:Side)(e:f.val=c.val*R.L.val)(i:ℕ) (T:Forest (v.L.op i e).ratio)(q:(v.L.op i e).Choices), Bid.Larger (G:=SU.group) (v.L.op i e) → ∀ (x b b' y:ℝ), A≤ x → A≤ b→ 0 < b' → A≤ y → |Real.log b'- Real.log b| ≤ tollCup ε→
    let Y:=v.L.mint i e; 0< (baseX Y x (bareStores _) T q 1).det ∧ |Perks.tariff L Y T q b x y - (Perks.schedule L f (v.L.H i) b - Perks.schedule L c (v.L.H (i+1)) b')| ≤ ε * Fintype.card (Site f):=by
 let σ:= K.top.width; let μ:=K.top.clip.direct; let W:= v.W.parcel; have hw:0 < W:= v.W.reserve
 obtain ⟨B,v',u⟩:= Perks.tenure L p K.bind σ μ K.top.paths R.L (v.L.mood 0).width K.top.clip.quadratic_pos ε he
 refine ⟨B,v',fun c f e i T q a x b b' y=>?_⟩; let A:= v.L.op i e; let Y:= v.L.deed i; let X:= v.L.roof i; let X':= v.L.roof (i+1); have ht : Towers.Diagonal A (v.L.H i) (v.L.H (i+1)) (v.L.Z i):= Y.link (v.L.sized i e)
 have hP : Floor (v.L.H i) K.top.clip f W K.C:=X.2.1 f; have hp:= X'.2.1 c; let Z:= v.L.mint i e
 exact fun t₁ t₂ t₃ t₄ t₅=> u c f A T Z _ _ _ q rfl rfl W v.W.bar K.C 0 W hw hw ht ⟨fun x=>(hp.uniform.1 x).1⟩ hp.symmetric.1 (v.L.mood i) (v.L.tied i) hP a (X.2.2 f) x b b' y t₁ t₂ t₃ t₄ t₅

