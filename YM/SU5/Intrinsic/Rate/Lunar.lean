/-- Use `till_q` on actual StatV and allocated Fends. Works directly on the
same hv; no need to renew the Lunar purchase or even choose a different Arch.
And here Q is an actual Year provision and the input is charged. -/
lemma noncash_support (i:Scree.Hub ι)(hp:lunarExtent < coverNumber p.B i.val.2) : (noncash_E (p:=p) (p':=p') (o:=o) hv F) i=0 := by
 let e:= Uq.press_f tF
 let U0:= Uq.layout.full β Q F e
 let τ:= (Z.toLid.crew β Q).1
 obtain ⟨Qx,Qv,Fq⟩:= Pig.sail_t V (H₀:=Ys β F) (H₁:=Xs β) (M_:=o.SheepR)
 let G : Ξm → InkD ι := Lunar.sun (p:=p) (p':=p') hv o (Lunar.pennies F.1)
 have hb:p.B=radiusB x:= Z.request.boot.B
 have hk:1 ≤ radiusB x:= hb ▸ (p.B_pos)
 let L:= forge_P (H:=Up β) (Y:=Ys β F) (X:=Xs β) V o.SheepR D.D hv C' D.X D.jp
 -- simpler than going via Uq.master / Lunar payment. Use equality of the recipe directly on these same data.
 have hu(X:Ξm)(g:lunarExtent < coverNumber p.B X.2.1.val): G X= 0 := by
    by_cases v:X∈L
    · have h:= till_q V D.pilot D.Z U0.statv o.SheepR τ D.D hv Qx Qv Fq C' D.X D.jp X v
      have he:= Corona.cover_mono ((show X.2.1.val ⊆ (ref_Q x X).val from subset_union_left).trans h) (radiusB x)
      have hh:=he.trans (Corona.tile _ (5+300) _ (by omega))
      rw [hb] at g; exact False.elim ((not_le.mpr g) (hh.trans (Nat.le_add_right _ _)))
    funext z; apply Subtype.ext; change cars_P _ _ _ (Lunar.seedling _ _ _ _) = _; rw [←Lunar.birth hv (β:=β) (F:=F) X]; exact anchor_P (Y:=Ys β F) (X:=Xs β) (H:=Up β) V o.SheepR D.D hv C' D.X D.jp 0 X v z
 let Y:RegBudget ι:= sunY univ (EpR (N:=mid m B) x) (fun t=> ∑ j:Ξm with lift_I j=t,G j)
 let X:RegBudget ι:= sunY (rope_i (H:=oWell)) (keep_A (H:=oWell)) (fun t=> ∑ j:Ξm with j.1=t.1 ∧ j.2.1=t.2,G j)
 change writ_E (Y-X) i=0
 refine Test.fixed_long_writ _ _ (Q:=p) (fun i hp=> ?_) _ hp
 have he:Y i=0:=by
   refine sum_eq_zero fun j t => ?_; have h' : EpR x j=i:=(mem_filter.mp t).2; rw [←h',hb] at hp; have ht: coverNumber (radiusB x) (EpR x j).val.2 ≤ reach_T:= yard_m x j.2.1 hk; exact False.elim ((not_le.mpr hp) (ht.trans (Nat.le_add_left ..)))
 have hx:X i=0:=by
   refine sum_eq_zero fun j t=> sum_eq_zero fun s f => ?_
   have hf:s.2.1=j.2:= (mem_filter.mp f).2.2; have hxj: keep_A (H:=oWell) j=i:=(mem_filter.mp t).2
   apply hu; rwa [← hxj,keep_h j,←hf] at hp
 change Y i-X i=0; rw [he,hx,sub_zero]
