theorem purchase124 (T:TintDemand) (Bq:Supplier) (L M:ℝ) (hm:0<M) : ∃ (P : Spine) (K : P.Register) (c r : ℕ→ℕ) (x : P.Spectrum0 3) (R : P.Ellis 3 x)
    (i₀ : ℕ) (F U : SampleDose) (A : ℕ → P.Apron) (n : ℕ→ℕ) (w : Lead.Clan → Prism)
    (V : ∀ j : Axis, List Axis → ℝ → P.ColorHil j (P.advocate 3 x j)) (g h : ℕ)
    (X : P.HandleWith x c r A n)
    (Y : Lead.Clan → Test4 →L[ℂ] P.ManyF 3 (P.advocate 3 x 3)) (Z : Lead.Clan → Lead.Clan → Boundary.Distn E4),
    ActualRate P.par ∧ P.Roster ∧ P.NightCop ∧ Meritorious P.par ∧ 15 ∣ P.par.R.L.val ∧ P.par.R.L.val %16=1 ∧ Yoke.Dispatchers P.par ∧ (∃ nk:ℕ, TintCommercial nk (crayon T) P.par) ∧ id ≤ r ∧ uniform P K Bq L M ∧
    M4Furnish P K c r x R i₀ F U A n w V g h X Y Z ∧ P.Garrison x c r A n ∧ PlanetaryG.{u} P A ∧ (∀ x:P.Spectrum0 3,P.Guest x c r A n) ∧ ∃ p:CapBacked P x A c r n w, P.OverM4 x c r F U A n w V Y Z p := by
 -- See M6, using stronger Future generation here.
 obtain ⟨n,P,K,e,π₀,h0,h1,h2,h3,h4,R124,G',C,ec,q,H',A,a,season,c,r,h,Θ,b,β,ρ'⟩:= heavier_further ActualRate T (minister124 (crayon T)) Bq L M hm 1 zero_lt_one id
 obtain ⟨s,_,t⟩:=ρ'.exists
 obtain ⟨x,R,_,p,v,a',q',S'⟩:=t (fun _=>True) (Eventually.of_forall fun _=>True.intro)
 obtain ⟨X,V,qX,pX,hX,B',Be⟩:= gala_camera.{u} P x K R c r _ _ a' v h0 ⟨P.par.R.L.val/2,by omega⟩ ((P.treasury_plot A C H' a).mono fun s p=> p (s+1) (by omega) (s+1) le_rfl) β p q' S'
 obtain ⟨N,f',hW⟩:= P.seam_everyone x c r X p.setup (Heavier.loose P Θ); obtain ⟨i₀,w,F,U,Y,Z,z⟩:= (P.packages_rows x K R c r _ _ e p.setup X V qX pX hX N f').exists
 let t':Garrison P x c r X N:=⟨B', hW x, Θ⟩; let ht:= P.lockup_law x K c r R i₀ F U X N w V _ _ f' Y Z z t'; have hd:P.OverM4 x c r F U X N w V Y Z ht:=P.sold_lockup x K c r R i₀ F U X N w V _ _ f' Y Z z t'; exact ⟨P,K,c,r,x,R,i₀,F,U,X,N,w,V,P.pointEra s,s,f',Y,Z,R124,π₀,h0,h2,h3,h4,G',⟨n,h1⟩,h,e,(RegistrationAgreement.sameM4Tuple ..).1 z,t',Be,hW,ht,hd⟩

theorem on_planet : ∃ (P : Spine) (K : P.Register) (c r : ℕ→ℕ) (x : P.Spectrum0 3) (R : P.Ellis 3 x)
    (i₀ : ℕ) (F U : SampleDose) (A : ℕ → P.Apron) (n : ℕ→ℕ) (w : Lead.Clan → Prism)
    (V : ∀ j : Axis, List Axis → ℝ → P.ColorHil j (P.advocate 3 x j)) (g h : ℕ)
    (X : P.HandleWith x c r A n)
    (Y : Lead.Clan → Test4 →L[ℂ] P.ManyF 3 (P.advocate 3 x 3)) (Z : Lead.Clan → Lead.Clan → Boundary.Distn E4),
    (∃ C>0, ∀ᶠ s in atTop, ∀ i k:ℕ,s<P.run.uv k →
 let y:= hat P.par.R.L P.par.x s
 let G:= ((P.run.voyage i).X (P.run.uv k)).gram s
 SupportRate (detectorBudget G.p) (Ione.head_L G.F) P.par.h
       (C * (1+(YM.Pressure.radiusB y:ℝ))^8 * SectorNext.Remainder.Scales.g SU.group P.par.R.L y^2 * Real.exp (Real.log (Real.log y)^2))) ∧ id ≤ r ∧ uniform P K (fun _ _ _ _ _ _ _ _ _ _ _ _=>0) 1 1 ∧
    M4Furnish P K c r x R i₀ F U A n w V g h X Y Z ∧ P.Garrison x c r A n ∧ PlanetaryG.{u} P A ∧ (∀ x:P.Spectrum0 3,P.Guest x c r A n) ∧ ∃ p:CapBacked P x A c r n w, P.OverM4 x c r F U A n w V Y Z p := by
 obtain ⟨P,K,c,r,x,R,i₀,F,U,A,n,w,V,g,h,X,Y,Z,t,V',C,_,_,_,_,_,e,Q,z⟩:= purchase124.{u} (fun _ _ _ _ _ _=> 0) (fun _ _ _ _ _ _ _ _ _ _ _ _=>0) 1 1 zero_lt_one
 exact ⟨P,K,c,r,x,R,i₀,F,U,A,n,w,V,g,h,X,Y,Z,provision124 P.run t,e,Q,z⟩

