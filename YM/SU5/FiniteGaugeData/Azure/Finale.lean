lemma fallback : Techo Y h W' R A S' V T G' N Jg Jm X Wk:=by
 obtain ⟨s,x,y,S,R',h₁,h₂⟩:= realOasis Y h W' R A S' Wγ Dν ι₀; let T₁:= Lₓ; let B:= Wk.learns; let u(x:E4): M T₁ x (J0 π)= J0 π:= (dew_pays Y h W' R A S' timeAxis (V π) (T π)).2 x; let p:= ghouls Y h S R' s W' R A S' V T x y G' N Jg Jm Z.book h₁ h₂; let z:= berth T₁ Ω' u G' X B; refine ⟨z,fun k=> z.keepCenter (fun x v=> soloDew Y h W' R A S' timeAxis (V π) (T π) x k v),p,fun U V s hp t e v=> exactC T₁ Ω' G' Jg Jm U V X B u p hp t e v s, fun x y=> pictureAnywhere T₁ Ω' u G' Jg Jm X B p x y⟩
omit Wk in
theorem zephyr : ∃ (X:_root_.YM.Boundary.Action (Wave Y h W' R V T timeAxis))(Wk:Life (Osc Y h W' R A S' V T) G' (Φω Y h W' R V T) (StemK Y h W' R A S' V T) N X),
   Techo Y h W' R A S' V T G' N Jg Jm X Wk ∧ SightK Y h W' R A S' V T G' N Jg Jm∧ Nurse Y h W' R A S' V T G' N Jm ∧
   (KernelP.Unique Y h W' R p₀ (V p₀) (T p₀)→ ∀ x:(Wave Y h W' R V T p₀).space,(∀ p:E4,X.orbit.translation p x=x)→∃ z:ℂ,x=z • (J0 p₀)):=by
 obtain ⟨X,K,U⟩:= begonias Y h W' R A S' V T G' N Z.eligible; exact ⟨X,K,fallback Y h W' R A S' V T G' N Jg Jm X K Z Wγ Dν ι₀,atlas Y h W' R A S' V T G' N Jg Jm X K Z,ShapeM Y h W' R A S' V T G' N Jg Jm X K Z Wγ Dν,U⟩
