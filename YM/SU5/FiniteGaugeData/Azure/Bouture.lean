lemma aperture(y:Dtime): (Lₓ).E (thetaX Λ s k) (LeafD Y h W' R timeAxis V T s y)= LeafD Y h W' R timeAxis V T s (vectorT Y h timeAxis y k):= by
 let v:= (T π).val; let S:= thetaX Λ s k; let u_:=y; let Fp₁:=(V π).leaf s u_
 have hp: regular Y h W' R π (V π) (T π) (thetaX Λ s k)=v.stepT s π k (fun _=>Nat.cast_nonneg' _):=atemporal Y h s W' R A S' π (V π) (T π) k
 have hy : v.stepT s π k (fun _=>Nat.cast_nonneg' _) Fp₁=(V π).leaf s (vectorT Y h π u_ k):= (T π).property s u_ π k _
 have he: dip (Anteroom (T π).val) (regular Y h W' R π (V π) (T π) S Fp₁)=coneT Y h W' R π (V π) (T π) S (dip (Anteroom (T π).val) Fp₁):=DFunLike.congr_fun (Cot.dip_fun (home_base Y h W' R π (V π) (T π) τP₀ S)) Fp₁
 let Ipp:= V π; exact he.symm.trans (congrArg (fun f:Ipp.space.Op=> dip (Anteroom (T π).val) (f Fp₁)) hp |>.trans (congrArg (dip (Anteroom (T π).val)) hy))
abbrev bond (w:Decko Y h timeAxis):Prop:= LeafD Y h W' R timeAxis V T s w∈ Height Lₓ Ω' G' Jg
