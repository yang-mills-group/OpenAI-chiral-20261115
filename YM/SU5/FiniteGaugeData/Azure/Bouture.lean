lemma tiltYM (x: Decko Y h timeAxis)(u:b=timeAxis→ 0 ≤ z): Eι x ↔ Eι (hoist Y h timeAxis b z u x):=by
 have hp(w:E4):M ((ℰ) π) w (Ω').val=(Ω').val:= (dew_pays Y h W' R A S' π (V π) (T π)).2 w; by_cases t:b=timeAxis; swap; · unfold bond; rw [← scarf Y h s W' R A S' π z x b V T t]; exact marches ℰ Ω' hp G' Jg _ _
 subst b; lift z to ℕ using u rfl
 change Eι x↔ Eι (vectorT Y h π x z); unfold bond; rw [←aperture Y h s z W' R A S' V T x]; exact warmR ℰ Ω' hp G' Jg _ _ -- potential notation lift rename?
lemma rotateYM (x:Decko Y h timeAxis)(p:Four ℤ)(h₀:0≤ p timeAxis)(B:List Axis): ∃ y:Decko Y h timeAxis, hourS Kₜ p x.val B=y.val ∧ (Eι x ↔ Eι y):=by
 induction B with
 | nil=> exact ⟨x,rfl,Iff.rfl⟩
 | cons b v ih=> obtain ⟨y,hp,f⟩:=ih; let u:b=timeAxis→0 ≤ p b:=fun e=>e ▸ h₀; refine ⟨ hoist Y h timeAxis b (p b) u y, by rw [hourS.eq_2,hp,hoist_val], Iff.trans f (tiltYM Y h s W' R A S' (p b) b V T G' Jg y u)⟩ -- order
local notation "Fₜ"=> orbitW Kₜ
private lemma flySee(x: Dtime) (p:Four ℤ)(y: Dtime)(hx: Fₜ p x.val=y.val)(hp:0 ≤ p timeAxis): ( Eι x ↔ Eι y):=by obtain ⟨k,h,f⟩:= rotateYM Y h s W' R A S' V T G' Jg x p hp Terrace.scheduleL; exact (Subtype.ext (h.symm.trans hx) : k=y) ▸ f
lemma playYM (p:Four ℤ)(y:Decko Y h timeAxis)(t: Fₜ p w.val=y.val) : (Eι w ↔ Eι y):=by
 by_cases v:0 ≤ p timeAxis; · exact flySee Y h s W' R A S' V T G' Jg w p y t v
 have he:Fₜ (-p) y.val=w.val:=by rw [← t, Mist.orbitW_add, neg_add_cancel, orbitW_o]
 exact (flySee Y h s W' R A S' V T G' Jg y _ w he (show 0 ≤ -(p timeAxis) from neg_nonneg.mpr (lt_of_not_ge v).le)).symm
lemma existsYM (p:WValid Y h s W' R A S' V T F G' N Jg)(t:Four ℤ)(x : Decko Y h timeAxis)(d: Mist.orbitW Kₜ t F=x.val): bond Y h s W' R A S' V T G' Jg x:=by
 obtain ⟨m,L,c,v,H⟩:=p; let M:= Decko Y h timeAxis; let y:M:= ⟨L.m,scoreP Y h _ (L.d π) (L.w π)⟩; have h0: orbitW Kₜ (t-m) y.val=x.val:=by rw [show y.val= _ from v, orbitW_add,sub_add_cancel,d]
 exact (playYM Y h s W' R A S' V T G' Jg y (t-m) x h0).mp ( c ▸ wood Y h W' R A S' V T G' N Jg L H y rfl) -- c changing s proof maybe.
