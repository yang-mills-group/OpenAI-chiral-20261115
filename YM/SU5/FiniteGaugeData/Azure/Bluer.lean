lemma nowV (p: ∀ i:Axis, LeadsC (costE Y h (targetP Λ l 0)) i S T₁): RecoverC Y h s W' R A S' V T F G G' Jg Jm :=by
 obtain ⟨x,t,u⟩:= ends_lac Y h mP S T₁ p vL.hs; let X:=orbitW Kₜ x F; let X':= orbitW Kₜ x G; let Vκ:= ƒπ X; let F₁:= swept Y h x S; let F₂:= swept Y h x T₁
 have hp:= swept_lit Y h F S x vL.v₁; have hκ:=swept_lit Y h G T₁ x vL.v₂; let d:= Ahead π 0 mP; have hV: F₁ = swept Y h x S:=rfl; have hm: Locator Kₜ Vκ (refract π 0 F₁):= locate_cold _ _ _ _ hp; -- Q notation.F.
 let Xₜ: Dtime := ⟨Vκ, camWave Y h _ π (wealthy Y h 0 π _ (t π)) _ hm⟩; let Yₜ : Dtime := ⟨ X', camWave Y h _ π (wealthy Y h 0 π _ (u π)) _ hκ⟩
 have hn: ƒπ (Xₜ.val)=X:= burning_ice ..
 let S₁ := V π; let VΦ:= Φ s; have heT: inner ℂ (τ Xₜ) (τ Yₜ)= VΦ (X* X') := by
    rw [show inner ℂ (τ Xₜ) (τ Yₜ)= _ from (runeAge Y h F₂ F₁ s 0 W' R A S' π S₁ Xₜ Yₜ (T π) V T t u (hn.symm ▸ hp) hκ)] -- hn cast defeq
    unfold helve; rw [hn]
 let n₁:= τ Xₜ; let n₂:= τ Yₜ; have hu:n₁∈ Height Lₓ Ω' G' Jg:= existsYM Y h s W' R A S' V T (ƒπ F) G' N Jg (P'.reachG s _ (fireNativeA Y h π F vL.k)) _ Xₜ (mirror_swept Y h π F x); have hF:n₂∈ Height Lₓ Ω' G' Jm:= existsYM Y h s W' R A S' V T G G' N Jm (P'.reachM s G vL.b) x Yₜ rfl
 have hV: inner ℂ n₁ (Ω').val = Φ s X:=by
    have he: inner ℂ ( (Ω').val) n₁=Φ s (ƒπ X):= tad₀ Y h s W' R A S' π Xₜ V T -- $escort
    rw [← inner_conj_symm (𝕜:=ℂ) n₁ (Ω').val,he,bumpØ Y h s W' R A S' X]; exact star_star _
 have hW:=tad₀ Y h s W' R A S' π Yₜ V T; refine ⟨x,Xₜ,Yₜ,rfl,rfl,hu,hF,?_ ,hV.trans (cross_paid Y h s W' R A S' x _), hW.trans (cross_paid Y h s W' R A S' x _)⟩; refine heT.trans ((congrArg VΦ (?_ : X*X'=orbitW Kₜ x (F*G))).trans (cross_paid Y h s W' R A S' x (F*G))); exact Eq.symm (hourS_prod ..)
