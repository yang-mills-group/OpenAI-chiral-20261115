import YM.SU5.FiniteGaugeData.Tapestry.Cumulus
set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
noncomputable section

namespace YM.CF.Buffered.Afterglow.Tapestry.Altitude
open Filter Function Finset TensorProduct
open scoped BigOperators Classical
open PiTensorProduct (tprod)
/-!
# Confined resolution polymarks

Declare permissible resolutions j∈ a set `r` along with their Subalgebras Iⱼ;
obtain exactly the subalgebra generated by these pinhole observables. Sums and
products interpreted as foregoing; each fits its own upper observing level and
extra levels, even if `r` infinite or excludes an initial segment. All such
subalgebras are contained in e.g. indicated height & allowed-window polynomials.
-/
variable {A:Type*}[CommRing A][Algebra ℂ A]
variable (r k : Set ℕ)(E F:ℕ→ Subalgebra ℂ A)
structure Officer (v:ℕ→A):Prop where
 toll : PreFinite v
 observes: ∀ i,v i∈ E i
 forbids (i:ℕ): i∉r→v i=1
lemma Officer.oneX : Officer r E 1:= ⟨preFinite1,fun i=>(E i).one_mem,fun i _=>rfl⟩
lemma Officer.inMult {v w:ℕ→A} (p: Officer r E v)(q:Officer r E w): Officer r E (v*w) :=
 ⟨p.toll.together q.toll,fun i=>(E i).mul_mem (p.observes i) (q.observes i),fun i e=> by rw [Pi.mul_apply,p.forbids i e,q.forbids i e,one_mul]⟩
lemma Officer.ger {f:ℕ→A}(p:Officer r E f)(g:r⊆k)(v:∀ i∈r,E i ≤ F i): Officer k F f:= ⟨p.toll,fun i=>by
  by_cases he:i∈r
  · exact v i he (p.observes i)
  rw [p.forbids _ he]; exact (F i).one_mem,fun i h=> p.forbids _ fun q=> h (g q)⟩
lemma Officer.slot (s:ℕ)(v:s∈ r)(x:A)(p:x∈E s): Officer r E (update (1:ℕ→A) s x):=by
 refine ⟨⟨s,enough_slot s x⟩,fun i=>?_,fun i q=> update_of_ne (fun (h:i=s)=> q (h ▸ v)) x (1:ℕ→A)⟩
 by_cases he:i=s
 · rw [he,update_self]; exact p
 rw [update_of_ne he]; exact (E i).one_mem
lemma Officer.visible {s:ℕ}{v:ℕ→A}(p:Officer r E v)(h:r⊆Set.Iic s): Enough s v:= fun i u=> p.forbids _ (fun a=> u.not_ge (h a))
lemma Officer.stays {s:ℕ}{v:ℕ→A}(p:Officer r E v)(u:Enough s v): Officer (r∩ Set.Iic s) E v:= by
  refine { p with forbids:=fun i v=>?_ }; by_cases he:i∈r; exact u i (lt_of_not_ge (fun g=> v ⟨he,g⟩)); exact p.forbids i he
def colonnade : Subalgebra ℂ (Cloud A) := spires {f|Officer r E f} (Officer.oneX ..) (fun x e y v=> Officer.inMult r E e v)
lemma pillars {x:Cloud A} : x∈colonnade r E ↔ x∈ heights {f| Officer r E f}:= Iff.rfl
lemma officer_stone {x:ℕ→A}(p:Officer r E x): tprod ℂ x∈colonnade r E:= board (P:={f|Officer r E f}) p
lemma pokes {s:ℕ}(p:s∈r){x:A}(v:x∈ E s): pinhole A s x∈ colonnade r E:= officer_stone r E (Officer.slot r E s p x v) -- `..` arguments? 
lemma makesWay (h:r⊆k)(p:∀ i∈r,E i≤F i): colonnade r E ≤ colonnade k F:= expandHeights (P:={f|Officer r E f}) (Q:={f|Officer k F f}) (fun _ e=> Officer.ger r k E F e h p) -- tune syntax
lemma officer_flat (r:Finset ℕ)(f:ℕ→ A)(q:∀ j,j∉r→ f j=1): f=∏ i∈r, update (1:ℕ→A) i (f i):=by
  funext i; rw [Finset.prod_apply]; by_cases he:i∈r
  · rw [prod_eq_single_of_mem i he (fun j _ h=>update_of_ne h.symm _ _), update_self]
  nth_rw 1 [q i he]; symm; apply prod_eq_one; intro j p; exact update_of_ne (fun (h:i=j)=> he (h ▸ p)) _ (1:ℕ→A)
lemma officer_rep {v:ℕ→A}(p:Officer r E v){s:ℕ}(e:Enough s v): tprod ℂ v=∏ i∈(Finset.Iic s).filter (· ∈ r), pinhole A i (v i):= by
  nth_rw 1 [officer_flat ((Finset.Iic s).filter (· ∈ r)) v ?_]; swap
  · intro j h; by_cases q:j∈r; exact e j (lt_of_not_ge (fun v=> h (mem_filter.mpr ⟨mem_Iic.mpr v,q⟩))); exact p.forbids j q
  rw [PiTensorProduct.tprod_prod]; rfl
lemma col_generation : colonnade r E=Algebra.adjoin ℂ (⋃ i∈ r,pinhole A i '' (E i:Set A)):=by
  let P:=Algebra.adjoin ℂ (⋃ i∈ r,pinhole A i '' (E i:Set A))
  apply le_antisymm ?_ (Algebra.adjoin_le ?_)
  · intro x p;
    apply boarded (P:={f|Officer r E f}) (M:=fun x=>x∈P) ?_ P.zero_mem (fun x y t q h v=>P.add_mem h v) (fun z x q h=>P.smul_mem h z) p
    intro v g; obtain ⟨t,e⟩:=Officer.toll g; rw [officer_rep r E g e]; refine P.prod_mem (fun i x=>?_) -- Finset args tune
    exact Algebra.subset_adjoin (Set.mem_iUnion.mpr ⟨i, Set.mem_iUnion.mpr ⟨(mem_filter.mp x).2,Set.mem_image_of_mem _ (Officer.observes g i)⟩⟩)
  intro x u; simp only [Set.mem_iUnion] at u; obtain ⟨i,h,y,p,rfl⟩:=u; exact pokes r E h p
lemma col_short (s:ℕ): colonnade (r∩ Set.Iic s) E ≤ shorter A s:= expandHeights (P:={f|Officer (r∩ Set.Iic s) E f}) (Q:={f|Enough s f}) (fun _ (p:Officer _ _ _)=> p.visible _ _ Set.inter_subset_right)
lemma col_poly : colonnade r E ≤ Polynomials A:= expandHeights (P:={f|Officer r E f}) (Q:={f| PreFinite f}) (fun _ p=> Officer.toll p)
theorem col_front (x:Cloud A): x∈colonnade r E ↔ ∃ n:ℕ,x∈colonnade (r∩Set.Iic n) E:=by
  have ht:{f|Officer r E f}=⋃ n:ℕ,{f|Officer (r∩Set.Iic n) E f}:=by
    ext f; rw [Set.mem_iUnion]; constructor
    · intro p; refine ⟨(Officer.toll p).choose,Officer.stays r E p (Officer.toll p).choose_spec⟩
    rintro ⟨n,v⟩; exact Officer.ger (r∩Set.Iic n) r E E v Set.inter_subset_left (fun i _=>le_rfl)
  rw [pillars,ht]
  exact curve_union (P:=fun n=>{f| Officer (r∩Set.Iic n) E f}) (fun n m h v e=> Officer.ger (r∩Set.Iic n) (r∩Set.Iic m) E E e (fun i p=> ⟨p.1, (le_trans p.2 h)⟩) (fun i _=>le_rfl)) -- type
lemma col_unbound : colonnade Set.univ (fun _=> (⊤ : Subalgebra ℂ A))= Polynomials A :=
 le_antisymm (col_poly ..) (expandHeights (P:={f:ℕ→ A| PreFinite f}) (Q:={f| Officer Set.univ (fun _=>(⊤:Subalgebra ℂ A)) f}) (fun _ h=>⟨h,fun _=> Set.mem_univ _,fun i v=> (v trivial).elim⟩))
end YM.CF.Buffered.Afterglow.Tapestry.Altitude
#print axioms YM.CF.Buffered.Afterglow.Tapestry.Altitude.col_front
#print axioms YM.CF.Buffered.Afterglow.Tapestry.Altitude.col_generation
