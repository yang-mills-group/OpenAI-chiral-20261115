/-!
# Multi-resolution cylindrical algebra on the election

Proposed determining algebra FOR THE COUPLED MULTISCALE MARKED HIERARCHY.
* whole state on this subalgebra, with native-wide gauge/CAR marks, shared phases/link arguments
* the physical subsystem may be taken generated by the inserted singlets at every resolution and
  their products: all local even chiral stencils on paired links incl all words collected at one
  resolution, with local gauge invariance; scales mean different observables at this stage. Does
  not claim this to be already determining for relativistic reconstruction (still missing restored
  symmetries etc) or replacing full arbitrary CAR algebra. No odd-legged probes mixed between levels,
  no implicit coincident/contact Ward identities. The estimates below won't treat odd observables or
  assert that they, or unbuffered half-space forms on grid marks, are positive. The underlying
  algebra uses *all* of junior, including gauge-covariant flux parts (even no condition on flux),
  so can evaluate also products of the even level stencils without requiring that their separated
  factors are gauge invariant. We can later enlarge the physical subsystem if a comparison argument
  requires more. We will control each `InHouse` approximation quantifier.

Build on honest `PiTensorProduct` algebra (of the level observable algebras, not states, NOT an
ordinary tensor-product state on indep copies and NOT in the representation/"generation"
direction at all). Use only its subalgebra of finite-level, support-controlled tensors. Provide its
full buffered positive-time algebra and reflected form. Physical finite-regulator readback and
support checks supplied next.
-/
set_option autoImplicit false
set_option synthInstance.maxSize 24000
set_option maxHeartbeats 420000
noncomputable section
namespace YM.CF.Buffered.Concord
open Function Filter NormedSpace SU Lat Lattice Cube Finset MeasureTheory RG Wilson Metric
open scoped Matrix MatrixOrder Matrix.Norms.L2Operator InnerProductSpace BigOperators Kronecker
  Topology ComplexOrder Classical TensorProduct
open Rush Scroll Peaks Stencil Tenant Tap Tulip Branch Fir Scree Advance Reflect Window Laurent
  Next.Free Bloch Drapes Spire Lifted Skye Precision Tree Push.SectorMeasure Next.SectorChange Fock Heat
open Afterglow Afterglow.Common Afterglow.Sound Afterglow.Satin
attribute [local instance] opCStarAlgebra
open Py Py.Rate LocalLimit Preparation Journey Vale Style
abbrev Hallspace (K:Calibration):= Style.Surface (junior K)

variable {K:Calibration} {Λ:Preparation}{l:ℕ} (Y:Course Λ (VolumeCape.Dream.Nimbus l))(H:Real.exp 1 ≤ Λ.x)
-- A room floor: define scope algebra of texts
section front
variable {n:ℕ}
def roomRule (R:ℕ→Subalgebra ℂ (junior K)) : Style.SurfaceRule (junior K) where
  carrier :={f|∀ i,f i∈ R i}
  one_mem' := fun i=> (R i).one_mem
  mul_mem':= fun a b i=>(R i).mul_mem ((show ∀ i, _ from a) i) ((show ∀ i, _ from b) i) -- annotate

/-- Precise `local algebra through s`; can narrow to supports & to singlets *at once*. -/
def limited (R:ℕ→Subalgebra ℂ (junior K))(s:ℕ): Subalgebra ℂ (Hallspace K):= Style.pressed (Style.pepper s (roomRule R))
def throughout (R:ℕ→Subalgebra ℂ (junior K)) : Subalgebra ℂ (Hallspace K):= Style.pressed (Style.pub (roomRule R))
lemma pepper_rule (R:ℕ→Subalgebra ℂ (junior K))(f:ℕ→junior K): f∈Style.pepper n (roomRule R) ↔ (∀ i≤n, f i∈ R i) ∧ Style.fits n f := by
  refine ⟨fun t=>⟨fun i _=> t.1 i,t.2⟩, fun ⟨t,u⟩=>⟨?_,u⟩⟩
  intro i; by_cases h:i≤n; exact t i h; rw [u i (lt_of_not_ge h)]; exact (R i).one_mem
lemma fanFare {P Q:ℕ→Subalgebra ℂ (junior K)}{n:ℕ}(h:∀ i≤n,P i≤Q i) : limited P n≤limited Q n := muscle (fun f v=> (pepper_rule Q f).mpr ⟨fun i w=>h i w (((pepper_rule P f).1 v).1 i w),v.2⟩)
lemma limited_top {R:ℕ→Subalgebra ℂ (junior K)}(s:ℕ): limited R s ≤ Style.atLeast (A:=↥(junior K)) s:= muscle (fun f h=> ⟨Submonoid.mem_top _,h.2⟩)

-- physical singlet algebra & locality (support budgets in the level grids). Every tensor only needs
-- a finite presentation and hence finitely many supports total, even over all resolutions.
def building (K:Calibration): Subalgebra ℂ (Hallspace K):= Style.pressed (Style.pub (A:=↥(junior K)) ⊤)
def physical (K:Calibration): Subalgebra ℂ (Hallspace K):= throughout fun _=>singlets K

lemma seen (R:ℕ→Subalgebra ℂ (junior K)): throughout R≤ building K := muscle (fun f h=>⟨Submonoid.mem_top _,h.2⟩)
lemma scent (K: Calibration) : physical K≤ building K:= seen _

-- Determine the physical subalgebra by insertions at each step
-- give decomposition of `fits` as exact product of these inclusions (freedom to repeat f factors via Algebra)
lemma factor_steps (f:ℕ→junior K)(p:Style.fits n f) : PiTensorProduct.tprod ℂ f=∏ i∈ Finset.Iic n, Style.stepFactor i (f i) := by
  simp_rw [Style.insert_at]; rw [←PiTensorProduct.tprod_prod]; apply congrArg; funext i; rw [Finset.prod_apply]; by_cases h:i≤n
  · rw [prod_eq_single i]; simp; swap; · exact fun v=>False.elim (v (mem_Iic.mpr h))
    intro j _ p; exact update_of_ne p.symm _ _
  rw [p i (lt_of_not_ge h), prod_eq_one]; intro j p; exact update_of_ne (by have a:= mem_Iic.mp p; omega:i≠j) ..
lemma resident (R:ℕ→Subalgebra ℂ (junior K)) (i:ℕ) (x:junior K)(h:x∈R i): Style.stepFactor i x∈limited R i:=by
  rw [Style.insert_at]; refine pressedIn (R:=pepper i (roomRule R)) ?_; refine (pepper_rule R _).mpr ⟨fun j p=> ?_, Style.visible i x⟩; by_cases v:i=j
  · subst j; rw [update_self]; exact h
  rw [update_of_ne (Ne.symm v)]; exact (R j).one_mem
lemma all_readers (R:ℕ→Subalgebra ℂ (junior K)){A: Subalgebra ℂ (Hallspace K)} : throughout R≤ A ↔ ∀ i x,x∈ R i → Style.stepFactor i x∈ A := by
  refine ⟨fun h i x t=> h (to_pub _ _ (resident R i x t)),?_⟩
  intro h x p; obtain ⟨n,v⟩:= by_stages _ _ (show x ∈ pressed _ from p)
  refine display (P:=fun x=>x∈A) (fun f t=>?_) A.zero_mem (fun _ _ _ _ p q=>A.add_mem p q) (fun c _ _ p=>A.smul_mem p c) v
  have he:= (pepper_rule ..).1 t; rw [factor_steps f he.2]; exact A.prod_mem fun i u=> h i (f i) (he.1 i (mem_Iic.mp u))

-- support discipline for every probe (no mention of far period thresholds here)
theorem building_limit {x:Hallspace K}(p:x∈building K):∃ n,∃ S : ℕ→Finset Cover,x∈limited (fun i=>club K (S i)) n:= by
  obtain ⟨n,v⟩:= by_stages _ _ (show x ∈ pressed _ from p); refine ⟨n,?_⟩
  refine display (P:=fun x=> ∃ S : ℕ→Finset Cover,x∈limited (fun i=>club K (S i)) n) (fun f t=>?_) ⟨fun _=>∅,(limited _ n).zero_mem⟩ ?_ ?_ v
  · choose R p using fun i=> supported K (f i)
    exact ⟨R,pressedIn (R:=pepper n (roomRule (fun i=>club K (R i)))) ⟨p,t.2⟩⟩
  · intro x y _ _ p q; obtain ⟨S,p⟩:=p; obtain ⟨T,q⟩:=q
    let U(i):= S i∪ T i; let R(i):=club K (U i)
    exact ⟨U,(limited R n).add_mem (fanFare (Q:=R) (fun i _=>lodge K _ subset_union_left) p) (fanFare (Q:=R) (fun i _=>lodge K _ subset_union_right) q)⟩
  intro a x _ p; obtain ⟨S,p⟩:=p; exact ⟨S,(limited _ n).smul_mem p a⟩
end front
end YM.CF.Buffered.Concord
