lemma ember_realΨ (t: Location.Request V U W J q w N0 x p p')(p0:Sch Bβ XG)(v:ℂ) : let A:=s.operate; rentD V w DΩ β - freqM * sites ι ≤ (A.offset β G v).re - v.re:= by
 let Y:=s.operate; let u:=s.baseOffset β G; have hf: (Y.offset β G v).re-v.re=u.re:=by change (u+v).re-v.re=_; simp
 intro _; change _ ≤ (Y.offset β G v).re-v.re; rw [hf]
 obtain ⟨d,g',h',X,C,e,hc⟩:= lantern_mΨ s castV p0
 have hE : Launch p p' w U q J.d (Y.realArr β G) G β (Y.posted β G) 0 C (Y.wave β G):= e
 have hp:= (s.robe_s p0).2.2.2.2.choose_spec.1; have ht:u=(s.robe_s p0).2.2.2.2.choose:=by unfold u baseOffset; rw [dif_pos p0]
 rw [←ht] at hp -- indent
 let Ω := Y.realArr β G; let B'' := β+w.movement V-Y.posted β G
 let pZ := construct p (V.L.path (w.lag+1)) K.top.clip w.output B'' Ω u
 let pZ' := construct p (V.L.path (w.lag+1)) K.top.clip w.output B'' Ω C
 let v:Orbit ι:= (1,Classical.arbitrary _)
 have eV: denZ pZ U w.coarse v= denZ pZ' U w.coarse v:=(hp.wear v (clear_identity p)).trans (e.wear v (clear_identity p)).symm
 have hpv:= J.gran.trans t.rocket.size; have hg:= (t.rocket.paid.paid v).shrink J.hr.le
 have hv:= congrArg (fun x=> ‖inner ℂ (changeM (m:=m) U (w.coarse v) w.output.M) x‖) eV; unfold pZ pZ' at hv; rw [sea_read U _ K.top.clip w.coarse w.output Ω u B'' v (UVNext.CouplingReset.flags_one _) hpv hg,sea_read U _ _ w.coarse w.output Ω C B'' v (UVNext.CouplingReset.flags_one _) hpv hg] at hv
 simp only [Complex.norm_exp, Real.exp_eq_exp,Complex.add_re, Complex.sub_re] at hv; exact hc.trans (le_of_eq (by linarith only [hv] : C.re=u.re))
