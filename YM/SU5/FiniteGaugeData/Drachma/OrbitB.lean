lemma lantern_mΨ (p0:Sch Bβ XG): let b:=s.standby Bβ XG; let Δ:=Θχ Bβ XG; let F:= τE Bβ XG; let force0:=zZ Bβ XG; Dark Utrue force0.1 p h s.maxV ∧ Δ.im=0∧ force0.2=0∧ F.2=0∧ ∃v:ℂ,Launch p p' w U q J.d (F.1,force0.1) G β Δ.re 0 v Λχ.1 ∧ rentD V w DΩ β-freqM * sites ι≤ v.re :=by
 intro i Δ F R; let r₀:= i.1; obtain z: i=rePoint r₀:= s.real_I (s.sleepsW p0).1.1 (s.real_pick p0); have hi':sunny (rePoint r₀):= z ▸ s.homely p0
 let E:=s.pF Bβ XG; let U:=s.gear Bβ XG; let Q:= s.pA E.1
 obtain ⟨r,_,_,_,_,_,x0,x1,x2,hb,-⟩:= house_real (A0:=s.A0) s.qL s.s s.Th s.S0 s.Ty s.coin.full p0 r₀ hi'
 rw [←z] at x0 hb; change E.2=0 at x0
 have pZ: (s.pF Bβ XG).2=0:= x0; have hz':s.τz Bβ XG=Zβ (rePoint r₀) Bβ XG:= congrArg (fun i=>Zβ i Bβ XG) z; have h0: U=(U.1,0):=Prod.ext rfl (show U.2=0 from (congrArg s.hoodZ x0).trans s.m0sΨ.2.2); have ht:makeK (A0:=s.A0) (Lp:=s.Lp) s.Ty Bβ (rePoint r₀) XG (U.1,0)= R:= (by rw [←z,←h0]; rfl)
 have H:Δ.re=(Zβ (rePoint r₀) Bβ XG).re-Q:= by unfold Δ RepΔ; rw [hz',Complex.sub_re,prob_re,prob_re]
 obtain ⟨pp,pR,xζ,v,t'⟩:= movie_emberΨ s.qL s.s s.Th s.S0 s.Ty s.coin s.pH castV r₀ hi' p0 (s.hood E.1) U.1 Q (s.careτ p0).1.1.piece.delivers (s.feeQ p0).1 (s.careτ p0).1.1.piece.zealed
 rw [ht] at pp v t'
 have he: r₀.val=Λχ.1:=congrArg Prod.fst (intent0 Λχ (mem_ball_zero_iff.mp (s.half_room (s.sleepsW p0).1.1)).le)
 refine ⟨pp,?_,v, ?_,?_⟩
 · unfold Δ RepΔ; rw [hz',Complex.sub_im,xζ,prob_im,pZ,s.m0sΨ.1,sub_zero]
 · change E.2+s.hood E.2=0; rw [x0,s.m0sΨ.2.1,add_zero]
 obtain ⟨bp,eh,hc⟩:=t'; refine ⟨bp,?_,hc⟩
 rw [H,←he]; change Launch p p' w _ _ _ (F.1,R.1) G β _ 0 bp r₀.val;
 have hpz:F.1=(VE (rePoint r₀) Bβ XG).1+s.hood E.1:= by change (VE i _ _).1+s.hood E.1=_; rw [z]
 rw [hpz]; exact eh
