  intro z j δ p o S; obtain ⟨⟨x₁,y₁,g⟩,⟨x₂,y₂,g'⟩⟩:= survive z j δ p; let v' := pan.character x
  have H' := (paint z).2.2.2.2 j; let u:= H'.1.witness.link; let v:= H'.2.witness.link
  let h := displays Y H D.univ_ G D.toExhibition 0 c v' s _ j x₁ y₁ (f z) g u.mark_mem
  let t := displays Y H D.univ_ G D.toExhibition 0 c v' s _ j x₂ y₂ (f' z) g' v.mark_mem
  exact ⟨⟨x₁,y₁,emerged Y H D.univ_ G D.toExhibition 0 c v' z j x₁ y₁ δ s (f z) S o q d h u.anchor_inj⟩,⟨x₂,y₂,emerged Y H D.univ_ G D.toExhibition 0 c v' z j x₂ y₂ δ s (f' z) _ o q d t v.anchor_inj⟩⟩
