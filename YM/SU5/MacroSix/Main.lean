namespace Spine
variable (P : Spine) (R : P.Register) (s t n : ℕ) (x : P.Spectrum0 3) (E : P.Ellis 3 x)
    (c r : ℕ→ ℕ) (V : Set E4)
local notation "Λ"=> P.par
local notation "ω"=> P.otherSpectrum 3 3 x
local notation "Θ"=>P.seasons 3 (P.otherSpectrum 3 3 x)
local notation "Π" => (P.seasons 3 ω).ℚmeasure
local notation "Q"=> P.measureField s n

/-- macroscopic Part(ii) of the measurement, closure with strict clearance already paid.
`Realized` for the successes includes the `s ≤ t` charges and the zero split comparison. -/
structure RectangleAward (A B : RectanglePose) (p : Axis→Bool) : Prop where
  lawful : RectanglePose.Allows P s n A B p
  pointCosts : P.PlacedPoints s n x A B
  pointReads : IsOpen (P.live s n x (A.paints ×ˢ B.paints)) ∧
    A.paints ×ˢ B.paints ⊆ closure (P.live s n x (A.paints ×ˢ B.paints))
  verification (f g : Vantage → ℝ) : P.Achieves s n x A B f g → P.Realized R s n x f g
  grants : ∃ f g, P.Achieves s n x A B f g
  credit : ∀ (f g a b : Vantage → ℝ), P.Achieves s n x A B f g → SmoothDensity a → SmoothDensity b →
    tsupport a⊆ A.paints → tsupport b⊆ B.paints →
    ∀ᶠ r in 𝓝[>] (0:ℝ), P.Achieves s n x A B (rideLine a f r) (rideLine b g r)

structure Settle (d : ℝ) : Prop where
  price : P.StockClear n     -- internal strict positive physical gap at this s
  projection : (d:ℂ) • (1:Matrix Window.Family Window.Family ℂ) ≤
    Matrix.gram ℂ (fun j : Window.Family ↦ (Π).region
      (Cheer.press (P.dew s n) V) (P.birthCloud x j s n))
  stamp (j): ((P.sixBody s n j).covered P j.2)
  reflection (u : ClockTest.Space → ℝ) (g : ℝ → ℝ) : SmoothDensity u →
    TimeDensity g → P.TimeFare s n g → P.Forever R s n x (ClockTest.joined u g) V
  rectangles (A B : RectanglePose) (p : Axis→Bool): RectanglePose.Allows P s n A B p →
    P.RectangleAward R s n x A B p

include E in
lemma fundsRectangle (h : P.StockClear n) (A B : RectanglePose) (p : Axis→Bool)
    (u : RectanglePose.Allows P s n A B p) (t:P.HasLaneSeed s n x p) :
    P.RectangleAward R s n x A B p := by
  let L:= A.paints; let G:=B.paints
  have ht := P.live_dense s n x p E (A.open_paint.prod B.open_paint)
    ((Set.prod_mono A.paints_inside B.paints_inside).trans u.fundedLane) u.forward t
  obtain ⟨f,g,v,-⟩:= P.successes s n x A B p E Set.Subset.rfl Set.Subset.rfl A.open_paint
    B.open_paint A.positive_paint B.positive_paint u t
  refine ⟨u,PlacedPoints.places P s n x A B p u E,⟨P.live_open s n x E (A.open_paint.prod B.open_paint)
    (fun i j e ↦ u.forwardOrder i j (A.paints_inside e.1) (B.paints_inside e.2) 3 u.forward),ht⟩,
    fun f g H ↦ P.realize _ s n x E f g h ⟨H.smoothLeft,H.smoothRight,_,H.frame.coverPrice H.smoothLeft.compact
      H.smoothRight.compact⟩ H.succeeds,⟨f,g,v⟩,fun _ _ _ _ t q e a b ↦ P.variations s n x A B p E u t q e a b⟩

-- analogous to `Credited` perturb version; standalone after-the-choice rectangles.
lemma RectangleAward.testClose {A B p} (a b : Vantage → ℝ)
    (R' : P.RectangleAward R s n x A B p)
    (pa : SmoothDensity a) (pb : SmoothDensity b) (u : tsupport a⊆ A.paints) (q : tsupport b⊆ B.paints)
    (k : ℕ) (ε : ℝ)(e : 0<ε) : ∃ f g : Vantage → ℝ, P.Achieves s n x A B f g ∧ P.Realized R s n x f g ∧
      ∀ j≤ k, ∀ x : Vantage, ‖iteratedFDeriv ℝ j (f - a) x‖ < ε ∧
        ‖iteratedFDeriv ℝ j (g - b) x‖ < ε := by
  obtain ⟨f,g,w⟩ := R'.grants
  obtain ⟨r,i,y,z⟩ := ((R'.credit _ _ _ _ w pa pb u q).and (eventually_nhdsWithin_of_eventually_nhds
    ((ride_crests a f pa w.smoothLeft k ε e).and (ride_crests b g pb w.smoothRight k ε e)))).exists
  exact ⟨_,_,i,R'.verification _ _ i,fun j h x ↦ ⟨y j h x,z j h x⟩⟩

/-- The statement with prescribed rectangles first, and even a version of the
second rank test with full footprints *inside* the stated center rectangles. -/
structure ChoiceCredit (d : ℝ) (A B : RectanglePose) (p : Axis→ Bool) : Prop where
  granted : P.Settle R s n x V d
  allotted : P.Credited s n x A B p
  realizes : ∃ f g : Vantage→ℝ, P.Achieves s n x A B f g ∧
    P.Realized R s n x f g ∧ ∀ z, P.occupiedSpace f ((P.sixBody s n z).kiss P 3)⊆ A.paints ∧
      P.occupiedSpace g (P.sixBody s n z)⊆ B.paints

lemma pristine (d : ℝ) {A B p} (f : P.Settle R s n x V d) (g : P.Credited s n x A B p) :
    P.ChoiceCredit R s n x V d A B p := by
  obtain ⟨v,w,q,p',r⟩:= g.successful
  refine ⟨f,g,v,w,q,(f.rectangles A B p g.margins).verification _ _ q,fun z ↦
    ⟨(RectanglePose.snugLocations P s n z v g.wrapsLeft (p'.trans (A.inset.paints_inside))).1,
      (RectanglePose.snugLocations P s n z w g.wrapsRight (r.trans B.inset.paints_inside)).2⟩⟩

/-- The rank grant from the *matrix* zoom, and the response at (these now
fixed) probe resolutions. Comparator part of `Realized`, any split with
(marginal) Ward as exposed. `choice` (c & r) is already on this x.
`V` belongs to the prescription; choose it as any ball in the theorem,
we can meet the requisition even without assuming its closure or round shape. -/
structure TransSix : Prop where
  extraction : ∃ m, P.Selects R 3 x m
  chart (i k : ℕ): P.SourceBill i k ∧
    (((P.run.voyage i).X (P.run.uv k)).gram 0).beta=P.par.x ∧
    ∀ s : ℕ, Pay P.run s i k → P.PaidPe s i k
  enrolled (s:ℕ)(f:P.Test): P.ElectedChart R s f
  zoom (j k:Window.Family)(F : ℕ→E4→ℂ)(f:E4→ℂ)(h : ZoomTest F f) :
    Tendsto (fun i ↦ crossIntegral (Π) (P.birthCloud x j (c i) (r i)) (P.birthCloud x k (c i) (r i))
      (fun p ↦ F i ((P.dew (c i) (r i)) • p))) atTop
        (𝓝 (if j=k then ∫ x, f x ∂(promenade j:Measure E4) else 0))
  purchases(V:Set E4) : SpectralWindow V → ∃ d:ℝ, 0 < d ∧
    (∀ᶠ i in atTop,P.Settle R (c i) (r i) x V d) ∧
    (∀ A B : RectanglePose, ∀ p:Axis→Bool,A.Across B p →
      ∀ᶠ i in atTop, P.ChoiceCredit R (c i) (r i) x V d A B p)
  cross_form (D:Set E4) (h : SpectralWindow D)(i:ℕ):
    (Matrix.of fun j k : Window.Family ↦ crossIntegral (Π) (P.birthCloud x j (c i) (r i))
      (P.birthCloud x k (c i) (r i)) ((Cheer.press (P.dew (c i) (r i)) D).indicator fun _ ↦ (1:ℂ))) =
    Matrix.gram ℂ (fun j : Window.Family ↦ (Π).region (Cheer.press (P.dew (c i) (r i)) D)
      (P.birthCloud x j (c i) (r i)))
  preset (g : ℝ→ℝ) : TimeDensity g → tsupport g⊆ Set.Ioi 0 →∀ᶠ i in atTop, P.TimeFare (c i) (r i) g
  -- manuscript `eq:msplit` ANY heights with these price conditions.
  -- `Apron.covered` includes all summands and also opposed/moved bodies (using stamps).
  msplit (T:Type) (B:T → P.Apron)(a:T → Cover)(L:List T) (p : L≠[])
    (v : ∀ i∈L,∃ b, (B i).covered P b) (t:ℕ) (q:∀ i∈L,(B i).s≤ t)
    (f : L.Pairwise (fun i j ↦ Disjoint ((B i).scenery P (P.pose t (a i)))
      ((B j).scenery P (P.pose t (a j))))) (M:P.Test→ₗ[ℂ]ℂ)(w : PaintedSplit P.par t M) :
    M (P.fullScroll t B a L)=0
  partner (t:ℕ): Comparison (P.partner t x) ∧ (∀ f∈ Gate P.calibration, P.partner t x f=P.singleState 3 t x f) ∧
    (∀ f∈Mantle P.calibration,P.partner t x f=P.singleState 3 t x f)
  stable (s n:ℕ) (u v : Vantage → ℝ)(h:P.StockClear n)(p:P.Realized R s n x u v)
    (T:Type)(L:Filter T)(a b : T→ Vantage→ℝ)(q:P.Through s n u v L a b):
    Tendsto (fun i ↦ P.measureField s n (a i) (b i) x) L (𝓝 (P.measureField s n u v x)) ∧
      ∀ᶠ i in L, P.Realized R s n x (a i) (b i)
  positiveStable (s n : ℕ)(f : Vantage→ℝ)(d u : ℝ)(v : u<d)(V:Set E4)(p : P.Forever R s n x f V)
    (q:(d:ℂ) • 1 ≤ P.measureField s n (f∘mirrorΩ 3) f x)(T:Type)(L: Filter T)
    (a b : T → Vantage→ℝ)(h : P.Through s n (f∘ mirrorΩ 3) f L a b):
    ∀ᶠ i in L, ReFloor (P.measureField s n (a i) (b i) x) u

section purchase
variable {P R x c r E} (S : P.Chosen x R c r E)
include S
private lemma all_seeds : ∀ᶠ i in atTop,∀ p : Axis→Bool, p 3=true → P.HasLaneSeed (c i) (r i) x p := by
  refine Filter.eventually_all.mpr (fun i ↦ ?_)
  by_cases h:i 3=true
  · filter_upwards [laneSeed i S.launch S.ready keyV_go (S.party.2.1.accepted 3) E h] with n v q
    exact ⟨_,v⟩
  exact Eventually.of_forall fun i p ↦ (h p).elim

lemma chosen_grants (p : SpectralWindow V): ∃ d:ℝ, 0 < d ∧
    ∀ᶠ i in atTop,P.Settle R (c i) (r i) x V d := by
  obtain ⟨d,q,h⟩:= sixGrant S.launch S.ready keyV_go (S.party.2.1.accepted 3) V p.actual
    ((Set.inter_eq_self_of_subset_right p.timeInside).symm ▸ p.positive)
  refine ⟨d,q,?_⟩
  filter_upwards [h,stockClear_event P S.launch,all_seeds S,
    reflected_six V S.launch S.ready keyV_go (S.party.2.1.accepted 3) E S.summit p] with i u v x₁ t
  exact ⟨v,u,(fun _ ↦ P.sixStamp _ _ _ v),(fun f g a b d ↦ P.believe R (c i) (r i) x E _ V
    (t f g a b d) v),(fun A B p d ↦ P.fundsRectangle _ _ _ _ E v A B p d (x₁ p d.forward))⟩

lemma Chosen.purchases (p : SpectralWindow V) : ∃ d:ℝ,0<d ∧
    (∀ᶠ i in atTop,P.Settle R (c i) (r i) x V d) ∧
    ∀ A B : RectanglePose, ∀ p:Axis→Bool,A.Across B p →
      ∀ᶠ i in atTop, P.ChoiceCredit R (c i) (r i) x V d A B p := by
  obtain ⟨d,h,v⟩:= chosen_grants V S p
  refine ⟨d,h,v,fun A B p t ↦ ?_⟩
  filter_upwards [lane_six A B p E S.launch S.ready keyV_go (S.party.2.1.accepted 3) t,v] with i y f
  exact P.pristine _ _ _ _ _ d f y

/-- The result on a **supplied** physical `P` and character `x`. -/
theorem transSix : P.TransSix R x c r where
  extraction:= P.detectorSelect ..
  chart i k:= ⟨P.source_bill i k,(P.coupling_confirmed R i k).1,fun _ ↦ P.account_pe⟩
  enrolled s f:= P.elected_chart ..
  zoom j k F f h:= sixZoom S.launch S.ready keyV_go (S.party.2.1.accepted 3) j k h
  purchases V h:= S.purchases V h
  cross_form D h i:=gram_press (Θ) _ _ D h.actual.measurableSet
  preset _ h v:= positive_ready S.launch h v
  msplit T A r L p v t q f M w:= P.mSplit_pose t R w A r L p v q f
  partner t:= ⟨P.partnerPricing t x,(P.actualPrediction t x).2.1,(P.actualPrediction t x).2.2.1⟩
  stable s n u v h p T L a b q:= Realized.perturb P R s n x E u v p h L a b q
  positiveStable s n f d v h V p q _ L a b u:= Forever.perturb_floor P R s n x f V p q L a b u E h
end purchase

-- additional beginning-of-trajectory existence. once & forever.
theorem physicalBeginning (e u:ℝ)(p : 0<u) (B : Supplier)(z:ℕ→ℕ): ∃ (P:Spine)(R:P.Register),
    P.RibbonCourse R e u B ∧ ∃ r:ℕ→ℕ,z≤r ∧ ∃ c x E,
      P.Chosen x R c r E ∧ P.TransSix R x c r := by
  obtain ⟨P,R,q⟩:= supplied e u B p
  obtain ⟨r,b,c,x,E,S⟩:= RibbonCourse.once P R e u B q z
  exact ⟨P,R,q,r,b,c,x,E,S,transSix S⟩
end Spine

