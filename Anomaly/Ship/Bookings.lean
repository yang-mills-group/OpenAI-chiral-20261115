 have hv:=sails_day P.R J κ Z K q.earn q.mint H (t.mono fun i u=> ⟨u.1,u.2.2.2,u.2.2.1⟩) n u ε pc h
 filter_upwards [(turnover P).eventually hv,(turnover P).eventually t] with s v e i k pB X R p t T e' v' c y η
 let V' := p_meters Y i k s pB; obtain ⟨p1,p2,p3⟩:= v; obtain ⟨Cnew,hΛ,hσ⟩:= e.2.1 p V'.1 V'.2.2.1 V'.2.2.2.1
 have lq:Mantling R.p y (spartCost R.p.B y (e'+v')) c (κ X) 0 (J X) n m η:=by rw [show spartCost R.p.B y (e'+v')=spartCost (radiusB X) y (e'+ v') from by rw [show R.p.B= _ from V'.1]]; exact Cnew
 let Cq:=gearOcc (κ (x s)) lq.census; -- type view.Test
 have hpQ:0 < Cq.κ:= zero_lt_one.trans_le e.1
 refine ⟨Cq,hpQ,rfl,?_,Cnew.thick,?_,?_,?_⟩
 · change packF u (R.p.B) n; rw [show R.p.B=_ from V'.1]; exact p3
 · change chillCash p.B*(e'+_ ) ≤ _; rw [show yσE p Cq=waxIncome J X from hΛ,show p.B=_ from V'.1]; exact p1 -- V'.1 needs p._
 · intro Tz; unfold Tz; rw [show yσF p Cq=yokeIncome J κ X from hσ,show p.B=_ from V'.1]; exact p2
 intro I _ _ σ v o D E K' r W' ht M Y' G Z vA pA q0 a b P' Φ Ψ t0 G' Tp qB eB Qv Yt Xp S α

 obtain ⟨Q,V,T'⟩:= allot_thrust P.U T n e.1 m P.R.L.val W' v o Z G vA pA q0 P' Tp Qv Yt lq S α P.height Xp -- explicit ancient arg
