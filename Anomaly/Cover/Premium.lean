lemma gatherStamps {T:TintDemand}(x:Cupwork P T m n Pay kc Γ Tξ Z V F W)(U:StellarResearch P): BoothJoin P Γ m:=by
 constructor; intro mm k p v; obtain ⟨a,b,δ,F,D,A,t,z,h,p',v',u,L⟩:= x.opens mm k p v
 let Y:=P.run; let V0:=fun i=> D i*pinpr P.par.R.L i
