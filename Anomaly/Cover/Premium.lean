 intro R B r Q T i j c; obtain ⟨C,f,w⟩:= boothW P c U a b t z mm p
 refine ⟨C,f,?_⟩; filter_upwards [y,(tendsto_add_atTop_nat 1).eventually w] with s g M; refine ⟨M.1, P.top_sum t z M.2 _ (?_)⟩; filter_upwards [P.history.finance (s+2),P.stockGo.eventually g] with j h ht
 let i:= P.nomadic j; let k':= P.engine j; have he:s+1<Y.uv k':= lt_of_lt_of_le (by omega :(s+1)<s+2) h.enters
 obtain ⟨D,J,T,X,Q,R,G,L,Vt⟩:= ht k' he
