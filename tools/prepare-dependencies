#!/usr/bin/env python3
"""Fetch public dependencies at the exact commits in the authenticated Lake lock."""
import hashlib
import json
from pathlib import Path
import re
import subprocess
import sys


def main():
    lock = json.loads(Path("lake-manifest.json").read_bytes())
    # Authenticate every field of the dependency lock apart from the local
    # package name. The project file itself is authenticated by SHA256SUMS.
    package_name = lock.pop("name")
    if not isinstance(package_name, str) or not package_name:
        raise ValueError("Invalid root package name")
    canonical = json.dumps(lock, sort_keys=True, separators=(",", ":")).encode()
    if hashlib.sha256(canonical).hexdigest() != "71ebb37b105d79c98eb0ff07b254f3018081dcb2573bb440886e3fed7bd958f7":
        raise ValueError("Unexpected Lake dependency lock")
    packages = Path(".lake/packages")
    packages.mkdir(parents=True)
    for pkg in lock["packages"]:
        name, url, rev = (pkg[k] for k in ("name", "url", "rev"))
        if not (re.fullmatch("[A-Za-z0-9_-]+", name)
                and re.fullmatch("https://github.com/(leanprover|leanprover-community)/[A-Za-z0-9_.-]+", url)
                and re.fullmatch("[0-9a-f]{40}", rev)):
            raise ValueError(f"Invalid dependency: {name}")
        target = packages / name
        target.mkdir()
        git = ["git", "-C", str(target)]
        for args in (["init", "-q"], ["remote", "add", "origin", url],
                     ["fetch", "--quiet", "--depth=1", "--no-tags", "origin", rev],
                     ["checkout", "--quiet", "--detach", rev]):
            subprocess.run(git + args, check=True)
        if subprocess.check_output(git + ["rev-parse", "HEAD"], text=True).strip() != rev:
            raise ValueError(f"Wrong checkout for {name}")
        print(f"{name}  {rev}", flush=True)


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, subprocess.CalledProcessError) as e:
        sys.exit(f"Dependency setup failed: {e}")
