 have pZ: (s.pF Bβ XG).2=0:= x0; have hz':s.τz Bβ XG=Zβ (rePoint r₀) Bβ XG:= congrArg (fun i=>Zβ i Bβ XG) z; have h0: Uh=(Uh.1,0):=Prod.ext rfl (show Uh.2=0 from (congrArg s.hoodZ x0).trans s.Ω0.2.2); have ht:makeK (A0:=s.A0) (Lp:=s.Lp) s.Ty Bβ (rePoint r₀) XG (Uh.1,0) = Rz:= (by rw [←z,←h0]; rfl)
