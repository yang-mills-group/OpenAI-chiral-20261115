lemma runKnoll_Th : KnollStep V U kL Hh X Y S G G₀ G₁ Xi q br bw κw Vq:=by
 constructor; intro tSpace t A E J St
 let F(r:tSpace):= meetT A (E r); let Gτ(r:tSpace):=meetK A (E r)
 choose e f h using fun r=> rental V Xi C0 br bw κw Vq M (F r) (Gτ r) (fun i=> (tether A (E r) i).holds) (J r) (fun x=>St r x) -- order M relative
 let p1:=e t false; let q1:= f t false
 let p2(r):= e r true; let q2(r):=f r true
 let hp(r k):=bothP p1 (p2 r) k; let hq(r k):=bothP q1 (q2 r) k
 have Lσ(r:tSpace):EmitRent V Xi C0 br κw Vq (F r) (Gτ r) false p1 ∧ EmitForce V Xi C0 br κw Vq (F r) (Gτ r) false p1 q1:=h t false
 have he(r:tSpace)(i:Bool):EmitRent V Xi C0 br κw Vq (F r) (Gτ r) i (hp r i)∧ EmitForce V Xi C0 br κw Vq (F r) (Gτ r) i (hp r i) (hq r i):=by cases i; exact Lσ r; exact h r true
 have ht(r:tSpace):Rates R.L κw Δτ χτ Hh g0 g1 g2 br bw X Y G (hp r):=⟨M.cash_o,M.night,M.noon,M.day,M.wallet,M.discount,M.mentor,M.value,fun b=>(he r b).1.2.1⟩
 choose Rσ Vσ p x z u using fun r:tSpace=>crateS (hp r) (ht r) M.ink M.cold M.h0
 let a:=Rσ t
 have hx (r:tSpace):Rσ r*p1.blade=bw:=x r
 have hΩ: (p1.blade)≠0:= right_ne_zero_of_mul ((hx t).symm ▸ ne_of_gt (M.night.trans_le M.noon))
 have hV(r):Rσ r=a:=mul_right_cancel₀ hΩ ((hx r).trans (hx t).symm)
 let Z:= Vσ
 let S0:=pTop p1 LB a q1 ((h t false).2.1)
 let hΩp(r:tSpace):=hBias V Xi C0 br κw Vq p1 (p2 r) q1 (q2 r) A (E r) (Lσ r) (h r true)
 let Sd(r:tSpace):=pBottom p1 (p2 r) LB (Z r) a q1 (q2 r) (hΩp r)
 refine ⟨a,Z,S0,Sd,fun i=>hV i ▸ p i,fun r I qx qt o hv Lv hL=>?_ ⟩ -- type lambdas for [_][_]? need intro
 have hE:= oneEmitter V Xi C0 br bw κw Vq M p1 (p2 r) q1 (q2 r) A (E r) (Lσ r) (h r true) (Rσ r) (Z r) o Lv hv hL (u r) (p r) (x r) (z r)
 rw [hV r] at hE; exact hE
