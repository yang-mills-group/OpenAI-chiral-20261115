 have q : Call_H (Y:=W0) Hh (armL o Lv W0).X (armL o Lv W0).Y (armL o Lv W0).Z (Cube.node ∘ Hove.heel G ∘sameY o) (Q1+m0) (Q2+m0) (Q3+m0):=by
    constructor
    · simp only [armL,varn, if_pos (roots (I:=PairKey I))]; change _ + Lv.earn 0=_ ∧ True∧_ + Lv.wake 0=_
      rw [show Lv.earn 0 = 0 from funext₂ fun i j=> (a i j).dawnQ,show Lv.wake 0=0 from funext₂ fun i j=> (b i j).dawnQ,add_zero,add_zero]; exact ⟨rfl,trivial,rfl⟩
    · intro i; refine ⟨fun z vz w vw h=>?_,fun _ _ _ _ _=>rfl,fun t=>⟨?_,zeroR _⟩ ⟩
      · change W0.F _+varn Lv.earn z _=W0.F _+varn Lv.earn w _; rw [show varn Lv.earn z= Lv.earn z from if_pos vz,show varn Lv.earn w= Lv.earn w from if_pos vw]; exact congrArg (fun t=> W0.F _+ t) (funext fun t=> hush_D (Hove.heel G ∘ o) (a i t) z vz w vw h)
      exact (dub_V (Mew.zeroR (I:=Iκ) (W0.F i t)) (a i t).reed).cong (fun z hz=> congrArg (fun t'=> (W0.F + t') i t) (if_pos hz))
    · intro i; refine ⟨fun z vz w vw h=>?_,fun t=>?_⟩
      · change W0.K _+varn Lv.wake z _=W0.K _+varn Lv.wake w _; rw [show varn Lv.wake z= _ from if_pos vz,show varn Lv.wake w= _ from if_pos vw]; exact congrArg (fun t=> W0.K _+t) (funext fun t=> hush_D (Hove.heel G ∘ o) (b i t) z vz w vw h)
      exact (dub_V (Mew.zeroR (I:=Iκ) (W0.K i t)) (b i t).reed).cong (fun z hz=> congrArg (fun t'=> (W0.K+t') i t) (if_pos hz))
    intro z; have he: IncX primeU (varn Lv.earn z) W0.p Hh m0 ∧ Dark primeU (varn Lv.wake z) W0.p Hh m0:=by
       by_cases v:z∈hill Iκ; rw [varn,if_pos v,varn,if_pos v]; exact c z ((hill_i.mp v))
