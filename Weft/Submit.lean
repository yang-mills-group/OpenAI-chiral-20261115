    exact loan_ξ _ (show Arc_r _ Hh (Q1+m0) Q2 (Q3+m0) from ⟨Larch.add_v _ _ _ pu.1 he.1,pu.2,union_F _ pu.3 he.2⟩) le_rfl (le_add_of_nonneg_right vA) le_rfl
