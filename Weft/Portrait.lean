 constructor
 · intro y u; simp only [rebarQ,map_add,stone_r,currencyB,map_smul,(p _).rill,smul_add,smul_smul,mul_comm _ (taxK y)]
 · intro y z j h x; change (taxK y) • (_ + _)= suit_Y y.val (_+_) -- CLI Pi-scalar.should infer
   let L(i):=(p i).mark y z j h x
   change (taxK y) • (stone a e v false i • Yk false (orbitT y z) (moveForce y.val x) (yellA y.val j) + stone a e v true i • _) = _
   change ∀ b:Bool, taxK y • _= suit_Y _ (Yk b z x j) at L
   change _ = suit_Y y.val (stone a e v false i • (_:Cipher m)+stone a e v true i • _)
   simp only [stone_r,currencyC,smul_add,map_add,map_smul,smul_smul,mul_comm (taxK _)]
