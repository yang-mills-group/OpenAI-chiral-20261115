/-- Extract the physical conclusions from the existence theorem on its particular
witness. Reflection positivity uses the selected Euclidean sector directly. -/
theorem relativisticClauses_of_oneTheory (h : OneTheory Certificate) :
    RelativisticClauses Certificate where
  lattice := h.bare
  matterRepresentation := h.bare.families
  continuumObservables := h.uses_these_fields
  reflectionPositive k _ A := process.duo_positive 3 vacuum k costAnalysis A
  euclideanSector := h.reconstruction.sector_geometry
  continuation := h.reconstruction.continuations
  wightmanPositivity := h.reconstruction.positive
  vacuumExpectations := h.reconstruction.costs
  cyclicFields := h.reconstruction.fields
  localFields := h.reconstruction.commute
  poincareCovariance := h.reconstruction.cover
  preservesNorm := model.system.action.usual
  inverseAction := model.system.action.goes
  strongContinuity := model.system.action.strong
  translationSpectrum := h.reconstruction.spectrum
  positiveEnergy := h.reconstruction.future
  uniqueInvariantDirection := h.reconstruction.unique
  stressWard := h.generation
  fixedProbes := h.interaction

end ContinuumConstruction
