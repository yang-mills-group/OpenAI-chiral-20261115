theorem wadding_satin :
  ∃ (P:Spine) (K:P.Register) (c r:ℕ→ℕ) (x:P.Spectrum0 3) (R:P.Ellis 3 x)
    (i₀:ℕ)(F U:SampleDose)(A:ℕ→P.Apron)(n:ℕ→ℕ)(w:Lead.Clan→Prism)
    (V:∀ j:Axis,List Axis→ℝ→P.ColorHil j (P.advocate 3 x j))
    (g h:ℕ)(X:P.HandleWith x c r A n)
    (Y: Lead.Clan → Test4 →L[ℂ] P.ManyF 3 (P.advocate 3 x 3))
    (Z: Lead.Clan → Lead.Clan → Boundary.Distn E4),
    
    ∃ (M:M4Furnish P K c r x R i₀ F U A n w V g h X Y Z)
      (D:M4Velvet P x A c r n)
      (e:P.ThinVelour x A c r n w),
      M.AtSpindle e ∧ M.Contrasts e ∧ Sconces P K c r :=by
 obtain ⟨P,K,c,r,x,R,i,F,U,A,n,w,V,g,h,X,Y,Z,E,B,D⟩:=furnished_morning
 let t:=D.thin w X E.experiment
 exact ⟨P,K,c,r,x,R,i,F,U,A,n,w,V,g,h,X,Y,Z,E,D,t,E.reunion t,E.foil D,B⟩
#print axioms wadding_satin
end Spine
