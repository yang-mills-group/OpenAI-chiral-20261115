private lemma twice (a b:ℝ) (i:ℕ)(h0:0≤a)(e:2*a≤b) (u:degreePrice (radiusB x) b 1 < 1) :2*(RΞ i a) ≤ RΞ i b:=by
 have he:b≥0:=by linarith only [h0,e]
 let D:=degreePrice (radiusB x) b 1
 let C:=degreePrice (radiusB x) a 1
 have hp:0≤C:=by unfold C degreePrice Trees.stretch; positivity
 have hw:a≤b:=by linarith
 have h:C ≤ D := by unfold D C degreePrice Trees.stretch; gcongr
 change 2*(a*C^i*(1-C)⁻¹)≤ b* D^i*(1-D)⁻¹
 change D < 1 at u; have hh:0<1-D:= sub_pos.mpr u; rw [←mul_assoc,←mul_assoc]; gcongr
 · exact inv_nonneg_of_nonneg (by linarith)
 · exact mul_nonneg he (pow_nonneg (hp.trans h) _)


/-- Tablet estimate; the rate in this purchase amplifies both unzoomed and marked Harvest. -/
theorem harvest_scaled {K0 K1 K2 b:ℝ} (Z' U' T':De)
  {H₁ H₂:Pilot}{hf:fends p p' o β H₁}{hf₂:fends p p' o β H₂}
  (pZ:GroV V H₁ D.Z (X:=Xs β) (Y:=Ys β F) o.SheepR o.bags o.vista hf vP U' Lz h K0 1)
  (pY:PZ)(pT:GroV V H₂ D.Z (X:=Xs β) (Y:=Ys β F) o.SheepR o.bags o.vista hf₂ vP T' pY h K2 1)
  (ht:Harvest (D:=D) p h K1 b (pY-Lz) Z') (hx:ScaledV (stampY Hs Hy) (tolQ p) h K0 x 1 U')
  (K3:ℝ)(p0:0≤K0)(p1:0≤K1)(q0:2*K0≤K3)(q1:2*K1≤K3)(he:degreePrice (radiusB x) K3 1 <1)(h0:1≤Hy)(hn:Hy≤Hs) (g:Hs*b≤1):
  GroV V H₂ D.Z (X:=Xs β) (Y:=Ys β F) o.SheepR o.bags o.vista hf₂ vP (U'+Z') pY h K3 1 ∧ ScaledV (fun z=>min Hs (stampY Hs Hy z)) (tolQ p) h K3 x 1 (U'+Z'):= by
 let pK := tolQ p
 let shift(k:De)(i:V_)(j:Lo)(o:Seat ι) := pK.mass j.val (∑ s:Finset D', Scree.tariff pK o h s*k i j s)
 have h0x(i:V_):1≤ cap i:= le_min (h0.trans hn) (shelfX i _ _ (h0.trans hn) h0); have hh:0≤ h:=zero_le_one.trans D.high
 have hN(T:De)(u:0≤T)(i j o):0≤ shift T i j o := mul_nonneg (Real.exp_pos _).le (sum_nonneg (fun e _=>mul_nonneg (by unfold Scree.tariff; positivity) (u ..)))
 let Rξ:=reserveT pK.power pK.order (radiusB x) 1; have hR:0 ≤ Rξ:= by unfold Rξ Nor.reserveT Nor.coin_n Nor.stilK; positivity
 have hN':0≤ U'+Z':=add_nonneg pZ.grace ht.nonnegative
 have hp: ScaledV (fun z=> min Hs (stampY Hs Hy z)) (tolQ p) h K3 x 1 (U'+Z'):= by
    intro yo i Y Hy₁
    let Xt := univ.filter (fun j:Lo=> yo∈j.val)
    let Xr:= univ.filter fun j:V_=>Palot.outC i j
    let q : V_→Lo→ Seat ι:= Y
    let R_pay(K:ℝ):= RΞ i K
    have hw(ωt:ℝ)(u:0≤ωt)(t:2*ωt≤K3) :2*(Rξ*R_pay ωt) ≤ Rξ*R_pay K3:=by rw [mul_left_comm]; exact mul_le_mul_of_nonneg_left (twice ωt K3 i u t he) hR
    change (∑ j∈Xr,∑ s∈Xt,(cap j)*shift (U'+Z') j s (q j s)) ≤ Rξ* R_pay K3
    calc
     _ ≤ ∑ j∈Xr,∑ s∈Xt,(stampY Hs Hy j*shift U' j s (q j s) +Hs*shift Z' j s (q j s)) := sum_le_sum fun j _=> sum_le_sum fun s _=> by
         rw [show shift (U'+Z') j s (q j s)= shift U' j s (q j s)+shift Z' j s (q j s) from (by unfold shift; simp only [Pi.add_apply,BudgetPoint.mass, mul_add,sum_add_distrib]),mul_add] -- hole
         exact add_le_add (mul_le_mul_of_nonneg_right (min_le_right ..) (hN U' pZ.grace ..)) (mul_le_mul_of_nonneg_right (min_le_left ..) (hN Z' ht.nonnegative ..)) -- syntax
     _ ≤ Rξ * R_pay K0 + (Hs*(b*(Rξ*R_pay K1))) := by
       simp_rw [sum_add_distrib, ←mul_sum] -- ← pulls both? Stamp j; Compare
       apply add_le_add _ (mul_le_mul_of_nonneg_left (ht.meter yo i Y Hy₁) (zero_le_one.trans (h0.trans hn)))
       simp_rw [mul_sum]; exact hx yo i Y Hy₁
     _ ≤ _ := by
       have hd: degreePrice (radiusB x) K1 1<1:= lt_of_le_of_lt (show degreePrice (radiusB x) K1 1 ≤ degreePrice (radiusB x) K3 1 from (by unfold degreePrice Trees.stretch; have ht:K1 ≤ K3:=(by linarith only [p1,q1]); gcongr)) he
       have hk:0<1-degreePrice (radiusB x) K1 1 := sub_pos.mpr hd
       apply le_trans (add_le_add (le_refl (Rξ*R_pay K0)) (show Hs*(b*(Rξ* R_pay K1))≤Rξ*R_pay K1 from ?_)) (by linarith only [hw _ p0 q0,hw _ p1 q1])
       rw [←mul_assoc]; apply mul_le_of_le_one_left _ g; have he:0≤degreePrice (radiusB x) K1 1:=by unfold degreePrice Trees.stretch; positivity
       exact mul_nonneg hR (by unfold R_pay; positivity)
 refine ⟨⟨hN',fun yo i Y w=>?_ ,fun j s=>?_⟩,hp⟩
 · apply le_trans _ (hp yo i Y w); refine sum_le_sum fun j _=> sum_le_sum fun s _=>?_
   exact le_mul_of_one_le_left (hN _ hN' j s (Y j s)) (h0x _)
 let G:= pT.quiet j s
 refine ⟨G.toLullT, G.priceP,fun u t y o ho e=>?_⟩
 have hr:= (pZ.quiet j s).hoist u t y o ho e
 -- defeq crumb sum? hoistAdd only works expression same structure; rw k Psi.
 let P:PZ:= Lz+(pY-Lz); have he:P=pY:= by unfold P; abel
 have hp: Signs (Xs β).p o ((fun a=>crumb (P j s (a,u.2)).val e)∘ Forge.gyrate (unrest (cook S' j.toLeft).flags p.B) u.1) ((U'+Z') j s e) := Prism.tack hr (ht.hoist j s u t y o ho e)
 rw [he] at hp; exact hp
